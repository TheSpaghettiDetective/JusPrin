# AI Translated
# Needs human review: "until restoration is recovered" is vague in the source; check the meaning
msgid "Project chat is blocked until restoration is recovered."
msgstr "復元処理が回復するまで、プロジェクトチャットは使用できません。"

# AI Translated
msgid "Return to the active chat or restore this chat before sending."
msgstr "送信する前に、アクティブなチャットに戻るか、このチャットを復元してください。"

# AI Translated
msgid "Finish or cancel AI configuration before sending a message."
msgstr "メッセージを送信する前に、AIの設定を完了するかキャンセルしてください。"

# AI Translated
msgid "This message belongs to a different chat."
msgstr "このメッセージは別のチャットのものです。"

# AI Translated
msgid "A message needs text or an attachment."
msgstr "メッセージにはテキストか添付ファイルが必要です。"

# AI Translated
msgid "This file is too large to attach."
msgstr "このファイルは大きすぎるため添付できません。"

# AI Translated
msgid "This file type can't be read by AI."
msgstr "この種類のファイルはAIが読み込めません。"

# AI Translated
msgid "This file is not readable UTF-8 text."
msgstr "このファイルは読み取り可能なUTF-8テキストではありません。"

# AI Translated
msgid "The attachment could not be stored."
msgstr "添付ファイルを保存できませんでした。"

# AI Translated
msgid "Photo or image"
msgstr "写真または画像"

# AI Translated
msgid "3D model"
msgstr "3Dモデル"

# AI Translated
msgid "Document (PDF)"
msgstr "ドキュメント (PDF)"

# AI Translated
msgid "This build cannot open a file dialog."
msgstr "このビルドではファイルダイアログを開けません。"

# AI Translated
#. TRN A calibration chat's first line. %1%: where it was started from, %2%: a printer.
#, boost-format
msgid "From %1% · %2% · filament not chosen · temporary test settings"
msgstr "%1%から · %2% · フィラメント未選択 · 一時的なテスト設定"

# AI Translated
#. TRN A calibration chat's first line. %1%: where it was started from, %2%: a filament, %3%: a printer.
#, boost-format
msgid "From %1% · %2% on %3% · temporary test settings"
msgstr "%1%から · %3%の%2% · 一時的なテスト設定"

# AI Translated
#. TRN A reopened calibration test's line. %1%: the day it was made, as "21 Oct 2026".
#, boost-format
msgid "Reopened · generated %1%"
msgstr "再度開きました · %1%に生成"

# AI Translated
#. TRN %1%: where the test was opened from, %2%: the day it was made, as "21 Oct 2026".
#, boost-format
msgid "Opened from %1% · generated %2%"
msgstr "%1%から開きました · %2%に生成"

# AI Translated
#. TRN %1% is a calibration result, such as 215 °C.
#, boost-format
msgid "result %1% saved"
msgstr "結果 %1% を保存しました"

# AI Translated
#. TRN %1% is a plate's name, %2% why the slice did not succeed.
#, boost-format
msgid "The app did not slice %1%: %2%"
msgstr "%1%をスライスしませんでした: %2%"

# AI Translated
#. TRN %1% is a plate's name, %2% why the slice did not succeed.
#, boost-format
msgid "The app stopped the slice of %1%: %2%"
msgstr "%1%のスライスを中止しました: %2%"

# AI Translated
msgid "The slice of every plate finished."
msgstr "すべてのプレートのスライスが完了しました。"

# AI Translated
#. TRN %1% is a plate's name.
#, boost-format
msgid "The slice of %1% finished."
msgstr "%1%のスライスが完了しました。"

# AI Translated
msgid "Historical replies cannot be retried."
msgstr "過去の返答は再試行できません。"

# AI Translated
msgid "Only a failed or stopped assistant message in the active conversation can be retried."
msgstr "再試行できるのは、アクティブな会話で失敗または中止したアシスタントのメッセージだけです。"

# AI Translated
msgid "Only the chat's last reply can be retried."
msgstr "再試行できるのは、チャットの最後の返答だけです。"

# AI Translated
msgid "Another reply is currently streaming."
msgstr "別の返答をストリーミング中です。"

# AI Translated
msgid "Historical tool actions cannot be changed."
msgstr "過去のツール操作は変更できません。"

# AI Translated
msgid "This proposal is no longer open. Ask AI again."
msgstr "この提案はもう有効ではありません。もう一度AIに尋ねてください。"

# AI Translated
msgid "This save can no longer be undone."
msgstr "この保存はもう元に戻せません。"

# AI Translated
msgid "Finish or resolve pending work before creating a chat."
msgstr "チャットを作成する前に、保留中の作業を完了または解決してください。"

# AI Translated
msgid "The current chat could not be saved."
msgstr "現在のチャットを保存できませんでした。"

# AI Translated
msgid "The new chat could not be saved."
msgstr "新しいチャットを保存できませんでした。"

# AI Translated
msgid "The selected chat could not be saved."
msgstr "選択したチャットを保存できませんでした。"

# AI Translated
msgid "The project or selected chat changed. Review it again."
msgstr "プロジェクトまたは選択したチャットが変更されました。もう一度確認してください。"

# AI Translated
msgid "Finish or resolve pending work before resuming a chat."
msgstr "チャットを再開する前に、保留中の作業を完了または解決してください。"

# AI Translated
msgid "This chat is already active."
msgstr "このチャットはすでにアクティブです。"

# AI Translated
msgid "JusPrin can't find the project version this chat was working on."
msgstr "このチャットが作業していたプロジェクトのバージョンが見つかりません。"

# AI Translated
msgid "The current project could not be saved before restoration."
msgstr "復元の前に現在のプロジェクトを保存できませんでした。"

# AI Translated
msgid "JusPrin couldn't put the project back."
msgstr "プロジェクトを元に戻せませんでした。"

# AI Translated
msgid "Restored this chat's saved project setup. Check the current printer and material before printing."
msgstr "このチャットで保存したプロジェクトの設定を復元しました。印刷する前に、現在のプリンターと材料を確認してください。"

# AI Translated
msgid "Use a non-empty, single-line title of at most 120 characters for an existing chat."
msgstr "既存のチャットのタイトルは、空でない1行の120文字以内にしてください。"

# AI Translated
msgid "This chat is still working. Stop it or let it finish, then delete it."
msgstr "このチャットはまだ作業中です。中止するか完了を待ってから削除してください。"

# AI Translated
msgid "This chat no longer exists."
msgstr "このチャットはもう存在しません。"

# AI Translated
msgid "The replacement chat could not be saved."
msgstr "置き換えるチャットを保存できませんでした。"

# AI Translated
msgid "Historical chats cannot edit the current draft."
msgstr "過去のチャットでは現在の下書きを編集できません。"

# AI Translated
msgid "Finish or stop the current reply before configuring AI."
msgstr "AIを設定する前に、現在の返答を完了するか中止してください。"

# AI Translated
msgid "This build cannot configure an AI provider."
msgstr "このビルドではAIプロバイダーを設定できません。"

# AI Translated
msgid "A credential check is already running."
msgstr "認証情報の確認はすでに実行中です。"

# AI Translated
msgid "This build cannot verify a key for that provider yet."
msgstr "このビルドでは、そのプロバイダーのキーをまだ検証できません。"

# AI Translated
msgid "Finish or stop the current reply before removing a key."
msgstr "キーを削除する前に、現在の返答を完了するか中止してください。"

# AI Translated
msgid "Finish or cancel the key check before removing a key."
msgstr "キーを削除する前に、キーの確認を完了するかキャンセルしてください。"

# AI Translated
msgid "That key could not be removed."
msgstr "そのキーを削除できませんでした。"

# AI Translated
msgid "This build cannot sign in to a JusPrin account."
msgstr "このビルドではJusPrinアカウントにサインインできません。"

# AI Translated
msgid "Finish or stop the current reply before signing in."
msgstr "サインインする前に、現在の返答を完了するか中止してください。"

# AI Translated
msgid "A sign-in or key check is already running."
msgstr "サインインまたはキーの確認がすでに実行中です。"

# AI Translated
msgid "There is no JusPrin account on this computer to check."
msgstr "このコンピューターには確認するJusPrinアカウントがありません。"

# AI Translated
msgid "JusPrin couldn't sign you in. Try again."
msgstr "JusPrinはサインインできませんでした。もう一度お試しください。"

# AI Translated
msgid "This sign-in could not be saved, so you will have to sign in again next time JusPrin starts."
msgstr "このサインインを保存できなかったため、次回JusPrinを起動したときにもう一度サインインする必要があります。"

# AI Translated
msgid "This key could not be saved, so it will have to be entered again next time JusPrin starts."
msgstr "このキーを保存できなかったため、次回JusPrinを起動したときにもう一度入力する必要があります。"

# AI Translated
msgid "The AI service is not available."
msgstr "AIサービスを利用できません。"

# AI Translated
msgid "The AI service could not start this request."
msgstr "AIサービスがこのリクエストを開始できませんでした。"

# AI Translated
msgid "AI could not receive the native tool result."
msgstr "AIがネイティブツールの結果を受け取れませんでした。"

# AI Translated
msgid "The AI request failed."
msgstr "AIリクエストが失敗しました。"

# AI Translated
msgid "The automatic chat title could not be generated. You can rename the chat."
msgstr "チャットのタイトルを自動生成できませんでした。チャットの名前は変更できます。"

# AI Translated
#. TRN %1% is an AI provider's account, such as JusPrin.
#, boost-format
msgid "This chat ran on your %1% account. Sign in again to continue it, or start a new chat."
msgstr "このチャットは%1%アカウントで実行されていました。続けるにはもう一度サインインするか、新しいチャットを開始してください。"

# AI Translated
#. TRN %1% is an AI provider, such as OpenAI.
#, boost-format
msgid "This chat ran on %1%, and no %1% API key is set up now. Add the key in the AI settings to continue it, or start a new chat."
msgstr "このチャットは%1%で実行されていましたが、現在%1%のAPIキーが設定されていません。続けるにはAI設定でキーを追加するか、新しいチャットを開始してください。"

# AI Translated
msgid "JusPrin hasn't loaded the AI models for your account yet. Try again in a moment."
msgstr "アカウントのAIモデルをまだ読み込んでいません。しばらくしてからもう一度お試しください。"

# AI Translated
#. TRN %1% is an AI provider, such as OpenAI.
#, boost-format
msgid "No %1% API key is set up. Add it in the AI settings, or choose another model."
msgstr "%1%のAPIキーが設定されていません。AI設定で追加するか、別のモデルを選択してください。"

# AI Translated
msgid "A connection is already being saved."
msgstr "接続はすでに保存中です。"

# AI Translated
msgid "JusPrin's connection helper is missing. Reinstall or rebuild JusPrin."
msgstr "JusPrinの接続ヘルパーが見つかりません。JusPrinを再インストールまたは再ビルドしてください。"

# AI Translated
msgid "The AppImage launcher is missing. Reopen the installed AppImage."
msgstr "AppImageランチャーが見つかりません。インストールしたAppImageを開き直してください。"

# AI Translated
msgid "Review the change before connecting."
msgstr "接続する前に変更内容を確認してください。"

# AI Translated
#. TRN %1% is an AI client app, such as Claude Code.
#, boost-format
msgid "%1% isn't installed. Install it, or copy the command and run it later."
msgstr "%1%がインストールされていません。インストールするか、コマンドをコピーして後で実行してください。"

# AI Translated
msgid "This build cannot run the client CLI."
msgstr "このビルドではクライアントのCLIを実行できません。"

# AI Translated
msgid "This build cannot open a file manager."
msgstr "このビルドではファイルマネージャーを開けません。"

# AI Translated
msgid "The provider did not answer."
msgstr "プロバイダーから応答がありませんでした。"

# AI Translated
msgid "Attach files"
msgstr "ファイルを添付"

# AI Translated
msgid "The AI panel could not connect"
msgstr "AIパネルを接続できませんでした"

# AI Translated
msgid "Back to Prepare"
msgstr "準備に戻る"

# AI Translated
msgid "Open filament settings"
msgstr "フィラメント設定を開く"

# AI Translated
msgid "The packaged AI page is missing from this build."
msgstr "このビルドには同梱のAIページがありません。"

# AI Translated
msgid "The system web view could not be created."
msgstr "システムのWebビューを作成できませんでした。"

# AI Translated
msgid "The AI page failed to load."
msgstr "AIページの読み込みに失敗しました。"

# AI Translated
msgid "The AI page did not complete the bridge handshake."
msgstr "AIページがブリッジのハンドシェイクを完了しませんでした。"

# AI Translated
msgid "Restart the application to load the AI page."
msgstr "AIページを読み込むには、アプリを再起動してください。"

# AI Translated
msgid "This is an internal connection between the application and its AI panel, not a network service."
msgstr "これはアプリとAIパネルの間の内部接続で、ネットワークサービスではありません。"

# AI Translated
#. TRN %1% is the web view's own error text.
#, boost-format
msgid "Last load error: %1%"
msgstr "最後の読み込みエラー: %1%"

# AI Translated
#. TRN The messages the app and its AI panel exchanged. %1% and %2% are counts.
#, boost-format
msgid "Bridge traffic: %1% sent / %2% received"
msgstr "ブリッジ通信: 送信 %1% / 受信 %2%"

# AI Translated
msgid "The AI service returned an unreadable streaming response."
msgstr "AIサービスから読み取れないストリーミング応答が返されました。"

# AI Translated
msgid "The AI service streamed a delta for a block it never opened."
msgstr "AIサービスが、開始していないブロックの差分をストリーミングしました。"

# AI Translated
msgid "The AI service sent a tool call whose arguments are not JSON."
msgstr "AIサービスが、引数がJSONではないツール呼び出しを送信しました。"

# AI Translated
msgid "The AI service could not complete the response."
msgstr "AIサービスが応答を完了できませんでした。"

# AI Translated
#. TRN %1% is the AI service's own reason, in English, such as "cyber".
#, boost-format
msgid "The AI service declined to answer (%1%)."
msgstr "AIサービスが回答を拒否しました (%1%)。"

# AI Translated
msgid "The AI service ended its response for a reason this build does not know."
msgstr "AIサービスが、このビルドの知らない理由で応答を終了しました。"

# AI Translated
msgid "This version of JusPrin can no longer connect to JusPrin accounts. Get the new version to keep using your account."
msgstr "このバージョンのJusPrinはJusPrinアカウントに接続できなくなりました。アカウントを引き続き使うには、新しいバージョンを入手してください。"

# AI Translated
msgid "Signing in didn't finish. Nothing was saved. Try again."
msgstr "サインインが完了しませんでした。何も保存されていません。もう一度お試しください。"

# AI Translated
msgid "JusPrin couldn't be reached to finish signing in. Try again."
msgstr "サインインを完了するためにJusPrinに接続できませんでした。もう一度お試しください。"

# AI Translated
msgid "JusPrin has no AI model for this account right now. Try again later."
msgstr "現在、このアカウントで使えるAIモデルがありません。後でもう一度お試しください。"

# AI Translated
msgid "Restored an earlier project version"
msgstr "以前のプロジェクトバージョンを復元しました"

# AI Translated
msgid "Restored this chat's saved project setup"
msgstr "このチャットで保存したプロジェクトの設定を復元しました"

# AI Translated
#. TRN The chat list's preview of a message that has only attachments.
msgid "Attachment"
msgstr "添付ファイル"

# AI Translated
msgid "The AI service stopped before finishing its response."
msgstr "AIサービスが応答を終える前に停止しました。"

# AI Translated
msgid "The AI service kept pausing its response."
msgstr "AIサービスの応答が何度も一時停止しました。"

# AI Translated
msgid "AI could not be asked to continue its response."
msgstr "AIに応答の続きを依頼できませんでした。"

# AI Translated
msgid "AI could not be told the results of its tool calls."
msgstr "AIにツール呼び出しの結果を伝えられませんでした。"

# AI Translated
msgid "AI returned an invalid tool call."
msgstr "AIが無効なツール呼び出しを返しました。"

# AI Translated
msgid "The AI service ended before a complete response arrived."
msgstr "完全な応答が届く前にAIサービスが終了しました。"

# AI Translated
msgid "Your JusPrin sign-in has ended. Sign in again in Preferences, then try again."
msgstr "JusPrinのサインインの有効期限が切れました。設定でもう一度サインインしてから、もう一度お試しください。"

# AI Translated
msgid "That photo could not be read."
msgstr "その写真を読み込めませんでした。"

# AI Translated
#. TRN The print report form, about a photo over the server's limit of 20 MB.
msgid "That photo is larger than 20 MB. Choose a smaller photo, then send the report again."
msgstr "その写真は 20 MB を超えています。もっと小さい写真を選んでから、もう一度レポートを送信してください。"

# AI Translated
#, boost-format
msgid "This message needs %1% credit; you have %2%."
msgid_plural "This message needs %1% credits; you have %2%."
msgstr[0] "このメッセージには %1% クレジットが必要です。現在 %2% クレジットです。"

# AI Translated
msgid "You're out of credits."
msgstr "クレジットがなくなりました。"

# AI Translated
#. TRN %1% is an AI provider, such as OpenAI.
#, boost-format
msgid "The %1% API key was rejected. Update the AI configuration and try again."
msgstr "%1%のAPIキーが拒否されました。AIの設定を更新して、もう一度お試しください。"

# AI Translated
#. TRN %1% is an AI provider, such as OpenAI.
#, boost-format
msgid "The request was too large for the %1% service."
msgstr "リクエストが%1%サービスには大きすぎました。"

# AI Translated
#. TRN %1% is an AI provider, such as OpenAI.
#, boost-format
msgid "The %1% service is rate limited. Try again shortly."
msgstr "%1%サービスがレート制限中です。少し待ってからもう一度お試しください。"

# AI Translated
#. TRN %1% is an AI provider, such as OpenAI.
#, boost-format
msgid "The %1% service is overloaded. Try again shortly."
msgstr "%1%サービスが混み合っています。少し待ってからもう一度お試しください。"

# AI Translated
#. TRN %1% is an AI provider, such as OpenAI.
#, boost-format
msgid "The %1% service is temporarily unavailable."
msgstr "%1%サービスは一時的に利用できません。"

# AI Translated
msgid "The AI request timed out."
msgstr "AIリクエストがタイムアウトしました。"

# AI Translated
#. TRN %1% is an AI provider, such as OpenAI.
#, boost-format
msgid "The AI request could not reach the %1% service."
msgstr "AIリクエストが%1%サービスに到達できませんでした。"

# AI Translated
msgid "The AI service response did not contain valid output."
msgstr "AIサービスの応答に有効な出力が含まれていませんでした。"

# AI Translated
#. TRN A button that asks the AI to choose another block of a calibration test.
msgid "Pick another block"
msgstr "別のブロックを選ぶ"

# AI Translated
#. TRN A button that asks the AI to choose another tile of a calibration test.
msgid "Pick another tile"
msgstr "別のタイルを選ぶ"

# AI Translated
#. TRN A button that asks the AI to choose another line of a calibration test.
msgid "Pick another line"
msgstr "別のラインを選ぶ"

# AI Translated
#. TRN A button that asks the AI to choose another corner of a calibration test.
msgid "Pick another corner"
msgstr "別のコーナーを選ぶ"

# AI Translated
#. TRN A button that asks the AI to choose another height of a calibration tower.
msgid "Pick another height"
msgstr "別の高さを選ぶ"

# AI Translated
#. TRN %1% is a preset's name.
#, boost-format
msgid "Preset · %1%"
msgstr "プリセット · %1%"

# AI Translated
#. TRN %1% is a preset's name.
#, boost-format
msgid "New preset · %1%"
msgstr "新しいプリセット · %1%"

# AI Translated
#. TRN %1% is the preset the new one is made from.
#, boost-format
msgid "%1% itself is unchanged"
msgstr "%1%自体は変更されません"

# AI Translated
#. TRN %1% is a setting's new value, such as 215 °C.
#, boost-format
msgid "Save %1% as a new filament preset"
msgstr "%1%を新しいフィラメントプリセットとして保存"

# AI Translated
#. TRN %1% is a setting's new value, such as 215 °C.
#, boost-format
msgid "Save %1% as a new printer preset"
msgstr "%1%を新しいプリンタープリセットとして保存"

# AI Translated
#. TRN %1% is a setting's new value, such as 215 °C.
#, boost-format
msgid "Save %1% as a new process preset"
msgstr "%1%を新しいプロセスプリセットとして保存"

# AI Translated
#. TRN %1% is a setting's new value, such as 215 °C, %2% a preset's name.
#, boost-format
msgid "Save %1% to %2%"
msgstr "%1%を%2%に保存"

# AI Translated
msgid "This proposal is already saved."
msgstr "この提案はすでに保存されています。"

# AI Translated
msgid "Drop a model here or add one"
msgstr "ここにモデルをドロップするか、追加してください"

# AI Translated
msgid "World coordinates"
msgstr "ワールド座標"

# AI Translated
msgid "Object coordinates"
msgstr "オブジェクト座標"

# AI Translated
msgid "Translate(Relative)"
msgstr "移動 (相対)"

# AI Translated
msgid "Rotate (absolute)"
msgstr "回転 (絶対)"

# AI Translated
msgid "Part coordinates"
msgstr "パーツ座標"

# AI Translated
msgid "The packaged Home page is missing from this build."
msgstr "このビルドには同梱のホームページがありません。"

# AI Translated
msgid "The Home page failed to load."
msgstr "ホームページの読み込みに失敗しました。"

# AI Translated
msgid "This window stopped updating because the app switched to another printer."
msgstr "アプリが別のプリンターに切り替わったため、このウィンドウの更新は停止しました。"

# AI Translated
#. TRN A length in millimetres, such as a nozzle diameter on a printer card: "0.4 mm". %s is the number.
#, c-format, boost-format
msgid "%s mm"
msgstr "%s mm"

# AI Translated
#, c-format, boost-format
msgid "The printer reports error %s."
msgstr "プリンターがエラー %s を報告しています。"

# AI Translated
msgid "LAN"
msgstr "LAN"

# AI Translated
