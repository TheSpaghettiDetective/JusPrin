msgid "This project's chats were saved by a newer version of JusPrin. Get the new version to see them."
msgstr "Czaty tego projektu zostały zapisane w nowszej wersji JusPrin. Pobierz nową wersję, aby je zobaczyć."

# AI Translated
msgid "Project chat is blocked until restoration is recovered."
msgstr "Czat projektu jest zablokowany, dopóki przywracanie nie zostanie naprawione."

# AI Translated
msgid "Return to the active chat or restore this chat before sending."
msgstr "Przed wysłaniem wróć do aktywnego czatu lub przywróć ten czat."

# AI Translated
msgid "Finish or cancel AI configuration before sending a message."
msgstr "Przed wysłaniem wiadomości zakończ lub anuluj konfigurację AI."

