msgstr "Ruch połączenia: wysłano %1% / odebrano %2%"

# AI Translated
#. TRN %1% is the AI service's own reason, in English, such as "cyber".
#, boost-format
msgid "The AI service declined to answer (%1%)."
msgstr "Usługa AI odmówiła odpowiedzi (%1%)."

# AI Translated
msgid "This version of JusPrin can no longer connect to JusPrin accounts. Get the new version to keep using your account."
msgstr "Ta wersja JusPrin nie może już łączyć się z kontami JusPrin. Pobierz nową wersję, aby dalej korzystać ze swojego konta."

# AI Translated
msgid "Your JusPrin sign-in has ended. Sign in again in Preferences, then try again."
msgstr "Twoja sesja logowania JusPrin wygasła. Zaloguj się ponownie w Preferencjach, a następnie spróbuj jeszcze raz."

# AI Translated
msgid "Signing in didn't finish. Nothing was saved. Try again."
msgstr "Logowanie nie zostało dokończone. Nic nie zapisano. Spróbuj ponownie."

# AI Translated
msgid "JusPrin couldn't be reached to finish signing in. Try again."
msgstr "Nie udało się połączyć z JusPrin, aby dokończyć logowanie. Spróbuj ponownie."

# AI Translated
msgid "JusPrin has no AI model for this account right now. Try again later."
msgstr "JusPrin nie ma w tej chwili modelu AI dla tego konta. Spróbuj ponownie później."

