# AI Translated
msgid "A credential check is already running."
msgstr "Sprawdzanie danych dostępowych już trwa."

# AI Translated
msgid "This build cannot verify a key for that provider yet."
msgstr "Ta wersja nie może jeszcze zweryfikować klucza tego dostawcy."

# AI Translated
msgid "A sign-in or key check is already running."
msgstr "Logowanie lub sprawdzanie klucza już trwa."

# AI Translated
msgid "JusPrin couldn't sign you in. Try again."
msgstr "JusPrin nie mógł cię zalogować. Spróbuj ponownie."

# AI Translated
msgid "The AI service is not available."
msgstr "Usługa AI jest niedostępna."

# AI Translated
msgid "The AI service could not start this request."
msgstr "Usługa AI nie mogła rozpocząć tego żądania."

# AI Translated
msgid "AI could not receive the native tool result."
msgstr "AI nie mogła odebrać wyniku natywnego narzędzia."

# AI Translated
msgid "The AI request failed."
msgstr "Żądanie do AI nie powiodło się."

# AI Translated
#. TRN %1% is an AI provider's account, such as JusPrin.
#, boost-format
msgid "This chat ran on your %1% account. Sign in again to continue it, or start a new chat."
msgstr "Ten czat działał na twoim koncie %1%. Zaloguj się ponownie, aby go kontynuować, lub rozpocznij nowy czat."

# AI Translated
#. TRN %1% is an AI provider, such as OpenAI.
#, boost-format
msgid "This chat ran on %1%, and no %1% API key is set up now. Add the key in the AI settings to continue it, or start a new chat."
msgstr "Ten czat działał na %1%, a klucz API %1% nie jest teraz skonfigurowany. Dodaj klucz w ustawieniach AI, aby go kontynuować, lub rozpocznij nowy czat."

# AI Translated
msgid "JusPrin hasn't loaded the AI models for your account yet. Try again in a moment."
msgstr "JusPrin nie wczytał jeszcze modeli AI dla twojego konta. Spróbuj ponownie za chwilę."

# AI Translated
#. TRN %1% is an AI provider, such as OpenAI.
#, boost-format
msgid "No %1% API key is set up. Add it in the AI settings, or choose another model."
msgstr "Klucz API %1% nie jest skonfigurowany. Dodaj go w ustawieniach AI lub wybierz inny model."

# AI Translated
msgid "A connection is already being saved."
msgstr "Połączenie jest już zapisywane."

# AI Translated
msgid "JusPrin's connection helper is missing. Reinstall or rebuild JusPrin."
msgstr "Brakuje pomocnika połączeń JusPrin. Zainstaluj lub zbuduj JusPrin ponownie."

# AI Translated
msgid "The AppImage launcher is missing. Reopen the installed AppImage."
msgstr "Brakuje programu uruchamiającego AppImage. Otwórz ponownie zainstalowany AppImage."

# AI Translated
msgid "Review the change before connecting."
msgstr "Przed połączeniem przejrzyj zmianę."

# AI Translated
#. TRN %1% is an AI client app, such as Claude Code.
#, boost-format
msgid "%1% isn't installed. Install it, or copy the command and run it later."
msgstr "%1% nie jest zainstalowany. Zainstaluj go lub skopiuj polecenie i uruchom je później."

# AI Translated
msgid "This build cannot run the client CLI."
msgstr "Ta wersja nie może uruchomić CLI klienta."

# AI Translated
msgid "The provider did not answer."
msgstr "Dostawca nie odpowiedział."

# AI Translated
