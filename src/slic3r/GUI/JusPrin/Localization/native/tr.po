# AI Translated
msgid "Something went wrong on our side"
msgstr "Bizim tarafımızda bir sorun oluştu"

# AI Translated
#. TRN Said in the chat when a project opens whose chats a newer version of JusPrin saved; they are kept, not shown.
msgid "This project's chats were saved by a newer version of JusPrin. Get the new version to see them."
msgstr "Bu projenin sohbetleri JusPrin'in daha yeni bir sürümüyle kaydedildi. Görmek için yeni sürümü edinin."

# AI Translated
msgid "Project chat is blocked until restoration is recovered."
msgstr "Geri yükleme düzelene kadar proje sohbeti kilitli."

# AI Translated
msgid "Return to the active chat or restore this chat before sending."
msgstr "Göndermeden önce etkin sohbete dönün veya bu sohbeti geri yükleyin."

# AI Translated
msgid "Finish or cancel AI configuration before sending a message."
msgstr "Mesaj göndermeden önce yapay zeka yapılandırmasını tamamlayın veya iptal edin."

# AI Translated
msgid "This file is too large to attach."
msgstr "Bu dosya eklenemeyecek kadar büyük."

# AI Translated
msgid "This file type can't be read by AI."
msgstr "Bu dosya türü yapay zeka tarafından okunamıyor."

# AI Translated
msgid "This file is not readable UTF-8 text."
msgstr "Bu dosya okunabilir bir UTF-8 metni değil."

# AI Translated
msgid "Photo or image"
msgstr "Fotoğraf veya resim"

# AI Translated
msgid "3D model"
msgstr "3D model"

# AI Translated
msgid "Document (PDF)"
msgstr "Belge (PDF)"

