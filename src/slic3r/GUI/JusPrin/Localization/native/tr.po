# AI Translated
msgid "Restored this chat's saved project setup. Check the current printer and material before printing."
msgstr "Bu sohbetin kayıtlı proje kurulumu geri yüklendi. Yazdırmadan önce geçerli yazıcıyı ve malzemeyi kontrol edin."

# AI Translated
msgid "A credential check is already running."
msgstr "Bir kimlik bilgisi denetimi zaten çalışıyor."

# AI Translated
msgid "This build cannot verify a key for that provider yet."
msgstr "Bu derleme o sağlayıcı için henüz anahtar doğrulayamıyor."

# AI Translated
msgid "A sign-in or key check is already running."
msgstr "Bir oturum açma veya anahtar denetimi zaten çalışıyor."

# AI Translated
msgid "JusPrin couldn't sign you in. Try again."
msgstr "JusPrin oturumunuzu açamadı. Yeniden deneyin."

# AI Translated
msgid "The AI service is not available."
msgstr "Yapay zeka hizmeti kullanılamıyor."

# AI Translated
msgid "The AI service could not start this request."
msgstr "Yapay zeka hizmeti bu isteği başlatamadı."

# AI Translated
msgid "AI could not receive the native tool result."
msgstr "Yapay zeka yerel araç sonucunu alamadı."

# AI Translated
msgid "The AI request failed."
msgstr "Yapay zeka isteği başarısız oldu."

# AI Translated
#. TRN The heading of the chat's model menu over a model that runs on this computer.
msgid "On this computer"
msgstr "Bu bilgisayarda"

# AI Translated
msgid "This chat ran on a model on this computer that is no longer set up. Set it up again in the AI settings to continue it, or start a new chat."
msgstr "Bu sohbet, bu bilgisayardaki artık kurulu olmayan bir modelle çalışıyordu. Devam etmek için modeli yapay zeka ayarlarında yeniden kurun veya yeni bir sohbet başlatın."

# AI Translated
#. TRN %1% is an AI provider's account, such as JusPrin.
#, boost-format
msgid "This chat ran on your %1% account. Sign in again to continue it, or start a new chat."
msgstr "Bu sohbet %1% hesabınızla çalışıyordu. Devam etmek için yeniden oturum açın veya yeni bir sohbet başlatın."

# AI Translated
#. TRN %1% is an AI provider, such as OpenAI.
#, boost-format
msgid "This chat ran on %1%, and no %1% API key is set up now. Add the key in the AI settings to continue it, or start a new chat."
msgstr "Bu sohbet %1% ile çalışıyordu ve şu anda ayarlı bir %1% API anahtarı yok. Devam etmek için anahtarı yapay zeka ayarlarına ekleyin veya yeni bir sohbet başlatın."

# AI Translated
msgid "JusPrin hasn't loaded the AI models for your account yet. Try again in a moment."
msgstr "JusPrin hesabınız için yapay zeka modellerini henüz yüklemedi. Birazdan yeniden deneyin."

# AI Translated
#. TRN %1% is an AI provider, such as OpenAI.
#, boost-format
msgid "No %1% API key is set up. Add it in the AI settings, or choose another model."
msgstr "Ayarlı bir %1% API anahtarı yok. Anahtarı yapay zeka ayarlarına ekleyin veya başka bir model seçin."

# AI Translated
msgid "A connection is already being saved."
msgstr "Bir bağlantı zaten kaydediliyor."

# AI Translated
msgid "JusPrin's connection helper is missing. Reinstall or rebuild JusPrin."
msgstr "JusPrin'in bağlantı yardımcısı eksik. JusPrin'i yeniden yükleyin veya yeniden derleyin."

# AI Translated
msgid "The AppImage launcher is missing. Reopen the installed AppImage."
msgstr "AppImage başlatıcısı eksik. Kurulu AppImage'ı yeniden açın."

# AI Translated
msgid "Review the change before connecting."
msgstr "Bağlanmadan önce değişikliği gözden geçirin."

# AI Translated
#. TRN %1% is an AI client app, such as Claude Code.
#, boost-format
msgid "%1% isn't installed. Install it, or copy the command and run it later."
msgstr "%1% yüklü değil. Yükleyin veya komutu kopyalayıp daha sonra çalıştırın."

# AI Translated
msgid "This build cannot run the client CLI."
msgstr "Bu derleme istemcinin CLI aracını çalıştıramıyor."

# AI Translated
msgid "The provider did not answer."
msgstr "Sağlayıcı yanıt vermedi."

# AI Translated
msgid "Attach files"
msgstr "Dosya ekle"

# AI Translated
msgid "The AI panel could not connect"
msgstr "Yapay zeka paneli bağlanamadı"

# AI Translated
msgid "Back to Prepare"
msgstr "Hazırlık'a dön"

# AI Translated
msgid "Open filament settings"
msgstr "Filament ayarlarını aç"

# AI Translated
msgid "The packaged AI page is missing from this build."
msgstr "Paketlenmiş yapay zeka sayfası bu derlemede eksik."

# AI Translated
msgid "The system web view could not be created."
msgstr "Sistem web görünümü oluşturulamadı."

# AI Translated
msgid "The AI page failed to load."
msgstr "Yapay zeka sayfası yüklenemedi."

# AI Translated
msgid "The AI page did not complete the bridge handshake."
msgstr "Yapay zeka sayfası köprü el sıkışmasını tamamlamadı."

# AI Translated
msgid "Restart the application to load the AI page."
msgstr "Yapay zeka sayfasını yüklemek için uygulamayı yeniden başlatın."

# AI Translated
msgid "This is an internal connection between the application and its AI panel, not a network service."
msgstr "Bu, uygulama ile yapay zeka paneli arasındaki dahili bir bağlantıdır, bir ağ hizmeti değildir."

# AI Translated
#. TRN %1% is the web view's own error text.
#, boost-format
msgid "Last load error: %1%"
msgstr "Son yükleme hatası: %1%"

# AI Translated
#. TRN The messages the app and its AI panel exchanged. %1% and %2% are counts.
#, boost-format
msgid "Bridge traffic: %1% sent / %2% received"
msgstr "Köprü trafiği: %1% gönderildi / %2% alındı"

# AI Translated
#. TRN %1% is the AI service's own reason, in English, such as "cyber".
#, boost-format
msgid "The AI service declined to answer (%1%)."
msgstr "Yapay zeka hizmeti yanıt vermeyi reddetti (%1%)."

# AI Translated
msgid "This version of JusPrin can no longer connect to JusPrin accounts. Get the new version to keep using your account."
msgstr "JusPrin'in bu sürümü artık JusPrin hesaplarına bağlanamıyor. Hesabınızı kullanmaya devam etmek için yeni sürümü edinin."

# AI Translated
msgid "Your JusPrin sign-in has ended. Sign in again in Preferences, then try again."
msgstr "JusPrin oturumunuz sona erdi. Tercihler'de yeniden oturum açın, sonra yeniden deneyin."

# AI Translated
msgid "Signing in didn't finish. Nothing was saved. Try again."
msgstr "Oturum açma tamamlanmadı. Hiçbir şey kaydedilmedi. Yeniden deneyin."

# AI Translated
msgid "JusPrin couldn't be reached to finish signing in. Try again."
msgstr "Oturum açmayı tamamlamak için JusPrin'e ulaşılamadı. Yeniden deneyin."

# AI Translated
msgid "JusPrin has no AI model for this account right now. Try again later."
msgstr "JusPrin'de şu anda bu hesap için bir yapay zeka modeli yok. Daha sonra yeniden deneyin."

# AI Translated
msgid "another app"
msgstr "başka bir uygulama"

