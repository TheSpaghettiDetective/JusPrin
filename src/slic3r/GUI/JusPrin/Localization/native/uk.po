# AI Translated
# Needs human review: Meaning of 'until restoration is recovered': check the chat is blocked until a failed restore is put right.
msgid "Project chat is blocked until restoration is recovered."
msgstr "Чат проєкту заблоковано, доки не вдасться завершити відновлення."

# AI Translated
msgid "Return to the active chat or restore this chat before sending."
msgstr "Перш ніж надсилати, поверніться до активного чату або відновіть цей чат."

# AI Translated
msgid "Finish or cancel AI configuration before sending a message."
msgstr "Завершіть або скасуйте налаштування ШІ, перш ніж надсилати повідомлення."

# AI Translated
msgid "This message belongs to a different chat."
msgstr "Це повідомлення належить до іншого чату."

# AI Translated
msgid "A message needs text or an attachment."
msgstr "Повідомлення має містити текст або вкладення."

# AI Translated
msgid "The file could not be read."
msgstr "Не вдалося прочитати файл."

# AI Translated
msgid "This file is too large to attach."
msgstr "Цей файл завеликий для вкладення."

# AI Translated
msgid "This file type can't be read by AI."
msgstr "ШІ не може прочитати файли цього типу."

# AI Translated
msgid "This file is not readable UTF-8 text."
msgstr "Цей файл не є коректним текстом у кодуванні UTF-8."

# AI Translated
msgid "The attachment could not be stored."
msgstr "Не вдалося зберегти вкладення."

# AI Translated
msgid "Photo or image"
msgstr "Фото або зображення"

# AI Translated
msgid "3D model"
msgstr "3D-модель"

# AI Translated
msgid "Document (PDF)"
msgstr "Документ (PDF)"

# AI Translated
msgid "This build cannot open a file dialog."
msgstr "Ця збірка програми не може відкрити вікно вибору файлу."

# AI Translated
# Needs human review: %1% is where the calibration was started from; check 'Звідки:' reads right with the real values.
#. TRN A calibration chat's first line. %1%: where it was started from, %2%: a printer.
#, boost-format
msgid "From %1% · %2% · filament not chosen · temporary test settings"
msgstr "Звідки: %1% · %2% · філамент не вибрано · тимчасові тестові налаштування"

# AI Translated
# Needs human review: %1% is where the calibration was started from; check 'Звідки:' reads right with the real values.
#. TRN A calibration chat's first line. %1%: where it was started from, %2%: a filament, %3%: a printer.
#, boost-format
msgid "From %1% · %2% on %3% · temporary test settings"
msgstr "Звідки: %1% · %2% на %3% · тимчасові тестові налаштування"

# AI Translated
#. TRN A reopened calibration test's line. %1%: the day it was made, as "21 Oct 2026".
#, boost-format
msgid "Reopened · generated %1%"
msgstr "Відкрито повторно · створено %1%"

# AI Translated
#. TRN %1%: where the test was opened from, %2%: the day it was made, as "21 Oct 2026".
#, boost-format
msgid "Opened from %1% · generated %2%"
msgstr "Відкрито з: %1% · створено %2%"

# AI Translated
#. TRN %1% is a calibration result, such as 215 °C.
#, boost-format
msgid "result %1% saved"
msgstr "результат %1% збережено"

# AI Translated
#. TRN %1% is a plate's name, %2% why the slice did not succeed.
#, boost-format
msgid "The app did not slice %1%: %2%"
msgstr "Програма не нарізала %1%: %2%"

# AI Translated
#. TRN %1% is a plate's name, %2% why the slice did not succeed.
#, boost-format
msgid "The app stopped the slice of %1%: %2%"
msgstr "Програма зупинила нарізку %1%: %2%"

# AI Translated
msgid "The slice of every plate finished."
msgstr "Нарізку всіх пластин завершено."

# AI Translated
#. TRN %1% is a plate's name.
#, boost-format
msgid "The slice of %1% finished."
msgstr "Нарізку %1% завершено."

# AI Translated
msgid "Historical replies cannot be retried."
msgstr "Відповіді з історії не можна повторити."

# AI Translated
msgid "Only a failed or stopped assistant message in the active conversation can be retried."
msgstr "Повторити можна лише невдале або зупинене повідомлення асистента в активній розмові."

# AI Translated
msgid "Only the chat's last reply can be retried."
msgstr "Повторити можна лише останню відповідь чату."

# AI Translated
msgid "Another reply is currently streaming."
msgstr "Зараз надходить інша відповідь."

# AI Translated
msgid "Historical tool actions cannot be changed."
msgstr "Дії інструментів з історії не можна змінити."

# AI Translated
msgid "This proposal is no longer open. Ask AI again."
msgstr "Ця пропозиція вже закрита. Запитайте ШІ ще раз."

# AI Translated
msgid "This save can no longer be undone."
msgstr "Це збереження вже не можна скасувати."

# AI Translated
msgid "The earlier values cannot be put back."
msgstr "Попередні значення не можна повернути."

# AI Translated
msgid "Finish or resolve pending work before creating a chat."
msgstr "Завершіть або вирішіть незавершені дії, перш ніж створювати чат."

# AI Translated
msgid "The current chat could not be saved."
msgstr "Не вдалося зберегти поточний чат."

# AI Translated
msgid "The new chat could not be saved."
msgstr "Не вдалося зберегти новий чат."

# AI Translated
msgid "The selected chat could not be saved."
msgstr "Не вдалося зберегти вибраний чат."

# AI Translated
msgid "The project or selected chat changed. Review it again."
msgstr "Проєкт або вибраний чат змінився. Перегляньте його ще раз."

# AI Translated
msgid "Finish or resolve pending work before resuming a chat."
msgstr "Завершіть або вирішіть незавершені дії, перш ніж продовжити чат."

# AI Translated
msgid "This chat is already active."
msgstr "Цей чат уже активний."

# AI Translated
msgid "JusPrin can't find the project version this chat was working on."
msgstr "JusPrin не може знайти версію проєкту, з якою працював цей чат."

# AI Translated
msgid "The current project could not be saved before restoration."
msgstr "Не вдалося зберегти поточний проєкт перед відновленням."

# AI Translated
msgid "JusPrin couldn't put the project back."
msgstr "JusPrin не вдалося відновити проєкт."

# AI Translated
msgid "Restored this chat's saved project setup. Check the current printer and material before printing."
msgstr "Відновлено збережені налаштування проєкту цього чату. Перед друком перевірте поточний принтер і матеріал."

# AI Translated
msgid "Use a non-empty, single-line title of at most 120 characters for an existing chat."
msgstr "Для наявного чату вкажіть непорожню однорядкову назву довжиною до 120 символів."

# AI Translated
msgid "This chat is still working. Stop it or let it finish, then delete it."
msgstr "Цей чат ще працює. Зупиніть його або дочекайтеся завершення, а потім видаліть."

# AI Translated
msgid "This chat no longer exists."
msgstr "Цього чату більше не існує."

# AI Translated
msgid "The replacement chat could not be saved."
msgstr "Не вдалося зберегти чат, що його замінює."

# AI Translated
msgid "Historical chats cannot edit the current draft."
msgstr "Чати з історії не можуть змінювати поточну чернетку."

# AI Translated
msgid "Finish or stop the current reply before configuring AI."
msgstr "Завершіть або зупиніть поточну відповідь, перш ніж налаштовувати ШІ."

# AI Translated
msgid "This build cannot configure an AI provider."
msgstr "Ця збірка програми не може налаштувати постачальника ШІ."

# AI Translated
msgid "A credential check is already running."
msgstr "Перевірка облікових даних уже виконується."

# AI Translated
msgid "This build cannot verify a key for that provider yet."
msgstr "Ця збірка програми поки не може перевірити ключ для цього постачальника."

# AI Translated
msgid "Finish or stop the current reply before removing a key."
msgstr "Завершіть або зупиніть поточну відповідь, перш ніж видаляти ключ."

# AI Translated
msgid "Finish or cancel the key check before removing a key."
msgstr "Завершіть або скасуйте перевірку ключа, перш ніж видаляти ключ."

# AI Translated
msgid "That key could not be removed."
msgstr "Не вдалося видалити цей ключ."

# AI Translated
msgid "This build cannot sign in to a JusPrin account."
msgstr "У цій збірці програми не можна увійти в обліковий запис JusPrin."

# AI Translated
msgid "Finish or stop the current reply before signing in."
msgstr "Завершіть або зупиніть поточну відповідь, перш ніж входити."

# AI Translated
msgid "A sign-in or key check is already running."
msgstr "Вхід або перевірка ключа вже виконується."

# AI Translated
msgid "There is no JusPrin account on this computer to check."
msgstr "На цьому компʼютері немає облікового запису JusPrin, який можна перевірити."

# AI Translated
msgid "JusPrin couldn't start signing in. Try again."
msgstr "JusPrin не вдалося почати вхід. Спробуйте ще раз."

# AI Translated
msgid "JusPrin couldn't sign you in. Try again."
msgstr "JusPrin не вдалося виконати вхід. Спробуйте ще раз."

# AI Translated
msgid "This sign-in could not be saved, so you will have to sign in again next time JusPrin starts."
msgstr "Не вдалося зберегти дані входу, тож під час наступного запуску JusPrin доведеться увійти знову."

# AI Translated
msgid "This key could not be saved, so it will have to be entered again next time JusPrin starts."
msgstr "Не вдалося зберегти цей ключ, тож під час наступного запуску JusPrin його доведеться ввести знову."

# AI Translated
msgid "The panel is still loading. Try again in a moment."
msgstr "Панель ще завантажується. Спробуйте ще раз за мить."

# AI Translated
msgid "The AI service is not available."
msgstr "Сервіс ШІ недоступний."

# AI Translated
msgid "The AI service could not start this request."
msgstr "Сервісу ШІ не вдалося почати виконання цього запиту."

# AI Translated
msgid "AI could not receive the native tool result."
msgstr "ШІ не вдалося отримати результат інструмента програми."

# AI Translated
msgid "The AI request failed."
msgstr "Запит до ШІ не вдався."

# AI Translated
msgid "The automatic chat title could not be generated. You can rename the chat."
msgstr "Не вдалося автоматично створити назву чату. Ви можете перейменувати чат."

# AI Translated
#. TRN %1% is an AI provider's account, such as JusPrin.
#, boost-format
msgid "This chat ran on your %1% account. Sign in again to continue it, or start a new chat."
msgstr "Цей чат працював через ваш обліковий запис %1%. Увійдіть знову, щоб продовжити його, або почніть новий чат."

# AI Translated
#. TRN %1% is an AI provider, such as OpenAI.
#, boost-format
msgid "This chat ran on %1%, and no %1% API key is set up now. Add the key in the AI settings to continue it, or start a new chat."
msgstr "Цей чат працював через %1%, а ключ API %1% зараз не налаштовано. Додайте ключ у налаштуваннях ШІ, щоб продовжити чат, або почніть новий."

# AI Translated
msgid "JusPrin hasn't loaded the AI models for your account yet. Try again in a moment."
msgstr "JusPrin ще не завантажив моделі ШІ для вашого облікового запису. Спробуйте ще раз за мить."

# AI Translated
#. TRN %1% is an AI provider, such as OpenAI.
#, boost-format
msgid "No %1% API key is set up. Add it in the AI settings, or choose another model."
msgstr "Ключ API %1% не налаштовано. Додайте його в налаштуваннях ШІ або виберіть іншу модель."

# AI Translated
msgid "A connection is already being saved."
msgstr "Підключення вже зберігається."

# AI Translated
msgid "JusPrin's connection helper is missing. Reinstall or rebuild JusPrin."
msgstr "Бракує помічника підключення JusPrin. Перевстановіть або перезберіть JusPrin."

# AI Translated
msgid "The AppImage launcher is missing. Reopen the installed AppImage."
msgstr "Бракує запускача AppImage. Відкрийте встановлений AppImage ще раз."

# AI Translated
msgid "Review the change before connecting."
msgstr "Перегляньте зміну, перш ніж підключатися."

# AI Translated
#. TRN %1% is an AI client app, such as Claude Code.
#, boost-format
msgid "%1% isn't installed. Install it, or copy the command and run it later."
msgstr "%1% не встановлено. Установіть його або скопіюйте команду й виконайте її пізніше."

# AI Translated
msgid "This build cannot run the client CLI."
msgstr "Ця збірка програми не може запустити CLI клієнта."

# AI Translated
msgid "This build cannot open a file manager."
msgstr "Ця збірка програми не може відкрити файловий менеджер."

# AI Translated
msgid "The provider did not answer."
msgstr "Постачальник не відповів."

# AI Translated
msgid "Attach files"
msgstr "Вкласти файли"

# AI Translated
msgid "The AI panel could not connect"
msgstr "Не вдалося підключити панель ШІ"

# AI Translated
msgid "Back to Prepare"
msgstr "Назад до «Підготовки»"

# AI Translated
msgid "Open filament settings"
msgstr "Відкрити налаштування філаменту"

# AI Translated
msgid "The packaged AI page is missing from this build."
msgstr "У цій збірці програми бракує вбудованої сторінки ШІ."

# AI Translated
msgid "The system web view could not be created."
msgstr "Не вдалося створити системний вебперегляд."

# AI Translated
msgid "The AI page failed to load."
msgstr "Не вдалося завантажити сторінку ШІ."

# AI Translated
msgid "The AI page did not complete the bridge handshake."
msgstr "Сторінка ШІ не завершила встановлення звʼязку з програмою."

# AI Translated
msgid "Restart the application to load the AI page."
msgstr "Перезапустіть програму, щоб завантажити сторінку ШІ."

# AI Translated
msgid "This is an internal connection between the application and its AI panel, not a network service."
msgstr "Це внутрішнє зʼєднання між програмою та її панеллю ШІ, а не мережевий сервіс."

# AI Translated
#. TRN %1% is the web view's own error text.
#, boost-format
msgid "Last load error: %1%"
msgstr "Остання помилка завантаження: %1%"

# AI Translated
#. TRN The messages the app and its AI panel exchanged. %1% and %2% are counts.
#, boost-format
msgid "Bridge traffic: %1% sent / %2% received"
msgstr "Обмін повідомленнями: надіслано %1% / отримано %2%"

# AI Translated
msgid "The AI service returned an unreadable streaming response."
msgstr "Сервіс ШІ повернув потокову відповідь, яку неможливо прочитати."

# AI Translated
msgid "The AI service streamed a delta for a block it never opened."
msgstr "Сервіс ШІ надіслав у потоці дані для блоку, який не відкривав."

# AI Translated
msgid "The AI service sent a tool call whose arguments are not JSON."
msgstr "Сервіс ШІ надіслав виклик інструмента з аргументами не у форматі JSON."

# AI Translated
msgid "The AI service could not complete the response."
msgstr "Сервісу ШІ не вдалося завершити відповідь."

# AI Translated
#. TRN %1% is the AI service's own reason, in English, such as "cyber".
#, boost-format
msgid "The AI service declined to answer (%1%)."
msgstr "Сервіс ШІ відмовився відповідати (%1%)."

# AI Translated
msgid "The AI service ended its response for a reason this build does not know."
msgstr "Сервіс ШІ завершив відповідь із причини, невідомої цій збірці програми."

# AI Translated
msgid "This version of JusPrin can no longer connect to JusPrin accounts. Get the new version to keep using your account."
msgstr "Ця версія JusPrin більше не може підключатися до облікових записів JusPrin. Отримайте нову версію, щоб і далі користуватися обліковим записом."

# AI Translated
msgid "Signing in didn't finish. Nothing was saved. Try again."
msgstr "Вхід не завершено. Нічого не збережено. Спробуйте ще раз."

# AI Translated
msgid "JusPrin couldn't be reached to finish signing in. Try again."
msgstr "Не вдалося звʼязатися з JusPrin, щоб завершити вхід. Спробуйте ще раз."

# AI Translated
msgid "JusPrin has no AI model for this account right now. Try again later."
msgstr "Зараз для цього облікового запису в JusPrin немає моделі ШІ. Спробуйте пізніше."

# AI Translated
msgid "Restored an earlier project version"
msgstr "Відновлено попередню версію проєкту"

# AI Translated
msgid "Restored this chat's saved project setup"
msgstr "Відновлено збережені налаштування проєкту цього чату"

# AI Translated
#. TRN The chat list's preview of a message that has only attachments.
msgid "Attachment"
msgstr "Вкладення"

# AI Translated
msgid "The AI service stopped before finishing its response."
msgstr "Сервіс ШІ зупинився, не завершивши відповідь."

# AI Translated
msgid "The AI service kept pausing its response."
msgstr "Сервіс ШІ постійно призупиняв відповідь."

# AI Translated
msgid "AI could not be asked to continue its response."
msgstr "Не вдалося попросити ШІ продовжити відповідь."

# AI Translated
msgid "AI could not be told the results of its tool calls."
msgstr "Не вдалося передати ШІ результати викликів інструментів."

# AI Translated
msgid "AI returned an invalid tool call."
msgstr "ШІ повернув недійсний виклик інструмента."

# AI Translated
msgid "The AI service ended before a complete response arrived."
msgstr "Сервіс ШІ завершив роботу, не надіславши повної відповіді."

# AI Translated
msgid "Your JusPrin sign-in has ended. Sign in again in Preferences, then try again."
msgstr "Ваш сеанс входу в JusPrin завершився. Увійдіть знову в налаштуваннях і спробуйте ще раз."

# AI Translated
#, boost-format
msgid "This message needs %1% credit; you have %2%."
msgid_plural "This message needs %1% credits; you have %2%."
msgstr[0] "Цьому повідомленню потрібен %1% кредит; у вас %2%."
msgstr[1] "Цьому повідомленню потрібно %1% кредити; у вас %2%."
msgstr[2] "Цьому повідомленню потрібно %1% кредитів; у вас %2%."
msgstr[3] "Цьому повідомленню потрібно %1% кредиту; у вас %2%."

# AI Translated
msgid "You're out of credits."
msgstr "У вас закінчилися кредити."

# AI Translated
#. TRN %1% is an AI provider, such as OpenAI.
#, boost-format
msgid "The %1% API key was rejected. Update the AI configuration and try again."
msgstr "Ключ API %1% відхилено. Оновіть налаштування ШІ та спробуйте ще раз."

# AI Translated
#. TRN %1% is an AI provider, such as OpenAI.
#, boost-format
msgid "The request was too large for the %1% service."
msgstr "Запит завеликий для сервісу %1%."

# AI Translated
#. TRN %1% is an AI provider, such as OpenAI.
#, boost-format
msgid "The %1% service is rate limited. Try again shortly."
msgstr "Сервіс %1% обмежує частоту запитів. Спробуйте трохи згодом."

# AI Translated
#. TRN %1% is an AI provider, such as OpenAI.
#, boost-format
msgid "The %1% service is overloaded. Try again shortly."
msgstr "Сервіс %1% перевантажений. Спробуйте трохи згодом."

# AI Translated
#. TRN %1% is an AI provider, such as OpenAI.
#, boost-format
msgid "The %1% service is temporarily unavailable."
msgstr "Сервіс %1% тимчасово недоступний."

# AI Translated
msgid "The AI request timed out."
msgstr "Час очікування запиту до ШІ минув."

# AI Translated
#. TRN %1% is an AI provider, such as OpenAI.
#, boost-format
msgid "The AI request could not reach the %1% service."
msgstr "Запит до ШІ не зміг дістатися сервісу %1%."

# AI Translated
msgid "The AI service response did not contain valid output."
msgstr "Відповідь сервісу ШІ не містить коректного результату."

# AI Translated
#. TRN A button that asks the AI to choose another block of a calibration test.
msgid "Pick another block"
msgstr "Вибрати інший блок"

# AI Translated
#. TRN A button that asks the AI to choose another tile of a calibration test.
msgid "Pick another tile"
msgstr "Вибрати іншу плитку"

# AI Translated
#. TRN A button that asks the AI to choose another line of a calibration test.
msgid "Pick another line"
