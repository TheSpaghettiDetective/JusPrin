msgstr "Ви вже відкривали цей файл. Відкрийте наявний проєкт, щоб продовжити з того місця, де зупинилися, або створіть новий проєкт із цього файлу."

# AI Translated
msgid "Previously opened file"
msgstr "Раніше відкритий файл"

# AI Translated
msgid "Continue current project"
msgstr "Продовжити поточний проєкт"

# AI Translated
msgid "Open most recent project"
msgstr "Відкрити останній проєкт"

# AI Translated
msgid "Open existing project"
msgstr "Відкрити наявний проєкт"

# AI Translated
