# AI Translated
#. TRN %1% is a calibration result, such as 215 °C.
#, boost-format
msgid "result %1% saved"
msgstr "emaitza gordeta: %1%"

# AI Translated
#. TRN %1% is a plate's name, %2% why the slice did not succeed.
#, boost-format
msgid "The app did not slice %1%: %2%"
msgstr "Aplikazioak ez du xerratu %1%: %2%"

# AI Translated
#. TRN %1% is a plate's name, %2% why the slice did not succeed.
#, boost-format
msgid "The app stopped the slice of %1%: %2%"
msgstr "Aplikazioak xerratzea gelditu du (%1%): %2%"

# AI Translated
msgid "The slice of every plate finished."
msgstr "Plaka guztien xerratzea amaitu da."

# AI Translated
#. TRN %1% is a plate's name.
#, boost-format
msgid "The slice of %1% finished."
msgstr "Xerratzea amaitu da: %1%."

# AI Translated
msgid "Restored this chat's saved project setup. Check the current printer and material before printing."
msgstr "Txat honen proiektuaren konfigurazio gordea leheneratu da. Egiaztatu uneko inprimagailua eta materiala inprimatu aurretik."

# AI Translated
msgid "A credential check is already running."
msgstr "Kredentzial-egiaztapen bat abian da jada."

# AI Translated
msgid "This build cannot verify a key for that provider yet."
msgstr "Konpilazio honek ezin du oraindik hornitzaile horren gakorik egiaztatu."

# AI Translated
msgid "A sign-in or key check is already running."
msgstr "Saio-hasiera edo gako-egiaztapen bat abian da jada."

# AI Translated
msgid "JusPrin couldn't sign you in. Try again."
msgstr "JusPrin-ek ezin izan dizu saioa hasi. Saiatu berriro."

# AI Translated
msgid "The AI service is not available."
msgstr "AA zerbitzua ez dago erabilgarri."

# AI Translated
msgid "The AI service could not start this request."
msgstr "AA zerbitzuak ezin izan du eskaera hau abiarazi."

# AI Translated
msgid "AI could not receive the native tool result."
msgstr "AAk ezin izan du tresna natiboaren emaitza jaso."

# AI Translated
msgid "The AI request failed."
msgstr "AA eskaerak huts egin du."

# AI Translated
#. TRN The heading of the chat's model menu over a model that runs on this computer.
msgid "On this computer"
msgstr "Ordenagailu honetan"

# AI Translated
msgid "This chat ran on a model on this computer that is no longer set up. Set it up again in the AI settings to continue it, or start a new chat."
msgstr "Txat hau ordenagailu honetako modelo batekin exekutatu zen, eta modelo hori ez dago jada konfiguratuta. Konfiguratu berriro AA ezarpenetan jarraitzeko, edo hasi txat berri bat."

# AI Translated
#. TRN %1% is an AI provider's account, such as JusPrin.
#, boost-format
msgid "This chat ran on your %1% account. Sign in again to continue it, or start a new chat."
msgstr "Txat hau zure %1% kontuan exekutatu zen. Hasi saioa berriro jarraitzeko, edo hasi txat berri bat."

# AI Translated
#. TRN %1% is an AI provider, such as OpenAI.
#, boost-format
msgid "This chat ran on %1%, and no %1% API key is set up now. Add the key in the AI settings to continue it, or start a new chat."
msgstr "Txat hau %1% erabiliz exekutatu zen, eta orain ez dago %1% API gakorik konfiguratuta. Gehitu gakoa AA ezarpenetan jarraitzeko, edo hasi txat berri bat."

# AI Translated
msgid "JusPrin hasn't loaded the AI models for your account yet. Try again in a moment."
msgstr "JusPrin-ek oraindik ez ditu kargatu zure konturako AA modeloak. Saiatu berriro une batean."

# AI Translated
#. TRN %1% is an AI provider, such as OpenAI.
#, boost-format
msgid "No %1% API key is set up. Add it in the AI settings, or choose another model."
msgstr "Ez dago %1% API gakorik konfiguratuta. Gehitu AA ezarpenetan, edo aukeratu beste modelo bat."

# AI Translated
msgid "A connection is already being saved."
msgstr "Konexio bat gordetzen ari da jada."

# AI Translated
msgid "JusPrin's connection helper is missing. Reinstall or rebuild JusPrin."
msgstr "JusPrin-en konexio-laguntzailea falta da. Instalatu edo konpilatu berriro JusPrin."

# AI Translated
msgid "The AppImage launcher is missing. Reopen the installed AppImage."
msgstr "AppImage abiarazlea falta da. Ireki berriro instalatutako AppImage-a."

# AI Translated
msgid "Review the change before connecting."
msgstr "Berrikusi aldaketa konektatu aurretik."

# AI Translated
#. TRN %1% is an AI client app, such as Claude Code.
#, boost-format
msgid "%1% isn't installed. Install it, or copy the command and run it later."
msgstr "%1% ez dago instalatuta. Instalatu, edo kopiatu komandoa eta exekutatu geroago."

# AI Translated
msgid "This build cannot run the client CLI."
msgstr "Konpilazio honek ezin du bezeroaren CLIa exekutatu."

# AI Translated
msgid "The provider did not answer."
msgstr "Hornitzaileak ez du erantzun."

# AI Translated
msgid "Attach files"
msgstr "Erantsi fitxategiak"

# AI Translated
msgid "The AI panel could not connect"
msgstr "AA panela ezin izan da konektatu"

# AI Translated
msgid "Back to Prepare"
msgstr "Itzuli Prestatu fitxara"

# AI Translated
msgid "Open filament settings"
msgstr "Ireki filamentuaren ezarpenak"

# AI Translated
msgid "The packaged AI page is missing from this build."
msgstr "Paketatutako AA orria falta da konpilazio honetan."

# AI Translated
msgid "The system web view could not be created."
msgstr "Ezin izan da sistemaren web-ikuspegia sortu."

# AI Translated
msgid "The AI page failed to load."
msgstr "Ezin izan da AA orria kargatu."

# AI Translated
msgid "The AI page did not complete the bridge handshake."
msgstr "AA orriak ez du zubiaren hasierako konexio-trukea osatu."

# AI Translated
msgid "Restart the application to load the AI page."
msgstr "Berrabiarazi aplikazioa AA orria kargatzeko."

# AI Translated
msgid "This is an internal connection between the application and its AI panel, not a network service."
msgstr "Hau aplikazioaren eta haren AA panelaren arteko barne-konexio bat da, ez sare-zerbitzu bat."

# AI Translated
#. TRN %1% is the web view's own error text.
#, boost-format
msgid "Last load error: %1%"
msgstr "Azken kargatze-errorea: %1%"

# AI Translated
#. TRN The messages the app and its AI panel exchanged. %1% and %2% are counts.
#, boost-format
msgid "Bridge traffic: %1% sent / %2% received"
msgstr "Zubiko trafikoa: %1% bidalita / %2% jasota"

# AI Translated
#. TRN %1% is the AI service's own reason, in English, such as "cyber".
#, boost-format
msgid "The AI service declined to answer (%1%)."
msgstr "AA zerbitzuak erantzuteari uko egin dio (%1%)."

# AI Translated
msgid "This version of JusPrin can no longer connect to JusPrin accounts. Get the new version to keep using your account."
msgstr "JusPrin-en bertsio honek ezin du jada JusPrin kontuetara konektatu. Lortu bertsio berria zure kontua erabiltzen jarraitzeko."

# AI Translated
msgid "Your JusPrin sign-in has ended. Sign in again in Preferences, then try again."
msgstr "Zure JusPrin saioa amaitu da. Hasi saioa berriro Hobespenetan, eta saiatu berriro."

# AI Translated
msgid "Signing in didn't finish. Nothing was saved. Try again."
msgstr "Saio-hasiera ez da amaitu. Ez da ezer gorde. Saiatu berriro."

# AI Translated
msgid "JusPrin couldn't be reached to finish signing in. Try again."
msgstr "Ezin izan da JusPrin-ekin konektatu saio-hasiera amaitzeko. Saiatu berriro."

# AI Translated
msgid "JusPrin has no AI model for this account right now. Try again later."
msgstr "JusPrin-ek ez du AA modelorik kontu honetarako une honetan. Saiatu berriro geroago."

# AI Translated
msgid "another app"
msgstr "beste aplikazio bat"

# AI Translated
