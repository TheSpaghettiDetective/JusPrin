# AI Translated
msgid "Something went wrong on our side"
msgstr "Zerbait gaizki atera da gure aldetik"

# AI Translated
#. TRN Said in the chat when a project opens whose chats a newer version of JusPrin saved; they are kept, not shown.
msgid "This project's chats were saved by a newer version of JusPrin. Get the new version to see them."
msgstr "Proiektu honen txatak JusPrin-en bertsio berriago batek gorde zituen. Lortu bertsio berria ikusteko."

# AI Translated
msgid "Project chat is blocked until restoration is recovered."
msgstr "Proiektuaren txata blokeatuta dago leheneratzea berreskuratu arte."

# AI Translated
msgid "Return to the active chat or restore this chat before sending."
msgstr "Itzuli txat aktibora edo leheneratu txat hau bidali aurretik."

# AI Translated
msgid "Finish or cancel AI configuration before sending a message."
msgstr "Amaitu edo utzi AAren konfigurazioa mezu bat bidali aurretik."

# AI Translated
msgid "This file is too large to attach."
msgstr "Fitxategi hau handiegia da eransteko."

# AI Translated
msgid "This file type can't be read by AI."
msgstr "AAk ezin du mota honetako fitxategirik irakurri."

# AI Translated
msgid "This file is not readable UTF-8 text."
msgstr "Fitxategi hau ez da UTF-8 testu irakurgarria."

# AI Translated
msgid "Photo or image"
msgstr "Argazkia edo irudia"

# AI Translated
msgid "3D model"
msgstr "3D modeloa"

# AI Translated
msgid "Document (PDF)"
msgstr "Dokumentua (PDF)"

# AI Translated
