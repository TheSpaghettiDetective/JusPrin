# AI Translated
msgid "An earlier model version was restored"
msgstr "Modeloaren aurreko bertsio bat leheneratu da"

# AI Translated
msgid "Restored this chat's saved project setup"
msgstr "Txat honen proiektuaren konfigurazio gordea leheneratu da"

# AI Translated
#. TRN The chat list's preview of a message that has only attachments.
msgid "Attachment"
msgstr "Eranskina"

# AI Translated
# Needs human review: The service name stays without a case ending ("%1% zerbitzuan"); check it reads naturally.
#. TRN %1% is an AI provider, such as OpenAI: the person's own account there has no credits left.
#, boost-format
msgid "Your %1% account is out of credits. Add credits at %1%, then try again."
msgstr "Zure %1% kontuak ez du krediturik. Gehitu kredituak %1% zerbitzuan, eta saiatu berriro."

# AI Translated
#. TRN %1% is an AI provider, such as OpenAI.
#, boost-format
msgid "The %1% service is rate limited. Try again shortly."
msgstr "%1% zerbitzuak eskaerak mugatu ditu. Saiatu berriro laster."

# AI Translated
#. TRN %1% is an AI provider, such as OpenAI.
#, boost-format
msgid "The request was too large for the %1% service."
msgstr "Eskaera handiegia zen %1% zerbitzurako."

# AI Translated
#, boost-format
msgid "Nothing is answering at %1%. Start Ollama or LM Studio, then try again."
msgstr "Ezerk ez du erantzuten %1% helbidean. Abiarazi Ollama edo LM Studio, eta saiatu berriro."

# AI Translated
msgid "This model can't run the app's tools. Pick a model with tool support and a context of at least 32k."
msgstr "Modelo honek ezin ditu aplikazioaren tresnak exekutatu. Aukeratu tresnak onartzen dituen eta gutxienez 32k-ko testuingurua duen modelo bat."

# AI Translated
#. TRN %1% is an AI provider, such as OpenAI.
#, boost-format
msgid "The AI request could not reach the %1% service."
msgstr "AA eskaerak ezin izan du %1% zerbitzura iritsi."

# AI Translated
#, boost-format
msgid "This message needs %1% credit; you have %2%."
msgid_plural "This message needs %1% credits; you have %2%."
msgstr[0] "Mezu honek kreditu %1% behar du; %2% dituzu."
msgstr[1] "Mezu honek %1% kreditu behar ditu; %2% dituzu."

# AI Translated
#. TRN %1% is an AI provider, such as OpenAI.
#, boost-format
msgid "The %1% API key was rejected. Update the AI configuration and try again."
msgstr "%1% API gakoa baztertu egin da. Eguneratu AAren konfigurazioa eta saiatu berriro."

# AI Translated
#. TRN %1% is how many settings, %2% an object's name or a preset's name in quotes, %3% the settings' keys.
#, boost-format
msgid "Change %1% setting of %2%: %3%"
msgid_plural "Change %1% settings of %2%: %3%"
msgstr[0] "%2%: aldatu %1% ezarpen (%3%)"
msgstr[1] "%2%: aldatu %1% ezarpen (%3%)"

# AI Translated
#. TRN %1% is how many settings, %2% a preset's name in quotes, %3% the settings' keys. The preset is saved with them.
#, boost-format
msgid "Change %1% setting of %2%: %3%; save it"
msgid_plural "Change %1% settings of %2%: %3%; save it"
msgstr[0] "%2%: aldatu %1% ezarpen (%3%) eta gorde"
msgstr[1] "%2%: aldatu %1% ezarpen (%3%) eta gorde"

# AI Translated
#. TRN %1% is how many settings, %2% a preset's name in quotes, %3% the settings' keys, %4% the new preset's name.
#, boost-format
msgid "Change %1% setting of %2%: %3%; save as \"%4%\""
msgid_plural "Change %1% settings of %2%: %3%; save as \"%4%\""
msgstr[0] "%2%: aldatu %1% ezarpen (%3%) eta gorde \"%4%\" gisa"
msgstr[1] "%2%: aldatu %1% ezarpen (%3%) eta gorde \"%4%\" gisa"

# AI Translated
#. TRN %1% and %2% are the tower's first and last temperatures.
#, boost-format
msgid "Make a temperature tower, %1% °C to %2% °C"
msgstr "Sortu tenperatura-dorre bat, %1% °C-tik %2% °C-ra"

# AI Translated
#. TRN YOLO is the name of OrcaSlicer's quicker flow-ratio test; %1% is its pass, 1 or 2.
#, boost-format
msgid "Make a flow-ratio test, YOLO pass %1%"
msgstr "Sortu fluxu-ratioaren proba bat, YOLO, %1%. pasada"

# AI Translated
#. TRN %1% is the test's pass, 1 or 2.
#, boost-format
msgid "Make a flow-ratio test, classic pass %1%"
msgstr "Sortu fluxu-ratioaren proba bat, klasikoa, %1%. pasada"

# AI Translated
#. TRN %1% and %2% are the first and last pressure-advance values.
#, boost-format
msgid "Make a pressure-advance line, %1% to %2%"
msgstr "Sortu Pressure Advance lerro bat, %1% eta %2% artean"

# AI Translated
#. TRN %1% and %2% are the first and last pressure-advance values.
#, boost-format
msgid "Make a pressure-advance pattern, %1% to %2%"
msgstr "Sortu Pressure Advance eredu bat, %1% eta %2% artean"

# AI Translated
#. TRN %1% and %2% are the first and last pressure-advance values.
#, boost-format
msgid "Make a pressure-advance tower, %1% to %2%"
msgstr "Sortu Pressure Advance dorre bat, %1% eta %2% artean"

# AI Translated
#. TRN A button that asks the AI to choose another block of a calibration test.
msgid "Pick another block"
msgstr "Aukeratu beste bloke bat"

# AI Translated
#. TRN A button that asks the AI to choose another tile of a calibration test.
msgid "Pick another tile"
