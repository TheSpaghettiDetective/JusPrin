msgid "Pick another height"
msgstr "Aukeratu beste altuera bat"

# AI Translated
#. TRN %1% is a preset's name.
#, boost-format
msgid "Preset · %1%"
msgstr "Aurrezarpena · %1%"

# AI Translated
#. TRN %1% is a preset's name.
#, boost-format
msgid "New preset · %1%"
msgstr "Aurrezarpen berria · %1%"

