#, boost-format
msgid "Filament preset · %1%"
msgstr "Filamentu-aurrezarpena · %1%"

# AI Translated
#. TRN The saved preset's receipt: %1% lists the settings saved.
#, boost-format
msgid "Printer preset · %1%"
msgstr "Inprimagailu-aurrezarpena · %1%"

# AI Translated
#. TRN The saved preset's receipt: %1% lists the settings saved.
#, boost-format
msgid "Process preset · %1%"
msgstr "Prozesu-aurrezarpena · %1%"

# AI Translated
