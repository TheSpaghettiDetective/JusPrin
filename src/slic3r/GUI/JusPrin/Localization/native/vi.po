#. TRN %1% is a calibration result, such as 215 °C.
#, boost-format
msgid "result %1% saved"
msgstr "đã lưu kết quả %1%"

# AI Translated
#. TRN %1% is a plate's name, %2% why the slice did not succeed.
#, boost-format
msgid "The app did not slice %1%: %2%"
msgstr "Ứng dụng đã không slice %1%: %2%"

# AI Translated
#. TRN %1% is a plate's name, %2% why the slice did not succeed.
#, boost-format
msgid "The app stopped the slice of %1%: %2%"
msgstr "Ứng dụng đã dừng slice %1%: %2%"

# AI Translated
msgid "The slice of every plate finished."
msgstr "Đã slice xong mọi plate."

# AI Translated
#. TRN %1% is a plate's name.
#, boost-format
msgid "The slice of %1% finished."
msgstr "Đã slice xong %1%."

# AI Translated
msgid "Restored this chat's saved project setup. Check the current printer and material before printing."
msgstr "Đã khôi phục thiết lập dự án đã lưu của cuộc trò chuyện này. Hãy kiểm tra máy in và vật liệu hiện tại trước khi in."

# AI Translated
msgid "A credential check is already running."
msgstr "Đang kiểm tra thông tin xác thực."

# AI Translated
msgid "This build cannot verify a key for that provider yet."
msgstr "Bản dựng này chưa thể xác minh khóa cho nhà cung cấp đó."

# AI Translated
msgid "A sign-in or key check is already running."
msgstr "Đang đăng nhập hoặc kiểm tra khóa."

# AI Translated
msgid "JusPrin couldn't sign you in. Try again."
msgstr "JusPrin không thể đăng nhập cho bạn. Hãy thử lại."

# AI Translated
msgid "The AI service is not available."
msgstr "Dịch vụ AI không khả dụng."

# AI Translated
msgid "The AI service could not start this request."
msgstr "Dịch vụ AI không thể bắt đầu yêu cầu này."

# AI Translated
# Needs human review: "native tool result" = the result of a tool the app ran; check the wording fits.
msgid "AI could not receive the native tool result."
msgstr "AI không thể nhận kết quả công cụ của ứng dụng."

# AI Translated
msgid "The AI request failed."
msgstr "Yêu cầu AI không thành công."

# AI Translated
#. TRN The heading of the chat's model menu over a model that runs on this computer.
msgid "On this computer"
msgstr "Trên máy tính này"

# AI Translated
msgid "This chat ran on a model on this computer that is no longer set up. Set it up again in the AI settings to continue it, or start a new chat."
msgstr "Cuộc trò chuyện này chạy trên một mô hình trên máy tính này nhưng mô hình đó không còn được thiết lập. Hãy thiết lập lại trong cài đặt AI để tiếp tục, hoặc bắt đầu cuộc trò chuyện mới."

# AI Translated
#. TRN %1% is an AI provider's account, such as JusPrin.
#, boost-format
msgid "This chat ran on your %1% account. Sign in again to continue it, or start a new chat."
msgstr "Cuộc trò chuyện này chạy trên tài khoản %1% của bạn. Hãy đăng nhập lại để tiếp tục, hoặc bắt đầu cuộc trò chuyện mới."

# AI Translated
#. TRN %1% is an AI provider, such as OpenAI.
#, boost-format
msgid "This chat ran on %1%, and no %1% API key is set up now. Add the key in the AI settings to continue it, or start a new chat."
msgstr "Cuộc trò chuyện này chạy trên %1%, và hiện chưa thiết lập khóa API %1% nào. Hãy thêm khóa trong cài đặt AI để tiếp tục, hoặc bắt đầu cuộc trò chuyện mới."

# AI Translated
msgid "JusPrin hasn't loaded the AI models for your account yet. Try again in a moment."
msgstr "JusPrin chưa tải xong các mô hình AI cho tài khoản của bạn. Hãy thử lại sau giây lát."

# AI Translated
#. TRN %1% is an AI provider, such as OpenAI.
#, boost-format
msgid "No %1% API key is set up. Add it in the AI settings, or choose another model."
msgstr "Chưa thiết lập khóa API %1%. Hãy thêm khóa trong cài đặt AI, hoặc chọn mô hình khác."

# AI Translated
msgid "A connection is already being saved."
msgstr "Đang lưu kết nối."

# AI Translated
msgid "JusPrin's connection helper is missing. Reinstall or rebuild JusPrin."
msgstr "Thiếu trình hỗ trợ kết nối của JusPrin. Hãy cài đặt lại hoặc dựng lại JusPrin."

# AI Translated
msgid "The AppImage launcher is missing. Reopen the installed AppImage."
msgstr "Thiếu trình khởi chạy AppImage. Hãy mở lại AppImage đã cài."

# AI Translated
msgid "Review the change before connecting."
msgstr "Hãy xem lại thay đổi trước khi kết nối."

# AI Translated
#. TRN %1% is an AI client app, such as Claude Code.
#, boost-format
msgid "%1% isn't installed. Install it, or copy the command and run it later."
msgstr "%1% chưa được cài đặt. Hãy cài đặt, hoặc sao chép lệnh để chạy sau."

# AI Translated
msgid "This build cannot run the client CLI."
msgstr "Bản dựng này không thể chạy CLI của ứng dụng khách."

# AI Translated
msgid "The provider did not answer."
msgstr "Nhà cung cấp không phản hồi."

# AI Translated
msgid "Attach files"
msgstr "Đính kèm file"

# AI Translated
msgid "The AI panel could not connect"
msgstr "Không thể kết nối bảng AI"

# AI Translated
msgid "Back to Prepare"
msgstr "Quay lại Chuẩn bị"

# AI Translated
msgid "Open filament settings"
msgstr "Mở cài đặt filament"

# AI Translated
msgid "The packaged AI page is missing from this build."
msgstr "Bản dựng này thiếu trang AI đóng gói sẵn."

# AI Translated
msgid "The system web view could not be created."
msgstr "Không thể tạo web view của hệ thống."

# AI Translated
msgid "The AI page failed to load."
msgstr "Không tải được trang AI."

# AI Translated
msgid "The AI page did not complete the bridge handshake."
msgstr "Trang AI chưa hoàn tất bắt tay với cầu nối."

# AI Translated
msgid "Restart the application to load the AI page."
msgstr "Hãy khởi động lại ứng dụng để tải trang AI."

# AI Translated
msgid "This is an internal connection between the application and its AI panel, not a network service."
msgstr "Đây là kết nối nội bộ giữa ứng dụng và bảng AI, không phải dịch vụ mạng."

# AI Translated
#. TRN %1% is the web view's own error text.
#, boost-format
msgid "Last load error: %1%"
msgstr "Lỗi tải gần nhất: %1%"

# AI Translated
#. TRN The messages the app and its AI panel exchanged. %1% and %2% are counts.
#, boost-format
msgid "Bridge traffic: %1% sent / %2% received"
msgstr "Lưu lượng cầu nối: đã gửi %1% / đã nhận %2%"

# AI Translated
#. TRN %1% is the AI service's own reason, in English, such as "cyber".
#, boost-format
msgid "The AI service declined to answer (%1%)."
msgstr "Dịch vụ AI từ chối trả lời (%1%)."

# AI Translated
msgid "This version of JusPrin can no longer connect to JusPrin accounts. Get the new version to keep using your account."
msgstr "Phiên bản JusPrin này không còn kết nối được với tài khoản JusPrin. Hãy tải phiên bản mới để tiếp tục dùng tài khoản của bạn."

# AI Translated
msgid "Your JusPrin sign-in has ended. Sign in again in Preferences, then try again."
msgstr "Phiên đăng nhập JusPrin của bạn đã hết hạn. Hãy đăng nhập lại trong Tùy chọn rồi thử lại."

# AI Translated
msgid "Your plan is still active. Cancel it in Credits and plans, then delete your account."
msgstr "Gói của bạn vẫn đang hoạt động. Hãy hủy gói trong Tín dụng và gói rồi xóa tài khoản."

# AI Translated
#. TRN The address is JusPrin's support email; keep it unchanged.
msgid "This account has been deactivated. If you think this is a mistake, email jusprin-support@obico.io."
msgstr "Tài khoản này đã bị vô hiệu hóa. Nếu bạn cho rằng đây là nhầm lẫn, hãy gửi email tới jusprin-support@obico.io."

# AI Translated
msgid "Signing in didn't finish. Nothing was saved. Try again."
msgstr "Đăng nhập chưa hoàn tất. Chưa có gì được lưu. Hãy thử lại."

# AI Translated
msgid "JusPrin couldn't be reached to finish signing in. Try again."
msgstr "Không thể kết nối tới JusPrin để hoàn tất đăng nhập. Hãy thử lại."

# AI Translated
msgid "JusPrin has no AI model for this account right now. Try again later."
msgstr "Hiện JusPrin không có mô hình AI nào cho tài khoản này. Hãy thử lại sau."

# AI Translated
msgid "another app"
msgstr "một ứng dụng khác"

