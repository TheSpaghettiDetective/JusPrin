# AI Translated
msgid "Something went wrong on our side"
msgstr "Đã xảy ra lỗi từ phía chúng tôi"

# AI Translated
#. TRN Said in the chat when a project opens whose chats a newer version of JusPrin saved; they are kept, not shown.
msgid "This project's chats were saved by a newer version of JusPrin. Get the new version to see them."
msgstr "Các cuộc trò chuyện của dự án này được lưu bằng phiên bản JusPrin mới hơn. Hãy tải phiên bản mới để xem."

# AI Translated
msgid "Project chat is blocked until restoration is recovered."
msgstr "Cuộc trò chuyện của dự án bị khóa cho đến khi khôi phục xong."

# AI Translated
msgid "Return to the active chat or restore this chat before sending."
msgstr "Hãy quay lại cuộc trò chuyện đang mở hoặc khôi phục cuộc trò chuyện này trước khi gửi."

# AI Translated
msgid "Finish or cancel AI configuration before sending a message."
msgstr "Hãy hoàn tất hoặc hủy thiết lập AI trước khi gửi tin nhắn."

# AI Translated
msgid "This file is too large to attach."
msgstr "File này quá lớn để đính kèm."

# AI Translated
msgid "This file type can't be read by AI."
msgstr "AI không thể đọc loại file này."

# AI Translated
msgid "This file is not readable UTF-8 text."
msgstr "File này không phải văn bản UTF-8 đọc được."

# AI Translated
msgid "Photo or image"
msgstr "Ảnh hoặc hình ảnh"

# AI Translated
msgid "3D model"
msgstr "Mô hình 3D"

# AI Translated
msgid "Document (PDF)"
msgstr "Tài liệu (PDF)"

# AI Translated
#. TRN A calibration chat's first line. %1%: a printer.
#, boost-format
msgid "From Home · %1% · filament not chosen · temporary test settings"
msgstr "Từ Trang chủ · %1% · chưa chọn filament · cài đặt thử nghiệm tạm thời"

# AI Translated
#. TRN A calibration chat's first line. %1%: the project it was started from, %2%: a printer.
#, boost-format
msgid "From %1% · %2% · filament not chosen · temporary test settings"
msgstr "Từ %1% · %2% · chưa chọn filament · cài đặt thử nghiệm tạm thời"

# AI Translated
#. TRN A calibration chat's first line. %1%: a filament, %2%: a printer.
