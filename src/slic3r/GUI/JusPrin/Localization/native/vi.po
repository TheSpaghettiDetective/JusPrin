msgstr "Đã khôi phục thiết lập dự án đã lưu của cuộc trò chuyện này"

# AI Translated
#. TRN The chat list's preview of a message that has only attachments.
msgid "Attachment"
msgstr "Tệp đính kèm"

# AI Translated
#. TRN %1% is an AI provider, such as OpenAI: the person's own account there has no credits left.
#, boost-format
msgid "Your %1% account is out of credits. Add credits at %1%, then try again."
msgstr "Tài khoản %1% của bạn đã hết tín dụng. Hãy nạp thêm tín dụng tại %1% rồi thử lại."

# AI Translated
#. TRN %1% is an AI provider, such as OpenAI.
#, boost-format
msgid "The %1% service is rate limited. Try again shortly."
msgstr "Dịch vụ %1% đang giới hạn tần suất. Hãy thử lại sau ít phút."

# AI Translated
#. TRN %1% is an AI provider, such as OpenAI. Its service is down or overloaded on its own side.
#, boost-format
msgid "The %1% service is having trouble right now. Try again later."
msgstr "Dịch vụ %1% hiện đang gặp sự cố. Hãy thử lại sau."

# AI Translated
#, boost-format
msgid "Nothing is answering at %1%. Start Ollama or LM Studio, then try again."
msgstr "Không có gì phản hồi tại %1%. Hãy khởi động Ollama hoặc LM Studio, rồi thử lại."

# AI Translated
msgid "This model can't run the app's tools. Pick a model with tool support and a context of at least 32k."
msgstr "Mô hình này không chạy được các công cụ của ứng dụng. Hãy chọn mô hình hỗ trợ công cụ (tools) và có ngữ cảnh từ 32k trở lên."

# AI Translated
#. TRN %1% is an AI provider, such as OpenAI.
#, boost-format
msgid "The AI request could not reach the %1% service."
msgstr "Yêu cầu AI không thể kết nối tới dịch vụ %1%."

# AI Translated
#, boost-format
msgid "This message needs %1% credit; you have %2%."
msgid_plural "This message needs %1% credits; you have %2%."
msgstr[0] "Tin nhắn này cần %1% tín dụng; bạn có %2%."

# AI Translated
#. TRN %1% is an AI provider, such as OpenAI.
#, boost-format
msgid "The %1% API key was rejected. Update the AI configuration and try again."
msgstr "Khóa API %1% đã bị từ chối. Hãy cập nhật cấu hình AI rồi thử lại."

# AI Translated
#. TRN %1% is how many settings, %2% an object's name or a preset's name in quotes, %3% the settings' keys.
#, boost-format
msgid "Change %1% setting of %2%: %3%"
msgid_plural "Change %1% settings of %2%: %3%"
msgstr[0] "Đổi %1% cài đặt của %2%: %3%"

# AI Translated
#. TRN %1% is how many settings, %2% a preset's name in quotes, %3% the settings' keys. The preset is saved with them.
#, boost-format
msgid "Change %1% setting of %2%: %3%; save it"
msgid_plural "Change %1% settings of %2%: %3%; save it"
msgstr[0] "Đổi %1% cài đặt của %2%: %3%; lưu lại"

# AI Translated
#. TRN %1% is how many settings, %2% a preset's name in quotes, %3% the settings' keys, %4% the new preset's name.
#, boost-format
msgid "Change %1% setting of %2%: %3%; save as \"%4%\""
msgid_plural "Change %1% settings of %2%: %3%; save as \"%4%\""
msgstr[0] "Đổi %1% cài đặt của %2%: %3%; lưu thành \"%4%\""

# AI Translated
#. TRN %1% and %2% are the tower's first and last temperatures.
#, boost-format
msgid "Make a temperature tower, %1% °C to %2% °C"
