# AI Translated
msgid "Project chat is blocked until restoration is recovered."
msgstr "Projektchatten är spärrad tills återställningen har lyckats."

# AI Translated
msgid "Return to the active chat or restore this chat before sending."
msgstr "Gå tillbaka till den aktiva chatten eller återställ den här chatten innan du skickar."

# AI Translated
msgid "Finish or cancel AI configuration before sending a message."
msgstr "Slutför eller avbryt AI-konfigurationen innan du skickar ett meddelande."

# AI Translated
msgid "This message belongs to a different chat."
msgstr "Det här meddelandet hör till en annan chatt."

# AI Translated
msgid "A message needs text or an attachment."
msgstr "Ett meddelande behöver text eller en bilaga."

# AI Translated
msgid "This file is too large to attach."
msgstr "Filen är för stor för att bifogas."

# AI Translated
msgid "This file type can't be read by AI."
msgstr "AI kan inte läsa den här filtypen."

# AI Translated
msgid "This file is not readable UTF-8 text."
msgstr "Filen är inte läsbar UTF-8-text."

# AI Translated
msgid "The attachment could not be stored."
msgstr "Bilagan kunde inte sparas."

# AI Translated
msgid "Photo or image"
msgstr "Foto eller bild"

# AI Translated
msgid "3D model"
msgstr "3D-modell"

# AI Translated
msgid "Document (PDF)"
msgstr "Dokument (PDF)"

# AI Translated
msgid "This build cannot open a file dialog."
msgstr "Den här versionen kan inte öppna en fildialog."

# AI Translated
#. TRN A calibration chat's first line. %1%: where it was started from, %2%: a printer.
#, boost-format
msgid "From %1% · %2% · filament not chosen · temporary test settings"
msgstr "Från %1% · %2% · inget filament valt · tillfälliga testinställningar"

# AI Translated
#. TRN A calibration chat's first line. %1%: where it was started from, %2%: a filament, %3%: a printer.
#, boost-format
msgid "From %1% · %2% on %3% · temporary test settings"
msgstr "Från %1% · %2% på %3% · tillfälliga testinställningar"

# AI Translated
#. TRN A reopened calibration test's line. %1%: the day it was made, as "21 Oct 2026".
#, boost-format
msgid "Reopened · generated %1%"
msgstr "Öppnat igen · skapat %1%"

# AI Translated
#. TRN %1%: where the test was opened from, %2%: the day it was made, as "21 Oct 2026".
#, boost-format
msgid "Opened from %1% · generated %2%"
msgstr "Öppnat från %1% · skapat %2%"

# AI Translated
#. TRN %1% is a calibration result, such as 215 °C.
#, boost-format
msgid "result %1% saved"
msgstr "resultatet %1% sparat"

# AI Translated
#. TRN %1% is a plate's name, %2% why the slice did not succeed.
#, boost-format
msgid "The app did not slice %1%: %2%"
msgstr "Appen beredde inte %1%: %2%"

# AI Translated
#. TRN %1% is a plate's name, %2% why the slice did not succeed.
#, boost-format
msgid "The app stopped the slice of %1%: %2%"
msgstr "Appen stoppade beredningen av %1%: %2%"

# AI Translated
msgid "The slice of every plate finished."
msgstr "Beredningen av alla plattor är klar."

# AI Translated
#. TRN %1% is a plate's name.
#, boost-format
msgid "The slice of %1% finished."
msgstr "Beredningen av %1% är klar."

# AI Translated
msgid "Historical replies cannot be retried."
msgstr "Tidigare svar kan inte försökas igen."

# AI Translated
msgid "Only a failed or stopped assistant message in the active conversation can be retried."
msgstr "Bara ett misslyckat eller stoppat assistentmeddelande i den aktiva konversationen kan försökas igen."

# AI Translated
msgid "Only the chat's last reply can be retried."
msgstr "Bara chattens senaste svar kan försökas igen."

# AI Translated
msgid "Another reply is currently streaming."
msgstr "Ett annat svar strömmas just nu."

# AI Translated
msgid "Historical tool actions cannot be changed."
msgstr "Tidigare verktygsåtgärder kan inte ändras."

# AI Translated
msgid "This proposal is no longer open. Ask AI again."
msgstr "Det här förslaget är inte längre öppet. Fråga AI igen."

# AI Translated
msgid "This save can no longer be undone."
msgstr "Den här sparningen kan inte längre ångras."

# AI Translated
msgid "Finish or resolve pending work before creating a chat."
msgstr "Slutför eller lös pågående arbete innan du skapar en chatt."

# AI Translated
msgid "The current chat could not be saved."
msgstr "Den aktuella chatten kunde inte sparas."

# AI Translated
msgid "The new chat could not be saved."
msgstr "Den nya chatten kunde inte sparas."

# AI Translated
msgid "The selected chat could not be saved."
msgstr "Den valda chatten kunde inte sparas."

# AI Translated
msgid "The project or selected chat changed. Review it again."
msgstr "Projektet eller den valda chatten har ändrats. Granska det igen."

# AI Translated
msgid "Finish or resolve pending work before resuming a chat."
msgstr "Slutför eller lös pågående arbete innan du återupptar en chatt."

# AI Translated
msgid "This chat is already active."
msgstr "Den här chatten är redan aktiv."

# AI Translated
msgid "JusPrin can't find the project version this chat was working on."
msgstr "JusPrin hittar inte den projektversion som den här chatten arbetade med."

# AI Translated
msgid "The current project could not be saved before restoration."
msgstr "Det aktuella projektet kunde inte sparas före återställningen."

# AI Translated
msgid "JusPrin couldn't put the project back."
msgstr "JusPrin kunde inte återställa projektet."

# AI Translated
msgid "Restored this chat's saved project setup. Check the current printer and material before printing."
msgstr "Chattens sparade projektinställning har återställts. Kontrollera aktuell skrivare och material innan du skriver ut."

# AI Translated
msgid "Use a non-empty, single-line title of at most 120 characters for an existing chat."
msgstr "Ange en titel som inte är tom, ryms på en rad och har högst 120 tecken för en befintlig chatt."

# AI Translated
msgid "This chat is still working. Stop it or let it finish, then delete it."
msgstr "Den här chatten arbetar fortfarande. Stoppa den eller låt den bli klar och ta sedan bort den."

# AI Translated
msgid "This chat no longer exists."
msgstr "Den här chatten finns inte längre."

# AI Translated
msgid "The replacement chat could not be saved."
msgstr "Ersättningschatten kunde inte sparas."

# AI Translated
msgid "Historical chats cannot edit the current draft."
msgstr "Tidigare chattar kan inte redigera det aktuella utkastet."

# AI Translated
msgid "Finish or stop the current reply before configuring AI."
msgstr "Slutför eller stoppa det aktuella svaret innan du konfigurerar AI."

# AI Translated
msgid "This build cannot configure an AI provider."
msgstr "Den här versionen kan inte konfigurera en AI-leverantör."

# AI Translated
msgid "A credential check is already running."
msgstr "En kontroll av inloggningsuppgifter pågår redan."

# AI Translated
msgid "This build cannot verify a key for that provider yet."
msgstr "Den här versionen kan ännu inte verifiera en nyckel för den leverantören."

# AI Translated
msgid "Finish or stop the current reply before removing a key."
msgstr "Slutför eller stoppa det aktuella svaret innan du tar bort en nyckel."

# AI Translated
msgid "Finish or cancel the key check before removing a key."
msgstr "Slutför eller avbryt nyckelkontrollen innan du tar bort en nyckel."

# AI Translated
msgid "That key could not be removed."
msgstr "Nyckeln kunde inte tas bort."

# AI Translated
msgid "This build cannot sign in to a JusPrin account."
msgstr "Den här versionen kan inte logga in på ett JusPrin-konto."

# AI Translated
msgid "Finish or stop the current reply before signing in."
msgstr "Slutför eller stoppa det aktuella svaret innan du loggar in."

# AI Translated
msgid "A sign-in or key check is already running."
msgstr "En inloggning eller nyckelkontroll pågår redan."

# AI Translated
msgid "There is no JusPrin account on this computer to check."
msgstr "Det finns inget JusPrin-konto på den här datorn att kontrollera."

# AI Translated
msgid "JusPrin couldn't sign you in. Try again."
msgstr "JusPrin kunde inte logga in dig. Försök igen."

# AI Translated
msgid "This sign-in could not be saved, so you will have to sign in again next time JusPrin starts."
msgstr "Inloggningen kunde inte sparas, så du måste logga in igen nästa gång JusPrin startar."

# AI Translated
msgid "This key could not be saved, so it will have to be entered again next time JusPrin starts."
msgstr "Nyckeln kunde inte sparas, så den måste anges igen nästa gång JusPrin startar."

# AI Translated
msgid "The AI service is not available."
msgstr "AI-tjänsten är inte tillgänglig."

# AI Translated
msgid "The AI service could not start this request."
msgstr "AI-tjänsten kunde inte starta den här begäran."

# AI Translated
msgid "AI could not receive the native tool result."
msgstr "AI kunde inte ta emot resultatet från det inbyggda verktyget."

# AI Translated
msgid "The AI request failed."
msgstr "AI-begäran misslyckades."

# AI Translated
msgid "The automatic chat title could not be generated. You can rename the chat."
msgstr "Chattens titel kunde inte skapas automatiskt. Du kan byta namn på chatten."

# AI Translated
#. TRN %1% is an AI provider's account, such as JusPrin.
#, boost-format
msgid "This chat ran on your %1% account. Sign in again to continue it, or start a new chat."
msgstr "Den här chatten kördes på ditt %1%-konto. Logga in igen för att fortsätta den, eller starta en ny chatt."

# AI Translated
#. TRN %1% is an AI provider, such as OpenAI.
#, boost-format
msgid "This chat ran on %1%, and no %1% API key is set up now. Add the key in the AI settings to continue it, or start a new chat."
msgstr "Den här chatten kördes på %1%, och ingen API-nyckel för %1% är konfigurerad nu. Lägg till nyckeln i AI-inställningarna för att fortsätta den, eller starta en ny chatt."

# AI Translated
msgid "JusPrin hasn't loaded the AI models for your account yet. Try again in a moment."
msgstr "JusPrin har inte läst in AI-modellerna för ditt konto ännu. Försök igen om en stund."

# AI Translated
#. TRN %1% is an AI provider, such as OpenAI.
#, boost-format
msgid "No %1% API key is set up. Add it in the AI settings, or choose another model."
msgstr "Ingen API-nyckel för %1% är konfigurerad. Lägg till den i AI-inställningarna eller välj en annan modell."

# AI Translated
msgid "A connection is already being saved."
msgstr "En anslutning sparas redan."

# AI Translated
msgid "JusPrin's connection helper is missing. Reinstall or rebuild JusPrin."
msgstr "JusPrins anslutningshjälpare saknas. Installera om eller bygg om JusPrin."

# AI Translated
msgid "The AppImage launcher is missing. Reopen the installed AppImage."
msgstr "AppImage-startprogrammet saknas. Öppna den installerade AppImage-filen igen."

# AI Translated
msgid "Review the change before connecting."
msgstr "Granska ändringen innan du ansluter."

# AI Translated
#. TRN %1% is an AI client app, such as Claude Code.
#, boost-format
msgid "%1% isn't installed. Install it, or copy the command and run it later."
msgstr "%1% är inte installerat. Installera det, eller kopiera kommandot och kör det senare."

# AI Translated
msgid "This build cannot run the client CLI."
msgstr "Den här versionen kan inte köra klientens CLI."

# AI Translated
msgid "This build cannot open a file manager."
msgstr "Den här versionen kan inte öppna en filhanterare."

# AI Translated
msgid "The provider did not answer."
msgstr "Leverantören svarade inte."

# AI Translated
msgid "Attach files"
msgstr "Bifoga filer"

# AI Translated
msgid "The AI panel could not connect"
msgstr "AI-panelen kunde inte ansluta"

# AI Translated
msgid "Back to Prepare"
msgstr "Tillbaka till Förbered"

# AI Translated
msgid "Open filament settings"
msgstr "Öppna filamentinställningar"

# AI Translated
msgid "The packaged AI page is missing from this build."
msgstr "Den paketerade AI-sidan saknas i den här versionen."

# AI Translated
msgid "The system web view could not be created."
msgstr "Systemets webbvy kunde inte skapas."

# AI Translated
msgid "The AI page failed to load."
msgstr "AI-sidan kunde inte läsas in."

# AI Translated
msgid "The AI page did not complete the bridge handshake."
msgstr "AI-sidan slutförde inte handskakningen med bryggan."

# AI Translated
msgid "Restart the application to load the AI page."
msgstr "Starta om programmet för att läsa in AI-sidan."

# AI Translated
msgid "This is an internal connection between the application and its AI panel, not a network service."
msgstr "Det här är en intern anslutning mellan programmet och dess AI-panel, inte en nätverkstjänst."

# AI Translated
#. TRN %1% is the web view's own error text.
#, boost-format
msgid "Last load error: %1%"
msgstr "Senaste inläsningsfel: %1%"

# AI Translated
#. TRN The messages the app and its AI panel exchanged. %1% and %2% are counts.
#, boost-format
msgid "Bridge traffic: %1% sent / %2% received"
msgstr "Bryggtrafik: %1% skickade / %2% mottagna"

# AI Translated
msgid "The AI service returned an unreadable streaming response."
msgstr "AI-tjänsten returnerade ett oläsbart strömmat svar."

# AI Translated
# Needs human review: technical stream error; 'delta' kept as a technical term
msgid "The AI service streamed a delta for a block it never opened."
msgstr "AI-tjänsten strömmade en delta för ett block som den aldrig öppnade."

# AI Translated
msgid "The AI service sent a tool call whose arguments are not JSON."
msgstr "AI-tjänsten skickade ett verktygsanrop vars argument inte är JSON."

# AI Translated
msgid "The AI service could not complete the response."
msgstr "AI-tjänsten kunde inte slutföra svaret."

# AI Translated
#. TRN %1% is the AI service's own reason, in English, such as "cyber".
#, boost-format
msgid "The AI service declined to answer (%1%)."
msgstr "AI-tjänsten avböjde att svara (%1%)."

# AI Translated
msgid "The AI service ended its response for a reason this build does not know."
msgstr "AI-tjänsten avslutade sitt svar av ett skäl som den här versionen inte känner till."

# AI Translated
msgid "This version of JusPrin can no longer connect to JusPrin accounts. Get the new version to keep using your account."
msgstr "Den här versionen av JusPrin kan inte längre ansluta till JusPrin-konton. Hämta den nya versionen för att fortsätta använda ditt konto."

# AI Translated
msgid "Signing in didn't finish. Nothing was saved. Try again."
msgstr "Inloggningen slutfördes inte. Inget sparades. Försök igen."

# AI Translated
msgid "JusPrin couldn't be reached to finish signing in. Try again."
msgstr "JusPrin kunde inte nås för att slutföra inloggningen. Försök igen."

# AI Translated
msgid "JusPrin has no AI model for this account right now. Try again later."
msgstr "JusPrin har ingen AI-modell för det här kontot just nu. Försök igen senare."

# AI Translated
msgid "Restored an earlier project version"
msgstr "En tidigare projektversion har återställts"

# AI Translated
msgid "Restored this chat's saved project setup"
msgstr "Chattens sparade projektinställning har återställts"

# AI Translated
#. TRN The chat list's preview of a message that has only attachments.
msgid "Attachment"
msgstr "Bilaga"

# AI Translated
msgid "The AI service stopped before finishing its response."
msgstr "AI-tjänsten stoppade innan svaret var klart."

# AI Translated
msgid "The AI service kept pausing its response."
msgstr "AI-tjänsten pausade sitt svar upprepade gånger."

# AI Translated
msgid "AI could not be asked to continue its response."
msgstr "AI kunde inte ombes att fortsätta sitt svar."

# AI Translated
msgid "AI could not be told the results of its tool calls."
msgstr "AI kunde inte få resultaten av sina verktygsanrop."

# AI Translated
msgid "AI returned an invalid tool call."
msgstr "AI returnerade ett ogiltigt verktygsanrop."

# AI Translated
msgid "The AI service ended before a complete response arrived."
msgstr "AI-tjänsten avslutades innan ett fullständigt svar kom."

# AI Translated
msgid "Your JusPrin sign-in has ended. Sign in again in Preferences, then try again."
msgstr "Din JusPrin-inloggning har gått ut. Logga in igen i Inställningar och försök sedan igen."

# AI Translated
#, boost-format
msgid "This message needs %1% credit; you have %2%."
msgid_plural "This message needs %1% credits; you have %2%."
msgstr[0] "Det här meddelandet kräver %1% kredit; du har %2%."
msgstr[1] "Det här meddelandet kräver %1% krediter; du har %2%."

# AI Translated
msgid "You're out of credits."
msgstr "Du har slut på krediter."

# AI Translated
#. TRN %1% is an AI provider, such as OpenAI.
#, boost-format
msgid "The %1% API key was rejected. Update the AI configuration and try again."
msgstr "API-nyckeln för %1% avvisades. Uppdatera AI-konfigurationen och försök igen."

# AI Translated
#. TRN %1% is an AI provider, such as OpenAI.
#, boost-format
msgid "The request was too large for the %1% service."
msgstr "Begäran var för stor för tjänsten %1%."

# AI Translated
#. TRN %1% is an AI provider, such as OpenAI.
#, boost-format
msgid "The %1% service is rate limited. Try again shortly."
msgstr "Tjänsten %1% begränsar antalet anrop. Försök igen om en liten stund."

# AI Translated
#. TRN %1% is an AI provider, such as OpenAI.
#, boost-format
msgid "The %1% service is overloaded. Try again shortly."
msgstr "Tjänsten %1% är överbelastad. Försök igen om en liten stund."

# AI Translated
#. TRN %1% is an AI provider, such as OpenAI.
#, boost-format
msgid "The %1% service is temporarily unavailable."
msgstr "Tjänsten %1% är tillfälligt otillgänglig."

# AI Translated
msgid "The AI request timed out."
msgstr "AI-begäran tog för lång tid."

# AI Translated
#. TRN %1% is an AI provider, such as OpenAI.
#, boost-format
msgid "The AI request could not reach the %1% service."
msgstr "AI-begäran kunde inte nå tjänsten %1%."

# AI Translated
msgid "The AI service response did not contain valid output."
msgstr "AI-tjänstens svar innehöll inget giltigt resultat."

# AI Translated
#. TRN A button that asks the AI to choose another block of a calibration test.
msgid "Pick another block"
msgstr "Välj ett annat block"

# AI Translated
#. TRN A button that asks the AI to choose another tile of a calibration test.
msgid "Pick another tile"
msgstr "Välj en annan ruta"

# AI Translated
#. TRN A button that asks the AI to choose another line of a calibration test.
msgid "Pick another line"
msgstr "Välj en annan linje"

# AI Translated
#. TRN A button that asks the AI to choose another corner of a calibration test.
msgid "Pick another corner"
msgstr "Välj ett annat hörn"

# AI Translated
#. TRN A button that asks the AI to choose another height of a calibration tower.
msgid "Pick another height"
msgstr "Välj en annan höjd"

# AI Translated
#. TRN %1% is a preset's name.
#, boost-format
msgid "Preset · %1%"
msgstr "Förinställning · %1%"

# AI Translated
#. TRN %1% is a preset's name.
#, boost-format
msgid "New preset · %1%"
msgstr "Ny förinställning · %1%"

# AI Translated
#. TRN %1% is the preset the new one is made from.
#, boost-format
msgid "%1% itself is unchanged"
msgstr "%1% är oförändrad"

# AI Translated
#. TRN %1% is a setting's new value, such as 215 °C.
#, boost-format
msgid "Save %1% as a new filament preset"
msgstr "Spara %1% som en ny filamentförinställning"

# AI Translated
#. TRN %1% is a setting's new value, such as 215 °C.
#, boost-format
msgid "Save %1% as a new printer preset"
msgstr "Spara %1% som en ny skrivarförinställning"

# AI Translated
#. TRN %1% is a setting's new value, such as 215 °C.
#, boost-format
msgid "Save %1% as a new process preset"
msgstr "Spara %1% som en ny processförinställning"

# AI Translated
#. TRN %1% is a setting's new value, such as 215 °C, %2% a preset's name.
#, boost-format
msgid "Save %1% to %2%"
msgstr "Spara %1% i %2%"

# AI Translated
msgid "This proposal is already saved."
msgstr "Det här förslaget är redan sparat."

# AI Translated
msgid "Drop a model here or add one"
msgstr "Släpp en modell här eller lägg till en"

# AI Translated
msgid "World coordinates"
msgstr "Världskoordinater"

# AI Translated
msgid "Object coordinates"
msgstr "Objektkoordinater"

# AI Translated
msgid "Translate(Relative)"
msgstr "Flytta (relativt)"

# AI Translated
msgid "Rotate (absolute)"
msgstr "Rotera (absolut)"

# AI Translated
msgid "Part coordinates"
msgstr "Delkoordinater"

# AI Translated
msgid "The packaged Home page is missing from this build."
msgstr "Den paketerade Hem-sidan saknas i den här versionen."

# AI Translated
msgid "The Home page failed to load."
msgstr "Hem-sidan kunde inte läsas in."

# AI Translated
msgid "This window stopped updating because the app switched to another printer."
msgstr "Det här fönstret slutade uppdateras eftersom appen bytte till en annan skrivare."

# AI Translated
#. TRN A length in millimetres, such as a nozzle diameter on a printer card: "0.4 mm". %s is the number.
#, c-format, boost-format
msgid "%s mm"
msgstr "%s mm"

# AI Translated
#, c-format, boost-format
msgid "The printer reports error %s."
msgstr "Skrivaren rapporterar felet %s."

# AI Translated
msgid "LAN"
msgstr "LAN"

# AI Translated
msgid "Cloud"
msgstr "Moln"

# AI Translated
msgid "The printer stopped sending updates."
msgstr "Skrivaren slutade skicka uppdateringar."

# AI Translated
#, c-format, boost-format
msgid "%s isn't answering."
msgstr "%s svarar inte."

# AI Translated
msgid "Klipper isn't running."
msgstr "Klipper körs inte."

# AI Translated
#. TRN %1% is Klipper's own message, in English, saying why it stopped.
#, boost-format
msgid "Klipper stopped: %1%"
msgstr "Klipper stoppade: %1%"

# AI Translated
msgid "This printer no longer exists."
msgstr "Den här skrivaren finns inte längre."

# AI Translated
#. TRN A date in this year on a project card: %1% is the abbreviated month name, %2% the day of the month, as in "Oct 20".
#, boost-format
msgctxt "short date"
msgid "%1% %2%"
msgstr "%2% %1%"

# AI Translated
#. TRN A date outside this year on a project card: %1% is the date without the year, as in "Oct 20", %2% the year.
#, boost-format
msgctxt "date with year"
msgid "%1%, %2%"
msgstr "%1% %2%"

# AI Translated
msgid "G-code exported"
msgstr "G-code exporterad"

# AI Translated
#. TRN A project's status: %1% is a date, as in "Nov 3".
#, boost-format
msgid "G-code exported %1%"
msgstr "G-code exporterad %1%"

# AI Translated
#. TRN A project's status: %1% is a printer model, as in "Ender-3 V3 KE".
#, boost-format
msgid "G-code exported for %1%"
msgstr "G-code exporterad för %1%"

# AI Translated
#. TRN A project's status: %1% is a date, as in "Nov 3", %2% a printer model, as in "Ender-3 V3 KE".
#, boost-format
msgid "G-code exported %1% for %2%"
msgstr "G-code exporterad %1% för %2%"

# AI Translated
msgctxt "project status"
msgid "Printed"
msgstr "Utskriven"

# AI Translated
#. TRN A project's status: %1% is a date, as in "Oct 20".
#, boost-format
msgid "Printed %1%"
msgstr "Utskriven %1%"

# AI Translated
msgctxt "project status"
msgid "Sent"
msgstr "Skickad"

# AI Translated
#. TRN A project's status: %1% is a date, as in "Oct 20".
#, boost-format
msgid "Sent %1%"
msgstr "Skickad %1%"

# AI Translated
#. TRN A project's status: it has not been sliced to G-code yet.
msgctxt "project status"
msgid "Draft"
msgstr "Utkast"

# AI Translated
msgid "That sign-in expired. Try again."
msgstr "Inloggningen har gått ut. Försök igen."

