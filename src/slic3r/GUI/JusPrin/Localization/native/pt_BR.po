# AI Translated
msgid "Something went wrong on our side"
msgstr "Algo deu errado do nosso lado"

# AI Translated
msgid "Project chat is blocked until restoration is recovered."
msgstr "A conversa do projeto está bloqueada até que a restauração seja recuperada."

# AI Translated
msgid "Return to the active chat or restore this chat before sending."
msgstr "Volte à conversa ativa ou restaure esta conversa antes de enviar."

# AI Translated
msgid "Finish or cancel AI configuration before sending a message."
msgstr "Conclua ou cancele a configuração da IA antes de enviar uma mensagem."

# AI Translated
msgid "This message belongs to a different chat."
msgstr "Esta mensagem pertence a outra conversa."

# AI Translated
msgid "A message needs text or an attachment."
msgstr "Uma mensagem precisa de texto ou de um anexo."

# AI Translated
msgid "This file is too large to attach."
msgstr "Este arquivo é grande demais para ser anexado."

# AI Translated
msgid "This file type can't be read by AI."
msgstr "A IA não consegue ler este tipo de arquivo."

# AI Translated
msgid "This file is not readable UTF-8 text."
msgstr "Este arquivo não é um texto UTF-8 legível."

# AI Translated
msgid "Photo or image"
msgstr "Foto ou imagem"

# AI Translated
msgid "3D model"
msgstr "Modelo 3D"

# AI Translated
msgid "Document (PDF)"
msgstr "Documento (PDF)"

# AI Translated
msgid "This build cannot open a file dialog."
msgstr "Esta versão não pode abrir uma caixa de diálogo de arquivos."

# AI Translated
#. TRN A calibration chat's first line. %1%: where it was started from, %2%: a printer.
#, boost-format
msgid "From %1% · %2% · filament not chosen · temporary test settings"
msgstr "De %1% · %2% · filamento não escolhido · configurações de teste temporárias"

# AI Translated
#. TRN A calibration chat's first line. %1%: where it was started from, %2%: a filament, %3%: a printer.
#, boost-format
msgid "From %1% · %2% on %3% · temporary test settings"
msgstr "De %1% · %2% em %3% · configurações de teste temporárias"

# AI Translated
#. TRN A reopened calibration test's line. %1%: the day it was made, as "21 Oct 2026".
#, boost-format
msgid "Reopened · generated %1%"
msgstr "Reaberto · gerado em %1%"

# AI Translated
#. TRN %1%: where the test was opened from, %2%: the day it was made, as "21 Oct 2026".
#, boost-format
msgid "Opened from %1% · generated %2%"
msgstr "Aberto de %1% · gerado em %2%"

# AI Translated
#. TRN %1% is a calibration result, such as 215 °C.
#, boost-format
msgid "result %1% saved"
msgstr "resultado %1% salvo"

# AI Translated
#. TRN %1% is a plate's name, %2% why the slice did not succeed.
#, boost-format
msgid "The app did not slice %1%: %2%"
msgstr "O aplicativo não fatiou %1%: %2%"

# AI Translated
#. TRN %1% is a plate's name, %2% why the slice did not succeed.
#, boost-format
msgid "The app stopped the slice of %1%: %2%"
msgstr "O aplicativo interrompeu o fatiamento de %1%: %2%"

# AI Translated
msgid "The slice of every plate finished."
msgstr "O fatiamento de todas as placas foi concluído."

# AI Translated
#. TRN %1% is a plate's name.
#, boost-format
msgid "The slice of %1% finished."
msgstr "O fatiamento de %1% foi concluído."

# AI Translated
msgid "Historical replies cannot be retried."
msgstr "Não é possível tentar novamente respostas do histórico."

# AI Translated
msgid "Only a failed or stopped assistant message in the active conversation can be retried."
msgstr "Só é possível tentar novamente uma mensagem do assistente que falhou ou foi interrompida na conversa ativa."

# AI Translated
msgid "Only the chat's last reply can be retried."
msgstr "Só é possível tentar novamente a última resposta da conversa."

# AI Translated
msgid "Another reply is currently streaming."
msgstr "Outra resposta está sendo transmitida no momento."

# AI Translated
msgid "Historical tool actions cannot be changed."
msgstr "Não é possível alterar ações de ferramentas do histórico."

# AI Translated
msgid "This proposal is no longer open. Ask AI again."
msgstr "Esta proposta não está mais aberta. Pergunte à IA novamente."

# AI Translated
msgid "This save can no longer be undone."
msgstr "Este salvamento não pode mais ser desfeito."

# AI Translated
msgid "Finish or resolve pending work before creating a chat."
msgstr "Conclua ou resolva o trabalho pendente antes de criar uma conversa."

# AI Translated
msgid "The project or selected chat changed. Review it again."
msgstr "O projeto ou a conversa selecionada mudou. Revise novamente."

# AI Translated
msgid "Finish or resolve pending work before resuming a chat."
msgstr "Conclua ou resolva o trabalho pendente antes de retomar uma conversa."

# AI Translated
msgid "This chat is already active."
msgstr "Esta conversa já está ativa."

# AI Translated
msgid "JusPrin can't find the project version this chat was working on."
msgstr "O JusPrin não encontra a versão do projeto em que esta conversa estava trabalhando."

# AI Translated
msgid "Restored this chat's saved project setup. Check the current printer and material before printing."
msgstr "A configuração de projeto salva nesta conversa foi restaurada. Verifique a impressora e o material atuais antes de imprimir."

# AI Translated
msgid "Use a non-empty, single-line title of at most 120 characters for an existing chat."
msgstr "Use um título não vazio, de uma só linha e com no máximo 120 caracteres para uma conversa existente."

# AI Translated
msgid "This chat is still working. Stop it or let it finish, then delete it."
msgstr "Esta conversa ainda está em andamento. Interrompa-a ou deixe-a terminar e depois exclua-a."

# AI Translated
msgid "This chat no longer exists."
msgstr "Esta conversa não existe mais."

# AI Translated
msgid "Historical chats cannot edit the current draft."
msgstr "Conversas do histórico não podem editar o rascunho atual."

# AI Translated
msgid "Finish or stop the current reply before configuring AI."
msgstr "Conclua ou interrompa a resposta atual antes de configurar a IA."

# AI Translated
msgid "This build cannot configure an AI provider."
msgstr "Esta versão não pode configurar um provedor de IA."

# AI Translated
msgid "A credential check is already running."
msgstr "Uma verificação de credenciais já está em andamento."

# AI Translated
msgid "This build cannot verify a key for that provider yet."
msgstr "Esta versão ainda não pode verificar uma chave desse provedor."

# AI Translated
msgid "Finish or stop the current reply before removing a key."
msgstr "Conclua ou interrompa a resposta atual antes de remover uma chave."

# AI Translated
msgid "Finish or cancel the key check before removing a key."
msgstr "Conclua ou cancele a verificação da chave antes de remover uma chave."

# AI Translated
msgid "That key could not be removed."
msgstr "Não foi possível remover essa chave."

# AI Translated
msgid "This build cannot sign in to a JusPrin account."
msgstr "Esta versão não pode entrar em uma conta JusPrin."

# AI Translated
msgid "Finish or stop the current reply before signing in."
msgstr "Conclua ou interrompa a resposta atual antes de entrar."

# AI Translated
msgid "A sign-in or key check is already running."
msgstr "Um login ou uma verificação de chave já está em andamento."

# AI Translated
msgid "There is no JusPrin account on this computer to check."
msgstr "Não há nenhuma conta JusPrin neste computador para verificar."

# AI Translated
msgid "JusPrin couldn't sign you in. Try again."
msgstr "O JusPrin não conseguiu fazer o seu login. Tente novamente."

# AI Translated
msgid "The AI service is not available."
msgstr "O serviço de IA não está disponível."

# AI Translated
msgid "The AI service could not start this request."
msgstr "O serviço de IA não conseguiu iniciar esta solicitação."

# AI Translated
msgid "AI could not receive the native tool result."
msgstr "A IA não recebeu o resultado da ferramenta nativa."

# AI Translated
msgid "The AI request failed."
msgstr "A solicitação à IA falhou."

# AI Translated
msgid "The automatic chat title could not be generated. You can rename the chat."
msgstr "Não foi possível gerar o título automático da conversa. Você pode renomear a conversa."

# AI Translated
#. TRN %1% is an AI provider's account, such as JusPrin.
#, boost-format
msgid "This chat ran on your %1% account. Sign in again to continue it, or start a new chat."
msgstr "Esta conversa usou sua conta %1%. Entre novamente para continuá-la ou inicie uma nova conversa."

# AI Translated
#. TRN %1% is an AI provider, such as OpenAI.
#, boost-format
msgid "This chat ran on %1%, and no %1% API key is set up now. Add the key in the AI settings to continue it, or start a new chat."
msgstr "Esta conversa usou %1%, e nenhuma chave de API do %1% está configurada agora. Adicione a chave nas configurações de IA para continuá-la ou inicie uma nova conversa."

# AI Translated
msgid "JusPrin hasn't loaded the AI models for your account yet. Try again in a moment."
msgstr "O JusPrin ainda não carregou os modelos de IA da sua conta. Tente novamente em instantes."

# AI Translated
#. TRN %1% is an AI provider, such as OpenAI.
#, boost-format
msgid "No %1% API key is set up. Add it in the AI settings, or choose another model."
msgstr "Nenhuma chave de API do %1% está configurada. Adicione-a nas configurações de IA ou escolha outro modelo."

# AI Translated
msgid "A connection is already being saved."
msgstr "Uma conexão já está sendo salva."

# AI Translated
msgid "JusPrin's connection helper is missing. Reinstall or rebuild JusPrin."
msgstr "O assistente de conexão do JusPrin está ausente. Reinstale ou recompile o JusPrin."

# AI Translated
msgid "The AppImage launcher is missing. Reopen the installed AppImage."
msgstr "O iniciador do AppImage está ausente. Abra novamente o AppImage instalado."

# AI Translated
msgid "Review the change before connecting."
msgstr "Revise a alteração antes de conectar."

# AI Translated
#. TRN %1% is an AI client app, such as Claude Code.
#, boost-format
msgid "%1% isn't installed. Install it, or copy the command and run it later."
msgstr "%1% não está instalado. Instale-o ou copie o comando e execute-o mais tarde."

# AI Translated
msgid "This build cannot run the client CLI."
msgstr "Esta versão não pode executar a CLI do cliente."

# AI Translated
msgid "This build cannot open a file manager."
msgstr "Esta versão não pode abrir um gerenciador de arquivos."

# AI Translated
msgid "The provider did not answer."
msgstr "O provedor não respondeu."

# AI Translated
msgid "Attach files"
msgstr "Anexar arquivos"

# AI Translated
msgid "The AI panel could not connect"
msgstr "Não foi possível conectar o painel de IA"

# AI Translated
msgid "Back to Prepare"
msgstr "Voltar para Preparar"

# AI Translated
msgid "Open filament settings"
msgstr "Abrir configurações de filamento"

# AI Translated
msgid "The packaged AI page is missing from this build."
msgstr "A página de IA empacotada não está presente nesta versão."

# AI Translated
msgid "The system web view could not be created."
msgstr "Não foi possível criar a visualização web do sistema."

# AI Translated
msgid "The AI page failed to load."
msgstr "Falha ao carregar a página de IA."

# AI Translated
msgid "The AI page did not complete the bridge handshake."
msgstr "A página de IA não concluiu o handshake da ponte com o aplicativo."

# AI Translated
msgid "Restart the application to load the AI page."
msgstr "Reinicie o aplicativo para carregar a página de IA."

# AI Translated
msgid "This is an internal connection between the application and its AI panel, not a network service."
msgstr "Esta é uma conexão interna entre o aplicativo e o painel de IA, não um serviço de rede."

# AI Translated
#. TRN %1% is the web view's own error text.
#, boost-format
msgid "Last load error: %1%"
msgstr "Último erro de carregamento: %1%"

# AI Translated
#. TRN The messages the app and its AI panel exchanged. %1% and %2% are counts.
#, boost-format
msgid "Bridge traffic: %1% sent / %2% received"
msgstr "Tráfego da ponte: %1% enviadas / %2% recebidas"

# AI Translated
#. TRN %1% is the AI service's own reason, in English, such as "cyber".
#, boost-format
msgid "The AI service declined to answer (%1%)."
msgstr "O serviço de IA se recusou a responder (%1%)."

# AI Translated
msgid "This version of JusPrin can no longer connect to JusPrin accounts. Get the new version to keep using your account."
msgstr "Esta versão do JusPrin não consegue mais se conectar a contas JusPrin. Obtenha a nova versão para continuar usando sua conta."

# AI Translated
msgid "Your JusPrin sign-in has ended. Sign in again in Preferences, then try again."
msgstr "Sua sessão do JusPrin terminou. Entre novamente em Preferências e tente de novo."

# AI Translated
msgid "Signing in didn't finish. Nothing was saved. Try again."
msgstr "O login não foi concluído. Nada foi salvo. Tente novamente."

# AI Translated
msgid "JusPrin couldn't be reached to finish signing in. Try again."
msgstr "Não foi possível acessar o JusPrin para concluir o login. Tente novamente."

# AI Translated
msgid "JusPrin has no AI model for this account right now. Try again later."
msgstr "O JusPrin não tem nenhum modelo de IA para esta conta no momento. Tente novamente mais tarde."

# AI Translated
msgid "Restored an earlier project version"
msgstr "Uma versão anterior do projeto foi restaurada"

# AI Translated
msgid "Restored this chat's saved project setup"
msgstr "A configuração de projeto salva nesta conversa foi restaurada"

# AI Translated
#. TRN The chat list's preview of a message that has only attachments.
msgid "Attachment"
msgstr "Anexo"

# AI Translated
#. TRN %1% is an AI provider, such as OpenAI.
#, boost-format
msgid "The %1% service is rate limited. Try again shortly."
msgstr "O serviço %1% atingiu o limite de solicitações. Tente novamente em breve."

# AI Translated
#. TRN %1% is an AI provider, such as OpenAI.
#, boost-format
msgid "The request was too large for the %1% service."
msgstr "A solicitação era grande demais para o serviço %1%."

# AI Translated
#. TRN %1% is an AI provider, such as OpenAI.
#, boost-format
msgid "The AI request could not reach the %1% service."
msgstr "A solicitação à IA não conseguiu acessar o serviço %1%."

# AI Translated
#, boost-format
msgid "This message needs %1% credit; you have %2%."
msgid_plural "This message needs %1% credits; you have %2%."
msgstr[0] "Esta mensagem precisa de %1% crédito; você tem %2%."
msgstr[1] "Esta mensagem precisa de %1% créditos; você tem %2%."

# AI Translated
#. TRN %1% is an AI provider, such as OpenAI.
#, boost-format
msgid "The %1% API key was rejected. Update the AI configuration and try again."
msgstr "A chave de API do %1% foi rejeitada. Atualize a configuração de IA e tente novamente."

# AI Translated
#. TRN A button that asks the AI to choose another block of a calibration test.
msgid "Pick another block"
msgstr "Escolher outro bloco"

# AI Translated
# Needs human review: "Tile" of a calibration test rendered as "quadrado"; check it matches what the test prints.
#. TRN A button that asks the AI to choose another tile of a calibration test.
msgid "Pick another tile"
msgstr "Escolher outro quadrado"

# AI Translated
#. TRN A button that asks the AI to choose another line of a calibration test.
msgid "Pick another line"
msgstr "Escolher outra linha"

# AI Translated
#. TRN A button that asks the AI to choose another corner of a calibration test.
msgid "Pick another corner"
msgstr "Escolher outro canto"

# AI Translated
#. TRN A button that asks the AI to choose another height of a calibration tower.
msgid "Pick another height"
msgstr "Escolher outra altura"

# AI Translated
#. TRN %1% is a preset's name.
#, boost-format
msgid "Preset · %1%"
msgstr "Predefinição · %1%"

# AI Translated
#. TRN %1% is a preset's name.
#, boost-format
msgid "New preset · %1%"
msgstr "Nova predefinição · %1%"

# AI Translated
#. TRN %1% is the preset the new one is made from.
#, boost-format
msgid "%1% itself is unchanged"
msgstr "%1% permanece sem alterações"

# AI Translated
#. TRN %1% is a setting's new value, such as 215 °C.
#, boost-format
msgid "Save %1% as a new filament preset"
msgstr "Salvar %1% como nova predefinição de filamento"

# AI Translated
#. TRN %1% is a setting's new value, such as 215 °C.
#, boost-format
msgid "Save %1% as a new printer preset"
msgstr "Salvar %1% como nova predefinição de impressora"

# AI Translated
#. TRN %1% is a setting's new value, such as 215 °C.
#, boost-format
msgid "Save %1% as a new process preset"
msgstr "Salvar %1% como nova predefinição de processo"

# AI Translated
#. TRN %1% is a setting's new value, such as 215 °C, %2% a preset's name.
#, boost-format
msgid "Save %1% to %2%"
msgstr "Salvar %1% em %2%"

# AI Translated
msgid "This proposal is already saved."
msgstr "Esta proposta já foi salva."

# AI Translated
msgid "Drop a model here or add one"
msgstr "Solte um modelo aqui ou adicione um"

# AI Translated
msgid "World coordinates"
msgstr "Coordenadas globais"

# AI Translated
msgid "Object coordinates"
msgstr "Coordenadas do objeto"

# AI Translated
msgid "Translate(Relative)"
msgstr "Translacionar (relativo)"

# AI Translated
msgid "Rotate (absolute)"
msgstr "Rotacionar (absoluto)"

# AI Translated
msgid "Part coordinates"
msgstr "Coordenadas da peça"

# AI Translated
msgid "The packaged Home page is missing from this build."
msgstr "A página Início empacotada não está presente nesta versão."

# AI Translated
msgid "The Home page failed to load."
msgstr "Falha ao carregar a página Início."

# AI Translated
msgid "This window stopped updating because the app switched to another printer."
msgstr "Esta janela parou de ser atualizada porque o aplicativo mudou para outra impressora."

# AI Translated
#. TRN A length in millimetres, such as a nozzle diameter on a printer card: "0.4 mm". %s is the number.
#, c-format, boost-format
msgid "%s mm"
msgstr "%s mm"

# AI Translated
#, c-format, boost-format
msgid "The printer reports error %s."
msgstr "A impressora informa o erro %s."

# AI Translated
msgid "LAN"
msgstr "LAN"

# AI Translated
msgid "Cloud"
msgstr "Nuvem"

# AI Translated
msgid "The printer stopped sending updates."
msgstr "A impressora parou de enviar atualizações."

# AI Translated
#, c-format, boost-format
msgid "%s isn't answering."
msgstr "%s não está respondendo."

# AI Translated
msgid "Klipper isn't running."
msgstr "O Klipper não está em execução."

# AI Translated
#. TRN %1% is Klipper's own message, in English, saying why it stopped.
#, boost-format
msgid "Klipper stopped: %1%"
msgstr "O Klipper parou: %1%"

# AI Translated
msgid "This printer no longer exists."
msgstr "Esta impressora não existe mais."

# AI Translated
# Needs human review: Short date on a project card; check that "%2% de %1%" (day, then month abbreviation) reads right, e.g. "20 de out.".
#. TRN A date in this year on a project card: %1% is the abbreviated month name, %2% the day of the month, as in "Oct 20".
#, boost-format
msgctxt "short date"
msgid "%1% %2%"
msgstr "%2% de %1%"

# AI Translated
# Needs human review: Date with year on a project card; %1% is the short date from the entry above, %2% the year.
#. TRN A date outside this year on a project card: %1% is the date without the year, as in "Oct 20", %2% the year.
#, boost-format
msgctxt "date with year"
msgid "%1%, %2%"
msgstr "%1% de %2%"

# AI Translated
msgid "G-code exported"
msgstr "G-code exportado"

# AI Translated
#. TRN A project's status: %1% is a date, as in "Nov 3".
#, boost-format
msgid "G-code exported %1%"
msgstr "G-code exportado em %1%"

# AI Translated
#. TRN A project's status: %1% is a printer model, as in "Ender-3 V3 KE".
#, boost-format
msgid "G-code exported for %1%"
msgstr "G-code exportado para %1%"

# AI Translated
#. TRN A project's status: %1% is a date, as in "Nov 3", %2% a printer model, as in "Ender-3 V3 KE".
#, boost-format
msgid "G-code exported %1% for %2%"
msgstr "G-code exportado em %1% para %2%"

# AI Translated
msgctxt "project status"
msgid "Printed"
msgstr "Impresso"

# AI Translated
#. TRN A project's status: %1% is a date, as in "Oct 20".
#, boost-format
msgid "Printed %1%"
msgstr "Impresso em %1%"

# AI Translated
msgctxt "project status"
msgid "Sent"
msgstr "Enviado"

# AI Translated
#. TRN A project's status: %1% is a date, as in "Oct 20".
#, boost-format
msgid "Sent %1%"
msgstr "Enviado em %1%"

# AI Translated
#. TRN A project's status: it has not been sliced to G-code yet.
msgctxt "project status"
msgid "Draft"
msgstr "Rascunho"

# AI Translated
msgid "That sign-in expired. Try again."
msgstr "Esse login expirou. Tente novamente."

# AI Translated
#, c-format, boost-format
msgid "JusPrin found no %s printers to bring. Choose your printer instead."
msgstr "O JusPrin não encontrou impressoras do %s para trazer. Escolha sua impressora."

# AI Translated
msgid "Generic printer"
msgstr "Impressora genérica"

# AI Translated
msgid "Your projects couldn't be loaded. JusPrin will keep trying."
msgstr "Não foi possível carregar seus projetos. O JusPrin continuará tentando."

# AI Translated
msgid "Untitled project"
msgstr "Projeto sem título"

# AI Translated
#, c-format, boost-format
msgid "Printing on %s"
msgstr "Imprimindo em %s"

# AI Translated
msgid "JusPrin no longer keeps this G-code. Slice the project again to export it."
msgstr "O JusPrin não guarda mais este G-code. Fatie o projeto novamente para exportá-lo."

# AI Translated
msgid "Couldn't export G-code"
msgstr "Não foi possível exportar o G-code"

# AI Translated
msgid "Choose a photo of the printed object"
msgstr "Escolha uma foto do objeto impresso"

# AI Translated
msgid "Photos"
msgstr "Fotos"

# AI Translated
#, c-format, boost-format
msgid "Import from %s"
msgstr "Importar do %s"

# AI Translated
msgid "Importing these printers loads their profiles, which replaces unsaved changes to the project's settings."
msgstr "Importar estas impressoras carrega os perfis delas, o que substitui as alterações não salvas nas configurações do projeto."

# AI Translated
#, c-format, boost-format
msgid "Imported from %s"
msgstr "Importado do %s"

# AI Translated
#, c-format, boost-format
msgid "JusPrin couldn't read this file. To try again, choose Printer › Import printers from %s…"
msgstr "O JusPrin não conseguiu ler este arquivo. Para tentar novamente, escolha Impressora › Importar impressoras do %s…"

# AI Translated
msgid "Not imported. The file has no version."
msgstr "Não importado. O arquivo não tem versão."

# AI Translated
msgid "Not imported. It isn't a printer, filament or process preset."
msgstr "Não importado. Não é uma predefinição de impressora, filamento ou processo."

# AI Translated
#. TRN %1% is the filament preset the file is based on, %2% the app it was imported from.
#, boost-format
msgid "Not imported, because it's based on %1%, which JusPrin doesn't have. It stays in %2%. When you prepare a print, choose a similar filament instead."
msgstr "Não foi importado porque se baseia em %1%, que o JusPrin não tem. Continua no %2%. Ao preparar uma impressão, escolha um filamento semelhante."

# AI Translated
#. TRN %1% is the print settings preset the file is based on, %2% the app it was imported from.
#, boost-format
msgid "Not imported, because they're based on %1%, which JusPrin doesn't have. They stay in %2%. When you prepare a print, choose similar print settings instead."
msgstr "Não foram importadas porque se baseiam em %1%, que o JusPrin não tem. Continuam no %2%. Ao preparar uma impressão, escolha configurações de impressão semelhantes."

# AI Translated
#. TRN %1% is the printer profile the file is based on, %2% the app it was imported from.
#, boost-format
msgid "Not imported, because it's based on %1%, which JusPrin doesn't have. It stays in %2%. When you add a printer, choose a similar one instead."
msgstr "Não foi importado porque se baseia em %1%, que o JusPrin não tem. Continua no %2%. Ao adicionar uma impressora, escolha uma semelhante."

# AI Translated
#, c-format, boost-format
