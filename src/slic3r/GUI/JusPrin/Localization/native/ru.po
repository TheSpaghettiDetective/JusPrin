# AI Translated
#. TRN %1% is a calibration result, such as 215 °C.
#, boost-format
msgid "result %1% saved"
msgstr "результат %1% сохранён"

# AI Translated
#. TRN %1% is a plate's name, %2% why the slice did not succeed.
#, boost-format
msgid "The app did not slice %1%: %2%"
msgstr "Приложение не выполнило нарезку %1%: %2%"

# AI Translated
#. TRN %1% is a plate's name, %2% why the slice did not succeed.
#, boost-format
msgid "The app stopped the slice of %1%: %2%"
msgstr "Приложение остановило нарезку %1%: %2%"

# AI Translated
msgid "The slice of every plate finished."
msgstr "Нарезка всех столов завершена."

# AI Translated
#. TRN %1% is a plate's name.
#, boost-format
msgid "The slice of %1% finished."
msgstr "Нарезка %1% завершена."

# AI Translated
msgid "Restored this chat's saved project setup. Check the current printer and material before printing."
msgstr "Восстановлена сохранённая в этом чате настройка проекта. Перед печатью проверьте текущий принтер и материал."

# AI Translated
msgid "A credential check is already running."
msgstr "Проверка учётных данных уже выполняется."

# AI Translated
msgid "This build cannot verify a key for that provider yet."
msgstr "Эта сборка пока не может проверить ключ этого поставщика."

# AI Translated
msgid "A sign-in or key check is already running."
msgstr "Вход или проверка ключа уже выполняется."

# AI Translated
msgid "JusPrin couldn't sign you in. Try again."
msgstr "JusPrin не удалось выполнить вход. Попробуйте ещё раз."

# AI Translated
msgid "The AI service is not available."
msgstr "Сервис ИИ недоступен."

# AI Translated
msgid "The AI service could not start this request."
msgstr "Сервису ИИ не удалось начать обработку этого запроса."

# AI Translated
msgid "AI could not receive the native tool result."
msgstr "ИИ не удалось получить результат инструмента приложения."

# AI Translated
msgid "The AI request failed."
msgstr "Запрос к ИИ не выполнен."

# AI Translated
#. TRN The heading of the chat's model menu over a model that runs on this computer.
msgid "On this computer"
msgstr "На этом компьютере"

# AI Translated
msgid "This chat ran on a model on this computer that is no longer set up. Set it up again in the AI settings to continue it, or start a new chat."
msgstr "Этот чат работал на модели с этого компьютера, которая больше не настроена. Настройте её снова в настройках ИИ, чтобы продолжить чат, или начните новый."

# AI Translated
#. TRN %1% is an AI provider's account, such as JusPrin.
#, boost-format
msgid "This chat ran on your %1% account. Sign in again to continue it, or start a new chat."
msgstr "Этот чат работал через вашу учётную запись %1%. Войдите снова, чтобы продолжить его, или начните новый чат."

# AI Translated
#. TRN %1% is an AI provider, such as OpenAI.
#, boost-format
msgid "This chat ran on %1%, and no %1% API key is set up now. Add the key in the AI settings to continue it, or start a new chat."
msgstr "Этот чат работал через %1%, но API-ключ %1% сейчас не настроен. Добавьте ключ в настройках ИИ, чтобы продолжить чат, или начните новый."

# AI Translated
msgid "JusPrin hasn't loaded the AI models for your account yet. Try again in a moment."
msgstr "JusPrin ещё не загрузил модели ИИ для вашей учётной записи. Повторите попытку чуть позже."

# AI Translated
#. TRN %1% is an AI provider, such as OpenAI.
#, boost-format
msgid "No %1% API key is set up. Add it in the AI settings, or choose another model."
msgstr "API-ключ %1% не настроен. Добавьте его в настройках ИИ или выберите другую модель."

# AI Translated
msgid "A connection is already being saved."
msgstr "Подключение уже сохраняется."

# AI Translated
msgid "JusPrin's connection helper is missing. Reinstall or rebuild JusPrin."
msgstr "Отсутствует вспомогательная программа подключения JusPrin. Переустановите или пересоберите JusPrin."

# AI Translated
msgid "The AppImage launcher is missing. Reopen the installed AppImage."
msgstr "Отсутствует загрузчик AppImage. Откройте установленный AppImage заново."

# AI Translated
msgid "Review the change before connecting."
msgstr "Проверьте изменение перед подключением."

# AI Translated
#. TRN %1% is an AI client app, such as Claude Code.
#, boost-format
msgid "%1% isn't installed. Install it, or copy the command and run it later."
msgstr "%1% не установлен. Установите его или скопируйте команду и выполните её позже."

# AI Translated
msgid "This build cannot run the client CLI."
msgstr "Эта сборка не может запустить CLI клиента."

# AI Translated
msgid "The provider did not answer."
msgstr "Поставщик не ответил."

# AI Translated
msgid "Attach files"
msgstr "Прикрепить файлы"

# AI Translated
msgid "The AI panel could not connect"
msgstr "Не удалось подключить панель ИИ"

# AI Translated
msgid "Back to Prepare"
msgstr "Вернуться к подготовке"

# AI Translated
msgid "Open filament settings"
msgstr "Открыть настройки материала"

# AI Translated
msgid "The packaged AI page is missing from this build."
msgstr "В этой сборке отсутствует встроенная страница ИИ."

# AI Translated
msgid "The system web view could not be created."
msgstr "Не удалось создать системный компонент веб-просмотра."

# AI Translated
msgid "The AI page failed to load."
msgstr "Не удалось загрузить страницу ИИ."

# AI Translated
msgid "The AI page did not complete the bridge handshake."
msgstr "Страница ИИ не завершила установку связи с приложением."

# AI Translated
msgid "Restart the application to load the AI page."
msgstr "Перезапустите приложение, чтобы загрузить страницу ИИ."

# AI Translated
msgid "This is an internal connection between the application and its AI panel, not a network service."
msgstr "Это внутреннее соединение между приложением и его панелью ИИ, а не сетевой сервис."

# AI Translated
#. TRN %1% is the web view's own error text.
#, boost-format
msgid "Last load error: %1%"
msgstr "Последняя ошибка загрузки: %1%"

# AI Translated
#. TRN The messages the app and its AI panel exchanged. %1% and %2% are counts.
#, boost-format
msgid "Bridge traffic: %1% sent / %2% received"
msgstr "Обмен с панелью: отправлено %1% / получено %2%"

# AI Translated
#. TRN %1% is the AI service's own reason, in English, such as "cyber".
#, boost-format
msgid "The AI service declined to answer (%1%)."
msgstr "Сервис ИИ отказался отвечать (%1%)."

# AI Translated
msgid "This version of JusPrin can no longer connect to JusPrin accounts. Get the new version to keep using your account."
msgstr "Эта версия JusPrin больше не может подключаться к учётным записям JusPrin. Установите новую версию, чтобы и дальше пользоваться учётной записью."

# AI Translated
msgid "Your JusPrin sign-in has ended. Sign in again in Preferences, then try again."
msgstr "Срок вашего входа в JusPrin истёк. Войдите снова в настройках, затем повторите попытку."

# AI Translated
msgid "Your plan is still active. Cancel it in Credits and plans, then delete your account."
msgstr "Ваш тариф всё ещё активен. Отмените его в разделе «Кредиты и тарифы», затем удалите учётную запись."

# AI Translated
#. TRN The address is JusPrin's support email; keep it unchanged.
msgid "This account has been deactivated. If you think this is a mistake, email jusprin-support@obico.io."
msgstr "Эта учётная запись деактивирована. Если вы считаете, что это ошибка, напишите на jusprin-support@obico.io."

# AI Translated
msgid "Signing in didn't finish. Nothing was saved. Try again."
msgstr "Вход не завершён. Ничего не сохранено. Попробуйте ещё раз."

# AI Translated
msgid "JusPrin couldn't be reached to finish signing in. Try again."
msgstr "Не удалось связаться с JusPrin для завершения входа. Попробуйте ещё раз."

# AI Translated
msgid "JusPrin has no AI model for this account right now. Try again later."
msgstr "Сейчас для этой учётной записи в JusPrin нет модели ИИ. Повторите попытку позже."

# AI Translated
msgid "another app"
msgstr "другое приложение"

