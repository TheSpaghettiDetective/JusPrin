# AI Translated
msgid "Something went wrong on our side"
msgstr "Что-то пошло не так на нашей стороне"

# AI Translated
#. TRN Said in the chat when a project opens whose chats a newer version of JusPrin saved; they are kept, not shown.
msgid "This project's chats were saved by a newer version of JusPrin. Get the new version to see them."
msgstr "Чаты этого проекта сохранены более новой версией JusPrin. Установите новую версию, чтобы увидеть их."

# AI Translated
# Needs human review: The English ("until restoration is recovered") is unclear; check the meaning in the code.
msgid "Project chat is blocked until restoration is recovered."
msgstr "Чат проекта недоступен, пока восстановление не будет завершено."

# AI Translated
msgid "Return to the active chat or restore this chat before sending."
msgstr "Вернитесь в активный чат или восстановите этот чат, прежде чем отправлять сообщение."

# AI Translated
msgid "Finish or cancel AI configuration before sending a message."
msgstr "Завершите или отмените настройку ИИ, прежде чем отправлять сообщение."

# AI Translated
msgid "This file is too large to attach."
msgstr "Файл слишком большой для вложения."

# AI Translated
msgid "This file type can't be read by AI."
msgstr "ИИ не может прочитать файлы этого типа."

# AI Translated
msgid "This file is not readable UTF-8 text."
msgstr "Этот файл не является текстом в кодировке UTF-8."

# AI Translated
msgid "Photo or image"
msgstr "Фото или изображение"

# AI Translated
msgid "3D model"
msgstr "3D-модель"

# AI Translated
msgid "Document (PDF)"
msgstr "Документ (PDF)"

