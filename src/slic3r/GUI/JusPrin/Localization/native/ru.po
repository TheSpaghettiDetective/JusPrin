# AI Translated
msgid "Something went wrong on our side"
msgstr "Что-то пошло не так на нашей стороне"

# AI Translated
# Needs human review: The English ("until restoration is recovered") is unclear; check the meaning in the code.
msgid "Project chat is blocked until restoration is recovered."
msgstr "Чат проекта недоступен, пока восстановление не будет завершено."

# AI Translated
msgid "Return to the active chat or restore this chat before sending."
msgstr "Вернитесь в активный чат или восстановите этот чат, прежде чем отправлять сообщение."

# AI Translated
msgid "Finish or cancel AI configuration before sending a message."
msgstr "Завершите или отмените настройку ИИ, прежде чем отправлять сообщение."

# AI Translated
msgid "This file is too large to attach."
msgstr "Файл слишком большой для вложения."

# AI Translated
msgid "This file type can't be read by AI."
msgstr "ИИ не может прочитать файлы этого типа."

# AI Translated
msgid "This file is not readable UTF-8 text."
msgstr "Этот файл не является текстом в кодировке UTF-8."

# AI Translated
msgid "Photo or image"
msgstr "Фото или изображение"

# AI Translated
msgid "3D model"
msgstr "3D-модель"

# AI Translated
msgid "Document (PDF)"
msgstr "Документ (PDF)"

# AI Translated
# Needs human review: "From %1%" rendered as "Источник: %1%" so the substituted place name needs no case; check it reads well with real values.
#. TRN A calibration chat's first line. %1%: where it was started from, %2%: a printer.
#, boost-format
msgid "From %1% · %2% · filament not chosen · temporary test settings"
msgstr "Источник: %1% · %2% · материал не выбран · временные тестовые настройки"

# AI Translated
# Needs human review: "From %1%" rendered as "Источник: %1%"; check with real values.
#. TRN A calibration chat's first line. %1%: where it was started from, %2%: a filament, %3%: a printer.
#, boost-format
msgid "From %1% · %2% on %3% · temporary test settings"
msgstr "Источник: %1% · %2% на %3% · временные тестовые настройки"

# AI Translated
#. TRN A reopened calibration test's line. %1%: the day it was made, as "21 Oct 2026".
#, boost-format
msgid "Reopened · generated %1%"
msgstr "Открыт повторно · создан %1%"

# AI Translated
#. TRN %1%: where the test was opened from, %2%: the day it was made, as "21 Oct 2026".
#, boost-format
msgid "Opened from %1% · generated %2%"
msgstr "Открыт из: %1% · создан %2%"

# AI Translated
#. TRN %1% is a calibration result, such as 215 °C.
#, boost-format
msgid "result %1% saved"
msgstr "результат %1% сохранён"

# AI Translated
#. TRN %1% is a plate's name, %2% why the slice did not succeed.
#, boost-format
msgid "The app did not slice %1%: %2%"
msgstr "Приложение не выполнило нарезку %1%: %2%"

# AI Translated
#. TRN %1% is a plate's name, %2% why the slice did not succeed.
#, boost-format
msgid "The app stopped the slice of %1%: %2%"
msgstr "Приложение остановило нарезку %1%: %2%"

# AI Translated
msgid "The slice of every plate finished."
msgstr "Нарезка всех столов завершена."

# AI Translated
#. TRN %1% is a plate's name.
#, boost-format
msgid "The slice of %1% finished."
msgstr "Нарезка %1% завершена."

# AI Translated
msgid "Restored this chat's saved project setup. Check the current printer and material before printing."
msgstr "Восстановлена сохранённая в этом чате настройка проекта. Перед печатью проверьте текущий принтер и материал."

# AI Translated
msgid "A credential check is already running."
msgstr "Проверка учётных данных уже выполняется."

# AI Translated
msgid "This build cannot verify a key for that provider yet."
msgstr "Эта сборка пока не может проверить ключ этого поставщика."

# AI Translated
msgid "A sign-in or key check is already running."
msgstr "Вход или проверка ключа уже выполняется."

# AI Translated
msgid "JusPrin couldn't sign you in. Try again."
msgstr "JusPrin не удалось выполнить вход. Попробуйте ещё раз."

# AI Translated
msgid "The AI service is not available."
msgstr "Сервис ИИ недоступен."

# AI Translated
msgid "The AI service could not start this request."
msgstr "Сервису ИИ не удалось начать обработку этого запроса."

# AI Translated
msgid "AI could not receive the native tool result."
msgstr "ИИ не удалось получить результат инструмента приложения."

# AI Translated
msgid "The AI request failed."
msgstr "Запрос к ИИ не выполнен."

# AI Translated
#. TRN %1% is an AI provider's account, such as JusPrin.
#, boost-format
msgid "This chat ran on your %1% account. Sign in again to continue it, or start a new chat."
msgstr "Этот чат работал через вашу учётную запись %1%. Войдите снова, чтобы продолжить его, или начните новый чат."

# AI Translated
#. TRN %1% is an AI provider, such as OpenAI.
#, boost-format
msgid "This chat ran on %1%, and no %1% API key is set up now. Add the key in the AI settings to continue it, or start a new chat."
msgstr "Этот чат работал через %1%, но API-ключ %1% сейчас не настроен. Добавьте ключ в настройках ИИ, чтобы продолжить чат, или начните новый."

# AI Translated
msgid "JusPrin hasn't loaded the AI models for your account yet. Try again in a moment."
msgstr "JusPrin ещё не загрузил модели ИИ для вашей учётной записи. Повторите попытку чуть позже."

# AI Translated
#. TRN %1% is an AI provider, such as OpenAI.
#, boost-format
msgid "No %1% API key is set up. Add it in the AI settings, or choose another model."
msgstr "API-ключ %1% не настроен. Добавьте его в настройках ИИ или выберите другую модель."

# AI Translated
msgid "A connection is already being saved."
msgstr "Подключение уже сохраняется."

# AI Translated
msgid "JusPrin's connection helper is missing. Reinstall or rebuild JusPrin."
msgstr "Отсутствует вспомогательная программа подключения JusPrin. Переустановите или пересоберите JusPrin."

# AI Translated
msgid "The AppImage launcher is missing. Reopen the installed AppImage."
msgstr "Отсутствует загрузчик AppImage. Откройте установленный AppImage заново."

# AI Translated
msgid "Review the change before connecting."
msgstr "Проверьте изменение перед подключением."

# AI Translated
#. TRN %1% is an AI client app, such as Claude Code.
#, boost-format
msgid "%1% isn't installed. Install it, or copy the command and run it later."
msgstr "%1% не установлен. Установите его или скопируйте команду и выполните её позже."

# AI Translated
msgid "This build cannot run the client CLI."
msgstr "Эта сборка не может запустить CLI клиента."

# AI Translated
msgid "The provider did not answer."
msgstr "Поставщик не ответил."

# AI Translated
msgid "Attach files"
msgstr "Прикрепить файлы"

# AI Translated
msgid "The AI panel could not connect"
msgstr "Не удалось подключить панель ИИ"

# AI Translated
msgid "Back to Prepare"
msgstr "Вернуться к подготовке"

# AI Translated
msgid "Open filament settings"
msgstr "Открыть настройки материала"

# AI Translated
msgid "The packaged AI page is missing from this build."
msgstr "В этой сборке отсутствует встроенная страница ИИ."

# AI Translated
msgid "The system web view could not be created."
msgstr "Не удалось создать системный компонент веб-просмотра."

# AI Translated
msgid "The AI page failed to load."
msgstr "Не удалось загрузить страницу ИИ."

# AI Translated
msgid "The AI page did not complete the bridge handshake."
msgstr "Страница ИИ не завершила установку связи с приложением."

# AI Translated
msgid "Restart the application to load the AI page."
msgstr "Перезапустите приложение, чтобы загрузить страницу ИИ."

# AI Translated
msgid "This is an internal connection between the application and its AI panel, not a network service."
msgstr "Это внутреннее соединение между приложением и его панелью ИИ, а не сетевой сервис."

# AI Translated
#. TRN %1% is the web view's own error text.
#, boost-format
msgid "Last load error: %1%"
msgstr "Последняя ошибка загрузки: %1%"

# AI Translated
#. TRN The messages the app and its AI panel exchanged. %1% and %2% are counts.
#, boost-format
msgid "Bridge traffic: %1% sent / %2% received"
msgstr "Обмен с панелью: отправлено %1% / получено %2%"

# AI Translated
#. TRN %1% is the AI service's own reason, in English, such as "cyber".
#, boost-format
msgid "The AI service declined to answer (%1%)."
msgstr "Сервис ИИ отказался отвечать (%1%)."

# AI Translated
msgid "This version of JusPrin can no longer connect to JusPrin accounts. Get the new version to keep using your account."
msgstr "Эта версия JusPrin больше не может подключаться к учётным записям JusPrin. Установите новую версию, чтобы и дальше пользоваться учётной записью."

# AI Translated
msgid "Your JusPrin sign-in has ended. Sign in again in Preferences, then try again."
msgstr "Срок вашего входа в JusPrin истёк. Войдите снова в настройках, затем повторите попытку."

# AI Translated
msgid "Signing in didn't finish. Nothing was saved. Try again."
msgstr "Вход не завершён. Ничего не сохранено. Попробуйте ещё раз."

# AI Translated
msgid "JusPrin couldn't be reached to finish signing in. Try again."
msgstr "Не удалось связаться с JusPrin для завершения входа. Попробуйте ещё раз."

# AI Translated
msgid "JusPrin has no AI model for this account right now. Try again later."
msgstr "Сейчас для этой учётной записи в JusPrin нет модели ИИ. Повторите попытку позже."

# AI Translated
msgid "Restored an earlier project version"
msgstr "Восстановлена более ранняя версия проекта"

# AI Translated
msgid "Restored this chat's saved project setup"
msgstr "Восстановлена сохранённая в этом чате настройка проекта"

# AI Translated
#. TRN The chat list's preview of a message that has only attachments.
msgid "Attachment"
msgstr "Вложение"

# AI Translated
#. TRN %1% is an AI provider, such as OpenAI.
#, boost-format
msgid "The %1% service is rate limited. Try again shortly."
msgstr "Сервис %1% ограничил частоту запросов. Повторите попытку чуть позже."

# AI Translated
#. TRN %1% is an AI provider, such as OpenAI.
#, boost-format
msgid "The request was too large for the %1% service."
msgstr "Запрос слишком велик для сервиса %1%."

# AI Translated
#. TRN %1% is an AI provider, such as OpenAI.
#, boost-format
msgid "The AI request could not reach the %1% service."
msgstr "Не удалось связаться с сервисом %1% для запроса к ИИ."

# AI Translated
#, boost-format
msgid "This message needs %1% credit; you have %2%."
msgid_plural "This message needs %1% credits; you have %2%."
msgstr[0] "Этому сообщению нужен %1% кредит; у вас %2%."
msgstr[1] "Этому сообщению нужно %1% кредита; у вас %2%."
msgstr[2] "Этому сообщению нужно %1% кредитов; у вас %2%."

# AI Translated
#. TRN %1% is an AI provider, such as OpenAI.
#, boost-format
msgid "The %1% API key was rejected. Update the AI configuration and try again."
msgstr "API-ключ %1% отклонён. Обновите настройки ИИ и повторите попытку."

# AI Translated
#. TRN A button that asks the AI to choose another block of a calibration test.
msgid "Pick another block"
msgstr "Выбрать другой блок"

# AI Translated
#. TRN A button that asks the AI to choose another tile of a calibration test.
msgid "Pick another tile"
msgstr "Выбрать другую плитку"

# AI Translated
#. TRN A button that asks the AI to choose another line of a calibration test.
msgid "Pick another line"
msgstr "Выбрать другую линию"

# AI Translated
#. TRN A button that asks the AI to choose another corner of a calibration test.
msgid "Pick another corner"
msgstr "Выбрать другой угол"

# AI Translated
#. TRN A button that asks the AI to choose another height of a calibration tower.
msgid "Pick another height"
msgstr "Выбрать другую высоту"

# AI Translated
#. TRN %1% is a preset's name.
#, boost-format
msgid "Preset · %1%"
msgstr "Профиль · %1%"

# AI Translated
#. TRN %1% is a preset's name.
#, boost-format
msgid "New preset · %1%"
msgstr "Новый профиль · %1%"

# AI Translated
#. TRN %1% is the preset the new one is made from.
#, boost-format
msgid "%1% itself is unchanged"
msgstr "%1% остаётся без изменений"

# AI Translated
#. TRN %1% is a setting's new value, such as 215 °C.
#, boost-format
msgid "Save %1% as a new filament preset"
msgstr "Сохранить %1% как новый профиль материала"

# AI Translated
#. TRN %1% is a setting's new value, such as 215 °C.
#, boost-format
msgid "Save %1% as a new printer preset"
msgstr "Сохранить %1% как новый профиль принтера"

# AI Translated
#. TRN %1% is a setting's new value, such as 215 °C.
#, boost-format
msgid "Save %1% as a new process preset"
msgstr "Сохранить %1% как новый профиль настроек печати"

# AI Translated
#. TRN %1% is a setting's new value, such as 215 °C, %2% a preset's name.
#, boost-format
msgid "Save %1% to %2%"
msgstr "Сохранить %1% в %2%"

# AI Translated
msgid "Drop a model here or add one"
msgstr "Перетащите модель сюда или добавьте её"

# AI Translated
msgid "World coordinates"
msgstr "Глобальные координаты"

# AI Translated
msgid "Object coordinates"
msgstr "Координаты модели"

# AI Translated
msgid "Translate(Relative)"
msgstr "Перемещение (относительное)"

# AI Translated
msgid "Rotate (absolute)"
msgstr "Поворот (абсолютный)"

# AI Translated
msgid "Part coordinates"
msgstr "Координаты части"

# AI Translated
msgid "The packaged Home page is missing from this build."
msgstr "В этой сборке отсутствует встроенная страница «Главная»."

# AI Translated
msgid "The Home page failed to load."
msgstr "Не удалось загрузить страницу «Главная»."

# AI Translated
msgid "This window stopped updating because the app switched to another printer."
msgstr "Это окно перестало обновляться, потому что приложение переключилось на другой принтер."

# AI Translated
#. TRN A length in millimetres, such as a nozzle diameter on a printer card: "0.4 mm". %s is the number.
#, c-format, boost-format
msgid "%s mm"
msgstr "%s мм"

# AI Translated
#, c-format, boost-format
msgid "The printer reports error %s."
msgstr "Принтер сообщает об ошибке %s."

# AI Translated
msgid "LAN"
msgstr "LAN"

# AI Translated
msgid "Cloud"
msgstr "Облако"

# AI Translated
msgid "The printer stopped sending updates."
msgstr "Принтер перестал присылать обновления."

# AI Translated
#, c-format, boost-format
msgid "%s isn't answering."
msgstr "%s не отвечает."

# AI Translated
msgid "Klipper isn't running."
msgstr "Klipper не запущен."

# AI Translated
#. TRN %1% is Klipper's own message, in English, saying why it stopped.
#, boost-format
msgid "Klipper stopped: %1%"
msgstr "Klipper остановлен: %1%"

# AI Translated
msgid "This printer no longer exists."
msgstr "Этот принтер больше не существует."

# AI Translated
# Needs human review: Day before the abbreviated month ("20 окт."); check the month abbreviations the app substitutes read right after the day.
#. TRN A date in this year on a project card: %1% is the abbreviated month name, %2% the day of the month, as in "Oct 20".
#, boost-format
msgctxt "short date"
msgid "%1% %2%"
msgstr "%2% %1%"

# AI Translated
#. TRN A date outside this year on a project card: %1% is the date without the year, as in "Oct 20", %2% the year.
#, boost-format
msgctxt "date with year"
msgid "%1%, %2%"
msgstr "%1% %2%"

# AI Translated
msgid "G-code exported"
msgstr "G-code экспортирован"

# AI Translated
#. TRN A project's status: %1% is a date, as in "Nov 3".
#, boost-format
msgid "G-code exported %1%"
msgstr "G-code экспортирован %1%"

# AI Translated
#. TRN A project's status: %1% is a printer model, as in "Ender-3 V3 KE".
#, boost-format
msgid "G-code exported for %1%"
msgstr "G-code экспортирован для %1%"

# AI Translated
#. TRN A project's status: %1% is a date, as in "Nov 3", %2% a printer model, as in "Ender-3 V3 KE".
#, boost-format
msgid "G-code exported %1% for %2%"
msgstr "G-code экспортирован %1% для %2%"

# AI Translated
msgctxt "project status"
msgid "Printed"
msgstr "Напечатан"

# AI Translated
#. TRN A project's status: %1% is a date, as in "Oct 20".
#, boost-format
msgid "Printed %1%"
msgstr "Напечатан %1%"

# AI Translated
msgctxt "project status"
msgid "Sent"
msgstr "Отправлен"

# AI Translated
#. TRN A project's status: %1% is a date, as in "Oct 20".
#, boost-format
msgid "Sent %1%"
msgstr "Отправлен %1%"

# AI Translated
#. TRN A project's status: it has not been sliced to G-code yet.
msgctxt "project status"
msgid "Draft"
msgstr "Черновик"

# AI Translated
msgid "That sign-in expired. Try again."
msgstr "Срок действия входа истёк. Попробуйте ещё раз."

# AI Translated
#, c-format, boost-format
msgid "JusPrin found no %s printers to bring. Choose your printer instead."
msgstr "JusPrin не нашёл принтеров %s для переноса. Выберите свой принтер вручную."

# AI Translated
msgid "Generic printer"
msgstr "Универсальный принтер"

# AI Translated
msgid "Your projects couldn't be loaded. JusPrin will keep trying."
msgstr "Не удалось загрузить ваши проекты. JusPrin продолжит попытки."

# AI Translated
msgid "Untitled project"
msgstr "Проект без названия"

# AI Translated
#, c-format, boost-format
msgid "Printing on %s"
msgstr "Печать на %s"

# AI Translated
msgid "JusPrin no longer keeps this G-code. Slice the project again to export it."
msgstr "JusPrin больше не хранит этот G-code. Нарежьте проект снова, чтобы экспортировать его."

# AI Translated
msgid "Couldn't export G-code"
msgstr "Не удалось экспортировать G-code"

# AI Translated
msgid "Choose a photo of the printed object"
msgstr "Выберите фото напечатанной модели"

# AI Translated
msgid "Photos"
msgstr "Фотографии"

# AI Translated
#, c-format, boost-format
msgid "Import from %s"
msgstr "Импорт из %s"

# AI Translated
msgid "Importing these printers loads their profiles, which replaces unsaved changes to the project's settings."
msgstr "При импорте этих принтеров загружаются их профили, и несохранённые изменения настроек проекта будут заменены."

# AI Translated
#, c-format, boost-format
msgid "Imported from %s"
msgstr "Импортировано из %s"

# AI Translated
#, c-format, boost-format
msgid "JusPrin couldn't read this file. To try again, choose Printer › Import printers from %s…"
msgstr "JusPrin не удалось прочитать этот файл. Чтобы повторить попытку, выберите «Принтер › Импортировать принтеры из %s…»"

# AI Translated
msgid "Not imported. The file has no version."
msgstr "Не импортировано. У файла нет версии."

# AI Translated
msgid "Not imported. It isn't a printer, filament or process preset."
msgstr "Не импортировано. Это не профиль принтера, материала или настроек печати."

# AI Translated
#. TRN %1% is the filament preset the file is based on, %2% the app it was imported from.
#, boost-format
msgid "Not imported, because it's based on %1%, which JusPrin doesn't have. It stays in %2%. When you prepare a print, choose a similar filament instead."
msgstr "Не импортировано: профиль основан на %1%, которого нет в JusPrin. Он остаётся в %2%. При подготовке печати выберите похожий материал."

# AI Translated
#. TRN %1% is the print settings preset the file is based on, %2% the app it was imported from.
#, boost-format
msgid "Not imported, because they're based on %1%, which JusPrin doesn't have. They stay in %2%. When you prepare a print, choose similar print settings instead."
msgstr "Не импортировано: профили основаны на %1%, которого нет в JusPrin. Они остаются в %2%. При подготовке печати выберите похожие настройки печати."

# AI Translated
#. TRN %1% is the printer profile the file is based on, %2% the app it was imported from.
#, boost-format
msgid "Not imported, because it's based on %1%, which JusPrin doesn't have. It stays in %2%. When you add a printer, choose a similar one instead."
msgstr "Не импортировано: профиль основан на %1%, которого нет в JusPrin. Он остаётся в %2%. При добавлении принтера выберите похожий."

# AI Translated
#, c-format, boost-format
msgid "JusPrin couldn't load this preset. To try again, choose Printer › Import printers from %s…"
msgstr "JusPrin не удалось загрузить этот профиль. Чтобы повторить попытку, выберите «Принтер › Импортировать принтеры из %s…»"

# AI Translated
#, c-format, boost-format
msgid "It's based on %s, which JusPrin doesn't have. When you prepare a print, choose a similar filament instead."
msgstr "Он основан на %s, которого нет в JusPrin. При подготовке печати выберите похожий материал."

# AI Translated
#, c-format, boost-format
msgid "It's based on %s, which JusPrin doesn't have. When you prepare a print, choose similar print settings instead."
