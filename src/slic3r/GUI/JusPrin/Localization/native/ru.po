msgstr "Восстановлена сохранённая в этом чате настройка проекта"

# AI Translated
#. TRN The chat list's preview of a message that has only attachments.
msgid "Attachment"
msgstr "Вложение"

# AI Translated
#. TRN %1% is an AI provider, such as OpenAI: the person's own account there has no credits left.
#, boost-format
msgid "Your %1% account is out of credits. Add credits at %1%, then try again."
msgstr "На вашем аккаунте %1% закончились средства. Пополните баланс в сервисе %1% и повторите попытку."

# AI Translated
#. TRN %1% is an AI provider, such as OpenAI.
#, boost-format
msgid "The %1% service is rate limited. Try again shortly."
msgstr "Сервис %1% ограничил частоту запросов. Повторите попытку чуть позже."

# AI Translated
#. TRN %1% is an AI provider, such as OpenAI. Its service is down or overloaded on its own side.
#, boost-format
msgid "The %1% service is having trouble right now. Try again later."
msgstr "У сервиса %1% сейчас неполадки. Повторите попытку позже."

# AI Translated
#, boost-format
msgid "Nothing is answering at %1%. Start Ollama or LM Studio, then try again."
msgstr "По адресу %1% никто не отвечает. Запустите Ollama или LM Studio, затем повторите попытку."

# AI Translated
msgid "This model can't run the app's tools. Pick a model with tool support and a context of at least 32k."
msgstr "Эта модель не может использовать инструменты приложения. Выберите модель с поддержкой инструментов и контекстом не меньше 32k."

# AI Translated
#. TRN %1% is an AI provider, such as OpenAI.
#, boost-format
msgid "The AI request could not reach the %1% service."
msgstr "Не удалось связаться с сервисом %1% для запроса к ИИ."

# AI Translated
#, boost-format
msgid "This message needs %1% credit; you have %2%."
msgid_plural "This message needs %1% credits; you have %2%."
msgstr[0] "Этому сообщению нужен %1% кредит; у вас %2%."
msgstr[1] "Этому сообщению нужно %1% кредита; у вас %2%."
msgstr[2] "Этому сообщению нужно %1% кредитов; у вас %2%."

# AI Translated
#. TRN %1% is an AI provider, such as OpenAI.
#, boost-format
msgid "The %1% API key was rejected. Update the AI configuration and try again."
msgstr "API-ключ %1% отклонён. Обновите настройки ИИ и повторите попытку."

# AI Translated
#. TRN %1% is how many settings, %2% an object's name or a preset's name in quotes, %3% the settings' keys.
#, boost-format
msgid "Change %1% setting of %2%: %3%"
msgid_plural "Change %1% settings of %2%: %3%"
msgstr[0] "Изменить %1% параметр в %2%: %3%"
msgstr[1] "Изменить %1% параметра в %2%: %3%"
msgstr[2] "Изменить %1% параметров в %2%: %3%"

# AI Translated
#. TRN %1% is how many settings, %2% a preset's name in quotes, %3% the settings' keys. The preset is saved with them.
#, boost-format
msgid "Change %1% setting of %2%: %3%; save it"
msgid_plural "Change %1% settings of %2%: %3%; save it"
msgstr[0] "Изменить %1% параметр в %2%: %3%; сохранить профиль"
msgstr[1] "Изменить %1% параметра в %2%: %3%; сохранить профиль"
msgstr[2] "Изменить %1% параметров в %2%: %3%; сохранить профиль"

# AI Translated
#. TRN %1% is how many settings, %2% a preset's name in quotes, %3% the settings' keys, %4% the new preset's name.
#, boost-format
msgid "Change %1% setting of %2%: %3%; save as \"%4%\""
msgid_plural "Change %1% settings of %2%: %3%; save as \"%4%\""
msgstr[0] "Изменить %1% параметр в %2%: %3%; сохранить как \"%4%\""
msgstr[1] "Изменить %1% параметра в %2%: %3%; сохранить как \"%4%\""
msgstr[2] "Изменить %1% параметров в %2%: %3%; сохранить как \"%4%\""

# AI Translated
#. TRN %1% and %2% are the tower's first and last temperatures.
#, boost-format
msgid "Make a temperature tower, %1% °C to %2% °C"
msgstr "Создать температурную башню от %1% °C до %2% °C"

# AI Translated
#. TRN YOLO is the name of OrcaSlicer's quicker flow-ratio test; %1% is its pass, 1 or 2.
#, boost-format
msgid "Make a flow-ratio test, YOLO pass %1%"
msgstr "Создать тест коэффициента потока: YOLO, проход %1%"

# AI Translated
#. TRN %1% is the test's pass, 1 or 2.
#, boost-format
msgid "Make a flow-ratio test, classic pass %1%"
