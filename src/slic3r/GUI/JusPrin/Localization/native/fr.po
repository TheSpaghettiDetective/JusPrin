msgstr "Revenez à la conversation active ou restaurez cette conversation avant d'envoyer."

# AI Translated
msgid "Finish or cancel AI configuration before sending a message."
msgstr "Terminez ou annulez la configuration de l'IA avant d'envoyer un message."

