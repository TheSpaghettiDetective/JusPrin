# AI Translated
msgid "A credential check is already running."
msgstr "Une vérification d'identifiants est déjà en cours."

# AI Translated
msgid "This build cannot verify a key for that provider yet."
msgstr "Cette version ne peut pas encore vérifier de clé pour ce fournisseur."

# AI Translated
msgid "A sign-in or key check is already running."
msgstr "Une connexion ou une vérification de clé est déjà en cours."

# AI Translated
msgid "JusPrin couldn't sign you in. Try again."
msgstr "JusPrin n'a pas pu vous connecter. Réessayez."

# AI Translated
msgid "The AI service is not available."
msgstr "Le service d'IA n'est pas disponible."

# AI Translated
msgid "The AI service could not start this request."
msgstr "Le service d'IA n'a pas pu lancer cette requête."

# AI Translated
msgid "AI could not receive the native tool result."
msgstr "L'IA n'a pas pu recevoir le résultat de l'outil natif."

