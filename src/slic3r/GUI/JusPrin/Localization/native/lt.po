# AI Translated
msgid "Project chat is blocked until restoration is recovered."
msgstr "Projekto pokalbis užblokuotas, kol atkūrimas nebus sutvarkytas."

# AI Translated
msgid "Return to the active chat or restore this chat before sending."
msgstr "Prieš siųsdami grįžkite į aktyvų pokalbį arba atkurkite šį pokalbį."

# AI Translated
msgid "Finish or cancel AI configuration before sending a message."
msgstr "Prieš siųsdami žinutę, užbaikite arba atšaukite DI konfigūravimą."

# AI Translated
msgid "This message belongs to a different chat."
msgstr "Ši žinutė priklauso kitam pokalbiui."

# AI Translated
msgid "A message needs text or an attachment."
msgstr "Žinutėje turi būti teksto arba priedas."

# AI Translated
msgid "This file is too large to attach."
msgstr "Šis failas per didelis, kad jį būtų galima pridėti."

# AI Translated
msgid "This file type can't be read by AI."
msgstr "DI negali perskaityti šio tipo failų."

# AI Translated
msgid "This file is not readable UTF-8 text."
msgstr "Šis failas nėra perskaitomas UTF-8 tekstas."

# AI Translated
msgid "The attachment could not be stored."
msgstr "Nepavyko išsaugoti priedo."

# AI Translated
msgid "Photo or image"
msgstr "Nuotrauka arba paveikslėlis"

# AI Translated
msgid "3D model"
msgstr "3D modelis"

# AI Translated
msgid "Document (PDF)"
msgstr "Dokumentas (PDF)"

# AI Translated
msgid "This build cannot open a file dialog."
msgstr "Ši programos versija negali atverti failo pasirinkimo lango."

# AI Translated
#. TRN A calibration chat's first line. %1%: where it was started from, %2%: a printer.
#, boost-format
msgid "From %1% · %2% · filament not chosen · temporary test settings"
msgstr "Iš %1% · %2% · gija nepasirinkta · laikini bandymo nustatymai"

# AI Translated
# Needs human review: %2% is a filament and %3% a printer; check the locative 'spausdintuve' reads right with real names.
#. TRN A calibration chat's first line. %1%: where it was started from, %2%: a filament, %3%: a printer.
#, boost-format
msgid "From %1% · %2% on %3% · temporary test settings"
msgstr "Iš %1% · %2% spausdintuve %3% · laikini bandymo nustatymai"

# AI Translated
#. TRN A reopened calibration test's line. %1%: the day it was made, as "21 Oct 2026".
#, boost-format
msgid "Reopened · generated %1%"
msgstr "Atverta iš naujo · sugeneruota %1%"

# AI Translated
#. TRN %1%: where the test was opened from, %2%: the day it was made, as "21 Oct 2026".
#, boost-format
msgid "Opened from %1% · generated %2%"
msgstr "Atverta iš %1% · sugeneruota %2%"

# AI Translated
#. TRN %1% is a calibration result, such as 215 °C.
#, boost-format
msgid "result %1% saved"
msgstr "rezultatas %1% išsaugotas"

# AI Translated
#. TRN %1% is a plate's name, %2% why the slice did not succeed.
#, boost-format
msgid "The app did not slice %1%: %2%"
msgstr "Programa nesusluoksniavo %1%: %2%"

# AI Translated
#. TRN %1% is a plate's name, %2% why the slice did not succeed.
#, boost-format
msgid "The app stopped the slice of %1%: %2%"
msgstr "Programa sustabdė %1% sluoksniavimą: %2%"

# AI Translated
msgid "The slice of every plate finished."
msgstr "Visų plokščių sluoksniavimas baigtas."

# AI Translated
#. TRN %1% is a plate's name.
#, boost-format
msgid "The slice of %1% finished."
msgstr "%1% sluoksniavimas baigtas."

# AI Translated
msgid "Historical replies cannot be retried."
msgstr "Ankstesnių atsakymų pakartoti negalima."

# AI Translated
msgid "Only a failed or stopped assistant message in the active conversation can be retried."
msgstr "Pakartoti galima tik nepavykusį arba sustabdytą asistento atsakymą aktyviame pokalbyje."

# AI Translated
msgid "Only the chat's last reply can be retried."
msgstr "Pakartoti galima tik paskutinį pokalbio atsakymą."

# AI Translated
msgid "Another reply is currently streaming."
msgstr "Šiuo metu gaunamas kitas atsakymas."

# AI Translated
msgid "Historical tool actions cannot be changed."
msgstr "Ankstesnių įrankių veiksmų pakeisti negalima."

# AI Translated
msgid "This proposal is no longer open. Ask AI again."
msgstr "Šis pasiūlymas nebegalioja. Paklauskite DI dar kartą."

# AI Translated
msgid "This save can no longer be undone."
msgstr "Šio išsaugojimo nebegalima atšaukti."

# AI Translated
msgid "Finish or resolve pending work before creating a chat."
msgstr "Prieš kurdami pokalbį, užbaikite arba išspręskite laukiančius darbus."

# AI Translated
msgid "The current chat could not be saved."
msgstr "Nepavyko išsaugoti dabartinio pokalbio."

# AI Translated
msgid "The new chat could not be saved."
msgstr "Nepavyko išsaugoti naujo pokalbio."

# AI Translated
msgid "The selected chat could not be saved."
msgstr "Nepavyko išsaugoti pasirinkto pokalbio."

# AI Translated
msgid "The project or selected chat changed. Review it again."
msgstr "Projektas arba pasirinktas pokalbis pasikeitė. Peržiūrėkite dar kartą."

# AI Translated
msgid "Finish or resolve pending work before resuming a chat."
msgstr "Prieš tęsdami pokalbį, užbaikite arba išspręskite laukiančius darbus."

# AI Translated
msgid "This chat is already active."
msgstr "Šis pokalbis jau aktyvus."

# AI Translated
msgid "JusPrin can't find the project version this chat was working on."
msgstr "JusPrin neranda projekto versijos, su kuria dirbo šis pokalbis."

# AI Translated
msgid "The current project could not be saved before restoration."
msgstr "Prieš atkūrimą nepavyko išsaugoti dabartinio projekto."

# AI Translated
msgid "JusPrin couldn't put the project back."
msgstr "JusPrin nepavyko grąžinti projekto."

# AI Translated
msgid "Restored this chat's saved project setup. Check the current printer and material before printing."
msgstr "Atkurta šio pokalbio išsaugota projekto sąranka. Prieš spausdindami patikrinkite dabartinį spausdintuvą ir medžiagą."

# AI Translated
msgid "Use a non-empty, single-line title of at most 120 characters for an existing chat."
msgstr "Esamam pokalbiui naudokite netuščią, vienos eilutės pavadinimą, ne ilgesnį nei 120 simbolių."

# AI Translated
msgid "This chat is still working. Stop it or let it finish, then delete it."
msgstr "Šis pokalbis dar vykdomas. Sustabdykite jį arba palaukite, kol baigsis, tada ištrinkite."

# AI Translated
msgid "This chat no longer exists."
msgstr "Šio pokalbio nebėra."

# AI Translated
msgid "The replacement chat could not be saved."
msgstr "Nepavyko išsaugoti pakaitinio pokalbio."

# AI Translated
msgid "Historical chats cannot edit the current draft."
msgstr "Ankstesniuose pokalbiuose negalima redaguoti dabartinio juodraščio."

# AI Translated
msgid "Finish or stop the current reply before configuring AI."
msgstr "Prieš konfigūruodami DI, užbaikite arba sustabdykite dabartinį atsakymą."

# AI Translated
msgid "This build cannot configure an AI provider."
msgstr "Ši programos versija negali konfigūruoti DI teikėjo."

# AI Translated
msgid "A credential check is already running."
msgstr "Prisijungimo duomenų patikra jau vykdoma."

# AI Translated
msgid "This build cannot verify a key for that provider yet."
msgstr "Ši programos versija dar negali patikrinti šio teikėjo rakto."

# AI Translated
msgid "Finish or stop the current reply before removing a key."
msgstr "Prieš šalindami raktą, užbaikite arba sustabdykite dabartinį atsakymą."

# AI Translated
msgid "Finish or cancel the key check before removing a key."
msgstr "Prieš šalindami raktą, užbaikite arba atšaukite rakto patikrą."

# AI Translated
msgid "That key could not be removed."
msgstr "Nepavyko pašalinti šio rakto."

# AI Translated
msgid "This build cannot sign in to a JusPrin account."
msgstr "Ši programos versija negali prisijungti prie JusPrin paskyros."

# AI Translated
msgid "Finish or stop the current reply before signing in."
msgstr "Prieš prisijungdami, užbaikite arba sustabdykite dabartinį atsakymą."

# AI Translated
msgid "A sign-in or key check is already running."
msgstr "Prisijungimas arba rakto patikra jau vykdoma."

# AI Translated
msgid "There is no JusPrin account on this computer to check."
msgstr "Šiame kompiuteryje nėra JusPrin paskyros, kurią būtų galima patikrinti."

# AI Translated
msgid "JusPrin couldn't sign you in. Try again."
msgstr "JusPrin nepavyko jūsų prijungti. Bandykite dar kartą."

# AI Translated
msgid "This sign-in could not be saved, so you will have to sign in again next time JusPrin starts."
msgstr "Nepavyko išsaugoti šio prisijungimo, todėl kitą kartą paleidę JusPrin turėsite prisijungti iš naujo."

# AI Translated
msgid "This key could not be saved, so it will have to be entered again next time JusPrin starts."
msgstr "Nepavyko išsaugoti šio rakto, todėl kitą kartą paleidus JusPrin jį reikės įvesti iš naujo."

# AI Translated
msgid "The AI service is not available."
msgstr "DI paslauga nepasiekiama."

# AI Translated
msgid "The AI service could not start this request."
msgstr "DI paslauga negalėjo pradėti šios užklausos."

# AI Translated
msgid "AI could not receive the native tool result."
msgstr "DI nepavyko gauti programos įrankio rezultato."

# AI Translated
msgid "The AI request failed."
msgstr "DI užklausa nepavyko."

# AI Translated
msgid "The automatic chat title could not be generated. You can rename the chat."
msgstr "Nepavyko automatiškai sugeneruoti pokalbio pavadinimo. Pokalbį galite pervardyti."

# AI Translated
#. TRN %1% is an AI provider's account, such as JusPrin.
#, boost-format
msgid "This chat ran on your %1% account. Sign in again to continue it, or start a new chat."
msgstr "Šis pokalbis vyko jūsų %1% paskyroje. Kad jį tęstumėte, prisijunkite iš naujo arba pradėkite naują pokalbį."

# AI Translated
#. TRN %1% is an AI provider, such as OpenAI.
#, boost-format
msgid "This chat ran on %1%, and no %1% API key is set up now. Add the key in the AI settings to continue it, or start a new chat."
msgstr "Šis pokalbis vyko per %1%, o %1% API raktas dabar nenustatytas. Kad jį tęstumėte, pridėkite raktą DI nustatymuose arba pradėkite naują pokalbį."

# AI Translated
msgid "JusPrin hasn't loaded the AI models for your account yet. Try again in a moment."
msgstr "JusPrin dar neįkėlė jūsų paskyros DI modelių. Netrukus bandykite dar kartą."

# AI Translated
#. TRN %1% is an AI provider, such as OpenAI.
#, boost-format
msgid "No %1% API key is set up. Add it in the AI settings, or choose another model."
msgstr "%1% API raktas nenustatytas. Pridėkite jį DI nustatymuose arba pasirinkite kitą modelį."

# AI Translated
msgid "A connection is already being saved."
msgstr "Ryšys jau išsaugomas."

# AI Translated
msgid "JusPrin's connection helper is missing. Reinstall or rebuild JusPrin."
msgstr "Trūksta JusPrin ryšio pagalbinės programos. Iš naujo įdiekite arba sukompiliuokite JusPrin."

# AI Translated
msgid "The AppImage launcher is missing. Reopen the installed AppImage."
msgstr "Trūksta AppImage paleidiklio. Iš naujo atverkite įdiegtą AppImage."

# AI Translated
msgid "Review the change before connecting."
msgstr "Prieš prijungdami peržiūrėkite pakeitimą."

# AI Translated
#. TRN %1% is an AI client app, such as Claude Code.
#, boost-format
msgid "%1% isn't installed. Install it, or copy the command and run it later."
msgstr "Programa %1% neįdiegta. Įdiekite ją arba nukopijuokite komandą ir paleiskite ją vėliau."

# AI Translated
msgid "This build cannot run the client CLI."
msgstr "Ši programos versija negali paleisti kliento CLI."

# AI Translated
msgid "This build cannot open a file manager."
msgstr "Ši programos versija negali atverti failų tvarkyklės."

# AI Translated
msgid "The provider did not answer."
msgstr "Teikėjas neatsakė."

# AI Translated
msgid "Attach files"
msgstr "Pridėti failus"

# AI Translated
msgid "The AI panel could not connect"
msgstr "Nepavyko prijungti DI skydelio"

# AI Translated
msgid "Back to Prepare"
msgstr "Atgal į paruošimą"

# AI Translated
msgid "Open filament settings"
msgstr "Atverti gijos nustatymus"

# AI Translated
msgid "The packaged AI page is missing from this build."
msgstr "Šioje programos versijoje trūksta supakuoto DI puslapio."

# AI Translated
msgid "The system web view could not be created."
msgstr "Nepavyko sukurti sistemos žiniatinklio rodinio."

# AI Translated
msgid "The AI page failed to load."
msgstr "Nepavyko įkelti DI puslapio."

# AI Translated
# Needs human review: 'Bridge handshake' is the page-to-app connection setup; check the wording is clear in the diagnostics panel.
msgid "The AI page did not complete the bridge handshake."
msgstr "DI puslapis neužbaigė ryšio su programa suderinimo."

# AI Translated
msgid "Restart the application to load the AI page."
msgstr "Paleiskite programą iš naujo, kad būtų įkeltas DI puslapis."

# AI Translated
msgid "This is an internal connection between the application and its AI panel, not a network service."
msgstr "Tai vidinis ryšys tarp programos ir jos DI skydelio, o ne tinklo paslauga."

# AI Translated
#. TRN %1% is the web view's own error text.
#, boost-format
msgid "Last load error: %1%"
msgstr "Paskutinė įkėlimo klaida: %1%"

# AI Translated
#. TRN The messages the app and its AI panel exchanged. %1% and %2% are counts.
#, boost-format
msgid "Bridge traffic: %1% sent / %2% received"
msgstr "Ryšio srautas: išsiųsta %1% / gauta %2%"

# AI Translated
msgid "The AI service returned an unreadable streaming response."
msgstr "DI paslauga grąžino neįskaitomą srautinį atsakymą."

# AI Translated
msgid "The AI service streamed a delta for a block it never opened."
msgstr "DI paslauga atsiuntė pokytį blokui, kurio niekada neatvėrė."

# AI Translated
msgid "The AI service sent a tool call whose arguments are not JSON."
msgstr "DI paslauga atsiuntė įrankio iškvietimą, kurio argumentai nėra JSON."

# AI Translated
msgid "The AI service could not complete the response."
msgstr "DI paslauga negalėjo užbaigti atsakymo."

# AI Translated
#. TRN %1% is the AI service's own reason, in English, such as "cyber".
#, boost-format
msgid "The AI service declined to answer (%1%)."
msgstr "DI paslauga atsisakė atsakyti (%1%)."

# AI Translated
msgid "The AI service ended its response for a reason this build does not know."
msgstr "DI paslauga baigė atsakymą dėl priežasties, kurios ši programos versija nežino."

# AI Translated
msgid "This version of JusPrin can no longer connect to JusPrin accounts. Get the new version to keep using your account."
msgstr "Ši JusPrin versija nebegali prisijungti prie JusPrin paskyrų. Įdiekite naują versiją, kad galėtumėte toliau naudotis paskyra."

# AI Translated
msgid "Signing in didn't finish. Nothing was saved. Try again."
msgstr "Prisijungimas nebaigtas. Niekas neišsaugota. Bandykite dar kartą."

# AI Translated
msgid "JusPrin couldn't be reached to finish signing in. Try again."
msgstr "Nepavyko pasiekti JusPrin prisijungimui užbaigti. Bandykite dar kartą."

# AI Translated
msgid "JusPrin has no AI model for this account right now. Try again later."
msgstr "Šiuo metu JusPrin neturi DI modelio šiai paskyrai. Bandykite vėliau."

# AI Translated
msgid "Restored an earlier project version"
msgstr "Atkurta ankstesnė projekto versija"

# AI Translated
msgid "Restored this chat's saved project setup"
msgstr "Atkurta šio pokalbio išsaugota projekto sąranka"

# AI Translated
#. TRN The chat list's preview of a message that has only attachments.
msgid "Attachment"
msgstr "Priedas"

# AI Translated
msgid "The AI service stopped before finishing its response."
msgstr "DI paslauga sustojo nebaigusi atsakymo."

# AI Translated
msgid "The AI service kept pausing its response."
msgstr "DI paslauga vis pristabdydavo savo atsakymą."

# AI Translated
msgid "AI could not be asked to continue its response."
msgstr "Nepavyko paprašyti DI tęsti atsakymą."

# AI Translated
msgid "AI could not be told the results of its tool calls."
msgstr "Nepavyko perduoti DI jo įrankių iškvietimų rezultatų."

# AI Translated
msgid "AI returned an invalid tool call."
msgstr "DI grąžino netinkamą įrankio iškvietimą."

# AI Translated
msgid "The AI service ended before a complete response arrived."
msgstr "DI paslaugos ryšys baigėsi dar negavus viso atsakymo."

# AI Translated
msgid "Your JusPrin sign-in has ended. Sign in again in Preferences, then try again."
msgstr "Jūsų JusPrin prisijungimas baigėsi. Prisijunkite iš naujo skiltyje „Parinktys“, tada bandykite dar kartą."

# AI Translated
msgid "That photo could not be read."
msgstr "Šios nuotraukos nepavyko nuskaityti."

# AI Translated
#. TRN The print report form, about a photo over the server's limit of 20 MB.
msgid "That photo is larger than 20 MB. Choose a smaller photo, then send the report again."
msgstr "Ši nuotrauka didesnė nei 20 MB. Pasirinkite mažesnę nuotrauką, tada siųskite ataskaitą dar kartą."

# AI Translated
#, boost-format
msgid "This message needs %1% credit; you have %2%."
msgid_plural "This message needs %1% credits; you have %2%."
msgstr[0] "Šiai žinutei reikia %1% kredito; jūs turite %2%."
msgstr[1] "Šiai žinutei reikia %1% kreditų; jūs turite %2%."
msgstr[2] "Šiai žinutei reikia %1% kreditų; jūs turite %2%."

# AI Translated
msgid "You're out of credits."
msgstr "Jūsų kreditai baigėsi."

# AI Translated
#. TRN %1% is an AI provider, such as OpenAI.
#, boost-format
msgid "The %1% API key was rejected. Update the AI configuration and try again."
msgstr "%1% API raktas atmestas. Atnaujinkite DI konfigūraciją ir bandykite dar kartą."

# AI Translated
#. TRN %1% is an AI provider, such as OpenAI.
#, boost-format
msgid "The request was too large for the %1% service."
msgstr "Užklausa per didelė %1% paslaugai."

# AI Translated
#. TRN %1% is an AI provider, such as OpenAI.
#, boost-format
msgid "The %1% service is rate limited. Try again shortly."
msgstr "Viršytas %1% paslaugos užklausų limitas. Netrukus bandykite dar kartą."

# AI Translated
#. TRN %1% is an AI provider, such as OpenAI.
#, boost-format
msgid "The %1% service is overloaded. Try again shortly."
msgstr "%1% paslauga perkrauta. Netrukus bandykite dar kartą."

# AI Translated
#. TRN %1% is an AI provider, such as OpenAI.
#, boost-format
msgid "The %1% service is temporarily unavailable."
msgstr "%1% paslauga laikinai nepasiekiama."

# AI Translated
msgid "The AI request timed out."
msgstr "Baigėsi DI užklausos laukimo laikas."

# AI Translated
#. TRN %1% is an AI provider, such as OpenAI.
#, boost-format
msgid "The AI request could not reach the %1% service."
msgstr "DI užklausa nepasiekė %1% paslaugos."

# AI Translated
msgid "The AI service response did not contain valid output."
msgstr "DI paslaugos atsakyme nebuvo tinkamo turinio."

# AI Translated
#. TRN A button that asks the AI to choose another block of a calibration test.
msgid "Pick another block"
msgstr "Pasirinkti kitą bloką"

# AI Translated
#. TRN A button that asks the AI to choose another tile of a calibration test.
msgid "Pick another tile"
msgstr "Pasirinkti kitą plytelę"

# AI Translated
#. TRN A button that asks the AI to choose another line of a calibration test.
msgid "Pick another line"
msgstr "Pasirinkti kitą liniją"

# AI Translated
#. TRN A button that asks the AI to choose another corner of a calibration test.
msgid "Pick another corner"
msgstr "Pasirinkti kitą kampą"

# AI Translated
#. TRN A button that asks the AI to choose another height of a calibration tower.
msgid "Pick another height"
msgstr "Pasirinkti kitą aukštį"

# AI Translated
#. TRN %1% is a preset's name.
#, boost-format
msgid "Preset · %1%"
msgstr "Profilis · %1%"

# AI Translated
#. TRN %1% is a preset's name.
#, boost-format
msgid "New preset · %1%"
msgstr "Naujas profilis · %1%"

# AI Translated
#. TRN %1% is the preset the new one is made from.
#, boost-format
msgid "%1% itself is unchanged"
msgstr "Pats %1% lieka nepakeistas"

# AI Translated
#. TRN %1% is a setting's new value, such as 215 °C.
#, boost-format
msgid "Save %1% as a new filament preset"
msgstr "Išsaugoti %1% kaip naują gijos profilį"

# AI Translated
#. TRN %1% is a setting's new value, such as 215 °C.
#, boost-format
msgid "Save %1% as a new printer preset"
msgstr "Išsaugoti %1% kaip naują spausdintuvo profilį"

# AI Translated
#. TRN %1% is a setting's new value, such as 215 °C.
#, boost-format
msgid "Save %1% as a new process preset"
msgstr "Išsaugoti %1% kaip naują proceso profilį"

# AI Translated
#. TRN %1% is a setting's new value, such as 215 °C, %2% a preset's name.
#, boost-format
msgid "Save %1% to %2%"
msgstr "Išsaugoti %1% į %2%"

# AI Translated
msgid "This proposal is already saved."
msgstr "Šis pasiūlymas jau išsaugotas."

# AI Translated
msgid "Drop a model here or add one"
msgstr "Numeskite modelį čia arba pridėkite jį"

# AI Translated
msgid "World coordinates"
msgstr "Pasaulio koordinatės"

# AI Translated
msgid "Object coordinates"
msgstr "Objekto koordinatės"

# AI Translated
msgid "Translate(Relative)"
msgstr "Slinkti (santykinai)"

# AI Translated
msgid "Rotate (absolute)"
msgstr "Pasukti (absoliučiai)"

# AI Translated
msgid "Part coordinates"
msgstr "Dalies koordinatės"

# AI Translated
msgid "The packaged Home page is missing from this build."
msgstr "Šioje programos versijoje trūksta supakuoto pradžios puslapio."

# AI Translated
msgid "The Home page failed to load."
msgstr "Nepavyko įkelti pradžios puslapio."

# AI Translated
msgid "This window stopped updating because the app switched to another printer."
msgstr "Šis langas nebeatnaujinamas, nes programa persijungė į kitą spausdintuvą."

# AI Translated
#. TRN A length in millimetres, such as a nozzle diameter on a printer card: "0.4 mm". %s is the number.
#, c-format, boost-format
