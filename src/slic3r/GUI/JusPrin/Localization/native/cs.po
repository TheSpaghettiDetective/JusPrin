# AI Translated
msgid "Something went wrong on our side"
msgstr "Na naší straně se něco pokazilo"

# AI Translated
# Needs human review: Unclear what "until restoration is recovered" means; check the wording in the source.
msgid "Project chat is blocked until restoration is recovered."
msgstr "Chat projektu je zablokovaný, dokud se nepodaří dokončit obnovení."

# AI Translated
msgid "Return to the active chat or restore this chat before sending."
msgstr "Před odesláním se vraťte do aktivního chatu nebo tento chat obnovte."

# AI Translated
msgid "Finish or cancel AI configuration before sending a message."
msgstr "Před odesláním zprávy dokončete nebo zrušte nastavení AI."

# AI Translated
msgid "This message belongs to a different chat."
msgstr "Tato zpráva patří do jiného chatu."

# AI Translated
msgid "A message needs text or an attachment."
msgstr "Zpráva musí obsahovat text nebo přílohu."

# AI Translated
msgid "This file is too large to attach."
msgstr "Tento soubor je příliš velký na přiložení."

# AI Translated
msgid "This file type can't be read by AI."
msgstr "Tento typ souboru AI neumí přečíst."

# AI Translated
msgid "This file is not readable UTF-8 text."
msgstr "Tento soubor není čitelný text v kódování UTF-8."

# AI Translated
msgid "Photo or image"
msgstr "Fotografie nebo obrázek"

# AI Translated
msgid "3D model"
msgstr "3D model"

# AI Translated
msgid "Document (PDF)"
msgstr "Dokument (PDF)"

# AI Translated
msgid "This build cannot open a file dialog."
msgstr "Tato verze nemůže otevřít dialog pro výběr souboru."

# AI Translated
# Needs human review: %1% is where the test was started from; check that "Zdroj: …" reads naturally with the real value.
#. TRN A calibration chat's first line. %1%: where it was started from, %2%: a printer.
#, boost-format
msgid "From %1% · %2% · filament not chosen · temporary test settings"
msgstr "Zdroj: %1% · %2% · filament nevybrán · dočasné nastavení testu"

# AI Translated
# Needs human review: %1% is where the test was started from; check that "Zdroj: …" reads naturally with the real value.
#. TRN A calibration chat's first line. %1%: where it was started from, %2%: a filament, %3%: a printer.
#, boost-format
msgid "From %1% · %2% on %3% · temporary test settings"
msgstr "Zdroj: %1% · %2% na tiskárně %3% · dočasné nastavení testu"

# AI Translated
#. TRN A reopened calibration test's line. %1%: the day it was made, as "21 Oct 2026".
#, boost-format
msgid "Reopened · generated %1%"
msgstr "Znovu otevřeno · vytvořeno %1%"

# AI Translated
#. TRN %1%: where the test was opened from, %2%: the day it was made, as "21 Oct 2026".
#, boost-format
msgid "Opened from %1% · generated %2%"
msgstr "Otevřeno z: %1% · vytvořeno %2%"

# AI Translated
#. TRN %1% is a calibration result, such as 215 °C.
#, boost-format
msgid "result %1% saved"
msgstr "výsledek %1% uložen"

# AI Translated
#. TRN %1% is a plate's name, %2% why the slice did not succeed.
#, boost-format
msgid "The app did not slice %1%: %2%"
msgstr "Aplikace neslicovala %1%: %2%"

# AI Translated
#. TRN %1% is a plate's name, %2% why the slice did not succeed.
#, boost-format
msgid "The app stopped the slice of %1%: %2%"
msgstr "Aplikace zastavila slicování %1%: %2%"

# AI Translated
msgid "The slice of every plate finished."
msgstr "Slicování všech desek bylo dokončeno."

# AI Translated
#. TRN %1% is a plate's name.
#, boost-format
msgid "The slice of %1% finished."
msgstr "Slicování %1% bylo dokončeno."

# AI Translated
msgid "Historical replies cannot be retried."
msgstr "Starší odpovědi nelze zopakovat."

# AI Translated
msgid "Only a failed or stopped assistant message in the active conversation can be retried."
msgstr "Zopakovat lze jen neúspěšnou nebo zastavenou zprávu asistenta v aktivní konverzaci."

# AI Translated
msgid "Only the chat's last reply can be retried."
msgstr "Zopakovat lze jen poslední odpověď v chatu."

# AI Translated
msgid "Another reply is currently streaming."
msgstr "Právě se přenáší jiná odpověď."

# AI Translated
msgid "Historical tool actions cannot be changed."
msgstr "Starší akce nástrojů nelze změnit."

# AI Translated
msgid "This proposal is no longer open. Ask AI again."
msgstr "Tento návrh už není otevřený. Zeptejte se AI znovu."

# AI Translated
msgid "This save can no longer be undone."
msgstr "Toto uložení už nelze vrátit zpět."

# AI Translated
msgid "Finish or resolve pending work before creating a chat."
msgstr "Před vytvořením chatu dokončete nebo vyřešte rozpracovanou činnost."

# AI Translated
msgid "The project or selected chat changed. Review it again."
msgstr "Projekt nebo vybraný chat se změnil. Zkontrolujte ho znovu."

# AI Translated
msgid "Finish or resolve pending work before resuming a chat."
msgstr "Před obnovením chatu dokončete nebo vyřešte rozpracovanou činnost."

# AI Translated
msgid "This chat is already active."
msgstr "Tento chat je již aktivní."

# AI Translated
msgid "JusPrin can't find the project version this chat was working on."
msgstr "JusPrin nemůže najít verzi projektu, se kterou tento chat pracoval."

# AI Translated
msgid "Restored this chat's saved project setup. Check the current printer and material before printing."
msgstr "Bylo obnoveno uložené nastavení projektu z tohoto chatu. Před tiskem zkontrolujte aktuální tiskárnu a materiál."

# AI Translated
msgid "Use a non-empty, single-line title of at most 120 characters for an existing chat."
msgstr "U existujícího chatu použijte neprázdný jednořádkový název o délce nejvýše 120 znaků."

# AI Translated
msgid "This chat is still working. Stop it or let it finish, then delete it."
msgstr "Tento chat stále pracuje. Zastavte ho nebo ho nechte dokončit a pak ho smažte."

# AI Translated
msgid "This chat no longer exists."
msgstr "Tento chat již neexistuje."

# AI Translated
msgid "Historical chats cannot edit the current draft."
msgstr "Starší chaty nemohou upravovat aktuální koncept."

# AI Translated
msgid "Finish or stop the current reply before configuring AI."
msgstr "Před nastavením AI dokončete nebo zastavte aktuální odpověď."

# AI Translated
msgid "This build cannot configure an AI provider."
msgstr "Tato verze nemůže nastavit poskytovatele AI."

# AI Translated
msgid "A credential check is already running."
msgstr "Kontrola přihlašovacích údajů již probíhá."

# AI Translated
msgid "This build cannot verify a key for that provider yet."
msgstr "Tato verze zatím neumí ověřit klíč pro tohoto poskytovatele."

# AI Translated
msgid "Finish or stop the current reply before removing a key."
msgstr "Před odebráním klíče dokončete nebo zastavte aktuální odpověď."

# AI Translated
msgid "Finish or cancel the key check before removing a key."
msgstr "Před odebráním klíče dokončete nebo zrušte jeho kontrolu."

# AI Translated
msgid "That key could not be removed."
msgstr "Tento klíč se nepodařilo odebrat."

# AI Translated
msgid "This build cannot sign in to a JusPrin account."
msgstr "Tato verze se nemůže přihlásit k účtu JusPrin."

# AI Translated
msgid "Finish or stop the current reply before signing in."
msgstr "Před přihlášením dokončete nebo zastavte aktuální odpověď."

# AI Translated
msgid "A sign-in or key check is already running."
msgstr "Přihlašování nebo kontrola klíče již probíhá."

# AI Translated
msgid "There is no JusPrin account on this computer to check."
msgstr "V tomto počítači není žádný účet JusPrin ke kontrole."

# AI Translated
msgid "JusPrin couldn't sign you in. Try again."
msgstr "JusPrin vás nemohl přihlásit. Zkuste to znovu."

# AI Translated
msgid "The AI service is not available."
msgstr "Služba AI není dostupná."

# AI Translated
msgid "The AI service could not start this request."
msgstr "Služba AI nemohla tento požadavek zahájit."

# AI Translated
msgid "AI could not receive the native tool result."
msgstr "AI nemohla přijmout výsledek nativního nástroje."

# AI Translated
msgid "The AI request failed."
msgstr "Požadavek na AI selhal."

# AI Translated
msgid "The automatic chat title could not be generated. You can rename the chat."
msgstr "Automatický název chatu se nepodařilo vytvořit. Chat můžete přejmenovat."

# AI Translated
#. TRN %1% is an AI provider's account, such as JusPrin.
#, boost-format
msgid "This chat ran on your %1% account. Sign in again to continue it, or start a new chat."
msgstr "Tento chat běžel na vašem účtu %1%. Chcete-li v něm pokračovat, znovu se přihlaste, nebo začněte nový chat."

# AI Translated
#. TRN %1% is an AI provider, such as OpenAI.
#, boost-format
msgid "This chat ran on %1%, and no %1% API key is set up now. Add the key in the AI settings to continue it, or start a new chat."
msgstr "Tento chat běžel na %1% a teď není nastavený žádný klíč API pro %1%. Chcete-li v chatu pokračovat, přidejte klíč v nastavení AI, nebo začněte nový chat."

# AI Translated
msgid "JusPrin hasn't loaded the AI models for your account yet. Try again in a moment."
msgstr "JusPrin ještě nenačetl modely AI pro váš účet. Zkuste to za chvíli znovu."

# AI Translated
#. TRN %1% is an AI provider, such as OpenAI.
#, boost-format
msgid "No %1% API key is set up. Add it in the AI settings, or choose another model."
msgstr "Není nastavený žádný klíč API pro %1%. Přidejte ho v nastavení AI, nebo zvolte jiný model."

# AI Translated
msgid "A connection is already being saved."
msgstr "Připojení se již ukládá."

# AI Translated
msgid "JusPrin's connection helper is missing. Reinstall or rebuild JusPrin."
msgstr "Chybí pomocník připojení JusPrinu. Přeinstalujte nebo znovu sestavte JusPrin."

# AI Translated
msgid "The AppImage launcher is missing. Reopen the installed AppImage."
msgstr "Chybí spouštěč AppImage. Znovu otevřete nainstalovaný AppImage."

# AI Translated
msgid "Review the change before connecting."
msgstr "Před připojením zkontrolujte změnu."

# AI Translated
#. TRN %1% is an AI client app, such as Claude Code.
#, boost-format
msgid "%1% isn't installed. Install it, or copy the command and run it later."
msgstr "%1% není nainstalován. Nainstalujte ho, nebo zkopírujte příkaz a spusťte ho později."

# AI Translated
msgid "This build cannot run the client CLI."
msgstr "Tato verze nemůže spustit klientské CLI."

# AI Translated
msgid "This build cannot open a file manager."
msgstr "Tato verze nemůže otevřít správce souborů."

# AI Translated
msgid "The provider did not answer."
msgstr "Poskytovatel neodpověděl."

# AI Translated
msgid "Attach files"
msgstr "Přiložit soubory"

# AI Translated
msgid "The AI panel could not connect"
msgstr "Panel AI se nemohl připojit"

# AI Translated
msgid "Back to Prepare"
msgstr "Zpět na Přípravu"

# AI Translated
msgid "Open filament settings"
msgstr "Otevřít nastavení filamentu"

# AI Translated
msgid "The packaged AI page is missing from this build."
msgstr "V této verzi chybí zabalená stránka AI."

# AI Translated
msgid "The system web view could not be created."
msgstr "Systémové webové zobrazení se nepodařilo vytvořit."

# AI Translated
msgid "The AI page failed to load."
msgstr "Stránku AI se nepodařilo načíst."

# AI Translated
msgid "The AI page did not complete the bridge handshake."
msgstr "Stránka AI nedokončila navázání spojení s aplikací."

# AI Translated
msgid "Restart the application to load the AI page."
msgstr "Restartujte aplikaci, aby se načetla stránka AI."

# AI Translated
msgid "This is an internal connection between the application and its AI panel, not a network service."
msgstr "Jde o interní spojení mezi aplikací a jejím panelem AI, nikoli o síťovou službu."

# AI Translated
#. TRN %1% is the web view's own error text.
#, boost-format
msgid "Last load error: %1%"
msgstr "Poslední chyba načítání: %1%"

# AI Translated
#. TRN The messages the app and its AI panel exchanged. %1% and %2% are counts.
#, boost-format
msgid "Bridge traffic: %1% sent / %2% received"
msgstr "Komunikace přes most: odesláno %1% / přijato %2%"

# AI Translated
#. TRN %1% is the AI service's own reason, in English, such as "cyber".
#, boost-format
msgid "The AI service declined to answer (%1%)."
msgstr "Služba AI odmítla odpovědět (%1%)."

# AI Translated
msgid "This version of JusPrin can no longer connect to JusPrin accounts. Get the new version to keep using your account."
msgstr "Tato verze JusPrinu se už nemůže připojit k účtům JusPrin. Chcete-li účet dál používat, stáhněte si novou verzi."

# AI Translated
msgid "Your JusPrin sign-in has ended. Sign in again in Preferences, then try again."
msgstr "Vaše přihlášení k JusPrinu skončilo. Znovu se přihlaste v Předvolbách a zkuste to znovu."

# AI Translated
msgid "Signing in didn't finish. Nothing was saved. Try again."
msgstr "Přihlášení nebylo dokončeno. Nic se neuložilo. Zkuste to znovu."

# AI Translated
msgid "JusPrin couldn't be reached to finish signing in. Try again."
msgstr "K JusPrinu se nepodařilo připojit a dokončit přihlášení. Zkuste to znovu."

# AI Translated
msgid "JusPrin has no AI model for this account right now. Try again later."
msgstr "JusPrin teď pro tento účet nemá žádný model AI. Zkuste to později."

# AI Translated
msgid "Restored an earlier project version"
msgstr "Obnovena dřívější verze projektu"

# AI Translated
msgid "Restored this chat's saved project setup"
msgstr "Obnoveno uložené nastavení projektu z tohoto chatu"

# AI Translated
#. TRN The chat list's preview of a message that has only attachments.
msgid "Attachment"
msgstr "Příloha"

# AI Translated
#. TRN %1% is an AI provider, such as OpenAI.
#, boost-format
msgid "The %1% service is rate limited. Try again shortly."
msgstr "Služba %1% omezuje počet požadavků. Zkuste to za chvíli znovu."

# AI Translated
#. TRN %1% is an AI provider, such as OpenAI.
#, boost-format
msgid "The request was too large for the %1% service."
msgstr "Požadavek byl pro službu %1% příliš velký."

# AI Translated
#. TRN %1% is an AI provider, such as OpenAI.
#, boost-format
msgid "The AI request could not reach the %1% service."
msgstr "Požadavek na AI se nedostal ke službě %1%."

# AI Translated
#, boost-format
msgid "This message needs %1% credit; you have %2%."
msgid_plural "This message needs %1% credits; you have %2%."
msgstr[0] "Tato zpráva potřebuje %1% kredit; máte %2%."
msgstr[1] "Tato zpráva potřebuje %1% kredity; máte %2%."
msgstr[2] "Tato zpráva potřebuje %1% kreditů; máte %2%."

# AI Translated
#. TRN %1% is an AI provider, such as OpenAI.
#, boost-format
msgid "The %1% API key was rejected. Update the AI configuration and try again."
msgstr "Klíč API pro %1% byl odmítnut. Aktualizujte nastavení AI a zkuste to znovu."

# AI Translated
#. TRN A button that asks the AI to choose another block of a calibration test.
msgid "Pick another block"
msgstr "Vybrat jiný blok"

# AI Translated
#. TRN A button that asks the AI to choose another tile of a calibration test.
msgid "Pick another tile"
msgstr "Vybrat jinou dlaždici"

# AI Translated
#. TRN A button that asks the AI to choose another line of a calibration test.
msgid "Pick another line"
msgstr "Vybrat jinou čáru"

# AI Translated
#. TRN A button that asks the AI to choose another corner of a calibration test.
msgid "Pick another corner"
msgstr "Vybrat jiný roh"

# AI Translated
#. TRN A button that asks the AI to choose another height of a calibration tower.
msgid "Pick another height"
msgstr "Vybrat jinou výšku"

# AI Translated
#. TRN %1% is a preset's name.
#, boost-format
msgid "Preset · %1%"
msgstr "Předvolba · %1%"

# AI Translated
#. TRN %1% is a preset's name.
#, boost-format
msgid "New preset · %1%"
msgstr "Nová předvolba · %1%"

# AI Translated
#. TRN %1% is the preset the new one is made from.
#, boost-format
msgid "%1% itself is unchanged"
msgstr "%1% zůstává beze změny"

# AI Translated
#. TRN %1% is a setting's new value, such as 215 °C.
#, boost-format
msgid "Save %1% as a new filament preset"
msgstr "Uložit %1% jako novou předvolbu filamentu"

# AI Translated
#. TRN %1% is a setting's new value, such as 215 °C.
#, boost-format
msgid "Save %1% as a new printer preset"
msgstr "Uložit %1% jako novou předvolbu tiskárny"

# AI Translated
#. TRN %1% is a setting's new value, such as 215 °C.
#, boost-format
msgid "Save %1% as a new process preset"
msgstr "Uložit %1% jako novou předvolbu procesu"

# AI Translated
#. TRN %1% is a setting's new value, such as 215 °C, %2% a preset's name.
#, boost-format
msgid "Save %1% to %2%"
msgstr "Uložit %1% do %2%"

# AI Translated
msgid "This proposal is already saved."
msgstr "Tento návrh je již uložen."

# AI Translated
msgid "Drop a model here or add one"
msgstr "Přetáhněte sem model nebo nějaký přidejte"

# AI Translated
msgid "World coordinates"
msgstr "Globální souřadnice"

# AI Translated
msgid "Object coordinates"
msgstr "Souřadnice objektu"

# AI Translated
msgid "Translate(Relative)"
msgstr "Posunout (relativně)"

# AI Translated
msgid "Rotate (absolute)"
msgstr "Otočit (absolutně)"

# AI Translated
msgid "Part coordinates"
msgstr "Souřadnice dílu"

# AI Translated
msgid "The packaged Home page is missing from this build."
msgstr "V této verzi chybí zabalená stránka Domů."

# AI Translated
msgid "The Home page failed to load."
msgstr "Stránku Domů se nepodařilo načíst."

# AI Translated
msgid "This window stopped updating because the app switched to another printer."
msgstr "Toto okno se přestalo aktualizovat, protože aplikace přepnula na jinou tiskárnu."

# AI Translated
#. TRN A length in millimetres, such as a nozzle diameter on a printer card: "0.4 mm". %s is the number.
#, c-format, boost-format
msgid "%s mm"
msgstr "%s mm"

# AI Translated
#, c-format, boost-format
msgid "The printer reports error %s."
msgstr "Tiskárna hlásí chybu %s."

# AI Translated
msgid "LAN"
msgstr "LAN"

# AI Translated
msgid "Cloud"
msgstr "Cloud"

# AI Translated
msgid "The printer stopped sending updates."
msgstr "Tiskárna přestala posílat aktualizace."

# AI Translated
#, c-format, boost-format
msgid "%s isn't answering."
msgstr "%s neodpovídá."

# AI Translated
msgid "Klipper isn't running."
msgstr "Klipper neběží."

# AI Translated
#. TRN %1% is Klipper's own message, in English, saying why it stopped.
#, boost-format
msgid "Klipper stopped: %1%"
msgstr "Klipper se zastavil: %1%"

# AI Translated
msgid "This printer no longer exists."
msgstr "Tato tiskárna již neexistuje."

# AI Translated
# Needs human review: Short date on a project card: day then abbreviated month, as in "20. říj"; check it reads right with the month names the app supplies.
#. TRN A date in this year on a project card: %1% is the abbreviated month name, %2% the day of the month, as in "Oct 20".
#, boost-format
msgctxt "short date"
msgid "%1% %2%"
msgstr "%2%. %1%"

# AI Translated
# Needs human review: Date with year, as in "20. říj 2026"; check it reads right on the project card.
#. TRN A date outside this year on a project card: %1% is the date without the year, as in "Oct 20", %2% the year.
#, boost-format
msgctxt "date with year"
msgid "%1%, %2%"
msgstr "%1% %2%"

# AI Translated
msgid "G-code exported"
msgstr "G-code exportován"

# AI Translated
#. TRN A project's status: %1% is a date, as in "Nov 3".
#, boost-format
msgid "G-code exported %1%"
msgstr "G-code exportován %1%"

# AI Translated
#. TRN A project's status: %1% is a printer model, as in "Ender-3 V3 KE".
#, boost-format
msgid "G-code exported for %1%"
msgstr "G-code exportován pro %1%"

# AI Translated
#. TRN A project's status: %1% is a date, as in "Nov 3", %2% a printer model, as in "Ender-3 V3 KE".
#, boost-format
msgid "G-code exported %1% for %2%"
msgstr "G-code exportován %1% pro %2%"

# AI Translated
msgctxt "project status"
msgid "Printed"
msgstr "Vytištěno"

# AI Translated
#. TRN A project's status: %1% is a date, as in "Oct 20".
#, boost-format
msgid "Printed %1%"
msgstr "Vytištěno %1%"

# AI Translated
msgctxt "project status"
msgid "Sent"
msgstr "Odesláno"

# AI Translated
#. TRN A project's status: %1% is a date, as in "Oct 20".
#, boost-format
msgid "Sent %1%"
msgstr "Odesláno %1%"

# AI Translated
#. TRN A project's status: it has not been sliced to G-code yet.
msgctxt "project status"
msgid "Draft"
msgstr "Koncept"

# AI Translated
msgid "That sign-in expired. Try again."
msgstr "Platnost přihlášení vypršela. Zkuste to znovu."

# AI Translated
#, c-format, boost-format
msgid "JusPrin found no %s printers to bring. Choose your printer instead."
msgstr "JusPrin nenašel žádné tiskárny z %s k přenesení. Zvolte místo toho svou tiskárnu."

# AI Translated
msgid "Generic printer"
msgstr "Obecná tiskárna"

# AI Translated
msgid "Your projects couldn't be loaded. JusPrin will keep trying."
msgstr "Vaše projekty se nepodařilo načíst. JusPrin to bude dál zkoušet."

# AI Translated
msgid "Untitled project"
msgstr "Projekt bez názvu"

# AI Translated
#, c-format, boost-format
msgid "Printing on %s"
msgstr "Tiskne se na %s"

# AI Translated
msgid "JusPrin no longer keeps this G-code. Slice the project again to export it."
msgstr "JusPrin už tento G-code neuchovává. Chcete-li ho exportovat, slicujte projekt znovu."

# AI Translated
msgid "Couldn't export G-code"
msgstr "G-code se nepodařilo exportovat"

# AI Translated
msgid "Choose a photo of the printed object"
msgstr "Vyberte fotografii vytištěného objektu"

# AI Translated
msgid "Photos"
