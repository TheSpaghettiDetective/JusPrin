msgstr "Vissza az Előkészítéshez"

# AI Translated
msgid "Open filament settings"
msgstr "Filament beállítások megnyitása"

# AI Translated
msgid "The packaged AI page is missing from this build."
msgstr "Ebből a verzióból hiányzik a beépített AI-oldal."

# AI Translated
msgid "The system web view could not be created."
msgstr "A rendszer webnézetét nem sikerült létrehozni."

# AI Translated
msgid "The AI page failed to load."
msgstr "Az AI-oldalt nem sikerült betölteni."

# AI Translated
msgid "The AI page did not complete the bridge handshake."
msgstr "Az AI-oldal nem fejezte be a kapcsolódási kézfogást."

# AI Translated
msgid "Restart the application to load the AI page."
msgstr "Az AI-oldal betöltéséhez indítsd újra az alkalmazást."

# AI Translated
msgid "This is an internal connection between the application and its AI panel, not a network service."
msgstr "Ez az alkalmazás és az AI-panele közötti belső kapcsolat, nem hálózati szolgáltatás."

# AI Translated
#. TRN %1% is the web view's own error text.
#, boost-format
msgid "Last load error: %1%"
msgstr "Utolsó betöltési hiba: %1%"

# AI Translated
#. TRN The messages the app and its AI panel exchanged. %1% and %2% are counts.
#, boost-format
msgid "Bridge traffic: %1% sent / %2% received"
msgstr "Hídforgalom: %1% elküldve / %2% fogadva"

# AI Translated
#. TRN %1% is the AI service's own reason, in English, such as "cyber".
#, boost-format
msgid "The AI service declined to answer (%1%)."
msgstr "Az AI-szolgáltatás megtagadta a választ (%1%)."

# AI Translated
msgid "This version of JusPrin can no longer connect to JusPrin accounts. Get the new version to keep using your account."
msgstr "A JusPrin ezen verziója már nem tud csatlakozni a JusPrin-fiókokhoz. A fiókod további használatához töltsd le az új verziót."

# AI Translated
msgid "Your JusPrin sign-in has ended. Sign in again in Preferences, then try again."
msgstr "A JusPrin-bejelentkezésed lejárt. Jelentkezz be újra a Beállításokban, majd próbáld újra."

# AI Translated
msgid "Signing in didn't finish. Nothing was saved. Try again."
msgstr "A bejelentkezés nem fejeződött be. Semmi sem lett mentve. Próbáld újra."

# AI Translated
msgid "JusPrin couldn't be reached to finish signing in. Try again."
msgstr "A bejelentkezés befejezéséhez nem sikerült elérni a JusPrint. Próbáld újra."

# AI Translated
msgid "JusPrin has no AI model for this account right now. Try again later."
msgstr "A JusPrinnek jelenleg nincs AI-modellje ehhez a fiókhoz. Próbáld újra később."

