# AI Translated
msgid "Restored this chat's saved project setup. Check the current printer and material before printing."
msgstr "A csevegés mentett projektbeállításai visszaállítva. Nyomtatás előtt ellenőrizd a nyomtatót és az anyagot."

# AI Translated
msgid "A credential check is already running."
msgstr "Már folyamatban van egy hitelesítőadat-ellenőrzés."

# AI Translated
msgid "This build cannot verify a key for that provider yet."
msgstr "Ez a verzió még nem tudja ellenőrizni az ehhez a szolgáltatóhoz tartozó kulcsot."

# AI Translated
msgid "A sign-in or key check is already running."
msgstr "Már folyamatban van egy bejelentkezés vagy kulcsellenőrzés."

# AI Translated
msgid "JusPrin couldn't sign you in. Try again."
msgstr "A JusPrin nem tudott bejelentkeztetni. Próbáld újra."

# AI Translated
msgid "The AI service is not available."
msgstr "Az AI-szolgáltatás nem érhető el."

# AI Translated
msgid "The AI service could not start this request."
msgstr "Az AI-szolgáltatás nem tudta elindítani ezt a kérést."

# AI Translated
msgid "AI could not receive the native tool result."
msgstr "Az AI nem kapta meg a natív eszköz eredményét."

# AI Translated
msgid "The AI request failed."
msgstr "Az AI-kérés sikertelen volt."

# AI Translated
#. TRN %1% is an AI provider's account, such as JusPrin.
#, boost-format
msgid "This chat ran on your %1% account. Sign in again to continue it, or start a new chat."
msgstr "Ez a csevegés a(z) %1%-fiókodon futott. A folytatáshoz jelentkezz be újra, vagy kezdj új csevegést."

# AI Translated
#. TRN %1% is an AI provider, such as OpenAI.
#, boost-format
msgid "This chat ran on %1%, and no %1% API key is set up now. Add the key in the AI settings to continue it, or start a new chat."
msgstr "Ez a csevegés a(z) %1% szolgáltatón futott, és most nincs beállítva %1% API-kulcs. A folytatáshoz add meg a kulcsot az AI-beállításokban, vagy kezdj új csevegést."

# AI Translated
msgid "JusPrin hasn't loaded the AI models for your account yet. Try again in a moment."
msgstr "A JusPrin még nem töltötte be a fiókodhoz tartozó AI-modelleket. Próbáld újra egy pillanat múlva."

# AI Translated
#. TRN %1% is an AI provider, such as OpenAI.
#, boost-format
msgid "No %1% API key is set up. Add it in the AI settings, or choose another model."
msgstr "Nincs beállítva %1% API-kulcs. Add meg az AI-beállításokban, vagy válassz másik modellt."

# AI Translated
msgid "A connection is already being saved."
msgstr "Egy kapcsolat mentése már folyamatban van."

# AI Translated
msgid "JusPrin's connection helper is missing. Reinstall or rebuild JusPrin."
msgstr "Hiányzik a JusPrin kapcsolódási segédprogramja. Telepítsd vagy fordítsd újra a JusPrint."

# AI Translated
msgid "The AppImage launcher is missing. Reopen the installed AppImage."
msgstr "Hiányzik az AppImage indítója. Nyisd meg újra a telepített AppImage-et."

# AI Translated
msgid "Review the change before connecting."
msgstr "Csatlakozás előtt nézd át a módosítást."

# AI Translated
#. TRN %1% is an AI client app, such as Claude Code.
#, boost-format
msgid "%1% isn't installed. Install it, or copy the command and run it later."
msgstr "A(z) %1% nincs telepítve. Telepítsd, vagy másold ki a parancsot, és futtasd később."

# AI Translated
msgid "This build cannot run the client CLI."
msgstr "Ez a verzió nem tudja futtatni a kliens parancssori eszközét."

# AI Translated
msgid "The provider did not answer."
msgstr "A szolgáltató nem válaszolt."

# AI Translated
