# AI Translated
msgid "Something went wrong on our side"
msgstr "Valami hiba történt nálunk"

# AI Translated
#. TRN Said in the chat when a project opens whose chats a newer version of JusPrin saved; they are kept, not shown.
msgid "This project's chats were saved by a newer version of JusPrin. Get the new version to see them."
msgstr "A projekt csevegéseit a JusPrin egy újabb verziója mentette. A megtekintésükhöz töltsd le az új verziót."

# AI Translated
# Needs human review: "until restoration is recovered": check what the person must do before the chat unlocks
msgid "Project chat is blocked until restoration is recovered."
msgstr "A projekt csevegése zárolva van, amíg a visszaállítás helyre nem áll."

# AI Translated
msgid "Return to the active chat or restore this chat before sending."
msgstr "Küldés előtt térj vissza az aktív csevegéshez, vagy állítsd vissza ezt a csevegést."

# AI Translated
msgid "Finish or cancel AI configuration before sending a message."
msgstr "Üzenet küldése előtt fejezd be vagy szakítsd meg az AI beállítását."

# AI Translated
msgid "This file is too large to attach."
msgstr "Ez a fájl túl nagy ahhoz, hogy csatolni lehessen."

# AI Translated
msgid "This file type can't be read by AI."
msgstr "Ezt a fájltípust az AI nem tudja beolvasni."

# AI Translated
msgid "This file is not readable UTF-8 text."
msgstr "Ez a fájl nem olvasható UTF-8 szöveg."

# AI Translated
