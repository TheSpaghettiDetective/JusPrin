# AI Translated
# Needs human review: "restoration is recovered" is unclear in the English; check what state this describes.
msgid "Project chat is blocked until restoration is recovered."
msgstr "El chat del proyecto está bloqueado hasta que se recupere la restauración."

# AI Translated
msgid "Return to the active chat or restore this chat before sending."
msgstr "Vuelva al chat activo o restaure este chat antes de enviar."

# AI Translated
msgid "Finish or cancel AI configuration before sending a message."
msgstr "Termine o cancele la configuración de la IA antes de enviar un mensaje."

# AI Translated
msgid "This message belongs to a different chat."
msgstr "Este mensaje pertenece a otro chat."

# AI Translated
msgid "A message needs text or an attachment."
msgstr "Un mensaje necesita texto o un archivo adjunto."

# AI Translated
msgid "This file is too large to attach."
msgstr "Este archivo es demasiado grande para adjuntarlo."

# AI Translated
msgid "This file type can't be read by AI."
msgstr "La IA no puede leer este tipo de archivo."

# AI Translated
msgid "This file is not readable UTF-8 text."
msgstr "Este archivo no es texto UTF-8 legible."

# AI Translated
msgid "The attachment could not be stored."
msgstr "No se ha podido guardar el archivo adjunto."

# AI Translated
msgid "Photo or image"
msgstr "Foto o imagen"

# AI Translated
msgid "3D model"
msgstr "Modelo 3D"

# AI Translated
msgid "Document (PDF)"
msgstr "Documento (PDF)"

# AI Translated
msgid "This build cannot open a file dialog."
msgstr "Esta versión no puede abrir un cuadro de diálogo de archivos."

# AI Translated
#. TRN A calibration chat's first line. %1%: where it was started from, %2%: a printer.
#, boost-format
msgid "From %1% · %2% · filament not chosen · temporary test settings"
msgstr "Desde %1% · %2% · filamento sin elegir · ajustes de prueba temporales"

# AI Translated
#. TRN A calibration chat's first line. %1%: where it was started from, %2%: a filament, %3%: a printer.
#, boost-format
msgid "From %1% · %2% on %3% · temporary test settings"
msgstr "Desde %1% · %2% en %3% · ajustes de prueba temporales"

# AI Translated
# Needs human review: Feminine agrees with "prueba" (the calibration test); check against the noun shown nearby.
#. TRN A reopened calibration test's line. %1%: the day it was made, as "21 Oct 2026".
#, boost-format
msgid "Reopened · generated %1%"
msgstr "Reabierta · generada el %1%"

# AI Translated
# Needs human review: Feminine agrees with "prueba" (the calibration test); check against the noun shown nearby.
#. TRN %1%: where the test was opened from, %2%: the day it was made, as "21 Oct 2026".
#, boost-format
msgid "Opened from %1% · generated %2%"
msgstr "Abierta desde %1% · generada el %2%"

# AI Translated
#. TRN %1% is a calibration result, such as 215 °C.
#, boost-format
msgid "result %1% saved"
msgstr "resultado %1% guardado"

# AI Translated
#. TRN %1% is a plate's name, %2% why the slice did not succeed.
#, boost-format
msgid "The app did not slice %1%: %2%"
msgstr "La aplicación no ha laminado %1%: %2%"

# AI Translated
#. TRN %1% is a plate's name, %2% why the slice did not succeed.
#, boost-format
msgid "The app stopped the slice of %1%: %2%"
msgstr "La aplicación ha detenido el laminado de %1%: %2%"

# AI Translated
msgid "The slice of every plate finished."
msgstr "El laminado de todas las camas ha terminado."

# AI Translated
#. TRN %1% is a plate's name.
#, boost-format
msgid "The slice of %1% finished."
msgstr "El laminado de %1% ha terminado."

# AI Translated
msgid "Historical replies cannot be retried."
msgstr "No se pueden reintentar las respuestas antiguas."

# AI Translated
msgid "Only a failed or stopped assistant message in the active conversation can be retried."
msgstr "Solo se puede reintentar un mensaje del asistente que haya fallado o se haya detenido en la conversación activa."

# AI Translated
msgid "Only the chat's last reply can be retried."
msgstr "Solo se puede reintentar la última respuesta del chat."

# AI Translated
msgid "Another reply is currently streaming."
msgstr "Ya se está transmitiendo otra respuesta."

# AI Translated
msgid "Historical tool actions cannot be changed."
msgstr "No se pueden cambiar las acciones de herramientas antiguas."

# AI Translated
msgid "This proposal is no longer open. Ask AI again."
msgstr "Esta propuesta ya no está abierta. Vuelva a preguntar a la IA."

# AI Translated
msgid "This save can no longer be undone."
msgstr "Este guardado ya no se puede deshacer."

# AI Translated
msgid "Finish or resolve pending work before creating a chat."
msgstr "Termine o resuelva el trabajo pendiente antes de crear un chat."

# AI Translated
msgid "The current chat could not be saved."
msgstr "No se ha podido guardar el chat actual."

# AI Translated
msgid "The new chat could not be saved."
msgstr "No se ha podido guardar el chat nuevo."

# AI Translated
msgid "The selected chat could not be saved."
msgstr "No se ha podido guardar el chat seleccionado."

# AI Translated
msgid "The project or selected chat changed. Review it again."
msgstr "El proyecto o el chat seleccionado han cambiado. Revíselo de nuevo."

# AI Translated
msgid "Finish or resolve pending work before resuming a chat."
msgstr "Termine o resuelva el trabajo pendiente antes de reanudar un chat."

# AI Translated
msgid "This chat is already active."
msgstr "Este chat ya está activo."

# AI Translated
msgid "JusPrin can't find the project version this chat was working on."
msgstr "JusPrin no encuentra la versión del proyecto con la que trabajaba este chat."

# AI Translated
msgid "The current project could not be saved before restoration."
msgstr "No se ha podido guardar el proyecto actual antes de la restauración."

# AI Translated
msgid "JusPrin couldn't put the project back."
msgstr "JusPrin no ha podido restaurar el proyecto."

# AI Translated
msgid "Restored this chat's saved project setup. Check the current printer and material before printing."
msgstr "Se ha restaurado la configuración del proyecto guardada en este chat. Compruebe la impresora y el material actuales antes de imprimir."

# AI Translated
msgid "Use a non-empty, single-line title of at most 120 characters for an existing chat."
msgstr "Use un título no vacío, de una sola línea y de 120 caracteres como máximo para un chat existente."

# AI Translated
msgid "This chat is still working. Stop it or let it finish, then delete it."
msgstr "Este chat sigue trabajando. Deténgalo o deje que termine y luego elimínelo."

# AI Translated
msgid "This chat no longer exists."
msgstr "Este chat ya no existe."

# AI Translated
msgid "The replacement chat could not be saved."
msgstr "No se ha podido guardar el chat de reemplazo."

# AI Translated
msgid "Historical chats cannot edit the current draft."
msgstr "Los chats antiguos no pueden editar el borrador actual."

# AI Translated
msgid "Finish or stop the current reply before configuring AI."
msgstr "Termine o detenga la respuesta actual antes de configurar la IA."

# AI Translated
msgid "This build cannot configure an AI provider."
msgstr "Esta versión no puede configurar un proveedor de IA."

# AI Translated
msgid "A credential check is already running."
msgstr "Ya se está comprobando una credencial."

# AI Translated
msgid "This build cannot verify a key for that provider yet."
msgstr "Esta versión todavía no puede verificar una clave de ese proveedor."

# AI Translated
msgid "Finish or stop the current reply before removing a key."
msgstr "Termine o detenga la respuesta actual antes de eliminar una clave."

# AI Translated
msgid "Finish or cancel the key check before removing a key."
msgstr "Termine o cancele la comprobación de la clave antes de eliminar una clave."

# AI Translated
msgid "That key could not be removed."
msgstr "No se ha podido eliminar esa clave."

# AI Translated
msgid "This build cannot sign in to a JusPrin account."
msgstr "Esta versión no puede iniciar sesión en una cuenta de JusPrin."

# AI Translated
msgid "Finish or stop the current reply before signing in."
msgstr "Termine o detenga la respuesta actual antes de iniciar sesión."

# AI Translated
msgid "A sign-in or key check is already running."
msgstr "Ya se está iniciando sesión o comprobando una clave."

# AI Translated
msgid "There is no JusPrin account on this computer to check."
msgstr "No hay ninguna cuenta de JusPrin en este ordenador que comprobar."

# AI Translated
msgid "JusPrin couldn't sign you in. Try again."
msgstr "JusPrin no ha podido iniciar su sesión. Inténtelo de nuevo."

# AI Translated
msgid "This sign-in could not be saved, so you will have to sign in again next time JusPrin starts."
msgstr "No se ha podido guardar este inicio de sesión, así que tendrá que volver a iniciar sesión la próxima vez que se abra JusPrin."

# AI Translated
msgid "This key could not be saved, so it will have to be entered again next time JusPrin starts."
msgstr "No se ha podido guardar esta clave, así que tendrá que volver a introducirla la próxima vez que se abra JusPrin."

# AI Translated
msgid "The AI service is not available."
msgstr "El servicio de IA no está disponible."

# AI Translated
msgid "The AI service could not start this request."
msgstr "El servicio de IA no ha podido iniciar esta solicitud."

# AI Translated
msgid "AI could not receive the native tool result."
msgstr "La IA no ha podido recibir el resultado de la herramienta nativa."

# AI Translated
msgid "The AI request failed."
msgstr "La solicitud a la IA ha fallado."

# AI Translated
msgid "The automatic chat title could not be generated. You can rename the chat."
msgstr "No se ha podido generar el título automático del chat. Puede cambiar el nombre del chat."

# AI Translated
#. TRN %1% is an AI provider's account, such as JusPrin.
#, boost-format
msgid "This chat ran on your %1% account. Sign in again to continue it, or start a new chat."
msgstr "Este chat se ejecutó con su cuenta de %1%. Vuelva a iniciar sesión para continuarlo o empiece un chat nuevo."

# AI Translated
#. TRN %1% is an AI provider, such as OpenAI.
#, boost-format
msgid "This chat ran on %1%, and no %1% API key is set up now. Add the key in the AI settings to continue it, or start a new chat."
msgstr "Este chat se ejecutó con %1% y ahora no hay ninguna clave API de %1% configurada. Añada la clave en los ajustes de la IA para continuarlo o empiece un chat nuevo."

# AI Translated
msgid "JusPrin hasn't loaded the AI models for your account yet. Try again in a moment."
msgstr "JusPrin aún no ha cargado los modelos de IA de su cuenta. Inténtelo de nuevo en un momento."

# AI Translated
#. TRN %1% is an AI provider, such as OpenAI.
#, boost-format
msgid "No %1% API key is set up. Add it in the AI settings, or choose another model."
msgstr "No hay ninguna clave API de %1% configurada. Añádala en los ajustes de la IA o elija otro modelo."

# AI Translated
msgid "A connection is already being saved."
msgstr "Ya se está guardando una conexión."

# AI Translated
msgid "JusPrin's connection helper is missing. Reinstall or rebuild JusPrin."
msgstr "Falta el asistente de conexión de JusPrin. Reinstale o vuelva a compilar JusPrin."

# AI Translated
msgid "The AppImage launcher is missing. Reopen the installed AppImage."
msgstr "Falta el lanzador de AppImage. Vuelva a abrir la AppImage instalada."

# AI Translated
msgid "Review the change before connecting."
msgstr "Revise el cambio antes de conectar."

# AI Translated
#. TRN %1% is an AI client app, such as Claude Code.
#, boost-format
msgid "%1% isn't installed. Install it, or copy the command and run it later."
msgstr "%1% no está instalado. Instálelo o copie el comando y ejecútelo más tarde."

# AI Translated
msgid "This build cannot run the client CLI."
msgstr "Esta versión no puede ejecutar la CLI del cliente."

# AI Translated
msgid "This build cannot open a file manager."
msgstr "Esta versión no puede abrir un gestor de archivos."

# AI Translated
msgid "The provider did not answer."
msgstr "El proveedor no ha respondido."

# AI Translated
msgid "Attach files"
msgstr "Adjuntar archivos"

# AI Translated
msgid "The AI panel could not connect"
msgstr "El panel de IA no ha podido conectarse"

# AI Translated
msgid "Back to Prepare"
msgstr "Volver a Preparar"

# AI Translated
msgid "Open filament settings"
msgstr "Abrir ajustes del filamento"

# AI Translated
msgid "The packaged AI page is missing from this build."
msgstr "Falta la página de IA empaquetada en esta versión."

# AI Translated
msgid "The system web view could not be created."
msgstr "No se ha podido crear la vista web del sistema."

# AI Translated
msgid "The AI page failed to load."
msgstr "No se ha podido cargar la página de IA."

# AI Translated
msgid "The AI page did not complete the bridge handshake."
msgstr "La página de IA no ha completado el protocolo de enlace del puente."

# AI Translated
msgid "Restart the application to load the AI page."
msgstr "Reinicie la aplicación para cargar la página de IA."

# AI Translated
msgid "This is an internal connection between the application and its AI panel, not a network service."
msgstr "Es una conexión interna entre la aplicación y su panel de IA, no un servicio de red."

# AI Translated
#. TRN %1% is the web view's own error text.
#, boost-format
msgid "Last load error: %1%"
msgstr "Último error de carga: %1%"

# AI Translated
#. TRN The messages the app and its AI panel exchanged. %1% and %2% are counts.
#, boost-format
msgid "Bridge traffic: %1% sent / %2% received"
msgstr "Tráfico del puente: %1% enviados / %2% recibidos"

# AI Translated
msgid "The AI service returned an unreadable streaming response."
msgstr "El servicio de IA ha devuelto una respuesta en streaming ilegible."

# AI Translated
msgid "The AI service streamed a delta for a block it never opened."
msgstr "El servicio de IA ha transmitido un fragmento de un bloque que nunca abrió."

# AI Translated
msgid "The AI service sent a tool call whose arguments are not JSON."
msgstr "El servicio de IA ha enviado una llamada a herramienta cuyos argumentos no son JSON."

# AI Translated
msgid "The AI service could not complete the response."
msgstr "El servicio de IA no ha podido completar la respuesta."

# AI Translated
#. TRN %1% is the AI service's own reason, in English, such as "cyber".
#, boost-format
msgid "The AI service declined to answer (%1%)."
msgstr "El servicio de IA se ha negado a responder (%1%)."

# AI Translated
msgid "The AI service ended its response for a reason this build does not know."
msgstr "El servicio de IA ha terminado su respuesta por un motivo que esta versión no conoce."

# AI Translated
msgid "This version of JusPrin can no longer connect to JusPrin accounts. Get the new version to keep using your account."
msgstr "Esta versión de JusPrin ya no puede conectarse a las cuentas de JusPrin. Descargue la nueva versión para seguir usando su cuenta."

# AI Translated
msgid "Signing in didn't finish. Nothing was saved. Try again."
msgstr "El inicio de sesión no ha terminado. No se ha guardado nada. Inténtelo de nuevo."

# AI Translated
msgid "JusPrin couldn't be reached to finish signing in. Try again."
msgstr "No se ha podido conectar con JusPrin para terminar de iniciar sesión. Inténtelo de nuevo."

# AI Translated
msgid "JusPrin has no AI model for this account right now. Try again later."
msgstr "JusPrin no tiene ningún modelo de IA para esta cuenta en este momento. Inténtelo de nuevo más tarde."

# AI Translated
msgid "Restored an earlier project version"
msgstr "Se ha restaurado una versión anterior del proyecto"

# AI Translated
msgid "Restored this chat's saved project setup"
msgstr "Se ha restaurado la configuración del proyecto guardada en este chat"

# AI Translated
#. TRN The chat list's preview of a message that has only attachments.
msgid "Attachment"
msgstr "Archivo adjunto"

# AI Translated
msgid "The AI service stopped before finishing its response."
msgstr "El servicio de IA se ha detenido antes de terminar su respuesta."

# AI Translated
msgid "The AI service kept pausing its response."
msgstr "El servicio de IA ha pausado su respuesta repetidamente."

# AI Translated
msgid "AI could not be asked to continue its response."
msgstr "No se ha podido pedir a la IA que continúe su respuesta."

# AI Translated
msgid "AI could not be told the results of its tool calls."
msgstr "No se ha podido comunicar a la IA los resultados de sus llamadas a herramientas."

# AI Translated
msgid "AI returned an invalid tool call."
msgstr "La IA ha devuelto una llamada a herramienta no válida."

# AI Translated
msgid "The AI service ended before a complete response arrived."
msgstr "El servicio de IA ha terminado antes de que llegara una respuesta completa."

# AI Translated
msgid "Your JusPrin sign-in has ended. Sign in again in Preferences, then try again."
msgstr "Su sesión de JusPrin ha caducado. Vuelva a iniciar sesión en Preferencias e inténtelo de nuevo."

# AI Translated
msgid "That photo could not be read."
msgstr "No se pudo leer esa foto."

# AI Translated
#. TRN The print report form, about a photo over the server's limit of 20 MB.
msgid "That photo is larger than 20 MB. Choose a smaller photo, then send the report again."
msgstr "Esa foto ocupa más de 20 MB. Elija una foto más pequeña y vuelva a enviar el informe."

# AI Translated
#, boost-format
msgid "This message needs %1% credit; you have %2%."
msgid_plural "This message needs %1% credits; you have %2%."
msgstr[0] "Este mensaje necesita %1% crédito; tiene %2%."
msgstr[1] "Este mensaje necesita %1% créditos; tiene %2%."

# AI Translated
msgid "You're out of credits."
msgstr "Se ha quedado sin créditos."

# AI Translated
#. TRN %1% is an AI provider, such as OpenAI.
#, boost-format
msgid "The %1% API key was rejected. Update the AI configuration and try again."
msgstr "Se ha rechazado la clave API de %1%. Actualice la configuración de la IA e inténtelo de nuevo."

# AI Translated
#. TRN %1% is an AI provider, such as OpenAI.
#, boost-format
msgid "The request was too large for the %1% service."
msgstr "La solicitud era demasiado grande para el servicio de %1%."

# AI Translated
#. TRN %1% is an AI provider, such as OpenAI.
#, boost-format
msgid "The %1% service is rate limited. Try again shortly."
msgstr "El servicio de %1% ha limitado las solicitudes. Inténtelo de nuevo en breve."

# AI Translated
#. TRN %1% is an AI provider, such as OpenAI.
#, boost-format
msgid "The %1% service is overloaded. Try again shortly."
msgstr "El servicio de %1% está sobrecargado. Inténtelo de nuevo en breve."

# AI Translated
#. TRN %1% is an AI provider, such as OpenAI.
#, boost-format
msgid "The %1% service is temporarily unavailable."
msgstr "El servicio de %1% no está disponible temporalmente."

# AI Translated
msgid "The AI request timed out."
msgstr "Se ha agotado el tiempo de espera de la solicitud a la IA."

# AI Translated
#. TRN %1% is an AI provider, such as OpenAI.
#, boost-format
msgid "The AI request could not reach the %1% service."
msgstr "La solicitud a la IA no ha podido llegar al servicio de %1%."

# AI Translated
msgid "The AI service response did not contain valid output."
msgstr "La respuesta del servicio de IA no contenía una salida válida."

# AI Translated
#. TRN A button that asks the AI to choose another block of a calibration test.
msgid "Pick another block"
msgstr "Elegir otro bloque"

# AI Translated
# Needs human review: "tile" of a calibration test: check whether "baldosa" or "casilla" fits the test pattern.
#. TRN A button that asks the AI to choose another tile of a calibration test.
msgid "Pick another tile"
msgstr "Elegir otra baldosa"

# AI Translated
#. TRN A button that asks the AI to choose another line of a calibration test.
msgid "Pick another line"
msgstr "Elegir otra línea"

# AI Translated
#. TRN A button that asks the AI to choose another corner of a calibration test.
msgid "Pick another corner"
msgstr "Elegir otra esquina"

# AI Translated
#. TRN A button that asks the AI to choose another height of a calibration tower.
msgid "Pick another height"
msgstr "Elegir otra altura"

# AI Translated
#. TRN %1% is a preset's name.
#, boost-format
msgid "Preset · %1%"
msgstr "Perfil · %1%"

# AI Translated
#. TRN %1% is a preset's name.
#, boost-format
msgid "New preset · %1%"
msgstr "Perfil nuevo · %1%"

# AI Translated
#. TRN %1% is the preset the new one is made from.
#, boost-format
msgid "%1% itself is unchanged"
msgstr "%1% no cambia"

# AI Translated
#. TRN %1% is a setting's new value, such as 215 °C.
#, boost-format
msgid "Save %1% as a new filament preset"
msgstr "Guardar %1% como un perfil de filamento nuevo"

# AI Translated
#. TRN %1% is a setting's new value, such as 215 °C.
#, boost-format
msgid "Save %1% as a new printer preset"
msgstr "Guardar %1% como un perfil de impresora nuevo"

# AI Translated
#. TRN %1% is a setting's new value, such as 215 °C.
#, boost-format
msgid "Save %1% as a new process preset"
msgstr "Guardar %1% como un perfil de proceso nuevo"

# AI Translated
#. TRN %1% is a setting's new value, such as 215 °C, %2% a preset's name.
#, boost-format
msgid "Save %1% to %2%"
msgstr "Guardar %1% en %2%"

# AI Translated
msgid "This proposal is already saved."
msgstr "Esta propuesta ya está guardada."

# AI Translated
msgid "Drop a model here or add one"
msgstr "Suelte un modelo aquí o añada uno"

# AI Translated
msgid "World coordinates"
msgstr "Coordenadas globales"

# AI Translated
msgid "Object coordinates"
msgstr "Coordenadas del objeto"

# AI Translated
msgid "Translate(Relative)"
msgstr "Trasladar (relativo)"

# AI Translated
msgid "Rotate (absolute)"
msgstr "Rotar (absoluto)"

# AI Translated
msgid "Part coordinates"
msgstr "Coordenadas de la pieza"

# AI Translated
msgid "The packaged Home page is missing from this build."
msgstr "Falta la página de Inicio empaquetada en esta versión."

# AI Translated
msgid "The Home page failed to load."
msgstr "No se ha podido cargar la página de Inicio."

# AI Translated
msgid "This window stopped updating because the app switched to another printer."
msgstr "Esta ventana ha dejado de actualizarse porque la aplicación ha cambiado a otra impresora."

# AI Translated
#. TRN A length in millimetres, such as a nozzle diameter on a printer card: "0.4 mm". %s is the number.
#, c-format, boost-format
msgid "%s mm"
msgstr "%s mm"

# AI Translated
#, c-format, boost-format
msgid "The printer reports error %s."
msgstr "La impresora informa del error %s."

# AI Translated
msgid "LAN"
msgstr "LAN"

# AI Translated
msgid "Cloud"
msgstr "Nube"

# AI Translated
msgid "The printer stopped sending updates."
msgstr "La impresora ha dejado de enviar actualizaciones."

# AI Translated
#, c-format, boost-format
msgid "%s isn't answering."
msgstr "%s no responde."

# AI Translated
msgid "Klipper isn't running."
msgstr "Klipper no se está ejecutando."

# AI Translated
#. TRN %1% is Klipper's own message, in English, saying why it stopped.
#, boost-format
msgid "Klipper stopped: %1%"
msgstr "Klipper se ha detenido: %1%"

# AI Translated
msgid "This printer no longer exists."
msgstr "Esta impresora ya no existe."

# AI Translated
#. TRN A date in this year on a project card: %1% is the abbreviated month name, %2% the day of the month, as in "Oct 20".
#, boost-format
msgctxt "short date"
msgid "%1% %2%"
msgstr "%2% %1%"

# AI Translated
# Needs human review: Date with year on a project card, e.g. "20 oct de 2026"; check against how %1% is formatted.
#. TRN A date outside this year on a project card: %1% is the date without the year, as in "Oct 20", %2% the year.
#, boost-format
msgctxt "date with year"
msgid "%1%, %2%"
msgstr "%1% de %2%"

# AI Translated
msgid "G-code exported"
msgstr "G-code exportado"

# AI Translated
#. TRN A project's status: %1% is a date, as in "Nov 3".
#, boost-format
msgid "G-code exported %1%"
msgstr "G-code exportado el %1%"

# AI Translated
#. TRN A project's status: %1% is a printer model, as in "Ender-3 V3 KE".
#, boost-format
msgid "G-code exported for %1%"
msgstr "G-code exportado para %1%"

# AI Translated
#. TRN A project's status: %1% is a date, as in "Nov 3", %2% a printer model, as in "Ender-3 V3 KE".
#, boost-format
msgid "G-code exported %1% for %2%"
msgstr "G-code exportado el %1% para %2%"

# AI Translated
msgctxt "project status"
msgid "Printed"
msgstr "Impreso"

# AI Translated
#. TRN A project's status: %1% is a date, as in "Oct 20".
#, boost-format
