# AI Translated
msgid "Restored this chat's saved project setup. Check the current printer and material before printing."
msgstr "S'ha restaurat la configuració del projecte desada d'aquest xat. Comproveu la impressora i el material actuals abans d'imprimir."

# AI Translated
msgid "A credential check is already running."
msgstr "Ja s'està comprovant una credencial."

# AI Translated
msgid "This build cannot verify a key for that provider yet."
msgstr "Aquesta compilació encara no pot verificar una clau per a aquest proveïdor."

# AI Translated
msgid "A sign-in or key check is already running."
msgstr "Ja s'està fent un inici de sessió o una comprovació de clau."

# AI Translated
msgid "JusPrin couldn't sign you in. Try again."
msgstr "JusPrin no ha pogut iniciar la vostra sessió. Torneu-ho a provar."

# AI Translated
msgid "The AI service is not available."
msgstr "El servei d'IA no està disponible."

# AI Translated
msgid "The AI service could not start this request."
msgstr "El servei d'IA no ha pogut iniciar aquesta sol·licitud."

# AI Translated
msgid "AI could not receive the native tool result."
msgstr "La IA no ha pogut rebre el resultat de l'eina nativa."

# AI Translated
msgid "The AI request failed."
msgstr "La sol·licitud a la IA ha fallat."

# AI Translated
#. TRN %1% is an AI provider's account, such as JusPrin.
#, boost-format
msgid "This chat ran on your %1% account. Sign in again to continue it, or start a new chat."
msgstr "Aquest xat funcionava amb el vostre compte de %1%. Torneu a iniciar sessió per continuar-lo o comenceu un xat nou."

# AI Translated
#. TRN %1% is an AI provider, such as OpenAI.
#, boost-format
msgid "This chat ran on %1%, and no %1% API key is set up now. Add the key in the AI settings to continue it, or start a new chat."
msgstr "Aquest xat funcionava amb %1% i ara no hi ha configurada cap clau d'API de %1%. Afegiu la clau a la configuració de la IA per continuar-lo o comenceu un xat nou."

# AI Translated
msgid "JusPrin hasn't loaded the AI models for your account yet. Try again in a moment."
msgstr "JusPrin encara no ha carregat els models d'IA del vostre compte. Torneu-ho a provar d'aquí a un moment."

# AI Translated
#. TRN %1% is an AI provider, such as OpenAI.
#, boost-format
msgid "No %1% API key is set up. Add it in the AI settings, or choose another model."
msgstr "No hi ha configurada cap clau d'API de %1%. Afegiu-la a la configuració de la IA o trieu un altre model."

# AI Translated
msgid "A connection is already being saved."
msgstr "Ja s'està desant una connexió."

# AI Translated
msgid "JusPrin's connection helper is missing. Reinstall or rebuild JusPrin."
msgstr "Falta l'assistent de connexió de JusPrin. Reinstal·leu o recompileu JusPrin."

# AI Translated
msgid "The AppImage launcher is missing. Reopen the installed AppImage."
msgstr "Falta el llançador de l'AppImage. Torneu a obrir l'AppImage instal·lada."

# AI Translated
msgid "Review the change before connecting."
msgstr "Reviseu el canvi abans de connectar."

# AI Translated
#. TRN %1% is an AI client app, such as Claude Code.
#, boost-format
msgid "%1% isn't installed. Install it, or copy the command and run it later."
msgstr "%1% no està instal·lat. Instal·leu-lo, o copieu l'ordre i executeu-la més tard."

# AI Translated
msgid "This build cannot run the client CLI."
msgstr "Aquesta compilació no pot executar la CLI del client."

# AI Translated
msgid "The provider did not answer."
msgstr "El proveïdor no ha respost."

# AI Translated
