#, boost-format
msgid "Bridge traffic: %1% sent / %2% received"
msgstr "Trànsit del pont: %1% enviats / %2% rebuts"

# AI Translated
#. TRN %1% is the AI service's own reason, in English, such as "cyber".
#, boost-format
msgid "The AI service declined to answer (%1%)."
msgstr "El servei d'IA s'ha negat a respondre (%1%)."

# AI Translated
msgid "This version of JusPrin can no longer connect to JusPrin accounts. Get the new version to keep using your account."
msgstr "Aquesta versió de JusPrin ja no es pot connectar als comptes de JusPrin. Obteniu la versió nova per continuar fent servir el vostre compte."

# AI Translated
msgid "Your JusPrin sign-in has ended. Sign in again in Preferences, then try again."
msgstr "La vostra sessió de JusPrin ha caducat. Torneu a iniciar sessió a Preferències i torneu-ho a provar."

# AI Translated
msgid "Signing in didn't finish. Nothing was saved. Try again."
msgstr "L'inici de sessió no s'ha completat. No s'ha desat res. Torneu-ho a provar."

# AI Translated
msgid "JusPrin couldn't be reached to finish signing in. Try again."
msgstr "No s'ha pogut contactar amb JusPrin per completar l'inici de sessió. Torneu-ho a provar."

# AI Translated
msgid "JusPrin has no AI model for this account right now. Try again later."
msgstr "Ara mateix JusPrin no té cap model d'IA per a aquest compte. Torneu-ho a provar més tard."

