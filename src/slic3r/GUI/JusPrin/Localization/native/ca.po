# AI Translated
msgid "The AI page failed to load."
msgstr "No s'ha pogut carregar la pàgina d'IA."

# AI Translated
msgid "The AI page did not complete the bridge handshake."
msgstr "La pàgina d'IA no ha completat la connexió amb el pont."

# AI Translated
msgid "Restart the application to load the AI page."
msgstr "Reinicieu l'aplicació per carregar la pàgina d'IA."

# AI Translated
msgid "This is an internal connection between the application and its AI panel, not a network service."
msgstr "Aquesta és una connexió interna entre l'aplicació i el seu panell d'IA, no un servei de xarxa."

# AI Translated
#. TRN %1% is the web view's own error text.
#, boost-format
