# AI Translated
# Needs human review: 'restoration is recovered' is unclear in English; check what the person sees here
msgid "Project chat is blocked until restoration is recovered."
msgstr "La chat del progetto è bloccata finché il ripristino non viene recuperato."

# AI Translated
msgid "Return to the active chat or restore this chat before sending."
msgstr "Torna alla chat attiva o ripristina questa chat prima di inviare."

# AI Translated
msgid "Finish or cancel AI configuration before sending a message."
msgstr "Completa o annulla la configurazione dell'IA prima di inviare un messaggio."

# AI Translated
msgid "This message belongs to a different chat."
msgstr "Questo messaggio appartiene a un'altra chat."

# AI Translated
msgid "A message needs text or an attachment."
msgstr "Un messaggio deve contenere testo o un allegato."

# AI Translated
msgid "This file is too large to attach."
msgstr "Questo file è troppo grande per essere allegato."

# AI Translated
msgid "This file type can't be read by AI."
msgstr "L'IA non può leggere questo tipo di file."

# AI Translated
msgid "This file is not readable UTF-8 text."
msgstr "Questo file non è un testo UTF-8 leggibile."

# AI Translated
msgid "The attachment could not be stored."
msgstr "Impossibile salvare l'allegato."

# AI Translated
msgid "Photo or image"
msgstr "Foto o immagine"

# AI Translated
msgid "3D model"
msgstr "Modello 3D"

# AI Translated
msgid "Document (PDF)"
msgstr "Documento (PDF)"

# AI Translated
msgid "This build cannot open a file dialog."
msgstr "Questa build non può aprire una finestra di selezione file."

# AI Translated
#. TRN A calibration chat's first line. %1%: where it was started from, %2%: a printer.
#, boost-format
msgid "From %1% · %2% · filament not chosen · temporary test settings"
msgstr "Da %1% · %2% · filamento non scelto · impostazioni di test temporanee"

# AI Translated
#. TRN A calibration chat's first line. %1%: where it was started from, %2%: a filament, %3%: a printer.
#, boost-format
msgid "From %1% · %2% on %3% · temporary test settings"
msgstr "Da %1% · %2% su %3% · impostazioni di test temporanee"

# AI Translated
#. TRN A reopened calibration test's line. %1%: the day it was made, as "21 Oct 2026".
#, boost-format
msgid "Reopened · generated %1%"
msgstr "Riaperto · generato il %1%"

# AI Translated
#. TRN %1%: where the test was opened from, %2%: the day it was made, as "21 Oct 2026".
#, boost-format
msgid "Opened from %1% · generated %2%"
msgstr "Aperto da %1% · generato il %2%"

# AI Translated
#. TRN %1% is a calibration result, such as 215 °C.
#, boost-format
msgid "result %1% saved"
msgstr "risultato %1% salvato"

# AI Translated
#. TRN %1% is a plate's name, %2% why the slice did not succeed.
#, boost-format
msgid "The app did not slice %1%: %2%"
msgstr "L'app non ha elaborato %1%: %2%"

# AI Translated
#. TRN %1% is a plate's name, %2% why the slice did not succeed.
#, boost-format
msgid "The app stopped the slice of %1%: %2%"
msgstr "L'app ha interrotto l'elaborazione di %1%: %2%"

# AI Translated
msgid "The slice of every plate finished."
msgstr "L'elaborazione di tutti i piatti è terminata."

# AI Translated
#. TRN %1% is a plate's name.
#, boost-format
msgid "The slice of %1% finished."
msgstr "L'elaborazione di %1% è terminata."

# AI Translated
msgid "Historical replies cannot be retried."
msgstr "Le risposte passate non possono essere riprovate."

# AI Translated
msgid "Only a failed or stopped assistant message in the active conversation can be retried."
msgstr "Si può riprovare solo un messaggio dell'assistente non riuscito o interrotto nella conversazione attiva."

# AI Translated
msgid "Only the chat's last reply can be retried."
msgstr "Si può riprovare solo l'ultima risposta della chat."

# AI Translated
msgid "Another reply is currently streaming."
msgstr "È già in arrivo un'altra risposta."

# AI Translated
msgid "Historical tool actions cannot be changed."
msgstr "Le azioni degli strumenti passate non possono essere modificate."

# AI Translated
msgid "This proposal is no longer open. Ask AI again."
msgstr "Questa proposta non è più aperta. Chiedi di nuovo all'IA."

# AI Translated
msgid "This save can no longer be undone."
msgstr "Questo salvataggio non può più essere annullato."

# AI Translated
msgid "Finish or resolve pending work before creating a chat."
msgstr "Completa o risolvi le operazioni in sospeso prima di creare una chat."

# AI Translated
msgid "The current chat could not be saved."
msgstr "Impossibile salvare la chat corrente."

# AI Translated
msgid "The new chat could not be saved."
msgstr "Impossibile salvare la nuova chat."

# AI Translated
msgid "The selected chat could not be saved."
msgstr "Impossibile salvare la chat selezionata."

# AI Translated
msgid "The project or selected chat changed. Review it again."
msgstr "Il progetto o la chat selezionata sono cambiati. Controlla di nuovo."

# AI Translated
msgid "Finish or resolve pending work before resuming a chat."
msgstr "Completa o risolvi le operazioni in sospeso prima di riprendere una chat."

# AI Translated
msgid "This chat is already active."
msgstr "Questa chat è già attiva."

# AI Translated
msgid "JusPrin can't find the project version this chat was working on."
msgstr "JusPrin non trova la versione del progetto su cui stava lavorando questa chat."

# AI Translated
msgid "The current project could not be saved before restoration."
msgstr "Impossibile salvare il progetto corrente prima del ripristino."

# AI Translated
msgid "JusPrin couldn't put the project back."
msgstr "JusPrin non è riuscito a ripristinare il progetto."

# AI Translated
msgid "Restored this chat's saved project setup. Check the current printer and material before printing."
msgstr "È stata ripristinata la configurazione del progetto salvata in questa chat. Controlla la stampante e il materiale correnti prima di stampare."

# AI Translated
msgid "Use a non-empty, single-line title of at most 120 characters for an existing chat."
msgstr "Usa per una chat esistente un titolo non vuoto, su una sola riga, di al massimo 120 caratteri."

# AI Translated
msgid "This chat is still working. Stop it or let it finish, then delete it."
msgstr "Questa chat è ancora al lavoro. Interrompila o lasciala finire, poi eliminala."

# AI Translated
msgid "This chat no longer exists."
msgstr "Questa chat non esiste più."

# AI Translated
msgid "The replacement chat could not be saved."
msgstr "Impossibile salvare la chat sostitutiva."

# AI Translated
msgid "Historical chats cannot edit the current draft."
msgstr "Le chat passate non possono modificare la bozza corrente."

# AI Translated
msgid "Finish or stop the current reply before configuring AI."
msgstr "Completa o interrompi la risposta corrente prima di configurare l'IA."

# AI Translated
msgid "This build cannot configure an AI provider."
msgstr "Questa build non può configurare un fornitore di IA."

# AI Translated
msgid "A credential check is already running."
msgstr "È già in corso una verifica delle credenziali."

# AI Translated
msgid "This build cannot verify a key for that provider yet."
msgstr "Questa build non può ancora verificare una chiave per quel fornitore."

# AI Translated
msgid "Finish or stop the current reply before removing a key."
msgstr "Completa o interrompi la risposta corrente prima di rimuovere una chiave."

# AI Translated
msgid "Finish or cancel the key check before removing a key."
msgstr "Completa o annulla la verifica della chiave prima di rimuovere una chiave."

# AI Translated
msgid "That key could not be removed."
msgstr "Impossibile rimuovere quella chiave."

# AI Translated
msgid "This build cannot sign in to a JusPrin account."
msgstr "Questa build non può accedere a un account JusPrin."

# AI Translated
msgid "Finish or stop the current reply before signing in."
msgstr "Completa o interrompi la risposta corrente prima di accedere."

# AI Translated
msgid "A sign-in or key check is already running."
msgstr "È già in corso un accesso o una verifica della chiave."

# AI Translated
msgid "There is no JusPrin account on this computer to check."
msgstr "Su questo computer non c'è nessun account JusPrin da verificare."

# AI Translated
msgid "JusPrin couldn't sign you in. Try again."
msgstr "JusPrin non è riuscito a farti accedere. Riprova."

# AI Translated
msgid "This sign-in could not be saved, so you will have to sign in again next time JusPrin starts."
msgstr "Impossibile salvare questo accesso: dovrai accedere di nuovo al prossimo avvio di JusPrin."

# AI Translated
msgid "This key could not be saved, so it will have to be entered again next time JusPrin starts."
msgstr "Impossibile salvare questa chiave: dovrai inserirla di nuovo al prossimo avvio di JusPrin."

# AI Translated
msgid "The AI service is not available."
msgstr "Il servizio di IA non è disponibile."

# AI Translated
msgid "The AI service could not start this request."
msgstr "Il servizio di IA non è riuscito ad avviare questa richiesta."

# AI Translated
msgid "AI could not receive the native tool result."
msgstr "L'IA non ha potuto ricevere il risultato dello strumento nativo."

# AI Translated
msgid "The AI request failed."
msgstr "La richiesta all'IA non è riuscita."

# AI Translated
msgid "The automatic chat title could not be generated. You can rename the chat."
msgstr "Impossibile generare automaticamente il titolo della chat. Puoi rinominare la chat."

# AI Translated
#. TRN %1% is an AI provider's account, such as JusPrin.
#, boost-format
msgid "This chat ran on your %1% account. Sign in again to continue it, or start a new chat."
msgstr "Questa chat usava il tuo account %1%. Accedi di nuovo per continuarla, oppure inizia una nuova chat."

# AI Translated
#. TRN %1% is an AI provider, such as OpenAI.
#, boost-format
msgid "This chat ran on %1%, and no %1% API key is set up now. Add the key in the AI settings to continue it, or start a new chat."
msgstr "Questa chat usava %1%, e ora non è configurata nessuna chiave API di %1%. Aggiungi la chiave nelle impostazioni dell'IA per continuarla, oppure inizia una nuova chat."

# AI Translated
msgid "JusPrin hasn't loaded the AI models for your account yet. Try again in a moment."
msgstr "JusPrin non ha ancora caricato i modelli di IA per il tuo account. Riprova tra un momento."

# AI Translated
#. TRN %1% is an AI provider, such as OpenAI.
#, boost-format
msgid "No %1% API key is set up. Add it in the AI settings, or choose another model."
msgstr "Nessuna chiave API di %1% configurata. Aggiungila nelle impostazioni dell'IA, oppure scegli un altro modello."

# AI Translated
msgid "A connection is already being saved."
msgstr "È già in corso il salvataggio di una connessione."

# AI Translated
msgid "JusPrin's connection helper is missing. Reinstall or rebuild JusPrin."
msgstr "Manca il componente di connessione di JusPrin. Reinstalla o ricompila JusPrin."

# AI Translated
msgid "The AppImage launcher is missing. Reopen the installed AppImage."
msgstr "Manca il launcher dell'AppImage. Riapri l'AppImage installata."

# AI Translated
msgid "Review the change before connecting."
msgstr "Controlla la modifica prima di connetterti."

# AI Translated
#. TRN %1% is an AI client app, such as Claude Code.
#, boost-format
msgid "%1% isn't installed. Install it, or copy the command and run it later."
msgstr "%1% non è installato. Installalo, oppure copia il comando ed eseguilo più tardi."

# AI Translated
msgid "This build cannot run the client CLI."
msgstr "Questa build non può eseguire la CLI del client."

# AI Translated
msgid "This build cannot open a file manager."
msgstr "Questa build non può aprire un file manager."

# AI Translated
msgid "The provider did not answer."
msgstr "Il fornitore non ha risposto."

# AI Translated
msgid "Attach files"
msgstr "Allega file"

# AI Translated
msgid "The AI panel could not connect"
msgstr "Il pannello IA non è riuscito a connettersi"

# AI Translated
msgid "Back to Prepare"
msgstr "Torna a Prepara"

# AI Translated
msgid "Open filament settings"
msgstr "Apri impostazioni filamento"

# AI Translated
msgid "The packaged AI page is missing from this build."
msgstr "In questa build manca la pagina IA inclusa nel pacchetto."

# AI Translated
msgid "The system web view could not be created."
msgstr "Impossibile creare la vista web di sistema."

# AI Translated
msgid "The AI page failed to load."
msgstr "Caricamento della pagina IA non riuscito."

# AI Translated
msgid "The AI page did not complete the bridge handshake."
msgstr "La pagina IA non ha completato l'handshake del bridge."

# AI Translated
msgid "Restart the application to load the AI page."
msgstr "Riavvia l'applicazione per caricare la pagina IA."

# AI Translated
msgid "This is an internal connection between the application and its AI panel, not a network service."
msgstr "Questa è una connessione interna tra l'applicazione e il suo pannello IA, non un servizio di rete."

# AI Translated
#. TRN %1% is the web view's own error text.
#, boost-format
msgid "Last load error: %1%"
msgstr "Ultimo errore di caricamento: %1%"

# AI Translated
#. TRN The messages the app and its AI panel exchanged. %1% and %2% are counts.
#, boost-format
msgid "Bridge traffic: %1% sent / %2% received"
msgstr "Traffico del bridge: %1% inviati / %2% ricevuti"

# AI Translated
msgid "The AI service returned an unreadable streaming response."
msgstr "Il servizio di IA ha restituito una risposta in streaming illeggibile."

# AI Translated
msgid "The AI service streamed a delta for a block it never opened."
msgstr "Il servizio di IA ha inviato in streaming un delta per un blocco mai aperto."

# AI Translated
msgid "The AI service sent a tool call whose arguments are not JSON."
msgstr "Il servizio di IA ha inviato una chiamata a uno strumento con argomenti non in formato JSON."

# AI Translated
msgid "The AI service could not complete the response."
msgstr "Il servizio di IA non è riuscito a completare la risposta."

# AI Translated
#. TRN %1% is the AI service's own reason, in English, such as "cyber".
#, boost-format
msgid "The AI service declined to answer (%1%)."
msgstr "Il servizio di IA si è rifiutato di rispondere (%1%)."

# AI Translated
msgid "The AI service ended its response for a reason this build does not know."
msgstr "Il servizio di IA ha terminato la risposta per un motivo che questa build non conosce."

# AI Translated
msgid "This version of JusPrin can no longer connect to JusPrin accounts. Get the new version to keep using your account."
msgstr "Questa versione di JusPrin non può più connettersi agli account JusPrin. Scarica la nuova versione per continuare a usare il tuo account."

# AI Translated
msgid "Signing in didn't finish. Nothing was saved. Try again."
msgstr "L'accesso non è stato completato. Non è stato salvato nulla. Riprova."

# AI Translated
msgid "JusPrin couldn't be reached to finish signing in. Try again."
msgstr "Impossibile raggiungere JusPrin per completare l'accesso. Riprova."

# AI Translated
msgid "JusPrin has no AI model for this account right now. Try again later."
msgstr "Al momento JusPrin non ha nessun modello di IA per questo account. Riprova più tardi."

# AI Translated
msgid "Restored an earlier project version"
msgstr "Ripristinata una versione precedente del progetto"

# AI Translated
msgid "Restored this chat's saved project setup"
msgstr "Ripristinata la configurazione del progetto salvata in questa chat"

# AI Translated
#. TRN The chat list's preview of a message that has only attachments.
msgid "Attachment"
msgstr "Allegato"

# AI Translated
msgid "The AI service stopped before finishing its response."
msgstr "Il servizio di IA si è interrotto prima di completare la risposta."

# AI Translated
msgid "The AI service kept pausing its response."
msgstr "Il servizio di IA ha continuato a mettere in pausa la risposta."

# AI Translated
msgid "AI could not be asked to continue its response."
msgstr "Impossibile chiedere all'IA di continuare la risposta."

# AI Translated
msgid "AI could not be told the results of its tool calls."
msgstr "Impossibile comunicare all'IA i risultati delle sue chiamate agli strumenti."

# AI Translated
msgid "AI returned an invalid tool call."
msgstr "L'IA ha restituito una chiamata a uno strumento non valida."

# AI Translated
msgid "The AI service ended before a complete response arrived."
msgstr "Il servizio di IA si è chiuso prima che arrivasse una risposta completa."

# AI Translated
msgid "Your JusPrin sign-in has ended. Sign in again in Preferences, then try again."
msgstr "Il tuo accesso a JusPrin è scaduto. Accedi di nuovo in Preferenze, poi riprova."

# AI Translated
msgid "That photo could not be read."
msgstr "Impossibile leggere questa foto."

# AI Translated
#. TRN The print report form, about a photo over the server's limit of 20 MB.
msgid "That photo is larger than 20 MB. Choose a smaller photo, then send the report again."
msgstr "Questa foto supera i 20 MB. Scegli una foto più piccola, poi invia di nuovo il rapporto."

# AI Translated
#, boost-format
msgid "This message needs %1% credit; you have %2%."
msgid_plural "This message needs %1% credits; you have %2%."
msgstr[0] "Questo messaggio richiede %1% credito; ne hai %2%."
msgstr[1] "Questo messaggio richiede %1% crediti; ne hai %2%."

# AI Translated
msgid "You're out of credits."
msgstr "Hai esaurito i crediti."

# AI Translated
#. TRN %1% is an AI provider, such as OpenAI.
#, boost-format
msgid "The %1% API key was rejected. Update the AI configuration and try again."
msgstr "La chiave API di %1% è stata rifiutata. Aggiorna la configurazione dell'IA e riprova."

# AI Translated
#. TRN %1% is an AI provider, such as OpenAI.
#, boost-format
msgid "The request was too large for the %1% service."
msgstr "La richiesta era troppo grande per il servizio %1%."

# AI Translated
#. TRN %1% is an AI provider, such as OpenAI.
#, boost-format
msgid "The %1% service is rate limited. Try again shortly."
msgstr "Il servizio %1% ha raggiunto il limite di richieste. Riprova tra poco."

# AI Translated
#. TRN %1% is an AI provider, such as OpenAI.
#, boost-format
msgid "The %1% service is overloaded. Try again shortly."
msgstr "Il servizio %1% è sovraccarico. Riprova tra poco."

# AI Translated
#. TRN %1% is an AI provider, such as OpenAI.
#, boost-format
msgid "The %1% service is temporarily unavailable."
msgstr "Il servizio %1% è temporaneamente non disponibile."

# AI Translated
msgid "The AI request timed out."
msgstr "La richiesta all'IA è scaduta."

# AI Translated
#. TRN %1% is an AI provider, such as OpenAI.
#, boost-format
msgid "The AI request could not reach the %1% service."
msgstr "La richiesta all'IA non ha potuto raggiungere il servizio %1%."

# AI Translated
msgid "The AI service response did not contain valid output."
msgstr "La risposta del servizio di IA non conteneva un output valido."

# AI Translated
#. TRN A button that asks the AI to choose another block of a calibration test.
msgid "Pick another block"
msgstr "Scegli un altro blocco"

# AI Translated
#. TRN A button that asks the AI to choose another tile of a calibration test.
msgid "Pick another tile"
msgstr "Scegli un'altra tessera"

# AI Translated
#. TRN A button that asks the AI to choose another line of a calibration test.
msgid "Pick another line"
msgstr "Scegli un'altra linea"

# AI Translated
#. TRN A button that asks the AI to choose another corner of a calibration test.
msgid "Pick another corner"
msgstr "Scegli un altro angolo"

# AI Translated
#. TRN A button that asks the AI to choose another height of a calibration tower.
msgid "Pick another height"
msgstr "Scegli un'altra altezza"

# AI Translated
#. TRN %1% is a preset's name.
#, boost-format
msgid "Preset · %1%"
msgstr "Profilo · %1%"

# AI Translated
#. TRN %1% is a preset's name.
#, boost-format
msgid "New preset · %1%"
msgstr "Nuovo profilo · %1%"

# AI Translated
#. TRN %1% is the preset the new one is made from.
#, boost-format
msgid "%1% itself is unchanged"
msgstr "%1% resta invariato"

# AI Translated
#. TRN %1% is a setting's new value, such as 215 °C.
#, boost-format
msgid "Save %1% as a new filament preset"
msgstr "Salva %1% come nuovo profilo filamento"

# AI Translated
#. TRN %1% is a setting's new value, such as 215 °C.
#, boost-format
msgid "Save %1% as a new printer preset"
msgstr "Salva %1% come nuovo profilo stampante"

# AI Translated
#. TRN %1% is a setting's new value, such as 215 °C.
#, boost-format
msgid "Save %1% as a new process preset"
msgstr "Salva %1% come nuovo profilo di processo"

# AI Translated
#. TRN %1% is a setting's new value, such as 215 °C, %2% a preset's name.
#, boost-format
msgid "Save %1% to %2%"
msgstr "Salva %1% in %2%"

# AI Translated
msgid "This proposal is already saved."
msgstr "Questa proposta è già salvata."

# AI Translated
msgid "Drop a model here or add one"
msgstr "Trascina qui un modello o aggiungine uno"

# AI Translated
msgid "World coordinates"
msgstr "Coordinate globali"

# AI Translated
msgid "Object coordinates"
msgstr "Coordinate oggetto"

# AI Translated
msgid "Translate(Relative)"
msgstr "Trasla (relativo)"

# AI Translated
msgid "Rotate (absolute)"
msgstr "Ruota (assoluto)"

# AI Translated
msgid "Part coordinates"
msgstr "Coordinate parte"

# AI Translated
msgid "The packaged Home page is missing from this build."
msgstr "In questa build manca la pagina Home inclusa nel pacchetto."

# AI Translated
msgid "The Home page failed to load."
msgstr "Caricamento della pagina Home non riuscito."

# AI Translated
msgid "This window stopped updating because the app switched to another printer."
msgstr "Questa finestra ha smesso di aggiornarsi perché l'app è passata a un'altra stampante."

# AI Translated
#. TRN A length in millimetres, such as a nozzle diameter on a printer card: "0.4 mm". %s is the number.
#, c-format, boost-format
msgid "%s mm"
msgstr "%s mm"

# AI Translated
#, c-format, boost-format
msgid "The printer reports error %s."
msgstr "La stampante segnala l'errore %s."

# AI Translated
msgid "LAN"
msgstr "LAN"

# AI Translated
msgid "Cloud"
msgstr "Cloud"

# AI Translated
msgid "The printer stopped sending updates."
msgstr "La stampante ha smesso di inviare aggiornamenti."

# AI Translated
#, c-format, boost-format
msgid "%s isn't answering."
msgstr "%s non risponde."

# AI Translated
msgid "Klipper isn't running."
msgstr "Klipper non è in esecuzione."

# AI Translated
#. TRN %1% is Klipper's own message, in English, saying why it stopped.
#, boost-format
msgid "Klipper stopped: %1%"
msgstr "Klipper si è fermato: %1%"

# AI Translated
msgid "This printer no longer exists."
msgstr "Questa stampante non esiste più."

# AI Translated
# Needs human review: Short date: day before month as Italian writes it (14 mar); check the month name is the abbreviated form
#. TRN A date in this year on a project card: %1% is the abbreviated month name, %2% the day of the month, as in "Oct 20".
#, boost-format
msgctxt "short date"
msgid "%1% %2%"
msgstr "%2% %1%"

# AI Translated
# Needs human review: Date with year: Italian writes 14 mar 2026 without a comma; check how %1% looks at runtime
#. TRN A date outside this year on a project card: %1% is the date without the year, as in "Oct 20", %2% the year.
#, boost-format
msgctxt "date with year"
msgid "%1%, %2%"
msgstr "%1% %2%"

# AI Translated
msgid "G-code exported"
msgstr "G-code esportato"

# AI Translated
#. TRN A project's status: %1% is a date, as in "Nov 3".
#, boost-format
msgid "G-code exported %1%"
msgstr "G-code esportato il %1%"

# AI Translated
#. TRN A project's status: %1% is a printer model, as in "Ender-3 V3 KE".
#, boost-format
msgid "G-code exported for %1%"
msgstr "G-code esportato per %1%"

# AI Translated
#. TRN A project's status: %1% is a date, as in "Nov 3", %2% a printer model, as in "Ender-3 V3 KE".
#, boost-format
msgid "G-code exported %1% for %2%"
msgstr "G-code esportato il %1% per %2%"

# AI Translated
msgctxt "project status"
msgid "Printed"
msgstr "Stampato"

# AI Translated
#. TRN A project's status: %1% is a date, as in "Oct 20".
#, boost-format
msgid "Printed %1%"
msgstr "Stampato il %1%"

# AI Translated
msgctxt "project status"
msgid "Sent"
