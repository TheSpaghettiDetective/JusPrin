edits {\n  account: CreditAccount | null;\n  // \"About 5 Expert messages left\" is said once: it stands until the person\n  // sends a message past it.\n  lowNoticeSeen: (notice: string) => boolean;\n  onLowNoticeSeen: (notice: string) => void;\n  onGetMore: () => void;\n  onSeeUsage: () => void;\n  // A new chat on that model, with these words in its box.\n  onNewChat: (choice: ChatModelChoice, text: string) => void;\n}\n\ninterface Props {\n  disabled: boolean;\n\n  const hasSendable = attachments.some((a) => a.state === 'staged');\n  const chosenModel = models && chatModel ? findModel(models, chatModel) : undefined;\n  const account = credits?.account;\n  const block = sendBlock(account, chosenModel);\n  const canSend = (!!text.trim() || hasSendable) && !disabled && !streaming && !block;\n  const newChatOn = (tier: Tier) => {\n    const choice = aliasOfTier(models, tier);\n    if (choice) credits?.onNewChat(choice, text);\n  };\n  // A picture a model without eyes would never see.\n  const blind = chosenModel?.images === false;\n  const low = lowNotice(account, chosenModel);\n  const lowShown = !!low && !block && !credits?.lowNoticeSeen(low);\n  const expertPrice = tierPrice(models, 'expert');\n  const ring = account && chosenModel?.credits !== undefined && expertPrice !== undefined && showsRing(account);\n\n  const send = () => {\n    if (!canSend) return;\n    if (lowShown) credits?.onLowNoticeSeen(low!);\n    if (draftTimer.current !== null) clearTimeout(draftTimer.current);\n    pendingDraft.current = false;\n    onSend(text.trim());\n    >\n      {notice}\n      {block && <div className=\"composer-credits\" role=\"status\">\n        <span>{block.sentence}</span>\n        <div className=\"composer-credits-actions\">\n          <button type=\"button\" className=\"link\" onClick={() => credits?.onGetMore()}>Get more credits</button>\n          {block.offerStandardChat && <button type=\"button\" className=\"link\" onClick={() => newChatOn('basic')}>New Standard chat</button>}\n        </div>\n      </div>}\n      {lowShown && <div className=\"composer-credits\" role=\"status\"><span>{low}</span></div>}\n      <div className=\"composer-box\">\n        {attachments.length > 0 && (\n          <div className=\"composer-attachments\" aria-label=\"Staged attachments\">\n            {attachments.map((attachment) => (\n              <AttachmentChip key={attachment.id} attachment={attachment} onRemove={onRemoveAttachment}\n                onNewExpertChat={blind && attachment.kind === 'image' && attachment.state === 'staged'\n                  ? () => newChatOn('expert') : undefined} />\n            ))}\n          </div>\n        )}\n        <textarea\n            {models && chatModel && onChooseModel && (\n              <ModelPickers catalog={models} choice={chatModel} disabled={disabled || streaming}\n                locked={started} account={account} onChoose={onChooseModel} />\n            )}\n            {ring && <BalancePanel account={account!} expertPrice={expertPrice!} low={!!low}\n              onGetMore={credits!.onGetMore} onSeeUsage={credits!.onSeeUsage} />}\n          </div>\n          {streaming ? (\n            <button type=\"button\" className=\"composer-send composer-stop\" onClick={onStop} aria-label=\"Stop generating\">\n---ML\n  // Save preset on a proposal card, by the preview's action id.\n  onSaveProposal?: (actionId: string) => void;\n  // Undo on a saved preset's receipt, by the receipt note's id.\n  onUndoReceipt?: (messageId: string) => void;\n  // The actions on a message the gateway refused for want of credits.\n  creditActions?: { onGetMore: () => void; onNewStandardChat: () => void };\n  // Sends a reply chip's text as the person's message.\n  onSend: (text: string) => void;\n  replyDisabled?: boolean;\n          {after}\n          {message.state === 'failed' && message.error && (\n            <div className=\"message-failure\">\n              <div className=\"error\">{message.error.message}</div>\n  