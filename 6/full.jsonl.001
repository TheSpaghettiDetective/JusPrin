failure: {what}, status {status}, request id {request_id}, '"}]},"uuid":"0ce75b92-3224-4bbc-8fef-5412d19f08c1","timestamp":"2026-11-02T16:10:38.799Z","toolUseResult":{"type":"text","file":{"filePath":"/Users/kenneth/Projects/tsd-enterprise/web_ent/jusprin/v2/gateway.py","content":"    None).\"\"\"\n\n    def __init__(self, fmt, upstream: UpstreamRequest, user_id, turn_id, request_kind, keep_key=None,\n                 chat_id=None):\n        self.fmt = fmt\n        self.upstream = upstream\n        self.user_id = user_id\n        self.turn_id = turn_id\n        self.request_kind = request_kind\n        self.keep_key = keep_key\n        self.chat_id = chat_id\n        self.rewriter = EventRewriter(fmt, upstream.alias.id)\n        self.outcome = 'started'\n        # The reply's upstream event payloads, as sent, while it is kept.\n        self.events = []\n        self.events_bytes = 0\n        self.truncated = False\n\n    async def relay(self, send):\n        try:\n            await self._relay(send)\n        finally:\n            self._log()\n\n    async def keep(self):\n        \"\"\"Keeps a completed reply, after its last byte has gone to the client.\n        A failure to keep a chat must not fail a reply the person already has:\n        it is reported and dropped, the one error this gateway swallows.\"\"\"\n        if self.keep_key is None or self.outcome != 'completed':\n            return\n        try:\n            await asyncio.to_thread(self._keep_sync)\n        except Exception:\n            sentry_sdk.capture_exception()\n            logger.exception('JusPrin v2 could not keep a chat request')\n\n    def _keep_sync(self):\n        alias = self.upstream.alias\n        capture.keep(self.user_id, self.keep_key, self.fmt, {\n            'schema': 1,\n            'user_id': self.user_id,\n            'chat_id': self.chat_id,\n            'turn_id': self.turn_id,\n            'alias': alias.id,\n            'format': self.fmt,\n            'upstream_model': self.upstream.backend.model,\n            'ab_group': alias.group_for(self.user_id).name,\n            'effort': self.upstream.effort,\n            'usage': self.rewriter.usage,\n            'request': json.loads(self.upstream.body),\n            'events': [json.loads(data) for data in self.events],\n            'truncated': self.truncated,\n        })\n\n    def _collect(self, event):\n        data = '\\n'.join(line[5:].removeprefix(' ') for line in event if line.startswith('data:'))\n        if not data or self.truncated:\n            return\n        self.events_bytes += len(data)\n        if self.events_bytes > settings.JUSPRIN_V2_CAPTURE_MAX_REPLY_BYTES:\n            self.truncated = True\n            return\n        self.events.append(data)\n\n    async def _relay(self, send):\n        client = upstream_client()\n        request = client.build_request('POST', self.upstream.url, headers=self.upstream.headers,\n                                       content=self.upstream.body)\n        try:\n            response = await client.send(request, stream=True)\n        except httpx.TimeoutException:\n            self._upstream_failed('timeout before response', None, None)\n            await _send_error(send, GatewayError(504, 'timeout'))\n            return\n        except httpx.TransportError as e:\n            self._upstream_failed(f'transport error {type(e).__name__}', None, None)\n            await _send_error(send, GatewayError(503, 'unavailable'))\n            return\n        try:\n            if response.status_code != 200:\n                self._upstream_failed('status', response.status_code, _request_id(response))\n                await _send_error(send, error_for_status(response.status_code))\n                return\n            await send({'type': 'http.response.start', 'status': 200, 'headers': [\n                (b'content-type', b'text/event-stream'),\n                (b'cache-control', b'no-store'),\n            ]})\n            self.outcome = 'streaming'\n            try:\n                async for event in sse_events(response.aiter_lines()):\n                    if self.keep_key is not None:\n                        self._collect(event)\n                    await send({'type': 'http.response.body', 'body': self.rewriter.rewrite(event),\n                                'more_body': True})\n                self.outcome = 'completed'\n            except httpx.TimeoutException:\n                self._upstream_failed('timeout mid-stream', 200, _request_id(response))\n                await send({'type': 'http.response.body', 'more_body': True,\n                            'body': gateway_error_event(self.fmt, 'timeout', STREAM_ERROR_MESSAGE)})\n            except httpx.TransportError as e:\n                self._upstream_failed(f'mid-stream {type(e).__name__}', 200, _request_id(response))\n                await send({'type': 'http.response.body', 'more_body': True,\n                            'body': gateway_error_event(self.fmt, 'upstream_error', STREAM_ERROR_MESSAGE)})\n            await send({'type': 'http.response.body', 'body': b'', 'more_body': False})\n        finally:\n            await response.aclose()\n\n    def _upstream_failed(self, what, status, request_id):\n        \"\"\"Status and request id only: an upstream body can echo the prompt.\"\"\"\n        self.outcome = f'upstream {what} {status or \"\"}'.strip()\n        backend = self.upstream.backend\n        text = (f'JusPrin v2 upstream failure: {what}, status {status}, request id {request_id}, '","numLines":112,"startLine":196,"totalLines":403}},"sourceToolAssistantUUID":"a6ec75fb-ce11-419f-bb3b-bda29a88ac0f","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"userType":"external","entrypoint":"claude-desktop","cwd":"/Users/kenneth/.claude/projects/-Users-kenneth-Projects-JusPrin","sessionId":"f57d8b7e-fd5a-4daf-9378-2e3d21342f7c","version":"2.1.309","gitBranch":"jusprin-newui","slug":"temporal-enchanting-muffin"}
