erInstructions.ts AgentUI/src/visual/yes-turn.ts Workspace/LoadFacts.cpp Agent/AgentHost.cpp ../../../../tests/agent/test_tool_coordinator.cpp ../../../../tests/agent/test_cloud_account.cpp ../../../../tests/agent/test_agent_bridge.cpp AgentUI/src/PreferencesApp.test.tsx AgentUI/src/WelcomeApp.test.tsx HomeUI/src/App.test.tsx | cut -c1-200; grep -n \"credit\\|Credit\\|subscription\\|Alert\" AgentUI/src/components/Preferences*.tsx AgentUI/src/PreferencesApp.tsx 2>/dev/null | cut -c1-170 | head -30; sed -n 125,145p AgentUI/src/components/WelcomeBack.tsx","description":"Read the composer, message list and test references","timeout":15000},"caller":{"type":"direct"}}]}}
{"type":"api-request-blob","sessionId":"f57d8b7e-fd5a-4daf-9378-2e3d21342f7c","hash":"0e4b3fea6751b0ca5d5a704f8277c52d34d4e85ba28d630917ec6b1db46cd688","message":{"role":"user","content":[{"tool_use_id":"toolu_01Df32yeyA8Hu2LPcVQpziRn","type":"tool_result","content":"45\t  return `Each message you send in this chat costs ${creditCount(model.credits)}.`;\n46\t}\n47\t\n48\tconst TIER_NAMES: Record<string, string> = { basic: 'Standard', expert: 'Expert' };\n49\t\n50\texport interface SendBlock {\n51\t  sentence: string;\n52\t  // Free Standard messages are left that this chat's model cannot spend.\n53\t  offerStandardChat: boolean;\n54\t}\n55\t\n56\t// Why the next message of this chat cannot be paid, or nothing when it can.\n57\texport function sendBlock(account: CreditAccount | null | undefined, model: ModelOptionInfo | undefined): SendBlock | undefined {\n58\t  if (!account || !model || model.credits === undefined || !model.tier) return undefined;\n59\t  if (model.tier === 'basic' && basicFreeOnPlan(account)) return undefined;\n60\t  const available = spendable(account, model.tier);\n61\t  if (available >= model.credits) return undefined;\n62\t  const name = TIER_NAMES[model.tier] ?? model.label;\n63\t  // Under 5 there is no point in a new Standard chat: it would run out within\n64\t  // a few messages.\n65\t  if (model.tier === 'expert' && basicOnlyCredits(account) >= 5)\n66\t    return { sentence: `This ${name} chat needs ${creditCount(model.credits)} a message. Your free Standard messages can only pay for Standard.`,\n67\t      offerStandardChat: true };\n68\t  return { sentence: `You have ${creditCount(available)}; this ${name} chat needs ${model.credits} a message.`, offerStandardChat: false };\n69\t}\n70\t\n71\t// \"About 5 Expert messages left\", once the balance is under one session's\n72\t// worth of the chat's model. A session of about five messages is the design's\n73\t// placeholder (from four harness sessions, not from engaged use).\n74\tconst LOW_MESSAGES = 5;\n75\t\n76\texport function lowNotice(account: CreditAccount | null | undefined, model: ModelOptionInfo | undefined): string | undefined {\n77\t  if (!account || !model || model.credits === undefined || !model.tier) return undefined;\n78\t  if (model.tier === 'basic' && basicFree(account)) return undefined;\n79\t  const messages = Math.floor(spendable(account, model.tier) / model.credits);\n80\t  if (messages < 1 || messages > LOW_MESSAGES) return undefined;\n81\t  return `About ${plural(messages, `${TIER_NAMES[model.tier] ?? model.label} message`, `${TIER_NAMES[model.tier] ?? model.label} messages`)} left`;\n82\t}\n83\t\n84\texport function aliasOfTier(catalog: ModelCatalogPayload | undefined, tier: Tier): ChatModelChoice | undefined {\n85\t  for (const provider of catalog?.providers ?? [])\n86\t    for (const model of provider.models)\n87\t      if (model.tier === tier)\n88\t        return { provider: provider.id, model: model.id, effort: model.defaultEffort ?? '' };\n89\t  return undefined;\n90\t}\n91\t\n92\texport function tierPrice(catalog: ModelCatalogPayload | undefined, tier: Tier): number | undefined {\n93\t  for (const provider of catalog?.providers ?? [])\n94\t    for (const model of provider.models)\n95\t      if (model.tier === tier && model.credits !== undefined)\n96\t        return model.credits;\n97\t  return undefined;\n98\t}\n99\t"},{"tool_use_id":"toolu_017d8ytaVvXbw7VcqaQAaFrp","type":"tool_result","content":"1\t// The composer's credits ring and the panel it opens (board 2a on the \"JusPrin\n2\t// v2\" canvas): a small ring of what is left, no number and no animation;\n3\t// hovering or tapping opens the total, translated into messages, then a bar per\n4\t// kind of credit that expires, soonest first. Credits that never expire have no\n5\t// limit to measure against, so they are a plain number.\n6\t//\n7\t// What the ring measures against is open (plan decision 13): the sum of what\n8\t// each lot started with, the board's placeholder.\n9\t\n10\timport { useEffect, useRef, useState } from 'react';\n11\timport { CreditAccount, CreditLot } from '../bridge/protocol';\n12\timport { basicOnlyCredits, creditCount, spendable } from '../credits';\n13\t\n14\tconst RING = 16;\n15\tconst STROKE = 3;\n16\t\n17\tfunction shortDate(iso: string): string {\n18\t  return new Date(iso).toLocaleDateString('en-GB', { day: 'numeric', month: 'short' });\n19\t}\n20\t\n21\tfunction lotName(lot: CreditLot, account: CreditAccount): string {\n22\t  switch (lot.kind) {\n23\t    case 'signup': return 'First-month credits';\n24\t    case 'trickle': return 'Free Standard messages';\n25\t    case 'subscription': return `${account.plan?.name ?? 'Plan'} credits`;\n26\t    case 'pack': return 'Bought credits';\n27\t    // What to call a reward is open (plan decision 13).\n28\t    case 'reward': return 'Report credits';\n29\t    default: return 'Credits';\n30\t  }\n31\t}\n32\t\n33\tinterface Row { key: string; name: string; left: number; of?: number; date: string }\n34\t\n35\tfunction rows(account: CreditAccount): Row[] {\n36\t  const expiring: (Row & { at: string })[] = [];\n37\t  const never = new Map<string, number>();\n38\t  for (const lot of account.credits.lots) {\n39\t    if (lot.expires_at) {\n40\t      expiring.push({ key: `${lot.kind}-${lot.expires_at}`, name: lotName(lot, account), left: lot.credits, of: lot.granted, at: lot.expires_at,\n41\t        date: `${lot.kind === 'trickle' ? 'Resets' : 'Expires'} ${shortDate(lot.expires_at)}` });\n42\t    } else if (lot.credits > 0) {\n43\t      const name = lotName(lot, account);\n44\t      never.set(name, (never.get(name) ?? 0) + lot.credits);\n45\t    }\n46\t  }\n47\t  const { plan } = account;\n48\t  if (plan?.unlimited_basic && plan.basic_fair_use && plan.renews_at) {\n49\t    const left = Math.max(plan.basic_fair_use - (plan.basic_used_this_term ?? 0), 0);\n50\t    expiring.push({ key: 'fair-use', name: 'Free Standard messages', left, of: plan.basic_fair_use, at: plan.renews_at,\n51\t      date: `Resets ${shortDate(plan.renews_at)}. After ${plan.basic_fair_use}, Standard is 1 credit a message until then.` });\n52\t  }\n53\t  expiring.sort((a, b) => a.at.localeCompare(b.at));\n54\t  return [...expiring, ...[...never].map(([name, left]) => ({ key: name, name, left, date: 'Never expire' }))];\n55\t}\n56\t\n57\t// The ring's share: what is left of what the lots started with.\n58\texport function ringShare(account: CreditAccount): number {\n59\t  const started = account.credits.lots.reduce((sum, lot) => sum + lot.granted, 0);\n60\t  return started > 0 ? Math.min(account.credits.total / started, 1) : 0;\n61\t}\n62\t\n63\tfunction Ring({ share, low }: { share: number; low: boolean }) {\n64\t  const radius = (RING - STROKE) / 2;\n65\t  const circumference = 2 * Math.PI * radius;\n66\t  return <svg className={low ? 'credit-ring credit-ring--low' : 'credit-ring'} viewBox={`0 0 ${RING} ${RING}`} aria-hidden=\"true\">\n67\t    <circle className=\"credit-ring-track\" cx={RING / 2} cy={RING / 2} r={radius} fill=\"none\" strokeWidth={STROKE} />\n68\t    <circle className=\"credit-ring-fill\" cx={RING / 2} cy={RING / 2} r={radius} fill=\"none\" strokeWidth={STROKE}\n69\t      strokeDasharray={`${share * circumference} ${circumference}`} transform={`rotate(-90 ${RING / 2} ${RING / 2})`} />\n70\t  </svg>;\n71\t}\n72\t\n73\texport function BalancePanel({ account, expertPrice, low, onGetMore, onSeeUsage }: {\n74\t  account: CreditAccount;\n75\t  expertPrice: number;\n76\t  low: boolean;\n77\t  onGetMore: () => void;\n78\t  onSeeUsage: () => void;\n79\t}) {\n80\t  const [open, setOpen] = useState(false);\n81\t  const closing = useRef<ReturnType<typeof setTimeout> | null>(null);\n82\t  useEffect(() => () => { if (closing.current !== null) clearTimeout(closing.current); }, []);\n83\t  const keepOpen = () => {\n84\t    if (closing.current !== null) clearTimeout(closing.current);\n85\t    closing.current = null;\n86\t    setOpen(true);\n87\t  };\n88\t  // The pointer crosses a gap on its way from the ring to the panel's actions.\n89\t  const closeSoon = () => { closing.current = setTimeout(() => setOpen(false), 200); };\n90\t\n91\t  const total = account.credits.total;\n92\t  const expert = Math.floor(spendable(account, 'expert') / expertPrice);\n93\t  return <div className=\"credit-balance\" onMouseEnter={keepOpen} onMouseLeave={closeSoon}\n94\t    onKeyDown={(event) => { if (event.key === 'Escape') setOpen(false); }}>\n95\t    <button type=\"button\" className=\"credit-ring-button\" aria-label=\"Credits left\" aria-expanded={open}\n96\t      onClick={keepOpen}>\n97\t      <Ring share={ringShare(account)} low={low} />\n98\t    </button>\n99\t    {open && <div className=\"credit-panel\" role=\"dialog\" aria-label=\"Credits\">\n100\t      <div className=\"credit-panel-total\">\n101\t        <strong>{creditCount(total)} left</strong>\n102\t        <span>That is {total} Standard or {expert} Expert {expert === 1 ? 'message' : 'messages'}.</span>\n103\t      </div>\n104\t      <div className=\"credit-panel-lots\">\n105\t        {rows(account).map((row) => <div key={row.key} className=\"credit-lot\">\n106\t          <div className=\"credit-lot-line\">\n107\t            <strong>{row.name}</strong>\n108\t            <span>{row.of === undefined ? `${row.left} left` : `${row.left} of ${row.of} left`}</span>\n109\t          </div>\n110\t          {row.of !== undefined && <div className=\"credit-lot-bar\">\n111\t            <div className=\"credit-lot-fill\" style={{ width: `${row.of > 0 ? Math.min(row.left / row.of, 1) * 100 : 0}%` }} />\n112\t          </div>}\n113\t          <span className=\"credit-lot-date\">{row.date}</span>\n114\t        </div>)}\n115\t        <p className=\"credit-panel-rule\">Expiring credits are used first.</p>\n116\t      </div>\n117\t      <div className=\"credit-panel-actions\">\n118\t        <button type=\"button\" className=\"link\" onClick={onGetMore}>Get more credits</button>\n119\t        <button type=\"button\" className=\"link\" onClick={onSeeUsage}>See usage</button>\n120\t      </div>\n121\t    </div>}\n122\t  </div>;\n123\t}\n124\t\n125\t// A person with only free Standard messages has no balance on the toolbar\n126\t// (boards 3d and 6a); the message box says what is there instead.\n127\texport function showsRing(account: CreditAccount): boolean {\n128\t  return account.credits.total > basicOnlyCredits(account);\n129\t}\n130\t"},{"tool_use_id":"toolu_014Br59TqiNDBpaPKsWU7FAe","type":"tool_result","content":"1\t// The credits ring and the panel it opens: the translated total, a bar per kind\n2\t// of credit that expires, soonest first, and the plain number for credits that\n3\t// never do (board 2a).\n4\t\n5\timport { cleanup, render, screen } from '@testing-library/react';\n6\timport userEvent from '@testing-library/user-event';\n7\timport { afterEach, describe, expect, it, vi } from 'vitest';\n8\timport { CreditAccount } from '../bridge/protocol';\n9\timport { BalancePanel, ringShare, showsRing } from './BalancePanel';\n10\t\n11\tafterEach(cleanup);\n12\t\n13\tconst board2a: CreditAccount = {\n14\t  credits: {\n15\t    total: 612,\n16\t    lots: [\n17\t      { kind: 'pack', credits: 500, granted: 500, expires_at: null },\n18\t      { kind: 'trickle', credits: 50, granted: 50, expires_at: '2026-12-01T12:00:00+00:00', basic_only: true },\n19\t      { kind: 'signup', credits: 62, granted: 500, expires_at: '2026-11-30T12:00:00+00:00' },\n20\t    ],\n21\t  },\n22\t  plan: null,\n23\t  v1_subscription: null,\n24\t};\n25\t\n26\tfunction open(account: CreditAccount, onGetMore = vi.fn(), onSeeUsage = vi.fn()) {\n27\t  render(<BalancePanel account={account} expertPrice={5} low={false} onGetMore={onGetMore} onSeeUsage={onSeeUsage} />);\n28\t  return userEvent.click(screen.getByRole('button', { name: 'Credits left' }));\n29\t}\n30\t\n31\tdescribe('the balance panel', () => {\n32\t  it('shows no number until it is opened', () => {\n33\t    render(<BalancePanel account={board2a} expertPrice={5} low={false} onGetMore={vi.fn()} onSeeUsage={vi.fn()} />);\n34\t    expect(screen.getByRole('button', { name: 'Credits left' })).toHaveTextContent('');\n35\t    expect(screen.queryByText(/credits left/)).toBeNull();\n36\t  });\n37\t\n38\t  it('translates the total, leaving free Standard messages out of the Expert count', async () => {\n39\t    await open(board2a);\n40\t    expect(screen.getByText('612 credits left')).toBeTruthy();\n41\t    expect(screen.getByText('That is 612 Standard or 112 Expert messages.')).toBeTruthy();\n42\t  });\n43\t\n44\t  it('lists what expires soonest first and never-expiring credits as a plain number', async () => {\n45\t    await open(board2a);\n46\t    const rows = [...document.querySelectorAll('.credit-lot')].map((row) => row.textContent);\n47\t    expect(rows).toEqual([\n48\t      'First-month credits62 of 500 leftExpires 30 Nov',\n49\t      'Free Standard messages50 of 50 leftResets 1 Dec',\n50\t      'Bought credits500 leftNever expire',\n51\t    ]);\n52\t    expect(document.querySelectorAll('.credit-lot-bar')).toHaveLength(2);\n53\t    expect(screen.getByText('Expiring credits are used first.')).toBeTruthy();\n54\t  });\n55\t\n56\t  it('offers Get more credits and See usage', async () => {\n57\t    const onGetMore = vi.fn();\n58\t    const onSeeUsage = vi.fn();\n59\t    await open(board2a, onGetMore, onSeeUsage);\n60\t    await userEvent.click(screen.getByRole('button', { name: 'Get more credits' }));\n61\t    await userEvent.click(screen.getByRole('button', { name: 'See usage' }));\n62\t    expect(onGetMore).toHaveBeenCalledOnce();\n63\t    expect(onSeeUsage).toHaveBeenCalledOnce();\n64\t  });\n65\t\n66\t  it('shows Workshop’s fair-use count as one more bar', async () => {\n67\t    await open({\n68\t      credits: { total: 1500, lots: [{ kind: 'subscription', credits: 1500, granted: 1500, expires_at: '2026-12-01T12:00:00+00:00' }] },\n69\t      plan: { id: 'workshop', name: 'Workshop', renews_at: '2026-12-01T12:00:00+00:00', unlimited_basic: true,\n70\t        basic_used_this_term: 412, basic_fair_use: 600 },\n71\t      v1_subscription: null,\n72\t    });\n73\t    expect(screen.getByText('Workshop credits')).toBeTruthy();\n74\t    expect(screen.getByText('188 of 600 left')).toBeTruthy();\n75\t    expect(screen.getByText('Resets 1 Dec. After 600, Standard is 1 credit a message until then.')).toBeTruthy();\n76\t  });\n77\t\n78\t  it('measures the ring against what the lots started with', () => {\n79\t    expect(ringShare(board2a)).toBeCloseTo(612 / 1050);\n80\t  });\n81\t\n82\t  it('is left off when only free Standard messages remain', () => {\n83\t    expect(showsRing(board2a)).toBe(true);\n84\t    expect(showsRing({ ...board2a, credits: { total: 50, lots: [board2a.credits.lots[1]] } })).toBe(false);\n85\t  });\n86\t});\n87\t"},{"tool_use_id":"toolu_01FDCm9b6RYxuPV7EaaRCM1d","type":"tool_result","content":"1\t// The message box with an account: prices in the model menu, greyed pickers once\n2\t// the person has sent a message, Send held back when the next message cannot be\n3\t// paid, and a picture a Standard chat would not send (boards 2b, 2c, 3a, 3b, 3d, 3e).\n4\t\n5\timport { cleanup, render, screen } from '@testing-library/react';\n6\timport userEvent from '@testing-library/user-event';\n7\timport { afterEach, describe, expect, it, vi } from 'vitest';\n8\timport { AttachmentInfo, ChatModelChoice, CreditAccount, ModelCatalogPayload } from '../bridge/protocol';\n9\timport { messageCostSentence, priceWords, sendBlock } from '../credits';\n10\timport { Composer, ComposerCredits } from './Composer';\n11\timport { modelMenu } from './ModelPickers';\n12\t\n13\tafterEach(cleanup);\n14\t\n15\tconst standard = { id: 'slicer-basic', label: 'Standard', efforts: ['fast', 'thorough'], defaultEffort: 'fast', tier: 'basic', credits: 1, images: false };\n16\tconst expert = { id: 'slicer-1', label: 'Expert', efforts: ['fast', 'thorough'], defaultEffort: 'thorough', tier: 'expert', credits: 5 };\n17\tconst own = { id: 'gpt-5.4', label: 'gpt-5.4', efforts: [] };\n18\tconst catalog: ModelCatalogPayload = {\n19\t  defaultProvider: 'jusprin',\n20\t  providers: [\n21\t    { id: 'jusprin', label: 'JusPrin', defaultModel: 'slicer-1', state: 'ready', models: [standard, expert] },\n22\t    { id: 'openai', label: 'OpenAI', defaultModel: 'gpt-5.4', state: 'ready', models: [own] },\n23\t  ],\n24\t};\n25\tconst onExpert: ChatModelChoice = { provider: 'jusprin', model: 'slicer-1', effort: 'thorough' };\n26\tconst onStandard: ChatModelChoice = { provider: 'jusprin', model: 'slicer-basic', effort: 'fast' };\n27\tconst onOwn: ChatModelChoice = { provider: 'openai', model: 'gpt-5.4', effort: '' };\n28\t\n29\tconst lot = (kind: string, credits: number, basicOnly = false) => ({\n30\t  kind, credits, granted: credits, expires_at: '2026-12-01T12:00:00+00:00', ...(basicOnly ? { basic_only: true } : {}),\n31\t});\n32\tconst balance = (...lots: ReturnType<typeof lot>[]): CreditAccount => ({\n33\t  credits: { total: lots.reduce((sum, one) => sum + one.credits, 0), lots },\n34\t  plan: null,\n35\t  v1_subscription: null,\n36\t});\n37\t\n38\tfunction credits(account: CreditAccount | null, extra: Partial<ComposerCredits> = {}): ComposerCredits {\n39\t  return { account, lowNoticeSeen: () => false, onLowNoticeSeen: vi.fn(), onGetMore: vi.fn(), onSeeUsage: vi.fn(), onNewChat: vi.fn(), ...extra };\n40\t}\n41\t\n42\tfunction renderComposer(props: {\n43\t  account?: CreditAccount | null; choice?: ChatModelChoice; started?: boolean; text?: string;\n44\t  attachments?: AttachmentInfo[]; composerCredits?: ComposerCredits; onSend?: (text: string) => void;\n45\t}) {\n46\t  render(<Composer disabled={false} streaming={false} attachments={props.attachments ?? []} initialText={props.text}\n47\t    started={props.started} onSend={props.onSend ?? vi.fn()} onStop={vi.fn()} onAttachFiles={vi.fn()} onRemoveAttachment={vi.fn()}\n48\t    models={catalog} chatModel={props.choice ?? onExpert} onChooseModel={vi.fn()}\n49\t    credits={props.composerCredits ?? credits(props.account ?? balance(lot('signup', 500)))} />);\n50\t}\n51\t\n52\tconst send = () => screen.getByRole('button', { name: 'Send message' });\n53\t\n54\tdescribe('prices', () => {\n55\t  it('always carry \"a message\", and only on the account’s models', () => {\n56\t    const entries = modelMenu(catalog, onExpert, vi.fn(), balance(lot('signup', 500)));\n57\t    expect(entries.flatMap((entry) => ('section' in entry ? [] : [[entry.label, entry.detail]]))).toEqual([\n58\t      ['Standard · 1 credit a message', 'setting up an ordinary print'],\n59\t      ['Expert · 5 credits a message', 'troubleshooting, tricky models, anything you’d ask a person'],\n60\t      ['gpt-5.4', undefined],\n61\t    ]);\n62\t  });\n63\t\n64\t  it('read \"free this month\" while free Standard messages last', () => {\n65\t    const account = balance(lot('trickle', 50, true));\n66\t    expect(priceWords(standard, account)).toBe('free this month');\n67\t    expect(priceWords(expert, account)).toBe('5 credits a message');\n68\t    expect(messageCostSentence(standard, account)).toBe('Each message you send in this chat is free this month.');\n69\t    expect(messageCostSentence(expert, account)).toBe('Each message you send in this chat costs 5 credits.');\n70\t    expect(messageCostSentence(own, account)).toBeUndefined();\n71\t  });\n72\t});\n73\t\n74\tdescribe('the pickers', () => {\n75\t  it('work until the person sends a message', () => {\n76\t    renderComposer({});\n77\t    expect(screen.getByRole('button', { name: /^Model/ })).toBeEnabled();\n78\t    expect(screen.queryByRole('tooltip', { hidden: true })).toBeNull();\n79\t  });\n80\t\n81\t  it('are greyed afterwards and say why and what a message costs', () => {\n82\t    renderComposer({ started: true });\n83\t    expect(screen.getByRole('button', { name: /^Model/ })).toBeDisabled();\n84\t    expect(screen.getByRole('button', { name: /^Thinking/ })).toBeDisabled();\n85\t    const tooltip = screen.getByRole('tooltip', { hidden: true });\n86\t    expect(tooltip).toHaveTextContent('A chat keeps the model and thinking level it started with. Start a new chat to change them.');\n87\t    expect(tooltip).toHaveTextContent('Each message you send in this chat costs 5 credits.');\n88\t  });\n89\t\n90\t  it('name no price on the person’s own key, and draw no ring', () => {\n91\t    renderComposer({ started: true, choice: onOwn });\n92\t    const tooltip = screen.getByRole('tooltip', { hidden: true });\n93\t    expect(tooltip).toHaveTextContent('A chat keeps the model');\n94\t    expect(tooltip).not.toHaveTextContent('credit');\n95\t    expect(screen.queryByRole('button', { name: 'Credits left' })).toBeNull();\n96\t  });\n97\t});\n98\t\n99\tdescribe('the check before sending', () => {\n100\t  it('leaves Send alone when the message can be paid', () => {\n101\t    renderComposer({ text: 'Hello', account: balance(lot('signup', 5)) });\n102\t    expect(send()).toBeEnabled();\n103\t    expect(screen.queryByRole('button', { name: 'Get more credits' })).toBeNull();\n104\t  });\n105\t\n106\t  it('disables Send, says why, offers one action and keeps the words', () => {\n107\t    const composerCredits = credits(balance(lot('pack', 3)));\n108\t    renderComposer({ text: 'The tip curled up', composerCredits });\n109\t    expect(send()).toBeDisabled();\n110\t    expect(screen.getByText('You have 3 credits; this Expert chat needs 5 a message.')).toBeTruthy();\n111\t    expect(screen.getByRole('button', { name: 'Get more credits' })).toBeTruthy();\n112\t    expect(screen.queryByRole('button', { name: 'New Standard chat' })).toBeNull();\n113\t    expect(screen.getByRole('textbox')).toHaveValue('The tip curled up');\n114\t  });\n115\t\n116\t  it('adds New Standard chat only when free Standard messages are what is left', async () => {\n117\t    const composerCredits = credits(balance(lot('trickle', 50, true)));\n118\t    renderComposer({ text: 'The tip curled up', composerCredits });\n119\t    expect(send()).toBeDisabled();\n120\t    expect(screen.getByText('This Expert chat needs 5 credits a message. Your free Standard messages can only pay for Standard.')).toBeTruthy();\n121\t    await userEvent.click(screen.getByRole('button', { name: 'New Standard chat' }));\n122\t    expect(composerCredits.onNewChat).toHaveBeenCalledWith(onStandard, 'The tip curled up');\n123\t  });\n124\t\n125\t  it('offers no New Standard chat under 5 credits', () => {\n126\t    expect(sendBlock(balance(lot('trickle', 4, true)), expert)).toEqual({\n127\t      sentence: 'You have 0 credits; this Expert chat needs 5 a message.', offerStandardChat: false });\n128\t  });\n129\t\n130\t  it('lets free Standard messages pay for a Standard chat', () => {\n131\t    expect(sendBlock(balance(lot('trickle', 4, true)), standard)).toBeUndefined();\n132\t  });\n133\t\n134\t  it('never blocks a model on the person’s own key', () => {\n135\t    expect(sendBlock(balance(), own)).toBeUndefined();\n136\t  });\n137\t\n138\t  it('says once that few messages are left, in the warning colour', async () => {\n139\t    const seen = new Set<string>();\n140\t    const composerCredits = credits(balance(lot('pack', 25)), {\n141\t      lowNoticeSeen: (notice) => seen.has(notice),\n142\t      onLowNoticeSeen: (notice) => { seen.add(notice); },\n143\t    });\n144\t    const onSend = vi.fn();\n145\t    renderComposer({ text: 'Hello', composerCredits, onSend });\n146\t    expect(screen.getByText('About 5 Expert messages left')).toBeTruthy();\n147\t    expect(document.querySelector('.credit-ring--low')).toBeTruthy();\n148\t    await userEvent.click(send());\n149\t    expect(onSend).toHaveBeenCalledWith('Hello');\n150\t    expect(seen.has('About 5 Expert messages left')).toBe(true);\n151\t  });\n152\t});\n153\t\n154\tdescribe('a picture in a Standard chat', () => {\n155\t  const picture: AttachmentInfo = { id: 'a1', name: 'curl.jpg', kind: 'image', mime: 'image/jpeg', sizeBytes: 2048, state: 'staged', summary: '' } as AttachmentInfo;\n156\t\n157\t  it('says it will not be sent, with New Expert chat beside Remove, and Send stays enabled', async () => {\n158\t    const composerCredits = credits(balance(lot('signup', 500)));\n159\t    renderComposer({ text: 'Why?', choice: onStandard, attachments: [picture], composerCredits });\n160\t    expect(screen.getByText('Standard can’t see pictures, so this one will not be sent.')).toBeTruthy();\n161\t    expect(screen.getByRole('button', { name: 'Remove curl.jpg' })).toBeTruthy();\n162\t    expect(send()).toBeEnabled();\n163\t    await userEvent.click(screen.getByRole('button', { name: 'New Expert chat' }));\n164\t    expect(composerCredits.onNewChat).toHaveBeenCalledWith(onExpert, 'Why?');\n165\t  });\n166\t\n167\t  it('says nothing in an Expert chat', () => {\n168\t    renderComposer({ text: 'Why?', attachments: [picture] });\n169\t    expect(screen.queryByText(/can’t see pictures/)).toBeNull();\n170\t    expect(screen.queryByRole('button', { name: 'New Expert chat' })).toBeNull();\n171\t  });\n172\t});\n173\t"},{"tool_use_id":"toolu_01DjSzNZ4vUXZ5gEScd1xYk3","type":"tool_result","content":"// pasting an image; staged attachments render as removable rows, and a\n// message may be sent with attachments and no text. The host owns decoding\n// and storage -- the composer only hands it files.\n//\n// With an account (the `credits` prop): the credits ring beside the pickers,\n// and Send disabled with one line above the box when the next message cannot\n// be paid (boards 2a, 3a, 3b, 3d, 3e).\n\nimport { ChangeEvent, ClipboardEvent, DragEvent, KeyboardEvent, ReactNode, useEffect, useLayoutEffect, useRef, useState } from 'react';\nimport { AttachmentInfo, AttachmentPickKind, AttachmentSource, ChatModelChoice, CreditAccount, ModelCatalogPayload } from '../bridge/protocol';\nimport { aliasOfTier, lowNotice, sendBlock, tierPrice, Tier } from '../credits';\n\nexport interface ComposerCredits {\n  account: CreditAccount | null;\n  // \"About 5 Expert messages left\" is said once: it stands until the person\n  // sends a message past it.\n  lowNoticeSeen: (notice: string) => boolean;\n  onLowNoticeSeen: (notice: string) => void;\n  onGetMore: () => void;\n  onSeeUsage: () => void;\n  // A new chat on that model, with these words in its box.\n  onNewChat: (choice: ChatModelChoice, text: string) => void;\n}\n\ninterface Props {\n  disabled: boolean;\n\n  const hasSendable = attachments.some((a) => a.state === 'staged');\n  const chosenModel = models && chatModel ? findModel(models, chatModel) : undefined;\n  const account = credits?.account;\n  const block = sendBlock(account, chosenModel);\n  const canSend = (!!text.trim() || hasSendable) && !disabled && !streaming && !block;\n  const newChatOn = (tier: Tier) => {\n    const choice = aliasOfTier(models, tier);\n    if (choice) credits?.onNewChat(choice, text);\n  };\n  // A picture a model without eyes would never see.\n  const blind = chosenModel?.images === false;\n  const low = lowNotice(account, chosenModel);\n  const lowShown = !!low && !block && !credits?.lowNoticeSeen(low);\n  const expertPrice = tierPrice(models, 'expert');\n  const ring = account && chosenModel?.credits !== undefined && expertPrice !== undefined && showsRing(account);\n\n  const send = () => {\n    if (!canSend) return;\n    if (lowShown) credits?.onLowNoticeSeen(low!);\n    if (draftTimer.current !== null) clearTimeout(draftTimer.current);\n    pendingDraft.current = false;\n    onSend(text.trim());\n    >\n      {notice}\n      {block && <div className=\"composer-credits\" role=\"status\">\n        <span>{block.sentence}</span>\n        <div className=\"composer-credits-actions\">\n          <button type=\"button\" className=\"link\" onClick={() => credits?.onGetMore()}>Get more credits</button>\n          {block.offerStandardChat && <button type=\"button\" className=\"link\" onClick={() => newChatOn('basic')}>New Standard chat</button>}\n        </div>\n      </div>}\n      {lowShown && <div className=\"composer-credits\" role=\"status\"><span>{low}</span></div>}\n      <div className=\"composer-box\">\n        {attachments.length > 0 && (\n          <div className=\"composer-attachments\" aria-label=\"Staged attachments\">\n            {attachments.map((attachment) => (\n              <AttachmentChip key={attachment.id} attachment={attachment} onRemove={onRemoveAttachment}\n                onNewExpertChat={blind && attachment.kind === 'image' && attachment.state === 'staged'\n                  ? () => newChatOn('expert') : undefined} />\n            ))}\n          </div>\n        )}\n        <textarea\n            {models && chatModel && onChooseModel && (\n              <ModelPickers catalog={models} choice={chatModel} disabled={disabled || streaming}\n                locked={started} account={account} onChoose={onChooseModel} />\n            )}\n            {ring && <BalancePanel account={account!} expertPrice={expertPrice!} low={!!low}\n              onGetMore={credits!.onGetMore} onSeeUsage={credits!.onSeeUsage} />}\n          </div>\n          {streaming ? (\n            <button type=\"button\" className=\"composer-send composer-stop\" onClick={onStop} aria-label=\"Stop generating\">\n---ML\n  // Save preset on a proposal card, by the preview's action id.\n  onSaveProposal?: (actionId: string) => void;\n  // Undo on a saved preset's receipt, by the receipt note's id.\n  onUndoReceipt?: (messageId: string) => void;\n  // The actions on a message the gateway refused for want of credits.\n  creditActions?: { onGetMore: () => void; onNewStandardChat: () => void };\n  // Sends a reply chip's text as the person's message.\n  onSend: (text: string) => void;\n  replyDisabled?: boolean;\n          {after}\n          {message.state === 'failed' && message.error && (\n            <div className=\"message-failure\">\n              <div className=\"error\">{message.error.message}</div>\n              {message.error.code === 'credits_exhausted' && creditActions && <>\n                <button className=\"primary\" onClick={creditActions.onGetMore}>Get more credits</button>\n                {/* Under 5 there is no point in a new Standard chat. */}\n                {(message.error.details?.basic_only_credits ?? 0) >= 5 &&\n                  <button className=\"secondary\" onClick={creditActions.onNewStandardChat}>New Standard chat</button>}\n              </>}\n              {message.error.retryable && !readOnly && (\n                <button className=\"primary\" onClick={() => onRetry(message.id)}>Retry</button>\n              )}\n            </div>\n          )}\n---chip\nAttachmentChip.tsx:12:  onNewExpertChat?: () => void;\nAttachmentChip.tsx:31:export function AttachmentChip({ attachment, onRemove, onNewExpertChat }: Props) {\nAttachmentChip.tsx:54:        {onRemove && !onNewExpertChat && (\nAttachmentChip.tsx:65:      {onNewExpertChat && <div className=\"attachment-not-sent\">\nAttachmentChip.tsx:68:          <button type=\"button\" className=\"link\" onClick={onNewExpertChat}>New Expert chat</button>\nComposer.credits.test.tsx:157:  it('says it will not be sent, with New Expert chat beside Remove, and Send stays enabled', async () => {\nComposer.credits.test.tsx:163:    await userEvent.click(screen.getByRole('button', { name: 'New Expert chat' }));\nComposer.credits.test.tsx:170:    expect(screen.queryByRole('button', { name: 'New Expert chat' })).toBeNull();\nComposer.tsx:215:  const blind = chosenModel?.images === false;\nComposer.tsx:299:                onNewExpertChat={blind && attachment.kind === 'image' && attachment.state === 'staged'\n---others\n../../../../tests/agent/test_cloud_account.cpp:555:                                      \"balance\":3,\"cost\":5,\"basic_only_credits\":49,\"affordable_aliases\":[\"slicer-basic\"],\"plan\":null})\");\n../../../../tests/agent/test_cloud_account.cpp:563:    CHECK(json::parse(event->error->details)[\"basic_only_credits\"] == 49);\nAgent/AgentHost.cpp:2169:    // \"New Standard chat\" and \"New Expert chat\": the new chat is on that model,\n../../../../tests/agent/test_agent_bridge.cpp:2452:                                                           R\"({\"balance\":3,\"cost\":5,\"basic_only_credits\":49})\"}));\n../../../../tests/agent/test_agent_bridge.cpp:2489:    CHECK((*failed)[\"payload\"][\"error\"][\"details\"][\"basic_only_credits\"] == 49);\nAgentUI/src/WelcomeApp.test.tsx:136:      expect(box).toHaveTextContent('750 credits a month: 750 Standard or 150 Expert messages.');\nHomeUI/src/App.test.tsx:473:    expect(screen.getByText('That is 500 Standard or 100 Expert messages. Your own API key stays free.')).toBeInTheDocument();\nAgentUI/src/PreferencesApp.test.tsx:119:    expect(screen.getByTestId('first-month-offer')).toHaveTextContent('That is 500 Standard or 100 Expert messages. Your own API key stays free.');\n      <button type=\"button\" className=\"secondary welcome-account-action\" onClick={actions.signIn}>Continue with JusPrin</button>\n    </div>\n  );\n}\n\n// Nothing to choose and no upgrade prompt: they stay on the price they pay.\nfunction KeptPrice({ subscription }: { subscription: NonNullable<CreditAccount['v1_subscription']> }) {\n  return (\n    <div className=\"credit-offer\" data-testid=\"welcome-kept-price\">\n      <div className=\"credit-offer-copy\">\n        <h2 className=\"credit-offer-title\">Hobby, at your original ${(subscription.cents / 100).toFixed(2)} a {subscription.period}</h2>\n        <p>750 credits a month: 750 Standard or 150 Expert messages.</p>\n        <p>Plus 500 more for your first month.</p>\n        <p>New subscribers pay $10. You keep this price while subscribed.</p>\n      </div>\n    </div>\n  );\n}\n\nexport function WelcomeBack({ report, account, status, actions, subscription, priceCarriesOver = V1_PRICE_CARRIES_OVER }: WelcomeBackProps) {\n  // The sign-in v1 left is checked once, when the window opens: it may have","is_error":false}]}}
