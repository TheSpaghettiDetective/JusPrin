le' ? 'Resets' : 'Expires'} ${shortDate(lot.expi\nsrc/slic3r/GUI/JusPrin/AgentUI/src/components/BalancePanel.tsx:48:  if (plan?.unlimited_basic && plan.basic_fair_use && plan.renews_at) {\nsrc/slic3r/GUI/JusPrin/AgentUI/src/components/BalancePanel.tsx:49:    const left = Math.max(plan.basic_fair_use - (plan.basic_used_this_term ?? 0), 0)\nsrc/slic3r/GUI/JusPrin/AgentUI/src/components/BalancePanel.tsx:50:    expiring.push({ key: 'fair-use', name: 'Free Standard messages', left, of: plan.\nsrc/slic3r/GUI/JusPrin/AgentUI/src/components/BalancePanel.tsx:51:      date: `Resets ${shortDate(plan.renews_at)}. After ${plan.basic_fair_use}, Stan\nsrc/slic3r/GUI/JusPrin/AgentUI/src/components/BalancePanel.tsx:102:        <span>That is {total} Standard or {expert} Expert {expert === 1 ? 'message'\nsrc/slic3r/GUI/JusPrin/AgentUI/src/components/BalancePanel.tsx:125:// A person with only free Standard messages has no balance on the toolbar\nsrc/slic3r/GUI/JusPrin/AgentUI/src/components/BalancePanel.tsx:128:  return account.credits.total > basicOnlyCredits(account);\nsrc/slic3r/GUI/JusPrin/AgentUI/src/credits.ts:14:// Free Standard messages only pay for Standard, so Expert leaves them out.\nsrc/slic3r/GUI/JusPrin/AgentUI/src/credits.ts:15:export function basicOnlyCredits(account: CreditAccount): number {\nsrc/slic3r/GUI/JusPrin/AgentUI/src/credits.ts:16:  return account.credits.lots.reduce((sum, lot) => sum + (lot.basic_only ? lot.credits : 0), 0);\nsrc/slic3r/GUI/JusPrin/AgentUI/src/credits.ts:20:  return tier === 'expert' ? account.credits.total - basicOnlyCredits(account) : account.credits.tota\nsrc/slic3r/GUI/JusPrin/AgentUI/src/credits.ts:23:// Workshop's Standard messages cost nothing up to the plan's fair-use count.\nsrc/slic3r/GUI/JusPrin/AgentUI/src/credits.ts:26:  return !!plan?.unlimited_basic && (plan.basic_used_this_term ?? 0) < (plan.basic_fair_use ?? 0);\nsrc/slic3r/GUI/JusPrin/AgentUI/src/credits.ts:32:  return !!account && (basicFreeOnPlan(account) || basicOnlyCredits(account) > 0);\nsrc/slic3r/GUI/JusPrin/AgentUI/src/credits.ts:52:  // Free Standard messages are left that this chat's model cannot spend.\nsrc/slic3r/GUI/JusPrin/AgentUI/src/credits.ts:65:  if (model.tier === 'expert' && basicOnlyCredits(account) >= 5)\nsrc/slic3r/GUI/JusPrin/AgentUI/src/credits.ts:66:    return { sentence: `This ${name} chat needs ${creditCount(model.credits)} a message. Your free St\nsrc/slic3r/GUI/JusPrin/AgentUI/src/credits.ts:71:// \"About 5 Expert messages left\", once the balance is under one session's\nsrc/slic3r/GUI/JusPrin/AgentUI/src/components/WelcomeBack.tsx:136:        <p>750 credits a month: 750 Standard or 150 Expert messages.</p>\nsrc/slic3r/GUI/JusPrin/AgentUI/src/components/Composer.credits.test.tsx:29:const lot = (kind: string, credits: number, basicOnly = false) => ({\nsrc/slic3r/GUI/JusPrin/AgentUI/src/components/Composer.credits.test.tsx:30:  kind, credits, granted: credits, expires_at: '2026-12-01T12:00:00+00:00',\nsrc/slic3r/GUI/JusPrin/AgentUI/src/components/Composer.credits.test.tsx:64:  it('read \"free this month\" while free Standard messages last', () => {\nsrc/slic3r/GUI/JusPrin/AgentUI/src/components/Composer.credits.test.tsx:65:    const account = balance(lot('trickle', 50, true));\nsrc/slic3r/GUI/JusPrin/AgentUI/src/components/Composer.credits.test.tsx:112:    expect(screen.queryByRole('button', { name: 'New Standard chat' })).to\nsrc/slic3r/GUI/JusPrin/AgentUI/src/components/Composer.credits.test.tsx:116:  it('adds New Standard chat only when free Standard messages are what is \nsrc/slic3r/GUI/JusPrin/AgentUI/src/components/Composer.credits.test.tsx:117:    const composerCredits = credits(balance(lot('trickle', 50, true)));\nsrc/slic3r/GUI/JusPrin/AgentUI/src/components/Composer.credits.test.tsx:120:    expect(screen.getByText('This Expert chat needs 5 credits a message. Y\nsrc/slic3r/GUI/JusPrin/AgentUI/src/components/Composer.credits.test.tsx:121:    await userEvent.click(screen.getByRole('button', { name: 'New Standard\nsrc/slic3r/GUI/JusPrin/AgentUI/src/components/Composer.credits.test.tsx:125:  it('offers no New Standard chat under 5 credits', () => {\nsrc/slic3r/GUI/JusPrin/AgentUI/src/components/Composer.credits.test.tsx:126:    expect(sendBlock(balance(lot('trickle', 4, true)), expert)).toEqual({\nsrc/slic3r/GUI/JusPrin/AgentUI/src/components/Composer.credits.test.tsx:130:  it('lets free Standard messages pay for a Standard chat', () => {\nsrc/slic3r/GUI/JusPrin/AgentUI/src/components/Composer.credits.test.tsx:131:    expect(sendBlock(balance(lot('trickle', 4, true)), standard)).toBeUnde\nsrc/slic3r/GUI/JusPrin/AgentUI/src/components/Composer.credits.test.tsx:146:    expect(screen.getByText('About 5 Expert messages left')).toBeTruthy();\nsrc/slic3r/GUI/JusPrin/AgentUI/src/components/Composer.credits.test.tsx:150:    expect(seen.has('About 5 Expert messages left')).toBe(true);\nsrc/slic3r/GUI/JusPrin/AgentUI/src/WelcomeApp.test.tsx:119:    host.deliver('account', account({ plan_id: 'jusprin-unlimited-monthly', cents: 699, per\nsrc/slic3r/GUI/JusPrin/AgentUI/src/WelcomeApp.test.tsx:133:      carriedOver({ plan_id: 'jusprin-unlimited-monthly', cents: 699, period: 'month' }, si\nsrc/slic3r/GUI/JusPrin/AgentUI/src/WelcomeApp.test.tsx:136:      expect(box).toHaveTextContent('750 credits a month: 750 Standard or 150 Expert messag\nsrc/slic3r/GUI/JusPrin/AgentUI/src/WelcomeApp.test.tsx:143:      carriedOver({ plan_id: 'jusprin-unlimited-annual', cents: 5999, period: 'year' }, sig\nsrc/slic3r/GUI/JusPrin/AgentUI/src/components/Composer.tsx:47:  // \"About 5 Expert messages left\" is said once: it stands until the person\nsrc/slic3r/GUI/JusPrin/AgentUI/src/components/Composer.tsx:290:          {block.offerStandardChat && <button type=\"button\" className=\"link\" onClick={(\n       0","is_error":false}]},"uuid":"f87ad2c2-190d-4114-a8d0-5cd053a5293c","timestamp":"2026-11-02T18:14:48.140Z","toolUseResult":{"stdout":"---\nname: credits-one-kind-no-ceiling\ndescription: \"Kenneth's 2026-11-02 evening pricing decisions - every credit is the same (no Standard-only lot), Workshop Standard costs 0 with no ceiling, balances in credits only with bars grouped by expiry, no New Standard chat\"\nmetadata:\n  node_type: memory\n  type: project\n  originSessionId: c790f253-5882-4425-8ee0-6201d35017ca\n  modified: 2026-11-02T17:24:22.538Z\n---\n\nOn 2026-11-02 evening, after seeing canvas version 73, Kenneth corrected the credits design in four ways:\n\n- Every credit is the same. No Standard-only (\"basic_only\", \"trickle\") lot. Free accounts (not subscribed) get 50 credits a month, expiring one month after grant, that pay for either tier. Not \"everyone\": he told the design session \"the 'everyone gets 50 credits' wording is wrong. I never said that.\" I had told the design session \"yes, everyone\" as my own pick before he answered; never pass my pick on as his. His words: \"let's just give free users 50/mo use-it-or-loose it credits\".\n- Workshop has no ceiling. \"no ceiling. It's probably easier just to say standard messages cost 0 credits\". Nothing about 600 or fair use remains.\n- A balance is one number of credits, never \"N Standard or N Expert messages\" beside it (\"showing a number of messages and credits at the same time is fucking confusing\"). The translation line was my addition in the design doc, never his decision. Bars are grouped only by expiry; bought credits get a bar too (decision 13 closed).\n- \"New Standard chat\" and board 3d are gone, since the case only existed because of the Standard-only lot.\n\nPrices in messages appear only where the person chooses or is stopped: picker options, the stop card for the chat's tier, the pricing page's one sentence, the low-balance notice, and one scale line under the first-month offer.\n\n**Why:** he said he was \"seriously worried that we are not on the same page\" and asked me to restate the plan; the Standard-only lot and the ceiling were placeholders the plan carried without his words behind them.\n\n**How to apply:** before presenting any credits surface, check it against these four. When a plan carries a mechanism (a lot kind, a cap) with no quote from Kenneth behind it, flag it as mine rather than drawing it on every board. Related: [[credit-price-needs-its-unit]], [[usage-against-quota-common-shape]], [[trace-a-rule-to-kenneths-words]].\n\nLater the same evening Kenneth reviewed every mechanism that was mine, not his. Kept: the launch offer, \"About 25 credits left\" (credits, not messages), \"Expiring credits are used first\", the savings switch on by default, the Account page shape, Standard as the default tier after the first month, the v1 welcome-back fill-ins, the print-report form details, the alias ids. Dropped: the reverse savings alert and board 7c, the month-end and 7-day expiry notices, the daily cap on free app turns, the thinking picker on Standard. Expiry: every expiring lot expires one month from the day it was grante\n\nRuled later: \"no 50 credits for first month. only 500 initial credits. pack holders also get 50 credits a month.\" The 50 a month goes to every account not on a subscription, starting after the first month; the balance example is 62 + 500 = 562 with no Free credits bar.\n---\nname: balances-in-credits-only\ndescription: \"Kenneth, 2026-11-02, relayed by the pricing session: a balance is shown in credits only. A number of messages appears only where the person chooses or is stopped.\"\nmetadata:\n  node_type: memory\n  type: feedback\n  originSessionId: 3eabf4a3-87b6-4471-a4e5-b6fb9c14763a\n  modified: 2026-11-02T16:42:29.104Z\n---\n\nKenneth decided that a balance is shown in credits only, because showing a number of messages and credits at the same time is confusing. The pricing session relayed this; the rule it says he agreed with is that the translation appears only where the person chooses or is stopped, never on a balance.\n\n**Why:** two numbers for one balance make the person work out which one counts.\n\n**How to apply:** no \"612 Standard or 112 Expert messages\" on any balance, offer or pricing card. Prices stay as \"5 credits a message\". The low-balance notice says \"About 25 credits left\", not \"About 5 Expert messages left\" (Kenneth, 2026-11-02: \"25 credits left\" directly, then \"About 25 credits left\" in his later keep list). Free credits get the same ring as any others, with no line of their own: \"No reason to make exception\". Canvas versions 73 and 74 applied this. The pricing session kept 5a's \"50 free Standard messages a month\", board 9's Workshop notices and 2c's caption, because they des\n\nLater on 2026-11-02, relayed the same way, Kenneth's words: \"no ceiling. It's probably easier just to say standard messages cost 0 credits\" (Workshop) and \"let's just give free users 50/mo use-it-or-loose it credits\". So every credit pays for either tier, there is no Standard-only lot, and bars differ only by when credits expire: First-month, Free, Bought. Canvas version 75 applied this and removed board 3d and New Standard chat. The older \"free Standard messages\" wording above no longer describes the boards.\n\nThe 50 free credits are for free accounts, not everyone. Kenneth directly, on the pricing footer: \"the \"everyone gets 50 credits\" wording is wrong. I never sadi that.\" The word \"everyone\" came from an older draft and a relayed brief. Kenneth settled who counts, 2026-11-02 18:01: \"no 50 credits for first month. only 500 initial credits. pack holders also get 50 credits a month.\" So every account not on a subscription gets the 50, starting after the first month. A first-month person with a pack shows 62 + 500 = 562 and no Free credits bar (canvas version 79).\n\nKenneth's review of the same day, 17:46:15: \"The expiration should be One month from the day when the credits were granted\". So an expiring lot never ends at a calendar month end; plan credits expire with the billing cycle. Canvas version 78 applied this. The pricing session read what his keep list left out as dropped (the reverse savings alert, the month-end and 7-day notices, the thinking picker on Standard) and told him so; he hadn't objected in the transcript when version 78 went out.\n\n**Watch for:** the pricing session's 2026-11-02 brief called \"everyone gets the 50 free credits, Workshop too\" his ruling. It was that session's own pick from a question he never answered, so it wasn't applied. Check a relayed ruling against his words before applying it: [[trace-a-rule-to-kenneths-words]].\n\n       0\n7c69f331be Keep JusPrin v2 chats as raw text, without branch files\na54316ceab Charge JusPrin v2 turns from a credit ledger\nweb_ent/settings_ent.py:170:# Credits. The first month is decided; the trickle, the daily ceiling on free app\nweb_ent/settings_ent.py:181:JUSPRIN_V2_TRICKLE_CREDITS = 50\nweb_ent/settings_ent.py:182:JUSPRIN_V2_FREE_APP_TURNS_PER_DAY = 50\nweb_ent/settings_ent.py:183:JUSPRIN_V2_APP_TURN_CREDITS_PAST_CEILING = 1\nweb_ent/settings_ent.py:184:JUSPRIN_V2_WORKSHOP_BASIC_FAIR_USE = 600\nweb_ent/settings_ent.py:187:    'jusprin-workshop-monthly': {'name': 'Workshop', 'cents': 2000, 'credits': 1000, 'unlimited_basic'\nweb_ent/jusprin/ledger/models.py:15:    TRICKLE = 'trickle'\nweb_ent/jusprin/ledger/models.py:19:    KINDS = [(k, k) for k in (PACK, SUBSCRIPTION, SIGNUP, TRICKLE, REWARD, LAUNCH_BONUS, ADJUS\nweb_ent/jusprin/ledger/models.py:26:    basic_only = models.BooleanField(default=False)  # pays basic turns only\nweb_ent/jusprin/ledger/models.py:27:    # What makes the lot one of a kind for this person: signup, trickle:<yyyy-mm>,\nweb_ent/jusprin/ledger/ledger.py:25:    def __init__(self, balance: int, cost: int, basic_only_credits: int, affordable_aliases: L\nweb_ent/jusprin/ledger/ledger.py:30:        self.basic_only_credits = basic_only_credits\nweb_ent/jusprin/ledger/ledger.py:38:            'basic_only_credits': self.basic_only_credits,\nweb_ent/jusprin/ledger/ledger.py:47:    basic_only: int\nweb_e