usprin-newui","slug":"temporal-enchanting-muffin"}
{"parentUuid":"7b9951eb-91e2-4f07-ab53-a85a2fb1a51c","isSidechain":false,"promptId":"6b3f9665-7f28-483d-84d9-db7ace5fe0b2","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01H98uvm5rDnV7oJE8N6Z64s","type":"tool_result","content":"1\t\"\"\"The credit ledger against a real database: draw order, expiry, what a turn\n2\tcosts, and the concurrency select_for_update is there for.\"\"\"\n3\timport json\n4\timport threading\n5\timport uuid\n6\tfrom datetime import datetime, timedelta, timezone as dt_timezone\n7\tfrom unittest import mock\n8\t\n9\tfrom django.db import close_old_connections, connection\n10\tfrom django.test import Client, TestCase, TransactionTestCase, override_settings\n11\tfrom django.utils import timezone\n12\tfrom oauth2_provider.models import AccessToken, Application\n13\t\n14\tfrom app.models import Syndicate, User\n15\tfrom jusprin.ledger import ledger\n16\tfrom jusprin.ledger.account import account\n17\tfrom jusprin.ledger.ledger import CreditsExhausted, charge_turn, ensure_lots\n18\tfrom jusprin.ledger.models import CreditAllocation, CreditCharge, CreditGrant\n19\tfrom jusprin.models import JusPrinPlan\n20\tfrom jusprin.v2.aliases import parse_aliases\n21\tfrom jusprin.v2.upstream import IMAGE_NOTE, prepare\n22\t\n23\tfrom .test_gateway import UPSTREAM\n24\t\n25\t\n26\tdef two_aliases(basic_images=False):\n27\t    def alias(alias_id, tier, credits, images, fmt):\n28\t        return {\n29\t            'id': alias_id, 'label': alias_id, 'tier': tier, 'credits': credits,\n30\t            'efforts': ['fast'], 'default_effort': 'fast',\n31\t            'backends': {fmt: {'base_url': UPSTREAM, 'model': f'up-{alias_id}', 'api_key_env': 'TEST_KEY',\n32\t                               'effort_map': {'fast': 'low'}, 'images': images}},\n33\t            'groups': [{'name': 'main', 'format': fmt, 'percent': 100}],\n34\t        }\n35\t    return json.dumps({'aliases': [alias('slicer-1', 'expert', 5, True, 'anthropic'),\n36\t                                   alias('slicer-basic', 'basic', 1, basic_images, 'responses')]})\n37\t\n38\t\n39\tALIASES = parse_aliases(two_aliases())\n40\tEXPERT = ALIASES['slicer-1']\n41\tBASIC = ALIASES['slicer-basic']\n42\t\n43\t\n44\tdef new_user():\n45\t    return User.objects.create(email=f'ledger-{uuid.uuid4().hex[:8]}@example.com')\n46\t\n47\t\n48\tdef charge(user, turn, alias=EXPERT, origin=CreditCharge.PERSON):\n49\t    return charge_turn(user.id, turn, alias, origin, ALIASES)\n50\t\n51\t\n52\tclass LedgerTestCase(TestCase):\n53\t    def setUp(self):\n54\t        self.user = new_user()\n55\t        ensure_lots(self.user.id)\n56\t        self.signup = self.lot('signup')\n57\t        self.trickle = CreditGrant.objects.get(user=self.user, kind=CreditGrant.TRICKLE)\n58\t\n59\t    def lot(self, source_ref):\n60\t        return CreditGrant.objects.get(user=self.user, source_ref=source_ref)\n61\t\n62\t    def add_lot(self, kind, credits, source_ref, expires_at=None, basic_only=False):\n63\t        return CreditGrant.objects.create(user=self.user, kind=kind, credits_granted=credits,\n64\t                                          credits_remaining=credits, source_ref=source_ref,\n65\t                                          expires_at=expires_at, basic_only=basic_only)\n66\t\n67\t    def left(self, lot):\n68\t        lot.refresh_from_db()\n69\t        return lot.credits_remaining\n70\t\n71\t    def set_left(self, lot, credits):\n72\t        CreditGrant.objects.filter(pk=lot.pk).update(credits_remaining=credits)\n73\t\n74\t\n75\tclass FirstContactTests(LedgerTestCase):\n76\t    def test_a_new_person_gets_500_for_30_days_and_this_months_free_messages(self):\n77\t        self.assertEqual((self.signup.kind, self.signup.credits_granted, self.signup.basic_only), ('signup', 500, False))\n78\t        self.assertAlmostEqual(self.signup.expires_at, timezone.now() + timedelta(days=30), delta=timedelta(minutes=1))\n79\t        self.assertEqual((self.trickle.credits_granted, self.trickle.basic_only), (50, True))\n80\t\n81\t    def test_the_first_month_is_once_per_account(self):\n82\t        self.set_left(self.signup, 0)\n83\t        CreditGrant.objects.filter(pk=self.signup.pk).update(expires_at=timezone.now() - timedelta(days=1))\n84\t        ensure_lots(self.user.id)\n85\t        self.assertEqual(CreditGrant.objects.filter(user=self.user, kind=CreditGrant.SIGNUP).count(), 1)\n86\t\n87\t    def test_the_free_messages_expire_at_the_month_end_and_a_new_lot_follows(self):\n88\t        now = datetime(2026, 12, 15, 12, tzinfo=dt_timezone.utc)\n89\t        ensure_lots(self.user.id, now)\n90\t        december = self.lot('trickle:2026-12')\n91\t        self.assertEqual(december.expires_at, datetime(2027, 1, 1, tzinfo=dt_timezone.utc))\n92\t        ensure_lots(self.user.id, now)\n93\t        self.assertEqual(CreditGrant.objects.filter(user=self.user, source_ref='trickle:2026-12').count(), 1)\n94\t\n95\t\n96\tclass DrawOrderTests(LedgerTestCase):\n97\t    def test_soonest_to_expire_first_never_expiring_last(self):\n98\t        pack = self.add_lot('pack', 100, 'inv:1')\n99\t        term = self.add_lot('subscription', 100, 'sub:1:credits', expires_at=timezone.now() + timedelta(days=60))\n100\t        charge(self.user, 't1', BASIC)\n101\t        self.assertEqual(self.left(self.trickle), 49)\n102\t        self.set_left(self.trickle, 0)\n103\t        charge(self.user, 't2', EXPERT)\n104\t        self.assertEqual((self.left(self.signup), self.left(term), self.left(pack)), (495, 100, 100))\n105\t        self.set_left(self.signup, 2)\n106\t        charge(self.user, 't3', EXPERT)\n107\t        self.assertEqual((self.left(self.signup), self.left(term), self.left(pack)), (0, 97, 100))\n108\t        allocations = {a.grant_id: a.credits for a in CreditAllocation.objects.filter(charge__turn_id='t3')}\n109\t        self.assertEqual(allocations, {self.signup.id: 2, term.id: 3})\n110\t\n111\t    def test_oldest_first_within_one_expiry(self):\n112\t        self.set_left(self.signup, 0)\n113\t        self.set_left(self.trickle, 0)\n114\t        older = self.add_lot('reward', 3, 'report:1')\n115\t        newer = self.add_lot('pack', 10, 'inv:1')\n116\t        charge(self.user, 't1', EXPERT)\n117\t        self.assertEqual((self.left(older), self.left(newer)), (0, 8))\n118\t\n119\t    def test_expert_skips_the_free_standard_messages(self):\n120\t        self.set_left(self.signup, 4)\n121\t        with self.assertRaises(CreditsExhausted) as caught:\n122\t            charge(self.user, 't1', EXPERT)\n123\t        self.assertEqual(caught.exception.details(), {\n124\t            'balance': 4, 'cost': 5, 'basic_only_credits': 50, 'affordable_aliases': ['slicer-basic'], 'plan': None})\n125\t        self.assertEqual(self.left(self.trickle), 50)\n126\t        self.assertFalse(CreditCharge.objects.filter(user=self.user).exists())\n127\t\n128\t    def test_expiry_is_exclusive_at_the_boundary(self):\n129\t        now = timezone.now()\n130\t        with mock.patch.object(ledger.timezone, 'now', return_value=now):\n131\t            CreditGrant.objects.filter(pk=self.signup.pk).update(expires_at=now)\n132\t            self.set_left(self.trickle, 0)\n133\t            with self.assertRaises(CreditsExhausted):\n134\t                charge(self.user, 't1', EXPERT)\n135\t            CreditGrant.objects.filter(pk=self.signup.pk).update(expires_at=now + timedelta(microseconds=1))\n136\t            self.assertEqual(charge(self.user, 't2', EXPERT).credits, 5)\n137\t\n138\t\n139\tclass WhatATurnCostsTests(LedgerTestCase):\n140\t    def test_a_retried_turn_pays_once(self):\n141\t        first = charge(self.user, 't1')\n142\t        self.assertEqual(charge(self.user, 't1').pk, first.pk)\n143\t        self.assertEqual(self.left(self.signup), 495)\n144\t\n145\t    def test_a_retried_turn_is_not_refused_once_the_credits_are_gone(self):\n146\t        charge(self.user, 't1')\n147\t        self.set_left(self.signup, 0)\n148\t        self.assertEqual(charge(self.user, 't1').credits, 5)\n149\t\n150\t    @override_settings(JUSPRIN_V2_FREE_APP_TURNS_PER_DAY=2)\n151\t    def test_app_turns_are_free_up_to_the_daily_ceiling_then_cost_a_basic_message(self):\n152\t        for turn in ('a1', 'a2'):\n153\t            self.assertEqual(charge(self.user, turn, EXPERT, CreditCharge.APP).credits, 0)\n154\t        self.assertEqual((self.left(self.signup), self.left(self.trickle)), (500, 50))\n155\t        past = charge(self.user, 'a3', EXPERT, CreditCharge.APP)\n156\t        self.assertEqual((past.credits, past.tier, past.alias), (1, 'basic', 'slicer-1'))\n157\t        self.assertEqual(self.left(self.trickle), 49)\n158\t\n159\t    @override_settings(JUSPRIN_V2_FREE_APP_TURNS_PER_DAY=1)\n160\t    def test_the_ceiling_counts_the_last_24_hours(self):\n161\t        old = charge(self.user, 'a1', EXPERT, CreditCharge.APP)\n162\t        CreditCharge.objects.filter(pk=old.pk).update(created_at=timezone.now() - timedelta(hours=25))\n163\t        self.assertEqual(charge(self.user, 'a2', EXPERT, CreditCharge.APP).credits, 0)\n164\t\n165\t    def workshop(self, **fields):\n166\t        JusPrinPlan.objects.update_or_create(user=self.user, defaults={\n167\t            'plan_id': 'jusprin-workshop-monthly', 'external_id': 'x', 'external_user_id': 'y',\n168\t            'current_term_start': timezone.now() - timedelta(days=3), **fields})\n169\t\n170\t    @override_settings(JUSPRIN_V2_WORKSHOP_BASIC_FAIR_USE=2)\n171\t    def test_workshop_standard_is_free_up_to_fair_use_then_one_credit(self):\n172\t        self.workshop()\n173\t        self.assertEqual([charge(self.user, f'b{i}', BASIC).credits for i in range(3)], [0, 0, 1])\n174\t        self.assertEqual(charge(self.user, 'e1', EXPERT).credits, 5)\n175\t\n176\t    def test_a_lapsed_workshop_pays_like_anyone(self):\n177\t        self.workshop(expired_at=timezone.now() - timedelta(days=1))\n178\t        self.assertEqual(charge(self.user, 'b1', BASIC).credits, 1)\n179\t\n180\t    def test_hobby_has_no_free_standard(self):\n181\t        JusPrinPlan.objects.create(user=self.user, plan_id='jusprin-hobby-monthly', external_id='x', external_user_id='y')\n182\t        self.assertEqual(charge(self.user, 'b1', BASIC).credits, 1)\n183\t\n184\t    def test_an_exhausted_workshop_can_still_afford_standard(self):\n185\t        self.workshop()\n186\t        self.set_left(self.signup, 0)\n187\t        self.set_left(self.trickle, 0)\n188\t        with self.assertRaises(CreditsExhausted) as caught:\n189\t            charge(self.user, 'e1', EXPERT)\n190\t        self.assertEqual(caught.exception.affordable_aliases, ['slicer-basic'])\n191\t        self.assertEqual(caught.exception.plan, 'jusprin-workshop-monthly')\n192\t\n193\t\n194\tclass ConcurrentChargeTests(TransactionTestCase):\n195\t    # Real commits, so a second connection sees them. The flush after each test\n196\t    # also takes the row migrations made, which every new user points at.\n197\t    def setUp(self):\n198\t        Syndicate.objects.get_or_create(id=1, defaults={'name': 'base'})\n199\t\n200\t    def test_two_turns_cannot_both_spend_the_last_credits_of_one_lot(self):\n201\t        user = new_user()\n202\t        ensure_lots(user.id)\n203\t        CreditGrant.objects.filter(user=user, kind=CreditGrant.SIGNUP).update(credits_remaining=5)\n204\t        self.run_at_once(user, ['t1', 't2'])\n205\t        self.assertEqual(self.outcomes.count('charged'), 1)\n206\t        self.assertEqual(self.outcomes.count('exhausted'), 1)\n207\t        self.assertEqual(CreditGrant.objects.get(user=user, kind=CreditGrant.SIGNUP).credits_remaining, 0)\n208\t        self.assertEqual(CreditCharge.objects.filter(user=user).count(), 1)\n209\t\n210\t    def test_two_first_requests_of_a_new_person_make_one_first_month(self):\n211\t        user = new_user()\n212\t        self.run_at_once(user, ['t1', 't2'])\n213\t        self.assertEqual(self.outcomes, ['charged', 'charged'])\n214\t        self.assertEqual(CreditGrant.objects.get(user=user, kind=CreditGrant.SIGNUP).credits_remaining, 490)\n215\t\n216\t    def test_one_turn_sent_twice_at_once_pays_once(self):\n217\t        user = new_user()\n218\t        ensure_lots(user.id)\n219\t        self.run_at_once(user, ['same', 'same'])\n220\t        self.assertEqual(self.outcomes, ['charged', 'charged'])\n221\t        self.assertEqual(CreditGrant.objects.get(user=user, kind=CreditGrant.SIGNUP).credits_remaining, 495)\n222\t\n223\t    def run_at_once(self, user, turns):\n224\t        barrier = threading.Barrier(len(turns))\n225\t        self.outcomes = []\n226\t\n227\t        def run(turn):\n228\t            try:\n229\t                barrier.wait(timeout=10)\n230\t                charge(user, turn)\n231\t                self.outcomes.append('charged')\n232\t            except CreditsExhausted:\n233\t                self.outcomes.append('exhausted')\n234\t            finally:\n235\t                connection.close()\n236\t\n237\t        threads = [threading.Thread(target=run, args=(turn,)) for turn in turns]\n238\t        for thread in threads:\n239\t            thread.start()\n240\t        for thread in threads:\n241\t            thread.join(timeout=30)\n242\t        close_old_connections()\n243\t\n244\t\n245\tclass AccountTests(LedgerTestCase):\n246\t    def test_lots_come_soonest_first_with_what_each_was_granted(self):\n247\t        self.add_lot('pack', 500, 'inv:1')\n248\t        self.set_left(self.signup, 62)\n249\t        answer = account(self.user)\n250\t        self.assertEqual(answer['credits']['total'], 612)\n251\t        kinds = [(lot['kind'], lot['credits'], lot['granted'], lot.get('basic_only', False))\n252\t                 for lot in answer['credits']['lots']]\n253\t        self.assertCountEqual(kinds[:2], [('signup', 62, 500, False), ('trickle', 50, 50, True)])\n254\t        self.assertEqual(kinds[2], ('pack', 500, 500, False))\n255\t        self.assertIsNone(answer['credits']['lots'][2]['expires_at'])\n256\t\n257\t    def test_a_person_with_no_lots_gets_them_on_first_read(self):\n258\t        other = new_user()\n259\t        self.assertEqual(account(other)['credits']['total'], 550)\n260\t\n261\t    def test_an_expired_lot_stops_counting(self):\n262\t        CreditGrant.objects.filter(pk=self.signup.pk).update(expires_at=timezone.now() - timedelta(seconds=1))\n263\t        self.assertEqual(account(self.user)['credits']['total'], 50)\n264\t\n265\t    def test_usage_counts_turns_by_tier_with_a_row_per_chat(self):\n266\t        charge_turn(self.user.id, 't1', EXPERT, CreditCharge.PERSON, ALIASES, 'a' * 32)\n267\t        charge_turn(self.user.id, 't2', EXPERT, CreditCharge.PERSON, ALIASES, 'a' * 32)\n268\t        charge_turn(self.user.id, 't3', BASIC, CreditCharge.PERSON, ALIASES, 'b' * 32)\n269\t        usage = account(self.user)['usage_30d']\n270\t        self.assertEqual((usage['expert_turns'], usage['basic_turns'], usage['credits']), (2, 1, 11))\n271\t        self.assertEqual(usage['days'], [{'date': timezone.now().date().isoformat(), 'credits': 11}])\n272\t        rows = {row['chat_id']: (row['tier'], row['messages'], row['credits']) for row in usage['activity']}\n273\t        self.assertEqual(rows, {'a' * 32: ('expert', 2, 10), 'b' * 32: ('basic', 1, 1)})\n274\t\n275\t    def test_workshop_reports_fair_use(self):\n276\t        JusPrinPlan.objects.create(user=self.user, plan_id='jusprin-workshop-monthly', external_id='x',\n277\t                                   external_user_id='y', current_term_start=timezone.now() - timedelta(days=1),\n278\t                                   current_term_end=timezone.now() + timedelta(days=29))\n279\t        charge(self.user, 'b1', BASIC)\n280\t        plan = account(self.user)['plan']\n281\t        self.assertEqual((plan['name'], plan['basic_used_this_term'], plan['basic_fair_use']), ('Workshop', 1, 600))\n282\t\n283\t    def test_v1_subscribers_are_named_with_the_price_they_keep(self):\n284\t        JusPrinPlan.objects.create(user=self.user, plan_id='jusprin-unlimited-annual', external_id='x', external_user_id='y')\n285\t        answer = account(self.user)\n286\t        self.assertIsNone(answer['plan'])\n287\t        self.assertEqual(answer['v1_subscription'], {'plan_id': 'jusprin-unlimited-annual', 'cents': 5999, 'period': 'year'})\n288\t\n289\t    @override_settings(JUSPRIN_MODEL_ALIASES=two_aliases())\n290\t    def test_the_endpoints_need_a_token_and_report_prices(self):\n291\t        app = Application.objects.create(\n292\t            client_id=f'JusPrin2-{uuid.uuid4().hex[:6]}', name='JusPrin 2', client_type=Application.CLIENT_PUBLIC,\n293\t            authorization_grant_type=Application.GRANT_AUTHORIZATION_CODE, redirect_uris='http://127.0.0.1/callback')\n294\t        token = AccessToken.objects.create(user=self.user, application=app, token=uuid.uuid4().hex, scope='read write',\n295\t                                           expires=timezone.now() + timedelta(days=1)).token\n296\t        self.assertEqual(Client().get('/ent/jusprin/v2/account').status_code, 401)\n297\t        response = Client().get('/ent/jusprin/v2/account', HTTP_AUTHORIZATION=f'Bearer {token}')\n298\t        self.assertEqual((response.status_code, response['Cache-Control']), (200, 'no-store'))\n299\t        self.assertEqual(response.json()['credits']['total'], 550)\n300\t        models = Client().get('/ent/jusprin/v2/models', HTTP_AUTHORIZATION=f'Bearer {token}').json()['data']\n301\t        self.assertEqual([(m['id'], m['tier'], m['credits'], m['images']) for m in models],\n302\t                         [('slicer-1', 'expert', 5, True), ('slicer-basic', 'basic', 1, False)])\n303\t\n304\t\n305\tclass PrepareTests(TestCase):\n306\t    def setUp(self):\n307\t        env = mock.patch.dict('os.environ', {'TEST_KEY': 'k'})\n308\t        env.start()\n309\t        self.addCleanup(env.stop)\n310\t\n311\t    def sent(self, fmt, aliases, **body):\n312\t        raw = json.dumps({'stream': True, **body}).encode()\n313\t        return json.loads(prepare(fmt, raw, aliases, 7).body)\n314\t\n315\t    def responses_body(self, picture):\n316\t        return dict(model='slicer-basic', input=[\n317\t            {'role': 'user', 'content': [{'type': 'input_text', 'text': 'look'}, picture]},\n318\t            {'type': 'function_call', 'call_id': 'c1', 'name': 'view', 'arguments': '{\"type\":\"input_image\"}'},\n319\t            {'type': 'function_call_output', 'call_id': 'c1', 'output': [picture]},\n320\t        ])\n321\t\n322\t    def test_pictures_become_a_note_on_a_backend_without_images(self):\n323\t        picture = {'type': 'input_image', 'image_url': 'data:image/png;base64,AAAA'}\n324\t        sent = self.sent('responses', ALIASES, **self.responses_body(picture))\n325\t        note = {'type': 'input_text', 'text': IMAGE_NOTE}\n326\t        self.assertEqual(sent['input'][0]['content'], [{'type': 'input_text', 'text': 'look'}, note])\n327\t        self.assertEqual(sent['input'][1]['arguments'], '{\"type\":\"input_image\"}')\n328\t        self.assertEqual(sent['input'][2]['output'], [note])\n329\t        self.assertNotIn('AAAA', json.dumps(sent))\n330\t\n331\t    def test_a_backend_with_images_keeps_them(self):\n332\t        picture = {'type': 'input_image', 'image_url': 'data:image/png;base64,AAAA'}\n333\t        aliases = parse_aliases(two_aliases(basic_images=True))\n334\t        sent = self.sent('responses', aliases, **self.responses_body(picture))\n335\t        self.assertEqual(sent['input'][0]['content'][1], picture)\n336\t\n337\t    def test_anthropic_pictures_are_stripped_inside_tool_results_too(self):\n338\t        config = json.loads(two_aliases())\n339\t        config['aliases'][0]['backends']['anthropic']['images'] = False\n340\t        picture = {'type': 'image', 'source': {'type': 'base64', 'media_type': 'image/png', 'data': 'AAAA'}}\n341\t        sent = self.sent('anthropic', parse_aliases(json.dumps(config)), model='slicer-1', max_tokens=1, messages=[\n342\t            {'role': 'user', 'content': [picture]},\n343\t            {'role': 'assistant', 'content': [{'type': 'tool_use', 'id': 'c', 'name': 'n', 'input': picture}]},\n344\t            {'role': 'user', 'content': [{'type': 'tool_result', 'tool_use_id': 'c', 'content': [picture]}]},\n345\t        ])\n346\t        note = {'type': 'text', 'text': IMAGE_NOTE}\n347\t        self.assertEqual(sent['messages'][0]['content'], [note])\n348\t        self.assertEqual(sent['messages'][1]['content'][0]['input'], picture)\n349\t        self.assertEqual(sent['messages'][2]['content'][0]['content'], [note])\n350\t\n351\t    def test_every_cache_control_lasts_an_hour(self):\n352\t        ephemeral = {'type': 'ephemeral'}\n353\t        hour = {'type': 'ephemeral', 'ttl': '1h'}\n354\t        sent = self.sent('anthropic', ALIASES, model='slicer-1', max_tokens=1,\n355\t                         tools=[{'name': 't', 'input_schema': {}, 'cache_control': ephemeral}],\n356\t                         system=[{'type': 'text', 'text': 's', 'cache_control': ephemeral}],\n357\t                         messages=[{'role': 'user', 'content': [\n358\t                             {'type': 'tool_result', 'tool_use_id': 'c',\n359\t                              'content': [{'type': 'text', 'text': 'r', 'cache_control': ephemeral}]},\n360\t                             {'type': 'text', 'text': 'm', 'cache_control': ephemeral}]}])\n361\t        self.assertEqual(sent['tools'][0]['cache_control'], hour)\n362\t        self.assertEqual(sent['system'][-1]['cache_control'], hour)\n363\t        self.assertEqual(sent['messages'][0]['content'][1]['cache_control'], hour)\n364\t        self.assertEqual(sent['messages'][0]['content'][0]['content'][0]['cache_control'], hour)\n365\t\n366\t    def test_a_responses_body_has_no_cache_control_added(self):\n367\t        sent = self.sent('responses', ALIASES, model='slicer-basic', input=[])\n368\t        self.assertNotIn('cache_control', json.dumps(sent))\n369\t"}]},"uuid":"c3e039a5-a157-4446-bc82-ac18da03d34f","timestamp":"2026-11-02T18:14:54.919Z","toolUseResult":{"type":"text","file":{"filePath":"/Users/kenneth/Projects/tsd-enterprise/.claude/worktrees/credits-ledger/web_ent/jusprin/v2/tests/test_ledger.py","content":"\"\"\"The credit ledger against a real database: draw order, expiry, what a turn\ncosts, and the concurrency select_for_update is there for.\"\"\"\nimport json\nimport threading\nimport uuid\nfrom datetime import datetime, timedelta, timezone as dt_timezone\nfrom unittest import mock\n\nfrom django.db import close_old_connections, connection\nfrom django.test import Client, TestCase, TransactionTestCase, override_settings\nfrom django.utils import timezone\nfrom oauth2_provider.models import AccessToken, Application\n\nfrom app.models import Syndicate, User\nfrom jusprin.ledger import ledger\nfrom jusprin.ledger.account import account\nfrom jusprin.ledger.ledger import CreditsExhausted, charge_turn, ensure_lots\nfrom jusprin.ledger.models import CreditAllocation, CreditCharge, CreditGrant\nfrom jusprin.models import JusPrinPlan\nfrom jusprin.v2.aliases import parse_aliases\nfrom jusprin.v2.upstream import IMAGE_NOTE, prepare\n\nfrom .test_gateway import UPSTREAM\n\n\ndef two_aliases(basic_images=False):\n    def alias(alias_id, tier, credits, images, fmt):\n        return {\n            'id': alias_id, 'label': alias_id, 'tier': tier, 'credits': credits,\n            'efforts': ['fast'], 'default_effort': 'fast',\n            'backends': {fmt: {'base_url': UPSTREAM, 'model': f'up-{alias_id}', 'api_key_env': 'TEST_KEY',\n                               'effort_map': {'fast': 'low'}, 'images': images}},\n            'groups': [{'name': 'main', 'format': fmt, 'percent': 100}],\n        }\n    return json.dumps({'aliases': [alias('slicer-1', 'expert', 5, True, 'anthropic'),\n                                   alias('slicer-basic', 'basic', 1, basic_images, 'responses')]})\n\n\nALIASES = parse_aliases(two_aliases())\nEXPERT = ALIASES['slicer-1']\nBASIC = ALIASES['slicer-basic']\n\n\ndef new_user():\n    return User.objects.create(email=f'ledger-{uuid.uuid4().hex[:8]}@example.com')\n\n\ndef charge(user, turn, alias=EXPERT, origin=CreditCharge.PERSON):\n    return charge_turn(user.id, turn, alias, origin, ALIASES)\n\n\nclass LedgerTestCase(TestCase):\n    def setUp(self):\n        self.user = new_user()\n        ensure_lots(self.user.id)\n        self.signup = self.lot('signup')\n        self.trickle = CreditGrant.objects.get(user=self.user, kind=CreditGrant.TRICKLE)\n\n    def lot(self, source_ref):\n        return CreditGrant.objects.get(user=self.user, source_ref=source_ref)\n\n    def add_lot(self, kind, credits, source_ref, expires_at=None, basic_only=False):\n        return CreditGrant.objects.create(user=self.user, kind=kind, credits_granted=credits,\n                                          credits_remaining=credits, source_ref=source_ref,\n                                          expires_at=expires_at, basic_only=basic_only)\n\n    def left(self, lot):\n        lot.refresh_from_db()\n        return lot.credits_remaining\n\n    def set_left(self, lot, credits):\n        CreditGrant.objects.filter(pk=lot.pk).update(credits_remaining=credits)\n\n\nclass FirstContactTests(LedgerTestCase):\n    def test_a_new_person_gets_500_for_30_days_and_this_months_free_messages(self):\n        self.assertEqual((self.signup.kind, self.signup.credits_granted, self.signup.basic_only), ('signup', 500, False))\n        self.assertAlmostEqual(self.signup.expires_at, timezone.now() + timedelta(days=30), delta=timedelta(minutes=1))\n        self.assertEqual((self.trickle.credits_granted, self.trickle.basic_only), (50, True))\n\n    def test_the_first_month_is_once_per_account(self):\n        self.set_left(self.signup, 0)\n        CreditGrant.objects.filter(pk=self.signup.pk).update(expires_at=timezone.now() - timedelta(days=1))\n        ensure_lots(self.user.id)\n        self.assertEqual(CreditGrant.objects.filter(user=self.user, kind=CreditGrant.SIGNUP).count(), 1)\n\n    def test_the_free_messages_expire_at_the_month_end_and_a_new_lot_follows(self):\n        now = datetime(2026, 12, 15, 12, tzinfo=dt_timezone.utc)\n        ensure_lots(self.user.id, now)\n        december = self.lot('trickle:2026-12')\n        self.assertEqual(december.expires_at, datetime(2027, 1, 1, tzinfo=dt_timezone.utc))\n        ensure_lots(self.user.id, now)\n        self.assertEqual(CreditGrant.objects.filter(user=self.user, source_ref='trickle:2026-12').count(), 1)\n\n\nclass DrawOrderTests(LedgerTestCase):\n    def test_soonest_to_expire_first_never_expiring_last(self):\n        pack = self.add_lot('pack', 100, 'inv:1')\n        term = self.add_lot('subscription', 100, 'sub:1:credits', expires_at=timezone.now() + timedelta(days=60))\n        charge(self.user, 't1', BASIC)\n        self.assertEqual(self.left(self.trickle), 49)\n        self.set_left(self.trickle, 0)\n        charge(self.user, 't2', EXPERT)\n        self.assertEqual((self.left(self.signup), self.left(term), self.left(pack)), (495, 100, 100))\n        self.set_left(self.signup, 2)\n        charge(self.user, 't3', EXPERT)\n        self.assertEqual((self.left(self.signup), self.left(term), self.left(pack)), (0, 97, 100))\n        allocations = {a.grant_id: a.credits for a in CreditAllocation.objects.filter(charge__turn_id='t3')}\n        self.assertEqual(allocations, {self.signup.id: 2, term.id: 3})\n\n    def test_oldest_first_within_one_expiry(self):\n        self.set_left(self.signup, 0)\n        self.set_left(self.trickle, 0)\n        older = self.add_lot('reward', 3, 'report:1')\n        newer = self.add_lot('pack', 10, 'inv:1')\n        charge(self.user, 't1', EXPERT)\n        self.assertEqual((self.left(older), self.left(newer)), (0, 8))\n\n    def test_expert_skips_the_free_standard_messages(self):\n        self.set_left(self.signup, 4)\n        with self.assertRaises(CreditsExhausted) as caught:\n            charge(self.user, 't1', EXPERT)\n        self.assertEqual(caught.exception.details(), {\n            'balance': 4, 'cost': 5, 'basic_only_credits': 50, 'affordable_aliases': ['slicer-basic'], 'plan': None})\n        self.assertEqual(self.left(self.trickle), 50)\n        self.assertFalse(CreditCharge.objects.filter(user=self.user).exists())\n\n    def test_expiry_is_exclusive_at_the_boundary(self):\n        now = timezone.now()\n        with mock.patch.object(ledger.timezone, 'now', return_value=now):\n            CreditGrant.objects.filter(pk=self.signup.pk).update(expires_at=now)\n            self.set_left(self.trickle, 0)\n            with self.assertRaises(CreditsExhausted):\n                charge(self.user, 't1', EXPERT)\n            CreditGrant.objects.filter(pk=self.signup.pk).update(expires_at=now + timedelta(microseconds=1))\n            self.assertEqual(charge(self.user, 't2', EXPERT).credits, 5)\n\n\nclass WhatATurnCostsTests(LedgerTestCase):\n    def test_a_retried_turn_pays_once(self):\n        first = charge(self.user, 't1')\n        self.assertEqual(charge(self.user, 't1').pk, first.pk)\n        self.assertEqual(self.left(self.signup), 495)\n\n    def test_a_retried_turn_is_not_refused_once_the_credits_are_gone(self):\n        charge(self.user, 't1')\n        self.set_left(self.signup, 0)\n        self.assertEqual(charge(self.user, 't1').credits, 5)\n\n    @override_settings(JUSPRIN_V2_FREE_APP_TURNS_PER_DAY=2)\n    def test_app_turns_are_free_up_to_the_daily_ceiling_then_cost_a_basic_message(self):\n        for turn in ('a1', 'a2'):\n            self.assertEqual(charge(self.user, turn, EXPERT, CreditCharge.APP).credits, 0)\n        self.assertEqual((self.left(self.signup), self.left(self.trickle)), (500, 50))\n        past = charge(self.user, 'a3', EXPERT, CreditCharge.APP)\n        self.assertEqual((past.credits, past.tier, past.alias), (1, 'basic', 'slicer-1'))\n        self.assertEqual(self.left(self.trickle), 49)\n\n    @override_settings(JUSPRIN_V2_FREE_APP_TURNS_PER_DAY=1)\n    def test_the_ceiling_counts_the_last_24_hours(self):\n        old = charge(self.user, 'a1', EXPERT, CreditCharge.APP)\n        CreditCharge.objects.filter(pk=old.pk).update(created_at=timezone.now() - timedelta(hours=25))\n        self.assertEqual(charge(self.user, 'a2', EXPERT, CreditCharge.APP).credits, 0)\n\n    def workshop(self, **fields):\n        JusPrinPlan.objects.update_or_create(user=self.user, defaults={\n            'plan_id': 'jusprin-workshop-monthly', 'external_id': 'x', 'external_user_id': 'y',\n            'current_term_start': timezone.now() - timedelta(days=3), **fields})\n\n    @override_settings(JUSPRIN_V2_WORKSHOP_BASIC_FAIR_USE=2)\n    def test_workshop_standard_is_free_up_to_fair_use_then_one_credit(self):\n        self.workshop()\n        self.assertEqual([charge(self.user, f'b{i}', BASIC).credits for i in range(3)], [0, 0, 1])\n        self.assertEqual(charge(self.user, 'e1', EXPERT).credits, 5)\n\n    def test_a_lapsed_workshop_pays_like_anyone(self):\n        self.workshop(expired_at=timezone.now() - timedelta(days=1))\n        self.assertEqual(charge(self.user, 'b1', BASIC).credits, 1)\n\n    def test_hobby_has_no_free_standard(self):\n        JusPrinPlan.objects.create(user=self.user, plan_id='jusprin-hobby-monthly', external_id='x', external_user_id='y')\n        self.assertEqual(charge(self.user, 'b1', BASIC).credits, 1)\n\n    def test_an_exhausted_workshop_can_still_afford_standard(self):\n        self.workshop()\n        self.set_left(self.signup, 0)\n        self.set_left(self.trickle, 0)\n        with self.assertRaises(CreditsExhausted) as caught:\n            charge(self.user, 'e1', EXPERT)\n        self.assertEqual(caught.exception.affordable_aliases, ['slicer-basic'])\n        self.assertEqual(caught.exception.plan, 'jusprin-workshop-monthly')\n\n\nclass ConcurrentChargeTests(TransactionTestCase):\n    # Real commits, so a second connection sees them. The flush after each test\n    # also takes the row migrations made, which every new user points at.\n    def setUp(self):\n        Syndicate.objects.get_or_create(id=1, defaults={'name': 'base'})\n\n    def test_two_turns_cannot_both_spend_the_last_credits_of_one_lot(self):\n        user = new_user()\n        ensure_lots(user.id)\n        CreditGrant.objects.filter(user=user, kind=CreditGrant.SIGNUP).update(credits_remaining=5)\n        self.run_at_once(user, ['t1', 't2'])\n        self.assertEqual(self.outcomes.count('charged'), 1)\n        self.assertEqual(self.outcomes.count('exhausted'), 1)\n        self.assertEqual(CreditGrant.objects.get(user=user, kind=CreditGrant.SIGNUP).credits_remaining, 0)\n        self.assertEqual(CreditCharge.objects.filter(user=user).count(), 1)\n\n    def test_two_first_requests_of_a_new_person_make_one_first_month(self):\n        user = new_user()\n        self.run_at_once(user, ['t1', 't2'])\n        self.assertEqual(self.outcomes, ['charged', 'charged'])\n        self.assertEqual(CreditGrant.objects.get(user=user, kind=CreditGrant.SIGNUP).credits_remaining, 490)\n\n    def test_one_turn_sent_twice_at_once_pays_once(self):\n        user = new_user()\n        ensure_lots(user.id)\n        self.run_at_once(user, ['same', 'same'])\n        self.assertEqual(self.outcomes, ['charged', 'charged'])\n        self.assertEqual(CreditGrant.objects.get(user=user, kind=CreditGrant.SIGNUP).credits_remaining, 495)\n\n    def run_at_once(self, user, turns):\n        barrier = threading.Barrier(len(turns))\n        self.outcomes = []\n\n        def run(turn):\n            try:\n                barrier.wait(timeout=10)\n                charge(user, turn)\n                self.outcomes.append('charged')\n            except CreditsExhausted:\n                self.outcomes.append('exhausted')\n            finally:\n                connection.close()\n\n        threads = [threading.Thread(target=run, args=(turn,)) for turn in turns]\n        for thread in threads:\n            thread.start()\n        for thread in threads:\n            thread.join(timeout=30)\n        close_old_connections()\n\n\nclass AccountTests(LedgerTestCase):\n    def test_lots_come_soonest_first_with_what_each_was_granted(self):\n        self.add_lot('pack', 500, 'inv:1')\n        self.set_left(self.signup, 62)\n        answer = account(self.user)\n        self.assertEqual(answer['credits']['total'], 612)\n        kinds = [(lot['kind'], lot['credits'], lot['granted'], lot.get('basic_only', False))\n                 for lot in answer['credits']['lots']]\n        self.assertCountEqual(kinds[:2], [('signup', 62, 500, False), ('trickle', 50, 50, True)])\n        self.assertEqual(kinds[2], ('pack', 500, 500, False))\n        self.assertIsNone(answer['credits']['lots'][2]['expires_at'])\n\n    def test_a_person_with_no_lots_gets_them_on_first_read(self):\n        other = new_user()\n        self.assertEqual(account(other)['credits']['total'], 550)\n\n    def test_an_expired_lot_stops_counting(self):\n        CreditGrant.objects.filter(pk=self.signup.pk).update(expires_at=timezone.now() - timedelta(seconds=1))\n        self.assertEqual(account(self.user)['credits']['total'], 50)\n\n    def test_usage_counts_turns_by_tier_with_a_row_per_chat(self):\n        charge_turn(self.user.id, 't1', EXPERT, CreditCharge.PERSON, ALIASES, 'a' * 32)\n        charge_turn(self.user.id, 't2', EXPERT, CreditCharge.PERSON, ALIASES, 'a' * 32)\n        charge_turn(self.user.id, 't3', BASIC, CreditCharge.PERSON, ALIASES, 'b' * 32)\n        usage = account(self.user)['usage_30d']\n        self.assertEqual((usage['expert_turns'], usage['basic_turns'], usage['credits']), (2, 1, 11))\n        self.assertEqual(usage['days'], [{'date': timezone.now().date().isoformat(), 'credits': 11}])\n        rows = {row['chat_id']: (row['tier'], row['messages'], row['credits']) for row in usage['activity']}\n        self.assertEqual(rows, {'a' * 32: ('expert', 2, 10), 'b' * 32: ('basic', 1, 1)})\n\n    def test_workshop_reports_fair_use(self):\n        JusPrinPlan.objects.create(user=self.user, plan_id='jusprin-workshop-monthly', external_id='x',\n                                   external_user_id='y', current_term_start=timezone.now() - timedelta(days=1),\n                                   current_term_end=timezone.now() + timedelta(days=29))\n        charge(self.user, 'b1', BASIC)\n        plan = account(self.user)['plan']\n        self.assertEqual((plan['name'], plan['basic_used_this_term'], plan['basic_fair_use']), ('Workshop', 1, 600))\n\n    def test_v1_subscribers_are_named_with_the_price_they_keep(self):\n        JusPrinPlan.objects.create(user=self.user, plan_id='jusprin-unlimited-annual', external_id='x', external_user_id='y')\n        answer = account(self.user)\n        self.assertIsNone(answer['plan'])\n        self.assertEqual(answer['v1_subscription'], {'plan_id': 'jusprin-unlimited-annual', 'cents': 5999, 'period': 'year'})\n\n    @override_settings(JUSPRIN_MODEL_ALIASES=two_aliases())\n    def test_the_endpoints_need_a_token_and_report_prices(self):\n        app = Application.objects.create(\n            client_id=f'JusPrin2-{uuid.uuid4().hex[:6]}', name='JusPrin 2', client_type=Application.CLIENT_PUBLIC,\n            authorization_grant_type=Application.GRANT_AUTHORIZATION_CODE, redirect_uris='http://127.0.0.1/callback')\n        token = AccessToken.objects.create(user=self.user, application=app, token=uuid.uuid4().hex, scope='read write',\n                                           expires=timezone.now() + timedelta(days=1)).token\n        self.assertEqual(Client().get('/ent/jusprin/v2/account').status_code, 401)\n        response = Client().get('/ent/jusprin/v2/account', HTTP_AUTHORIZATION=f'Bearer {token}')\n        self.assertEqual((response.status_code, response['Cache-Control']), (200, 'no-store'))\n        self.assertEqual(response.json()['credits']['total'], 550)\n        models = Client().get('/ent/jusprin/v2/models', HTTP_AUTHORIZATION=f'Bearer {token}').json()['data']\n        self.assertEqual([(m['id'], m['tier'], m['credits'], m['images']) for m in models],\n                         [('slicer-1', 'expert', 5, True), ('slicer-basic', 'basic', 1, False)])\n\n\nclass PrepareTests(TestCase):\n    def setUp(self):\n        env = mock.patch.dict('os.environ', {'TEST_KEY': 'k'})\n        env.start()\n        self.addCleanup(env.stop)\n\n    def sent(self, fmt, aliases, **body):\n        raw = json.dumps({'stream': True, **body}).encode()\n        return json.loads(prepare(fmt, raw, aliases, 7).body)\n\n    def responses_body(self, picture):\n        return dict(model='slicer-basic', input=[\n            {'role': 'user', 'content': [{'type': 'input_text', 'text': 'look'}, picture]},\n            {'type': 'function_call', 'call_id': 'c1', 'name': 'view', 'arguments': '{\"type\":\"input_image\"}'},\n            {'type': 'function_call_output', 'call_id': 'c1', 'output': [picture]},\n        ])\n\n    def test_pictures_become_a_note_on_a_backend_without_images(self):\n        picture = {'type': 'input_image', 'image_url': 'data:image/png;base64,AAAA'}\n        sent = self.sent('responses', ALIASES, **self.responses_body(picture))\n        note = {'type': 'input_text', 'text': IMAGE_NOTE}\n        self.assertEqual(sent['input'][0]['content'], [{'type': 'input_text', 'text': 'look'}, note])\n        self.assertEqual(sent['input'][1]['arguments'], '{\"type\":\"input_image\"}')\n        self.assertEqual(sent['input'][2]['output'], [note])\n        self.assertNotIn('AAAA', json.dumps(sent))\n\n    def test_a_backend_with_images_keeps_them(self):\n        picture = {'type': 'input_image', 'image_url': 'data:image/png;base64,AAAA'}\n        aliases = parse_aliases(two_aliases(basic_images=True))\n        sent = self.sent('responses', aliases, **self.responses_body(picture))\n        self.assertEqual(sent['input'][0]['content'][1], picture)\n\n    def test_anthropic_pictures_are_stripped_inside_tool_results_too(self):\n        config = json.loads(two_aliases())\n        config['aliases'][0]['backends']['anthropic']['images'] = False\n        picture = {'type': 'image', 'source': {'type': 'base64', 'media_type': 'image/png', 'data': 'AAAA'}}\n        sent = self.sent('anthropic', parse_aliases(json.dumps(config)), model='slicer-1', max_tokens=1, messages=[\n            {'role': 'user', 'content': [picture]},\n            {'role': 'assistant', 'content': [{'type': 'tool_use', 'id': 'c', 'name': 'n', 'input': picture}]},\n            {'role': 'user', 'content': [{'type': 'tool_result', 'tool_use_id': 'c', 'content': [picture]}]},\n        ])\n        note = {'type': 'text', 'text': IMAGE_NOTE}\n        self.assertEqual(sent['messages'][0]['content'], [note])\n        self.assertEqual(sent['messages'][1]['content'][0]['input'], picture)\n        self.assertEqual(sent['messages'][2]['content'][0]['content'], [note])\n\n    def test_every_cache_control_lasts_an_hour(self):\n        ephemeral = {'type': 'ephemeral'}\n        hour = {'type': 'ephemeral', 'ttl': '1h'}\n        sent = self.sent('anthropic', ALIASES, model='slicer-1', max_tokens=1,\n                         tools=[{'name': 't', 'input_schema': {}, 'cache_control': ephemeral}],\n                         system=[{'type': 'text', 'text': 's', 'cache_control': ephemeral}],\n                         messages=[{'role': 'user', 'content': [\n                             {'type': 'tool_result', 'tool_use_id': 'c',\n                              'content': [{'type': 'text', 'text': 'r', 'cache_control': ephemeral}]},\n                             {'type': 'text', 'text': 'm', 'cache_control': ephemeral}]}])\n        self.assertEqual(sent['tools'][0]['cache_control'], hour)\n        self.assertEqual(sent['system'][-1]['cache_control'], hour)\n        self.assertEqual(sent['messages'][0]['content'][1]['cache_control'], hour)\n        self.assertEqual(sent['messages'][0]['content'][0]['content'][0]['cache_control'], hour)\n\n    def test_a_responses_body_has_no_cache_control_added(self):\n        sent = self.sent('responses', ALIASES, model='slicer-basic', input=[])\n        self.assertNotIn('cache_control', json.dumps(sent))\n","numLines":369,"startLine":1,"totalLines":369}},"sourceToolAssistantUUID":"7b9951eb-91e2-4f07-ab53-a85a2fb1a51c","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"userType":"external","entrypoint":"claude-desktop","cwd":"/Users/kenneth/Projects/ops/.claude/worktrees/credits-gateway-config","sessionId":"f57d8b7e-fd5a-4daf-9378-2e3d21342f7c","version":"2.1.309","gitBranch":"jusprin-newui","slug":"temporal-enchanting-muffin"}
{"parentUuid":"c3e039a5-a157-4446-bc82-ac18da03d34f","isSidechain":false,"message":{"model":"claude-opus-5-5","id":"msg_011CgeZFbcTiguq54fFvXJNh","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01NAzJX9fyKTYDqn1Z483sZd","name":"Read","input":{"file_path":"/Users/kenneth/Projects/tsd-enterprise/.claude/worktrees/credits-ledger/web_ent/jusprin/ledger/reports.py","offset":60},"caller":{"type":"direct"}}],"container":null,"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":13422,"cache_read_input_tokens":298294,"output_tokens":969,"output_tokens_details":{"thinking_tokens":0},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":13422,"ephemeral_5m_input_tokens":0},"inference_geo":"global","iterations":[{"input_tokens":2,"output_tokens":969,"cache_read_input_tokens":298294,"cache_creation_input_tokens":13422,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":13422},"type":"message"}],"speed":"standard","fallback_credit":null},"input_transformations":[],"diagnostics":null,"context_management":null},"wireToolInputs":{"toolu_01NAzJX9fyKTYDqn1Z483sZd":{"file_path":"/Users/kenneth/Projects/tsd-enterprise/.claude/worktrees/credits-ledger/web_ent/jusprin/ledger/reports.py","offset":60}},"apiBlockIndex":6,"requestId":"req_011CgeZFbH7xLJvivgGZgKFR","requestRef":"c78f3bda-4360-4ba8-85aa-6781a37a4881","requestedModel":"claude-opus-5-5","attributionMcpServer":"ccd_turn","attributionMcpTool":"update_plan","type":"assistant","uuid":"bca0eaf1-f657-450f-b9cf-887df088eed0","timestamp":"2026-11-02T18:14:55.647Z","advisorModel":"claude-opus-5-5","effort":"high","perTurnEffort":"high","userType":"external","entrypoint":"claude-desktop","cwd":"/Users/kenneth/Projects/ops/.claude/worktrees/credits-gateway-config","sessionId":"f57d8b7e-fd5a-4daf-9378-2e3d21342f7c","version":"2.1.309","gitBranch":"jusprin-newui","slug":"temporal-enchanting-muffin"}
{"parentUuid":"bca0eaf1-f657-450f-b9cf-887df088eed0","isSidechain":false,"promptId":"6b3f9665-7f28-483d-84d9-db7ace5fe0b2","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01NAzJX9fyKTYDqn1Z483sZd","type":"tool_result","content":"60\t    return PrintReport.objects.filter(user=user, gcode_hash=gcode_hash).exists()\n61\t\n62\t\n63\tdef review_report(report: PrintReport, invalid: bool, note: str = '') -> PrintReportReview:\n64\t    \"\"\"Records the review. An invalid report that earned loses it once, from what\n65\t    is left: the balance can reach zero, not below, and the rest is forgiven.\"\"\"\n66\t    with transaction.atomic():\n67\t        review, _ = PrintReportReview.objects.update_or_create(report=report, defaults={'invalid': invalid, 'note': note})\n68\t        if invalid and report.rewarded:\n69\t            _take_back(report)\n70\t    return review\n71\t\n72\t\n73\tdef _take_back(report: PrintReport) -> None:\n74\t    credits = settings.JUSPRIN_V2_REPORT_CREDITS\n75\t    now = timezone.now()\n76\t    # Locks the person's lots in the order charge_turn takes them.\n77\t    lots = list(live_lots(report.user_id, now).select_for_update())\n78\t    _, created = CreditGrant.objects.get_or_create(\n79\t        user_id=report.user_id, source_ref=_invalid_ref(report),\n80\t        defaults={'kind': CreditGrant.ADJUSTMENT, 'credits_granted': -credits, 'credits_remaining': 0})\n81\t    if not created:\n82\t        return\n83\t    # The reward's own lot first, then what else the person holds. Free Standard\n84\t    # messages are left alone: they never came from the reward.\n85\t    own = [lot for lot in lots if lot.source_ref == _reward_ref(report)]\n86\t    others = [lot for lot in lots if lot.source_ref != _reward_ref(report) and not lot.basic_only]\n87\t    owed = credits\n88\t    for lot in own + others:\n89\t        taken = min(owed, lot.credits_remaining)\n90\t        if taken > 0:\n91\t            lot.credits_remaining -= taken\n92\t            lot.save(update_fields=['credits_remaining'])\n93\t            owed -= taken\n94\t\n95\t\n96\tdef report_activity(user, since) -> List[Dict]:\n97\t    \"\"\"The Account usage table's rows for reports: what each earned, and what a\n98\t    review took back with its reason.\"\"\"\n99\t    rows = []\n100\t    reports = PrintReport.objects.filter(user=user).select_related('printreportreview')\n101\t    by_ref = {_reward_ref(report): report for report in reports}\n102\t    by_ref.update({_invalid_ref(report): report for report in reports})\n103\t    grants = CreditGrant.objects.filter(user=user, created_at__gte=since, source_ref__in=by_ref.keys())\n104\t    for grant in grants:\n105\t        report = by_ref[grant.source_ref]\n106\t        title = 'Print report · ' + report.facts.get('project', report.gcode_hash[:8])\n107\t        row = {'date': grant.created_at.date().isoformat(), 'title': title, 'credits': grant.credits_granted}\n108\t        if grant.kind == CreditGrant.REWARD:\n109\t            rows.append({**row, 'kind': 'report'})\n110\t        else:\n111\t            rows.append({**row, 'kind': 'report_removed', 'note': report.printreportreview.note})\n112\t    return rows\n113\t"}]},"uuid":"95865ccf-42d8-4717-9ee3-a808217315b2","timestamp":"2026-11-02T18:14:55.710Z","toolUseResult":{"type":"text","file":{"filePath":"/Users/kenneth/Projects/tsd-enterprise/.claude/worktrees/credits-ledger/web_ent/jusprin/ledger/reports.py","content":"    return PrintReport.objects.filter(user=user, gcode_hash=gcode_hash).exists()\n\n\ndef review_report(report: PrintReport, invalid: bool, note: str = '') -> PrintReportReview:\n    \"\"\"Records the review. An invalid report that earned loses it once, from what\n    is left: the balance can reach zero, not below, and the rest is forgiven.\"\"\"\n    with transaction.atomic():\n        review, _ = PrintReportReview.objects.update_or_create(report=report, defaults={'invalid': invalid, 'note': note})\n        if invalid and report.rewarded:\n            _take_back(report)\n    return review\n\n\ndef _take_back(report: PrintReport) -> None:\n    credits = settings.JUSPRIN_V2_REPORT_CREDITS\n    now = timezone.now()\n    # Locks the person's lots in the order charge_turn takes them.\n    lots = list(live_lots(report.user_id, now).select_for_update())\n    _, created = CreditGrant.objects.get_or_create(\n        user_id=report.user_id, source_ref=_invalid_ref(report),\n        defaults={'kind': CreditGrant.ADJUSTMENT, 'credits_granted': -credits, 'credits_remaining': 0})\n    if not created:\n        return\n    # The reward's own lot first, then what else the person holds. Free Standard\n    # messages are left alone: they never came from the reward.\n    own = [lot for lot in lots if lot.source_ref == _reward_ref(report)]\n    others = [lot for lot in lots if lot.source_ref != _reward_ref(report) and not lot.basic_only]\n    owed = credits\n    for lot in own + others:\n        taken = min(owed, lot.credits_remaining)\n        if taken > 0:\n            lot.credits_remaining -= taken\n            lot.save(update_fields=['credits_remaining'])\n            owed -= taken\n\n\ndef report_activity(user, since) -> List[Dict]:\n    \"\"\"The Account usage table's rows for reports: what each earned, and what a\n    review took back with its reason.\"\"\"\n    rows = []\n    reports = PrintReport.objects.filter(user=user).select_related('printreportreview')\n    by_ref = {_reward_ref(report): report for report in reports}\n    by_ref.update({_invalid_ref(report): report for report in reports})\n    grants = CreditGrant.objects.filter(user=user, created_at__gte=since, source_ref__in=by_ref.keys())\n    for grant in grants:\n        report = by_ref[grant.source_ref]\n        title = 'Print report · ' + report.facts.get('project', report.gcode_hash[:8])\n        row = {'date': grant.created_at.date().isoformat(), 'title': title, 'credits': grant.credits_granted}\n        if grant.kind == CreditGrant.REWARD:\n            rows.append({**row, 'kind': 'report'})\n        else:\n            rows.append({**row, 'kind': 'report_removed', 'note': report.printreportreview.note})\n    return rows\n","numLines":54,"startLine":60,"totalLines":113}},"sourceToolAssistantUUID":"bca0eaf1-f657-450f-b9cf-887df088eed0","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"userType":"external","entrypoint":"claude-desktop","cwd":"/Users/kenneth/Projects/ops/.claude/worktrees/credits-gateway-config","sessionId":"f57d8b7e-fd5a-4daf-9378-2e3d21342f7c","version":"2.1.309","gitBranch":"jusprin-newui","slug":"temporal-enchanting-muffin"}
{"parentUuid":"95865ccf-42d8-4717-9ee3-a808217315b2","isSidechain":false,"message":{"model":"claude-opus-5-5","id":"msg_011CgeZFbcTiguq54fFvXJNh","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01SJDHBVjqikTLj6V1drCxcW","name":"Read","input":{"file_path":"/Users/kenneth/Projects/tsd-enterprise/.claude/worktrees/credits-ledger/web_ent/jusprin/v2/credits.py"},"caller":{"type":"direct"}}],"container":null,"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":13422,"cache_read_input_tokens":298294,"output_tokens":969,"output_tokens_details":{"thinking_tokens":0},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":13422,"ephemeral_5m_input_tokens":0},"inference_geo":"global","iterations":[{"input_tokens":2,"output_tokens":969,"cache_read_input_tokens":298294,"cache_creation_input_tokens":13422,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":13422},"type":"message"}],"speed":"standard","fallback_credit":null},"input_transformations":[],"diagnostics":null,"context_management":null},"wireToolInputs":{"toolu_01SJDHBVjqikTLj6V1drCxcW":{"file_path":"/Users/kenneth/Projects/tsd-enterprise/.claude/worktrees/credits-ledger/web_ent/jusprin/v2/credits.py"}},"apiBlockIndex":7,"requestId":"req_011CgeZFbH7xLJvivgGZgKFR","requestRef":"c78f3bda-4360-4ba8-85aa-6781a37a4881","requestedModel":"claude-opus-5-5","attributionMcpServer":"ccd_turn","attributionMcpTool":"update_plan","type":"assistant","uuid":"cfb1bd10-c15f-4c57-b1a0-dde35dc605cf","timestamp":"2026-11-02T18:14:56.224Z","advisorModel":"claude-opus-5-5","effort":"high","perTurnEffort":"high","userType":"external","entrypoint":"claude-desktop","cwd":"/Users/kenneth/Projects/ops/.claude/worktrees/credits-gateway-config","sessionId":"f57d8b7e-fd5a-4daf-9378-2e3d21342f7c","version":"2.1.309","gitBranch":"jusprin-newui","slug":"temporal-enchanting-muffin"}
{"parentUuid":"cfb1bd10-c15f-4c57-b1a0-dde35dc605cf","isSidechain":false,"promptId":"6b3f9665-7f28-483d-84d9-db7ace5fe0b2","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01SJDHBVjqikTLj6V1drCxcW","type":"tool_result","content":"1\t\"\"\"Per-turn admission: rate limit, then the turn's charge in the credit ledger.\n2\t\n3\tA turn is everything the client sends for one reply, including tool-call\n4\tfollow-ups; every request of it carries the same X-JusPrin-Turn value. A turn\n5\tpays its model's price once, however many requests it makes. Title requests are\n6\tfree, and a request of kind \"note\" is a turn the app started, not the person.\n7\t\n8\tThe reply requests of one turn are sequential (a follow-up is built from the\n9\tprevious answer), so the charge does not guard against two reply requests of\n10\tthe same turn racing each other.\n11\t\"\"\"\n12\timport enum\n13\timport time\n14\t\n15\tfrom django.conf import settings\n16\t\n17\tfrom jusprin.ledger.ledger import charge_turn\n18\tfrom jusprin.ledger.models import CreditCharge\n19\tfrom lib.cache import REDIS\n20\t\n21\tKEY_PREFIX = 'jusprin:v2'\n22\tTURN_TTL_SECONDS = 60 * 60\n23\t\n24\t\n25\tclass Admission(enum.Enum):\n26\t    ADMITTED = 'admitted'\n27\t    RATE_LIMITED = 'rate_limited'\n28\t\n29\t\n30\tdef admit(user_id: int, turn_id: str, request_kind: str, alias, aliases, chat_id: str = None) -> Admission:\n31\t    \"\"\"Count a new turn against the rate limit, then charge it once unless it\n32\t    is a title. Raises ledger.CreditsExhausted when it cannot be paid.\n33\t    Synchronous: Redis and the credit tables are both blocking.\"\"\"\n34\t    seen_key = f'{KEY_PREFIX}:seen:{user_id}:{turn_id}'\n35\t    if REDIS.set(seen_key, '1', nx=True, ex=TURN_TTL_SECONDS):\n36\t        bucket = f'{KEY_PREFIX}:turns:{user_id}:{int(time.time() // 60)}'\n37\t        pipe = REDIS.pipeline()\n38\t        pipe.incr(bucket)\n39\t        pipe.expire(bucket, 120)\n40\t        turns_this_minute, _ = pipe.execute()\n41\t        if turns_this_minute > settings.JUSPRIN_V2_TURNS_PER_MINUTE:\n42\t            # The turn was not admitted, so its retry is a new turn again.\n43\t            REDIS.delete(seen_key)\n44\t            return Admission.RATE_LIMITED\n45\t\n46\t    if request_kind == 'title':\n47\t        return Admission.ADMITTED\n48\t\n49\t    charged_key = f'{KEY_PREFIX}:charged:{user_id}:{turn_id}'\n50\t    if not REDIS.set(charged_key, '1', nx=True, ex=TURN_TTL_SECONDS):\n51\t        return Admission.ADMITTED\n52\t    origin = CreditCharge.APP if request_kind == 'note' else CreditCharge.PERSON\n53\t    charged = False\n54\t    try:\n55\t        charge_turn(user_id, turn_id, alias, origin, aliases, chat_id)\n56\t        charged = True\n57\t    finally:\n58\t        # Only a turn that actually paid is remembered as paid, whether the\n59\t        # credits ran out or the credit tables raised.\n60\t        if not charged:\n61\t            REDIS.delete(charged_key)\n62\t    return Admission.ADMITTED\n63\t"}]},"uuid":"f3a526ad-c85f-4ac0-a244-a7dda87f44fc","timestamp":"2026-11-02T18:14:56.268Z","toolUseResult":{"type":"text","file":{"filePath":"/Users/kenneth/Projects/tsd-enterprise/.claude/worktrees/credits-ledger/web_ent/jusprin/v2/credits.py","content":"\"\"\"Per-turn admission: rate limit, then the turn's charge in the credit ledger.\n\nA turn is everything the client sends for one reply, including tool-call\nfollow-ups; every request of it carries the same X-JusPrin-Turn value. A turn\npays its model's price once, however many requests it makes. Title requests are\nfree, and a request of kind \"note\" is a turn the app started, not the person.\n\nThe reply requests of one turn are sequential (a follow-up is built from the\nprevious answer), so the charge does not guard against two reply requests of\nthe same turn racing each other.\n\"\"\"\nimport enum\nimport time\n\nfrom django.conf import settings\n\nfrom jusprin.ledger.ledger import charge_turn\nfrom jusprin.ledger.models import CreditCharge\nfrom lib.cache import REDIS\n\nKEY_PREFIX = 'jusprin:v2'\nTURN_TTL_SECONDS = 60 * 60\n\n\nclass Admission(enum.Enum):\n    ADMITTED = 'admitted'\n    RATE_LIMITED = 'rate_limited'\n\n\ndef admit(user_id: int, turn_id: str, request_kind: str, alias, aliases, chat_id: str = None) -> Admission:\n    \"\"\"Count a new turn against the rate limit, then charge it once unless it\n    is a title. Raises ledger.CreditsExhausted when it cannot be paid.\n    Synchronous: Redis and the credit tables are both blocking.\"\"\"\n    seen_key = f'{KEY_PREFIX}:seen:{user_id}:{turn_id}'\n    if REDIS.set(seen_key, '1', nx=True, ex=TURN_TTL_SECONDS):\n        bucket = f'{KEY_PREFIX}:turns:{user_id}:{int(time.time() // 60)}'\n        pipe = REDIS.pipeline()\n        pipe.incr(bucket)\n        pipe.expire(bucket, 120)\n        turns_this_minute, _ = pipe.execute()\n        if turns_this_minute > settings.JUSPRIN_V2_TURNS_PER_MINUTE:\n            # The turn was not admitted, so its retry is a new turn again.\n            REDIS.delete(seen_key)\n            return Admission.RATE_LIMITED\n\n    if request_kind == 'title':\n        return Admission.ADMITTED\n\n    charged_key = f'{KEY_PREFIX}:charged:{user_id}:{turn_id}'\n    if not REDIS.set(charged_key, '1', nx=True, ex=TURN_TTL_SECONDS):\n        return Admission.ADMITTED\n    origin = CreditCharge.APP if request_kind == 'note' else CreditCharge.PERSON\n    charged = False\n    try:\n        charge_turn(user_id, turn_id, alias, origin, aliases, chat_id)\n        charged = True\n    finally:\n        # Only a turn that actually paid is remembered as paid, whether the\n        # credits ran out or the credit tables raised.\n        if not charged:\n            REDIS.delete(charged_key)\n    return Admission.ADMITTED\n","numLines":63,"startLine":1,"totalLines":63}},"sourceToolAssistantUUID":"cfb1bd10-c15f-4c57-b1a0-dde35dc605cf","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"userType":"external","entrypoint":"claude-desktop","cwd":"/Users/kenneth/Projects/ops/.claude/worktrees/credits-gateway-config","sessionId":"f57d8b7e-fd5a-4daf-9378-2e3d21342f7c","version":"2.1.309","gitBranch":"jusprin-newui","slug":"temporal-enchanting-muffin"}
{"parentUuid":"f3a526ad-c85f-4ac0-a244-a7dda87f44fc","isSidechain":false,"attachment":{"type":"output_style","style":"Plain"},"type":"attachment","uuid":"4deb5d5e-7181-499a-af89-0e70ed81cc10","timestamp":"2026-11-02T18:14:56.316Z","rendered":[{"content":"<system-reminder>\nPlain output style is active. Remember to follow the specific guidelines for this style.\n</system-reminder>"}],"renderedRole":"system","userType":"external","entrypoint":"claude-desktop","cwd":"/Users/kenneth/Projects/ops/.claude/worktrees/credits-gateway-config","sessionId":"f57d8b7e-fd5a-4daf-9378-2e3d21342f7c","version":"2.1.309","gitBranch":"jusprin-newui","slug":"temporal-enchanting-muffin"}
{"type":"api-request-blob","sessionId":"f57d8b7e-fd5a-4daf-9378-2e3d21342f7c","hash":"9b2520a654f774c251c4c677c5a402a7922b68abe903e872fb804e50fb1ad63f","message":{"role":"assistant","content":[{"type":"text","text":"Now I'm reading the rest of the decision block and the current ledger code."},{"type":"tool_use","id":"toolu_01UaBP2Adp4qazR2HdMak4Nr","name":"Bash","input":{"command":"sed -n 1,30p /Users/kenneth/Projects/JusPrin/pricing-implementation-plan-2026-11.md | cut -c1-900; echo ...; grep -n \"^#### \\|^\\*\\*Decided\" /Users/kenneth/.claude/projects/-Users-kenneth-Projects-JusPrin/f57d8b7e-fd5a-4daf-9378-2e3d21342f7c/tool-results/bvzcbzazr.txt | head; sed -n 1,20p /Users/kenneth/Projects/JusPrin/pricing-touchpoints-design-2026-11.md | cut -c1-900","description":"Read the plan and design decision blocks in full","timeout":10000},"caller":{"type":"direct"}},{"type":"tool_use","id":"toolu_01XX8Exps8euyb23hNCFZSLw","name":"Read","input":{"file_path":"/Users/kenneth/Projects/tsd-enterprise/.claude/worktrees/credits-ledger/web_ent/jusprin/ledger/ledger.py"},"caller":{"type":"direct"}},{"type":"tool_use","id":"toolu_01X8sjBELKaqMirKN6vwu4G1","name":"Read","input":{"file_path":"/Users/kenneth/Projects/tsd-enterprise/.claude/worktrees/credits-ledger/web_ent/jusprin/ledger/account.py"},"caller":{"type":"direct"}},{"type":"tool_use","id":"toolu_01P2djqjZYntPsSGBqZM9bLZ","name":"Read","input":{"file_path":"/Users/kenneth/Projects/tsd-enterprise/.claude/worktrees/credits-ledger/web_ent/jusprin/ledger/models.py"},"caller":{"type":"direct"}},{"type":"tool_use","id":"toolu_01H98uvm5rDnV7oJE8N6Z64s","name":"Read","input":{"file_path":"/Users/kenneth/Projects/tsd-enterprise/.claude/worktrees/credits-ledger/web_ent/jusprin/v2/tests/test_ledger.py"},"caller":{"type":"direct"}},{"type":"tool_use","id":"toolu_01NAzJX9fyKTYDqn1Z483sZd","name":"Read","input":{"file_path":"/Users/kenneth/Projects/tsd-enterprise/.claude/worktrees/credits-ledger/web_ent/jusprin/ledger/reports.py","offset":60},"caller":{"type":"direct"}},{"type":"tool_use","id":"toolu_01SJDHBVjqikTLj6V1drCxcW","name":"Read","input":{"file_path":"/Users/kenneth/Projects/tsd-enterprise/.claude/worktrees/credits-ledger/web_ent/jusprin/v2/credits.py"},"caller":{"type":"direct"}}]}}
{"type":"api-request-blob","sessionId":"f57d8b7e-fd5a-4daf-9378-2e3d21342f7c","hash":"b15232624fce6d6a4239e5351ee5326f78f797a55e8de07cc5c281a2fb31f008","message":{"role":"user","content":[{"tool_use_id":"toolu_01UaBP2Adp4qazR2HdMak4Nr","type":"tool_result","content":"# JusPrin Cloud credits: implementation plan (working doc, 2026-11-01, order of work and readiness updated 2026-11-02; balances credits only since 2026-11-02 evening)\n\n**Decided 2026-11-02 evening, after Kenneth saw canvas version 73. These override anything below that says otherwise.**\n- Every credit is the same. There is no Standard-only lot. Any mention below of a `basic_only` flag, a \"trickle\" of Standard-only credits, \"Free Standard messages\" or \"Free Standard credits\" is superseded. free accounts (not subscribed) get 50 credits a month, expiring one month after grant, that pay for either tier; Kenneth to the design session: \"the 'everyone gets 50 credits' wording is wrong. I never said that.\" (Kenneth: \"let's just give free users 50/mo use-it-or-loose it credits\").\n- Workshop has no ceiling. Standard messages cost 0 credits on Workshop (Kenneth: \"no ceiling. It's probably easier just to say standard messages cost 0 credits\"). Anything below about 600, fair use, or a notice at 500 or 600 is superseded.\n- A balance is one number of credits, never a count of messages beside it. The panel shows one bar per lot, grouped only by when the credits expire: \"First-month credits · 62 of 500 left · Expires 1 Dec\", \"Bought credits · 500 of 500 left · Never expire\". Bought credits get a bar like the others (decision 13 closed).\n- \"New Standard chat\" and board 3d are gone: the case only existed because a Standard-only lot could not pay for an Expert chat. A chat that cannot be paid offers \"Get more credits\" only.\n- Prices in messages appear only on the picker options, the stop card for the chat's own tier, the pricing page's one sentence, the low-balance notice, and one scale line under the first-month offer (\"An Expert message is 5 credits\").\n- Kenneth reviewed the list of mechanisms that were mine, not his (2026-11-02, late evening). **Kept:** the launch offer (double credits on packs until a date); the low-balance notice, reworded to \"About 25 credits left\" (credits, not messages); \"Expiring credits are used first\" in the panel; the \"Alert me when a subscription would save me money\" switch, on by default; the Account page shape (30-day total, bar chart per day, table of chats); Standard as the default tier for a new chat after the first month; the v1 welcome-back fill-ins; the print-report form details; alias ids `slicer-1` and `slicer-basic` with image stripping. **Dropped:** the reverse savings alert and board 7c; the month-end and 7-day expiry notices (rule 4 on board 0 loses them); the daily cap on free app turns; the thinking picker on Standard (Expert only). **Expiry:** every expiring lot expires one month from the da\n- Free credits, ruled 2026-11-02 late: \"no 50 credits for first month. only 500 initial credits. pack holders also get 50 credits a month.\" So the 50 a month goes to every account not on a subscription, starting after the first month; a pack holder gets it; during the first month there is only the 500. The balance example on 2a, 4a and 4b is 62 first-month + 500 bought = 562, with no Free credits bar. Footer: \"After your first month, accounts without a plan get 50 free credits a month.\"\n\nUntracked working document. It turns the pricing plan Kenneth settled on 2026-11-01 into concrete work on the three codebases involved: the gateway in `tsd-enterprise` (`web_ent/jusprin/v2/`), the Obico server it is built on (`obico-server`, where the v1 credit table lives), and the desktop app (`src/slic3r/GUI/JusPrin/Agent/` and the Agent page under `AgentUI/`). Companion docs: `pricing-mental-model-2026-10.md`, `journey-cost-2026-10.md`, `obico-pro-pricing-data-2026-10.md`, `v1-pricing-data-2026-10.md`.\n\nEvery \"recommend\" below is my opinion; every \"decided\" is Kenneth's. Code facts were read from the checkouts on 2026-11-01 (tsd-enterprise master, JusPrin `jusprin-newui` at 69780c7af4, ops master).\n\n## 1. The plan being implemented\n\n- The unit is a **credit**, about 2 cents (decided 2026-11-01: \"credits\", not the placeholder \"coins\"). Credits pay per message, not per token. A **Standard** message (DeepSeek V4 Flash class) costs 1 credit; an **Expert** message (Claude Sonnet 5.5 class, not Opus) costs 5 credits. The 1:5 ratio is decided. A balance is shown in credits only, \"562 credits left\", never with a count of messages beside it (Kenneth, 2026-11-02: the two numbers together are confusing). Prices in messages appear only on the picker options, the stop card, the pricing page sentence and one scale line under the first-month offer.\n- **Pay as you go** (the pack): 500 credits for $10, never expire. Optional auto-reload at a discount.\n- **Hobby, $10 a month:** 750 credits, Standard messages cost credits, unused credits lost at the end of each month.\n- **Workshop, $20 a month:** 1,000 credits plus unlimited Standard messages, unused credits lost each month. Needs fair-use wording.\n- Plan names decided 2026-11-01: Hobby, Workshop, Pay as you go. No Pro, Plus or Premium, because Obico Pro exists next door.\n- **Obico subscribers:** 20% off both subscriptions.\n- **Your first month** (the sign-up grant, never called a trial): about $10 of credits (500), expiring after one month. **Trickle:** a free monthly Standard allowance for light users.\n- **Rewards:** credits of real value for a print report with a photo and detailed text, with a human review flag for bad ones.\n- **Launch period:** discounted, not free, credits.\n- **Alert:** tell the person when their usage has grown to where a subscription saves them money.\n- **BYOK** (the person's own API key) stays free with no sign-in.\n\n### The cost figures the margins rest on\n...\n1:#### pricing-implementation-plan-2026-11.md\n5:**Decided 2026-11-02 evening, after Kenneth saw canvas version 73. These override anything below that says otherwise.**\n48:#### pricing-touchpoints-design-2026-11.md\n52:**Decided 2026-11-02 evening, after Kenneth saw canvas version 73. These override anything below that says otherwise.**\n95:#### credits-and-onboarding-handoff-2026-11.md\n99:**Decided 2026-11-02 evening, after Kenneth saw canvas version 73. These override anything below that says otherwise.**\n# Where a person meets the credits, and how each point should feel (working doc, 2026-11-01, synced to canvas version 71; balances changed to credits only on 2026-11-02 evening, canvas update pending on 2026-11-02)\n\n**Decided 2026-11-02 evening, after Kenneth saw canvas version 73. These override anything below that says otherwise.**\n- Every credit is the same. There is no Standard-only lot. Any mention below of a `basic_only` flag, a \"trickle\" of Standard-only credits, \"Free Standard messages\" or \"Free Standard credits\" is superseded. free accounts (not subscribed) get 50 credits a month, expiring one month after grant, that pay for either tier; Kenneth to the design session: \"the 'everyone gets 50 credits' wording is wrong. I never said that.\" (Kenneth: \"let's just give free users 50/mo use-it-or-loose it credits\").\n- Workshop has no ceiling. Standard messages cost 0 credits on Workshop (Kenneth: \"no ceiling. It's probably easier just to say standard messages cost 0 credits\"). Anything below about 600, fair use, or a notice at 500 or 600 is superseded.\n- A balance is one number of credits, never a count of messages beside it. The panel shows one bar per lot, grouped only by when the credits expire: \"First-month credits · 62 of 500 left · Expires 1 Dec\", \"Bought credits · 500 of 500 left · Never expire\". Bought credits get a bar like the others (decision 13 closed).\n- \"New Standard chat\" and board 3d are gone: the case only existed because a Standard-only lot could not pay for an Expert chat. A chat that cannot be paid offers \"Get more credits\" only.\n- Prices in messages appear only on the picker options, the stop card for the chat's own tier, the pricing page's one sentence, the low-balance notice, and one scale line under the first-month offer (\"An Expert message is 5 credits\").\n- Kenneth reviewed the list of mechanisms that were mine, not his (2026-11-02, late evening). **Kept:** the launch offer (double credits on packs until a date); the low-balance notice, reworded to \"About 25 credits left\" (credits, not messages); \"Expiring credits are used first\" in the panel; the \"Alert me when a subscription would save me money\" switch, on by default; the Account page shape (30-day total, bar chart per day, table of chats); Standard as the default tier for a new chat after the first month; the v1 welcome-back fill-ins; the print-report form details; alias ids `slicer-1` and `slicer-basic` with image stripping. **Dropped:** the reverse savings alert and board 7c; the month-end and 7-day expiry notices (rule 4 on board 0 loses them); the daily cap on free app turns; the thinking picker on Standard (Expert only). **Expiry:** every expiring lot expires one month from the da\n- Free credits, ruled 2026-11-02 late: \"no 50 credits for first month. only 500 initial credits. pack holders also get 50 credits a month.\" So the 50 a month goes to every account not on a subscription, starting after the first month; a pack holder gets it; during the first month there is only the 500. The balance example on 2a, 4a and 4b is 62 first-month + 500 bought = 562, with no Free credits bar. Footer: \"After your first month, accounts without a plan get 50 free credits a month.\"\n\nUntracked design notes. The pricing plan is in `pricing-implementation-plan-2026-11.md`; this document is about the person, not the ledger. It lists every point in the product where someone meets credits, says what goes wrong there in other products, and gives one opinion per point. Kenneth reviewed the boards on the JusPrin v2 canvas (https://claude.ai/artifact/ENCtdaz7gjynfbcy4JYbWJ) between versions 54 and 70; the boards are now the source of truth and this document follows them. Captures are in `design-captures/credits-2026-11/` (`credits-00` to `credits-09`).\n\nWhere the boards live on the canvas (decided 2026-11-02: boards sit with the flow they change, not on a feature page): the onboarding boards (1a to 1d, 6a, 6b) on \"On boarding experience\"; the composer states (2a to 2c, 3a to 3d, 7a to 7c) on \"Compositions\" beside the Composer; the Account boards (4a to 4c) on \"Agent setup & Preferences\"; the report boards (8a to 8d) on \"Print history\". \"Credits & plans\" keeps only what has no flow of its own: the five rules (board 0), the pricing page (5a, 5b) and the states overview (9). Every board has \"Credits\" in its canvas name so a search finds the set.\n\nWhat the survey of other products (`pricing-case-studies-2026-10.md`) says goes wrong, in one list: people cannot picture what an abstract credit buys; two kinds of credit with different expiry rules confuse everyone; the anger is at the boundary, when something they were doing stops; a balance that drops for reasons they did not cause breeds distrust; \"unlimited\" with an unstated ceiling is read as a lie once reached.\n\n## Five rules that apply at every point (board 0)\n\n1. **One word, one unit, credits only.** \"Credits\" (decided 2026-11-01), never coins, never tokens. A balance is a number of credits and nothing else: \"562 credits left.\" Kenneth, 2026-11-02: showing a count of messages beside the credits is confusing; consolidate everything into credits. (Canvas versions up to 71 and my earlier drafts put \"That is 612 Standard or 112 Expert messages\" under every balance; that was my addition, never his decision, and it is gone.) The translation into messages appears only where the person chooses or is stopped: the picker options, the stop card for the chat's own tier, the pricing page's one sentence, and one scale line under the first-month offer (\"An Expert message is 5 credits\"). The low-balance notice \"About 25 credits left\" stays, because there the person needs to know how many turns this chat has left. A price never stands alone: \"1 credit\" confuse","is_error":false},{"tool_use_id":"toolu_01XX8Exps8euyb23hNCFZSLw","type":"tool_result","content":"1\t\"\"\"Charging a turn against a person's lots of credits.\n2\t\n3\tThe app also starts turns by itself (the file-opened report, the slice-finished\n4\tnote). Those run on Expert at no credits up to a daily ceiling, then cost what a\n5\tbasic message costs. Everything else costs the alias's price, except a basic\n6\tmessage on an active Workshop plan, which is free up to the fair-use ceiling.\n7\t\"\"\"\n8\tfrom dataclasses import dataclass\n9\tfrom datetime import datetime, timedelta, timezone as dt_timezone\n10\tfrom typing import Dict, List, Optional\n11\t\n12\tfrom django.conf import settings\n13\tfrom django.db import transaction\n14\tfrom django.db.models import F, Q\n15\tfrom django.utils import timezone\n16\t\n17\tfrom jusprin.models import JusPrinPlan\n18\tfrom .models import CreditAllocation, CreditCharge, CreditGrant\n19\t\n20\t\n21\tclass CreditsExhausted(Exception):\n22\t    \"\"\"The next turn cannot be paid. balance is what can pay this alias, so an\n23\t    Expert chat's card never counts the free Standard messages it cannot spend.\"\"\"\n24\t\n25\t    def __init__(self, balance: int, cost: int, basic_only_credits: int, affordable_aliases: List[str],\n26\t                 plan: Optional[str]):\n27\t        super().__init__(f'{cost} credits needed, {balance} available')\n28\t        self.balance = balance\n29\t        self.cost = cost\n30\t        self.basic_only_credits = basic_only_credits\n31\t        self.affordable_aliases = affordable_aliases\n32\t        self.plan = plan\n33\t\n34\t    def details(self) -> Dict:\n35\t        return {\n36\t            'balance': self.balance,\n37\t            'cost': self.cost,\n38\t            'basic_only_credits': self.basic_only_credits,\n39\t            'affordable_aliases': self.affordable_aliases,\n40\t            'plan': self.plan,\n41\t        }\n42\t\n43\t\n44\t@dataclass(frozen=True)\n45\tclass Balance:\n46\t    total: int\n47\t    basic_only: int\n48\t\n49\t    def payable(self, tier: str) -> int:\n50\t        return self.total if tier == CreditCharge.BASIC else self.total - self.basic_only\n51\t\n52\t\n53\tdef _first_of_next_month(now: datetime) -> datetime:\n54\t    utc = now.astimezone(dt_timezone.utc)\n55\t    year, month = (utc.year + 1, 1) if utc.month == 12 else (utc.year, utc.month + 1)\n56\t    return datetime(year, month, 1, tzinfo=dt_timezone.utc)\n57\t\n58\t\n59\tdef ensure_lots(user_id: int, now: datetime = None) -> None:\n60\t    \"\"\"Creates the lots nobody buys: the first month's, once per account, and\n61\t    this month's free Standard messages. Lazy, in place of a monthly sweep over\n62\t    every account. Concurrent first requests meet on the unique source_ref.\"\"\"\n63\t    now = now or timezone.now()\n64\t    CreditGrant.objects.get_or_create(user_id=user_id, source_ref='signup', defaults={\n65\t        'kind': CreditGrant.SIGNUP,\n66\t        'credits_granted': settings.JUSPRIN_V2_SIGNUP_CREDITS,\n67\t        'credits_remaining': settings.JUSPRIN_V2_SIGNUP_CREDITS,\n68\t        'expires_at': now + timedelta(days=settings.JUSPRIN_V2_SIGNUP_DAYS),\n69\t    })\n70\t    utc = now.astimezone(dt_timezone.utc)\n71\t    CreditGrant.objects.get_or_create(user_id=user_id, source_ref=f'trickle:{utc:%Y-%m}', defaults={\n72\t        'kind': CreditGrant.TRICKLE,\n73\t        'credits_granted': settings.JUSPRIN_V2_TRICKLE_CREDITS,\n74\t        'credits_remaining': settings.JUSPRIN_V2_TRICKLE_CREDITS,\n75\t        'expires_at': _first_of_next_month(now),\n76\t        'basic_only': True,\n77\t    })\n78\t\n79\t\n80\tdef live_lots(user_id: int, now: datetime):\n81\t    \"\"\"The lots still counting, in draw order: the soonest to expire first,\n82\t    never-expiring last, oldest first within one expiry.\"\"\"\n83\t    return (CreditGrant.objects\n84\t            .filter(Q(expires_at__isnull=True) | Q(expires_at__gt=now), user_id=user_id)\n85\t            .order_by(F('expires_at').asc(nulls_last=True), 'created_at', 'id'))\n86\t\n87\t\n88\tdef balance_of(lots) -> Balance:\n89\t    return Balance(total=sum(lot.credits_remaining for lot in lots),\n90\t                   basic_only=sum(lot.credits_remaining for lot in lots if lot.basic_only))\n91\t\n92\t\n93\tdef active_v2_plan(user_id: int) -> Optional[JusPrinPlan]:\n94\t    plan = JusPrinPlan.objects.filter(user_id=user_id).first()\n95\t    if plan is None or not plan.is_active or plan.plan_id not in settings.JUSPRIN_V2_PLANS:\n96\t        return None\n97\t    return plan\n98\t\n99\t\n100\tdef basic_used_this_term(user_id: int, plan: JusPrinPlan, now: datetime) -> int:\n101\t    start = plan.current_term_start or now - timedelta(days=30)\n102\t    return CreditCharge.objects.filter(user_id=user_id, tier=CreditCharge.BASIC, origin=CreditCharge.PERSON,\n103\t                                       created_at__gte=start).count()\n104\t\n105\t\n106\tdef _basic_is_free(user_id: int, plan: Optional[JusPrinPlan], now: datetime) -> bool:\n107\t    if plan is None or not settings.JUSPRIN_V2_PLANS[plan.plan_id].get('unlimited_basic'):\n108\t        return False\n109\t    return basic_used_this_term(user_id, plan, now) < settings.JUSPRIN_V2_WORKSHOP_BASIC_FAIR_USE\n110\t\n111\t\n112\tdef _price(user_id, alias, origin, plan, now):\n113\t    \"\"\"The tier a turn is charged as, and its credits.\"\"\"\n114\t    if origin == CreditCharge.APP:\n115\t        free_today = CreditCharge.objects.filter(user_id=user_id, origin=CreditCharge.APP, credits=0,\n116\t                                                 created_at__gte=now - timedelta(hours=24)).count()\n117\t        if free_today < settings.JUSPRIN_V2_FREE_APP_TURNS_PER_DAY:\n118\t            return alias.tier, 0\n119\t        return CreditCharge.BASIC, settings.JUSPRIN_V2_APP_TURN_CREDITS_PAST_CEILING\n120\t    if alias.tier == CreditCharge.BASIC and _basic_is_free(user_id, plan, now):\n121\t        return alias.tier, 0\n122\t    return alias.tier, alias.credits\n123\t\n124\t\n125\tdef _affordable(balance, aliases, user_id, plan, now) -> List[str]:\n126\t    free_basic = _basic_is_free(user_id, plan, now)\n127\t    return [alias.id for alias in aliases.values()\n128\t            if (free_basic and alias.tier == CreditCharge.BASIC) or balance.payable(alias.tier) >= alias.credits]\n129\t\n130\t\n131\tdef charge_turn(user_id: int, turn_id: str, alias, origin: str, aliases: Dict, chat_id: str = None) -> CreditCharge:\n132\t    \"\"\"Charges a turn once, whatever retries its first request. Raises\n133\t    CreditsExhausted with nothing written when the lots cannot pay.\"\"\"\n134\t    now = timezone.now()\n135\t    ensure_lots(user_id, now)\n136\t    with transaction.atomic():\n137\t        # Holding every live lot, spent ones too, serialises all of a person's\n138\t        # charges: this month's free lot always exists, so there is always a row.\n139\t        lots = list(live_lots(user_id, now).select_for_update())\n140\t        existing = CreditCharge.objects.filter(user_id=user_id, turn_id=turn_id).first()\n141\t        if existing is not None:\n142\t            return existing\n143\t\n144\t        plan = active_v2_plan(user_id)\n145\t        tier, cost = _price(user_id, alias, origin, plan, now)\n146\t        balance = balance_of(lots)\n147\t        if balance.payable(tier) < cost:\n148\t            raise CreditsExhausted(balance.payable(tier), cost, balance.basic_only,\n149\t                                   _affordable(balance, aliases, user_id, plan, now),\n150\t                                   plan.plan_id if plan else None)\n151\t\n152\t        charge = CreditCharge.objects.create(user_id=user_id, turn_id=turn_id, chat_id=chat_id, alias=alias.id,\n153\t                                             tier=tier, credits=cost, origin=origin)\n154\t        left = cost\n155\t        for lot in lots:\n156\t            if left == 0:\n157\t                break\n158\t            if lot.credits_remaining <= 0 or (lot.basic_only and tier != CreditCharge.BASIC):\n159\t                continue\n160\t            taken = min(left, lot.credits_remaining)\n161\t            lot.credits_remaining -= taken\n162\t            lot.save(update_fields=['credits_remaining'])\n163\t            CreditAllocation.objects.create(charge=charge, grant=lot, credits=taken)\n164\t            left -= taken\n165\t    return charge\n166\t"},{"tool_use_id":"toolu_01X8sjBELKaqMirKN6vwu4G1","type":"tool_result","content":"1\t\"\"\"What GET /ent/jusprin/v2/account answers: numbers and names only, so the app\n2\tcan keep reading it for years.\"\"\"\n3\tfrom datetime import timedelta\n4\tfrom typing import Dict, Optional\n5\t\n6\tfrom django.conf import settings\n7\tfrom django.db.models import Count, Sum\n8\tfrom django.db.models.functions import TruncDate\n9\tfrom django.utils import timezone\n10\t\n11\tfrom app_ent.models import Subscription\n12\tfrom jusprin.models import JusPrinPlan\n13\tfrom .ledger import active_v2_plan, basic_used_this_term, ensure_lots, live_lots\n14\tfrom .models import CreditCharge, CreditGrant\n15\tfrom .reports import report_activity\n16\t\n17\tUSAGE_DAYS = 30\n18\t\n19\t\n20\tdef _lot(grant: CreditGrant) -> Dict:\n21\t    lot = {\n22\t        'kind': grant.kind,\n23\t        'credits': grant.credits_remaining,\n24\t        'granted': grant.credits_granted,\n25\t        'expires_at': grant.expires_at.isoformat() if grant.expires_at else None,\n26\t    }\n27\t    if grant.basic_only:\n28\t        lot['basic_only'] = True\n29\t    return lot\n30\t\n31\t\n32\tdef _plan(user, now) -> Optional[Dict]:\n33\t    plan = active_v2_plan(user.id)\n34\t    if plan is None:\n35\t        return None\n36\t    spec = settings.JUSPRIN_V2_PLANS[plan.plan_id]\n37\t    subscription = Subscription.objects.filter(user=user).first()\n38\t    answer = {\n39\t        'id': plan.plan_id,\n40\t        'name': spec['name'],\n41\t        'renews_at': plan.current_term_end.isoformat() if plan.current_term_end else None,\n42\t        'unlimited_basic': bool(spec.get('unlimited_basic')),\n43\t        'obico_discount': bool(subscription and subscription.active()),\n44\t        'auto_reload': False,\n45\t    }\n46\t    if answer['unlimited_basic']:\n47\t        answer['basic_used_this_term'] = basic_used_this_term(user.id, plan, now)\n48\t        answer['basic_fair_use'] = settings.JUSPRIN_V2_WORKSHOP_BASIC_FAIR_USE\n49\t    return answer\n50\t\n51\t\n52\tdef _v1_subscription(user) -> Optional[Dict]:\n53\t    \"\"\"The v1 subscription a person keeps the price of, for the welcome-back\n54\t    window. Read only: moving them to Hobby is billing's work.\"\"\"\n55\t    plan = JusPrinPlan.objects.filter(user=user).first()\n56\t    if plan is None or not plan.is_active or plan.plan_id not in settings.JUSPRIN_V1_PLANS:\n57\t        return None\n58\t    return {'plan_id': plan.plan_id, **settings.JUSPRIN_V1_PLANS[plan.plan_id]}\n59\t\n60\t\n61\tdef _usage(user, now) -> Dict:\n62\t    charges = CreditCharge.objects.filter(user=user, created_at__gte=now - timedelta(days=USAGE_DAYS))\n63\t    by_tier = {row['tier']: row for row in charges.values('tier').annotate(turns=Count('id'), credits=Sum('credits'))}\n64\t    dated = charges.annotate(date=TruncDate('created_at'))\n65\t    days = dated.values('date').annotate(credits=Sum('credits')).order_by('date')\n66\t    # The gateway never sees a chat's title, so a row names the chat by its id.\n67\t    rows = dated.values('date', 'chat_id', 'tier').annotate(messages=Count('id'), credits=Sum('credits'))\n68\t    activity = [{'date': row['date'].isoformat(), 'chat_id': row['chat_id'], 'tier': row['tier'],\n69\t                 'messages': row['messages'], 'credits': row['credits']} for row in rows]\n70\t    activity += report_activity(user, now - timedelta(days=USAGE_DAYS))\n71\t    activity.sort(key=lambda row: row['date'], reverse=True)\n72\t    return {\n73\t        'basic_turns': by_tier.get(CreditCharge.BASIC, {}).get('turns', 0),\n74\t        'expert_turns': by_tier.get(CreditCharge.EXPERT, {}).get('turns', 0),\n75\t        'credits': sum(row['credits'] for row in by_tier.values()),\n76\t        'days': [{'date': row['date'].isoformat(), 'credits': row['credits']} for row in days],\n77\t        'activity': activity,\n78\t    }\n79\t\n80\t\n81\tdef account(user) -> Dict:\n82\t    now = timezone.now()\n83\t    ensure_lots(user.id, now)\n84\t    # A spent lot that still has an expiry keeps its bar (\"0 of 500 left\"); a\n85\t    # spent lot that never expires has nothing left to say.\n86\t    lots = [lot for lot in live_lots(user.id, now)\n87\t            if lot.credits_remaining > 0 or (lot.expires_at is not None and lot.kind != CreditGrant.ADJUSTMENT)]\n88\t    return {\n89\t        'credits': {'total': sum(lot.credits_remaining for lot in lots), 'lots': [_lot(lot) for lot in lots]},\n90\t        'plan': _plan(user, now),\n91\t        'v1_subscription': _v1_subscription(user),\n92\t        'prices': {\n93\t            'credit_cents': settings.JUSPRIN_V2_CREDIT_CENTS,\n94\t            'pack': settings.JUSPRIN_V2_PACK,\n95\t            'plans': [{'id': plan_id, **spec} for plan_id, spec in settings.JUSPRIN_V2_PLANS.items()],\n96\t        },\n97\t        'usage_30d': _usage(user, now),\n98\t        'suggestion': None,\n99\t    }\n100\t"},{"tool_use_id":"toolu_01P2djqjZYntPsSGBqZM9bLZ","type":"tool_result","content":"1\t\"\"\"The credit ledger: lots of credits and what each charged turn took from them.\n2\t\n3\tBalance is the sum of the lots still live, never a stored number, and a lot's\n4\texpiry is a comparison at read and charge time, so a lot simply stops counting.\n5\t\"\"\"\n6\tfrom django.conf import settings\n7\tfrom django.db import models\n8\t\n9\t\n10\tclass CreditGrant(models.Model):\n11\t    \"\"\"One lot of credits.\"\"\"\n12\t    PACK = 'pack'\n13\t    SUBSCRIPTION = 'subscription'\n14\t    SIGNUP = 'signup'\n15\t    TRICKLE = 'trickle'\n16\t    REWARD = 'reward'\n17\t    LAUNCH_BONUS = 'launch_bonus'\n18\t    ADJUSTMENT = 'adjustment'\n19\t    KINDS = [(k, k) for k in (PACK, SUBSCRIPTION, SIGNUP, TRICKLE, REWARD, LAUNCH_BONUS, ADJUSTMENT)]\n20\t\n21\t    user = models.ForeignKey(settings.AUTH_USER_MODEL, on_delete=models.CASCADE)\n22\t    kind = models.CharField(max_length=16, choices=KINDS)\n23\t    credits_granted = models.IntegerField()\n24\t    credits_remaining = models.IntegerField()\n25\t    expires_at = models.DateTimeField(null=True, blank=True)  # null: never\n26\t    basic_only = models.BooleanField(default=False)  # pays basic turns only\n27\t    # What makes the lot one of a kind for this person: signup, trickle:<yyyy-mm>,\n28\t    # report:<print report id>, and the invoice and subscription refs of billing.\n29\t    source_ref = models.CharField(max_length=128)\n30\t    created_at = models.DateTimeField(auto_now_add=True)\n31\t\n32\t    class Meta:\n33\t        constraints = [models.UniqueConstraint(fields=['user', 'source_ref'], name='jusprin_credit_grant_once')]\n34\t        indexes = [models.Index(fields=['user', 'expires_at'])]\n35\t\n36\t    def __str__(self):\n37\t        return f'{self.user_id} {self.source_ref}: {self.credits_remaining}/{self.credits_granted}'\n38\t\n39\t\n40\tclass CreditCharge(models.Model):\n41\t    \"\"\"One per charged turn. credits is 0 for a turn covered by unlimited basic\n42\t    or a free app turn.\"\"\"\n43\t    BASIC = 'basic'\n44\t    EXPERT = 'expert'\n45\t    TIERS = [(BASIC, BASIC), (EXPERT, EXPERT)]\n46\t    PERSON = 'person'\n47\t    APP = 'app'\n48\t    ORIGINS = [(PERSON, PERSON), (APP, APP)]\n49\t\n50\t    user = models.ForeignKey(settings.AUTH_USER_MODEL, on_delete=models.CASCADE)\n51\t    turn_id = models.CharField(max_length=128)\n52\t    chat_id = models.CharField(max_length=32, null=True, blank=True)\n53\t    alias = models.CharField(max_length=64)\n54\t    tier = models.CharField(max_length=8, choices=TIERS)\n55\t    credits = models.IntegerField()\n56\t    origin = models.CharField(max_length=8, choices=ORIGINS)\n57\t    created_at = models.DateTimeField(auto_now_add=True)\n58\t\n59\t    class Meta:\n60\t        constraints = [models.UniqueConstraint(fields=['user', 'turn_id'], name='jusprin_credit_charge_once')]\n61\t        indexes = [models.Index(fields=['user', 'created_at'])]\n62\t\n63\t    def __str__(self):\n64\t        return f'{self.user_id} {self.turn_id}: {self.credits}'\n65\t\n66\t\n67\tclass CreditAllocation(models.Model):\n68\t    \"\"\"Which lots paid a charge.\"\"\"\n69\t    charge = models.ForeignKey(CreditCharge, on_delete=models.CASCADE, related_name='allocations')\n70\t    grant = models.ForeignKey(CreditGrant, on_delete=models.CASCADE, related_name='allocations')\n71\t    credits = models.IntegerField()\n72\t\n73\t\n74\tclass PrintReport(models.Model):\n75\t    \"\"\"What a person says about how a sliced print came out: the training-data\n76\t    channel, so it has its own table rather than a place in the gateway's chats.\"\"\"\n77\t    WORKED = 'worked'\n78\t    PARTLY = 'partly'\n79\t    FAILED = 'failed'\n80\t    OUTCOMES = [(k, k) for k in (WORKED, PARTLY, FAILED)]\n81\t\n82\t    user = models.ForeignKey(settings.AUTH_USER_MODEL, on_delete=models.CASCADE)\n83\t    gcode_hash = models.CharField(max_length=128)\n84\t    outcome = models.CharField(max_length=16, choices=OUTCOMES)\n85\t    text = models.TextField()\n86\t    # Sent by the app with the report: printer, material, process, slice\n87\t    # statistics, manufacturing input hash, and the project's name for the row.\n88\t    facts = models.JSONField(default=dict, blank=True)\n89\t    photos = models.JSONField(default=list)  # the stored photos' URLs\n90\t    rewarded = models.BooleanField(default=False)\n91\t    created_at = models.DateTimeField(auto_now_add=True)\n92\t\n93\t    class Meta:\n94\t        constraints = [models.UniqueConstraint(fields=['user', 'gcode_hash'], name='jusprin_print_report_once')]\n95\t        indexes = [models.Index(fields=['user', 'created_at'])]\n96\t\n97\t    def __str__(self):\n98\t        return f'{self.user_id} {self.gcode_hash}: {self.outcome}'\n99\t\n100\t\n101\tclass PrintReportReview(models.Model):\n102\t    \"\"\"A person at Obico read the report. Invalid takes its reward back, once.\"\"\"\n103\t    report = models.OneToOneField(PrintReport, on_delete=models.CASCADE)\n104\t    invalid = models.BooleanField(default=False)\n105\t    note = models.CharField(max_length=500, blank=True)  # shown to the person as the reason\n106\t    created_at = models.DateTimeField(auto_now_add=True)\n107\t"},{"tool_use_id":"toolu_01H98uvm5rDnV7oJE8N6Z64s","type":"tool_result","content":"1\t\"\"\"The credit ledger against a real database: draw order, expiry, what a turn\n2\tcosts, and the concurrency select_for_update is there for.\"\"\"\n3\timport json\n4\timport threading\n5\timport uuid\n6\tfrom datetime import datetime, timedelta, timezone as dt_timezone\n7\tfrom unittest import mock\n8\t\n9\tfrom django.db import close_old_connections, connection\n10\tfrom django.test import Client, TestCase, TransactionTestCase, override_settings\n11\tfrom django.utils import timezone\n12\tfrom oauth2_provider.models import AccessToken, Application\n13\t\n14\tfrom app.models import Syndicate, User\n15\tfrom jusprin.ledger import ledger\n16\tfrom jusprin.ledger.account import account\n17\tfrom jusprin.ledger.ledger import CreditsExhausted, charge_turn, ensure_lots\n18\tfrom jusprin.ledger.models import CreditAllocation, CreditCharge, CreditGrant\n19\tfrom jusprin.models import JusPrinPlan\n20\tfrom jusprin.v2.aliases import parse_aliases\n21\tfrom jusprin.v2.upstream import IMAGE_NOTE, prepare\n22\t\n23\tfrom .test_gateway import UPSTREAM\n24\t\n25\t\n26\tdef two_aliases(basic_images=False):\n27\t    def alias(alias_id, tier, credits, images, fmt):\n28\t        return {\n29\t            'id': alias_id, 'label': alias_id, 'tier': tier, 'credits': credits,\n30\t            'efforts': ['fast'], 'default_effort': 'fast',\n31\t            'backends': {fmt: {'base_url': UPSTREAM, 'model': f'up-{alias_id}', 'api_key_env': 'TEST_KEY',\n32\t                               'effort_map': {'fast': 'low'}, 'images': images}},\n33\t            'groups': [{'name': 'main', 'format': fmt, 'percent': 100}],\n34\t        }\n35\t    return json.dumps({'aliases': [alias('slicer-1', 'expert', 5, True, 'anthropic'),\n36\t                                   alias('slicer-basic', 'basic', 1, basic_images, 'responses')]})\n37\t\n38\t\n39\tALIASES = parse_aliases(two_aliases())\n40\tEXPERT = ALIASES['slicer-1']\n41\tBASIC = ALIASES['slicer-basic']\n42\t\n43\t\n44\tdef new_user():\n45\t    return User.objects.create(email=f'ledger-{uuid.uuid4().hex[:8]}@example.com')\n46\t\n47\t\n48\tdef charge(user, turn, alias=EXPERT, origin=CreditCharge.PERSON):\n49\t    return charge_turn(user.id, turn, alias, origin, ALIASES)\n50\t\n51\t\n52\tclass LedgerTestCase(TestCase):\n53\t    def setUp(self):\n54\t        self.user = new_user()\n55\t        ensure_lots(self.user.id)\n56\t        self.signup = self.lot('signup')\n57\t        self.trickle = CreditGrant.objects.get(user=self.user, kind=CreditGrant.TRICKLE)\n58\t\n59\t    def lot(self, source_ref):\n60\t        return CreditGrant.objects.get(user=self.user, source_ref=source_ref)\n61\t\n62\t    def add_lot(self, kind, credits, source_ref, expires_at=None, basic_only=False):\n63\t        return CreditGrant.objects.create(user=self.user, kind=kind, credits_granted=credits,\n64\t                                          credits_remaining=credits, source_ref=source_ref,\n65\t                                          expires_at=expires_at, basic_only=basic_only)\n66\t\n67\t    def left(self, lot):\n68\t        lot.refresh_from_db()\n69\t        return lot.credits_remaining\n70\t\n71\t    def set_left(self, lot, credits):\n72\t        CreditGrant.objects.filter(pk=lot.pk).update(credits_remaining=credits)\n73\t\n74\t\n75\tclass FirstContactTests(LedgerTestCase):\n76\t    def test_a_new_person_gets_500_for_30_days_and_this_months_free_messages(self):\n77\t        self.assertEqual((self.signup.kind, self.signup.credits_granted, self.signup.basic_only), ('signup', 500, False))\n78\t        self.assertAlmostEqual(self.signup.expires_at, timezone.now() + timedelta(days=30), delta=timedelta(minutes=1))\n79\t        self.assertEqual((self.trickle.credits_granted, self.trickle.basic_only), (50, True))\n80\t\n81\t    def test_the_first_month_is_once_per_account(self):\n82\t        self.set_left(self.signup, 0)\n83\t        CreditGrant.objects.filter(pk=self.signup.pk).update(expires_at=timezone.now() - timedelta(days=1))\n84\t        ensure_lots(self.user.id)\n85\t        self.assertEqual(CreditGrant.objects.filter(user=self.user, kind=CreditGrant.SIGNUP).count(), 1)\n86\t\n87\t    def test_the_free_messages_expire_at_the_month_end_and_a_new_lot_follows(self):\n88\t        now = datetime(2026, 12, 15, 12, tzinfo=dt_timezone.utc)\n89\t        ensure_lots(self.user.id, now)\n90\t        december = self.lot('trickle:2026-12')\n91\t        self.assertEqual(december.expires_at, datetime(2027, 1, 1, tzinfo=dt_timezone.utc))\n92\t        ensure_lots(self.user.id, now)\n93\t        self.assertEqual(CreditGrant.objects.filter(user=self.user, source_ref='trickle:2026-12').count(), 1)\n94\t\n95\t\n96\tclass DrawOrderTests(LedgerTestCase):\n97\t    def test_soonest_to_expire_first_never_expiring_last(self):\n98\t        pack = self.add_lot('pack', 100, 'inv:1')\n99\t        term = self.add_lot('subscription', 100, 'sub:1:credits', expires_at=timezone.now() + timedelta(days=60))\n100\t        charge(self.user, 't1', BASIC)\n101\t        self.assertEqual(self.left(self.trickle), 49)\n102\t        self.set_left(self.trickle, 0)\n103\t        charge(self.user, 't2', EXPERT)\n104\t        self.assertEqual((self.left(self.signup), self.left(term), self.left(pack)), (495, 100, 100))\n105\t        self.set_left(self.signup, 2)\n106\t        charge(self.user, 't3', EXPERT)\n107\t        self.assertEqual((self.left(self.signup), self.left(term), self.left(pack)), (0, 97, 100))\n108\t        allocations = {a.grant_id: a.credits for a in CreditAllocation.objects.filter(charge__turn_id='t3')}\n109\t        self.assertEqual(allocations, {self.signup.id: 2, term.id: 3})\n110\t\n111\t    def test_oldest_first_within_one_expiry(self):\n112\t        self.set_left(self.signup, 0)\n113\t        self.set_left(self.trickle, 0)\n114\t        older = self.add_lot('reward', 3, 'report:1')\n115\t        newer = self.add_lot('pack', 10, 'inv:1')\n116\t        charge(self.user, 't1', EXPERT)\n117\t        self.assertEqual((self.left(older), self.left(newer)), (0, 8))\n118\t\n119\t    def test_expert_skips_the_free_standard_messages(self):\n120\t        self.set_left(self.signup, 4)\n121\t        with self.assertRaises(CreditsExhausted) as caught:\n122\t            charge(self.user, 't1', EXPERT)\n123\t        self.assertEqual(caught.exception.details(), {\n124\t            'balance': 4, 'cost': 5, 'basic_only_credits': 50, 'affordable_aliases': ['slicer-basic'], 'plan': None})\n125\t        self.assertEqual(self.left(self.trickle), 50)\n126\t        self.assertFalse(CreditCharge.objects.filter(user=self.user).exists())\n127\t\n128\t    def test_expiry_is_exclusive_at_the_boundary(self):\n129\t        now = timezone.now()\n130\t        with mock.patch.object(ledger.timezone, 'now', return_value=now):\n131\t            CreditGrant.objects.filter(pk=self.signup.pk).update(expires_at=now)\n132\t            self.set_left(self.trickle, 0)\n133\t            with self.assertRaises(CreditsExhausted):\n134\t                charge(self.user, 't1', EXPERT)\n135\t            CreditGrant.objects.filter(pk=self.signup.pk).update(expires_at=now + timedelta(microseconds=1))\n136\t            self.assertEqual(charge(self.user, 't2', EXPERT).credits, 5)\n137\t\n138\t\n139\tclass WhatATurnCostsTests(LedgerTestCase):\n140\t    def test_a_retried_turn_pays_once(self):\n141\t        first = charge(self.user, 't1')\n142\t        self.assertEqual(charge(self.user, 't1').pk, first.pk)\n143\t        self.assertEqual(self.left(self.signup), 495)\n144\t\n145\t    def test_a_retried_turn_is_not_refused_once_the_credits_are_gone(self):\n146\t        charge(self.user, 't1')\n147\t        self.set_left(self.signup, 0)\n148\t        self.assertEqual(charge(self.user, 't1').credits, 5)\n149\t\n150\t    @override_settings(JUSPRIN_V2_FREE_APP_TURNS_PER_DAY=2)\n151\t    def test_app_turns_are_free_up_to_the_daily_ceiling_then_cost_a_basic_message(self):\n152\t        for turn in ('a1', 'a2'):\n153\t            self.assertEqual(charge(self.user, turn, EXPERT, CreditCharge.APP).credits, 0)\n154\t        self.assertEqual((self.left(self.signup), self.left(self.trickle)), (500, 50))\n155\t        past = charge(self.user, 'a3', EXPERT, CreditCharge.APP)\n156\t        self.assertEqual((past.credits, past.tier, past.alias), (1, 'basic', 'slicer-1'))\n157\t        self.assertEqual(self.left(self.trickle), 49)\n158\t\n159\t    @override_settings(JUSPRIN_V2_FREE_APP_TURNS_PER_DAY=1)\n160\t    def test_the_ceiling_counts_the_last_24_hours(self):\n161\t        old = charge(self.user, 'a1', EXPERT, CreditCharge.APP)\n162\t        CreditCharge.objects.filter(pk=old.pk).update(created_at=timezone.now() - timedelta(hours=25))\n163\t        self.assertEqual(charge(self.user, 'a2', EXPERT, CreditCharge.APP).credits, 0)\n164\t\n165\t    def workshop(self, **fields):\n166\t        JusPrinPlan.objects.update_or_create(user=self.user, defaults={\n167\t            'plan_id': 'jusprin-workshop-monthly', 'external_id': 'x', 'external_user_id': 'y',\n168\t            'current_term_start': timezone.now() - timedelta(days=3), **fields})\n169\t\n170\t    @override_settings(JUSPRIN_V2_WORKSHOP_BASIC_FAIR_USE=2)\n171\t    def test_workshop_standard_is_free_up_to_fair_use_then_one_credit(self):\n172\t        self.workshop()\n173\t        self.assertEqual([charge(self.user, f'b{i}', BASIC).credits for i in range(3)], [0, 0, 1])\n174\t        self.assertEqual(charge(self.user, 'e1', EXPERT).credits, 5)\n175\t\n176\t    def test_a_lapsed_workshop_pays_like_anyone(self):\n177\t        self.workshop(expired_at=timezone.now() - timedelta(days=1))\n178\t        self.assertEqual(charge(self.user, 'b1', BASIC).credits, 1)\n179\t\n180\t    def test_hobby_has_no_free_standard(self):\n181\t        JusPrinPlan.objects.create(user=self.user, plan_id='jusprin-hobby-monthly', external_id='x', external_user_id='y')\n182\t        self.assertEqual(charge(self.user, 'b1', BASIC).credits, 1)\n183\t\n184\t    def test_an_exhausted_workshop_can_still_afford_standard(self):\n185\t        self.workshop()\n186\t        self.set_left(self.signup, 0)\n187\t        self.set_left(self.trickle, 0)\n188\t        with self.assertRaises(CreditsExhausted) as caught:\n189\t            charge(self.user, 'e1', EXPERT)\n190\t        self.assertEqual(caught.exception.affordable_aliases, ['slicer-basic'])\n191\t        self.assertEqual(caught.exception.plan, 'jusprin-workshop-monthly')\n192\t\n193\t\n194\tclass ConcurrentChargeTests(TransactionTestCase):\n195\t    # Real commits, so a second connection sees them. The flush after each test\n196\t    # also takes the row migrations made, which every new user points at.\n197\t    def setUp(self):\n198\t        Syndicate.objects.get_or_create(id=1, defaults={'name': 'base'})\n199\t\n200\t    def test_two_turns_cannot_both_spend_the_last_credits_of_one_lot(self):\n201\t        user = new_user()\n202\t        ensure_lots(user.id)\n203\t        CreditGrant.objects.filter(user=user, kind=CreditGrant.SIGNUP).update(credits_remaining=5)\n204\t        self.run_at_once(user, ['t1', 't2'])\n205\t        self.assertEqual(self.outcomes.count('charged'), 1)\n206\t        self.assertEqual(self.outcomes.count('exhausted'), 1)\n207\t        self.assertEqual(CreditGrant.objects.get(user=user, kind=CreditGrant.SIGNUP).credits_remaining, 0)\n208\t        self.assertEqual(CreditCharge.objects.filter(user=user).count(), 1)\n209\t\n210\t    def test_two_first_requests_of_a_new_person_make_one_first_month(self):\n211\t        user = new_user()\n212\t        self.run_at_once(user, ['t1', 't2'])\n213\t        self.assertEqual(self.outcomes, ['charged', 'charged'])\n214\t        self.assertEqual(CreditGrant.objects.get(user=user, kind=CreditGrant.SIGNUP).credits_remaining, 490)\n215\t\n216\t    def test_one_turn_sent_twice_at_once_pays_once(self):\n217\t        user = new_user()\n218\t        ensure_lots(user.id)\n219\t        self.run_at_once(user, ['same', 'same'])\n220\t        self.assertEqual(self.outcomes, ['charged', 'charged'])\n221\t        self.assertEqual(CreditGrant.objects.get(user=user, kind=CreditGrant.SIGNUP).credits_remaining, 495)\n222\t\n223\t    def run_at_once(self, user, turns):\n224\t        barrier = threading.Barrier(len(turns))\n225\t        self.outcomes = []\n226\t\n227\t        def run(turn):\n228\t            try:\n229\t                barrier.wait(timeout=10)\n230\t                charge(user, turn)\n231\t                self.outcomes.append('charged')\n232\t            except CreditsExhausted:\n233\t                self.outcomes.append('exhausted')\n234\t            finally:\n235\t                connection.close()\n236\t\n237\t        threads = [threading.Thread(target=run, args=(turn,)) for turn in turns]\n238\t        for thread in threads:\n239\t            thread.start()\n240\t        for thread in threads:\n241\t            thread.join(timeout=30)\n242\t        close_old_connections()\n243\t\n244\t\n245\tclass AccountTests(LedgerTestCase):\n246\t    def test_lots_come_soonest_first_with_what_each_was_granted(self):\n247\t        self.add_lot('pack', 500, 'inv:1')\n248\t        self.set_left(self.signup, 62)\n249\t        answer = account(self.user)\n250\t        self.assertEqual(answer['credits']['total'], 612)\n251\t        kinds = [(lot['kind'], lot['credits'], lot['granted'], lot.get('basic_only', False))\n252\t                 for lot in answer['credits']['lots']]\n253\t        self.assertCountEqual(kinds[:2], [('signup', 62, 500, False), ('trickle', 50, 50, True)])\n254\t        self.assertEqual(kinds[2], ('pack', 500, 500, False))\n255\t        self.assertIsNone(answer['credits']['lots'][2]['expires_at'])\n256\t\n257\t    def test_a_person_with_no_lots_gets_them_on_first_read(self):\n258\t        other = new_user()\n259\t        self.assertEqual(account(other)['credits']['total'], 550)\n260\t\n261\t    def test_an_expired_lot_stops_counting(self):\n262\t        CreditGrant.objects.filter(pk=self.signup.pk).update(expires_at=timezone.now() - timedelta(seconds=1))\n263\t        self.assertEqual(account(self.user)['credits']['total'], 50)\n264\t\n265\t    def test_usage_counts_turns_by_tier_with_a_row_per_chat(self):\n266\t        charge_turn(self.user.id, 't1', EXPERT, CreditCharge.PERSON, ALIASES, 'a' * 32)\n267\t        charge_turn(self.user.id, 't2', EXPERT, CreditCharge.PERSON, ALIASES, 'a' * 32)\n268\t        charge_turn(self.user.id, 't3', BASIC, CreditCharge.PERSON, ALIASES, 'b' * 32)\n269\t        usage = account(self.user)['usage_30d']\n270\t        self.assertEqual((usage['expert_turns'], usage['basic_turns'], usage['credits']), (2, 1, 11))\n271\t        self.assertEqual(usage['days'], [{'date': timezone.now().date().isoformat(), 'credits': 11}])\n272\t        rows = {row['chat_id']: (row['tier'], row['messages'], row['credits']) for row in usage['activity']}\n273\t        self.assertEqual(rows, {'a' * 32: ('expert', 2, 10), 'b' * 32: ('basic', 1, 1)})\n274\t\n275\t    def test_workshop_reports_fair_use(self):\n276\t        JusPrinPlan.objects.create(user=self.user, plan_id='jusprin-workshop-monthly', external_id='x',\n277\t                                   external_user_id='y', current_term_start=timezone.now() - timedelta(days=1),\n278\t                                   current_term_end=timezone.now() + timedelta(days=29))\n279\t        charge(self.user, 'b1', BASIC)\n280\t        plan = account(self.user)['plan']\n281\t        self.assertEqual((plan['name'], plan['basic_used_this_term'], plan['basic_fair_use']), ('Workshop', 1, 600))\n282\t\n283\t    def test_v1_subscribers_are_named_with_the_price_they_keep(self):\n284\t        JusPrinPlan.objects.create(user=self.user, plan_id='jusprin-unlimited-annual', external_id='x', external_user_id='y')\n285\t        answer = account(self.user)\n286\t        self.assertIsNone(answer['plan'])\n287\t        self.assertEqual(answer['v1_subscription'], {'plan_id': 'jusprin-unlimited-annual', 'cents': 5999, 'period': 'year'})\n288\t\n289\t    @override_settings(JUSPRIN_MODEL_ALIASES=two_aliases())\n290\t    def test_the_endpoints_need_a_token_and_report_prices(self):\n291\t        app = Application.objects.create(\n292\t            client_id=f'JusPrin2-{uuid.uuid4().hex[:6]}', name='JusPrin 2', client_type=Application.CLIENT_PUBLIC,\n293\t            authorization_grant_type=Application.GRANT_AUTHORIZATION_CODE, redirect_uris='http://127.0.0.1/callback')\n294\t        token = AccessToken.objects.create(user=self.user, application=app, token=uuid.uuid4().hex, scope='read write',\n295\t                                           expires=timezone.now() + timedelta(days=1)).token\n296\t        self.assertEqual(Client().get('/ent/jusprin/v2/account').status_code, 401)\n297\t        response = Client().get('/ent/jusprin/v2/account', HTTP_AUTHORIZATION=f'Bearer {token}')\n298\t        self.assertEqual((response.status_code, response['Cache-Control']), (200, 'no-store'))\n299\t        self.assertEqual(response.json()['credits']['total'], 550)\n300\t        models = Client().get('/ent/jusprin/v2/models', HTTP_AUTHORIZATION=f'Bearer {token}').json()['data']\n301\t        self.assertEqual([(m['id'], m['tier'], m['credits'], m['images']) for m in models],\n302\t                         [('slicer-1', 'expert', 5, True), ('slicer-basic', 'basic', 1, False)])\n303\t\n304\t\n305\tclass PrepareTests(TestCase):\n306\t    def setUp(self):\n307\t        env = mock.patch.dict('os.environ', {'TEST_KEY': 'k'})\n308\t        env.start()\n309\t        self.addCleanup(env.stop)\n310\t\n311\t    def sent(self, fmt, aliases, **body):\n312\t        raw = json.dumps({'stream': True, **body}).encode()\n313\t        return json.loads(prepare(fmt, raw, aliases, 7).body)\n314\t\n315\t    def responses_body(self, picture):\n316\t        return dict(model='slicer-basic', input=[\n317\t            {'role': 'user', 'content': [{'type': 'input_text', 'text': 'look'}, picture]},\n318\t            {'type': 'function_call', 'call_id': 'c1', 'name': 'view', 'arguments': '{\"type\":\"input_image\"}'},\n319\t            {'type': 'function_call_output', 'call_id': 'c1', 'output': [picture]},\n320\t        ])\n321\t\n322\t    def test_pictures_become_a_note_on_a_backend_without_images(self):\n323\t        picture = {'type': 'input_image', 'image_url': 'data:image/png;base64,AAAA'}\n324\t        sent = self.sent('responses', ALIASES, **self.responses_body(picture))\n325\t        note = {'type': 'input_text', 'text': IMAGE_NOTE}\n326\t        self.assertEqual(sent['input'][0]['content'], [{'type': 'input_text', 'text': 'look'}, note])\n327\t        self.assertEqual(sent['input'][1]['arguments'], '{\"type\":\"input_image\"}')\n328\t        self.assertEqual(sent['input'][2]['output'], [note])\n329\t        self.assertNotIn('AAAA', json.dumps(sent))\n330\t\n331\t    def test_a_backend_with_images_keeps_them(self):\n332\t        picture = {'type': 'input_image', 'image_url': 'data:image/png;base64,AAAA'}\n333\t        aliases = parse_aliases(two_aliases(basic_images=True))\n334\t        sent = self.sent('responses', aliases, **self.responses_body(picture))\n335\t        self.assertEqual(sent['input'][0]['content'][1], picture)\n336\t\n337\t    def test_anthropic_pictures_are_stripped_inside_tool_results_too(self):\n338\t        config = json.loads(two_aliases())\n339\t        config['aliases'][0]['backends']['anthropic']['images'] = False\n340\t        picture = {'type': 'image', 'source': {'type': 'base64', 'media_type': 'image/png', 'data': 'AAAA'}}\n341\t        sent = self.sent('anthropic', parse_aliases(json.dumps(config)), model='slicer-1', max_tokens=1, messages=[\n342\t            {'role': 'user', 'content': [picture]},\n343\t            {'role': 'assistant', 'content': [{'type': 'tool_use', 'id': 'c', 'name': 'n', 'input': picture}]},\n344\t            {'role': 'user', 'content': [{'type': 'tool_result', 'tool_use_id': 'c', 'content': [picture]}]},\n345\t        ])\n346\t        note = {'type': 'text', 'text': IMAGE_NOTE}\n347\t        self.assertEqual(sent['messages'][0]['content'], [note])\n348\t        self.assertEqual(sent['messages'][1]['content'][0]['input'], picture)\n349\t        self.assertEqual(sent['messages'][2]['content'][0]['content'], [note])\n350\t\n351\t    def test_every_cache_control_lasts_an_hour(self):\n352\t        ephemeral = {'type': 'ephemeral'}\n353\t        hour = {'type': 'ephemeral', 'ttl': '1h'}\n354\t        sent = self.sent('anthropic', ALIASES, model='slicer-1', max_tokens=1,\n355\t                         tools=[{'name': 't', 'input_schema': {}, 'cache_control': ephemeral}],\n356\t                         system=[{'type': 'text', 'text': 's', 'cache_control': ephemeral}],\n357\t                         messages=[{'role': 'user', 'content': [\n358\t                             {'type': 'tool_result', 'tool_use_id': 'c',\n359\t                              'content': [{'type': 'text', 'text': 'r', 'cache_control': ephemeral}]},\n360\t                             {'type': 'text', 'text': 'm', 'cache_control': ephemeral}]}])\n361\t        self.assertEqual(sent['tools'][0]['cache_control'], hour)\n362\t        self.assertEqual(sent['system'][-1]['cache_control'], hour)\n363\t        self.assertEqual(sent['messages'][0]['content'][1]['cache_control'], hour)\n364\t        self.assertEqual(sent['messages'][0]['content'][0]['content'][0]['cache_control'], hour)\n365\t\n366\t    def test_a_responses_body_has_no_cache_control_added(self):\n367\t        sent = self.sent('responses', ALIASES, model='slicer-basic', input=[])\n368\t        self.assertNotIn('cache_control', json.dumps(sent))\n369\t"},{"tool_use_id":"toolu_01NAzJX9fyKTYDqn1Z483sZd","type":"tool_result","content":"60\t    return PrintReport.objects.filter(user=user, gcode_hash=gcode_hash).exists()\n61\t\n62\t\n63\tdef review_report(report: PrintReport, invalid: bool, note: str = '') -> PrintReportReview:\n64\t    \"\"\"Records the review. An invalid report that earned loses it once, from what\n65\t    is left: the balance can reach zero, not below, and the rest is forgiven.\"\"\"\n66\t    with transaction.atomic():\n67\t        review, _ = PrintReportReview.objects.update_or_create(report=report, defaults={'invalid': invalid, 'note': note})\n68\t        if invalid and report.rewarded:\n69\t            _take_back(report)\n70\t    return review\n71\t\n72\t\n73\tdef _take_back(report: PrintReport) -> None:\n74\t    credits = settings.JUSPRIN_V2_REPORT_CREDITS\n75\t    now = timezone.now()\n76\t    # Locks the person's lots in the order charge_turn takes them.\n77\t    lots = list(live_lots(report.user_id, now).select_for_update())\n78\t    _, created = CreditGrant.objects.get_or_create(\n79\t        user_id=report.user_id, source_ref=_invalid_ref(report),\n80\t        defaults={'kind': CreditGrant.ADJUSTMENT, 'credits_granted': -credits, 'credits_remaining': 0})\n81\t    if not created:\n82\t        return\n83\t    # The reward's own lot first, then what else the person holds. Free Standard\n84\t    # messages are left alone: they never came from the reward.\n85\t    own = [lot for lot in lots if lot.source_ref == _reward_ref(report)]\n86\t    others = [lot for lot in lots if lot.source_ref != _reward_ref(report) and not lot.basic_only]\n87\t    owed = credits\n88\t    for lot in own + others:\n89\t        taken = min(owed, lot.credits_remaining)\n90\t        if taken > 0:\n91\t            lot.credits_remaining -= taken\n92\t            lot.save(update_fields=['credits_remaining'])\n93\t            owed -= taken\n94\t\n95\t\n96\tdef report_activity(user, since) -> List[Dict]:\n97\t    \"\"\"The Account usage table's rows for reports: what each earned, and what a\n98\t    review took back with its reason.\"\"\"\n99\t    rows = []\n100\t    reports = PrintReport.objects.filter(user=user).select_related('printreportreview')\n101\t    by_ref = {_reward_ref(report): report for report in reports}\n102\t    by_ref.update({_invalid_ref(report): report for report in reports})\n103\t    grants = CreditGrant.objects.filter(user=user, created_at__gte=since, source_ref__in=by_ref.keys())\n104\t    for grant in grants:\n105\t        report = by_ref[grant.source_ref]\n106\t        title = 'Print report · ' + report.facts.get('project', report.gcode_hash[:8])\n107\t        row = {'date': grant.created_at.date().isoformat(), 'title': title, 'credits': grant.credits_granted}\n108\t        if grant.kind == CreditGrant.REWARD:\n109\t            rows.append({**row, 'kind': 'report'})\n110\t        else:\n111\t            rows.append({**row, 'kind': 'report_removed', 'note': report.printreportreview.note})\n112\t    return rows\n113\t"},{"tool_use_id":"toolu_01SJDHBVjqikTLj6V1drCxcW","type":"tool_result","content":"1\t\"\"\"Per-turn admission: rate limit, then the turn's charge in the credit ledger.\n2\t\n3\tA turn is everything the client sends for one reply, including tool-call\n4\tfollow-ups; every request of it carries the same X-JusPrin-Turn value. A turn\n5\tpays its model's price once, however many requests it makes. Title requests are\n6\tfree, and a request of kind \"note\" is a turn the app started, not the person.\n7\t\n8\tThe reply requests of one turn are sequential (a follow-up is built from the\n9\tprevious answer), so the charge does not guard against two reply requests of\n10\tthe same turn racing each other.\n11\t\"\"\"\n12\timport enum\n13\timport time\n14\t\n15\tfrom django.conf import settings\n16\t\n17\tfrom jusprin.ledger.ledger import charge_turn\n18\tfrom jusprin.ledger.models import CreditCharge\n19\tfrom lib.cache import REDIS\n20\t\n21\tKEY_PREFIX = 'jusprin:v2'\n22\tTURN_TTL_SECONDS = 60 * 60\n23\t\n24\t\n25\tclass Admission(enum.Enum):\n26\t    ADMITTED = 'admitted'\n27\t    RATE_LIMITED = 'rate_limited'\n28\t\n29\t\n30\tdef admit(user_id: int, turn_id: str, request_kind: str, alias, aliases, chat_id: str = None) -> Admission:\n31\t    \"\"\"Count a new turn against the rate limit, then charge it once unless it\n32\t    is a title. Raises ledger.CreditsExhausted when it cannot be paid.\n33\t    Synchronous: Redis and the credit tables are both blocking.\"\"\"\n34\t    seen_key = f'{KEY_PREFIX}:seen:{user_id}:{turn_id}'\n35\t    if REDIS.set(seen_key, '1', nx=True, ex=TURN_TTL_SECONDS):\n36\t        bucket = f'{KEY_PREFIX}:turns:{user_id}:{int(time.time() // 60)}'\n37\t        pipe = REDIS.pipeline()\n38\t        pipe.incr(bucket)\n39\t        pipe.expire(bucket, 120)\n40\t        turns_this_minute, _ = pipe.execute()\n41\t        if turns_this_minute > settings.JUSPRIN_V2_TURNS_PER_MINUTE:\n42\t            # The turn was not admitted, so its retry is a new turn again.\n43\t            REDIS.delete(seen_key)\n44\t            return Admission.RATE_LIMITED\n45\t\n46\t    if request_kind == 'title':\n47\t        return Admission.ADMITTED\n48\t\n49\t    charged_key = f'{KEY_PREFIX}:charged:{user_id}:{turn_id}'\n50\t    if not REDIS.set(charged_key, '1', nx=True, ex=TURN_TTL_SECONDS):\n51\t        return Admission.ADMITTED\n52\t    origin = CreditCharge.APP if request_kind == 'note' else CreditCharge.PERSON\n53\t    charged = False\n54\t    try:\n55\t        charge_turn(user_id, turn_id, alias, origin, aliases, chat_id)\n56\t        charged = True\n57\t    finally:\n58\t        # Only a turn that actually paid is remembered as paid, whether the\n59\t        # credits ran out or the credit tables raised.\n60\t        if not charged:\n61\t            REDIS.delete(charged_key)\n62\t    return Admission.ADMITTED\n63\t"}]}}
