{
  "meta": {
    "name": "JusPrin UI Design System",
    "version": "1.0.0",
    "units": "DIP",
    "platforms": [
      "Windows",
      "macOS",
      "Linux"
    ]
  },
  "primitive": {
    "brand": {
      "orbit": "#3A2D64",
      "orbitHover": "#4B3A77",
      "orbitPressed": "#2B214F",
      "violet": "#6F4F84",
      "bloom": "#CE84B7",
      "bloomHover": "#D99AC5",
      "bloomPressed": "#B76CA0"
    },
    "neutral": {
      "ink": "#17131F",
      "white": "#FFFFFF",
      "mist": "#F6F2F7",
      "trace": "#E8DFEB",
      "darkSurface": "#211B2A",
      "darkRaised": "#2B2336",
      "darkBorder": "#4B3E57",
      "darkBorderStrong": "#7D6A8D"
    },
    "status": {
      "success": "#2D6A55",
      "danger": "#B44757",
      "warning": "#D49A2A"
    }
  },
  "semantic": {
    "light": {
      "surface": {
        "canvas": "#FFFFFF",
        "subtle": "#F6F2F7",
        "raised": "#FFFFFF",
        "raisedHover": "#F6F2F7",
        "selected": "#EDE7F2",
        "failureInverse": "#261F37"
      },
      "text": {
        "primary": "#17131F",
        "secondary": "#5F5767",
        "tertiary": "#6C6374",
        "onFailurePrimary": "#FFFFFF",
        "onFailureSecondary": "#C8C1D2",
        "onFailureTertiary": "#A29AAA"
      },
      "border": {
        "subtle": "#E8DFEB",
        "strong": "#6F4F84",
        "focus": "#6F4F84",
        "onFailure": "#746A86"
      },
      "action": {
        "primary": "#3A2D64",
        "primaryHover": "#4B3A77",
        "primaryPressed": "#2B214F",
        "primaryText": "#FFFFFF",
        "disabled": "#E4E0E6",
        "disabledText": "#8A838F"
      },
      "status": {
        "success": "#2D6A55",
        "successOnAction": "#58B894",
        "danger": "#B44757",
        "dangerOnInverse": "#FF7868",
        "warning": "#D49A2A"
      },
      "overlay": {
        "scrim": "#17131F"
      },
      "axis": {
        "x": "#FF3C5B",
        "y": "#64C818",
        "z": "#2F88E9"
      }
    },
    "dark": {
      "surface": {
        "canvas": "#17131F",
        "subtle": "#211B2A",
        "raised": "#2B2336",
        "raisedHover": "#3B3047",
        "selected": "#4B3E57",
        "failureInverse": "#342C3B"
      },
      "text": {
        "primary": "#F6F2F7",
        "secondary": "#CFC5D3",
        "tertiary": "#A99EAE",
        "onFailurePrimary": "#FFFFFF",
        "onFailureSecondary": "#D7D0DF",
        "onFailureTertiary": "#B8AFBF"
      },
      "border": {
        "subtle": "#4B3E57",
        "strong": "#7D6A8D",
        "focus": "#7D6A8D",
        "onFailure": "#8E829D"
      },
      "action": {
        "primary": "#CE84B7",
        "primaryHover": "#D99AC5",
        "primaryPressed": "#B76CA0",
        "primaryText": "#17131F",
        "disabled": "#342C3B",
        "disabledText": "#857B8C"
      },
      "status": {
        "success": "#4CAF82",
        "successOnAction": "#174735",
        "danger": "#E07080",
        "dangerOnInverse": "#FF8E80",
        "warning": "#E8B84A"
      },
      "overlay": {
        "scrim": "#000000"
      },
      "axis": {
        "x": "#FF3C5B",
        "y": "#64C818",
        "z": "#2F88E9"
      }
    }
  },
  "typography": {
    "ui": {
      "family": "HarmonyOS Sans SC",
      "weights": {
        "regular": 400,
        "bold": 700
      },
      "fallback": "system GUI font",
      "cssFallback": "system-ui, sans-serif"
    },
    "code": {
      "family": "system monospace",
      "usage": "code, keys, file paths and IDs only; never names, words or measurements",
      "cssFamily": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace",
      "size": 12,
      "lineHeight": 16,
      "weight": 400
    },
    "roles": {
      "pageTitle": {
        "size": 24,
        "lineHeight": 30,
        "weight": 700
      },
      "section": {
        "size": 18,
        "lineHeight": 24,
        "weight": 700
      },
      "body": {
        "size": 14,
        "lineHeight": 20,
        "weight": 400
      },
      "bodyBold": {
        "size": 14,
        "lineHeight": 20,
        "weight": 700
      },
      "bodySmall": {
        "size": 13,
        "lineHeight": 18,
        "weight": 400
      },
      "bodySmallBold": {
        "size": 13,
        "lineHeight": 18,
        "weight": 700
      },
      "label": {
        "size": 12,
        "lineHeight": 16,
        "weight": 400
      },
      "labelBold": {
        "size": 12,
        "lineHeight": 16,
        "weight": 700
      },
      "metadata": {
        "size": 10,
        "lineHeight": 14,
        "weight": 400
      },
      "metadataBold": {
        "size": 10,
        "lineHeight": 14,
        "weight": 700
      }
    }
  },
  "dimension": {
    "space": {
      "1": 4,
      "2": 8,
      "3": 12,
      "4": 16,
      "5": 20,
      "6": 24,
      "8": 32,
      "10": 40,
      "12": 48
    },
    "radius": {
      "small": 4,
      "medium": 8,
      "large": 12,
      "chip": 4,
      "full": 14
    }
  },
  "elevation": {
    "subtle": {
      "offsetX": 0,
      "offsetY": 2,
      "blur": 8,
      "spread": 0,
      "color": "#000000",
      "opacity": {
        "light": 0.08,
        "dark": 0.24
      }
    },
    "medium": {
      "offsetX": 0,
      "offsetY": 4,
      "blur": 12,
      "spread": 0,
      "color": "#000000",
      "opacity": {
        "light": 0.12,
        "dark": 0.32
      }
    },
    "strong": {
      "offsetX": 0,
      "offsetY": 8,
      "blur": 24,
      "spread": 0,
      "color": "#000000",
      "opacity": {
        "light": 0.16,
        "dark": 0.4
      }
    }
  },
  "component": {
    "button": {
      "compact": {
        "paddingX": 8,
        "paddingY": 3,
        "radius": 8,
        "textRole": "metadata"
      },
      "window": {
        "minWidth": 58,
        "height": 24,
        "radius": 12,
        "textRole": "label"
      },
      "choice": {
        "minWidth": 100,
        "height": 32,
        "paddingX": 12,
        "paddingY": 8,
        "radius": 4,
        "textRole": "body"
      },
      "parameter": {
        "width": 120,
        "height": 26,
        "radius": 4,
        "textRole": "body"
      },
      "icon": {
        "width": 32,
        "height": 32,
        "iconSize": 16,
        "radius": 4
      },
      "iconCompact": {
        "width": 26,
        "height": 26,
        "iconSize": 16,
        "radius": 4
      },
      "link": {
        "height": 26,
        "paddingX": 4,
        "paddingY": 0,
        "radius": 4,
        "textRole": "labelBold"
      },
      "picker": {
        "height": 24,
        "paddingX": 8,
        "paddingY": 4,
        "radius": 4,
        "iconGap": 4,
        "textRole": "label"
      },
      "expanded": {
        "minHeight": 32,
        "paddingX": 12,
        "paddingY": 8,
        "radius": 4,
        "textRole": "body"
      },
      "secondary": {
        "paddingX": 12,
        "paddingY": 6,
        "radius": 4,
        "iconGap": 6,
        "textRole": "bodySmall"
      },
      "secondarySmall": {
        "height": 28,
        "paddingX": 12,
        "paddingY": 4,
        "radius": 4,
        "textRole": "bodySmall"
      },
      "primary": {
        "paddingX": 16,
        "paddingY": 8,
        "radius": 8,
        "iconGap": 6,
        "textRole": "bodySmallBold"
      },
      "primarySmall": {
        "height": 28,
        "paddingX": 16,
        "paddingY": 4,
        "radius": 8,
        "textRole": "bodySmallBold"
      }
    },
    "chip": {
      "height": 28,
      "radius": 4
    },
    "menuRow": {
      "height": 36,
      "radius": 0,
      "sideInset": 0
    },
    "popover": {
      "paddingY": 8,
      "rowGap": 2,
      "radius": 8,
      "borderWidth": 1,
      "width": 280
    },
    "segmented": {
      "height": 30,
      "padding": 2,
      "borderWidth": 1,
      "radius": 4,
      "segmentHeight": 24,
      "segmentPaddingX": 16,
      "segmentPaddingY": 4,
      "textRole": "label"
    },
    "tooltip": {
      "height": 24,
      "paddingX": 8,
      "paddingY": 4,
      "radius": 4,
      "textRole": "metadata"
    },
    "timelineRevert": {
      "width": 320
    },
    "statusRow": {
      "height": 34
    },
    "agentPane": {
      "width": 429,
      "minWidth": 320,
      "workspaceMinWidth": 320,
      "resizeHandleWidth": 8,
      "resizeHandleLineWidth": 2
    },
    "leftPane": {
      "width": 200,
      "minWidth": 160,
      "paddingY": 10,
      "tabHeight": 36,
      "tabIndicatorHeight": 2,
      "listPaddingY": 8,
      "rowGap": 2,
      "rowPaddingX": 8,
      "rowPaddingY": 6,
      "plateRowHeight": 32,
      "objectRowHeight": 36,
      "objectIndent": 20,
      "glyphSize": 16,
      "plateGap": 8,
      "objectGap": 4,
      "summaryIndent": 32,
      "summaryPaddingBottom": 6,
      "addPlatePaddingTop": 8,
      "addPlatePaddingBottom": 4,
      "addPlatePaddingX": 12,
      "addPlateButtonHeight": 30
    },
    "threadRow": {
      "lineGap": 2
    },
    "turnActivity": {
      "shimmerMs": 1600,
      "spinMs": 1000
    },
    "timelineSummary": {
      "paddingX": 8,
      "paddingY": 8,
      "iconGap": 4
    },
    "swatch": {
      "size": 24,
      "radius": 4,
      "gap": 4,
      "captionGap": 4,
      "inset": 2,
      "currentInset": 1,
      "ringWidth": 1,
      "currentRingWidth": 2,
      "glyphWidth": 1
    },
    "slotDot": {
      "size": 8,
      "compactSize": 4,
      "gap": 3,
      "compactGap": 2,
      "labelGap": 8,
      "fadedAlpha": 90
    },
    "projectCard": {
      "minWidth": 240,
      "maxWidth": 320,
      "footerHeight": 64,
      "thumbnailAspectWidth": 4,
      "thumbnailAspectHeight": 3,
      "radius": 12
    },
    "printerDialog": {
      "width": 500,
      "radius": 12,
      "scrimAlpha": 88
    },
    "printerSetup": {
      "contentWidth": 720
    },
    "replyChip": {
      "height": 28,
      "paddingX": 12
    },
    "chatAttachment": {
      "maxWidth": 320,
      "thumbnailSize": 48,
      "kindSize": 32
    },
    "composer": {
      "padding": 8,
      "gap": 4,
      "inputPadding": 4,
      "maxLines": 8
    },
    "printerCard": {
      "columnWidth": 320,
      "pictureSize": 32,
      "padding": 16,
      "radius": 12
    },
    "progress": {
      "height": 4
    },
    "statusDot": {
      "size": 8
    },
    "stepDots": {
      "size": 6
    },
    "setupCard": {
      "iconSize": 14
    },
    "field": {
      "height": 26,
      "radius": 4,
      "paddingX": 8,
      "minWidth": 72,
      "textRole": "body",
      "unitTextRole": "label"
    },
    "fieldSearch": {
      "height": 38,
      "paddingX": 10,
      "iconSize": 16,
      "iconGap": 6,
      "radius": 4,
      "borderWidth": 1,
      "focusBorderWidth": 2,
      "textRole": "body"
    },
    "select": {
      "height": 26,
      "radius": 4,
      "paddingX": 8,
      "chevronSize": 16,
      "textRole": "body"
    },
    "checkbox": {
      "size": 16,
      "radius": 4,
      "glyphSize": 12,
      "labelGap": 8,
      "textRole": "body"
    },
    "formRow": {
      "height": 26,
      "gap": 8,
      "labelWidth": 96,
      "textRole": "label"
    },
    "toolPanel": {
      "padding": 12,
      "rowGap": 8,
      "radius": 8,
      "minWidth": 220,
      "titleTextRole": "section"
    },
    "printIssues": {
      "bubbleWidth": 288,
      "listWidth": 320
    },
    "icon": {
      "sizes": [
        16,
        20,
        24
      ],
      "preferredFormat": "SVG",
      "fallbackFormat": "PNG"
    },
    "focus": {
      "width": 2,
      "offset": 2,
      "rule": "Must remain visible without relying on fill-color change alone"
    }
  },
  "rules": {
    "gradient": "Logo, splash, onboarding, and rare marketing moments only",
    "measurement": "All product UI dimensions are DIP",
    "modePair": "Every high-fidelity product frame must be delivered in light and dark mode",
    "rawColor": "Do not use primitive colors directly in product UI; resolve through semantic tokens"
  }
}
