{"parentUuid":"4baa2530-fd36-4b9a-b4f9-411ca3ebbf01","isSidechain":false,"attachment":{"type":"file","filename":"/Users/kenneth/Projects/JusPrin/.claude/worktrees/misrouted-failures/src/slic3r/GUI/JusPrin/Agent/CloudSignInMachine.cpp","content":{"type":"text","file":{"filePath":"/Users/kenneth/Projects/JusPrin/.claude/worktrees/misrouted-failures/src/slic3r/GUI/JusPrin/Agent/CloudSignInMachine.cpp","content":"#include \"CloudSignInMachine.hpp\"\n#include \"slic3r/GUI/JusPrin/Support/ErrorReport.hpp\"\n\n#include \"Base64.hpp\"\n#include \"slic3r/GUI/GUI_App.hpp\"\n#include \"slic3r/GUI/Jobs/BoostThreadWorker.hpp\"\n#include \"slic3r/GUI/Jobs/OAuthJob.hpp\"\n#include \"slic3r/GUI/Jobs/ProgressIndicator.hpp\"\n#include \"slic3r/GUI/MainFrame.hpp\"\n#include \"slic3r/GUI/JusPrin/Support/PageLanguage.hpp\"\n#include \"slic3r/GUI/JusPrin/Updates/Version.hpp\"\n#include \"slic3r/Utils/Http.hpp\"\n#include \"libslic3r/Exception.hpp\"\n\n#include <boost/log/trivial.hpp>\n#include <boost/system/system_error.hpp>\n\n#include <openssl/rand.h>\n#include <openssl/sha.h>\n\n#include <wx/utils.h>\n\n#include <algorithm>\n#include <stdexcept>\n#include <string>\n#include <utility>\n\nnamespace Slic3r::GUI::JusPrin::Agent {\n\nnamespace {\n\nstd::string base64_url(const std::string& bytes)\n{\n    std::string text = base64_bytes(bytes);\n    std::replace(text.begin(), text.end(), '+', '-');\n    std::replace(text.begin(), text.end(), '/', '_');\n    text.erase(std::remove(text.begin(), text.end(), '='), text.end());\n    return text;\n}\n\nstd::string random_bytes(std::size_t count)\n{\n    std::string bytes(count, '\\0');\n    if (RAND_bytes(reinterpret_cast<unsigned char*>(bytes.data()), static_cast<int>(count)) != 1)\n        throw std::runtime_error(\"OpenSSL could not produce random bytes for a JusPrin sign-in\");\n    return bytes;\n}\n\n// The worker reports nothing to a progress bar: waiting for the browser is\n// not progress anyone watches.\nclass NoProgress final : public ProgressIndicator\n{\npublic:\n    void clear_percent() override {}\n    void show_error_info(wxString, int, wxString, wxString) override {}\n    void set_range(int) override {}\n    void set_cancel_callback(CancelFn) override {}\n    void set_progress(int) override {}\n    void set_status_text(const char*) override {}\n    int  get_range() const override { return 0; }\n};\n\n// OrcaSlicer's OAuthJob, with its result handed on once it is final.\nclass SignInJob final : public Job\n{\npublic:\n    SignInJob(const CloudAuthorization& authorization, std::function<void(CloudAuthorizationResult)> done)\n        : m_result(std::make_shared<OAuthResult>()), m_done(std::move(done)),\n          m_job(OAuthData{OAuthParams{authorization.authorize_url, authorization.client_id, authorization.port,\n                                      authorization.redirect_uri, authorization.scope, \"code\", authorization.success_url,\n                                      authorization.failure_url, authorization.token_url, authorization.code_verifier,\n                                      authorization.state},\n                          m_result})\n    {\n        // OAuthJob tells this window it has finished; nothing listens there,\n        // because finalize() below is where its result is read.\n        m_job.set_event_handle(wxGetApp().mainframe);\n    }\n\n    // OAuthJob stops its loopback server in its own finalize(). That runs\n    // here, on the worker, so the port is free before a sign-in started\n    // right after a cancelled one opens it again; the worker would otherwise\n    // start the next job before the GUI thread got to finalize this one.\n    void process(Ctl& ctl) override\n    {\n        m_job.process(ctl);\n        std::exception_ptr none;\n        m_job.finalize(ctl.was_canceled(), none);\n    }\n\n    void finalize(bool canceled, std::exception_ptr& eptr) override\n    {\n        if (eptr) {\n            // Another program holding the loopback port is the one failure\n            // expected here; the person is told sign-in didn't finish and can\n            // try again. Anything else is a fault and goes on.\n            try {\n                std::rethrow_exception(eptr);\n            } catch (const boost::system::system_error& error) {\n                BOOST_LOG_TRIVIAL(warning) << \"JusPrin sign-in could not listen for the browser: \" << error.what();\n                eptr = nullptr;\n                m_done({false, {}, error.what()});\n            }\n            return;\n        }\n        if (canceled)\n            return;\n        m_done({m_result->success, m_result->access_token, m_result->error_message});\n    }\n\nprivate:\n    std::shared_ptr<OAuthResult>                  m_result;\n    std::function<void(CloudAuthorizationResult)> m_done;\n    OAuthJob                                      m_job;\n};\n\n} // namespace\n\nCloudAccountDeps make_cloud_account_deps()\n{\n    // The worker is a thread of its own, started by the first sign-in: every\n    // agent rebuild makes these dependencies, and most never sign in.\n    auto worker = std::make_shared<std::unique_ptr<BoostThreadWorker>>();\n\n    CloudAccountDeps deps;\n    deps.authorize = [worker](const CloudAuthorization& authorization, std::function<void(CloudAuthorizationResult)> done) {\n        if (!*worker)\n            *worker = std::make_unique<BoostThreadWorker>(std::make_shared<NoProgress>(), \"jusprin_sign_in\");\n        if (!replace_job(**worker, std::make_unique<SignInJob>(authorization, std::move(done))))\n            return false;\n        wxLaunchDefaultBrowser(wxString::FromUTF8(authorization.authorize_url));\n        return true;\n    };\n    deps.cancel_authorize = [worker] {\n        if (*worker)\n            (*worker)->cancel_all();\n    };\n    deps.pump = [worker] {\n        if (*worker)\n            (*worker)->process_events();\n    };\n    deps.get = [](const std::string& url, const std::string& token, std::function<void(CloudHttpResult)> done) {\n        auto http = Slic3r::Http::get(url);\n        http.header(\"Authorization\", \"Bearer \" + token)\n            .header(\"User-Agent\", Updates::user_agent())\n            .header(\"Accept\", \"application/json\")\n            .tls_verify(true)\n            .timeout_connect(10)\n            .timeout_max(30)\n            .on_complete(reported(\"reading the JusPrin account\", [done](std::string body, unsigned status) { done({status, std::move(body)}); }))\n            .on_error(reported(\"reading the JusPrin account\", [done](std::string body, std::string error, unsigned status) {\n                BOOST_LOG_TRIVIAL(warning) << \"JusPrin account request failed (\" << status << \"): \" << error;\n                done({status, std::move(body)});\n            }))\n            .perform();\n    };\n    deps.post = [](const std::string& url, const std::string& body, const std::string& session,\n                   std::function<void(CloudHttpResult)> done) {\n        auto http = Slic3r::Http::post(url);\n        if (!session.empty())\n            http.header(\"X-Session-Token\", session);\n        // The sign-in code email is written in this language.\n        if (const std::string language = server_language(); !language.empty())\n            http.header(\"Accept-Language\", language);\n        http.header(\"User-Agent\", Updates::user_agent())\n            .header(\"Content-Type\", \"application/json\")\n            .header(\"Accept\", \"application/json\")\n            .set_post_body(body)\n            .tls_verify(true)\n            .timeout_connect(10)\n            .timeout_max(30)\n            .on_complete(reported(\"signing in to JusPrin\", [done](std::string body, unsigned status) { done({status, std::move(body)}); }))\n            .on_error(reported(\"signing in to JusPrin\", [done](std::string body, std::string error, unsigned status) {\n                // A refusal (4xx) comes here too, with the server's body.\n                if (status == 0)\n                    BOOST_LOG_TRIVIAL(warning) << \"JusPrin email sign-in request failed: \" << error;\n                done({status, std::move(body)});\n            }))\n            .perform();\n    };\n    deps.revoke = [](const std::string& url, const std::string& client_id, const std::string& token) {\n        auto http = Slic3r::Http::post(url);\n        http.header(\"User-Agent\", Updates::user_agent())\n            .form_add(\"token\", token)\n            .form_add(\"client_id\", client_id)\n            .timeout_connect(10)\n            .timeout_max(30)\n            .on_error(reported(\"signing out of JusPrin\", [url](std::string body, std::string error, unsigned status) {\n                // No answer, such as no network: the token is already\n                // forgotten on this computer, and nobody can act on it.\n                if (status == 0) {\n                    BOOST_LOG_TRIVIAL(warning) << \"Signing out of JusPrin reached no server at \" << url << \": \" << error;\n                    return;\n                }\n                // Forgotten on this computer, the token still works on the\n                // server.\n                throw RuntimeError(\"revoking the token at \" + url + \" answered \" + std::to_string(status) + \": \" + error +\n                                   (body.empty() ? std::string() : \" \" + body));\n            }))\n            .perform();\n    };\n    deps.pkce = [](std::string& verifier, std::string& challenge, std::string& state) {\n        verifier = base64_url(random_bytes(32));\n        unsigned char digest[SHA256_DIGEST_LENGTH];\n        SHA256(reinterpret_cast<const unsigned char*>(verifier.data()), verifier.size(), digest);\n        challenge = base64_url(std::string(reinterpret_cast<const char*>(digest), sizeof(digest)));\n        state     = base64_url(random_bytes(16));\n    };\n    return deps;\n}\n\n} // namespace Slic3r::GUI::JusPrin::Agent\n","numLines":213,"startLine":1,"totalLines":213}},"displayPath":"../JusPrin/.claude/worktrees/misrouted-failures/src/slic3r/GUI/JusPrin/Agent/CloudSignInMachine.cpp","savedCopyFraming":{"enveloped":false}},"type":"attachment","uuid":"b22b4de6-9026-42f7-a94c-a5c2768f0387","timestamp":"2026-11-25T18:39:24.412Z","rendered":[{"content":"<system-reminder>\nCalled the Read tool with the following input: {\"file_path\":\"/Users/kenneth/Projects/JusPrin/.claude/worktrees/misrouted-failures/src/slic3r/GUI/JusPrin/Agent/CloudSignInMachine.cpp\"}\n</system-reminder>"},{"content":"<system-reminder>\nResult of calling the Read tool:\n1\t#include \"CloudSignInMachine.hpp\"\n2\t#include \"slic3r/GUI/JusPrin/Support/ErrorReport.hpp\"\n3\t\n4\t#include \"Base64.hpp\"\n5\t#include \"slic3r/GUI/GUI_App.hpp\"\n6\t#include \"slic3r/GUI/Jobs/BoostThreadWorker.hpp\"\n7\t#include \"slic3r/GUI/Jobs/OAuthJob.hpp\"\n8\t#include \"slic3r/GUI/Jobs/ProgressIndicator.hpp\"\n9\t#include \"slic3r/GUI/MainFrame.hpp\"\n10\t#include \"slic3r/GUI/JusPrin/Support/PageLanguage.hpp\"\n11\t#include \"slic3r/GUI/JusPrin/Updates/Version.hpp\"\n12\t#include \"slic3r/Utils/Http.hpp\"\n13\t#include \"libslic3r/Exception.hpp\"\n14\t\n15\t#include <boost/log/trivial.hpp>\n16\t#include <boost/system/system_error.hpp>\n17\t\n18\t#include <openssl/rand.h>\n19\t#include <openssl/sha.h>\n20\t\n21\t#include <wx/utils.h>\n22\t\n23\t#include <algorithm>\n24\t#include <stdexcept>\n25\t#include <string>\n26\t#include <utility>\n27\t\n28\tnamespace Slic3r::GUI::JusPrin::Agent {\n29\t\n30\tnamespace {\n31\t\n32\tstd::string base64_url(const std::string& bytes)\n33\t{\n34\t    std::string text = base64_bytes(bytes);\n35\t    std::replace(text.begin(), text.end(), '+', '-');\n36\t    std::replace(text.begin(), text.end(), '/', '_');\n37\t    text.erase(std::remove(text.begin(), text.end(), '='), text.end());\n38\t    return text;\n39\t}\n40\t\n41\tstd::string random_bytes(std::size_t count)\n42\t{\n43\t    std::string bytes(count, '\\0');\n44\t    if (RAND_bytes(reinterpret_cast<unsigned char*>(byte