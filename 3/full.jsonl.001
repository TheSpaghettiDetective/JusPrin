rs/kenneth/Projects/tsd-enterprise/web_ent/jusprin; grep -rn \\\"invalid_request\\\\|unknown_model\\\\|method_not_allowed\\\" . | grep \\\"\\\\.py:\\\" | grep -v \\\"/tests/\\\" | cut -c1-170\"}\n---\n1048 print_report {\"command\": \"T=09ecad6c046c4049bae2e9b2e31174f4; UA='JusPrin/2.0.1 OrcaSlicer/2.5.0'; curl -s -w \\\" %{http_code}\\\\n\\\" -A \\\"$UA\\\" -H \\\"Authorization: Bearer $T\\\" -F \\\"gcode_hash=\\\" -F \\\"outcome=success\\\" --form-string \\\"text=The print came out fine with no problems at all\\\" -F \\\"facts={}\\\" http://localhost:3334/ent/jusprin/v2/print_reports; curl -s -w \\\" %{http_code}\\\\n\\\" -A \\\"$UA\\\" -H \\\"Authorization: Bearer $T\\\" -F \\\"gcode_hash=abc\\\" -F \\\"outcome=success\\\" --form-string \\\"text=The print came out fine with no problems at all\\\" --form-string \\\"facts={\\\" http://localhost:3334/ent/jusprin/v2/print_reports; grep -n \\\"print_reports\\\\|print-reports\\\" /Users/kenneth/Projects/tsd-enterprise/web_ent/\n---\n1064 unknown_model {\"replace_all\": false, \"file_path\": \"/Users/kenneth/Projects/tsd-enterprise/web_ent/jusprin/v2/gateway.py\", \"old_string\": \"        except GatewayError as e:\\n            # The code only, never the message or details, which can hold the\\n            # person's numbers.\\n            facts['failure'] = f'answered {e.status} {e.code}'\", \"new_string\": \"        except GatewayError as e:\\n            # A request the app sent that this server refuses is ours: the app\\n            # is on the other end. Kenneth, 2026-11-15: \\\"Treat them as\\n            # unexpected errors.\\\"\\n            if e.code in ('invalid_request', 'unknown_model'):\\n                raise\\n            # The code only, never the \n---\n1066 invalid_request {\"replace_all\": false, \"file_path\": \"/Users/kenneth/Projects/tsd-enterprise/web_ent/jusprin/v2/views.py\", \"old_string\": \"    try:\\n        facts = json.loads(request.POST.get('facts', '{}'))\\n    except json.JSONDecodeErr