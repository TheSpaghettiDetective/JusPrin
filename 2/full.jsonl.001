09:          <button type=\"button\" className=\"button-secondary\" onClick={() => onAction('onboarding_choose_profile_bundle')}>\n314:        <button type=\"button\" className=\"button-primary block\" onClick={() => onAction('onboarding_accept_partial_profiles')}>\n322:function NoOrca({ agentConfigured, error, onAction }: Pick<Props, 'error' | 'onAction'> & { agentConfigured: boolean }) {\n325:      <Heading eyebrow=\"Bring your settings\" title=\"No Orca setup found\">\n329:        <div className=\"onboarding-source-name\"><Glyph name=\"monitor\" />Import from your local files</div>\n337:        <button type=\"button\" className=\"button-primary block\" onClick={() => onAction('onboarding_choose_profile_bundle')}>\n340:        <button type=\"button\" className=\"button-secondary block\" onClick={() => onAction('onboarding_choose_profile_folder')}>\n344:          {!agentConfigured && <LinkButton onClick={() => onAction('onboarding_back')}>Back</LinkButton>}\n345:          <LinkButton onClick={() => onAction('onboarding_defer_profiles')}>Skip for now</LinkButton>\n352:function ConfirmSetup({ onboarding, error, onAction }: Pick<Props, 'onboarding' | 'error' | 'onAction'>) {\n354:  const provenance = profiles.imported ? 'Imported configuration' : 'Saved configuration';\n363:      <Heading eyebrow=\"Confirm your setup\" title=\"What will you print with?\">\n390:        <button type=\"button\" className=\"button-primary block\" onClick={() => onAction('onboarding_confirm_setup')}>\n393:        <button type=\"button\" className=\"button-secondary block\" onClick={() => onAction('onboarding_manual_setup')}>\n398:          <LinkButton variant=\"flush\" onClick={() => onAction('onboarding_offline_example')}>I don’t have a printer here</LinkButton>\n400:            Continue with an offline example. You can slice and check it locally; physical Send stays unavailable.\n408:function ChooseSetup({ error, onAction }: Pick<Props, 'error' | 'onAction'>) {\n411:      <Heading eyebrow=\"Printer setup\" title=\"How would you like to set up your printer?\">\n416:          <button type=\"button\" className=\"button-primary block\" onClick={() => onAction('onboarding_agent_setup')}>\n425:          <button type=\"button\" className=\"button-secondary block\" onClick={() => onAction('onboarding_manual_setup')}>\n431:          <LinkButton variant=\"block\" onClick={() => onAction('onboarding_offline_example')}>I don’t have a printer here</LinkButton>\n433:            Use a labeled offline example. You can prepare and review it locally. Physical Send stays unavailable\n440:        <LinkButton variant=\"block\" onClick={() => onAction('onboarding_back')}>Back to Orca import</LinkButton>\n447:function ProjectFailed({ reason, onRetry, onChooseAnother, onClose }: {\n460:        <h1>Couldn’t open the file.</h1>\n475:function Project({ error, onAction, onDismissError }: Pick<Props, 'error' | 'onAction' | 'onDismissError'>) {\n477:  const [attempted, setAttempted] = useState<ProjectAction>('onboarding_open_example');\n494:      <Heading eyebrow=\"Start a project\" title=\"Start with something you want to print\">\n495:        Choose a project or model from your computer, or start with the example.\n503:      <div className=\"onboarding-example\">\n504:        <div className=\"onboarding-example-actions\">\n506:          <button type=\"button\" className=\"button-secondary\" onClick={() => attempt('onboarding_open_example')}>\n508:            Try the example\n511:        <p className=\"onboarding-copy\">Use the labeled example with local tools. No Agent or physical printer is required.</p>\n517:      <LinkButton variant=\"flush\" onClick={() => onAction('onboarding_back')}>Back</LinkButton>","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"sandboxed":false,"sourceToolAssistantUUID":"214a565a-8ab9-4e8a-b578-433f25ba9da4","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"userType":"external","entrypoint":