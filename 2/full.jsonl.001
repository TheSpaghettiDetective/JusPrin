     focus = '' if error or i != len(filled) else ';box-shadow:inset 0 0 0 2px var(--border-focus)'\n        out += f'<div style=\"width:40px;height:44px;display:flex;align-items:center;justify-content:center;background:var(--surface-canvas);border-radius:var(--radius-small);box-shadow:inset 0 0 0 1px {ring}{focus}\" class=\"body-bold\">{ch}</div>'\n    return f'<div style=\"display:flex;gap:var(--space-8)\">{out}</div>'\n\ndef links(*items):\n    return '<span class=\"label-bold\">' + ' <span style=\"color:var(--text-secondary)\">·</span> '.join(f'<span style=\"{LINK}\">{t}</span>' for t in items) + '</span>'\n\nOFFER_HEAD = '<span class=\"section\">Your first month: 500 credits</span><span class=\"body-small\" style=\"color:var(--text-secondary)\">An Expert message is 5 credits. Your own API key stays free.</span>'\nTERMS = '<span class=\"label\" style=\"color:var(--text-secondary)\">By signing in you agree to the <span style=\"' + LINK + '\">Terms</span> and <span style=\"' + LINK + '\">Privacy Policy</span>.</span>'\n\n# a. The door at rest: email field and the button that names the reward.\nA = card(OFFER_HEAD + f'''\n<div style=\"display:flex;gap:var(--space-8);margin-top:var(--space-8)\"><div style=\"{FIELD}\"><span class=\"body\" style=\"color:var(--text-tertiary)\">you@example.com</span></div><span class=\"body-small-bold\" style=\"{PRIMARY}\">Sign in for 500 credits</span></div>\n<span class=\"label\" style=\"color:var(--text-secondary)\">We email you a 6-digit code. No password. <span style=\"{LINK}\">Use Google or a password in the browser instead</span></span>\n{TERMS}''')\n\n# b. The code, typed in the app.\nB = card(f'''<span class=\"section\">Check your email.</span><span class=\"body-small\" style=\"color:var(--text-secondary)\">We sent a 6-digit code to {EMAIL}.</span>\n<div style=\"margin-top:var(--space-8)\">{cells('41')}</div>\n<span class=\"label\" style=\"color:var(--text-secondary)\">The sixth digit signs you in. Read the email on any device.</span>\n<div style=\"display:flex;justify-content:space-between;align-items:center;margin-top:var(--space-4)\">{links('Resend code', 'Change email', 'Use the browser instead')}<span class=\"label-bold\" style=\"{LINK}\">Cancel</span></div>''')\n\n# c. The code expired or was wrong.\nC = card(f'''<span class=\"section\">Check your email.</span><span class=\"body-small\" style=\"color:var(--text-secondary)\">We sent a 6-digit code to {EMAIL}.</span>\n<div style=\"margin-top:var(--space-8)\">{cells('418203', error=True)}</div>\n<span class=\"label\" style=\"color:var(--status-danger)\">That code has expired. We can send a new one.</span>\n<div style=\"display:flex;justify-content:space-between;align-items:center;margin-top:var(--space-4)\"><span class=\"body-small-bold\" style=\"{PRIMARY}\">Send a new code</span>{links('Change email', 'Use the browser instead')}</div>''')\n\n# d. The browser path, with the way back when the browser never returns.\nD = card(f'''<span class=\"section\" style=\"display:flex;gap:var(--space-8);align-items:center\"><span style=\"width:14px;height:14px;border-radius:50%;border:2px solid var(--border-subtle);border-top-color:var(--action-primary);display:inline-block\"></span>Finish signing in in your browser.</span>\n<span class=\"body-small\" style=\"color:var(--text-secondary)\">The app continues on its own once the browser is done.</span>\n<span class=\"label\" style=\"color:var(--text-secondary);margin-top:var(--space-8)\">Nothing happened? {links('Open the browser again', 'Check sign-in')}</span>\n<div style=\"display:flex;justify-content:space-between;align-items:center;margin-top:var(--space-4)\">{links('Use an email code instead')}<span class=\"label-bold\" style=\"{LINK}\">Cancel</span></div>''')\n\nFREE = ''.join([\n  b.ns['door']('Your own API key', 'Free'),\n  b.ns['door']('Claude Code or Claude Desktop', 'Free · MCP server'),\n  '<span class=\"label-bold\" style=\"color:var(--action-primary);padding:var(--space-4) 0\">Just slice for now</span>',\n])\nLABEL = '<span class=\"label\" style=\"color:var(--text-secondary)\">Pick how the agent should think. Change it any time in Preferences › Agent.</span>'\n\ndef screen(door, free=True):\n    doors = LABEL + door + (FREE if free else '')\n    return f'''{b.HEAD}<div class=\"screen\">{LOCKUP43}\n<div style=\"flex:1;display:flex;justify-content:center;align-items:center\">\n <div style=\"width:1120px;display:flex;gap:var(--space-48);align-items:center\">\n  {b.CLIP}\n  <div style=\"flex:1;display:flex;flex-direction:column;gap:var(--space-20)\">\n   <div style=\"display:flex;flex-direction:column;gap:var(--space-8)\">{b.TITLE}</div>\n   <div style=\"display:flex;flex-direction:column;gap:var(--space-8)\">{doors}</div>\n  </div>\n </div></div>\n</div></body></html>'''\n\nSCREENS = (('si-a-email-door', screen(A)), ('si-b-code', screen(B)), ('si-c-code-expired', screen(C)), ('si-d-browser-waiting', screen(D)))\n\nif __name__ == '__main__':\n    for name, html in SCREENS:\n        (HERE / f'{name}.html').write_text(html)\n        png = HERE / f'{name}.png'\n        subprocess.run([CHROME, '--headless=new', '--disable-gpu', '--no-first-run', f'--user-data-dir={tempfile.mkdtemp()}', '--hide-scrollbars',\n                        '--window-size=1280,800', '--force-device-scale-factor=2', '--virtual-time-budget=4000', f'--screenshot={png}',\n                        f'file://{HERE}/{name}.html'], check=True, capture_output=True, timeout=90)\n        print(png)\n","structuredPatch":[],"originalFile":null,"userModified":false},"sourceToolAssistantUUID":"f07f87f7-5c23-41b8-8e51-1f9d56f7579e","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"userType":"external","entrypoint":"claude-desktop","cwd":"/Users/kenneth/Projects/tsd-enterprise","sessionId":"e997298c-6edf-4c7d-8994-08bc7e301a34","version":"2.1.309","gitBranch":"claude/first-run-flow-f7be35","slug":"distributed-snuggling-crane"}
