 other?: string; // the other choice, which the person sends as their reply\n  receipt: string;\n}\n\"\"\"),\n])\n\nedit(\"bridge/protocol.test.ts\", [(\"\"\"      'settings_action',\n    ]);\"\"\",\"\"\"      'settings_action',\n      'save_proposal',\n    ]);\"\"\")])\n\nedit(\"components/MessageList.tsx\", [\n(\"\"\"import { PrinterBlockView } from './PrinterPanel';\"\"\",\"\"\"import { PrinterBlockView } from './PrinterPanel';\nimport { ProposalCard } from './ProposalCard';\"\"\"),\n(\"\"\"  onToolCancel: (actionId: string) => void;\n\"\"\",\"\"\"  onToolCancel: (actionId: string) => void;\n  // Save preset on a proposal card, by the preview's action id.\n  onSaveProposal?: (actionId: string) => void;\n\"\"\"),\n(\"\"\"  onToolCancel,\n  onSend,\"\"\",\"\"\"  onToolCancel,\n  onSaveProposal,\n  onSend,\"\"\"),\n(\"\"\"  const bubble = (message: Message): ReactNode => {\n    if (message.role === 'note' && message.fileReport)\n      return message.fileReportCard ? <FileNotesCard report={message.fileReport} onSetUpAgent={onSetUpAgent} /> : null;\"\"\",\n\"\"\"  const bubble = (message: Message, after?: ReactNode): ReactNode => {\n    if (message.role === 'note' && message.fileReport)\n      return message.fileReportCard ? <FileNotesCard report={message.fileReport} onSetUpAgent={onSetUpAgent} /> : null;\n    // Chat/Receipt: a preset the person saved from a proposal, in the same\n    // words every time, from what the app saved.\n    if (message.role === 'note' && message.receipt)\n      return (\n        <div className=\"printer-added\" role=\"status\">\n          <span className=\"printer-notice-heading\">\n            <span className=\"jp-icon jp-icon-check\" aria-hidden=\"true\" />\n            <span className=\"printer-added-caption\">Saved: <span className=\"printer-added-name\">{message.receipt.name}</span></span>\n          </span>\n          <span className=\"printer-added-detail\"><small>{message.receipt.detail}</small></span>\n        </div>\n      );\"\"\"),\n(\"\"\"          {otherAttachments.length > 0 && (\n            <div className=\"message-attachments\">\n              {otherAttachments.map((attachment) => (\n                <AttachmentChip key={attachment.id} attachment={attachment} />\n              ))}\n            </div>\n          )}\"\"\",\"\"\"          {otherAttachments.length > 0 && (\n            <div className=\"message-attachments\">\n              {otherAttachments.map((attachment) => (\n                <AttachmentChip key={attachment.id} attachment={attachment} />\n              ))}\n            </div>\n          )}\n          {after}\"\"\"),\n(\"\"\"  return (\n    <div className=\"message-list\" role=\"log\" aria-label=\"Agent conversation\\\"\"\"\",\n\"\"\"  // The proposal cards of a turn's previews, drawn in its last reply with\n  // words, the way the board draws them in the Agent's bubble. A message of\n  // the person's after the preview answered the card another way.\n  const messageIndex = new Map(messages.map((message, index) => [message.id, index]));\n  const answeredAfter = (messageId: string) =>\n    messages.slice((messageIndex.get(messageId) ?? messages.length) + 1).some((message) => message.role === 'user');\n  const proposalCards = (activities: ToolActivityInfo[]) =>\n    activities.filter((activity) => activity.proposal).map((preview) => (\n      <ProposalCard key={preview.actionId} preview={preview}\n        save={toolActivities.filter((activity) => activity.approves === preview.actionId).pop()}\n        closed={answeredAfter(preview.correlationId)} disabled={replyDisabled || readOnly}\n        onSave={(actionId) => onSaveProposal?.(actionId)} onSend={onSend} />\n    ));\n\n  return (\n    <div className=\"message-list\" role=\"log\" aria-label=\"Agent conversation\\\"\"\"\"),\n(\"\"\"        const turnActivities = turnMessages.flatMap((message) => activitiesOf(message.id));\"\"\",\n\"\"\"        // A save the person approved is theirs, receipted by its note, not\n        // part of the Agent's work.\n        const turnActivities = turnMessages.flatMap((message) => activitiesOf(message.id)).filter((activity) => !activity.approves);\n        const proposals = printerPanel ? [] : proposalCards(turnActivities);\n        const proposalHost = [...turn.replies].reverse().find((reply) => reply.role === 'assistant' && reply.text);\"\"\"),\n(\"\"\"              {turn.replies.map((reply) => (\n                <Fragment key={reply.id}>\n                  {bubble(reply)}\n                  {printerPanel && activityCards(reply)}\n                </Fragment>\n              ))}\"\"\",\"\"\"              {turn.replies.map((reply) => (\n                <Fragment key={reply.id}>\n                  {bubble(reply, reply === proposalHost && proposals.length > 0 ? proposals : undefined)}\n                  {printerPanel && activityCards(reply)}\n                </Fragment>\n              ))}\n              {!proposalHost && proposals}\"\"\"),\n])\n\nedit(\"App.tsx\", [\n(\"\"\"          onToolCancel={sendToolCancel}\n          onSend={sendMessage}\n          replyDisabled={unavailable || streaming || historical || state.projectChatBlocked}\"\"\",\n\"\"\"          onToolCancel={sendToolCancel}\n          onSaveProposal={(actionId) => client.send('save_proposal', { actionId })}\n          onSend={sendMessage}\n          replyDisabled={unavailable || streaming || historical || state.projectChatBlocked}\"\"\"),\n])\n\nedit(\"styles.css\", [\n(\"\"\"/* The change log between the turns (Figma \"Hand edits\").\"\"\",\n\"\"\"/* Chat/Tool Activity, Status=Proposed (board 5b): a settings preview that\n   saves a preset, in the Agent's bubble 8 under its words. Status rows are\n   Body Small secondary text after a 16 DIP glyph in the primary colour;\n   Save preset is Button/Primary and the other choice Button/Secondary. */\n.message-content > .proposal-card { margin-top: 8px; }\n.proposal-card {\n  align-self: stretch;\n  display: flex;\n  flex-direction: column;\n  align-items: flex-start;\n  gap: 8px;\n  padding: 12px;\n  border-radius: var(--radius-medium);\n  background: var(--surface-subtle);\n  box-shadow: inset 0 0 0 1px var(--border-subtle);\n  white-space: normal;\n}\n.proposal-title { align-self: stretch; font: var(--font-body-small-bold); color: var(--text-primary); }\n.proposal-row { align-self: stretch; display: flex; align-items: flex-start; gap: 8px; font: var(--font-body-small); color: var(--text-secondary); }\n.proposal-row > .jp-icon { width: var(--icon-size-small); height: var(--icon-size-small); margin-top: 1px; color: var(--text-primary); }\n.proposal-failure, .proposal-failure > .jp-icon { color: var(--status-danger); }\n.proposal-actions { align-self: stretch; display: flex; flex-wrap: wrap; align-items: center; gap: 8px; }\n.proposal-actions > button:not(.primary) { padding: var(--button-secondary-padding); border-color: var(--border-subtle); font: var(--font-body-small); }\n.proposal-actions > button:not(.primary):hover:enabled { background: var(--surface-raised); }\n.proposal-actions > button:not(.primary):disabled { opacity: 0.5; }\n\n/* The change log between the turns (Figma \"Hand edits\").\"\"\"),\n(\"\"\".jp-icon-lock { -webkit-mask-image\"\"\", \"\"\".jp-icon-save { -webkit-mask-image: url('@resources/jusprin/ui/icons/save.svg'); mask-image: url('@resources/jusprin/ui/icons/save.svg'); }\n.jp-icon-thermometer { -webkit-mask-image: url('@resources/jusprin/ui/icons/thermometer.svg'); mask-image: url('@resources/jusprin/ui/icons/thermometer.svg'); }\n.jp-icon-sliders { -webkit-mask-image: url('@resources/jusprin/ui/icons/sliders.svg'); mask-image: url('@resources/jusprin/ui/icons/sliders.svg'); }\n.jp-icon-lock { -webkit-mask-image\"\"\"),\n])\nprint(\"ok\")\nEOF\ngrep -n \"icon-size\\|--button-icon-icon-size\" styles.css | head -5; grep -rn \"jp-icon-sliders\" styles.css | head","description":"Add proposal card to the page"},"caller":{"type":"direct"}}]}}
