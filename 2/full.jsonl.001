\u001b[39m src/skills.test.ts\u001b[2m > \u001b[22mthe skill for a setup to check against the print's purpose\u001b[2m > \u001b[22mopens under the standing rules and stays short\n\u001b[31m\u001b[1mTypeError\u001b[22m: .toMatch() expects to receive a string, but got undefined\u001b[39m\n\u001b[36m \u001b[2m❯\u001b[22m src/skills.test.ts:\u001b[2m209:35\u001b[22m\u001b[39m\n    \u001b[90m207| \u001b[39m\n    \u001b[90m208| \u001b[39m  \u001b[34mit\u001b[39m(\u001b[32m'opens under the standing rules and stays short'\u001b[39m\u001b[33m,\u001b[39m () \u001b[33m=>\u001b[39m {\n    \u001b[90m209| \u001b[39m    \u001b[34mexpect\u001b[39m(text\u001b[33m.\u001b[39m\u001b[34msplit\u001b[39m(\u001b[32m'\\n\\n'\u001b[39m)[\u001b[34m1\u001b[39m])\u001b[33m.\u001b[39m\u001b[34mtoMatch\u001b[39m(\u001b[36m/^The rules above still appl\u001b[39m…\n    \u001b[90m   | \u001b[39m                                  \u001b[31m^\u001b[39m\n    \u001b[90m210| \u001b[39m    \u001b[34mexpect\u001b[39m(encoder\u001b[33m.\u001b[39m\u001b[34mencode\u001b[39m(text)\u001b[33m.\u001b[39mlength)\u001b[33m.\u001b[39m\u001b[34mtoBeLessThan\u001b[39m(encoder\u001b[33m.\u001b[39m\u001b[34mencode\u001b[39m(ar…\n    \u001b[90m211| \u001b[39m  })\u001b[33m;\u001b[39m\n\n\u001b[31m\u001b[2m⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯[2/2]⎯\u001b[22m\u001b[39m\n\n\u001b[2m Test Files \u001b[22m \u001b[1m\u001b[31m1 failed\u001b[39m\u001b[22m\u001b[2m | \u001b[22m\u001b[1m\u001b[32m2 passed\u001b[39m\u001b[22m\u001b[90m (3)\u001b[39m\n\u001b[2m      Tests \u001b[22m \u001b[1m\u001b[31m2 failed\u001b[39m\u001b[22m\u001b[2m | \u001b[22m\u001b[1m\u001b[32m40 passed\u001b[39m\u001b[22m\u001b[90m (42)\u001b[39m\n\u001b[2m   Start at \u001b[22m 15:34:25\n\u001b[2m   Duration \u001b[22m 2.94s\u001b[2m (transform 417ms, setup 623ms, collect 1.47s, tests 233ms, environment 2.83s, prepare 535ms)\u001b[22m","is_error":false}]}}
