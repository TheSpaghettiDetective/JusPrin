"currentColor\" stroke-width=\"1.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" fill=\"none\" style=\"color:var(--text-secondary)\"/></svg>\n<span class=\"body\" style=\"color:var(--text-secondary)\">{crumb}</span></div>\n<div style=\"display:flex;gap:var(--space-8);align-items:center\"><span class=\"dot\"></span><span class=\"label\" style=\"color:var(--text-secondary)\">{status}</span></div></div>'''\n\n# The proof panel: a clip frame from the recorded session. Words are the agent's own (turn 2 reply to the photo, turn 4 applied changes).\nPROOF = '''<div class=\"card\" style=\"width:560px;padding:var(--space-20);display:flex;flex-direction:column;gap:var(--space-16)\">\n  <div class=\"kv\"><span class=\"label-bold\" style=\"color:var(--text-secondary)\">A REAL SESSION · 30 OCT · X1 CARBON · PLA</span><span class=\"label\" style=\"color:var(--text-tertiary)\">0:38</span></div>\n  <div class=\"photo\"><div class=\"play\"><svg viewBox=\"0 0 24 24\" width=\"20\" height=\"20\" fill=\"currentColor\" style=\"color:var(--action-primary)\"><path d=\"M8 5v14l11-7z\"/></svg></div></div>\n  <div class=\"bar\"><div></div></div>\n  <div style=\"background:var(--surface-raised);border-radius:var(--radius-small);padding:var(--space-16);display:flex;flex-direction:column;gap:var(--space-16)\">\n    <div class=\"bubble\"><span class=\"label-bold\" style=\"color:var(--text-secondary)\">You</span>\n      <span class=\"body\">I printed it and it failed. The first layer didn't stick: about 5 mm in, one side of the base lifted off the plate and it turned into a mess of spaghetti. What went wrong?</span>\n      <span class=\"chip\"><span class=\"thumb\"></span><span class=\"label\">failed-print.jpg</span></span></div>\n    <div class=\"bubble\"><span class=\"label-bold\" style=\"color:var(--text-secondary)\">Agent</span>\n      <span class=\"body\">Your photo shows the base rings went down, but once one side came loose the nozzle kept printing into thin air. I looked at the slice and the settings are normal for PLA on a textured PEI plate: bed at 55&nbsp;°C, a 5&nbsp;mm brim, and a slow first layer. The base is narrow, about 50&nbsp;mm, and the wall flares out to 85&nbsp;mm, so a lightly stuck edge can lift at 5&nbsp;mm. Should I apply a wider brim, a warmer bed and slower early walls, and slice again?</span></div>\n    <div style=\"display:flex;flex-direction:column;gap:var(--space-4);padding-top:var(--space-12);box-shadow:inset 0 1px 0 0 var(--border-subtle)\">\n      <div class=\"kv\"><span class=\"body-small\" style=\"color:var(--text-secondary)\">Bed temperature</span><span class=\"body-small-bold\">55 → 60 °C</span></div>\n      <div class=\"kv\"><span class=\"body-small\" style=\"color:var(--text-secondary)\">Brim</span><span class=\"body-small-bold\">5 → 10 mm</span></div>\n      <div class=\"kv\"><span class=\"body-small\" style=\"color:var(--text-secondary)\">Cooling fan</span><span class=\"body-small-bold\">off for the first 3 layers</span></div>\n      <div class=\"kv\"><span class=\"body-small\" style=\"color:var(--text-secondary)\">Slicing again</span><span class=\"label\" style=\"color:var(--status-success)\">● applied to this project only</span></div>\n    </div>\n  </div>\n</div>'''\n\nDOORS = '''<div style=\"display:flex;flex-direction:column;gap:var(--space-12);align-self:stretch\">\n  <div class=\"card sel\" style=\"padding:var(--space-16);display:flex;flex-direction:column;gap:var(--space-8)\">","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"sandboxed":false,"sourceToolAssistantUUID":"11bc8bd1-e8ee-4a1d-af3a-67f1eeb9b35b","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"userType":"external","entrypoint":"claude-desktop","cwd":"/Users/kenneth/Projects/tsd-enterprise","sessionId":"e997298c-6edf-4c7d-8994-08bc7e301a34","version":"2.1.309","gitBranch":"claude/first-run-flow-f7be35","slug":"distributed-snuggling-crane"}
