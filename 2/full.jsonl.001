 source != \"drop\" && source != \"clipboard\" && source != \"project\")\n1445-        source = \"picker\";\n1446-    if (name.empty() && source != \"project\") {\n1447-        send_bridge_error(\"invalid_payload\", \"attach_file requires a file name.\", envelope_id);\n1448-        return;\n1449-    }\n1450-\n1451-    ProjectStateDocument& document = m_persistence.document();\n1452-\n1453-    // A lost acknowledgement can make the page resend the same file; the stable\n1454-    // client ID makes that idempotent rather than a duplicate attachment.\n1455-    if (const std::optional<AttachmentRecord> existing = document.find_attachment_by_client_id(client_id)) {\n1456-        send_attachment_updated(*existing, envelope_id);\n1457-        return;\n1458-    }\n1459-\n1460-    AttachmentRecord record;\n1461-    record.id            = document.allocate_attachment_id();\n1462-    record.client_id     = client_id;\n1463-    record.original_name = name;\n1464-    record.source        = source;\n1465-    record.state         = \"staged\";\n1466-\n1467-    if (source == \"project\") {\n1468-        // A reference to an item already in the open project: the Agent sees a","is_error":false}]},"uuid":"15b882b5-5c19-4c05-9cc8-1b95d9349ce7","timestamp":"2026-10-22T15:38:03.426Z","toolUseResult":{"stdout":"        calibration_from_symptom();\n    }\n\n    // A message from the Agent page, as the page sends it.\n    void send_page_message(const char* type, const std::string& id, nlohmann::json payload)\n    {\n        installed_shell()->agent_pane()->web_view().host().on_page_message(\n            nlohmann::json{{\"protocol\", Agent::Protocol::kName}, {\"version\", Agent::Protocol::kVersion}, {\"id\", id},\n                           {\"type\", type}, {\"payload\", std::move(payload)}}\n                .dump());\n    }\n    void send_person_text(const std::string& id, const std::string& text)\n    {\n        send_page_message(Agent::Protocol::kUserMessage, id,\n                          {{\"clientMessageId\", id + \"-c\"}, {\"text\", text}, {\"attachmentIds\", nlohmann::json::array()}});\n    }\n\n    // Board 2: a symptom typed into the project chat, answered with the two\n    // facts and a choice before any test is made. Its state first, as the\n    // board draws it: a chat of its own whose purpose and plan are recorded,\n    // on a sliced plate.\n    void calibration_from_symptom()\n    {\n        send_page_message(Agent::Protocol::kCreateConversation, \"calibration-chat\", nlohmann::json::object());\n        send_person_text(\"calibration-purpose\", CalibrationAgent::kPurpose);\n1438:void AgentHost::handle_attach_file(const std::string& envelope_id, const std::string& payload_json)\n1439-{\n1440-    const json payload = json::parse(payload_json);\n1441-    const std::string client_id = payload.value(\"clientAttachmentId\", \"\");\n1442-    const std::string name      = payload.value(\"name\", \"\");\n1443-    std::string       source    = payload.value(\"source\", \"picker\");\n1444-    if (source != \"picker\" && source != \"drop\" && source != \"clipboard\" && source != \"project\")\n1445-        source = \"picker\";\n1446-    if (name.empty() && source != \"project\") {\n1447-        send_bridge_error(\"invalid_payload\", \"attach_file requires a file name.\", envelope_id);\n1448-        return;\n1449-    }\n1450-\n1451-    ProjectStateDocument& document = m_persistence.document();\n1452-\n1453-    // A lost acknowledgement can make the page resend the same file; the stable\n1454-    // client ID makes that idempotent rather than a duplicate attachment.\n1455-    if (const std::optional<AttachmentRecord> existing = document.find_attachment_by_client_id(client_id)) {\n1456-        send_attachment_updated(*existing, envelope_id);\n1457-        return;\n1458-    }\n1459-\n1460-    AttachmentRecord record;\n1461-    record.id            = document.allocate_attachment_id();\n1462-    record.client_id     = client_id;\n1463-    record.origin