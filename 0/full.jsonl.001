== n - 1 else 'min-width:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis'\n        words = text('body-small', v, '--text-primary' if i == main else '--text-secondary', align)\n        return col([words, text('label', note, '--text-secondary')], 2, 'min-width:0') if note else words\n    line = lambda inner: f'<div style=\"{BOX}align-self:stretch;display:grid;grid-template-columns:{columns};gap:var(--space-8);padding:var(--space-4) 0;align-items:baseline;box-shadow:inset 0 -1px 0 0 var(--border-subtle)\">{inner}</div>'\n    out = [line(''.join(text('label', h, '--text-secondary', 'min-width:0' + (';text-align:right' if i == n - 1 else '')) for i, h in enumerate(head)))]\n    for r in rows:\n        out.append(line(''.join(cell(i, r[i], r[n] if i == main and len(r) > n else None) for i in range(n))))\n    return col(out, 0)\n\ndef balance_popover():\n    rule = f'<div style=\"{BOX}align-self:stretch;height:1px;margin:var(--space-4) 0;background:var(--border-subtle)\"></div>'\n    pad = 'padding:var(--space-4) var(--space-12);'\n    return popover([balance_head(BALANCE_HEAD, pad), rule] + lots_first(pad) + [col([text('label', USED_FIRST, '--text-secondary')], 0, pad=pad), rule,\n                    row([link(OUT_OF_CREDITS), link('See usage')], 8, 'align-self:stretch;padding:0 var(--space-8)', 'space-between')], 'right:var(--space-8)', 300)","is_error":false}]},"uuid":"4a458243-b866-4755-a971-1f40ccde0efc","timestamp":"2026-11-03T05:08:18.856Z","toolUseResult":{"stdout":"collapsedFirstRun\",\"sheetExpanded\",\"sheetCollapsedIdle\",\"sheetCollapsedOffline\"],\"default\":\"all\"},\"design\":{\"editor\":null},\"printer\":{\"editor\":null},\"status\":{\"editor\":null},\"specs\":{\"editor\":null},\"material\":{\"editor\ncollapsedFirstRun\": {\ncollapsedFirstRun\": \"Collapsed · idle (first-run Home)\", \"sheetExpanded\": \"Component sheet · expanded printing (Figma-era drawing)\", \"sheetCollapsedIdle\": \"Component sheet · collapsed idle (Figma-era drawing)\", \