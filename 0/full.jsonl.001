roup\" aria-label={proposal.title}>\n      <div className=\"proposal-title\">{proposal.title}</div>\n      {proposal.rows.map((row) => (\n        <div key={row.text} className=\"proposal-row\">\n          <span className={`jp-icon jp-icon-${row.icon}`} aria-hidden=\"true\" />\n          <span>{row.text}</span>\n        </div>\n      ))}\n      {failure && (\n        <div className=\"proposal-row proposal-failure\" role=\"alert\">\n          <span className=\"jp-icon jp-icon-circle-alert\" aria-hidden=\"true\" />\n          <span>{failure}</span>\n        </div>\n      )}\n      {closed ? (\n        <div className=\"proposal-row\">\n          <span className=\"jp-icon jp-icon-circle-minus\" aria-hidden=\"true\" />\n          <span>Not saved</span>\n        </div>\n      ) : (\n        <div className=\"proposal-actions\">\n          <button type=\"button\" className=\"primary\" disabled={disabled || saving} onClick={() => onSave(preview.actionId)}>\n            {saving ? 'Saving…' : proposal.save}\n          </button>\n          {proposal.other && (\n            <button type=\"button\" className=\"secondary\" disabled={disabled || saving} onClick={() => onSend(proposal.other!)}>\n              {proposal.other}\n            </button>\n          )}\n        </div>\n      )}\n    </div>\n  );\n}\n","structuredPatch":[],"originalFile":null,"userModified":false},"sourceToolAssistantUUID":"99cd8c3b-8984-47ad-920c-15b31eaa9366","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"userType":"external","entrypoint":"claude-desktop","cwd":"C:\\src\\JusPrin\\.claude\\worktrees\\calibration\\src\\slic3r\\GUI\\JusPrin\\AgentUI\\src","sessionId":"e7286644-9c40-4163-89b2-1b9685541258","version":"2.1.304","gitBranch":"claude/calibration","slug":"steady-sparking-swan"}
