ing& base) {\n        return base == \"Elegoo Generic ABS\" ? std::string(\"Generic ABS @System\") : base;\n    };\n\n    CHECK(orca_preset_in_jusprin(shop, catalog));\n    CHECK(orca_preset_in_jusprin(abs, catalog));''')\nopen(p,'w').write(s)\nEOF\ngrep -n \"has_base\" tests/jusprin/test_orca_import.cpp; cd src/slic3r/GUI/JusPrin/AgentUI && npx vitest run src/components/OrcaImport.test.tsx 2>&1 | tail -4; npx tsc --noEmit -p . && echo tsc ok","description":"Update the import tests and run the page tests","timeout":200000},"caller":{"type":"direct"}}]}}
