 folder beside JusPrin's. Its printers are the","-// presets saved in its account folder, and the printers ticked in its printer","-// list or selected in it that JusPrin ships a profile for, each of those an","-// item of its own named by JusPrin's profile.","-struct OrcaProfileSource","-{","-    std::string                 root;","-    OrcaPresetFiles             presets;","-    std::vector<OrcaImportItem> ticked;","-    // The printer preset OrcaSlicer has selected.","-    std::string selected;","-","-    bool has_printers() const { return !presets.printers.empty() || !ticked.empty(); }","-    std::vector<std::string> printer_names() const","-    {","-        std::vector<std::string> names = presets.printers;","-        for (const OrcaImportItem& item : ticked)","-            names.push_back(item.name);","-        return names;","-    }","-};","-","-OrcaProfileSource detect_orca_profiles(const std::optional<std::filesystem::path>& picked,","-                                       const std::function<const PrinterSetup::PrinterCatalog&()>& catalog)","-{","-    namespace fs = std::filesystem;","-    OrcaProfileSource source;","-    std::optional<fs::path> account;","-    fs::path                root;","-    if (picked) {","-        source.root = picked->u8string();","-        root        = *picked;","-        account     = orca_account_folder_for_pick(*picked);","-    } else {","-        const fs::path data = fs::u8path(data_dir());","-        root                = data.parent_path() / \"OrcaSlicer\";","-        std::error_code error;","-        if (!fs::is_directory(root, error) || root == data)","-            return source;","-        source.root = root.u8string();","-        account     = orca_account_folder(root);","-    }","-    if (account)","-        source.presets = scan_orca_presets(*account);","-    source.selected = orca_selected_printer(root);","-    source.ticked   = orca_profile_printers(root, account, [&catalog]() -> const auto& { return catalog().candidates(); });","-    return source;","-}","-","-PresetCollection& preset_collection(PresetBundle& presets, OrcaImportItem::Kind kind)","-{","-    switch (kind) {","-    case OrcaImportItem::Kind::Filament: return presets.filaments;","-    case OrcaImportItem::Kind::Process: return presets.prints;","-    case OrcaImportItem::Kind::Printer: break;","-    }","-    return presets.printers;","-}","-"," const char* to_string(OrcaImportItem::Kind kind)"," {","     switch (kind) {"]},{"oldStart":634,"oldLines":7,"newStart":574,"newLines":7,"lines":[" ","     if (state.step == OnboardingStep::Printers) {","         // Read only on the Printers step: this runs on every Home refresh.","-        OrcaProfileSource source   = detect_orca_profiles(m_picked_orca, [this]() -> const auto& { return profile_catalog(); });","+        OrcaProfileSource source   = m_importer.detect(m_picked_orca);","         state.facts.orca_printers  = source.has_printers();","         state.printers_screen      = printers_screen(state.progress, state.facts);","         if (state.printers_screen == PrintersScreen::OrcaImport) {"]},{"oldStart":863,"oldLines":7,"newStart":803,"newLines":7,"lines":[" "," std::string OrcaHomeBackend::import_orca_printers()"," {","-    OrcaProfileSource source = detect_orca_profiles(m_picked_orca, [this]() -> const auto& { return profile_catalog(); });","+    OrcaProfileSource source = m_importer.detect(m_picked_orca);","     if (!source.has_printers())","         return utf8(_L(\"JusPrin found no OrcaSlicer printers to bring. Start fresh instead.\"));","     m_orca_selected = source.selected;"]},{"oldStart":873,"oldLines":17,"newStart":813,"newLines":11,"lines":[" "," std::vector<OrcaImportItem> OrcaHomeBackend::bring_orca_items(std::vector<OrcaImportItem> ticked, const std::vector<std::string>& files)"," {","-    // Whichever kind holds OrcaSlicer's selected printer goes last, so its","-    // selection is the one left. Otherwise the saved presets go last: the","-    // first of them is the first printer the result lists.","-    const bool selected_ticked = std::any_of(ticked.begin(), ticked.end(),","-                                             [this](const OrcaImportItem& item) { return item.name == m_orca_selected; });","-    if (!selected_ticked)","-        install_ticked_printers(ticked, m_orca_selected);","-    std::vector<OrcaImportItem> items = import_orca_files(files, m_orca_selected);","-    if (selected_ticked)","-        install_ticked_printers(ticked, m_orca_selected);","-    items.insert(items.end(), std::make_move_iterator(ticked.begin()), std::make_move_iterator(ticked.end()));","+    std::vector<OrcaImportItem> items = m_importer.bring(std::move(ticked), files, m_orca_selected);","+    if (std::any_of(items.begin(), items.end(), [](const OrcaImportItem& item) {","+            return item.kind == OrcaImportItem::Kind::Printer && item.outcome == OrcaImportItem::Outcome::Imported;","+        }))","+        printer_chosen();","     return items;"," }"," "]},{"oldStart":943,"oldLines":7,"newStart":877,"newLines":7,"lines":["     if (dialog.ShowModal() != wxID_OK)","         return {};","     const std::filesystem::path picked = std::filesystem::u8path(utf8(dialog.GetPath()));","-    if (!detect_orca_profiles(picked, [this]() -> const auto& { return profile_catalog(); }).has_printers())","+    if (!m_importer.detect(picked).has_printers())","         return utf8(_L(\"JusPrin found no OrcaSlicer printers in that folder.\"));","     m_picked_orca = picked;","     OnboardingProgress progress = onboarding_progress();"]},{"oldStart":952,"oldLines":132,"newStart":886,"newLines":16,"lines":["     return {};"," }"," ","-const PrinterSetup::PrinterCatalog& OrcaHomeBackend::profile_catalog()","-{","-    if (!m_profile_catalog)","-        m_profile_catalog = std::make_shared<const PrinterSetup::PrinterCatalog>(PrinterSetup::PrinterCatalog::load(Slic3r::resources_dir()));","-    return *m_profile_catalog;","-}","-","-void OrcaHomeBackend::install_ticked_printers(std::vector<OrcaImportItem>& items, const std::string& preferred)","-{","-    Plater* plater = wxGetApp().plater();","-    if (plater == nullptr)","-        throw std::logic_error(\"Home installed printers before the app finished starting\");","-    if (items.empty())","-        return;","-    bool installed = false;","-    // Each printer is saved under its model's name as it is installed, two","-    // nozzles of one model as two printers, and the last one saved stays","-    // selected: the preferred one, otherwise the first, goes last.","-    std::vector<OrcaImportItem*> order;","-    for (OrcaImportItem& item : items)","-        order.push_back(&item);","-    const auto kept = std::find_if(order.begin(), order.end(), [&](const OrcaImportItem* item) { return item->name == preferred; });","-    std::rotate(order.begin(), kept == order.end() ? order.begin() + 1 : kept + 1, order.end());","-    for (OrcaImportItem* entry : order) {","-        OrcaImportItem& item = *entry;","-        const std::vector<PrinterSetup::PrinterCandidate>& candidates = profile_catalog().candidates();","-        const auto profile = std::find_if(candidates.begin(), candidates.end(), [&item](const PrinterSetup::PrinterCandidate& candidate) {","-            return candidate.vendor_id == item.vendor && candidate.model_id == item.model && candidate.variant == item.nozzle;","-        });","-        if (profile == candidates.end())","-            throw std::logic_error(\"A printer ticked in OrcaSlicer lost its JusPrin profile between detection and import\");","-        // The reason is the generic one: installing a shipped profile fails","-        // only on a broken install, which the log describes.","-        std::string problem;","-        if (SetupCommands::install_and_select_printer(*plater, item.vendor, item.model, item.nozzle, profile->default_material, problem)) {","-            Printers::add_named_printer(*plater, item.model, {});","-            item.outcome = OrcaImportItem::Outcome::Imported;","-            item.reason  = OrcaImportItem::Reason::None;","-            installed    = true;","-        } else {","-            BOOST_LOG_TRIVIAL(error) << \"Installing \" << item.model << \" from OrcaSlicer's printer list failed: \" << problem;","-            item.outcome = OrcaImportItem::Outcome::NotImported;","-            item.reason  = OrcaImportItem::Reason::NotLoaded;","-        }","-    }","-    if (installed)","-        printer_chosen();","-}","-","-std::vector<OrcaImportItem> OrcaHomeBackend::import_orca_files(const std::vector<std::string>& files, const std::string& preferred)","-{","-    namespace fs = std::filesystem;","-    PresetBundle* presets = wxGetApp().preset_bundle;","-    AppConfig* config     = wxGetApp().app_config;","-    Plater* plater        = wxGetApp().plater();","-    if (presets == nullptr || config == nullptr || plater == nullptr)","-        throw std::logic_error(\"Home imported printers before the app finished starting\");","-","-    // A saved printer imports only once its base profile is loaded, and","-    // JusPrin loads a vendor's profiles only once one of its printers is","-    // installed, which on a fresh install none is. So each base JusPrin has","-    // a profile for is installed first, as OrcaSlicer had it. A base that","-    // fails to install stays missing, and its printer's line says so.","-    for (const std::string& base : orca_printer_bases(files)) {","-        if (presets->printers.find_preset2(base, true) != nullptr)","-            continue;","-        const std::vector<PrinterSetup::PrinterCandidate>& candidates = profile_catalog().candidates();","-        const auto profile = std::find_if(candidates.begin(), candidates.end(),","-                                          [&base](const PrinterSetup::PrinterCandidate& candidate) { return candidate.preset_name == base; });","-        if (profile == candidates.end())","-            continue;","-        std::string problem;","-        if (!SetupCommands::install_and_select_printer(*plater, profile->vendor_id, profile->model_id, profile->variant,","-                                                       profile->default_material, problem))","-            BOOST_LOG_TRIVIAL(error) << \"Installing \" << base << \", the base of a saved OrcaSlicer printer, failed: \" << problem;","-    }","-","-    OrcaImportCatalog catalog;","-    catalog.has = [presets](OrcaImportItem::Kind kind, const std::string& name) {","-        return preset_collection(*presets, kind).find_preset(name, false) != nullptr;","-    };","-    catalog.has_base = [presets](OrcaImportItem::Kind kind, const std::string& base) {","-        return preset_collection(*presets, kind).find_preset2(base, true) != nullptr;","-    };","-    // Renamed copies live here only until import_presets has copied them.","-    const fs::path staging = fs::temp_directory_path() / (\"jusprin-orca-import-\" + std::to_string(wxGetProcessId()));","-    fs::remove_all(staging);","-    fs::create_directories(staging);","-    std::vector<OrcaImportItem> items = plan_orca_import(files, catalog, staging);","-","-    std::vector<std::string> pending;","-    for (const OrcaImportItem& item : items)","-        if (item.outcome == OrcaImportItem::Outcome::Pending)","-            pending.push_back(item.file);","-    if (!pending.empty()) {","-        // Every taken name was renamed above, so import_presets has nothing","-        // to ask. Were it asked, the answer is no and that item says it was","-        // not imported.","-        presets->import_presets(pending, [](const std::string&) { return 0; }, ForwardCompatibilitySubstitutionRule::Enable,","-                                *config);","-        wxGetApp().load_current_presets();","-        presets->update_compatible(PresetSelectCompatibleType::Always);","-        m_frame.update_side_preset_ui();","-    }","-    // import_presets leaves in `pending` what it imported.","-    settle_orca_import(items, pending);","-    fs::remove_all(staging);","-","-    const auto is_printer = [](const OrcaImportItem& item) {","-        return item.kind == OrcaImportItem::Kind::Printer && item.outcome == OrcaImportItem::Outcome::Imported;","-    };","-    auto chosen = std::find_if(items.begin(), items.end(), [&](const OrcaImportItem& item) { return is_printer(item) && item.name == preferred; });","-    if (chosen == items.end())","-        chosen = std::find_if(items.begin(), items.end(), is_printer);","-    if (chosen != items.end()) {","-        SetupCommands::select_printer_preset(*plater, chosen->renamed_to.empty() ? chosen->name : chosen->renamed_to);","-        printer_chosen();","-    }","-    return items;","-}","+const PrinterSetup::PrinterCatalog& OrcaHomeBackend::profile_catalog() { return m_importer.profile_catalog(); }"," "," std::vector<Snapshot::Onboarding::ImportItem> OrcaHomeBackend::import_result_lines(const std::vector<OrcaImportItem>& items)"," {","     using Reason = OrcaImportItem::Reason;","     std::vector<Snapshot::Onboarding::ImportItem> lines;","     for (const OrcaImportItem& item : items) {","+        // Nothing to say about a preset JusPrin already had.","+        if (item.outcome == OrcaImportItem::Outcome::AlreadyThere)","+            continue;","         Snapshot::Onboarding::ImportItem line{to_string(item.kind), item.name, item.renamed_to,","                                               item.outcome == OrcaImportItem::Outcome::Imported, {}};","         switch (item.reason) {"]}]},{"filePath":"/Users/kenneth/Projects/JusPrin/.claude/worktrees/first-run-flow-f7be35/src/slic3r/GUI/JusPrin/Home/OrcaHomeBackend.hpp","hunks":[{"oldStart":11,"oldLines":7,"newStart":11,"newLines":7,"lines":[" "," #include \"HomeBackend.hpp\""," #include \"MonitorWindow.hpp\"","-#include \"OrcaImport.hpp\"","+#include \"OrcaImporter.hpp\""," #include \"PrintHistory.hpp\""," #include \"PrinterWindow.hpp\""," #include \"slic3r/GUI/JusPrin/Agent/CloudAccount.hpp\""]},{"