{"type":"api-request-blob","sessionId":"e7286644-9c40-4163-89b2-1b9685541258","hash":"0f593d0d9c1b4861f36af0270ea0b222fdf53e14a1dd02965062d38a2dec4c1b","message":{"role":"user","content":[{"tool_use_id":"toolu_017b51Sohbh22cbnLozQA5xU","type":"tool_result","content":"497:void drop_unsaved_edits(Tab* tab)\n1422:        drop_unsaved_edits(tab(edits.kind == \"printer\" ? Preset::TYPE_PRINTER :\n2545:        drop_unsaved_edits(wxGetApp().get_tab(type));\n3486:        drop_unsaved_edits(tab);\n493-    return steps;\n494-}\n495-\n496-// Orca's Discard for the preset a tab edits: nothing asks about it after.\n497:void drop_unsaved_edits(Tab* tab)\n498-{\n499-    if (tab != nullptr && tab->get_presets()->current_is_dirty()) {\n500-        tab->get_presets()->discard_current_changes();\n501-        tab->load_current_preset();\n502-    }\n503-}\n504-\n505-std::string plate_label(BedType type)\n506-{\n507-    const ConfigOptionDef* definition = print_config_def.get(\"curr_bed_type\");\n508-    if (definition == nullptr || type <= btDefault || int(type) - 1 >= int(definition->enum_labels.size()))\n509-        return {};\n510-    return definition->enum_labels[int(type) - 1];\n511-}\n512-\n513-} // namespace\n514-\n515-OrcaWorkspaceAdapter::OrcaWorkspaceAdapter(Plater& plater) : m_plater(plater)\n516-{\n517-    wxASSERT(wxIsMainThread());","is_error":false}]}}
