{"type":"api-request-blob","sessionId":"e7286644-9c40-4163-89b2-1b9685541258","hash":"f313c6779077341e6f755426a8ba952145614dd28c207d6372fe8c456c349f19","message":{"role":"user","content":[{"tool_use_id":"toolu_01FVNJf4ZdrrHDqXtA6BF9sG","type":"tool_result","content":"    // queued in is torn down, and it has to be able to report.\n    void clear();\n    const std::string& executing_action_id() const { return m_executing; }\n    void forget_if_closed(const std::string& action_id);\n    // Chat deletion may forget completed records, never in-flight work.\n    void forget_terminal_activities(const std::vector<std::string>& message_ids);\n\n    // Creates a record stamped with the current workspace session and revision,\n    // validates it, and starts it immediately.\n    const ToolActivity& submit(const ToolRequest& request, const std::string& correlation_id,\n                               ToolExecutionPacing pacing = {}, ToolSource source = ToolSource::Agent,\n                               const std::string& call_id = {});\n\n    bool cancel(const std::string& action_id);\n\n    // Advances every Running activity by one deterministic tick: progress\n    // first, then the native command on the final tick. The owner paces this\n    // from a timer; tests call it directly.\n    void pump();\n\n    bool any_running() const;\n\n    const std::vector<ToolActivity>& activities() const { return m_activities; }\n    const ToolActivity*              find(const std::string& action_id) const;\n\nprivate:\n    ToolActivity* find_mutable(const std::string& action_id);\n    void          start_running(ToolActivity& activity);\n    void          execute(ToolActivity& activity);\n    void          fail(ToolActivity& activity, std::string code, std::string message, std::string details_json = \"{}\");\n    // The ids of the regions whose geometry is still found, and, after a\n    // change, those of them that no longer are: what a place, divide or\n    // repair result reports as unbound.\n    std::set<std::string> bound_regions() const;\n    nlohmann::json        regions_unbound(const std::set<std::string>& bound_before) const;\n    void          notify(const ToolActivity& activity);\n    void          invalidate_pending(const Workspace::WorkspaceChanged& change);\n\n    struct ObserverState\n    {\n        std::uint64_t                             next_id{1};\n568:const ToolActivity& ToolExecutionCoordinator::submit(const ToolRequest& request, const std::string& correlation_id,\n577:    activity.correlation_id    = correlation_id;\n599:        fail(stored, \"unknown_tool\", \"This build has no tool named \\\"\" + request.tool + \"\\\".\");\n605:        fail(stored, validation.error->code, validation.error->message);\n617:            fail(stored, \"invalid_argument\", \"Give the absolute path of a file that exists.\");\n644:            fail(stored, workspace_error_code(previewed.error), previewed.message);\n675:            fail(stored, workspace_error_code(checked.error), checked.message);\n713:            fail(stored, \"unavailable_operation\", \"Region annotations are not available here.\");\n719:            fail(stored, workspace_error_code(plan.error), plan.message);\n837:                fail(stored, preview.issues.front().code, preview.issues.front().message,\n858:                fail(stored, \"unavailable_operation\", \"This build cannot record printer facts.\");\n875:                fail(stored, \"invalid_argument\", \"Give the absolute path of a file that exists.\");\n879:                fail(stored, \"invalid_argument\", \"A project keeps its own units; inches applies to model files.\");\n890:                fail(stored, \"opened_before\",\n911:            fail(stored, \"invalid_argument\", problem);\n923:            fail(stored, \"needs_person\",\n929:            fail(stored, \"stale_workspace\", \"The workspace changed. Read and preview again.\", stale_settings_details(arguments, snapshot).dump());\n934:            fail(stored, \"missing_object\", kMissingTarget);\n941:            fail(stored, issue.code, issue.message, settings_preview_result(preview, target.target.scope, snapshot).dump());\n956:            fail(stored, problem->code, problem->message);\n979:    const std::string correlation = preview->correlation_id;\n981:    submit(ToolRequest{\"settings_apply_patch\", arguments.dump()}, correlation);\n988:    ToolActivity* activity = find_mutable(action_id);\n1064:                    fail(activity, \"local_save_failed\", \"Couldn't save the project. The action was not run.\");\n1077:                    fail(activity, \"local_save_failed\", \"The action ran, but its changes couldn't be saved. Check the project before trying again.\");\n1086:                    fail(activity, \"local_save_failed\", \"The action ran, but its changes couldn't be saved. Check the project before trying again.\");\n1106:        return std::find(message_ids.begin(), message_ids.end(), activity.correlation_id) != message_ids.end();\n1124:ToolActivity* ToolExecutionCoordinator::find_mutable(const std::string& action_id)\n1146:        fail(activity, \"stale_revision\", \"The project changed before this action could execute. Call the tool again.\");\n1156:        fail(activity, \"unknown_tool\", \"This build has no tool named \\\"\" + activity.tool + \"\\\".\");\n3:80-    std::string   action_id;      // coordinator-assigned, stable across reloads\n4:81-    std::string   correlation_id; // assistant message or adapter request correlation\n1782:struct SettingsPreview\n1783-{\n1784-    bool valid{false};\n1785-    std::vector<SettingChange> changes;\n1786-    std::vector<SettingIssue> issues, warnings;\n1787-    // The preset the settings belong to: the process preset for an object.\n1788-    std::string preset;\n1789-    // Predicted secondary changes are previewed and read back alongside the\n1790-    // explicit patch. They are never accepted as extra writable input keys.\n1791-    std::vector<SettingChange> dependencies;\n1792-    // After an apply: the name the preset was saved under, empty when it\n1793-    // was not saved, and whether the preset in use still has unsaved edits.\n1794-    std::string saved_as;\n1795-    bool        preset_dirty{false};\n1796-};\n1797-","is_error":false}]}}
