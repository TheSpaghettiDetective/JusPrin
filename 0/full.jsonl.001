pp","hunks":[{"oldStart":287,"oldLines":13,"newStart":287,"newLines":15,"lines":["     settle_orca_import(items, pending);","     fs::remove_all(staging);"," ","+    if (selection == Selection::Kept)","+        return items;","     const auto is_printer = [](const OrcaImportItem& item) {","         return item.kind == OrcaImportItem::Kind::Printer && item.outcome == OrcaImportItem::Outcome::Imported;","     };","     auto chosen = std::find_if(items.begin(), items.end(), [&](const OrcaImportItem& item) { return is_printer(item) && item.name == preferred; });","     if (chosen == items.end())","         chosen = std::find_if(items.begin(), items.end(), is_printer);","-    if (chosen != items.end() && selection == Selection::Brought)","+    if (chosen != items.end())","         SetupCommands::select_printer_preset(plater, chosen->renamed_to.empty() ? chosen->name : chosen->renamed_to);","     return items;"," }"]}]}],"moreFiles":0,"changedFiles":["/Users/kenneth/Projects/JusPrin/.claude/worktrees/first-run-flow-f7be35/src/slic3r/GUI/JusPrin/Home/OrcaImporter.cpp"]}},"sandboxed":false,"sourceToolAssistantUUID":"9e6a80ab-e73d-492a-97a1-fa14cf6b32d1","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"userType":"external","entrypoint":"claude-desktop","cwd":"/Users/kenneth/Projects/JusPrin/.claude/worktrees/first-run-flow-f7be35/src/slic3r/GUI/JusPrin","sessionId":"c868826d-3950-4f0f-9ecd-4a549cdd6983","version":"2.1.309","gitBranch":"claude/orca-import-menu","slug":"dapper-knitting-moler"}
