{"type":"api-request-blob","sessionId":"e7286644-9c40-4163-89b2-1b9685541258","hash":"2229373d0fa0f6cf04b0464c2d0fa947cbd05ed12812be87a39a22b34392d949","message":{"role":"user","content":[{"tool_use_id":"toolu_01PkWae942GQpfi5X5JLjBn9","type":"tool_result","content":"tests/agent/test_agent_bridge.cpp:3410:class OneCallAgent final : public IAgentService\ntests/agent/test_agent_bridge.cpp:3832:const AgentRequest& last_reply(const OneCallAgent& agent)\ntests/agent/test_agent_bridge.cpp:3935:    OneCallAgent*            agent{nullptr};\ntests/agent/test_agent_bridge.cpp\n3410:class OneCallAgent final : public IAgentService\n3411-{\n3412-public:\n3413-    std::function<ToolRequest(const AgentRequest&)> call;\n3414-\n3415-    bool ready() const override { return true; }\n3416-    bool busy() const override { return active; }\n3417-    bool start(const AgentRequest& request) override\n3418-    {\n3419-        requests.push_back(request);\n3420-        active = true;\n3421-        if (request.purpose == AgentRequest::Purpose::Reply && call && !called) {\n3422-            called = true;\n3423-            events.push_back(AgentEvent::tool_call({\"call-load\", call(request), true}));\n3424-        } else {\n3425-            events.push_back(AgentEvent::delta(\"Done.\"));\n3426-            events.push_back(AgentEvent::completed());\n3427-        }\n3428-        return true;\n3429-    }\n3430-    bool continue_after_tool(const AgentToolResult& result) override\n3431-    {\n3432-        results.push_back(result);\n3433-        // Optionally one more call before the reply.\n3434-        if (then_call && !then_called) {\n3435-            then_called = true;\n3436-            events.push_back(AgentEvent::tool_call({\"call-then\", *then_call, true}));\n3437-            return true;\n3438-        }\n3439-        events.push_back(AgentEvent::delta(\"It is in.\"));\n3440-        events.push_back(AgentEvent::completed());\n3441-        return true;\n3442-    }\n3443-    void cancel() ove