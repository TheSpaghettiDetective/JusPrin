-    }\n324-    // Naming selects each printer in turn; the wizard's own choice is the one\n325-    // left selected, under its name when it was one of them.\n326-    if (!models.empty())\n327-        SetupCommands::select_printer_preset(plater, keep.empty() ? selected : keep);\n328-    return added;\n329-}\n330-\n331-wxString link_named_printer(const std::string& name, const std::string& device_id)\n332-{\n333-    const Preset* preset = saved_preset(name);\n334-    if (preset == nullptr || !is_named_printer(*preset))\n335-        return gone();\n336-    if (device_id.empty())","is_error":false}]},"uuid":"a4515eaf-4b7b-4dae-987c-1e13a5947193","timestamp":"2026-11-05T23:27:35.201Z","toolUseResult":{"stdout":"null\n[{'model': 'Bambu Lab A1 mini', 'nozzle_diameter': '0.4', 'vendor': 'BBL'}, {'model': 'Bambu Lab P1S', 'nozzle_diameter': '0.4', 'vendor': 'BBL'}, {'model': 'Creality K1C', 'nozzle_diameter': '0.4;0.6', 'vendor': 'Creality'}, {'model': 'Generic Klipper Printer', 'nozzle_diameter': '0.6', 'vendor': 'Custom'}]\n\t\"inherits\": \"MyKlipper 0.6 nozzle\",\n\t\"inherits\": \"Creality K1C 0.4 nozzle\",\n\t\"inherits\": \"Bambu Lab P1S 0.4 nozzle\",\n\t\"inherits\": \"Bambu Lab A1 mini 0.4 nozzle\",\n306:    const auto        models   = newly_installed_models(before, wxGetApp().app_config->vendors(),\n307-                                                        current.config.opt_string(\"printer_model\"),\n308-                                                        current.config.opt_string(\"printer_variant\"));\n309-    std::string keep;\n310-    for (const InstalledModel& model : models) {\n311-        const Preset* profile = presets.printers.find_system_preset_by_model_and_variant(model.model, model.variant);\n312-        if (profile == nullptr)\n313-            throw std::runtime_error(\"The wizard enabled \" + model.model + \" \" + model.variant +\n314-                                     \" but no system profile for it is loaded\");\n315-        const std::s