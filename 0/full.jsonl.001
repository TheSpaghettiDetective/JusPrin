d\" style=\"margin:0;color:var(--text-primary)\">Preferences</h1><div style=\"{BOX}width:26px;height:26px;display:flex;justify-content:center;align-items:center\">{icon(\"x\", \"--text-secondary\", 16)}</div></div>'\n            f'<div data-n=\"Body\" style=\"box-sizing:border-box;flex:1 1 auto;min-height:0;display:flex;align-items:stretch\">{nav(section)}'\n            f'<main data-n=\"Content\" style=\"box-sizing:border-box;flex:1 1 0;min-width:0;overflow:hidden;padding:var(--space-24) var(--space-32) var(--space-32)\">{content}</main></div></div>')\n\ndef group_head(s):\n    return f'<h3 class=\"body-bold\" style=\"margin:0;padding-bottom:var(--space-8);color:var(--text-primary)\">{escape(s)}</h3>'\n\ndef prefs_row(title, detail=None, trailing=(), title_cls='body'):\n    copy = [text(title_cls, title)] + ([text('label', detail, '--text-secondary')] if detail else [])\n    return (f'<div style=\"{BOX}align-self:stretch;display:flex;gap:var(--space-16);align-items:center;padding:var(--space-12) 0;box-shadow:inset 0 1px 0 0 var(--border-subtle)\">'\n            f'<div style=\"flex:1 1 0;min-width:0;display:flex;flex-direction:column;gap:2px\">' + ''.join(copy) + '</div>' + ''.join(trailing) + '</div>')\n\ndef account_row_signed_in(email='alex@example.com'):\n    status = (f'<div style=\"display:flex;gap:var(--space-8);align-items:center\">{icon(\"check\", \"--status-success\", 14)}' + text('label', f'Signed in as {email}', '--text-secondary', 'flex:none', True) + '</div>')\n    return row([col([text('body-bold', 'JusPrin account'), status], 0, 'flex:1 1 0;min-width:0'), secondary('Sign out')], 12)\n\nV1_NOTE = 'Subscribed to JusPrin v1? You get these 500 credits and keep your original price, on the $10 Hobby plan.'\n\ndef first_month_offer(button, kicker=None, note=None):\n    \"\"\"Kenneth, 2026-11-02: the reason to sign in must be what the eye lands on, not a line of small print under a button.\n    So the number is the headline, on the selected surface, and the button itself names what signing in gets.\"\"\"\n    head = [text('label-bold', kicker, '--text-secondary')] if kicker else []\n    return col(head + [col([text('section', OFFER_HEAD), text('body-small', OFFER_DETAIL)] + ([text('body-small-bold', note)] if note else []), 4), button], 12,\n               pad='padding:var(--space-16);background:var(--surface-selected);border-radius:var(--radius-medium);', name='First-month offer')\n\ndef account_row_signed_out():\n    return first_month_offer(primary(OFFER_BUTTON, block=True), 'JusPrin account')\n\ndef check_row(title, detail):\n    box = (f'<div style=\"{BOX}width:var(--component-checkbox-size);height:var(--component-checkbox-size);display:flex;justify-content:center;align-items:center;border-radius:var(--radius-small);background:var(--action-primary);box-shadow:inset 0 0 0 1px var(--action-primary)\">{icon(\"check\", \"--action-on-primary\", 12)}</div>')\n    return (f'<div style=\"{BOX}align-self:stretch;display:flex;gap:var(--space-8);align-items:flex-start;padding:var(--space-12) 0;box-shadow:inset 0 1px 0 0 var(--border-subtle)\">' + box","is_error":false}]},"uuid":"c37f182f-5ec7-4196-ad70-93103affb70b","timestamp":"2026-11-03T05:06:15.691Z","toolUseResult":{"stdout":"work-first-run/ref/main-08-home-first-run.png\nwork-first-run/ref/credits-01a-agent-setup.png\nwork-first-run/ref/prefs-02-agent-setup-one-door.png\nwork-first-run/ref/onboarding-v1-01-imported.png\n# ---- Preferences (comp-prefs-window's frame and nav; .prefs-* and .agent-* in AgentUI/styles.css) ---------------------\n_win = (proj / 'comp-prefs-window.dc.html').read_text()\n_nav = _win[_win.index('<nav data-n=\"Sections\"'):_win.index('</nav>') + 6]\n_nav = re.sub(r'<sc-if value=\"\\{\\{up\\.dot\\}\\}\".*?</sc-if>', '', _nav, flags=re.S)\n_nav = re.sub(r' onClick=\"\\{\\{nav\\.\\w+\\.go\\}\\}\"', '', _nav)\n\ndef nav(section):\n    s = _nav\n    for k in ['account', 'agent', 'appearance', 'view3d', 'projects', 'updates']:\n        on = k == sectio