{"type":"api-request-blob","sessionId":"e7286644-9c40-4163-89b2-1b9685541258","hash":"c07b0a13337bde9b66c652e06f7b439c272157488f01c40cb8b123192d37ab82","message":{"role":"user","content":[{"tool_use_id":"toolu_01NFBqtH8H6Bhv6eDkMnSN6W","type":"tool_result","content":"Agent/AgentHost.hpp:340:    void handle_tool_cancel(const std::string& envelope_id, const std::string& payload_json);\nAgent/AgentProtocol.hpp:44:inline constexpr const char* kToolCancel         = \"tool_cancel\";\nAgent/AgentHost.cpp:1049:    else if (type == Protocol::kToolCancel)\nAgent/AgentHost.cpp:1050:        handle_tool_cancel(envelope_id, payload);\nAgent/AgentHost.cpp:1901:void AgentHost::handle_tool_cancel(const std::string& envelope_id, const std::string& payload_json)\nAgentUI/src/bridge/protocol.test.ts:31:      'tool_cancel',\nAgentUI/src/bridge/protocol.ts:18:  | 'tool_cancel'\nAgentUI/src/App.tsx:292:    client.send('tool_cancel', { actionId });\n../../../../tests/agent/test_agent_bridge.cpp:316:                                              Protocol::kStopGeneration, Protocol::kRetryMessage, Protocol::kToolCancel,\n../../../../tests/agent/test_agent_bridge.cpp:1470:        harness.deliver(\"tool_cancel\", json{{\"actionId\", action_id}});","is_error":false}]}}
