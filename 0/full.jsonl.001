ing base = string_value(*json, \"inherits\");\n+                !base.empty() && std::find(bases.begin(), bases.end(), base) == bases.end())\n                 bases.push_back(std::move(base));\n     }\n     return bases;\n@@ -270,7 +271,8 @@ std::vector<OrcaImportItem> orca_profile_printers(const fs::path& orca_root, con\n             named.push_back({candidate.vendor_id, candidate.model_id, candidate.variant});\n             break;\n         }\n-    const std::vector<std::string> bases = account_folder ? orca_saved_printer_bases(*account_folder) : std::vector<std::string>();\n+    const std::vector<std::string> bases =\n+        account_folder ? orca_printer_bases(scan_orca_presets(*account_folder).files) : std::vector<std::string>();\n     for (const OrcaTickedPrinter& printer : named) {\n         const auto profile = std::find_if(candidates.begin(), candidates.end(), [&printer](const PrinterCandidate& candidate) {\n             return candidate.vendor_id == printer.vendor && candidate.model_id == printer.model && candidate.variant == printer.nozzle;","is_error":false}]},"uuid":"b367a243-dd25-463e-b576-c2c764df39f9","timestamp":"2026-11-06T00:08:05.263Z","toolUseResult":{"stdout":" M src/slic3r/GUI/JusPrin/Home/OrcaHomeBackend.cpp\n M src/slic3r/GUI/JusPrin/Home/OrcaImport.cpp\n M src/slic3r/GUI/JusPrin/Home/OrcaImport.hpp\n M tests/jusprin/test_orca_import.cpp\n?? .playwright-mcp/\n src/slic3r/GUI/JusPrin/Home/OrcaHomeBackend.cpp | 32 +++++++++++++++++++++++++\n src/slic3r/GUI/JusPrin/Home/OrcaImport.cpp      | 16 +++++++------\n src/slic3r/GUI/JusPrin/Home/OrcaImport.hpp      |  7 +++---\n tests/jusprin/test_orca_import.cpp              | 17 +++++++++++++\n 4 files changed, 62 insertions(+), 10 deletions(-)\ndiff --git a/src/slic3r/GUI/JusPrin/Home/OrcaImport.cpp b/src/slic3r/GUI/JusPrin/Home/OrcaImport.cpp\nindex 63250135e0..d297f660cc 100644\n--- a/src/slic3r/GUI/JusPrin/Home/OrcaImport.cpp\n+++ b/src/slic3r/GUI/JusPrin/Home/OrcaImport.cpp\n@@ -193,15 +193,16 