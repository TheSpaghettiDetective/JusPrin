ent.requests.rbegin(), agent.requests.rend(), [](const AgentRequest& request) {\n3835-        return request.purpose == AgentRequest::Purpose::Reply;\n3836-    });\n3837-    REQUIRE(reply != agent.requests.rend());\n3838-    return *reply;\n3839-}\n3840-\n--","is_error":false}]}}
