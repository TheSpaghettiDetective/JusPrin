{"type":"api-request-blob","sessionId":"e7286644-9c40-4163-89b2-1b9685541258","hash":"754a81773c253d9e120385309db7586f2fbc657c8eeddc20ae08a4726f10c9df","message":{"role":"user","content":[{"tool_use_id":"toolu_01W8ivPWmERM6rXMS92gq9oa","type":"tool_result","content":"};\n\n// What the selected presets say the hardware is. The plate type is the\n// untranslated name Orca stores, so it compares with what a person states.\nstruct ConfiguredFilament\n{\n    std::string preset;\n    std::string material;\n};\n\nstruct ConfiguredPrinter\n{\n    std::string                     preset;\n    std::string                     model; // the device model id a matching printer reports\n    std::vector<double>             nozzle_diameters;\n    std::string                     plate_type;\n    std::vector<ConfiguredFilament> filaments;\n};\n\n// Establish the hardware for a job. Every field is optional; what is left\n// out stays as it is unless a change it depends on forces Orca to replace it,\n704:struct ConfiguredFilament\n705-{\n706-    std::string preset;\n707-    std::string material;\n708-};\n709-\n710-struct ConfiguredPrinter\n711-{\n712-    std::string                     preset;\n713-    std::string                     model; // the device model id a matching printer reports\n714-    std::vector<double>             nozzle_diameters;\n715-    std::string                     plate_type;\n716-    std::vector<ConfiguredFilament> filaments;","is_error":false}]}}
