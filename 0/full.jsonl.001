t src=\"./support.js\"></script>\n<link rel=\"stylesheet\" href=\"ds/jusprin/tokens.css\">\n</head>\n<body>\n<x-dc>\n<helmet>\n<style>\nbody{margin:0}\n</style>\n</helmet>\n<div data-theme=\"{{theme}}\" class=\"body\" style=\"width:1328px;height:958px;position:relative;overflow:hidden;background:var(--surface-canvas);color:var(--text-primary);font-family:var(--font-sans)\"><div data-n=\"1c · Welcome back: the first-month offer for someone not signed in\" style=\"box-sizing:border-box;flex:none;position:relative;width:1328px;height:958px;display:flex;flex-direction:column;gap:var(--space-16);padding:var(--space-24);align-items:flex-start;background:var(--surface-canvas);overflow:hidden\"><div class=\"section\" style=\"box-sizing:border-box;flex:none;align-self:stretch;color:var(--text-primary)\">1c · Welcome back: the first-month offer for someone not signed in</div><div class=\"body-small\" style=\"box-sizing:border-box;flex:none;align-self:stretch;color:var(--text-secondary)\">The welcome window the app builds today, which appears only after importing JusPrin v1. The account box becomes the offer in place of “Sign in to use the agent” and “JusPrin v1 wasn’t signed in on this computer.”, without its warning triangle because an offer isn’t a warning. Signing in becomes the screen’s primary button and Continue the secondary one. Until they sign in, a JusPrin v1 subscriber can’t be told from anyone else, so the box also says what signing in means for them; 1d is what they see once signed in.</div><div data-theme=\"{{theme}}\" class=\"body\" style=\"width:1280px;height:800px;position:relative;overflow:hidden;background:var(--surface-subtle);color:var(--text-primary);font-family:var(--font-sans)\"><div data-n=\"V1-03 · JusPrin v1 sign-in expired · Light\" style=\"box-sizing:border-box;flex:none;position:relative;width:1280px;height:800px;display:flex;flex-direction:column;align-items:flex-start;background:var(--surface-canvas);overflow:hidden\"><div data-n=\"Application header\" style=\"box-sizing:border-box;flex:none;align-self:stretch;height:56px;display:flex;padding:0px var(--space-24) 0px var(--space-24);justify-content:space-between;align-items:center;box-shadow:inset 0 -1px 0 0 var(--border-subtle);overflow:hidden\"><div data-n=\"Application identity\" style=\"box-sizing:border-box;flex:none;display:flex;gap:var(--space-12);align-items:center;overflow:hidden\"><div class=\"section\" style=\"box-sizing:border-box;flex:none;white-space:nowrap;color:var(--action-primary)\">JusPrin</div><span data-icon=\"breadcrumb separator\" style=\"box-sizing:border-box;flex:none;position:relative;width:14px;height:14px;color:var(--text-secondary);display:inline-block\"><svg viewBox=\"0 0 14 14\" width=\"14\" height=\"14\" fill=\"none\" style=\"display:block;overflow:visible\" aria-hidden=\"true\"><path transform=\"translate(5.3 3.5)\" d=\"M 0 7 L 3.5 3.5 L 0 0\" stroke=\"currentColor\" stroke-width=\"1.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" fill=\"none\"/></svg></span><div class=\"body\" style=\"box-sizing:border-box;flex:none;white-space:nowrap;color:var(--text-secondary)\">Welcome</div></div><div data-n=\"App status\" style=\"box-sizing:border-box;flex:none;display:flex;gap:var(--space-8);align-items:center;overflow:hidden\"><div data-c=\"Status Dot:State=Idle\" style=\"box-sizing:border-box;flex:none;position:relative;width:8px;height:8px\"><div style=\"box-sizing:border-box;flex:none;position:absolute;left:0px;top:0px;width:8px;height:8px;background:var(--status-success);border-radius:50%\"></div></div><div class=\"label\" style=\"box-sizing:border-box;flex:none;white-space:nowrap;color:var(--text-secondary)\">Not signed in · Agent not configured</div></div></div><div data-n=\"Import content\" style=\"box-sizing:border-box;flex:none;align-self:stretch;flex:1 1 0;min-height:0;display:flex;flex-direction:column;padding:0;justify-content:center;align-items:center;overflow:hidden\"><div data-n=\"V1 import card\" style=\"box-si