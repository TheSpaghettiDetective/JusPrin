","cwd":"C:\\src\\JusPrin\\.claude\\worktrees\\calibration\\src\\slic3r\\GUI\\JusPrin\\AgentUI\\src","sessionId":"e7286644-9c40-4163-89b2-1b9685541258","version":"2.1.304","gitBranch":"claude/calibration","slug":"steady-sparking-swan"}
