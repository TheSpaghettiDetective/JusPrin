{"parentUuid":"03d7414a-b3a6-49a1-b3bf-773bfc5a9544","isSidechain":false,"message":{"model":"claude-opus-5-5","id":"msg_011CgfJmXHM47qwgjFyuYa1B","type":"message","role":"assistant","content":[{"type":"thinking","thinking":"","signature":""}],"container":null,"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":115,"cache_read_input_tokens":287121,"output_tokens":8158,"output_tokens_details":{"thinking_tokens":24},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":115,"ephemeral_5m_input_tokens":0},"inference_geo":"global","iterations":[{"input_tokens":2,"output_tokens":8158,"cache_read_input_tokens":287121,"cache_creation_input_tokens":115,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":115},"type":"message"}],"speed":"standard","fallback_credit":null},"input_transformations":[],"diagnostics":null,"context_management":null},"thinkingDurationMs":493,"thinkingDisplay":"updates","apiBlockIndex":0,"requestId":"req_011CgfJmX1UreUausaTnqZYD","requestRef":"5be78eed-73ab-4ac0-9263-0a95aa250e69","requestedModel":"claude-opus-5-5","type":"assistant","uuid":"961c7b3e-0afe-4b29-ad58-4d66b3bfdf1b","timestamp":"2026-11-03T03:45:28.567Z","advisorModel":"claude-opus-5-5","effort":"high","perTurnEffort":"high","userType":"external","entrypoint":"claude-desktop","cwd":"/Users/kenneth/.claude/projects/-Users-kenneth-Projects-JusPrin/figma-mirror/work-first-run","sessionId":"473348c5-5f94-4e4d-9ad9-c7e9dd10b438","version":"2.1.309","gitBranch":"jusprin-newui","slug":"glimmering-doodling-lovelace"}
{"parentUuid":"961c7b3e-0afe-4b29-ad58-4d66b3bfdf1b","isSidechain":false,"message":{"model":"claude-opus-5-5","id":"msg_011CgfJmXHM47qwgjFyuYa1B","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01HJQXjXttKmGPqdwVHgEeQc","name":"Write","input":{"file_path":"/Users/kenneth/.claude/projects/-Users-kenneth-Projects-JusPrin/figma-mirror/tools/composer/build_first_run_page.py","content":"\"\"\"Draws the first-launch welcome screen Kenneth decided on 2026-11-02 (memory: first-run-value-prop-decisions), as boards on the\ncanvas's \"On boarding experience\" page: the welcome with its clip at beat 1, the welcome with the clip's final frame, and a\nstoryboard of the clip's four beats. Every board is a whole 1280 x 800 screen. The layout and timing follow the reference animatic in\ndesign-captures/value-prop-2026-11/animatic/src (animatic.html, welcome-stringing.html, strings.js); colours, radii, type and\nspacing come from the token file. It replaces the no-wizard variants A and B (first-run-a-*, first-run-b-*), which this script\nremoves from the index. Usage: build_first_run_page.py <canvas project dir>; render with render_dc.py.\"\"\"\nimport json, re, sys\nfrom html import escape\nfrom pathlib import Path\n\nproj = Path(sys.argv[1])\n_src = (Path(__file__).parent / 'build_credits_page.py').read_text()\nexec(_src[:_src.index('# ---- Preferences')])\n\nPAGE = 'onboarding'\nICONS.update({\n    'circle-check': '<circle cx=\"12\" cy=\"12\" r=\"10\" /><path d=\"m9 12 2 2 4-4\" />',\n    'circle-dashed': '<path d=\"M10.1 2.182a10 10 0 0 1 3.8 0\" /><path d=\"M13.9 21.818a10 10 0 0 1-3.8 0\" /><path d=\"M17.609 3.721a10 10 0 0 1 2.69 2.7\" /><path d=\"M2.182 13.9a10 10 0 0 1 0-3.8\" /><path d=\"M20.279 17.609a10 10 0 0 1-2.7 2.69\" /><path d=\"M21.818 10.1a10 10 0 0 1 0 3.8\" /><path d=\"M3.721 6.391a10 10 0 0 1 2.7-2.69\" /><path d=\"M6.391 20.279a10 10 0 0 1-2.69-2.7\" />',\n    'chevron-right': '<path d=\"m9 18 6-6-6-6\" />',\n})\n\n# The clip's pictures. The photos are the CC BY 2.0 #3DBenchy photos as edited in photo/ATTRIBUTION.md, scaled to 1200 wide; the boats\n# on the plate are the animatic's renders of the bundled 3DBenchy (render_benchy.py), standing in for the app's own view.\nPHOTO_FAILED, PHOTO_CLEAN = '/_blob/ffb4fd1e55daad0c7d05a62e9be4419e', '/_blob/d1d0da8df4a3b47e13751b9a5eb187c6'\nBOAT_MODEL, BOAT_SLICED = '/_blob/686e61119d60dca9576b0cca762d2c0b', '/_blob/edf2c391e9915065d6f51d6b8af7585c'\n\n# Every string the screen and the clip show, as Kenneth chose them (strings.js for the clip).\nTITLE = 'The AI slicer that fixes failed prints.'\nSUBTITLE = 'Show it a photo of what went wrong. The agent reads your file, your settings and your slice, changes the settings and slices again.'\nDOORS_LABEL = 'Pick how the agent should think. Change it any time in Preferences › Agent.'\nOFFER_HEAD, OFFER_DETAIL = 'Your first month: 500 credits', 'An Expert message is 5 credits. Then paid, or your own key.'\nFOOTER = 'Slicing works without an account. The agent needs one, or your own API key.'\nCAPTIONS = ['Show it what happened.', 'It reads your photo, your file and your slice.', 'It changes the settings for you.', 'And slices again. Tonight.']\nASKED = 'I printed it and it failed. What went wrong? Photo attached.'\n# Placeholder: the opening of a real reply from a different print (journey j3-opus-photo, the vase), until a live run on this photo.\nREPLY = ('I’m sorry the print failed. Your photo shows the base rings went down, but once one side came loose the nozzle kept printing '\n         'into thin air, which made the tangle of loose strands. I looked at the slice and the settings are normal for PLA on a textured PEI plate.')\nSETTINGS = [('Retraction 0.8 → ', '2 mm'), ('Nozzle 220 → ', '200 °C')]   # placeholders, textbook fixes for stringing\nSLICING = 'Slicing '   # the app's \"Slicing %d%%\", LeftPane.cpp\nDONE = 'Sliced · ready · 1 h 34 min · 34 g'\nCREDIT = ('Photos: “Dual extrusion 3D printed #3DBenchy v01” (flickr.com/photos/3dbenchy/19273965123) and “Dual-print multi-part color 3D print '\n          'of #3DBenchy v13” (flickr.com/photos/3dbenchy/19239738473) by #3DBenchy, CC BY 2.0. Cropped and resized.')\n\n# ---- the clip: one frame of the animatic, 620 x 388, positioned as animatic.html positions it ----------------------------------------\nCLIP_W, CLIP_H = 620, 388\nABS = BOX + 'position:absolute;'\nPHOTO_BIG, PHOTO_CORNER = (236, 14, 368, 230), (16, 16, 184, 115)\n\ndef photo(src, rect):\n    x, y, w, h = rect\n    return f'<img src=\"{src}\" alt=\"\" style=\"{ABS}left:{x}px;top:{y}px;width:{w}px;height:{h}px;object-fit:cover;object-position:50% 45%;border-radius:var(--radius-medium)\">'\n\ndef plate(boat, shift=0):\n    \"\"\"The bed and a boat on it. Beat 1 shows the left 220 px of it (shifted 400 px left); beat 4 shows it whole.\"\"\"\n    bed = (f'<div style=\"{ABS}left:{340 - shift}px;top:24px;width:264px;height:348px;border-radius:var(--radius-small);background-color:var(--surface-raised);box-shadow:inset 0 0 0 1px var(--border-subtle);'\n           'background-image:linear-gradient(var(--border-subtle) 1px,transparent 1px),linear-gradient(90deg,var(--border-subtle) 1px,transparent 1px);background-size:var(--space-48) var(--space-48)\"></div>')\n    return (f'<div data-n=\"Plate\" style=\"{ABS}left:0;top:0;width:{CLIP_W}px;height:{CLIP_H}px;background:var(--surface-subtle)\">' + bed\n            + f'<img src=\"{boat}\" alt=\"\" style=\"{ABS}left:{420 - shift}px;top:110px;width:180px\"></div>')\n\ndef caption(i):\n    return (f'<div data-n=\"Caption\" class=\"body-bold\" style=\"{ABS}left:var(--space-16);bottom:var(--space-16);padding:var(--space-8) var(--space-12);background:var(--surface-failure-inverse);'\n            f'color:var(--text-on-failure-primary);border-radius:var(--radius-small);white-space:nowrap\">{escape(CAPTIONS[i])}</div>')\n\ndef reply_burst():\n    \"\"\"Beats 2 and 3: three lines of the reply as texture. It says \"working\" and is not meant to be read.\"\"\"\n    return f'<div data-n=\"Reply, placeholder\" class=\"metadata\" style=\"{ABS}left:var(--space-16);right:var(--space-16);top:140px;height:42px;overflow:hidden;color:var(--text-tertiary)\">{escape(REPLY)}</div>'\n\ndef big_settings():\n    lines = ''.join(f'<div class=\"page-title\" style=\"{BOX}white-space:nowrap;color:var(--text-secondary);font-weight:400\">{escape(a)}<b style=\"font-weight:700;color:var(--action-primary)\">{escape(b)}</b></div>' for a, b in SETTINGS)\n    return f'<div data-n=\"Settings changed\" style=\"{ABS}left:216px;top:var(--space-16);width:388px;display:flex;flex-direction:column;gap:var(--space-8)\">{lines}</div>'\n\ndef slicing(pct):\n    head = f'<div class=\"page-title\" style=\"{ABS}left:var(--space-16);top:148px;white-space:nowrap;color:var(--text-primary)\">{SLICING}<span style=\"color:var(--action-primary)\">{pct}</span>%</div>'\n    bar = (f'<div data-n=\"Slicing bar\" style=\"{ABS}left:var(--space-16);top:196px;width:300px;height:var(--component-progress-height);border-radius:var(--radius-full);background:var(--border-subtle);overflow:hidden\">'\n           f'<div style=\"{BOX}width:{pct}%;height:100%;background:var(--action-primary)\"></div></div>')\n    return head + bar\n\ndef sliced_line():\n    return (f'<div style=\"{ABS}left:var(--space-16);top:148px\">{icon(\"circle-check\", \"--status-success\", 40)}</div>'\n            f'<div class=\"section\" style=\"{ABS}left:var(--space-16);top:204px;white-space:nowrap;color:var(--status-success)\">{escape(DONE)}</div>')\n\ndef clip(beat):\n    \"\"\"beat: 1, 2, 3, '4a' (the bar counting, at 68%) or 4 (the final frame, held longest).\"\"\"\n    if beat == 1:\n        kids = [plate(BOAT_MODEL, 400), photo(PHOTO_FAILED, PHOTO_BIG),\n                f'<div data-n=\"Their message\" class=\"body\" style=\"{ABS}right:var(--space-16);top:252px;width:276px;padding:var(--space-8) var(--space-12);border-radius:var(--radius-medium);background:var(--surface-subtle)\">{escape(ASKED)}</div>',\n                caption(0)]\n    elif beat in (2, 3):\n        kids = [photo(PHOTO_FAILED, PHOTO_CORNER), reply_burst()] + ([big_settings()] if beat == 3 else []) + [caption(beat - 1)]\n    elif beat == '4a':\n        kids = [plate(BOAT_MODEL), photo(PHOTO_FAILED, PHOTO_CORNER), slicing(68), caption(3)]\n    else:\n        kids = [plate(BOAT_SLICED), photo(PHOTO_CLEAN, PHOTO_CORNER), sliced_line(), caption(3)]\n    return f'<div data-n=\"Clip, beat {beat}\" style=\"{BOX}position:relative;width:{CLIP_W}px;height:{CLIP_H}px;overflow:hidden;background:var(--surface-canvas)\">' + ''.join(kids) + '</div>'\n\n# ---- the welcome screen -----------------------------------------------------------------------------------------------------------\ndef header():\n    left = row([text('section', 'JusPrin', '--action-primary', 'flex:none', True), icon('chevron-right', '--text-secondary', 14), text('body', 'Agent', '--text-secondary', 'flex:none', True)], 12, 'flex:none')\n    right = row([icon('circle-dashed', '--text-secondary', 12), text('label', 'Agent not connected', '--text-secondary', 'flex:none', True)], 8, 'flex:none')\n    return f'<div data-n=\"top-bar\" style=\"{BOX}align-self:stretch;height:56px;display:flex;padding:0 var(--space-24);justify-content:space-between;align-items:center;box-shadow:inset 0 -1px 0 0 var(--border-subtle)\">{left}{right}</div>'\n\ndef free_door(name, cost):\n    return (f'<div data-n=\"Door: {escape(name)}\" style=\"{BOX}align-self:stretch;display:flex;gap:var(--space-16);justify-content:space-between;align-items:center;padding:var(--space-12) var(--space-16);'\n            'background:var(--surface-subtle);border-radius:var(--radius-medium);box-shadow:inset 0 0 0 1px var(--border-subtle)\">'\n            + text('body-bold', name, extra='flex:1 1 0;min-width:0') + text('label', cost, '--text-secondary', 'flex:none', True) + '</div>')\n\ndef doors():\n    offer = (f'<div data-n=\"Door: first-month offer\" style=\"{BOX}align-self:stretch;display:flex;flex-direction:column;gap:var(--space-4);align-items:flex-start;padding:var(--space-16);'\n             'background:var(--surface-selected);border-radius:var(--radius-medium);box-shadow:inset 0 0 0 1px var(--border-subtle)\">'\n             + text('section', OFFER_HEAD) + text('body-small', OFFER_DETAIL, '--text-secondary')\n             + f'<div style=\"{BOX}margin-top:var(--space-8)\">{primary(OFFER_BUTTON)}</div></div>')\n    just = f'<div style=\"{BOX}padding:var(--space-4) 0\">' + text('label-bold', 'Just slice for now', '--action-primary', 'flex:none', True) + '</div>'\n    return col([text('label', DOORS_LABEL, '--text-secondary'), offer, free_door('Your own API key', 'Free'), free_door('Claude Code or Claude Desktop', 'Free · MCP server'), just], 8, name='Doors')\n\ndef welcome(beat):\n    framed = f'<div data-n=\"Clip\" style=\"{BOX}position:relative;width:{CLIP_W}px;height:{CLIP_H}px;border-radius:var(--radius-medium);overflow:hidden;box-shadow:var(--elevation-medium)\">{clip(beat)}</div>'\n    words = col([col([text('page-title', TITLE), text('body', SUBTITLE, '--text-secondary')], 8), doors()], 20, 'flex:1 1 0;min-width:0', name='Words and doors')\n    body = (f'<div data-n=\"Welcome\" style=\"{BOX}flex:1 1 0;min-height:0;align-self:stretch;display:flex;justify-content:center;align-items:center;padding-bottom:var(--space-32)\">'\n            f'<div style=\"{BOX}width:1120px;display:flex;gap:var(--space-48);align-items:center\">{framed}{words}</div></div>')\n    foot = f'<div data-n=\"Footer\" style=\"{BOX}align-self:stretch;height:32px;display:flex;padding:0 var(--space-24);align-items:center;box-shadow:inset 0 1px 0 0 var(--border-subtle)\">' + text('label', FOOTER, '--text-secondary', 'flex:none', True) + '</div>'\n    return (f'<div data-n=\"Welcome screen\" data-theme=\"{THEME}\" class=\"body\" style=\"{BOX}position:relative;width:{SCREEN_W}px;height:{SCREEN_H}px;display:flex;flex-direction:column;background:var(--surface-canvas);color:var(--text-primary);font-family:var(--font-sans);overflow:hidden\">'\n            + header() + body + foot + '</div>')\n\n# ---- the storyboard ---------------------------------------------------------------------------------------------------------------\nBEATS = [(1, 'Beat 1 · 0 to 2.6 s'), (2, 'Beat 2 · 2.6 to 5 s'), (3, 'Beat 3 · 5 to 7.2 s'), ('4a', 'Beat 4 · 7.2 to 12.2 s, here at 68 %; the final frame is on 02')]\nSCALE = 0.75   # the frames at three quarters of their size, so four fit beside the notes\n\ndef storyboard():\n    cells = ''.join(col([text('label-bold', label, '--text-secondary'),\n                         f'<div style=\"{BOX}width:{CLIP_W * SCALE:.0f}px;height:{CLIP_H * SCALE:.0f}px;border-radius:var(--radius-medium);overflow:hidden;box-shadow:inset 0 0 0 1px var(--border-subtle)\">'\n                         f'<div style=\"{BOX}transform:scale({SCALE});transform-origin:0 0\">{clip(beat)}</div></div>'], 4, 'flex:none')\n                    for beat, label in BEATS)\n    grid = f'<div data-n=\"Beats\" style=\"{BOX}display:grid;grid-template-columns:repeat(2,auto);gap:var(--space-16) var(--space-16)\">{cells}</div>'\n    notes = col([text('section', 'The first-launch clip'),\n                 text('body-small', 'About 12 seconds, silent and looping. Motion only at the beat changes, short holds, and the last frame held longest.', '--text-secondary'),\n                 text('label', 'The agent’s words in beat 2 are placeholders: the opening of a real reply about a different print, until a live run on this photo is recorded. The two settings in beat 3 are placeholders too.', '--text-secondary'),\n                 text('label', 'The boats on the plate are renders of the bundled 3DBenchy, standing in for the app’s own view. The clip that ships is a recording of the real app.', '--text-secondary'),\n                 text('label', 'The settings, the Slicing line and the bar are drawn at page-title size, the largest in the type scale. The reference animatic drew them at 36 to 48 px, which no type token covers.', '--text-secondary'),\n                 f'<div style=\"{BOX}flex:1 1 0\"></div>', text('metadata', CREDIT, '--text-tertiary')], 12, 'flex:1 1 0;min-width:0;align-self:stretch', name='Notes')\n    return (f'<div data-n=\"Clip storyboard\" data-theme=\"{THEME}\" class=\"body\" style=\"{BOX}width:{SCREEN_W}px;height:{SCREEN_H}px;display:flex;gap:var(--space-24);padding:var(--space-24);background:var(--surface-canvas);color:var(--text-primary);font-family:var(--font-sans);overflow:hidden\">'\n            + notes + grid + '</div>')\n\n# ---- boards -----------------------------------------------------------------------------------------------------------------------\nTOP = 5220\nBOARDS = [\n    ('first-run-welcome-01-clip-beat-1', 'First run · 01 · Welcome, the clip at beat 1', welcome(1), -1440, TOP),\n    ('first-run-welcome-02-clip-final-frame', 'First run · 02 · Welcome, the clip’s final frame', welcome(4), -80, TOP),\n    ('first-run-welcome-03-clip-storyboard', 'First run · 03 · The clip’s four beats', storyboard(), 1280, TOP),\n]\n\ndef wrap(title, inner):\n    return f'''<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<title>{escape(title)}</title>\n<script src=\"./support.js\"></script>\n<link rel=\"stylesheet\" href=\"ds/jusprin/tokens.css\">\n</head>\n<body>\n<x-dc>\n<helmet>\n<style>\nbody{{margin:0}}\n</style>\n</helmet>\n<div data-theme=\"{{{{theme}}}}\" class=\"body\" style=\"width:{SCREEN_W}px;height:{SCREEN_H}px;position:relative;overflow:hidden;background:var(--surface-canvas);color:var(--text-primary);font-family:var(--font-sans)\">{inner}</div>\n</x-dc>\n<script type=\"text/x-dc\" data-dc-script data-props='{{\"theme\":{{\"editor\":\"enum\",\"options\":[\"light\",\"dark\"],\"default\":\"light\"}},\"$preview\":{{\"width\":{SCREEN_W},\"height\":{SCREEN_H}}}}}'>\nclass Component extends DCLogic {{\n  renderVals() {{ return {{ theme: this.props.theme ?? 'light' }}; }}\n}}\n</script>\n</body>\n</html>\n'''\n\ncanvas_path = proj / 'canvas.json'\ncanvas = json.loads(canvas_path.read_text())\n# Variants A and B are withdrawn (Kenneth, 2026-11-02); their boards and notes go, and nothing else on the page moved for them.\nremoved = [k for k in canvas['boards'] if k.startswith(('first-run-a-', 'first-run-b-'))]\nfor k in removed:\n    del canvas['boards'][k]\n    canvas['order'].remove(k)\n    (proj / k).unlink(missing_ok=True)\nfor nid in ('first-run-title', 'first-run-replaces', 'first-run-b-title', 'first-run-b-about'):\n    canvas['notes'].pop(nid, None)\n    if nid in canvas['noteOrder']:\n        canvas['noteOrder'].remove(nid)\nnames = []\nfor stem, title, inner, x, y in BOARDS:\n    name = stem + '.dc.html'\n    (proj / name).write_text(wrap(title.replace('First run · ', ''), inner))\n    names.append(name)\n    canvas['boards'][name] = {'x': x, 'y': y, 'w': SCREEN_W, 'h': SCREEN_H, 'title': title, 'page': PAGE}\n    if name not in canvas['order']:\n        canvas['order'].append(name)\ncanvas['notes']['first-run-welcome-title'] = {'x': -1440, 'y': TOP - 100, 'text': 'First launch: one welcome screen', 'kind': 'title1', 'size': 40, 'maxW': 2400, 'page': PAGE}\ncanvas['notes']['first-run-welcome-about'] = {'x': -1920, 'y': TOP, 'w': 420, 'page': PAGE, 'fill': 'purple',\n    'text': 'Decided by Kenneth, 2026-11-02. No wizard: the first launch is one welcome screen, a looping silent clip on the left and the words and doors on the right. '\n            'It replaces the onboarding wizard (boards 00 to 11 and 17 to 18 on this page, and Welcome 1b to 1d), which stay here until he retires them.\\n\\n'\n            'The proposition is expert help with a failed print, now, from an AI that can see the file, the settings and the slice and fixes the settings. '\n            'One door is primary, the first-month offer; the two free doors show their cost; “Just slice for now” is a link.\\n\\n'\n            'After the doors nothing new is decided: each setup door opens Preferences › Agent (the one setup flow, 2026-10-23), and “Just slice for now” goes to Home, '\n            'with the printer from the 3MF, else an OrcaSlicer import, else a default the chip marks as assumed. Those screens are not drawn here.\\n\\n'\n            'The clip’s pictures and strings follow the reference animatic in design-captures/value-prop-2026-11; 03 says which parts are placeholders.'}\nfor nid in ('first-run-welcome-title', 'first-run-welcome-about'):\n    if nid not in canvas['noteOrder']:\n        canvas['noteOrder'].append(nid)\ncanvas_path.write_text(json.dumps(canvas, ensure_ascii=False, indent=1))\nprint('\\n'.join(names))\nif removed:\n    print('REMOVED ' + ' '.join(removed), file=sys.stderr)\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":115,"cache_read_input_tokens":287121,"output_tokens":8158,"output_tokens_details":{"thinking_tokens":24},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":115,"ephemeral_5m_input_tokens":0},"inference_geo":"global","iterations":[{"input_tokens":2,"output_tokens":8158,"cache_read_input_tokens":287121,"cache_creation_input_tokens":115,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":115},"type":"message"}],"speed":"standard","fallback_credit":null},"input_transformations":[],"diagnostics":null,"context_management":null},"wireToolInputs":{"toolu_01HJQXjXttKmGPqdwVHgEeQc":{"file_path":"/Users/kenneth/.claude/projects/-Users-kenneth-Projects-JusPrin/figma-mirror/tools/composer/build_first_run_page.py","content":"\"\"\"Draws the first-launch welcome screen Kenneth decided on 2026-11-02 (memory: first-run-value-prop-decisions), as boards on the\ncanvas's \"On boarding experience\" page: the welcome with its clip at beat 1, the welcome with the clip's final frame, and a\nstoryboard of the clip's four beats. Every board is a whole 1280 x 800 screen. The layout and timing follow the reference animatic in\ndesign-captures/value-prop-2026-11/animatic/src (animatic.html, welcome-stringing.html, strings.js); colours, radii, type and\nspacing come from the token file. It replaces the no-wizard variants A and B (first-run-a-*, first-run-b-*), which this script\nremoves from the index. Usage: build_first_run_page.py <canvas project dir>; render with render_dc.py.\"\"\"\nimport json, re, sys\nfrom html import escape\nfrom pathlib import Path\n\nproj = Path(sys.argv[1])\n_src = (Path(__file__).parent / 'build_credits_page.py').read_text()\nexec(_src[:_src.index('# ---- Preferences')])\n\nPAGE = 'onboarding'\nICONS.update({\n    'circle-check': '<circle cx=\"12\" cy=\"12\" r=\"10\" /><path d=\"m9 12 2 2 4-4\" />',\n    'circle-dashed': '<path d=\"M10.1 2.182a10 10 0 0 1 3.8 0\" /><path d=\"M13.9 21.818a10 10 0 0 1-3.8 0\" /><path d=\"M17.609 3.721a10 10 0 0 1 2.69 2.7\" /><path d=\"M2.182 13.9a10 10 0 0 1 0-3.8\" /><path d=\"M20.279 17.609a10 10 0 0 1-2.7 2.69\" /><path d=\"M21.818 10.1a10 10 0 0 1 0 3.8\" /><path d=\"M3.721 6.391a10 10 0 0 1 2.7-2.69\" /><path d=\"M6.391 20.279a10 10 0 0 1-2.69-2.7\" />',\n    'chevron-right': '<path d=\"m9 18 6-6-6-6\" />',\n})\n\n# The clip's pictures. The photos are the CC BY 2.0 #3DBenchy photos as edited in photo/ATTRIBUTION.md, scaled to 1200 wide; the boats\n# on the plate are the animatic's renders of the bundled 3DBenchy (render_benchy.py), standing in for the app's own view.\nPHOTO_FAILED, PHOTO_CLEAN = '/_blob/ffb4fd1e55daad0c7d05a62e9be4419e', '/_blob/d1d0da8df4a3b47e13751b9a5eb187c6'\nBOAT_MODEL, BOAT_SLICED = '/_blob/686e61119d60dca9576b0cca762d2c0b', '/_blob/edf2c391e9915065d6f51d6b8af7585c'\n\n# Every string the screen and the clip show, as Kenneth chose them (strings.js for the clip).\nTITLE = 'The AI slicer that fixes failed prints.'\nSUBTITLE = 'Show it a photo of what went wrong. The agent reads your file, your settings and your slice, changes the settings and slices again.'\nDOORS_LABEL = 'Pick how the agent should think. Change it any time in Preferences › Agent.'\nOFFER_HEAD, OFFER_DETAIL = 'Your first month: 500 credits', 'An Expert message is 5 credits. Then paid, or your own key.'\nFOOTER = 'Slicing works without an account. The agent needs one, or your own API key.'\nCAPTIONS = ['Show it what happened.', 'It reads your photo, your file and your slice.', 'It changes the settings for you.', 'And slices again. Tonight.']\nASKED = 'I printed it and it failed. What went wrong? Photo attached.'\n# Placeholder: the opening of a real reply from a different print (journey j3-opus-photo, the vase), until a live run on this photo.\nREPLY = ('I’m sorry the print failed. Your photo shows the base rings went down, but once one side came loose the nozzle kept printing '\n         'into thin air, which made the tangle of loose strands. I looked at the slice and the settings are normal for PLA on a textured PEI plate.')\nSETTINGS = [('Retraction 0.8 → ', '2 mm'), ('Nozzle 220 → ', '200 °C')]   # placeholders, textbook fixes for stringing\nSLICING = 'Slicing '   # the app's \"Slicing %d%%\", LeftPane.cpp\nDONE = 'Sliced · ready · 1 h 34 min · 34 g'\nCREDIT = ('Photos: “Dual extrusion 3D printed #3DBenchy v01” (flickr.com/photos/3dbenchy/19273965123) and “Dual-print multi-part color 3D print '\n          'of #3DBenchy v13” (flickr.com/photos/3dbenchy/19239738473) by #3DBenchy, CC BY 2.0. Cropped and resized.')\n\n# ---- the clip: one frame of the animatic, 620 x 388, positioned as animatic.html positions it ----------------------------------------\nCLIP_W, CLIP_H = 620, 388\nABS = BOX + 'position:absolute;'\nPHOTO_BIG, PHOTO_CORNER = (236, 14, 368, 230), (16, 16, 184, 115)\n\ndef photo(src, rect):\n    x, y, w, h = rect\n    return f'<img src=\"{src}\" alt=\"\" style=\"{ABS}left:{x}px;top:{y}px;width:{w}px;height:{h}px;object-fit:cover;object-position:50% 45%;border-radius:var(--radius-medium)\">'\n\ndef plate(boat, shift=0):\n    \"\"\"The bed and a boat on it. Beat 1 shows the left 220 px of it (shifted 400 px left); beat 4 shows it whole.\"\"\"\n    bed = (f'<div style=\"{ABS}left:{340 - shift}px;top:24px;width:264px;height:348px;border-radius:var(--radius-small);background-color:var(--surface-raised);box-shadow:inset 0 0 0 1px var(--border-subtle);'\n           'background-image:linear-gradient(var(--border-subtle) 1px,transparent 1px),linear-gradient(90deg,var(--border-subtle) 1px,transparent 1px);background-size:var(--space-48) var(--space-48)\"></div>')\n    return (f'<div data-n=\"Plate\" style=\"{ABS}left:0;top:0;width:{CLIP_W}px;height:{CLIP_H}px;background:var(--surface-subtle)\">' + bed\n            + f'<img src=\"{boat}\" alt=\"\" style=\"{ABS}left:{420 - shift}px;top:110px;width:180px\"></div>')\n\ndef caption(i):\n    return (f'<div data-n=\"Caption\" class=\"body-bold\" style=\"{ABS}left:var(--space-16);bottom:var(--space-16);padding:var(--space-8) var(--space-12);background:var(--surface-failure-inverse);'\n            f'color:var(--text-on-failure-primary);border-radius:var(--radius-small);white-space:nowrap\">{escape(CAPTIONS[i])}</div>')\n\ndef reply_burst():\n    \"\"\"Beats 2 and 3: three lines of the reply as texture. It says \"working\" and is not meant to be read.\"\"\"\n    return f'<div data-n=\"Reply, placeholder\" class=\"metadata\" style=\"{ABS}left:var(--space-16);right:var(--space-16);top:140px;height:42px;overflow:hidden;color:var(--text-tertiary)\">{escape(REPLY)}</div>'\n\ndef big_settings():\n    lines = ''.join(f'<div class=\"page-title\" style=\"{BOX}white-space:nowrap;color:var(--text-secondary);font-weight:400\">{escape(a)}<b style=\"font-weight:700;color:var(--action-primary)\">{escape(b)}</b></div>' for a, b in SETTINGS)\n    return f'<div data-n=\"Settings changed\" style=\"{ABS}left:216px;top:var(--space-16);width:388px;display:flex;flex-direction:column;gap:var(--space-8)\">{lines}</div>'\n\ndef slicing(pct):\n    head = f'<div class=\"page-title\" style=\"{ABS}left:var(--space-16);top:148px;white-space:nowrap;color:var(--text-primary)\">{SLICING}<span style=\"color:var(--action-primary)\">{pct}</span>%</div>'\n    bar = (f'<div data-n=\"Slicing bar\" style=\"{ABS}left:var(--space-16);top:196px;width:300px;height:var(--component-progress-height);border-radius:var(--radius-full);background:var(--border-subtle);overflow:hidden\">'\n           f'<div style=\"{BOX}width:{pct}%;height:100%;background:var(--action-primary)\"></div></div>')\n    return head + bar\n\ndef sliced_line():\n    return (f'<div style=\"{ABS}left:var(--space-16);top:148px\">{icon(\"circle-check\", \"--status-success\", 40)}</div>'\n            f'<div class=\"section\" style=\"{ABS}left:var(--space-16);top:204px;white-space:nowrap;color:var(--status-success)\">{escape(DONE)}</div>')\n\ndef clip(beat):\n    \"\"\"beat: 1, 2, 3, '4a' (the bar counting, at 68%) or 4 (the final frame, held longest).\"\"\"\n    if beat == 1:\n        kids = [plate(BOAT_MODEL, 400), photo(PHOTO_FAILED, PHOTO_BIG),\n                f'<div data-n=\"Their message\" class=\"body\" style=\"{ABS}right:var(--space-16);top:252px;width:276px;padding:var(--space-8) var(--space-12);border-radius:var(--radius-medium);background:var(--surface-subtle)\">{escape(ASKED)}</div>',\n                caption(0)]\n    elif beat in (2, 3):\n        kids = [photo(PHOTO_FAILED, PHOTO_CORNER), reply_burst()] + ([big_settings()] if beat == 3 else []) + [caption(beat - 1)]\n    elif beat == '4a':\n        kids = [plate(BOAT_MODEL), photo(PHOTO_FAILED, PHOTO_CORNER), slicing(68), caption(3)]\n    else:\n        kids = [plate(BOAT_SLICED), photo(PHOTO_CLEAN, PHOTO_CORNER), sliced_line(), caption(3)]\n    return f'<div data-n=\"Clip, beat {beat}\" style=\"{BOX}position:relative;width:{CLIP_W}px;height:{CLIP_H}px;overflow:hidden;background:var(--surface-canvas)\">' + ''.join(kids) + '</div>'\n\n# ---- the welcome screen -----------------------------------------------------------------------------------------------------------\ndef header():\n    left = row([text('section', 'JusPrin', '--action-primary', 'flex:none', True), icon('chevron-right', '--text-secondary', 14), text('body', 'Agent', '--text-secondary', 'flex:none', True)], 12, 'flex:none')\n    right = row([icon('circle-dashed', '--text-secondary', 12), text('label', 'Agent not connected', '--text-secondary', 'flex:none', True)], 8, 'flex:none')\n    return f'<div data-n=\"top-bar\" style=\"{BOX}align-self:stretch;height:56px;display:flex;padding:0 var(--space-24);justify-content:space-between;align-items:center;box-shadow:inset 0 -1px 0 0 var(--border-subtle)\">{left}{right}</div>'\n\ndef free_door(name, cost):\n    return (f'<div data-n=\"Door: {escape(name)}\" style=\"{BOX}align-self:stretch;display:flex;gap:var(--space-16);justify-content:space-between;align-items:center;padding:var(--space-12) var(--space-16);'\n            'background:var(--surface-subtle);border-radius:var(--radius-medium);box-shadow:inset 0 0 0 1px var(--border-subtle)\">'\n            + text('body-bold', name, extra='flex:1 1 0;min-width:0') + text('label', cost, '--text-secondary', 'flex:none', True) + '</div>')\n\ndef doors():\n    offer = (f'<div data-n=\"Door: first-month offer\" style=\"{BOX}align-self:stretch;display:flex;flex-direction:column;gap:var(--space-4);align-items:flex-start;padding:var(--space-16);'\n             'background:var(--surface-selected);border-radius:var(--radius-medium);box-shadow:inset 0 0 0 1px var(--border-subtle)\">'\n             + text('section', OFFER_HEAD) + text('body-small', OFFER_DETAIL, '--text-secondary')\n             + f'<div style=\"{BOX}margin-top:var(--space-8)\">{primary(OFFER_BUTTON)}</div></div>')\n    just = f'<div style=\"{BOX}padding:var(--space-4) 0\">' + text('label-bold', 'Just slice for now', '--action-primary', 'flex:none', True) + '</div>'\n    return col([text('label', DOORS_LABEL, '--text-secondary'), offer, free_door('Your own API key', 'Free'), free_door('Claude Code or Claude Desktop', 'Free · MCP server'), just], 8, name='Doors')\n\ndef welcome(beat):\n    framed = f'<div data-n=\"Clip\" style=\"{BOX}position:relative;width:{CLIP_W}px;height:{CLIP_H}px;border-radius:var(--radius-medium);overflow:hidden;box-shadow:var(--elevation-medium)\">{clip(beat)}</div>'\n    words = col([col([text('page-title', TITLE), text('body', SUBTITLE, '--text-secondary')], 8), doors()], 20, 'flex:1 1 0;min-width:0', name='Words and doors')\n    body = (f'<div data-n=\"Welcome\" style=\"{BOX}flex:1 1 0;min-height:0;align-self:stretch;display:flex;justify-content:center;align-items:center;padding-bottom:var(--space-32)\">'\n            f'<div style=\"{BOX}width:1120px;display:flex;gap:var(--space-48);align-items:center\">{framed}{words}</div></div>')\n    foot = f'<div data-n=\"Footer\" style=\"{BOX}align-self:stretch;height:32px;display:flex;padding:0 var(--space-24);align-items:center;box-shadow:inset 0 1px 0 0 var(--border-subtle)\">' + text('label', FOOTER, '--text-secondary', 'flex:none', True) + '</div>'\n    return (f'<div data-n=\"Welcome screen\" data-theme=\"{THEME}\" class=\"body\" style=\"{BOX}position:relative;width:{SCREEN_W}px;height:{SCREEN_H}px;display:flex;flex-direction:column;background:var(--surface-canvas);color:var(--text-primary);font-family:var(--font-sans);overflow:hidden\">'\n            + header() + body + foot + '</div>')\n\n# ---- the storyboard ---------------------------------------------------------------------------------------------------------------\nBEATS = [(1, 'Beat 1 · 0 to 2.6 s'), (2, 'Beat 2 · 2.6 to 5 s'), (3, 'Beat 3 · 5 to 7.2 s'), ('4a', 'Beat 4 · 7.2 to 12.2 s, here at 68 %; the final frame is on 02')]\nSCALE = 0.75   # the frames at three quarters of their size, so four fit beside the notes\n\ndef storyboard():\n    cells = ''.join(col([text('label-bold', label, '--text-secondary'),\n                         f'<div style=\"{BOX}width:{CLIP_W * SCALE:.0f}px;height:{CLIP_H * SCALE:.0f}px;border-radius:var(--radius-medium);overflow:hidden;box-shadow:inset 0 0 0 1px var(--border-subtle)\">'\n                         f'<div style=\"{BOX}transform:scale({SCALE});transform-origin:0 0\">{clip(beat)}</div></div>'], 4, 'flex:none')\n                    for beat, label in BEATS)\n    grid = f'<div data-n=\"Beats\" style=\"{BOX}display:grid;grid-template-columns:repeat(2,auto);gap:var(--space-16) var(--space-16)\">{cells}</div>'\n    notes = col([text('section', 'The first-launch clip'),\n                 text('body-small', 'About 12 seconds, silent and looping. Motion only at the beat changes, short holds, and the last frame held longest.', '--text-secondary'),\n                 text('label', 'The agent’s words in beat 2 are placeholders: the opening of a real reply about a different print, until a live run on this photo is recorded. The two settings in beat 3 are placeholders too.', '--text-secondary'),\n                 text('label', 'The boats on the plate are renders of the bundled 3DBenchy, standing in for the app’s own view. The clip that ships is a recording of the real app.', '--text-secondary'),\n                 text('label', 'The settings, the Slicing line and the bar are drawn at page-title size, the largest in the type scale. The reference animatic drew them at 36 to 48 px, which no type token covers.', '--text-secondary'),\n                 f'<div style=\"{BOX}flex:1 1 0\"></div>', text('metadata', CREDIT, '--text-tertiary')], 12, 'flex:1 1 0;min-width:0;align-self:stretch', name='Notes')\n    return (f'<div data-n=\"Clip storyboard\" data-theme=\"{THEME}\" class=\"body\" style=\"{BOX}width:{SCREEN_W}px;height:{SCREEN_H}px;display:flex;gap:var(--space-24);padding:var(--space-24);background:var(--surface-canvas);color:var(--text-primary);font-family:var(--font-sans);overflow:hidden\">'\n            + notes + grid + '</div>')\n\n# ---- boards -----------------------------------------------------------------------------------------------------------------------\nTOP = 5220\nBOARDS = [\n    ('first-run-welcome-01-clip-beat-1', 'First run · 01 · Welcome, the clip at beat 1', welcome(1), -1440, TOP),\n    ('first-run-welcome-02-clip-final-frame', 'First run · 02 · Welcome, the clip’s final frame', welcome(4), -80, TOP),\n    ('first-run-welcome-03-clip-storyboard', 'First run · 03 · The clip’s four beats', storyboard(), 1280, TOP),\n]\n\ndef wrap(title, inner):\n    return f'''<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<title>{escape(title)}</title>\n<script src=\"./support.js\"></script>\n<link rel=\"stylesheet\" href=\"ds/jusprin/tokens.css\">\n</head>\n<body>\n<x-dc>\n<helmet>\n<style>\nbody{{margin:0}}\n</style>\n</helmet>\n<div data-theme=\"{{{{theme}}}}\" class=\"body\" style=\"width:{SCREEN_W}px;height:{SCREEN_H}px;position:relative;overflow:hidden;background:var(--surface-canvas);color:var(--text-primary);font-family:var(--font-sans)\">{inner}</div>\n</x-dc>\n<script type=\"text/x-dc\" data-dc-script data-props='{{\"theme\":{{\"editor\":\"enum\",\"options\":[\"light\",\"dark\"],\"default\":\"light\"}},\"$preview\":{{\"width\":{SCREEN_W},\"height\":{SCREEN_H}}}}}'>\nclass Component extends DCLogic {{\n  renderVals() {{ return {{ theme: this.props.theme ?? 'light' }}; }}\n}}\n</script>\n</body>\n</html>\n'''\n\ncanvas_path = proj / 'canvas.json'\ncanvas = json.loads(canvas_path.read_text())\n# Variants A and B are withdrawn (Kenneth, 2026-11-02); their boards and notes go, and nothing else on the page moved for them.\nremoved = [k for k in canvas['boards'] if k.startswith(('first-run-a-', 'first-run-b-'))]\nfor k in removed:\n    del canvas['boards'][k]\n    canvas['order'].remove(k)\n    (proj / k).unlink(missing_ok=True)\nfor nid in ('first-run-title', 'first-run-replaces', 'first-run-b-title', 'first-run-b-about'):\n    canvas['notes'].pop(nid, None)\n    if nid in canvas['noteOrder']:\n        canvas['noteOrder'].remove(nid)\nnames = []\nfor stem, title, inner, x, y in BOARDS:\n    name = stem + '.dc.html'\n    (proj / name).write_text(wrap(title.replace('First run · ', ''), inner))\n    names.append(name)\n    canvas['boards'][name] = {'x': x, 'y': y, 'w': SCREEN_W, 'h': SCREEN_H, 'title': title, 'page': PAGE}\n    if name not in canvas['order']:\n        canvas['order'].append(name)\ncanvas['notes']['first-run-welcome-title'] = {'x': -1440, 'y': TOP - 100, 'text': 'First launch: one welcome screen', 'kind': 'title1', 'size': 40, 'maxW': 2400, 'page': PAGE}\ncanvas['notes']['first-run-welcome-about'] = {'x': -1920, 'y': TOP, 'w': 420, 'page': PAGE, 'fill': 'purple',\n    'text': 'Decided by Kenneth, 2026-11-02. No wizard: the first launch is one welcome screen, a looping silent clip on the left and the words and doors on the right. '\n            'It replaces the onboarding wizard (boards 00 to 11 and 17 to 18 on this page, and Welcome 1b to 1d), which stay here until he retires them.\\n\\n'\n            'The proposition is expert help with a failed print, now, from an AI that can see the file, the settings and the slice and fixes the settings. '\n            'One door is primary, the first-month offer; the two free doors show their cost; “Just slice for now” is a link.\\n\\n'\n            'After the doors nothing new is decided: each setup door opens Preferences › Agent (the one setup flow, 2026-10-23), and “Just slice for now” goes to Home, '\n            'with the printer from the 3MF, else an OrcaSlicer import, else a default the chip marks as assumed. Those screens are not drawn here.\\n\\n'\n            'The clip’s pictures and strings follow the reference animatic in design-captures/value-prop-2026-11; 03 says which parts are placeholders.'}\nfor nid in ('first-run-welcome-title', 'first-run-welcome-about'):\n    if nid not in canvas['noteOrder']:\n        canvas['noteOrder'].append(nid)\ncanvas_path.write_text(json.dumps(canvas, ensure_ascii=False, indent=1))\nprint('\\n'.join(names))\nif removed:\n    print('REMOVED ' + ' '.join(removed), file=sys.stderr)\n"}},"apiBlockIndex":1,"requestId":"req_011CgfJmX1UreUausaTnqZYD","requestRef":"5be78eed-73ab-4ac0-9263-0a95aa250e69","requestedModel":"claude-opus-5-5","type":"assistant","uuid":"f05544ff-e624-45fb-be35-9bfb64f761e1","timestamp":"2026-11-03T03:46:19.430Z","advisorModel":"claude-opus-5-5","effort":"high","perTurnEffort":"high","userType":"external","entrypoint":"claude-desktop","cwd":"/Users/kenneth/.claude/projects/-Users-kenneth-Projects-JusPrin/figma-mirror/work-first-run","sessionId":"473348c5-5f94-4e4d-9ad9-c7e9dd10b438","version":"2.1.309","gitBranch":"jusprin-newui","slug":"glimmering-doodling-lovelace"}
{"type":"file-history-delta","messageId":"f05544ff-e624-45fb-be35-9bfb64f761e1","snapshotMessageId":"3ac051f9-0d56-47a6-b123-71ecefaf4a49","trackingPath":"/Users/kenneth/.claude/projects/-Users-kenneth-Projects-JusPrin/figma-mirror/tools/composer/build_first_run_page.py","backup":{"backupFileName":"c2d3280c68ef13ec@v1","version":1,"backupTime":"2026-11-03T03:46:19.458Z","realParentDir":"/Users/kenneth/.claude/projects/-Users-kenneth-Projects-JusPrin/figma-mirror/tools/composer"},"timestamp":"2026-11-03T03:46:19.458Z"}
{"parentUuid":"f05544ff-e624-45fb-be35-9bfb64f761e1","isSidechain":false,"promptId":"3302b766-bcdc-47a6-990a-3c389fab5338","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01HJQXjXttKmGPqdwVHgEeQc","type":"tool_result","content":"The file /Users/kenneth/.claude/projects/-Users-kenneth-Projects-JusPrin/figma-mirror/tools/composer/build_first_run_page.py has been updated successfully. (file state is current in your context — no need to Read it back)"}]},"uuid":"805a2964-b9c9-40cc-b9cc-0137a4d2ab43","timestamp":"2026-11-03T03:46:19.497Z","toolUseResult":{"type":"update","filePath":"/Users/kenneth/.claude/projects/-Users-kenneth-Projects-JusPrin/figma-mirror/tools/composer/build_first_run_page.py","content":"\"\"\"Draws the first-launch welcome screen Kenneth decided on 2026-11-02 (memory: first-run-value-prop-decisions), as boards on the\ncanvas's \"On boarding experience\" page: the welcome with its clip at beat 1, the welcome with the clip's final frame, and a\nstoryboard of the clip's four beats. Every board is a whole 1280 x 800 screen. The layout and timing follow the reference animatic in\ndesign-captures/value-prop-2026-11/animatic/src (animatic.html, welcome-stringing.html, strings.js); colours, radii, type and\nspacing come from the token file. It replaces the no-wizard variants A and B (first-run-a-*, first-run-b-*), which this script\nremoves from the index. Usage: build_first_run_page.py <canvas project dir>; render with render_dc.py.\"\"\"\nimport json, re, sys\nfrom html import escape\nfrom pathlib import Path\n\nproj = Path(sys.argv[1])\n_src = (Path(__file__).parent / 'build_credits_page.py').read_text()\nexec(_src[:_src.index('# ---- Preferences')])\n\nPAGE = 'onboarding'\nICONS.update({\n    'circle-check': '<circle cx=\"12\" cy=\"12\" r=\"10\" /><path d=\"m9 12 2 2 4-4\" />',\n    'circle-dashed': '<path d=\"M10.1 2.182a10 10 0 0 1 3.8 0\" /><path d=\"M13.9 21.818a10 10 0 0 1-3.8 0\" /><path d=\"M17.609 3.721a10 10 0 0 1 2.69 2.7\" /><path d=\"M2.182 13.9a10 10 0 0 1 0-3.8\" /><path d=\"M20.279 17.609a10 10 0 0 1-2.7 2.69\" /><path d=\"M21.818 10.1a10 10 0 0 1 0 3.8\" /><path d=\"M3.721 6.391a10 10 0 0 1 2.7-2.69\" /><path d=\"M6.391 20.279a10 10 0 0 1-2.69-2.7\" />',\n    'chevron-right': '<path d=\"m9 18 6-6-6-6\" />',\n})\n\n# The clip's pictures. The photos are the CC BY 2.0 #3DBenchy photos as edited in photo/ATTRIBUTION.md, scaled to 1200 wide; the boats\n# on the plate are the animatic's renders of the bundled 3DBenchy (render_benchy.py), standing in for the app's own view.\nPHOTO_FAILED, PHOTO_CLEAN = '/_blob/ffb4fd1e55daad0c7d05a62e9be4419e', '/_blob/d1d0da8df4a3b47e13751b9a5eb187c6'\nBOAT_MODEL, BOAT_SLICED = '/_blob/686e61119d60dca9576b0cca762d2c0b', '/_blob/edf2c391e9915065d6f51d6b8af7585c'\n\n# Every string the screen and the clip show, as Kenneth chose them (strings.js for the clip).\nTITLE = 'The AI slicer that fixes failed prints.'\nSUBTITLE = 'Show it a photo of what went wrong. The agent reads your file, your settings and your slice, changes the settings and slices again.'\nDOORS_LABEL = 'Pick how the agent should think. Change it any time in Preferences › Agent.'\nOFFER_HEAD, OFFER_DETAIL = 'Your first month: 500 credits', 'An Expert message is 5 credits. Then paid, or your own key.'\nFOOTER = 'Slicing works without an account. The agent needs one, or your own API key.'\nCAPTIONS = ['Show it what happened.', 'It reads your photo, your file and your slice.', 'It changes the settings for you.', 'And slices again. Tonight.']\nASKED = 'I printed it and it failed. What went wrong? Photo attached.'\n# Placeholder: the opening of a real reply from a different print (journey j3-opus-photo, the vase), until a live run on this photo.\nREPLY = ('I’m sorry the print failed. Your photo shows the base rings went down, but once one side came loose the nozzle kept printing '\n         'into thin air, which made the tangle of loose strands. I looked at the slice and the settings are normal for PLA on a textured PEI plate.')\nSETTINGS = [('Retraction 0.8 → ', '2 mm'), ('Nozzle 220 → ', '200 °C')]   # placeholders, textbook fixes for stringing\nSLICING = 'Slicing '   # the app's \"Slicing %d%%\", LeftPane.cpp\nDONE = 'Sliced · ready · 1 h 34 min · 34 g'\nCREDIT = ('Photos: “Dual extrusion 3D printed #3DBenchy v01” (flickr.com/photos/3dbenchy/19273965123) and “Dual-print multi-part color 3D print '\n          'of #3DBenchy v13” (flickr.com/photos/3dbenchy/19239738473) by #3DBenchy, CC BY 2.0. Cropped and resized.')\n\n# ---- the clip: one frame of the animatic, 620 x 388, positioned as animatic.html positions it ----------------------------------------\nCLIP_W, CLIP_H = 620, 388\nABS = BOX + 'position:absolute;'\nPHOTO_BIG, PHOTO_CORNER = (236, 14, 368, 230), (16, 16, 184, 115)\n\ndef photo(src, rect):\n    x, y, w, h = rect\n    return f'<img src=\"{src}\" alt=\"\" style=\"{ABS}left:{x}px;top:{y}px;width:{w}px;height:{h}px;object-fit:cover;object-position:50% 45%;border-radius:var(--radius-medium)\">'\n\ndef plate(boat, shift=0):\n    \"\"\"The bed and a boat on it. Beat 1 shows the left 220 px of it (shifted 400 px left); beat 4 shows it whole.\"\"\"\n    bed = (f'<div style=\"{ABS}left:{340 - shift}px;top:24px;width:264px;height:348px;border-radius:var(--radius-small);background-color:var(--surface-raised);box-shadow:inset 0 0 0 1px var(--border-subtle);'\n           'background-image:linear-gradient(var(--border-subtle) 1px,transparent 1px),linear-gradient(90deg,var(--border-subtle) 1px,transparent 1px);background-size:var(--space-48) var(--space-48)\"></div>')\n    return (f'<div data-n=\"Plate\" style=\"{ABS}left:0;top:0;width:{CLIP_W}px;height:{CLIP_H}px;background:var(--surface-subtle)\">' + bed\n            + f'<img src=\"{boat}\" alt=\"\" style=\"{ABS}left:{420 - shift}px;top:110px;width:180px\"></div>')\n\ndef caption(i):\n    return (f'<div data-n=\"Caption\" class=\"body-bold\" style=\"{ABS}left:var(--space-16);bottom:var(--space-16);padding:var(--space-8) var(--space-12);background:var(--surface-failure-inverse);'\n            f'color:var(--text-on-failure-primary);border-radius:var(--radius-small);white-space:nowrap\">{escape(CAPTIONS[i])}</div>')\n\ndef reply_burst():\n    \"\"\"Beats 2 and 3: three lines of the reply as texture. It says \"working\" and is not meant to be read.\"\"\"\n    return f'<div data-n=\"Reply, placeholder\" class=\"metadata\" style=\"{ABS}left:var(--space-16);right:var(--space-16);top:140px;height:42px;overflow:hidden;color:var(--text-tertiary)\">{escape(REPLY)}</div>'\n\ndef big_settings():\n    lines = ''.join(f'<div class=\"page-title\" style=\"{BOX}white-space:nowrap;color:var(--text-secondary);font-weight:400\">{escape(a)}<b style=\"font-weight:700;color:var(--action-primary)\">{escape(b)}</b></div>' for a, b in SETTINGS)\n    return f'<div data-n=\"Settings changed\" style=\"{ABS}left:216px;top:var(--space-16);width:388px;display:flex;flex-direction:column;gap:var(--space-8)\">{lines}</div>'\n\ndef slicing(pct):\n    head = f'<div class=\"page-title\" style=\"{ABS}left:var(--space-16);top:148px;white-space:nowrap;color:var(--text-primary)\">{SLICING}<span style=\"color:var(--action-primary)\">{pct}</span>%</div>'\n    bar = (f'<div data-n=\"Slicing bar\" style=\"{ABS}left:var(--space-16);top:196px;width:300px;height:var(--component-progress-height);border-radius:var(--radius-full);background:var(--border-subtle);overflow:hidden\">'\n           f'<div style=\"{BOX}width:{pct}%;height:100%;background:var(--action-primary)\"></div></div>')\n    return head + bar\n\ndef sliced_line():\n    return (f'<div style=\"{ABS}left:var(--space-16);top:148px\">{icon(\"circle-check\", \"--status-success\", 40)}</div>'\n            f'<div class=\"section\" style=\"{ABS}left:var(--space-16);top:204px;white-space:nowrap;color:var(--status-success)\">{escape(DONE)}</div>')\n\ndef clip(beat):\n    \"\"\"beat: 1, 2, 3, '4a' (the bar counting, at 68%) or 4 (the final frame, held longest).\"\"\"\n    if beat == 1:\n        kids = [plate(BOAT_MODEL, 400), photo(PHOTO_FAILED, PHOTO_BIG),\n                f'<div data-n=\"Their message\" class=\"body\" style=\"{ABS}right:var(--space-16);top:252px;width:276px;padding:var(--space-8) var(--space-12);border-radius:var(--radius-medium);background:var(--surface-subtle)\">{escape(ASKED)}</div>',\n                caption(0)]\n    elif beat in (2, 3):\n        kids = [photo(PHOTO_FAILED, PHOTO_CORNER), reply_burst()] + ([big_settings()] if beat == 3 else []) + [caption(beat - 1)]\n    elif beat == '4a':\n        kids = [plate(BOAT_MODEL), photo(PHOTO_FAILED, PHOTO_CORNER), slicing(68), caption(3)]\n    else:\n        kids = [plate(BOAT_SLICED), photo(PHOTO_CLEAN, PHOTO_CORNER), sliced_line(), caption(3)]\n    return f'<div data-n=\"Clip, beat {beat}\" style=\"{BOX}position:relative;width:{CLIP_W}px;height:{CLIP_H}px;overflow:hidden;background:var(--surface-canvas)\">' + ''.join(kids) + '</div>'\n\n# ---- the welcome screen -----------------------------------------------------------------------------------------------------------\ndef header():\n    left = row([text('section', 'JusPrin', '--action-primary', 'flex:none', True), icon('chevron-right', '--text-secondary', 14), text('body', 'Agent', '--text-secondary', 'flex:none', True)], 12, 'flex:none')\n    right = row([icon('circle-dashed', '--text-secondary', 12), text('label', 'Agent not connected', '--text-secondary', 'flex:none', True)], 8, 'flex:none')\n    return f'<div data-n=\"top-bar\" style=\"{BOX}align-self:stretch;height:56px;display:flex;padding:0 var(--space-24);justify-content:space-between;align-items:center;box-shadow:inset 0 -1px 0 0 var(--border-subtle)\">{left}{right}</div>'\n\ndef free_door(name, cost):\n    return (f'<div data-n=\"Door: {escape(name)}\" style=\"{BOX}align-self:stretch;display:flex;gap:var(--space-16);justify-content:space-between;align-items:center;padding:var(--space-12) var(--space-16);'\n            'background:var(--surface-subtle);border-radius:var(--radius-medium);box-shadow:inset 0 0 0 1px var(--border-subtle)\">'\n            + text('body-bold', name, extra='flex:1 1 0;min-width:0') + text('label', cost, '--text-secondary', 'flex:none', True) + '</div>')\n\ndef doors():\n    offer = (f'<div data-n=\"Door: first-month offer\" style=\"{BOX}align-self:stretch;display:flex;flex-direction:column;gap:var(--space-4);align-items:flex-start;padding:var(--space-16);'\n             'background:var(--surface-selected);border-radius:var(--radius-medium);box-shadow:inset 0 0 0 1px var(--border-subtle)\">'\n             + text('section', OFFER_HEAD) + text('body-small', OFFER_DETAIL, '--text-secondary')\n             + f'<div style=\"{BOX}margin-top:var(--space-8)\">{primary(OFFER_BUTTON)}</div></div>')\n    just = f'<div style=\"{BOX}padding:var(--space-4) 0\">' + text('label-bold', 'Just slice for now', '--action-primary', 'flex:none', True) + '</div>'\n    return col([text('label', DOORS_LABEL, '--text-secondary'), offer, free_door('Your own API key', 'Free'), free_door('Claude Code or Claude Desktop', 'Free · MCP server'), just], 8, name='Doors')\n\ndef welcome(beat):\n    framed = f'<div data-n=\"Clip\" style=\"{BOX}position:relative;width:{CLIP_W}px;height:{CLIP_H}px;border-radius:var(--radius-medium);overflow:hidden;box-shadow:var(--elevation-medium)\">{clip(beat)}</div>'\n    words = col([col([text('page-title', TITLE), text('body', SUBTITLE, '--text-secondary')], 8), doors()], 20, 'flex:1 1 0;min-width:0', name='Words and doors')\n    body = (f'<div data-n=\"Welcome\" style=\"{BOX}flex:1 1 0;min-height:0;align-self:stretch;display:flex;justify-content:center;align-items:center;padding-bottom:var(--space-32)\">'\n            f'<div style=\"{BOX}width:1120px;display:flex;gap:var(--space-48);align-items:center\">{framed}{words}</div></div>')\n    foot = f'<div data-n=\"Footer\" style=\"{BOX}align-self:stretch;height:32px;display:flex;padding:0 var(--space-24);align-items:center;box-shadow:inset 0 1px 0 0 var(--border-subtle)\">' + text('label', FOOTER, '--text-secondary', 'flex:none', True) + '</div>'\n    return (f'<div data-n=\"Welcome screen\" data-theme=\"{THEME}\" class=\"body\" style=\"{BOX}position:relative;width:{SCREEN_W}px;height:{SCREEN_H}px;display:flex;flex-direction:column;background:var(--surface-canvas);color:var(--text-primary);font-family:var(--font-sans);overflow:hidden\">'\n            + header() + body + foot + '</div>')\n\n# ---- the storyboard ---------------------------------------------------------------------------------------------------------------\nBEATS = [(1, 'Beat 1 · 0 to 2.6 s'), (2, 'Beat 2 · 2.6 to 5 s'), (3, 'Beat 3 · 5 to 7.2 s'), ('4a', 'Beat 4 · 7.2 to 12.2 s, here at 68 %; the final frame is on 02')]\nSCALE = 0.75   # the frames at three quarters of their size, so four fit beside the notes\n\ndef storyboard():\n    cells = ''.join(col([text('label-bold', label, '--text-secondary'),\n                         f'<div style=\"{BOX}width:{CLIP_W * SCALE:.0f}px;height:{CLIP_H * SCALE:.0f}px;border-radius:var(--radius-medium);overflow:hidden;box-shadow:inset 0 0 0 1px var(--border-subtle)\">'\n                         f'<div style=\"{BOX}transform:scale({SCALE});transform-origin:0 0\">{clip(beat)}</div></div>'], 4, 'flex:none')\n                    for beat, label in BEATS)\n    grid = f'<div data-n=\"Beats\" style=\"{BOX}display:grid;grid-template-columns:repeat(2,auto);gap:var(--space-16) var(--space-16)\">{cells}</div>'\n    notes = col([text('section', 'The first-launch clip'),\n                 text('body-small', 'About 12 seconds, silent and looping. Motion only at the beat changes, short holds, and the last frame held longest.', '--text-secondary'),\n                 text('label', 'The agent’s words in beat 2 are placeholders: the opening of a real reply about a different print, until a live run on this photo is recorded. The two settings in beat 3 are placeholders too.', '--text-secondary'),\n                 text('label', 'The boats on the plate are renders of the bundled 3DBenchy, standing in for the app’s own view. The clip that ships is a recording of the real app.', '--text-secondary'),\n                 text('label', 'The settings, the Slicing line and the bar are drawn at page-title size, the largest in the type scale. The reference animatic drew them at 36 to 48 px, which no type token covers.', '--text-secondary'),\n                 f'<div style=\"{BOX}flex:1 1 0\"></div>', text('metadata', CREDIT, '--text-tertiary')], 12, 'flex:1 1 0;min-width:0;align-self:stretch', name='Notes')\n    return (f'<div data-n=\"Clip storyboard\" data-theme=\"{THEME}\" class=\"body\" style=\"{BOX}width:{SCREEN_W}px;height:{SCREEN_H}px;display:flex;gap:var(--space-24);padding:var(--space-24);background:var(--surface-canvas);color:var(--text-primary);font-family:var(--font-sans);overflow:hidden\">'\n            + notes + grid + '</div>')\n\n# ---- boards -----------------------------------------------------------------------------------------------------------------------\nTOP = 5220\nBOARDS = [\n    ('first-run-welcome-01-clip-beat-1', 'First run · 01 · Welcome, the clip at beat 1', welcome(1), -1440, TOP),\n    ('first-run-welcome-02-clip-final-frame', 'First run · 02 · Welcome, the clip’s final frame', welcome(4), -80, TOP),\n    ('first-run-welcome-03-clip-storyboard', 'First run · 03 · The clip’s four beats', storyboard(), 1280, TOP),\n]\n\ndef wrap(title, inner):\n    return f'''<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<title>{escape(title)}</title>\n<script src=\"./support.js\"></script>\n<link rel=\"stylesheet\" href=\"ds/jusprin/tokens.css\">\n</head>\n<body>\n<x-dc>\n<helmet>\n<style>\nbody{{margin:0}}\n</style>\n</helmet>\n<div data-theme=\"{{{{theme}}}}\" class=\"body\" style=\"width:{SCREEN_W}px;height:{SCREEN_H}px;position:relative;overflow:hidden;background:var(--surface-canvas);color:var(--text-primary);font-family:var(--font-sans)\">{inner}</div>\n</x-dc>\n<script type=\"text/x-dc\" data-dc-script data-props='{{\"theme\":{{\"editor\":\"enum\",\"options\":[\"light\",\"dark\"],\"default\":\"light\"}},\"$preview\":{{\"width\":{SCREEN_W},\"height\":{SCREEN_H}}}}}'>\nclass Component extends DCLogic {{\n  renderVals() {{ return {{ theme: this.props.theme ?? 'light' }}; }}\n}}\n</script>\n</body>\n</html>\n'''\n\ncanvas_path = proj / 'canvas.json'\ncanvas = json.loads(canvas_path.read_text())\n# Variants A and B are withdrawn (Kenneth, 2026-11-02); their boards and notes go, and nothing else on the page moved for them.\nremoved = [k for k in canvas['boards'] if k.startswith(('first-run-a-', 'first-run-b-'))]\nfor k in removed:\n    del canvas['boards'][k]\n    canvas['order'].remove(k)\n    (proj / k).unlink(missing_ok=True)\nfor nid in ('first-run-title', 'first-run-replaces', 'first-run-b-title', 'first-run-b-about'):\n    canvas['notes'].pop(nid, None)\n    if nid in canvas['noteOrder']:\n        canvas['noteOrder'].remove(nid)\nnames = []\nfor stem, title, inner, x, y in BOARDS:\n    name = stem + '.dc.html'\n    (proj / name).write_text(wrap(title.replace('First run · ', ''), inner))\n    names.append(name)\n    canvas['boards'][name] = {'x': x, 'y': y, 'w': SCREEN_W, 'h': SCREEN_H, 'title': title, 'page': PAGE}\n    if name not in canvas['order']:\n        canvas['order'].append(name)\ncanvas['notes']['first-run-welcome-title'] = {'x': -1440, 'y': TOP - 100, 'text': 'First launch: one welcome screen', 'kind': 'title1', 'size': 40, 'maxW': 2400, 'page': PAGE}\ncanvas['notes']['first-run-welcome-about'] = {'x': -1920, 'y': TOP, 'w': 420, 'page': PAGE, 'fill': 'purple',\n    'text': 'Decided by Kenneth, 2026-11-02. No wizard: the first launch is one welcome screen, a looping silent clip on the left and the words and doors on the right. '\n            'It replaces the onboarding wizard (boards 00 to 11 and 17 to 18 on this page, and Welcome 1b to 1d), which stay here until he retires them.\\n\\n'\n            'The proposition is expert help with a failed print, now, from an AI that can see the file, the settings and the slice and fixes the settings. '\n            'One door is primary, the first-month offer; the two free doors show their cost; “Just slice for now” is a link.\\n\\n'\n            'After the doors nothing new is decided: each setup door opens Preferences › Agent (the one setup flow, 2026-10-23), and “Just slice for now” goes to Home, '\n            'with the printer from the 3MF, else an OrcaSlicer import, else a default the chip marks as assumed. Those screens are not drawn here.\\n\\n'\n            'The clip’s pictures and strings follow the reference animatic in design-captures/value-prop-2026-11; 03 says which parts are placeholders.'}\nfor nid in ('first-run-welcome-title', 'first-run-welcome-about'):\n    if nid not in canvas['noteOrder']:\n        canvas['noteOrder'].append(nid)\ncanvas_path.write_text(json.dumps(canvas, ensure_ascii=False, indent=1))\nprint('\\n'.join(names))\nif removed:\n    print('REMOVED ' + ' '.join(removed), file=sys.stderr)\n","structuredPatch":[{"oldStart":1,"oldLines":10,"newStart":1,"newLines":9,"lines":["-\"\"\"Draws the two first-run flows Kenneth is comparing (2026-11-02): variant A, no welcome screen and a sign-in gate at Send, and","-variant B, one welcome screen with three doors; the boards first-run-a-*.dc.html and first-run-b-*.dc.html on the canvas's","-\"On boarding experience\" page. Every board is a whole 1280 x 800 screen. Home follows main-08-home-first-run; Prepare is composed","-as build_credits_page.py composes it (its primitives are reused by running the file's part above Preferences), with plates captured","-from the real app on general_purpose_hook.STL and the bundled 3DBenchy. The offer's words are the credits boards'. The Preferences","-window is lifted from the live credits-01a. Both variants open on one headline and a proof frame (Kenneth, 2026-11-02). The headline is a stand-in","-until his final wording, and the frame is a wordless placeholder. Usage: build_first_run_page.py <canvas project dir>; render with render_dc.py.\"\"\"","+\"\"\"Draws the first-launch welcome screen Kenneth decided on 2026-11-02 (memory: first-run-value-prop-decisions), as boards on the","+canvas's \"On boarding experience\" page: the welcome with its clip at beat 1, the welcome with the clip's final frame, and a","+storyboard of the clip's four beats. Every board is a whole 1280 x 800 screen. The layout and timing follow the reference animatic in","+design-captures/value-prop-2026-11/animatic/src (animatic.html, welcome-stringing.html, strings.js); colours, radii, type and","+spacing come from the token file. It replaces the no-wizard variants A and B (first-run-a-*, first-run-b-*), which this script","+removes from the index. Usage: build_first_run_page.py <canvas project dir>; render with render_dc.py.\"\"\""," import json, re, sys"," from html import escape"," from pathlib import Path"]},{"oldStart":14,"oldLines":387,"newStart":13,"newLines":139,"lines":[" exec(_src[:_src.index('# ---- Preferences')])"," "," PAGE = 'onboarding'","-VP_BENCHY = '/_blob/f244941cd62e927e49118bfc96430432'","-VP_EMPTY = '/_blob/fe6778296af1a35c853afff98f816ef3'","-VP_A1, VP_A1_SIDE = '/_blob/e2909e5c3ace6b59be8c5216c51a1c30', '/_blob/5dc4273d09f776fc4f13764c143d501f'"," ICONS.update({","-    'upload': '<path d=\"M12 3v12\" /><path d=\"m17 8-5-5-5 5\" /><path d=\"M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4\" />',","-    'settings': '<path d=\"M9.671 4.136a2.34 2.34 0 0 1 4.659 0 2.34 2.34 0 0 0 3.319 1.915 2.34 2.34 0 0 1 2.33 4.033 2.34 2.34 0 0 0 0 3.831 2.34 2.34 0 0 1-2.33 4.033 2.34 2.34 0 0 0-3.319 1.915 2.34 2.34 0 0 1-4.659 0 2.34 2.34 0 0 0-3.32-1.915 2.34 2.34 0 0 1-2.33-4.033 2.34 2.34 0 0 0 0-3.831A2.34 2.34 0 0 1 6.35 6.051a2.34 2.34 0 0 0 3.319-1.915\" /><circle cx=\"12\" cy=\"12\" r=\"3\" />',","-    'rotate-cw': '<path d=\"M21 12a9 9 0 1 1-9-9c2.52 0 4.93 1 6.74 2.74L21 8\" /> <path d=\"M21 3v5h-5\" />',","-    'send': '<path d=\"M14.536 21.686a.5.5 0 0 0 .937-.024l6.5-19a.496.496 0 0 0-.635-.635l-19 6.5a.5.5 0 0 0-.024.937l7.93 3.18a2 2 0 0 1 1.112 1.11z\" /><path d=\"m21.854 2.147-10.94 10.939\" />',","-    'play': '<polygon points=\"6 3 20 12 6 21 6 3\" />',","-    'circle-alert': '<circle cx=\"12\" cy=\"12\" r=\"10\" /><line x1=\"12\" x2=\"12\" y1=\"8\" y2=\"12\" /><line x1=\"12\" x2=\"12.01\" y1=\"16\" y2=\"16\" />',","+    'circle-check': '<circle cx=\"12\" cy=\"12\" r=\"10\" /><path d=\"m9 12 2 2 4-4\" />',","+    'circle-dashed': '<path d=\"M10.1 2.182a10 10 0 0 1 3.8 0\" /><path d=\"M13.9 21.818a10 10 0 0 1-3.8 0\" /><path d=\"M17.609 3.721a10 10 0 0 1 2.69 2.7\" /><path d=\"M2.182 13.9a10 10 0 0 1 0-3.8\" /><path d=\"M20.279 17.609a10 10 0 0 1-2.7 2.69\" /><path d=\"M21.818 10.1a10 10 0 0 1 0 3.8\" /><path d=\"M3.721 6.391a10 10 0 0 1 2.7-2.69\" /><path d=\"M6.391 20.279a10 10 0 0 1-2.69-2.7\" />',","+    'chevron-right': '<path d=\"m9 18 6-6-6-6\" />',"," })"," ","-# Kenneth, 2026-11-02: the first screen states the value proposition, expert help with a printing problem from an agent that can see the","-# file, settings and slice and fixes the settings; the three doors are only the means to it. This line stands in until his final wording.","-PROMISE = 'Your print failed. Ask someone who can see why.'","-OFFER_GATE = 'Sign in for 500 credits to send this'","-KEY_LINK = 'Paste an API key'","-FILE = 'general_purpose_hook.STL'","-HOOK_TOLD = ('This looks like a wall hook, about 45 mm long with one countersunk screw hole, and it fits your A1 mini. Printed the way it '","-             'sits, the arm could split along its layers under a heavy load, so how I’d set it up depends on the job. What will it hang?')","-# Kenneth, 2026-11-02: the printer comes from the 3MF, else an OrcaSlicer import, else a default the chip marks and the agent's first words name.","-ASSUMED = 'I’ve assumed a Bambu A1 mini; tell me if it’s something else.'","-HOOK_ASSUMED = (ASSUMED + ' This looks like a wall hook, about 45 mm long with one countersunk screw hole, and it fits that printer. Printed the way it sits, '","-                'the arm could split along its layers under a heavy load, so how I’d set it up depends on the job. What will it hang?')","-BENCHY_ASSUMED = (ASSUMED + ' This is 3DBenchy, the little boat people print to test a printer. It’s here so you can see how this works without a file of your own. '","-                  'What would you like to find out from it?')","+# The clip's pictures. The photos are the CC BY 2.0 #3DBenchy photos as edited in photo/ATTRIBUTION.md, scaled to 1200 wide; the boats","+# on the plate are the animatic's renders of the bundled 3DBenchy (render_benchy.py), standing in for the app's own view.","+PHOTO_FAILED, PHOTO_CLEAN = '/_blob/ffb4fd1e55daad0c7d05a62e9be4419e', '/_blob/d1d0da8df4a3b47e13751b9a5eb187c6'","+BOAT_MODEL, BOAT_SLICED = '/_blob/686e61119d60dca9576b0cca762d2c0b', '/_blob/edf2c391e9915065d6f51d6b8af7585c'"," ","-# The real helper and discovery paths on a Mac, in the exact shape of Mcp/McpConnections.hpp; the app fills in the person's own home folder.","-HELPER, DISCOVERY = '/Applications/JusPrin.app/Contents/MacOS/jusprin-mcp', '/Users/you/Library/Application Support/JusPrin2/jusprin/mcp.json'","-CLAUDE_CODE_CMD = f\"claude mcp add --scope user --transport stdio jusprin -- '{HELPER}' '--discovery' '{DISCOVERY}'\"","-CLAUDE_DESKTOP_JSON = json.dumps({'mcpServers': {'jusprin': {'args': ['--discovery', DISCOVERY], 'command': HELPER}}}, indent=2)","+# Every string the screen and the clip show, as Kenneth chose them (strings.js for the clip).","+TITLE = 'The AI slicer that fixes failed prints.'","+SUBTITLE = 'Show it a photo of what went wrong. The agent reads your file, your settings and your slice, changes the settings and slices again.'","+DOORS_LABEL = 'Pick how the agent should think. Change it any time in Preferences › Agent.'","+OFFER_HEAD, OFFER_DETAIL = 'Your first month: 500 credits', 'An Expert message is 5 credits. Then paid, or your own key.'","+FOOTER = 'Slicing works without an account. The agent needs one, or your own API key.'","+CAPTIONS = ['Show it what happened.', 'It reads your photo, your file and your slice.', 'It changes the settings for you.', 'And slices again. Tonight.']","+ASKED = 'I printed it and it failed. What went wrong? Photo attached.'","+# Placeholder: the opening of a real reply from a different print (journey j3-opus-photo, the vase), until a live run on this photo.","+REPLY = ('I’m sorry the print failed. Your photo shows the base rings went down, but once one side came loose the nozzle kept printing '","+         'into thin air, which made the tangle of loose strands. I looked at the slice and the settings are normal for PLA on a textured PEI plate.')","+SETTINGS = [('Retraction 0.8 → ', '2 mm'), ('Nozzle 220 → ', '200 °C')]   # placeholders, textbook fixes for stringing","+SLICING = 'Slicing '   # the app's \"Slicing %d%%\", LeftPane.cpp","+DONE = 'Sliced · ready · 1 h 34 min · 34 g'","+CREDIT = ('Photos: “Dual extrusion 3D printed #3DBenchy v01” (flickr.com/photos/3dbenchy/19273965123) and “Dual-print multi-part color 3D print '","+          'of #3DBenchy v13” (flickr.com/photos/3dbenchy/19239738473) by #3DBenchy, CC BY 2.0. Cropped and resized.')"," ","-# ---- Prepare ---------------------------------------------------------------------------------------------------------","-def chip_for(printer, mark=None):","-    \"\"\"mark: the words of a qualified selection, drawn as the file-printer boards draw \"from the file\": the warning glyph where the printer glyph was.\"\"\"","-    words = [text('label-bold', printer, extra='flex:none', nowrap=True), text('label-bold', '·', '--text-secondary', 'flex:none', True), text('label', '0.4', extra='flex:none', nowrap=True)]","-    if mark:","-        words += [text('label-bold', '·', '--text-secondary', 'flex:none', True), text('label', mark, extra='flex:none', nowrap=True)]","-    left = (f'<div data-c=\"Header Chip/Printer:State=rest\" style=\"{BOX}height:26px;display:flex;gap:5px;padding:0 var(--space-8) 0 10px;align-items:center;background:var(--surface-canvas);border-radius:calc(var(--radius-chip) - 1px) 0 0 calc(var(--radius-chip) - 1px)\">'","-            + (icon('triangle-alert', '--status-warning', 14) if mark else printer_glyph()) + ''.join(words) + caret() + '</div>')","-    filament = 'Bambu PLA Basic'","-    slots = f'<div style=\"{BOX}display:flex;gap:3px;padding:0 2px;align-items:center\">' + swatch_dot('#1E8A7A', True) + '</div>'","-    right = (f'<div data-c=\"Header Chip/Filament:State=rest\" style=\"{BOX}height:26px;display:flex;gap:5px;padding:0 var(--space-8);align-items:center;background:var(--surface-subtle);border-radius:0 calc(var(--radius-chip) - 1px) calc(var(--radius-chip) - 1px) 0;box-shadow:inset 1px 0 0 0 var(--border-subtle)\">'","-             + slots + text('label-bold', filament, extra='flex:none', nowrap=True) + caret() + '</div>')","-    return f'<div data-n=\"Printer and filament chip\" style=\"{BOX}display:inline-flex;padding:1px;border-radius:var(--radius-chip);box-shadow:inset 0 0 0 1px var(--border-subtle);overflow:hidden\">{left}{right}</div>'","+# ---- the clip: one frame of the animatic, 620 x 388, positioned as animatic.html positions it ----------------------------------------","+CLIP_W, CLIP_H = 620, 388","+ABS = BOX + 'position:absolute;'","+PHOTO_BIG, PHOTO_CORNER = (236, 14, 368, 230), (16, 16, 184, 115)"," ","-def split_button(label, glyph, on=True):","-    bg, fg = ('--action-primary', '--action-on-primary') if on else ('--action-disabled', '--action-disabled-text')","-    return (f'<div data-c=\"Button/Split:State={\"Default\" if on else \"Disabled\"}\" style=\"{BOX}display:flex;align-items:center;height:34px;background:var({bg});border-radius:var(--radius-medium)\">'","-            f'<div style=\"{BOX}display:flex;gap:6px;padding:var(--space-8) var(--space-12) var(--space-8) 14px;align-items:center\">{icon(glyph, fg, 12)}' + text('body-small-bold', label, fg, 'flex:none', True) + '</div>'","-            f'<div style=\"{BOX}width:1px;height:18px;background:var({fg});opacity:0.3\"></div>'","-            f'<div style=\"{BOX}display:flex;padding:var(--space-8) 10px var(--space-8) var(--space-8);align-items:center\">{icon(\"chevron-down\", fg, 10)}</div></div>')","+def photo(src, rect):","+    x, y, w, h = rect","+    return f'<img src=\"{src}\" alt=\"\" style=\"{ABS}left:{x}px;top:{y}px;width:{w}px;height:{h}px;object-fit:cover;object-position:50% 45%;border-radius:var(--radius-medium)\">'"," ","-def bar(printer, action='slice', mark=None):","-    toggle = (f'<div data-c=\"Button/Icon:State=Default\" data-n=\"Plates and Project pane\" style=\"{BOX}width:32px;height:32px;display:flex;justify-content:center;align-items:center;border-radius:var(--radius-small);box-shadow:inset 0 0 0 1px var(--border-subtle)\">{icon(\"panel-left\", \"--text-primary\", 16)}</div>')","-    home = (f'<div data-n=\"Home\" style=\"{BOX}display:flex;gap:6px;align-items:center;padding:6px var(--space-8);border-radius:var(--radius-small)\">' + icon('chevron-left', '--text-secondary', 14) + text('body', 'Home', '--text-secondary', 'flex:none', True) + '</div>')","-    act = split_button('Print', 'send') if action == 'print' else split_button('Slice', 'play-circle')","-    more = (f'<div data-c=\"Button/Icon:State=Default\" data-n=\"Project actions\" style=\"{BOX}width:32px;height:32px;display:flex;justify-content:center;align-items:center;border-radius:var(--radius-small);box-shadow:inset 0 0 0 1px var(--border-subtle)\">{icon(\"ellipsis\", \"--text-primary\", 16)}</div>')","-    return (f'<div data-n=\"top-bar\" style=\"{BOX}align-self:stretch;height:{BAR_H}px;display:grid;grid-template-columns:1fr auto 1fr;align-items:center;padding:0 var(--space-16);background:var(--surface-canvas);box-shadow:inset 0 -1px 0 0 var(--border-subtle)\">'","-            + row([toggle, home], 8, 'justify-self:start', name='top-bar-left')","-            + f'<div data-n=\"top-bar-center\" style=\"{BOX}display:flex;justify-content:center;align-items:center\">{chip_for(printer, mark)}</div>'","-            + row([act, more], 8, 'justify-self:end', name='top-bar-right') + '</div>')","+def plate(boat, shift=0):","+    \"\"\"The bed and a boat on it. Beat 1 shows the left 220 px of it (shifted 400 px left); beat 4 shows it whole.\"\"\"","+    bed = (f'<div style=\"{ABS}left:{340 - shift}px;top:24px;width:264px;height:348px;border-radius:var(--radius-small);background-color:var(--surface-raised);box-shadow:inset 0 0 0 1px var(--border-subtle);'","+           'background-image:linear-gradient(var(--border-subtle) 1px,transparent 1px),linear-gradient(90deg,var(--border-subtle) 1px,transparent 1px);background-size:var(--space-48) var(--space-48)\"></div>')","+    return (f'<div data-n=\"Plate\" style=\"{ABS}left:0;top:0;width:{CLIP_W}px;height:{CLIP_H}px;background:var(--surface-subtle)\">' + bed","+            + f'<img src=\"{boat}\" alt=\"\" style=\"{ABS}left:{420 - shift}px;top:110px;width:180px\"></div>')"," ","-def plate(src, alt):","-    w = SCREEN_W - PANE_W","-    return (f'<div data-n=\"OrcaSlicer canvas\" style=\"{BOX}width:{w}px;height:{SCREEN_H - BAR_H}px;position:relative;overflow:hidden;background:var(--surface-subtle)\">'","-            f'<img src=\"{src}\" alt=\"{escape(alt)}\" style=\"{BOX}position:absolute;left:0;top:0;width:{w}px;height:{SCREEN_H - BAR_H}px;object-fit:cover;object-position:center\"></div>')","+def caption(i):","+    return (f'<div data-n=\"Caption\" class=\"body-bold\" style=\"{ABS}left:var(--space-16);bottom:var(--space-16);padding:var(--space-8) var(--space-12);background:var(--surface-failure-inverse);'","+            f'color:var(--text-on-failure-primary);border-radius:var(--radius-small);white-space:nowrap\">{escape(CAPTIONS[i])}</div>')"," ","-def setup_card(presets, **sliced):","-    if sliced:","-        card = ' '.join(f'{k}=\"{escape(v)}\"' for k, v in {'presets': presets, **sliced}.items())","-        return f'<dc-import name=\"comp-pinned-setup-card\" variant=\"current\" theme=\"{THEME}\" {card} style=\"width:100%\" hint-size=\"100%,120px\"></dc-import>'","-    return f'<dc-import name=\"comp-pinned-setup-card\" variant=\"stressNeverSliced\" theme=\"{THEME}\" purpose=\"\" plan=\"\" presets=\"{escape(presets)}\" style=\"width:100%\" hint-size=\"100%,100px\"></dc-import>'","+def reply_burst():","+    \"\"\"Beats 2 and 3: three lines of the reply as texture. It says \"working\" and is not meant to be read.\"\"\"","+    return f'<div data-n=\"Reply, placeholder\" class=\"metadata\" style=\"{ABS}left:var(--space-16);right:var(--space-16);top:140px;height:42px;overflow:hidden;color:var(--text-tertiary)\">{escape(REPLY)}</div>'"," ","-def pane(heading, card, timeline, band, scrolled_to_end=False):","-    return (f'<div data-n=\"Agent pane\" style=\"{BOX}width:{PANE_W}px;height:{SCREEN_H - BAR_H}px;display:flex;flex-direction:column;align-items:flex-start;background:var(--surface-canvas);box-shadow:inset 1px 0 0 0 var(--border-subtle);overflow:hidden\">'","-            f'<div style=\"{BOX}align-self:stretch;height:44px;display:flex;flex-direction:column;align-items:flex-start;box-shadow:inset 0 -1px 0 0 var(--border-subtle);overflow:hidden\">'","-            f'<dc-import name=\"comp-chat-header\" variant=\"current\" theme=\"{THEME}\" heading=\"{escape(heading)}\" style=\"width:100%\"></dc-import></div>'","-            f'<div style=\"{BOX}align-self:stretch;display:flex;flex-direction:column;align-items:flex-start;overflow:hidden\">{card}</div>'","-            f'<div data-n=\"Timeline\" style=\"{BOX}align-self:stretch;flex:1 1 0;min-height:0;display:flex;flex-direction:column;justify-content:{\"flex-end\" if scrolled_to_end else \"flex-start\"};gap:var(--space-12);padding:var(--space-8) var(--space-16);align-items:flex-start;overflow:hidden\">'","-            + ''.join(timeline) + '</div>' + band + '</div>')","+def big_settings():","+    lines = ''.join(f'<div class=\"page-title\" style=\"{BOX}white-space:nowrap;color:var(--text-secondary);font-weight:400\">{escape(a)}<b style=\"font-weight:700;color:var(--action-primary)\">{escape(b)}</b></div>' for a, b in SETTINGS)","+    return f'<div data-n=\"Settings changed\" style=\"{ABS}left:216px;top:var(--space-16);width:388px;display:flex;flex-direction:column;gap:var(--space-8)\">{lines}</div>'"," ","-def prepare(printer, vp, alt, pane_html, overlay='', action='slice', mark=None):","-    body = f'<div data-n=\"workspace\" style=\"{BOX}align-self:stretch;display:flex;align-items:flex-start\">' + plate(vp, alt) + pane_html + '</div>'","-    return (f'<div data-n=\"Prepare\" data-theme=\"{THEME}\" class=\"body\" style=\"{BOX}position:relative;width:{SCREEN_W}px;height:{SCREEN_H}px;display:flex;flex-direction:column;align-items:flex-start;'","-            f'background:var(--surface-canvas);color:var(--text-primary);font-family:var(--font-sans);overflow:hidden\">' + bar(printer, action, mark) + body + overlay + '</div>')","+def slicing(pct):","+    head = f'<div class=\"page-title\" style=\"{ABS}left:var(--space-16);top:148px;white-space:nowrap;color:var(--text-primary)\">{SLICING}<span style=\"color:var(--action-primary)\">{pct}</span>%</div>'","+    bar = (f'<div data-n=\"Slicing bar\" style=\"{ABS}left:var(--space-16);top:196px;width:300px;height:var(--component-progress-height);border-radius:var(--radius-full);background:var(--border-subtle);overflow:hidden\">'","+           f'<div style=\"{BOX}width:{pct}%;height:100%;background:var(--action-primary)\"></div></div>')","+    return head + bar"," ","-# ---- the chat pieces -------------------------------------------------------------------------------------------------","-def opened(name, when='15:04'):","-    return system_line(f'Opened {name} as a new project', f'you · {when}')","+def sliced_line():","+    return (f'<div style=\"{ABS}left:var(--space-16);top:148px\">{icon(\"circle-check\", \"--status-success\", 40)}</div>'","+            f'<div class=\"section\" style=\"{ABS}left:var(--space-16);top:204px;white-space:nowrap;color:var(--status-success)\">{escape(DONE)}</div>')"," ","-def agent_text(s):","-    return text('body', s)","-","-def working(words='Working on it… 3s'):","-    return text('metadata', words, '--text-secondary')","-","-def change(title, sub):","-    return change_row(title, sub)","-","-def done_card(title):","-    return (f'<div data-c=\"Chat/Tool Card\" style=\"{BOX}align-self:stretch;display:flex;flex-direction:column;gap:var(--space-4);padding:var(--space-12);background:var(--surface-subtle);border-radius:var(--radius-medium)\">'","-            + text('body-small-bold', title) + row([icon('check', '--status-success', 14), text('body-small', 'Done', '--text-secondary', 'flex:none', True)], 8) + '</div>')","-","-# Before an account or a key there is no model to choose, so the box has + and Send only (today it shows a raw model id).","-def bare_bar(send='Send', on=False):","-    plus = (f'<div data-c=\"Button/Icon:State=Default\" data-n=\"Attach\" style=\"{BOX}width:32px;height:32px;display:flex;justify-content:center;align-items:center;border-radius:var(--radius-small)\">{icon(\"plus\", \"--text-primary\", 16)}</div>')","-    return (f'<div data-n=\"Toolbar\" style=\"{BOX}align-self:stretch;display:flex;gap:var(--space-8);justify-content:space-between;align-items:center\">{plus}' + send_button(send, on) + '</div>')","-","-def box(field, typed=False, focus=False, tool=None):","-    ring = '2px var(--border-focus)' if focus else '1px var(--border-subtle)'","-    return (f'<div data-n=\"Composer box\" style=\"{BOX}align-self:stretch;position:relative;display:flex;flex-direction:column;gap:var(--space-4);padding:var(--space-8);align-items:flex-start;background:var(--surface-canvas);border-radius:var(--radius-medium);box-shadow:inset 0 0 0 {ring}\">'","-            f'<div data-n=\"Input\" class=\"body\" style=\"{BOX}align-self:stretch;display:flex;flex-direction:column;padding:var(--space-4);align-items:flex-start\">'","-            + text('body', field, '--text-primary' if typed else '--text-tertiary') + '</div>' + (tool or bare_bar()) + '</div>')","-","-def band(*kids):","-    return (f'<div data-n=\"Composer band\" style=\"{BOX}align-self:stretch;position:relative;z-index:2;display:flex;flex-direction:column;gap:var(--space-8);padding:var(--space-12);align-items:flex-start;background:var(--surface-canvas);box-shadow:inset 0 1px 0 0 var(--border-subtle)\">'","-            + ''.join(kids) + '</div>')","-","-def gate(extra=None):","-    \"\"\"Send pressed with no account and no key. The offer's own surface, as on the credits boards; the button names the reward.\"\"\"","-    head = row([text('body-small', OFFER_DETAIL, extra='flex:1 1 0;min-width:0'), dismiss()], 4, align='flex-start')","-    acts = row([primary(OFFER_GATE), link(KEY_LINK)], 8, align='center')","-    kids = [head, acts] + ([extra] if extra else [])","-    return (f'<div data-n=\"Sign-in gate\" style=\"{BOX}align-self:stretch;display:flex;flex-direction:column;gap:var(--space-8);padding:var(--space-8) var(--space-8) var(--space-12) var(--space-12);background:var(--surface-selected);border-radius:var(--radius-medium)\">'","-            + ''.join(kids) + '</div>')","-","-def signed_bar(tier_state='rest', frac=1.0, left='500 left', send='Send', on=True):","-    return toolbar(tier='Expert', thinking='Thinking: Thorough', balance=left, send=send, send_on=on, tier_state=tier_state, balance_frac=frac)","-","-def waiting():","-    return (f'<div data-n=\"Waiting for browser\" style=\"{BOX}align-self:stretch;display:flex;flex-direction:column;gap:var(--space-4);padding:var(--space-8) var(--space-8) var(--space-8) var(--space-12);background:var(--surface-selected);border-radius:var(--radius-medium)\">'","-            + text('body-small', 'Finish signing in in your browser, then come back here.')","-            + row([link('Open browser again'), link('Cancel')], 8, 'align-self:stretch;margin-left:calc(var(--space-4) * -1)') + '</div>')","-","-def signed_line():","-    return (f'<div data-n=\"Signed in\" style=\"{BOX}align-self:stretch;display:flex;gap:var(--space-8);align-items:center;padding:0 var(--space-4)\">'","-            + icon('check', '--status-success', 14) + text('body-small', 'You’re signed in, and 500 first-month credits are yours.', extra='flex:1 1 0;min-width:0') + '</div>')","-","-def browser(left='var(--space-48)', width=560):","-    \"\"\"The system browser over the app; a representative view, as board 04 draws one.\"\"\"","-    head = (f'<div style=\"{BOX}align-self:stretch;display:flex;flex-direction:column;background:var(--surface-subtle);box-shadow:inset 0 -1px 0 0 var(--border-subtle)\">'","-            f'<div style=\"{BOX}align-self:stretch;height:36px;display:flex;padding:0 var(--space-16);justify-content:space-between;align-items:center\">'","-            + text('label-bold', 'System browser', extra='flex:none', nowrap=True) + icon('x', '--text-secondary', 16) + '</div>'","-            f'<div style=\"{BOX}align-self:stretch;height:44px;display:flex;gap:var(--space-12);padding:0 var(--space-16) var(--space-8);align-items:center\">'","-            + icon('chevron-left', '--text-secondary', 16) + icon('rotate-cw', '--text-primary', 16)","-            + f'<div style=\"{BOX}flex:1 1 0;min-width:0;height:28px;display:flex;padding:0 var(--space-12);align-items:center;background:var(--surface-canvas);border-radius:var(--radius-small);box-shadow:inset 0 0 0 1px var(--border-subtle)\">'","-            + text('label', 'app.obico.io/o/authorize', '--text-secondary', 'flex:none', True) + '</div></div></div>')","-    page = (f'<div style=\"{BOX}align-self:stretch;flex:1 1 0;min-height:0;display:flex;flex-direction:column;gap:var(--space-24);padding:var(--space-32);align-items:flex-start\">'","-            + col([text('section', 'Sign in to JusPrin'), text('body-small', 'Your first month comes with 500 credits.', '--text-secondary')], 4)","-            + col([secondary('Continue with Google', True), secondary('Continue with email', True)], 8) + '</div>')","-    foot = (f'<div style=\"{BOX}align-self:stretch;padding:var(--space-12) var(--space-16);box-shadow:inset 0 1px 0 0 var(--border-subtle)\">'","-            + text('label', 'Representative browser view, not the exact page.', '--text-secondary') + '</div>')","-    return (f'<div data-n=\"System browser window\" style=\"{BOX}position:absolute;z-index:6;left:{left};top:136px;width:{width}px;height:440px;display:flex;flex-direction:column;background:var(--surface-raised);border-radius:var(--radius-medium);box-shadow:inset 0 0 0 1px var(--border-subtle),var(--elevation-strong);overflow:hidden\">'","-            + head + page + foot + '</div>')","-","-def stopped():","-    \"\"\"19A's recovery in the thread, at the size of the thread's text: Retry, Continue locally, and what is untouched.\"\"\"","-    return (f'<div data-n=\"Could not look\" style=\"{BOX}align-self:stretch;display:flex;flex-direction:column;gap:var(--space-12);padding:var(--space-12);background:var(--surface-subtle);border-radius:var(--radius-medium)\">'","-            + row([icon('circle-alert', '--status-warning', 16), text('body-bold', 'JusPrin couldn’t look at your part', extra='flex:1 1 0;min-width:0')], 8)","-            + text('body', 'It couldn’t reach its AI service. Your project is open and nothing is lost: you can arrange it, slice it and print it as usual.')","-            + text('body-small', 'The printer is an assumption, a Bambu A1 mini. If yours is different, change it in the menu at the top; that list works without the AI service.', '--text-secondary')","-            + row([secondary('Retry'), link('Continue locally')], 8) + '</div>')","-","-# ---- Home ------------------------------------------------------------------------------------------------------------","-def app_top(crumb='Home'):","-    return (f'<div data-n=\"top-bar\" style=\"{BOX}align-self:stretch;height:56px;display:flex;padding:0 var(--space-24);justify-content:space-between;align-items:center;background:var(--surface-canvas);box-shadow:inset 0 -1px 0 0 var(--border-subtle)\">'","-            f'<div data-n=\"top-bar-left\" style=\"{BOX}display:flex;gap:var(--space-12);align-items:center\">' + text('section', 'JusPrin', '--action-primary', 'flex:none', True) + icon('chevron-right', '--text-secondary', 14) + text('body', crumb, '--text-secondary', 'flex:none', True) + '</div>'","-            f'<button aria-label=\"Preferences\" style=\"{BTN}{BOX}width:32px;height:32px;display:flex;justify-content:center;align-items:center;background:none;border-radius:var(--radius-small)\">{icon(\"settings\", \"--text-primary\", 16)}</button></div>')","-","-def clip(w, h):","-    \"\"\"The proof, in the window's 16:10: a placeholder with a play control and no words, until the proof is decided.\"\"\"","-    play = (f'<div data-n=\"Play\" style=\"{BOX}width:var(--space-48);height:var(--space-48);display:flex;justify-content:center;align-items:center;background:var(--action-primary);border-radius:var(--radius-full)\">{icon(\"play\", \"--action-on-primary\", 20)}</div>')","-    track = f'<div data-n=\"Progress\" style=\"{BOX}position:absolute;left:var(--space-12);right:var(--space-12);bottom:var(--space-12);height:var(--space-4);background:var(--border-subtle);border-radius:var(--radius-full)\"></div>'","-    return (f'<div data-n=\"Proof placeholder\" style=\"{BOX}position:relative;flex:none;width:{w}px;height:{h}px;display:flex;justify-content:center;align-items:center;background:var(--surface-raised);border-radius:var(--radius-medium);box-shadow:inset 0 0 0 1px var(--border-subtle),var(--elevation-subtle);overflow:hidden\">'","-            + play + track + '</div>')","-","-def promise_block(w, h):","-    return col([text('page-title', PROMISE, extra='text-align:center', nowrap=False), clip(w, h)], 12, 'flex:none', align='center', name='The promise')","-","-FILE_TYPES = 'STL, 3MF, STEP, OBJ, AMF, SVG or ZIP.'","-AGENT_EXPLAINED = FILE_TYPES + ' JusPrin’s Agent, the AI that reads your model and plans the print with you, takes a look as soon as it opens.'","-","-def home(orca_row=False, top_card=None, blurb=AGENT_EXPLAINED, promise=False):","-    \"\"\"top_card: what sits above PRINTERS. Variant A's is the first-month offer; variant B's says which door was taken.","-    promise: variant A has no welcome screen, so Home's empty state opens on the promise and the clip.\"\"\"","-    top = app_top()","-    new_btn = (f'<button data-c=\"Button/SecondarySmall:State=Default\" style=\"{BTN}{BOX}height:28px;display:flex;gap:6px;padding:var(--space-4) var(--space-12);justify-content:center;align-items:center;background:var(--surface-raised);border-radius:var(--radius-small);box-shadow:inset 0 0 0 1px var(--border-subtle)\">'","-               + icon('plus', '--text-primary', 16) + text('body-small', 'New', extra='flex:none', nowrap=True) + '</button>')","-    open_btn = (f'<button data-c=\"Button/Primary:State=Default\" style=\"{BTN}{BOX}height:34px;display:flex;gap:6px;padding:var(--space-8) var(--space-16);justify-content:center;align-items:center;background:var(--action-primary);border-radius:var(--radius-medium)\">'","-                + icon('upload', '--action-on-primary', 16) + text('body-small-bold', 'Open…', '--action-on-primary', 'flex:none', True) + '</button>')","-    words = col([text('section', 'Drop a model or project to start', extra='text-align:center', nowrap=False),","-                 text('body-small', blurb, '--text-secondary', 'max-width:460px;text-align:center')],","-                4, 'flex:none', align='center')","-    example = row([text('body-small', 'No file handy?', '--text-secondary', 'flex:none', True), link('Try the example')], 4, 'flex:none', name='Example')","-    empty = (f'<div data-n=\"empty-state\" style=\"{BOX}flex:1 1 0;min-height:0;align-self:stretch;display:flex;flex-direction:column;gap:var(--space-16);justify-content:center;align-items:center;padding:var(--space-{\"24\" if promise else \"48\"});background:var(--surface-subtle);border-radius:var(--radius-large);outline:1px dashed var(--border-strong);outline-offset:-1px\">'","-             + (promise_block(384, 240) if promise else '') + icon('upload', '--text-secondary', 24) + words + row([new_btn, open_btn], 12, 'flex:none') + example","-             + text('label', 'Your projects will appear here, most recent first.', '--text-tertiary', 'flex:none;text-align:center') + '</div>')","-    gallery = (f'<div data-n=\"project-gallery\" style=\"{BOX}flex:1 1 0;min-width:0;align-self:stretch;display:flex;flex-direction:column;gap:var(--space-16);padding:var(--space-24);align-items:flex-start\">'","-               f'<div data-n=\"projects-header\" style=\"{BOX}align-self:stretch;height:34px;display:flex;align-items:center;gap:var(--space-8)\">' + text('label-bold', 'PROJECTS', extra='flex:none', nowrap=True) + text('label', '0', '--text-tertiary', 'flex:none', True) + '</div>' + empty + '</div>')","-    offer = (f'<div data-n=\"First-month offer\" style=\"{BOX}align-self:stretch;display:flex;flex-direction:column;gap:var(--space-12);align-items:flex-start;padding:var(--space-16);background:var(--surface-selected);border-radius:var(--radius-medium)\">'","-             + col([text('section', OFFER_HEAD), text('body-small', OFFER_DETAIL)], 4) + primary(OFFER_BUTTON, block=True) + '</div>')","-    orca = (f'<div data-n=\"OrcaSlicer import\" style=\"{BOX}align-self:stretch;display:flex;gap:var(--space-8);align-items:center\">'","-            + text('body-small', 'OrcaSlicer is on this computer. Bring in its printers and presets?', '--text-secondary', 'flex:1 1 0;min-width:0') + link('Import') + '</div>') if orca_row else ''","-    add = (f'<button style=\"{BTN}{BOX}align-self:stretch;height:36px;display:flex;justify-content:center;align-items:center;background:none;border-radius:var(--radius-medium);outline:1px dashed var(--border-subtle);outline-offset:-1px\">'","-           + text('label', '+ Add printer', '--text-secondary', 'flex:none', True) + '</button>')","-    cabinet = (f'<div data-n=\"printer-cabinet\" style=\"{BOX}width:320px;align-self:stretch;display:flex;flex-direction:column;gap:var(--space-16);padding:var(--space-24);align-items:flex-start;box-shadow:inset 1px 0 0 0 var(--border-subtle)\">'","-               + (top_card or offer) + text('label-bold', 'PRINTERS', extra='flex:none', nowrap=True) + orca + add + '</div>')","-    return (f'<div data-n=\"Home\" data-theme=\"{THEME}\" class=\"body\" style=\"{BOX}position:relative;width:{SCREEN_W}px;height:{SCREEN_H}px;display:flex;flex-direction:column;align-items:flex-start;background:var(--surface-canvas);color:var(--text-primary);font-family:var(--font-sans);overflow:hidden\">'","-            + top + f'<div data-n=\"workspace\" style=\"{BOX}flex:1 1 0;min-height:0;align-self:stretch;display:flex;align-items:stretch\">' + gallery + cabinet + '</div></div>')","-","-ICONS['chevron-right'] = '<path d=\"m9 18 6-6-6-6\" />'","-","-# ---- the Preferences window, lifted from the live credits-01a so its offer and key rows stay the approved ones ----------","-def prefs_over(under):","-    s = (proj / 'credits-01a-agent-setup.dc.html').read_text()","-    start = s.rindex('<div', 0, s.index('data-n=\"Preferences window\"'))","-    depth, i = 0, start","-    for m in re.finditer(r'<(/?)div\\b', s[start:]):","-        depth += -1 if m.group(1) else 1","-        if depth == 0:","-            i = start + m.start() + 6","-            break","-    win = s[start:i]","-    # Opened from \"Paste an API key\": the section scrolled so the key rows are at the top of the window.","-    win = win.replace('<div data-n=\"Agent\" style=\"box-sizing:border-box;flex:none;align-self:stretch;display:flex;flex-direction:column;gap:var(--space-24);align-items:flex-start;\">',","-                      '<div data-n=\"Agent\" style=\"box-sizing:border-box;flex:none;align-self:stretch;display:flex;flex-direction:column;gap:var(--space-24);align-items:flex-start;margin-top:-258px;\">')","-    assert 'margin-top:-258px' in win","-    win = re.sub(r'(data-n=\"Preferences window\"[^>]*?style=\"[^\"]*?)position:[a-z]+;', r'\\1', win, count=1)","-    return under, (f'<div data-n=\"Preferences over Prepare\" style=\"{BOX}position:absolute;z-index:8;left:240px;top:80px;width:800px;height:640px;border-radius:var(--radius-large);box-shadow:var(--elevation-strong);overflow:hidden\">' + win + '</div>')","-","-# ---- shared by the boards --------------------------------------------------------------------------------------------","-A1, HOOK_ALT, BENCHY_ALT = 'Bambu Lab A1 mini', 'The real app’s plate with general_purpose_hook.STL', 'The real app’s plate with the bundled 3DBenchy'","-A1_CARD = '0.20mm Standard · Bambu PLA Basic'","-HOOK_HEAD, REPLY = 'general_purpose_hook', 'Reply…'","-ASSUMED_MARK = 'assumed'","-","-def over(screen, overlay):","-    return screen[:-len('</div>')] + overlay + '</div>'","-","-def told(band_html):","-    return prepare(A1, VP_A1, HOOK_ALT, pane(HOOK_HEAD, setup_card(A1_CARD), [opened(FILE), agent_text(HOOK_TOLD)], band_html))","-","-def assumed(band_html):","-    return prepare(A1, VP_A1, HOOK_ALT, pane(HOOK_HEAD, setup_card(A1_CARD), [opened(FILE), agent_text(HOOK_ASSUMED)], band_html), mark=ASSUMED_MARK)","-","-TYPED_COAT, TYPED_PRINTER = 'A heavy winter coat.', 'It’s a Prusa MK4, actually.'","-gate_coat = band(gate(), box(TYPED_COAT, typed=True, focus=True))","-printer_way = row([text('label', 'Or change it yourself, no account:', '--text-secondary', 'flex:none', True), link('Browse the full printer list')], 4, name='Local way')","-","-side_thread = [bubble(TYPED_COAT),","-               agent_text('A winter coat can pull hard on that arm. I’d print the hook on its side, so the layers run along the arm, with 5 walls and 40% infill. Shall I do that and slice it?'),","-               bubble('Do that and slice'),","-               change('Place object', 'Agent · 15:07'),","-               change('Wall loops 2 → <b>5</b>', 'Agent, in 0.20mm Standard @BBL A1M · 15:07'),","-               change('Sparse infill density 15% → <b>40%</b>', 'Agent, in 0.20mm Standard @BBL A1M · 15:07'),","-               done_card('Slicing plate 1'),","-               agent_text('It’s sliced: about 21 minutes and 5.3 g. Check the print before you send it.')]","-side_card = setup_card('0.20mm Standard · Bambu PLA Basic · 2 settings changed', purpose='Hangs a heavy winter coat', plan='On its side so the layers run along the arm, 5 walls, 40% infill', time='~21 min', material='5.3 g', plate='Plate 1')","-","-_door_under = told(gate_coat)","-_, _door = prefs_over(_door_under)","-","-# ---- variant B: the welcome screen and its doors -----------------------------------------------------------------------","-def door(kids, name, selected=False):","-    skin = 'background:var(--surface-selected)' if selected else 'background:var(--surface-raised);box-shadow:inset 0 0 0 1px var(--border-subtle)'","-    return (f'<div data-n=\"{escape(name)}\" style=\"{BOX}flex:1 1 0;min-width:0;align-self:stretch;display:flex;flex-direction:column;gap:var(--space-12);align-items:flex-start;padding:var(--space-16);border-radius:var(--radius-medium);{skin}\">'","-            + ''.join(kids) + '</div>')","-","-def key_field(hint=None, focus=False):","-    \"\"\"Field/Secret: the value in code, the placeholder as Field/Text draws it.\"\"\"","-    ring = '2px var(--border-focus)' if focus else '1px var(--border-subtle)'","-    inner = text('code', hint, extra='flex:none', nowrap=True) if hint else text('body', 'Paste your key', '--text-secondary', 'flex:none', True)","-    return (f'<div data-n=\"API key field\" style=\"{BOX}align-self:stretch;height:var(--component-field-height);display:flex;align-items:center;padding:0 var(--space-8);background:var(--surface-canvas);border-radius:var(--radius-small);box-shadow:inset 0 0 0 {ring}\">{inner}</div>')","-","-KEY_HINT = 'sk-ant-…a3F9'","-","-def door_key(state=None):","-    kids = [text('body-bold', 'Use your own API key'), text('body-small', 'No account. Billed by your provider, stored on this computer only.', '--text-secondary')]","-    if state == 'ok':","-        kids += [key_field(KEY_HINT), row([icon('check', '--status-success', 14), text('body-small', 'This key works: it replied in 0.8 s.', extra='flex:1 1 0;min-width:0')], 8),","-                 text('label', 'Saved to Preferences › Agent. Taking you to Home…', '--text-secondary')]","-    elif state == 'rejected':","-        kids += [key_field(KEY_HINT, focus=True), row([icon('triangle-alert', '--status-warning', 14), text('body-small', 'Anthropic turned this key down, so nothing was saved.', extra='flex:1 1 0;min-width:0')], 8, align='flex-start'),","-                 text('label', 'Paste another key, or take one of the other two ways.', '--text-secondary')]","+def clip(beat):","+    \"\"\"beat: 1, 2, 3, '4a' (the bar counting, at 68%) or 4 (the final frame, held longest).\"\"\"","+    if beat == 1:","+        kids = [plate(BOAT_MODEL, 400), photo(PHOTO_FAILED, PHOTO_BIG),","+                f'<div data-n=\"Their message\" class=\"body\" style=\"{ABS}right:var(--space-16);top:252px;width:276px;padding:var(--space-8) var(--space-12);border-radius:var(--radius-medium);background:var(--surface-subtle)\">{escape(ASKED)}</div>',","+                caption(0)]","+    elif beat in (2, 3):","+        kids = [photo(PHOTO_FAILED, PHOTO_CORNER), reply_burst()] + ([big_settings()] if beat == 3 else []) + [caption(beat - 1)]","+    elif beat == '4a':","+        kids = [plate(BOAT_MODEL), photo(PHOTO_FAILED, PHOTO_CORNER), slicing(68), caption(3)]","     else:","-        kids += [key_field(focus=True), text('label', 'From Anthropic, OpenAI or OpenRouter. Pasting it is the whole step.', '--text-secondary')]","-    return door(kids, 'Door: your own API key')","+        kids = [plate(BOAT_SLICED), photo(PHOTO_CLEAN, PHOTO_CORNER), sliced_line(), caption(3)]","+    return f'<div data-n=\"Clip, beat {beat}\" style=\"{BOX}position:relative;width:{CLIP_W}px;height:{CLIP_H}px;overflow:hidden;background:var(--surface-canvas)\">' + ''.join(kids) + '</div>'"," ","-def door_offer(signing_in=False):","-    return door([text('body-bold', 'Try the agent'), col([text('section', OFFER_HEAD), text('body-small', OFFER_DETAIL)], 4),","-                 col([text('body-small', 'Finish signing in in your browser, then come back here.'), row([link('Open browser again'), link('Cancel')], 8, 'align-self:stretch;margin-left:calc(var(--space-4) * -1)')], 4) if signing_in else primary(OFFER_BUTTON, block=True)], 'Door: first-month offer', selected=True)","+# ---- the welcome screen -----------------------------------------------------------------------------------------------------------","+def header():","+    left = row([text('section', 'JusPrin', '--action-primary', 'flex:none', True), icon('chevron-right', '--text-secondary', 14), text('body', 'Agent', '--text-secondary', 'flex:none', True)], 12, 'flex:none')","+    right = row([icon('circle-dashed', '--text-secondary', 12), text('label', 'Agent not connected', '--text-secondary', 'flex:none', True)], 8, 'flex:none')","+    return f'<div data-n=\"top-bar\" style=\"{BOX}align-self:stretch;height:56px;display:flex;padding:0 var(--space-24);justify-content:space-between;align-items:center;box-shadow:inset 0 -1px 0 0 var(--border-subtle)\">{left}{right}</div>'"," ","-def code_block(s):","-    return (f'<div data-n=\"Connection settings\" class=\"code\" style=\"{BOX}align-self:stretch;padding:var(--space-8);background:var(--surface-subtle);border-radius:var(--radius-small);color:var(--text-primary);white-space:pre-wrap;overflow-wrap:anywhere\">{escape(s)}</div>')","+def free_door(name, cost):","+    return (f'<div data-n=\"Door: {escape(name)}\" style=\"{BOX}align-self:stretch;display:flex;gap:var(--space-16);justify-content:space-between;align-items:center;padding:var(--space-12) var(--space-16);'","+            'background:var(--surface-subtle);border-radius:var(--radius-medium);box-shadow:inset 0 0 0 1px var(--border-subtle)\">'","+            + text('body-bold', name, extra='flex:1 1 0;min-width:0') + text('label', cost, '--text-secondary', 'flex:none', True) + '</div>')"," ","-def tab(label, on):","-    skin = 'background:var(--surface-selected)' if on else 'background:transparent'","-    return (f'<button type=\"button\" style=\"{BTN}{BOX}height:26px;display:flex;align-items:center;padding:0 var(--space-8);border-radius:var(--radius-small);{skin}\">'","-            f'<span class=\"label-bold\" style=\"white-space:nowrap;color:var({\"--text-primary\" if on else \"--text-secondary\"})\">{escape(label)}</span></button>')","+def doors():","+    offer = (f'<div data-n=\"Door: first-month offer\" style=\"{BOX}align-self:stretch;display:flex;flex-direction:column;gap:var(--space-4);align-items:flex-start;padding:var(--space-16);'","+             'background:var(--surface-selected);border-radius:var(--radius-medium);box-shadow:inset 0 0 0 1px var(--border-subtle)\">'","+             + text('section', OFFER_HEAD) + text('body-small', OFFER_DETAIL, '--text-secondary')","+             + f'<div style=\"{BOX}margin-top:var(--space-8)\">{primary(OFFER_BUTTON)}</div></div>')","+    just = f'<div style=\"{BOX}padding:var(--space-4) 0\">' + text('label-bold', 'Just slice for now', '--action-primary', 'flex:none', True) + '</div>'","+    return col([text('label', DOORS_LABEL, '--text-secondary'), offer, free_door('Your own API key', 'Free'), free_door('Claude Code or Claude Desktop', 'Free · MCP server'), just], 8, name='Doors')"," ","-def door_mcp(which='code', copied=False):","-    snippet, how = ((CLAUDE_CODE_CMD, 'Run it in a terminal, then ask Claude Code to open a model. JusPrin has to stay open.') if which == 'code' else","-                    (json.dumps(json.loads(CLAUDE_DESKTOP_JSON)), 'Add it to claude_desktop_config.json and restart Claude Desktop. JusPrin has to stay open.'))","-    kids = [text('body-bold', 'Connect it to Claude Code or Claude Desktop')]","-    if not copied:","-        kids += [text('body-small', 'Use the AI you already pay for, through the MCP server built into JusPrin. Nothing is charged here.', '--text-secondary')]","-    kids += [row([tab('Claude Code', which == 'code'), tab('Claude Desktop', which != 'code')], 4, name='Which tool'), code_block(snippet)]","-    if copied:","-        kids += [text('body-small', how), row([secondary('Copied', trailing='check'), primary('Go to Home')], 8, justify='space-between')]","-    else:","-        kids += [row([secondary('Copy'), link('Add it for me')], 8)]","-    return door(kids, 'Door: MCP server')","+def welcome(beat):","+    framed = f'<div data-n=\"Clip\" style=\"{BOX}position:relative;width:{CLIP_W}px;height:{CLIP_H}px;border-radius:var(--radius-medium);overflow:hidden;box-shadow:var(--elevation-medium)\">{clip(beat)}</div>'","+    words = col([col([text('page-title', TITLE), text('body', SUBTITLE, '--text-secondary')], 8), doors()], 20, 'flex:1 1 0;min-width:0', name='Words and doors')","+    body = (f'<div data-n=\"Welcome\" style=\"{BOX}flex:1 1 0;min-height:0;align-self:stretch;display:flex;justify-content:center;align-items:center;padding-bottom:var(--space-32)\">'","+            f'<div style=\"{BOX}width:1120px;display:flex;gap:var(--space-48);align-items:center\">{framed}{words}</div></div>')","+    foot = f'<div data-n=\"Footer\" style=\"{BOX}align-self:stretch;height:32px;display:flex;padding:0 var(--space-24);align-items:center;box-shadow:inset 0 1px 0 0 var(--border-subtle)\">' + text('label', FOOTER, '--text-secondary', 'flex:none', True) + '</div>'","+    return (f'<div data-n=\"Welcome screen\" data-theme=\"{THEME}\" class=\"body\" style=\"{BOX}position:relative;width:{SCREEN_W}px;height:{SCREEN_H}px;display:flex;flex-direction:column;background:var(--surface-canvas);color:var(--text-primary);font-family:var(--font-sans);overflow:hidden\">'","+            + header() + body + foot + '</div>')"," ","-def welcome(key=None, offer=None, mcp=None, overlay=''):","-    how = text('body', 'JusPrin’s Agent is an AI that can see your file, settings and slice, and fixes the settings. Choose how to run it. Each way is one step, and you can change it later.', '--text-secondary', 'align-self:stretch;text-align:center')","-    doors = f'<div data-n=\"Three doors\" style=\"{BOX}align-self:stretch;display:flex;gap:var(--space-16);align-items:stretch\">' + (key or door_key()) + (offer or door_offer()) + (mcp or door_mcp()) + '</div>'","-    foot = row([link('Just slice for now'), text('label', 'Everything works without the agent. It’s here when you want it.', '--text-secondary', 'flex:none', True)], 8, justify='center', name='Fourth way')","-    body = (f'<div data-n=\"Welcome\" style=\"{BOX}flex:1 1 0;min-height:0;align-self:stretch;display:flex;flex-direction:column;gap:var(--space-16);justify-content:center;padding:var(--space-16) var(--space-48);align-items:center\">' + promise_block(320, 200) + how + doors + foot + '</div>')","-    return (f'<div data-n=\"Welcome screen\" data-theme=\"{THEME}\" class=\"body\" style=\"{BOX}position:relative;width:{SCREEN_W}px;height:{SCREEN_H}px;display:flex;flex-direction:column;align-items:flex-start;background:var(--surface-canvas);color:var(--text-primary);font-family:var(--font-sans);overflow:hidden\">'","-            + app_top('Welcome') + body + overlay + '</div>')","+# ---- the storyboard ---------------------------------------------------------------------------------------------------------------","+BEATS = [(1, 'Beat 1 · 0 to 2.6 s'), (2, 'Beat 2 · 2.6 to 5 s'), (3, 'Beat 3 · 5 to 7.2 s'), ('4a', 'Beat 4 · 7.2 to 12.2 s, here at 68 %; the final frame is on 02')]","+SCALE = 0.75   # the frames at three quarters of their size, so four fit beside the notes"," ","-def door_taken(head, detail, action=None, done=True):","-    title = ([icon('check', '--status-success', 14)] if done else []) + [text('body-bold', head, extra='flex:1 1 0;min-width:0')]","-    return (f'<div data-n=\"Door taken\" style=\"{BOX}align-self:stretch;display:flex;flex-direction:column;gap:var(--space-4);align-items:flex-start;padding:var(--space-16);background:var(--surface-subtle);border-radius:var(--radius-medium)\">'","-            + row(title, 8) + text('body-small', detail, '--text-secondary') + (f'<div style=\"{BOX}margin-left:calc(var(--space-4) * -1)\">{link(action)}</div>' if action else '') + '</div>')","+def storyboard():","+    cells = ''.join(col([text('label-bold', label, '--text-secondary'),","+                         f'<div style=\"{BOX}width:{CLIP_W * SCALE:.0f}px;height:{CLIP_H * SCALE:.0f}px;border-radius:var(--radius-medium);overflow:hidden;box-shadow:inset 0 0 0 1px var(--border-subtle)\">'","+                         f'<div style=\"{BOX}transform:scale({SCALE});transform-origin:0 0\">{clip(beat)}</div></div>'], 4, 'flex:none')","+                    for beat, label in BEATS)","+    grid = f'<div data-n=\"Beats\" style=\"{BOX}display:grid;grid-template-columns:repeat(2,auto);gap:var(--space-16) var(--space-16)\">{cells}</div>'","+    notes = col([text('section', 'The first-launch clip'),","+                 text('body-small', 'About 12 seconds, silent and looping. Motion only at the beat changes, short holds, and the last frame held longest.', '--text-secondary'),","+                 text('label', 'The agent’s words in beat 2 are placeholders: the opening of a real reply about a different print, until a live run on this photo is recorded. The two settings in beat 3 are placeholders too.', '--text-secondary'),","+                 text('label', 'The boats on the plate are renders of the bundled 3DBenchy, standing in for the app’s own view. The clip that ships is a recording of the real app.', '--text-secondary'),","+                 text('label', 'The settings, the Slicing line and the bar are drawn at page-title size, the largest in the type scale. The reference animatic drew them at 36 to 48 px, which no type token covers.', '--text-secondary'),","+                 f'<div style=\"{BOX}flex:1 1 0\"></div>', text('metadata', CREDIT, '--text-tertiary')], 12, 'flex:1 1 0;min-width:0;align-self:stretch', name='Notes')","+    return (f'<div data-n=\"Clip storyboard\" data-theme=\"{THEME}\" class=\"body\" style=\"{BOX}width:{SCREEN_W}px;height:{SCREEN_H}px;display:flex;gap:var(--space-24);padding:var(--space-24);background:var(--surface-canvas);color:var(--text-primary);font-family:var(--font-sans);overflow:hidden\">'","+            + notes + grid + '</div>')"," ","-def doors_small():","-    \"\"\"The three doors again for someone who chose Just slice. Sign-in goes to the browser; the other two open Preferences › Agent, the one setup flow.\"\"\"","-    offer_small = (f'<div data-n=\"First-month offer\" style=\"{BOX}align-self:stretch;display:flex;flex-direction:column;gap:var(--space-8);align-items:flex-start;padding:var(--space-12);background:var(--surface-selected);border-radius:var(--radius-medium)\">'","-                   + col([text('body-bold', OFFER_HEAD), text('label', OFFER_DETAIL)], 4) + primary(OFFER_BUTTON, small=True, block=True) + '</div>')","-    return col([text('body-bold', PROMISE), text('body-small', 'The agent is an AI that can see your file, settings and slice, and fixes the settings. Add it whenever you like; you can slice without it.', '--text-secondary'),","-                f'<div style=\"{BOX}margin-left:calc(var(--space-4) * -1)\">{link(\"Use your own API key\")}</div>', offer_small,","-                f'<div style=\"{BOX}margin-left:calc(var(--space-4) * -1)\">{link(\"Connect Claude Code or Claude Desktop\")}</div>'], 8, name='Three doors, small')","-","-# Variant A's agent pane before there is a model: a new project with nothing on the plate. Home has no pane, so this is where the pane's empty state is seen.","-def pane_empty():","-    line = f'<div data-n=\"Empty state\" style=\"{BOX}align-self:stretch;flex:1 1 0;display:flex;align-items:center\">' + text('body', PROMISE, '--text-secondary', 'flex:1 1 0;min-width:0;text-align:center') + '</div>'","-    return pane('New project', setup_card(A1_CARD), [line], band(box(NEW_FIELD)))","-","-LIVE_BLURB = FILE_TYPES + ' The agent takes a look as soon as it opens.'","-home_key = home(True, door_taken('The agent is ready', f'On your own API key, {KEY_HINT}. Your provider bills you; JusPrin charges nothing.'), LIVE_BLURB)","-home_hosted = home(True, door_taken('The agent is ready', 'You’re signed in, and 500 first-month credits are yours.'), LIVE_BLURB)","-home_mcp = home(True, door_taken('Claude Code can connect', 'Run the command you copied, then ask Claude Code to open a model. JusPrin has to stay open. Nothing is charged here.', 'Show the command again', done=False), FILE_TYPES)","-home_slice = home(True, doors_small(), FILE_TYPES)","-prepare_slice = prepare(A1, VP_A1, HOOK_ALT, pane(HOOK_HEAD, setup_card(A1_CARD), [opened(FILE),","-    text('body-small', 'JusPrin assumed a Bambu A1 mini, because this file doesn’t name a printer. Change it from the menu at the top.', '--text-secondary'), doors_small()], ''), mark=ASSUMED_MARK)","-","-# ---- boards ----------------------------------------------------------------------------------------------------------","-TOP_A, TOP_B, GAP = 5220, 8180, 920","-COL = [-1440, -80, 1280, 2640, 4000, 5360, 6720]","-def A(stem, title, inner, c, r): return (f'first-run-a-{stem}', f'First run A · {title}', inner, COL[c], TOP_A + r * GAP)","-def B(stem, title, inner, c, r): return (f'first-run-b-{stem}', f'First run B · {title}', inner, COL[c], TOP_B + r * GAP)","-","+# ---- boards -----------------------------------------------------------------------------------------------------------------------","+TOP = 5220"," BOARDS = [","-    A('01a-home-orca-found', '01a · Home: OrcaSlicer found', home(True, promise=True), 0, 0),","-    A('01b-home-nothing-to-import', '01b · Home: nothing to import', home(False, promise=True), 0, 1),","-    A('01c-new-project-empty-pane', '01c · A new project: the agent pane’s empty state repeats the headline', prepare(A1, VP_EMPTY, 'The real app’s empty plate', pane_empty(), mark=ASSUMED_MARK), 0, 2),","-    A('02a-own-model-opened', '02a · Their model opens; the free look starts', prepare(A1, VP_A1, HOOK_ALT, pane(HOOK_HEAD, setup_card(A1_CARD), [opened(FILE), working()], band(box(REPLY, tool=bare_bar('Stop'))))), 1, 0),","-    A('02b-example-opened', '02b · No file: the bundled example', prepare(A1, VP_BENCHY, BENCHY_ALT, pane('3DBenchy', setup_card(A1_CARD), [system_line('Opened the example, 3DBenchy, as a new project', 'you · 15:04'), agent_text(BENCHY_ASSUMED)], band(box(REPLY))), mark=ASSUMED_MARK), 1, 1),","-    A('03a-speaks-on-the-part', '03a · It speaks first, about their part', told(band(box(REPLY))), 2, 0),","-    A('03b-assumed-printer', '03b · No printer found: a default the chip marks and the agent names (both variants)', assumed(band(box(REPLY))), 2, 1),","-    A('04a-send-is-the-gate', '04a · Send is the gate; their text stays', told(gate_coat), 3, 0),","-    A('04b-gate-on-printer-correction', '04b · The same gate when they correct the printer', assumed(band(gate(printer_way), box(TYPED_PRINTER, typed=True, focus=True))), 3, 1),","-    A('04c-browser-round-trip', '04c · One click to the browser', over(told(band(waiting(), box(TYPED_COAT, typed=True))), browser()), 4, 0),","-    A('04d-back-in-the-same-chat', '04d · Back in the same chat, message still there', told(band(signed_line(), box(TYPED_COAT, typed=True, focus=True, tool=signed_bar()))), 5, 0),","-    A('05-ordinary-flow', '05 · Then the ordinary flow (13 to 16 cover the rest)', prepare(A1, VP_A1_SIDE, HOOK_ALT, pane('A Wall Hook Strong Enough for a Coat', side_card, side_thread, band(box(REPLY, tool=signed_bar('fixed', 0.98, '490 left', on=False))), scrolled_to_end=True), action='print'), 6, 0),","-    A('06-turn-could-not-run', '06 · The free look could not run: stays on the project', prepare(A1, VP_A1, HOOK_ALT, pane(HOOK_HEAD, setup_card(A1_CARD), [opened(FILE), stopped()], band(box(REPLY))), mark=ASSUMED_MARK), 4, 1),","-    A('07-own-key-door', '07 · Paste an API key: the key rows in Preferences › Agent', over(_door_under, _door), 5, 1),","-","-    B('01-welcome', '01 · One welcome screen: three doors and a small way out', welcome(), 0, 0),","-    B('02a-key-verified', '02a · Door 1: the key is pasted and works', welcome(key=door_key('ok')), 1, 0),","-    B('02b-key-rejected', '02b · Door 1: the provider turns the key down', welcome(key=door_key('rejected')), 1, 1),","-    B('03-browser-round-trip', '03 · Door 2: one trip to the browser', welcome(offer=door_offer(True), overlay=browser('832px', 432)), 2, 0),","-    B('04a-mcp-command-copied', '04a · Door 3: the Claude Code command copied', welcome(mcp=door_mcp('code', True)), 3, 0),","-    B('04b-mcp-desktop-settings-copied', '04b · Door 3: the Claude Desktop settings copied', welcome(mcp=door_mcp('desktop', True)), 3, 1),","-    B('05a-home-own-key', '05a · Home after door 1: the agent is ready on their key', home_key, 4, 0),","-    B('05b-home-signed-in', '05b · Home after door 2: back from the browser, the agent is ready', home_hosted, 4, 1),","-    B('05c-home-mcp', '05c · Home after door 3: no model in the app', home_mcp, 5, 0),","-    B('05d-home-just-slice', '05d · Home after Just slice: the three doors, small', home_slice, 5, 1),","-    B('06-prepare-just-slice', '06 · Prepare after Just slice: no agent turn, the assumption stated, the doors', prepare_slice, 6, 1),","+    ('first-run-welcome-01-clip-beat-1', 'First run · 01 · Welcome, the clip at beat 1', welcome(1), -1440, TOP),","+    ('first-run-welcome-02-clip-final-frame', 'First run · 02 · Welcome, the clip’s final frame', welcome(4), -80, TOP),","+    ('first-run-welcome-03-clip-storyboard', 'First run · 03 · The clip’s four beats', storyboard(), 1280, TOP),"," ]"," "," def wrap(title, inner):"]},{"oldStart":424,"oldLines":35,"newStart":175,"newLines":36,"lines":[" </html>"," '''"," ","-names = []"," canvas_path = proj / 'canvas.json'"," canvas = json.loads(canvas_path.read_text())","-# The first version of these boards was one set named first-run-NN; it is now variant A, so those names go.","-removed = [k for k in canvas['boards'] if k.startswith('first-run-') and not k.startswith(('first-run-a-', 'first-run-b-'))]","+# Variants A and B are withdrawn (Kenneth, 2026-11-02); their boards and notes go, and nothing else on the page moved for them.","+removed = [k for k in canvas['boards'] if k.startswith(('first-run-a-', 'first-run-b-'))]"," for k in removed:","     del canvas['boards'][k]","     canvas['order'].remove(k)","     (proj / k).unlink(missing_ok=True)","+for nid in ('first-run-title', 'first-run-replaces', 'first-run-b-title', 'first-run-b-about'):","+    canvas['notes'].pop(nid, None)","+    if nid in canvas['noteOrder']:","+        canvas['noteOrder'].remove(nid)","+names = []"," for stem, title, inner, x, y in BOARDS:","     name = stem + '.dc.html'","-    (proj / name).write_text(wrap(title.replace('First run ', ''), inner))","+    (proj / name).write_text(wrap(title.replace('First run · ', ''), inner))","     names.append(name)","     canvas['boards'][name] = {'x': x, 'y': y, 'w': SCREEN_W, 'h': SCREEN_H, 'title': title, 'page': PAGE}","     if name not in canvas['order']:","         canvas['order'].append(name)","-canvas['notes']['first-run-title'] = {'x': -1440, 'y': TOP_A - 100, 'text': 'First run · variant A: no welcome screen', 'kind': 'title1', 'size': 40, 'maxW': 2400, 'page': PAGE}","-canvas['notes']['first-run-replaces'] = {'x': -1920, 'y': TOP_A, 'w': 420, 'page': PAGE, 'fill': 'purple',","-    'text': 'For review, 2026-11-02. Kenneth is comparing two first-run flows: this one and variant B below. Either would replace the onboarding wizard, boards 00 to 11 and 17 to 18 on this page, and the Welcome screens 1b to 1d, which stay for comparison until he decides what to retire.\\n\\n'","-            'Both variants open on one headline, “' + PROMISE + '”, and one proof frame under it, with no tour. The headline stands in until Kenneth’s final wording, and the frame is a placeholder with no words.\\n\\n'","-            'Variant A: the person lands on Home, where the headline tops the empty state, opens their own part, and hears about it before anyone asks for an account. The first message they send is what asks them to sign in, and what they typed stays in the box.\\n\\n'","-            'The printer, in both variants: the one inside a 3MF (the “from the file” chip on the file-printer boards, page Printer & Material Settings), else OrcaSlicer’s printers imported from this computer, else a default the chip marks as assumed and the agent’s first words name. Never a silent default.\\n\\n'","-            'Top row: someone who imported OrcaSlicer’s printers. Bottom row: no OrcaSlicer, so the assumed default (03b, drawn once for both variants), the example, and the two doors out. Plates are captured from the real app; the agent’s words are written for these boards, not model output.'}","-canvas['notes']['first-run-b-title'] = {'x': -1440, 'y': TOP_B - 100, 'text': 'First run · variant B: one welcome screen', 'kind': 'title1', 'size': 40, 'maxW': 2400, 'page': PAGE}","-canvas['notes']['first-run-b-about'] = {'x': -1920, 'y': TOP_B, 'w': 420, 'page': PAGE, 'fill': 'purple',","-    'text': 'Variant B adds one welcome screen before the same Home, and nothing else of the wizard returns. The headline comes first, with the proof frame under it and the doors under that as the how: your own API key, the first-month offer, or connecting Claude Code or Claude Desktop as an MCP server, each one step. A small “Just slice for now” sits under them. Every door lands on Home.\\n\\n'","-            'After Home, variant A’s boards apply: 02a, 03a or 03b, 05 and 06, with the model picker already in the box. There is no sign-in gate, because the person already chose a door. Someone with an MCP connection or who chose Just slice gets no turn from the app, so their agent pane shows the doors again (06).\\n\\n'","-            'Home has no agent pane in the app (the pane is collapsed on Home), so the state each door leaves is drawn at the top of the Printers column. The MCP command and settings are the real shape from Mcp/McpConnections.hpp, with a placeholder home folder.'}","-for nid in ('first-run-title', 'first-run-replaces', 'first-run-b-title', 'first-run-b-about'):","+canvas['notes']['first-run-welcome-title'] = {'x': -1440, 'y': TOP - 100, 'text': 'First launch: one welcome screen', 'kind': 'title1', 'size': 40, 'maxW': 2400, 'page': PAGE}","+canvas['notes']['first-run-welcome-about'] = {'x': -1920, 'y': TOP, 'w': 420, 'page': PAGE, 'fill': 'purple',","+    'text': 'Decided by Kenneth, 2026-11-02. No wizard: the first launch is one welcome screen, a looping silent clip on the left and the words and doors on the right. '","+            'It replaces the onboarding wizard (boards 00 to 11 and 17 to 18 on this page, and Welcome 1b to 1d), which stay here until he retires them.\\n\\n'","+            'The proposition is expert help with a failed print, now, from an AI that can see the file, the settings and the slice and fixes the settings. '","+            'One door is primary, the first-month offer; the two free doors show their cost; “Just slice for now” is a link.\\n\\n'","+            'After the doors nothing new is decided: each setup door opens Preferences › Agent (the one setup flow, 2026-10-23), and “Just slice for now” goes to Home, '","+            'with the printer from the 3MF, else an OrcaSlicer import, else a default the chip marks as assumed. Those screens are not drawn here.\\n\\n'","+            'The clip’s pictures and strings follow the reference animatic in design-captures/value-prop-2026-11; 03 says which parts are placeholders.'}","+for nid in ('first-run-welcome-title', 'first-run-welcome-about'):","     if nid not in canvas['noteOrder']:","         canvas['noteOrder'].append(nid)"," canvas_path.write_text(json.dumps(canvas, ensure_ascii=False, indent=1))"]}],"originalFile":null,"userModified":false},"sourceToolAssistantUUID":"f05544ff-e624-45fb-be35-9bfb64f761e1","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"userType":"external","entrypoint":"claude-desktop","cwd":"/Users/kenneth/.claude/projects/-Users-kenneth-Projects-JusPrin/figma-mirror/work-first-run","sessionId":"473348c5-5f94-4e4d-9ad9-c7e9dd10b438","version":"2.1.309","gitBranch":"jusprin-newui","slug":"glimmering-doodling-lovelace"}
