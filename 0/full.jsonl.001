:Temperature;\n384-    request.project_name = arguments.value(\"projectName\", \"\");\n385-    if (arguments.contains(\"start\")) request.start = arguments[\"start\"].get<double>();\n386-    if (arguments.contains(\"end\")) request.end = arguments[\"end\"].get<double>();\n387-    if (arguments.contains(\"step\")) request.step = arguments[\"step\"].get<double>();\n388-    const std::string method = arguments.value(\"method\", \"tower\");\n389-    request.method      = method == \"line\" ? PressureAdvanceMethod::Line : method == \"pattern\" ? PressureAdvanceMethod::Pattern :\n390-                                                                                               PressureAdvanceMethod::Tower;\n391-    request.bowden      = arguments.value(\"extruderType\", \"direct_drive\") == \"bowden\";\n392-    request.flow_pass   = arguments.value(\"pass\", 1);\n393-    request.flow_linear = arguments.value(\"linear\", true);\n394-    return request;\n395-}\n396-\n397-// Unrounded: a pressure-advance step is a few thousandths.\n398-std::string calibration_number(double value)\n399-{\n400-    std::ostringstream out;\n401-    out << value;\n508:std::string calibration_note(const std::string& started_from)\n509-{\n510-    return started_from.empty() ? \"The test’s settings are temporary\"\n511-                                : \"Started from \" + started_from + \" · the test’s settings are temporary\";\n512-}\n513-\n514-std::string calibration_summary(const Workspace::CalibrationRequest& request, const Workspace::CalibrationResult& made)\n515-{\n516-    const std::string in = \" is ready in this project, \\\"\" + made.project_name + \"\\\": \";\n517-    std::string text;\n518-    switch (request.test) {\n519-    case Workspace::CalibrationTest::Temperature:\n520-        text = \"The temperature tower\" + in + \"blocks from \" + calibration_number(*made.start) +","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"sourceToolAssistantUUID":"ce1c0fc6-214