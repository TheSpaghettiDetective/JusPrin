-chargebee","sessionId":"14cb6590-7113-489e-aa7f-9aa6dca15e79","version":"2.1.309","gitBranch":"jusprin-dev","slug":"rosy-bubbling-whisper"}
{"parentUuid":"da0b7cfe-3065-4882-9d54-0d30db0fd6d2","isSidechain":false,"promptId":"d3cef047-f25f-4980-9952-f7c49a687725","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Ux12uRqHW7MVBBJ85acrj6","type":"tool_result","content":"    elif is_jusprin_subscription(plan_id):\n        # JustPrint subscriptions should not use this callback - they have their own dedicated callback\n        raise Exception(f\"JustPrint subscription {plan_id} should not use Obico callback URL\")\n    else:\n        upsert_subscription(cb_page.hosted_page.content.subscription.values, request.user)\n        messages.success(request, mark_safe('<div>Your subscription is now activated!</div><div>Please remember you need to restart Raspberry Pi to get the premium webcam streaming.</div>'))\n        UserMessage.objects.filter(user=request.user, message__icontains='trial', expire_at__gt=timezone.now()).update(expire_at=timezone.now())\n        return redirect('/user_preferences/subscription/?subscribed=pro')\n\n@csrf_exempt\ndef cb_webhook(request):\n    SUBSCRIPTION_EVENTS = ['subscription_created', 'subscription_started', 'subscription_activated', 'subscription_changed', 'subscription_cancellation_scheduled', 'subscription_cancelled', 'subscription_reactivated', 'subscription_renewed',]\n\n    payload = request.body\n    cb_event = json.loads(payload)\n\n    if cb_event['event_type'] in SUBSCRIPTION_EVENTS:\n        cb_sub = cb_event['content']['subscription']\n\n        # Handle pro subscriptions\n        if cb_sub['plan_id'].startswith('pro-'):\n            try:\n                user = Subscription.objects.get(external_id=cb_event['content']['subscription']['id']).user # in case user is using different email in chargebee\n            except:\n                user = User.objects.get(email__iexact=cb_event['content']['customer']['email'])\n            upsert_subscription(cb_sub, user)\n\n        # Handle JusPrin subscriptions\n        elif is_jusprin_subscription(cb_sub['plan_id']):\n            return handle_jusprin_webhook(cb_event)\n        else:\n            return  HttpResponse('')\n\n    if cb_event['event_type'] == 'invoice_generated':\n        cb_invoice = cb_event['content']['invoice']\n        result = chargebee.Subscription.retrieve(cb_invoice['subscription_id'])\n        if result.subscription.plan_id == 'pre-paid-detective-hour-pack':\n            try:\n                user = PrepaidDHPackPlaceholder.objects.get(external_id=result.subscription.id).user # in case user is using different email in chargebee\n            except:\n                user = User.objects.get(email__iexact=result.customer.email)\n            recharge_prepaid_dh_pack(cb_invoice, user)\n\n    return HttpResponse('')\n\ndef cb_customer_for_user(user):\n    cb_customer_id = user_cb_customer_id(user)\n    if cb_customer_id:\n        return {\n                \"id\" : cb_customer_id,\n            }\n    else:\n        return {\n                \"first_name\" : user.first_name,\n                \"last_name\" : user.last_name,\n                \"email\" : user.email\n            }\n\n### Helper methods #####\n\ndef upsert_subscription(cb_subscription, user):\n    (sub, _) = Subscription.objects.get_or_create(\n        user=user,\n        defaults={'external_id': '', 'external_user_id': '', 'printers_subscribed': 1, 'plan_id': 'pro-monthly'},\n    )\n\n    if sub.external_resource_version == str(cb_subscription['resource_version']):        # chargebee is sending an event even if nothing has changed\n        return\n\n    if cb_subscription.get('status') == 'cancelled':\n        sub.expired_at = timezone.now()\n        update_subscription_from_cb_subcription(sub, cb_subscription)\n    elif cb_subscription.get('status') == 'non_renewing':\n        return # subscription watiting to expire. Nothing should be done (or should it?)\n    elif cb_subscription.get('status') == 'active':\n        sub.expired_at = None\n        prorated_reversal_if_needed(sub, cb_subscription, user)  # prorated reversal has to go before subscription is updated, to use the original sub's resource_version\n        update_subscription_from_cb_subcription(sub, cb_subscription)\n        credit_for_pro_current_term(cb_subscription, user)\n        credit_for_dhpack_current_term(cb_subscription, user)\n    else:\n        raise Exception('Unexpected subscription status: {}'.format(cb_subscription))\n\n    sub.update_pro_status_on_user()\n\ndef update_subscription_from_cb_subcription(sub, cb_subscription):\n    sub.external_id=cb_subscription['id']\n    sub.external_user_id=cb_subscription['customer_id']\n    sub.plan_id = cb_subscription['plan_id']\n    sub.printers_subscribed = sum([a['quantity'] for a in cb_subscription.get('addons', []) if 'additional-printers' in a['id']]) + 1\n    sub.external_resource_version = str(cb_subscription['resource_version'])","is_error":false}]},"uuid":"4158b1af-d31f-440f-be40-c1647337b188","timestamp":"2026-11-10T21:17:13.636Z","toolUseResult":{"stdout":"    elif is_jusprin_subscription(plan_id):\n        # JustPrint subscriptions should not use this callback - they have their own dedicated callback\n        raise Exception(f\"JustPrint subscription {plan_id} should not use Obico callback URL\")\n    else:\n        upsert_subscription(cb_page.hosted_page.content.subscription.values, request.user)\n        messages.success(request, mark_safe('<div>Your subscription is now activated!</div><div>Please remember you need to restart Raspberry Pi to get the premium webcam streaming.</div>'))\n        UserMessage.objects.filter(user=request.user, message__icontains='trial', expire_at__gt=timezone.now()).update(expire_at=timezone.now())\n        return redirect('/user_preferences/subscription/?subscribed=pro')\n\n@csrf_exempt\ndef cb_webhook(request):\n    SUBSCRIPTION_EVENTS = ['subscription_created', 'subscription_started', 'subscription_activated', 'subscription_changed', 'subscription_cancellation_scheduled', 'subscription_cancelled', 'subscription_reactivated', 'subscription_renewed',]\n\n    payload = request.body\n    cb_event = json.loads(payload)\n\n    if cb_event['event_type'] in SUBSCRIPTION_EVENTS:\n        cb_sub = cb_event['content']['subscription']\n\n        # Handle pro subscriptions\n        if cb_sub['plan_id'].startswith('pro-'):\n            try:\n                user = Subscription.objects.get(external_id=cb_event['content']['subscription']['id']).user # in case user is using different email in chargebee\n            except:\n                user = User.objects.get(email__iexact=cb_event['content']['customer']['email'])\n            upsert_subscription(cb_sub, user)\n\n        # Handle JusPrin subscriptions\n        elif is_jusprin_subscription(cb_sub['plan_id']):\n            return handle_jusprin_webhook(cb_event)\n        else:\n            return  HttpResponse('')\n\n    if cb_event['event_type'] == 'invoice_generated':\n        cb_invoice = cb_event['content']['invoice']\n        result = chargebee.Subscription.retrieve(cb_invoice['subscription_id'])\n        if result.subscription.plan_id == 'pre-paid-detective-hour-pack':\n            try:\n                user = PrepaidDHPackPlaceholder.objects.get(external_id=result.subscription.id).user # in case user is using different email in chargebee\n            except:\n                user = User.objects.get(email__iexact=result.customer.email)\n            recharge_prepaid_dh_pack(cb_invoice, user)\n\n    return HttpResponse('')\n\ndef cb_customer_for_user(user):\n    cb_customer_id = user_cb_customer_id(user)\n    if cb_customer_id:\n        return {\n                \"id\" : cb_customer_id,\n            }\n    else:\n        return {\n                \"first_name\" : user.first_name,\n                \"last_name\" : user.last_name,\n                \"email\" : user.email\n            }\n\n### Helper methods #####\n\ndef upsert_subscription(cb_subscription, user):\n    (sub, _) = Subscription.objects.get_or_create(\n        user=user,\n        defaults={'external_id': '', 'external_user_id': '', 'printers_subscribed': 1, 'plan_id': 'pro-monthly'},\n    )\n\n    if sub.external_resource_version == str(cb_subscription['resource_version']):        # chargebee is sending an event even if nothing has changed\n        return\n\n    if cb_subscription.get('status') == 'cancelled':\n        sub.expired_at = timezone.now()\n        update_subscription_from_cb_subcription(sub, cb_subscription)\n    elif cb_subscription.get('status') == 'non_renewing':\n        return # subscription watiting to expire. Nothing should be done (or should it?)\n    elif cb_subscription.get('status') == 'active':\n        sub.expired_at = None\n        prorated_reversal_if_needed(sub, cb_subscription, user)  # prorated reversal has to go before subscription is updated, to use the original sub's resource_version\n        update_subscription_from_cb_subcription(sub, cb_subscription)\n        credit_for_pro_current_term(cb_subscription, user)\n        credit_for_dhpack_current_term(cb_subscription, user)\n    else:\n        raise Exception('Unexpected subscription status: {}'.format(cb_subscription))\n\n    sub.update_pro_status_on_user()\n\ndef update_subscription_from_cb_subcription(sub, cb_subscription):\n    sub.external_id=cb_subscription['id']\n    sub.external_user_id=cb_subscription['customer_id']\n    sub.plan_id = cb_subscription['plan_id']\n    sub.printers_subscribed = sum([a['quantity'] for a in cb_subscription.get('addons', []) if 'additional-printers' in a['id']]) + 1\n    sub.external_resource_version = str(cb_subscription['resource_version'])","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"sandboxed":false,"sourceToolAssistantUUID":"da0b7cfe-3065-4882-9d54-0d30db0fd6d2","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"userType":"external","entrypoint":"claude-desktop","cwd":"/Users/kenneth/Projects/tsd-enterprise-worktrees/jusprin-v2-own-chargebee","sessionId":"14cb6590-7113-489e-aa7f-9aa6dca15e79","version":"2.1.309","gitBranch":"jusprin-dev","slug":"rosy-bubbling-whisper"}
