== OrcaImportItem::Outcome::Imported;\n        }))\n        printer_chosen();\n    return items;\n}\n\n''' + retry + '''const PrinterSetup::PrinterCatalog& OrcaHomeBackend::profile_catalog() { return m_importer.profile_catalog(); }\n\n'''\ns=s[:a]+new_block+s[b:]\ns=s.replace(\"if (!detect_orca_profiles(picked, [this]() -> const auto& { return profile_catalog(); }).has_printers())\",\"if (!m_importer.detect(picked).has_printers())\")\ns=s.replace(\"OrcaProfileSource source   = detect_orca_profiles(m_picked_orca, [this]() -> const auto& { return profile_catalog(); });\",\"OrcaProfileSource source   = m_importer.detect(m_picked_orca);\")\n# 3. import_result_lines skip AlreadyThere\nold='''    for (const OrcaImportItem& item : items) {\n        Snapshot::Onboarding::ImportItem line{to_string(item.kind)'''\nnew='''    for (const OrcaImportItem& item : items) {\n        // Nothing to say about a preset JusPrin already had.\n        if (item.outcome == OrcaImportItem::Outcome::AlreadyThere)\n            continue;\n        Snapshot::Onboarding::ImportItem line{to_string(item.kind)'''\nassert old in s; s=s.replace(old,new,1)\nopen(p,'w').write(s)\n\np='OrcaHomeBackend.hpp'\nh=open(p).read()\nold=h[h.index(\"    // Imports OrcaSlicer preset files and says what became of each.\"):h.index(\"    // Brings the OrcaSlicer items the person asked for\")]\nh=h.replace(old,\"\")\nh=h.replace('''    // Brings the OrcaSlicer items the person asked for and selects the\n    // printer OrcaSlicer had selected, otherwise the first one brought.''','''    // Brings the OrcaSlicer items the person asked for and selects the\n    // printer OrcaSlicer had selected, otherwise the first one brought; the\n    // Printers step then has its printer.''')\nold='''    // JusPrin's own printer profiles, read once the Printers step needs them\n    // to match the printers ticked in OrcaSlicer.\n    std::shared_ptr<const PrinterSetup::PrinterCatalog> m_profile_catalog;\n'''\nassert old in h\nh=h.replace(o