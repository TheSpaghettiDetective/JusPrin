{"type":"api-request-blob","sessionId":"e7286644-9c40-4163-89b2-1b9685541258","hash":"1ebc39fc72c39330ebfae1876b6d255eeba85178b95c85a680f33e240e54304e","message":{"role":"user","content":[{"tool_use_id":"toolu_011kRYrEwHdk4psEzwZESQZv","type":"tool_result","content":"134:TEST_CASE(\"Settings tools share terminal activities across adapters and return atomic results\", \"[tools][settings][mcp]\")\n1453:TEST_CASE(\"settings search can keep only writable or unsaved settings\", \"[tools][settings]\")\n1474:TEST_CASE(\"the settings tools turn spiral vase on with the values it needs\", \"[tools][settings]\")\n1488:    const auto alone = run(\"settings_preview_patch\", json{{\"scope\", \"process\"}, {\"changes\", {{\"spiral_mode\", true}}}});\n1489:    CHECK(registry.validate_output(*registry.find(\"settings_preview_patch\"), alone));\n1495:    const auto preview = run(\"settings_preview_patch\", json{{\"scope\", \"process\"}, {\"changes\", vase}});\n1509:TEST_CASE(\"settings tools read and write one object's overrides\", \"[tools][settings]\")\n1530:    const auto scope = json::parse(run(\"settings_preview_patch\", json{{\"scope\", \"object\"}, {\"changes\", {{\"skirt_loops\", 2}}}, {\"target\", target}}).result_json);\n1559:        CHECK_FALSE(registry.validate_call(*registry.find(std::string(bad).find(\"keys\") != std::string::npos ? \"settings_get\" : \"settings_preview_patch\"), bad).valid());\n1562:TEST_CASE(\"a printer preset OrcaSlicer ships is saved as a copy, which is used in its place\", \"[tools][settings]\")\n1576:    const auto own = json::parse(run(\"settings_preview_patch\", json{{\"scope\", \"printer\"}, {\"target\", printer}, {\"changes\", changes},\n1577:                                                                    {\"persistAs\", \"Fixture printer\"}}).result_json);\n1578:    CHECK(registry.validate_output(*registry.find(\"settings_preview_patch\"), own));\n1585:    const json apply{{\"scope\", \"printer\"}, {\"target\", printer}, {\"changes\", changes}, {\"persistAs\", \"Fixture printer - Copy\"},\n1603:TEST_CASE(\"a preset that is not being edited changes only by being saved\", \"[tools][settings]\")\n1607:        const std::string id = h.coordinator.submit({\"settings_preview_patch\", arguments.dump()}, \"m-1\").action_id;\n1615:    CHECK(preview(json{{\"scope\", \"printer\"}, {\"target\", garage}, {\"changes\", changes}, {\"persistAs\", \"Garage printer\"}})[\"valid\"] == true);\n1616:    CHECK(preview(json{{\"scope\", \"printer\"}, {\"target\", garage}, {\"changes\", changes}, {\"persistAs\", \"Garage two\"}})[\"issues\"][0][\"code\"] ==\n1618:    CHECK(preview(json{{\"scope\", \"printer\"}, {\"target\", garage}, {\"changes\", changes}, {\"persistAs\", \"Fixture printer\"}})[\"issues\"][0][\"code\"] ==\n1625:    CHECK(preview(json{{\"scope\", \"filament\"}, {\"target\", petg}, {\"changes\", hotter}, {\"persistAs\", \"Fixture PETG - Copy\"}})[\"valid\"] == true);\n1628:    CHECK(preview(json{{\"scope\", \"filament\"}, {\"target\", petg}, {\"changes\", hotter}, {\"persistAs\", \"Fixture PETG - Copy\"}})[\"warnings\"][0][\"code\"] ==\n1636:    CHECK(preview(json{{\"scope\", \"filament\"}, {\"target\", petg}, {\"changes\", {{\"compatible_printers\", \"Any\"}}}, {\"persistAs\", \"x\"}})[\"issues\"][0][\"code\"] ==\n1646:TEST_CASE(\"settings_get never returns a printer's connection credentials\", \"[tools][settings]\")\n1673:TEST_CASE(\"saving a copy of a project filament puts the copy in its slot\", \"[tools][settings]\")\n1678:                     {\"persistAs\", \"Fixture PETG - Copy\"}, {\"expectedSessionId\", std::to_string(snapshot.session.value())},\n1923:TEST_CASE(\"a settings patch survives model edits after its preview, but not a settings edit\", \"[tools][settings]\")\n1946:    const auto refused = registry.validate_call(*registry.find(\"settings_preview_patch\"), json{{\"scope\", \"process\"}, {\"changes\", {{\"wall_loops\", 3}}}, {\"intent\", \"x\"}}.dump());\n1949:    CHECK(registry.validate_call(*registry.find(\"settings_preview_patch\"), \"{}\").error->message.find(\"Missing: scope, changes.\") != std::string::npos);","is_error":false}]}}
