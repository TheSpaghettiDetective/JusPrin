lor: var(--text-tertiary);\n}\n\n.orca-import-row-status {\n  flex: none;\n  font: var(--font-label);\n  color: var(--text-secondary);\n}\n\n.orca-import-icon--done {\n  color: var(--status-success);\n}\n\n.orca-import-icon--warning {\n  color: var(--status-warning);\n}\n\n.orca-import-folder {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  color: var(--text-tertiary);\n}\n\n.orca-import-folder-path {\n  flex: 1 1 auto;\n  min-width: 0;\n  font: var(--font-label);\n  overflow-wrap: anywhere;\n}\n\np.orca-import-error {\n  margin: 0;\n  font: var(--font-body-small);\n  color: var(--status-danger);\n}\n\n.orca-import-buttons {\n  display: flex;\n  flex: none;\n  justify-content: flex-end;\n  align-items: center;\n  gap: 12px;\n  padding: 12px 20px;\n  box-shadow: inset 0 1px 0 0 var(--border-subtle);\n}\n\n.orca-import-buttons button:not(.primary) {\n  min-height: var(--button-secondary-height);\n  padding: var(--button-secondary-padding);\n  border-color: var(--border-subtle);\n  font: var(--font-body-small);\n}\n\n.jp-icon-monitor { -webkit-mask-image: url('@resources/jusprin/ui/icons/monitor.svg'); mask-image: url('@resources/jusprin/ui/icons/monitor.svg'); }\n'''\ns=s.replace(anchor,anchor+css,1)\nopen(p,'w').write(s)\nEOF\ncp WelcomeApp.tsx /dev/null; sed -n 1,12p WelcomeApp.tsx >/dev/null; echo done"},"caller":{"type":"direct"}}]}}
