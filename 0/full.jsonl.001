{"type":"custom-title","customTitle":"Verify JusPrin 2 Chargebee setup and payment flow on staging","sessionId":"14cb6590-7113-489e-aa7f-9aa6dca15e79"}
{"type":"agent-name","agentName":"Verify JusPrin 2 Chargebee setup and payment flow on staging","sessionId":"14cb6590-7113-489e-aa7f-9aa6dca15e79"}
{"type":"mode","mode":"normal","sessionId":"14cb6590-7113-489e-aa7f-9aa6dca15e79"}
