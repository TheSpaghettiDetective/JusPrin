{"type":"api-request-blob","sessionId":"e7286644-9c40-4163-89b2-1b9685541258","hash":"0106648e3af30d20e569924a26b517777951920a661dd9c7f8ceacc50c582be5","message":{"role":"user","content":[{"tool_use_id":"toolu_016tHLMQcbGEAHxHzz1Eb66C","type":"tool_result","content":"4:1362-        send_bridge_error(refusal->code, refusal->message, envelope_id);\n10:1368-        send_bridge_error(\"stale_conversation\", \"This message belongs to a different chat.\", envelope_id);\n24:1382-        send_bridge_error(\"invalid_payload\", \"A message needs text or an attachment.\", envelope_id);\n2371:void AgentHost::start_turn(const std::string& source_message_id)\n2372-{\n2373-    if (m_chat_transition_blocked)\n2374-        return;\n2375-    // As a sent message does: the title is optional, the turn is not. The\n2376-    // source ID keeps an app-initiated file report attached to its own turn.\n2377-    cancel_conversation_title();\n2378-    if (agent_busy()) {\n2379-        m_queued_user_message_ids.push_back(source_message_id);\n2380-        return;\n2381-    }\n2382-    begin_reply(source_message_id);\n2383-}\n2384-\n2385-void AgentHost::set_session_tool_preflight(ToolExecutionCoordinator::ExtensionPreflight preflight)\n2386-{\n2387-    m_tools.set_extension_preflight(std::move(preflight));\n2388-}\n2389-\n2390-void AgentHost::send_page_envelope(const std::string& type, const json& payload)\n2391-{\n2392-    send_envelope(type.c_str(), payload.dump());\n2393-}\n2394-\n2395-AgentHost::SubmitResult AgentHost::submit_issue_message(const std::string& client_message_id, const std::string& text,\n2396-                                                        const std::string& context_json, std::string* refusal)","is_error":false}]}}
