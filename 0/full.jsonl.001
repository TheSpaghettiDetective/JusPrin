= live_anthropic_agent(sent, usage);\n+    AgentRequest                  request;\n+    request.request_id = \"live-anthropic-title\";\n+    request.purpose    = AgentRequest::Purpose::ConversationTitle;\n+    request.user_text  = \"Help me print a backpack frame.\";\n+    REQUIRE(agent->start(request));\n+    const Turn turn = run_until_settled(*agent);\n+    report(usage);\n+    INFO(\"title: \" << turn.text << (turn.error ? \" error: \" + turn.error->code + \" \" + turn.error->message : \"\"));\n+    CHECK_FALSE(turn.error);\n+    CHECK(turn.completed);\n+    CHECK_FALSE(turn.text.empty());\n+    REQUIRE(sent.size() == 1);\n+    const json body = json::parse(sent.front().body);\n+    CHECK_FALSE(body.contains(\"tools\"));\n+    REQUIRE(body[\"messages\"].size() == 1);\n+    CHECK(body[\"messages\"][0][\"role\"] == \"user\");\n+    CHECK(body[\"messages\"][0][\"content\"].dump().find(\"backpack frame\") != std::string::npos);\n }\n \n namespace {\ndiff --git a/tests/jusprin/test_shell_theme.cpp b/tests/jusprin/test_shell_theme.cpp\nindex 6f43c0f550..7dd97393f4 100644\n--- a/tests/jusprin/test_shell_theme.cpp\n+++ b/tests/jusprin/test_shell_theme.cpp\n@@ -362,7 +362,7 @@ TEST_CASE(\"the printer chip marks a printer from the file\", \"[shell][theme][wx]\"\n     const ShellTheme theme = load_packaged_theme();\n     auto* frame = new wxFrame(nullptr, wxID_ANY, \"chip\");\n     auto* chip  = new PrinterFilamentChip(frame, theme);\n-    auto near = [](const wxColour& a, unsigned char r, unsigned char g, unsigned char b) {\n+    auto close_to = [](const wxColour& a, unsigned char r, unsigned char g, unsigned char b) {\n         return std::abs(a.Red() - r) < 24 && std::abs(a.Green() - g) < 24 && std::abs(a.Blue() - b) < 24;\n     };\n     for (const bool dark : {false, true}) {\n@@ -376,7 +376,7 @@ TEST_CASE(\"the printer chip marks a printer from the file\", \"[shell][theme][wx]\"\n             const int glyph_end = half.FromDIP(12 + theme.metrics().button.icon.icon_siz