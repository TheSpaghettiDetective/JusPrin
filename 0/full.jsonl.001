 act_buttons = ActionButtons::KEEP | ActionButtons::REMEMBER_CHOISE;\n        if (!yes_or_no)\n            act_buttons |= ActionButtons::SAVE;\n        if (m_exported_file) { //.gcode.3mf ignore presets modify\n            m_exported_file = false;\n        }\n        bool result = wxGetApp().check_and_keep_current_preset_changes(_L(\"Creating a new project\"), header, act_buttons, &transfer_preset_changes);\n        m_new_project_and_check_state = false;\n        return result;\n    };\n    int result;\n    if ((!skip_confirm && (result = close_with_confirm(m_before_project_release ? std::function<bool(bool)>{} : check)) == wxID_CANCEL) ||\n        (skip_confirm && m_before_project_release && !m_before_project_release()))\n        return wxID_CANCEL;\n\n    // Rebase note: keep these two upstream resets after the release guard.\n    // They used to run at function entry, which mutated the old project even\n    // when a failed durable save canceled replacement.\n    model().calib_pa_pattern.reset(nullptr);\n    model().plates_custom_gcodes.clear();\n\n    ProjectStateTransaction project_change = project_state_transaction();\n\n    m_only_gcode = false;\n    m_exported_file = false;\n    m_loading_project = false;\n    get_notification_manager()->clear_all();\n\n    if (!silent)\n        wxGetApp().mainframe->select_tab(MainFrame::tp3DEditor);\n\n    //get_partplate_list().reinit();\n    //get_partplate_list().update_slice_context_to_current_plate(p->background_process);\n    //p->preview->update_gcode_result(p->partplate_list.get_current_slice_result());\n    reset(transfer_preset_changes);\nsrc/slic3r/GUI/Plater.cpp:12072:        bool result = wxGetApp().check_and_keep_current_preset_changes(_L(\"Creating a new project\"), header, act_buttons, &transfer_preset_changes);\nsrc/slic3r/GUI/Plater.cpp:12149:        if (!yes_or_no && !wxGetApp().check_and_save_current_preset_changes(_L(\"Load project\"),\nsrc/slic3r/GUI/MainFrame.cpp:588:        //if (event.CanVeto() && !wxGetApp().check_and_save_current_preset_changes(_L(\"Application is closing\"), _L(\"Closing Application while some presets are modified.\"))) {\nsrc/slic3r/GUI/MainFrame.cpp:595:            return wxGetApp().check_and_save_current_preset_changes(_L(\"Application is closing\"), _L(\"Closing Application while some presets are modified.\"));\nsrc/slic3r/GUI/MainFrame.cpp:619:        //             (plater()->is_presets_dirty() && !wxGetApp().check_and_save_current_preset_changes(_L(\"Application is closing\"), _L(\"Closing Application while some presets are modified.\")))) {\nsrc/slic3r/GUI/MainFrame.cpp:3732: //   if (!wxGetApp().check_and_save_current_preset_changes(_L(\"Loading profile file\"), \"\", false))\nsrc/slic3r/GUI/MainFrame.cpp:3794:   // if (!wxGetApp().check_and_save_current_preset_changes(_L(\"Exporting current profile bundle\"),\nsrc/slic3r/GUI/GUI_App.cpp:4617:            wxGetApp().check_and_keep_current_preset_changes(_L(\"User logged out\"), header, ActionButtons::KEEP | ActionButtons::SAVE, &transfer_preset_changes);\nsrc/slic3r/GUI/GUI_App.cpp:8203:bool GUI_App::check_and_save_current_preset_changes(const wxString& caption, const wxString& header, bool remember_choice/* = true*/, bool dont_save_insted_of_discard/* = false*/)\nsrc/slic3r/GUI/GUI_App.cpp:8255:bool GUI_App::check_and_keep_current_preset_changes(const wxString& caption, const wxString& header, int action_buttons, bool* postponed_apply_of_keeped_changes/* = nullptr*/)","is_error":false}]}}
