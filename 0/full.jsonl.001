 += \"M976 S1 P1 ; scan model before printing 2nd layer\\n\";\n                gcode += \"M400 P100\\n\";\n                gcode += this->unretract();\n            }\n        }\n      // Reset acceleration at sencond layer\n      // Orca: only set once, don't need to call set_accel_and_jerk\n      if (m_config.default_acceleration.value > 0 && m_config.initial_layer_acceleration.value > 0) {\n        gcode += m_writer.set_print_acceleration((unsigned int) floor(m_config.default_acceleration.value + 0.5));\n      }\n\n      if (m_config.default_jerk.value > 0 && m_config.initial_layer_jerk.value > 0) {\n        gcode += m_writer.set_jerk_xy(m_config.default_jerk.value);\n      }\n","numLines":22,"startLine":4780,"totalLines":8265}},"sourceToolAssistantUUID":"8ffc4c3f-b978-4c4d-aded-6346b23cea5d","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"userType":"external","entrypoint":"claude-desktop","cwd":"C:\\src\\JusPrin","sessionId":"06cfc08f-7504-4961-807f-e1d5fa2ffb14","version":"2.1.304","gitBranch":"jusprin-newui","slug":"jaunty-wobbling-gosling"}
