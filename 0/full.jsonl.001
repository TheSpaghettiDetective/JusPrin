st OrcaImportItem& other) {\n            return &other != &item && other.kind == item.kind && other.name == item.base;\n        });\n        if (!item.base.empty() && !in_batch && !catalog.has_base(item.kind, item.base)) {\n            item.outcome = OrcaImportItem::Outcome::NotImported;\n            item.reason  = OrcaImportItem::Reason::MissingBase;\n            continue;\n        }\n        if (!catalog.has(item.kind, item.name))\n            continue;\n\n        int         number  = 1;\n        std::string renamed = copy_name(item.name, number);\n        while (catalog.has(item.kind, renamed) || taken.count({item.kind, renamed}) != 0)\n            renamed = copy_name(item.name, ++number);\n        taken.insert({item.kind, renamed});\n        json[\"name\"]                    = renamed;\n        json[settings_id_key(item.kind)] = renamed;\n71:    catalog.has      = [](Kind kind, const std::string& name) { return kind == Kind::Printer && name == \"Shop X1C\"; };\n73:    catalog.inherits = [](Kind, const std::string&) { return std::string(\"Bambu Lab P1S 0.4 nozzle\"); };\n74:    catalog.has_base = [&](Kind, const std::string& base) {\n136:    catalog.has      = [](Kind, const std::string& name) { return name == \"My PLA\" || name == \"My PLA (Orca copy)\"; };\n137:    catalog.inherits = [](Kind, const std::string&) { return std::string(\"Generic PLA @System\"); };\n138:    catalog.has_base = [](Kind, const std::string& name) { return name == \"Generic PLA @System\"; };\n173:    catalog.has      = [&](Kind kind, const std::string& name) { return jusprin.count({kind, name}) != 0; };\n174:    catalog.inherits = [&](Kind kind, const std::string& name) { return jusprin.at({kind, name}); };\n175:    catalog.has_base = [](Kind, const std::string&) { return true; };","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"sandboxed":false,"sourceToolAssistantUUID":"7c8d40d0-94c4-4509-85a4-c013f34d6fcc","permissionDecision":{"decision":"accept","source"