{"type":"api-request-blob","sessionId":"e7286644-9c40-4163-89b2-1b9685541258","hash":"481217ef5d4637c9e9f5cf40f1b81a8da77f7f616328a2cee54f652cb056df52","message":{"role":"user","content":[{"tool_use_id":"toolu_01V1JdhjDumfLUua5nzXCUYp","type":"tool_result","content":"335:    case 'tool_activity': {\n336-      const activity = payload.activity as ToolActivityInfo;\n337-      const index = state.toolActivities.findIndex((a) => a.actionId === activity.actionId);\n338-      const toolActivities =\n339-        index < 0\n340-          ? [...state.toolActivities, activity]\n341-          : state.toolActivities.map((a, i) => (i === index ? activity : a));\n342-      return { ...state, toolActivities };\n343-    }\n344-    case 'attachment_updated': {\n345-      const attachment = payload.attachment as AttachmentInfo;\n346-      const index = state.attachments.findIndex((a) => a.id === attachment.id);\n347-      const attachments =\n                {\"title\", activity.title},\n                {\"arguments\", parsed_or_object(activity.arguments_json)},\n                {\"actionClass\", action_class_name(activity.action_class)},\n                {\"sessionId\", std::to_string(activity.session)},\n                {\"expectedRevision\", activity.expected_revision},\n                {\"state\", tool_state_name(activity.state)},\n                {\"progress\", json{{\"current\", activity.progress_current}, {\"total\", activity.progress_total}}}};\n    if (!activity.result_json.empty())\n        result[\"result\"] = parsed_or_object(activity.result_json);\n    if (activity.error)\n        result[\"error\"] = json{{\"code\", activity.error->code}, {\"message\", activity.error->message},\n                                {\"details\", json::parse(activity.error->details_json)}};\n    if (!activity.proposal_json.empty())\n        result[\"proposal\"] = parsed_or_object(activity.proposal_json);\n    if (!activity.approves.empty())\n        result[\"approves\"] = activity.approves;\n    return result;\n}\n\njson statistics_json(const SliceStatistics& statistics)\n{","is_error":false}]}}
