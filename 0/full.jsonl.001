{"parentUuid":"86890424-e19c-4117-b54f-a0ab6cb4ed60","isSidechain":false,"promptId":"4fcc31c2-3e80-420b-a5c6-f7cbf63689ec","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01En7aVGTLyNrATwqs1S3LaE","type":"tool_result","content":"        config->save();\n    }\n}\n\nstd::string OrcaHomeBackend::import_orca_printers()\n{\n    OrcaProfileSource source = detect_orca_profiles(m_picked_orca, [this]() -> const auto& { return profile_catalog(); });\n    if (!source.has_printers())\n        return utf8(_L(\"JusPrin found no OrcaSlicer printers to bring. Start fresh instead.\"));\n    m_orca_selected = source.selected;\n    m_import_result = bring_orca_items(std::move(source.ticked), source.presets.files);\n    return {};\n}\n\nstd::vector<OrcaImportItem> OrcaHomeBackend::bring_orca_items(std::vector<OrcaImportItem> ticked, const std::vector<std::string>& files)\n{\n    // Whichever kind holds OrcaSlicer's selected printer goes last, so its\n    // selection is the one left. Otherwise the saved presets go last: the\n    // first of them is the first printer the result lists.\n    const bool selected_ticked = std::any_of(ticked.begin(), ticked.end(),\n                                             [this](const OrcaImportItem& item) { return item.name == m_orca_selected; });\n    if (!selected_ticked)\n        install_ticked_printers(ticked, m_orca_selected);\n    std::vector<OrcaImportItem> items = import_orca_files(files, m_orca_selected);\n    if (selected_ticked)\n        install_ticked_printers(ticked, m_orca_selected);\n    items.insert(items.end(), std::make_move_iterator(ticked.begin()), std::make_move_iterator(ticked.end()));\n    return items;\n}\n\nvoid OrcaHomeBackend::retry_orca_import()\n{\n    if (!m_import_result)\n        throw std::logic_error(\"Home retried an OrcaSlicer import with no result on screen\");\n    // A failed ticked printer is installed again; a failed file is imported again.\n    std::vector<OrcaImportItem> ticked;\n    std::vector<std::string>    failed;\n    for (const OrcaImportItem& item : *m_import_result)\n        if (item.outcome == OrcaImportItem::Outcome::NotImported) {\n            if (item.vendor.empty())\n                failed.push_back(item.source);\n            else\n                ticked.push_back(item);\n        }\n    // The printer the first try selected stays selected, unless this try\n    // brings OrcaSlicer's selected printer: retrying installs and selects\n    // printers on its way.\n    const auto imported_printer = [](const OrcaImportItem& item) {\n        return item.kind == OrcaImportItem::Kind::Printer && item.outcome == OrcaImportItem::Outcome::Imported;\n    };\n    const bool        had_printer = std::any_of(m_import_result->begin(), m_import_result->end(), imported_printer);\n    const std::string kept        = wxGetApp().preset_bundle->printers.get_selected_preset_name();\n    // Each failed item is replaced by its new outcome, in place.\n    // bring_orca_items lists the files' items before the ticked ones.\n    std::vector<OrcaImportItem> again = bring_orca_items(std::move(ticked), failed);\n    const bool brought_selected = std::any_of(again.begin(), again.end(), [&](const OrcaImportItem& item) {\n        return imported_printer(item) && item.name == m_orca_selected;\n    });\n    if (had_printer && !brought_selected)\n        SetupCommands::select_printer_preset(*wxGetApp().plater(), kept);\n    auto next_file   = again.begin();\n    auto next_ticked = again.begin() + std::ptrdiff_t(failed.size());\n    for (OrcaImportItem& item : *m_import_result)\n        if (item.outcome == OrcaImportItem::Outcome::NotImported)\n            item = item.vendor.empty() ? std::move(*next_file++) : std::move(*next_ticked++);\n}\n\nvoid OrcaHomeBackend::finish_orca_import()\n{\n    if (!m_import_result)\n        throw std::logic_error(\"Home continued from an OrcaSlicer import with no result on screen\");\n    const bool brought_printer = std::any_of(m_import_result->begin(), m_import_result->end(), [](const OrcaImportItem& item) {\n        return item.kind == OrcaImportItem::Kind::Printer && item.outcome == OrcaImportItem::Outcome::Imported;\n    });\n    m_import_result.reset();\n    // Nothing to print with yet: the add-printer form.\n    if (!brought_printer)\n        start_fresh();\n}\n\nstd::string OrcaHomeBackend::choose_orca_folder()\n{\n    wxDirDialog dialog(&m_frame, _L(\"Choose your OrcaSlicer folder\"), wxEmptyString, wxDD_DEFAULT_STYLE | wxDD_DIR_MUST_EXIST);\n    if (dialog.ShowModal() != wxID_OK)\n        return {};\n    const std::filesystem::path picked = std::filesystem::u8path(utf8(dialog.GetPath()));\n    if (!detect_orca_profiles(picked, [this]() -> const auto& { return profile_catalog(); }).has_printers())\n        return utf8(_L(\"JusPrin found no OrcaSlicer printers in that folder.\"));\n    m_picked_orca = picked;\n    OnboardingProgress progress = onboarding_progress();\n    progress.fresh_start        = false;\n    save_onboarding(progress);\n    return {};\n}\n\nconst PrinterSetup::PrinterCatalog& OrcaHomeBackend::profile_catalog()\n{\n    if (!m_profile_catalog)\n        m_profile_catalog = std::make_shared<const PrinterSetup::PrinterCatalog>(PrinterSetup::PrinterCatalog::load(Slic3r::resources_dir()));\n    return *m_profile_catalog;\n}\n\nvoid OrcaHomeBackend::install_ticked_printers(std::vector<OrcaImportItem>& items, const std::string& preferred)\n{\n    Plater* plater = wxGetApp().plater();\n    if (plater == nullptr)\n        throw std::logic_error(\"Home installed printers before the app finished starting\");\n    if (items.empty())\n        return;\n    bool installed = false;\n    // Each printer is saved under its model's name as it is installed, two\n    // nozzles of one model as two printers, and the last one saved stays\n    // selected: the preferred one, otherwise the first, goes last.\n    std::vector<OrcaImportItem*> order;\n    for (OrcaImportItem& item : items)\n        order.push_back(&item);\n    const auto kept = std::find_if(order.begin(), order.end(), [&](const OrcaImportItem* item) { return item->name == preferred; });\n    std::rotate(order.begin(), kept == order.end() ? order.begin() + 1 : kept + 1, order.end());\n    for (OrcaImportItem* entry : order) {\n        OrcaImportItem& item = *entry;\n        const std::vector<PrinterSetup::PrinterCandidate>& candidates = profile_catalog().candidates();\n        const auto profile = std::find_if(candidates.begin(), candidates.end(), [&item](const PrinterSetup::PrinterCandidate& candidate) {\n            return candidate.vendor_id == item.vendor && candidate.model_id == item.model && candidate.variant == item.nozzle;\n        });\n        if (profile == candidates.end())\n            throw std::logic_error(\"A printer ticked in OrcaSlicer lost its JusPrin profile between detection and import\");\n        // The reason is the generic one: installing a shipped profile fails\n        // only on a broken install, which the log describes.\n        std::string problem;\n        if (SetupCommands::install_and_select_printer(*plater, item.vendor, item.model, item.nozzle, profile->default_material, problem)) {\n            Printers::add_named_printer(*plater, item.model, {});\n            item.outcome = OrcaImportItem::Outcome::Imported;\n            item.reason  = OrcaImportItem::Reason::None;\n            installed    = true;\n        } else {\n            BOOST_LOG_TRIVIAL(error) << \"Installing \" << item.model << \" from OrcaSlicer's printer list failed: \" << problem;\n            item.outcome = OrcaImportItem::Outcome::NotImported;\n            item.reason  = OrcaImportItem::Reason::NotLoaded;\n        }\n    }\n    if (installed)\n        printer_chosen();\n}\n\nstd::vector<OrcaImportItem> OrcaHomeBackend::import_orca_files(const std::vector<std::string>& files, const std::string& preferred)\n{\n    namespace fs = std::filesystem;\n    PresetBundle* presets = wxGetApp().preset_bundle;\n    AppConfig* config     = wxGetApp().app_config;\n    Plater* plater        = wxGetApp().plater();\n    if (presets == nullptr || config == nullptr || plater == nullptr)\n        throw std::logic_error(\"Home imported printers before the app finished starting\");\n\n    // A saved printer imports only once its base profile is loaded, and\n    // JusPrin loads a vendor's profiles only once one of its printers is\n    // installed, which on a fresh install none is. So each base JusPrin has\n    // a profile for is installed first, as OrcaSlicer had it. A base that\n    // fails to install stays missing, and its printer's line says so.\n    for (const std::string& base : orca_printer_bases(files)) {\n        if (presets->printers.find_preset2(base, true) != nullptr)\n            continue;\n        const std::vector<PrinterSetup::PrinterCandidate>& candidates = profile_catalog().candidates();\n        const auto profile = std::find_if(candidates.begin(), candidates.end(),\n                                          [&base](const PrinterSetup::PrinterCandidate& candidate) { return candidate.preset_name == base; });\n        if (profile == candidates.end())\n            continue;\n        std::string problem;\n        if (!SetupCommands::install_and_select_printer(*plater, profile->vendor_id, profile->model_id, profile->variant,\n                                                       profile->default_material, problem))\n            BOOST_LOG_TRIVIAL(error) << \"Installing \" << base << \", the base of a saved OrcaSlicer printer, failed: \" << problem;\n    }\n\n    OrcaImportCatalog catalog;\n    catalog.has = [presets](OrcaImportItem::Kind kind, const std::string& name) {\n        return preset_collection(*presets, kind).find_preset(name, false) != nullptr;\n    };\n    catalog.has_base = [presets](OrcaImportItem::Kind kind, const std::string& base) {\n        return preset_collection(*presets, kind).find_preset2(base, true) != nullptr;\n    };\n    // Renamed copies live here only until import_presets has copied them.\n    const fs::path staging = fs::temp_directory_path() / (\"jusprin-orca-import-\" + std::to_string(wxGetProcessId()));\n    fs::remove_all(staging);\n    fs::create_directories(staging);\n    std::vector<OrcaImportItem> items = plan_orca_import(files, catalog, staging);\n\n    std::vector<std::string> pending;\n    for (const OrcaImportItem& item : items)\n        if (item.outcome == OrcaImportItem::Outcome::Pending)\n            pending.push_back(item.file);\n    if (!pending.empty()) {\n        // Every taken name was renamed above, so import_presets has nothing\n        // to ask. Were it asked, the answer is no and that item says it was\n        // not imported.\n        presets->import_presets(pending, [](const std::string&) { return 0; }, ForwardCompatibilitySubstitutionRule::Enable,\n                                *config);\n        wxGetApp().load_current_presets();\n        presets->update_compatible(PresetSelectCompatibleType::Always);\n        m_frame.update_side_preset_ui();\n    }\n    // import_presets leaves in `pending` what it imported.\n    settle_orca_import(items, pending);\n    fs::remove_all(staging);\n\n    const auto is_printer = [](const OrcaImportItem& item) {\n        return item.kind == OrcaImportItem::Kind::Printer && item.outcome == OrcaImportItem::Outcome::Imported;\n    };\n    auto chosen = std::find_if(items.begin(), items.end(), [&](const OrcaImportItem& item) { return is_printer(item) && item.name == preferred; });\n    if (chosen == items.end())\n        chosen = std::find_if(items.begin(), items.end(), is_printer);\n    if (chosen != items.end()) {\n        SetupCommands::select_printer_preset(*plater, chosen->renamed_to.empty() ? chosen->name : chosen->renamed_to);\n        printer_chosen();\n    }\n    return items;\n}\n\nstd::vector<Snapshot::Onboarding::ImportItem> OrcaHomeBackend::import_result_lines(const std::vector<OrcaImportItem>& items)\n{\n    using Reason = Orca