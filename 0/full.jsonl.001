----------------------------\n\nPrinterInfo  current_printer();\nFilamentInfo current_filament();          // slot 1\n// Slot 1's colour as \"#RRGGBB\", or empty.\nwxString     current_colour();\n\n// Every filament slot in the project, in slot order.\nstd::vector<FilamentSlot> filament_slots();\n\n483:bool install_and_select_printer(Plater& plater, const std::string& vendor_id,\n484-                                const std::string& model_id, const std::string& variant,\n485-                                const std::string& default_filament, std::string& error)\n486-{\n487-    PresetBundle* presets = wxGetApp().preset_bundle;\n488-    AppConfig* config = wxGetApp().app_config;\n489-    if (!presets || !config || vendor_id.empty() || model_id.empty() || variant.empty()) {\n490-        error = \"Printer setup is unavailable because the preset system is not ready.\";\n491-        return false;\n492-    }\n493-    const auto old_vendors = config->vendors();\n494-    const bool had_filaments = config->has_section(AppConfig::SECTION_FILAMENTS);\n495-    const auto old_filaments = had_filaments ? config->get_section(AppConfig::SECTION_FILAMENTS)\n496-                                             : std::map<std::string, std::string>();\n497-    const std::string old_printer = presets->printers.get_selected_preset_name();\n498-    auto rollback = [&]() -> std::string {\n499-        config->set_vendors(old_vendors);\n500-        config->set_section(AppConfig::SECTION_FILAMENTS, old_filaments);\n501-        try {\n502-            presets->load_presets(*config, ForwardCompatibilitySubstitutionRule::Enable,\n503-                                  {std::string(), std::string(), std::string(), std::string()});\n504-            if (!select_printer_preset(plater, old_printer))\n505-                return \"The previous printer preset could not be selected again.\";\n506-            if (wxGetApp().mainframe) wxGetApp().mainframe->update_side_preset_ui();\n507-        } catch (const s