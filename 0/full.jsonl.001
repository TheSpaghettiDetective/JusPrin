tion::None)\n            return CommandResult::failure(WorkspaceError::UnavailableOperation, \"The All settings panel offers nothing like that\");\n281-            (patch.target.object ? overrides[patch.target.object->value()] : values)[change.key] = change.after;\n282-        for (const auto& change : applied.dependencies)\n283-            applied.warnings.push_back({change.key, \"normalized\", \"Orca normalized this dependent setting to \" + change.after + \".\"});\n284:        if (patch.persist_as) {\n285-            preset_values    = values;\n286:            applied.saved_as = *patch.persist_as;\n287-        }\n288-        applied.preset_dirty = values != preset_values;\n289-        return CommandResult::success();\n290-    }\n291-\n292-    std::vector<SettingDefinition> definitions, filament_definitions, printer_definitions;\n293-    std::map<std::string, std::string> values, preset_values;\n294-    std::map<std::uint64_t, std::map<std::string, std::string>> overrides;\n295-    std::map<std::string, FakePreset> filaments, printers;\n296-    std::string selected_filament{\"Fixture PLA\"}, selected_printer{\"Fixture printer\"};\n297-    std::vector<std::string> filament_slots{\"Fixture PLA\", \"Fixture PETG\"};\n298-\n299-private:\n300-    const std::vector<SettingDefinition>& scope_definitions(SettingsScope scope) const\n301-    {\n302-        return scope == SettingsScope::Filament ? filament_definitions : scope == SettingsScope::Printer ? printer_definitions : definitions;\n303-    }\n304-\n305-    static SettingDefinition definition_of(std::string key, std::string type, std::string label, SettingsScope scope,\n306-                                           std::optional<double> min = {}, std::optional<double> max = {}, std::string unit = {})\n307-    {\n308-        const bool writable = writable_setting(key);\n309-        return {std::move(key), std::move(type), label, scope_name(scope), label, std::move(unit), min, max, {}, {}, writable};\n310-    }\n311-\n