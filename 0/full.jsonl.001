g != send.svg\r\nsettings.svg != settings.svg\r\nsliders.svg != sliders-horizontal.svg\r\ntriangle-alert.svg != triangle-alert.svg\r\nundo-dot.svg != undo-dot.svg\r\nupload.svg != upload.svg\r\nx.svg != x.svg\r\nLUCIDE-LICENSE.txt != LICENSE\r\n456:.jp-icon-info { -webkit-mask-image: url('@resources/jusprin/ui/icons/info.svg'); mask-image: url('@resources/jusprin/ui/icons/info.svg'); }","is_error":false}]}}
