ent/AgentProtocol.hpp:209:    bool                      file_report_card{false};\nAgent/ProjectStateDocument.cpp:106:    if (!message.file_report.empty()) {\nAgent/ProjectStateDocument.cpp:107:        entry[\"fileReport\"]     = message.file_report;\nAgent/ProjectStateDocument.cpp:108:        entry[\"fileReportCard\"] = message.file_report_card;\nAgent/ProjectStateDocument.cpp:138:    message.file_report      = entry.value(\"fileReport\", \"\");\nAgent/ProjectStateDocument.cpp:139:    message.file_report_card = entry.value(\"fileReportCard\", false);","is_error":false}]}}
