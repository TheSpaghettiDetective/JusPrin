ol([text('body-small', expiry), cta], 12) + '</div>')\",\n    \"            + f'<div style=\\\"{BOX}align-self:stretch;flex:1 1 auto\\\"></div>' + col([text('body-small', expiry)] + list(choices) + [cta], 12) + '</div>')\")\nrep(\"    pack = launch_card(PACK, '$10', 'once', '500', '1,000 credits', '', 'These credits never expire.', buy('Buy a credit pack'))\",\n    \"    pack = launch_card(PACK, '$10', 'once', '500', '1,000 credits', '', 'These credits never expire.', buy('Buy a credit pack'),\\n                       pack_choices(state == 'hobby') if signed_in else ())\")\nrep(\"            prefs_row('1,122 credits left', 'Expiring credits are used first.', [link('Buy a credit pack')]),\",\n    \"            prefs_row('1,122 credits left', 'Expiring credits are used first.', [link('Buy a credit pack')]),\\n\"\n    \"            prefs_row('Auto-reload is on', 'Buys a credit pack ($10, 1,000 credits during the launch) whenever you drop below 50 credits.', [secondary('Change'), secondary('Turn off')]),\")\nrep(\"text('label', USED_FIRST, '--text-secondary'), alert_group(), delete_group()], 24, name='Account')\", \"text('label', USED_FIRST, '--text-secondary'), delete_group()], 24, name='Account')\")\nrep(\"account_row_signed_in(), card, alert_group(), delete_group()], 24, name='Account')\", \"account_row_signed_in(), card, delete_group()], 24, name='Account')\")\nrep(\"a bar per kind of credit, the savings-alert switch, Delete account.\", \"a bar per kind of credit, Delete account.\")\nrep(\"('Credits and plans', 'Credit pack, Hobby and Workshop with dollar prices, the launch offer, Obico’s discount.'),\",\n    \"('Credits and plans', 'Credit pack, Hobby and Workshop with dollar prices, the launch offer, Obico’s discount; on the Credit pack, auto-reload and the savings-alert choice.'),\")\nrep(\"Chargebee’s portal for payment method and invoices, credits used per day and per chat.'),\",\n    \"Chargebee’s portal for payment method and invoices, auto-reload, credits us