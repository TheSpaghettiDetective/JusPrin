he browser or an email that stays in the app,","+// each step of either, and who signed in. Signing up and signing in are","+// the same door: an address with no account gets one from its first code.","+// Returns the words and controls only; the caller frames them.","+export function SignInDoor({ onboarding, onAction, offer }: { onboarding: OnboardingState; onAction: Action; offer?: boolean }) {","   // The address typed at rest, kept for \"Change email\".","   const [address, setAddress] = useState('');","   const addressField = useRef<HTMLInputElement>(null);"]},{"oldStart":204,"oldLines":7,"newStart":228,"newLines":7,"lines":["       <>","         <p className=\"onboarding-door-title onboarding-waiting\">","           <span className=\"onboarding-spinner\" aria-hidden=\"true\" />","-          Finish signing in in your browser.","+          Finish in your browser.","         </p>","         <p className=\"onboarding-door-detail\">The app continues on its own once the browser is done.</p>","         <p className=\"onboarding-door-note\">"]},{"oldStart":228,"oldLines":21,"newStart":252,"newLines":18,"lines":["       </>","     );","   }","-  if (onboarding.accountEmail) {","-    const total = onboarding.account?.credits.total;","-    return (","-      <p className=\"onboarding-door-title\" role=\"status\">","-        Signed in as {onboarding.accountEmail}","-        {total !== undefined && ` · ${creditCount(total)}`}","-      </p>","-    );","-  }","+  if (onboarding.accountEmail) return <SignedIn onboarding={onboarding} />;","   // At rest.","+  const sendEmail = () => {","+    const typed = address.trim();","+    if (typed) onAction('onboarding_sign_in_email', { email: typed });","+    else addressField.current?.focus();","+  };","   return (","     <>","-      {title && <p className=\"onboarding-door-title\">{title}</p>}","-      {title && <p className=\"onboarding-door-detail\">An Expert message is 5 credits. Your own API key stays free.</p>}","-      {title && onboarding.v1Imported && (","+      {offer && <p className=\"onboarding-door-title\">{SIGNUP_OFFER}</p>}","+      {offer && <p className=\"onboarding-door-detail\">{SIGNUP_SCALE}</p>}","+      {offer && onboarding.v1Imported && (","         <p className=\"onboarding-door-detail\">Subscribed to JusPrin v1? You get these 500 credits and keep your original price.</p>","       )}","       <button type=\"button\" className=\"button-secondary onboarding-google\""]},{"oldStart":253,"oldLines":16,"newStart":274,"newLines":19,"lines":["       <p className=\"onboarding-or\"><span>or</span></p>","       <form className=\"onboarding-email-row\" onSubmit={(event) => {","         event.preventDefault();","-        const typed = address.trim();","-        if (typed) onAction('onboarding_sign_in_email', { email: typed });","+        sendEmail();","       }}>","         <input ref={addressField} className=\"onboarding-field\" type=\"email\" placeholder=\"you@example.com\" autoComplete=\"email\"","           aria-label=\"Email\" value={address} onChange={(event) => setAddress(event.target.value)} />","-        <button type=\"submit\" className=\"button-primary\" disabled={!address.trim()}>Continue with email</button>","+        <button type=\"submit\" className=\"button-primary\" disabled={!address.trim()}>Sign up free</button>","       </form>","-      <p className=\"onboarding-door-note\">New or existing account, same door. Google opens your browser; email stays here.</p>","       <p className=\"onboarding-door-note\">","-        By signing in you agree to the{' '}","+        Already have an account?{' '}","+        <button type=\"button\" className=\"onboarding-link inline\" onClick={sendEmail}>Sign in</button>","+      </p>","+      <p className=\"onboarding-door-note\">Google opens your browser; email stays here.</p>","+      <p className=\"onboarding-door-note\">","+        By continuing you agree to the{' '}","         <button type=\"button\" className=\"onboarding-link inline\" onClick={() => onAction('onboarding_open_link', { link: 'terms' })}>","           Terms","         </button>{' '}"]},{"oldStart":277,"oldLines":20,"newStart":301,"newLines":14,"lines":["   );"," }"," ","-// The two free doors: each opens Preferences › Agent, and closes back here.","-export function FreeDoors({ onAction, disabled }: { onAction: Action; disabled: boolean }) {","-  const door = (which: 'key' | 'tool', name: string, cost: string) => (","-    <button type=\"button\" className=\"onboarding-door\" disabled={disabled}","-      onClick={() => onAction('onboarding_open_preferences', { door: which })}>","-      <span className=\"onboarding-door-name\">{name}</span>","-      <span className=\"onboarding-door-cost\">{cost}</span>","-    </button>","-  );","+// The agent on the person's own AI account, an API key or Claude Code and","+// Claude Desktop: Preferences › Agent explains both, and closes back here.","+export function OwnAccountDoor({ onAction, disabled }: { onAction: Action; disabled: boolean }) {","   return (","-    <>","-      {door('key', 'Your own API key', 'Free')}","-      {door('tool', 'Claude Code or Claude Desktop', 'Free · MCP server')}","-    </>","+    <button type=\"button\" className=\"onboarding-link flush\" disabled={disabled}","+      onClick={() => onAction('onboarding_open_preferences', { door: 'key' })}>","+      Use your own AI account instead","+    </button>","   );"," }"," "]},{"oldStart":337,"oldLines":9,"newStart":355,"newLines":9,"lines":["             </p>","           </div>","           <div className=\"onboarding-doors\">","-            <p className=\"onboarding-doors-label\">Pick how the agent should think. Change it any time in Preferences › Agent.</p>","+            <p className=\"onboarding-doors-label\">Sign up to use the AI agent, or skip it and just slice.</p>","             <div className=\"onboarding-offer\">","-              <SignInDoor onboarding={onboarding} onAction={onAction} title=\"Your first month: 500 credits\" />","+              <SignInDoor onboarding={onboarding} onAction={onAction} offer />","               {signedIn && !waited.current && (","                 <button type=\"button\" className=\"button-primary onboarding-door-button\"","                   onClick={() => onAction('onboarding_leave_welcome')}>"]},{"oldStart":347,"oldLines":7,"newStart":365,"newLines":7,"lines":["                 </button>","               )}","             </div>","-            <FreeDoors onAction={onAction} disabled={checking || (signedIn && waited.current)} />","+            <OwnAccountDoor onAction={onAction} disabled={checking || (signedIn && waited.current)} />","             <button type=\"button\" className=\"onboarding-link flush\" disabled={checking || (signedIn && waited.current)}","               onClick={() => onAction('onboarding_leave_welcome')}>","               Just slice for now"]},{"oldStart":363,"oldLines":9,"newStart":381,"newLines":19,"lines":[" // who signed in, or whose key the agent uses. Nothing after \"Just slice for"," // now\"."," function WelcomeDone({ onboarding }: { onboarding: OnboardingState }) {","-  const total = onboarding.account?.credits.total;","-  const text = onboarding.accountEmail","-    ? `Signed in as ${onboarding.accountEmail}${total !== undefined ? ` · ${creditCount(total)}` : ''}`","+  const { account, accountEmail } = onboarding;","+  if (accountEmail && account) {","+    return (","+      <div className=\"onboarding-done\">","+        <CheckGlyph />","+        <span className=\"onboarding-done-text\">","+          <span>{signedInCredits(account)}</span>","+          <span className=\"onboarding-done-detail\">Signed in as {accountEmail}</span>","+        </span>","+      </div>","+    );","+  }","+  const text = accountEmail ? `Signed in as ${accountEmail}`","     : onboarding.agentKeyProvider ? `The agent uses your ${onboarding.agentKeyProvider} key` : '';","   if (!text) return null;","   return <p className=\"onboarding-done\"><CheckGlyph />{text}</p>;"]},{"oldStart":377,"oldLines":16,"newStart":405,"newLines":32,"lines":[" function useBusy(onAction: Action, onboarding: OnboardingState) {","   const [busy, setBusy] = useState(false);","   useEffect(() => setBusy(false), [onboarding]);","-  const run = (type: string) => {","+  const run = (type: string, payload?: object) => {","     setBusy(true);","-    afterPaint(() => onAction(type));","+    afterPaint(() => onAction(type, payload));","   };","   return [busy, run] as const;"," }"," ","+// The printer JusPrin selects once the import is done, as the importer","+// picks it: OrcaSlicer's own, while it is ticked, otherwise the first ticked.","+function startsWith(orca: OnboardingState['orca'], chosen: string[]): string {","+  const ticked = orca.printers.filter((name) => chosen.includes(name));","+  if (ticked.length === 0) return '';","+  if (ticked.includes(orca.selected)) return `JusPrin starts with ${orca.selected}, the printer OrcaSlicer had selected.`;","+  return `JusPrin starts with ${ticked[0]}.`;","+}","+"," function OrcaImport({ onboarding, error, onAction }: Props) {","   const { orca } = onboarding;","   const [busy, run] = useBusy(onAction, onboarding);","+  // Every printer starts ticked; only the ticked ones are imported.","+  const [chosen, setChosen] = useState(orca.printers);","+  const listed = orca.printers.join('\\n');","+  useEffect(() => setChosen(orca.printers), [listed]);","+  const choose = (name: string, ticked: boolean) =>","+    setChosen((now) => (ticked ? [...now, name] : now.filter((one) => one !== name)));","+  const starts = startsWith(orca, chosen);","   return (","     <div className=\"onboarding-step\">","       <WelcomeDone onboarding={onboarding} />"]},{"oldStart":396,"oldLines":19,"newStart":440,"newLines":26,"lines":["           JusPrin copies these printers with their filaments, settings and printer connections. OrcaSlicer keeps its own copy.","         </p>","       </div>","-      <OrcaPrinterList printers={orca.printers.map((name) => ({ name, already: false }))} />","-      <p className=\"onboarding-source\">","-        <FolderGlyph />","-        <span className=\"onboarding-source-path\">{orca.source}</span>","-        {orca.filamentCount > 0 && <span>· {orca.filamentCount === 1 ? '1 filament' : `${orca.filamentCount} filaments`}</span>}","-      </p>","+      <OrcaPrinterList printers={orca.printers.map((name) => ({ name, already: false }))} chosen={chosen} onChoose={choose}","+        disabled={busy} />","+      <div className=\"onboarding-source\">","+        {orca.filamentCount > 0 && (","+          <p>Also brings {orca.filamentCount === 1 ? '1 filament' : `${orca.filamentCount} filaments`}.</p>","+        )}","+        <p className=\"onboarding-source-folder\">","+          <FolderGlyph />","+          <span className=\"onboarding-source-path\">{orca.source}</span>","+        </p>","+      </div>","+      {starts && <p className=\"onboarding-lead\">{starts}</p>}","       {error && <p className=\"onboarding-error\" role=\"alert\">{error}</p>}","       <div className=\"onboarding-actions\">","-        <button type=\"button\" className=\"button-primary\" disabled={busy} onClick={() => run('onboarding_import')}>","+        <button type=\"button\" className=\"button-primary\" disabled={busy || chosen.length === 0}","+          onClick={() => run('onboarding_import', { printers: chosen })}>","           {busy ? 'Importing…' : 'Import'}","         </button>","         <button type=\"button\" className=\"button-secondary\" disabled={busy} onClick={() => onAction('onboarding_start_fresh')}>","-          Start fresh","+          Choose my printer instead","         </button>","       </div>","       <button type=\"button\" className=\"onboarding-link flush\" disabled={busy} onClick={() => onAction('onboarding_back')}>Back</button>"]},{"oldStart":418,"oldLines":13,"newStart":469,"newLines":13,"lines":[" "," function ImportResult({ onboarding, error, onAction }: Props) {","   const items = onboarding.orca.importResult ?? [];","-  const failed = items.some((item) => !item.imported);","+  // Only a failure that can go another way is offered again.","+  const retryable = items.some((item) => item.retryable);","   const [busy, run] = useBusy(onAction, onboarding);","   return (","     <div className=\"onboarding-step\">","       <div className=\"onboarding-heading\">","-        <h1>{failed ? 'Some settings need attention' : 'Imported from OrcaSlicer'}</h1>","-        <p className=\"onboarding-lead\">OrcaSlicer’s own files were not changed.</p>","+        <h1>Imported from OrcaSlicer</h1>","       </div>","       <OrcaImportResultLines lines={items} />","       {error && <p className=\"onboarding-error\" role=\"alert\">{error}</p>}"]},{"oldStart":432,"oldLines":7,"newStart":483,"newLines":7,"lines":["         <button type=\"button\" className=\"button-primary\" disabled={busy} onClick={() => onAction('onboarding_import_continue')}>","           Continue","         </button>","-        {failed && (","+        {retryable && (","           <button type=\"button\" className=\"button-secondary\" disabled={busy} onClick={() => run('onboarding_import_retry')}>","             {busy ? 'Importing…' : 'Retry failed items'}","           </button>"]},{"oldStart":482,"oldLines":6,"newStart":533,"newLines":7,"lines":["       </div>","       {form ? (","         <PrinterPickerHost form={form} pick={pick} onPick={setPick}","+          reading={Boolean(form.loading && catalogId && nozzle !== undefined)}","           onAskAgent={agentReady ? () => onAction('onboarding_ask_agent') : undefined} />","       ) : (","         <p className=\"onboarding-lead\" role=\"status\">Reading the printer list…</p>"]},{"oldStart":494,"oldLines":16,"newStart":546,"newLines":8,"lines":["           <button type=\"button\" className=\"button-primary\" disabled={!ready || finishing} onClick={finish}>Continue</button>","           <button type=\"button\" className=\"onboarding-link\" onClick={() => onAction('onboarding_assume_default')}>Skip for now</button>","         </div>","-        <p className=\"onboarding-note\">Skip, and JusPrin slices for a generic 0.4 mm printer until you add yours.</p>","+        <p className=\"onboarding-note\">{STAND_IN_PRINTER}</p>","       </div>","-      {!onboarding.orca.found && (","-        <p className=\"onboarding-aside\">","-          OrcaSlicer printers in another folder?{' '}","-          <button type=\"button\" className=\"onboarding-link inline\" onClick={() => onAction('onboarding_choose_orca_folder')}>","-            Choose the folder…","-          </button>","-        </p>","-      )}","       <button type=\"button\" className=\"onboarding-link flush\" onClick={() => onAction('onboarding_back')}>Back</button>","     </div>","   );"]}]}],"moreFiles":0,"changedFiles":["/Users/kenneth/Projects/JusPrin/.claude/worktrees/first-run-flow-f7be35/src/slic3r/GUI/JusPrin/HomeUI/src/components/Onboarding.tsx"]}},"sandboxed":false,"sourceToolAssistantUUID":"1aad298f-4d3c-4ed0-85ff-e8acd79b960d","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"userType":"external","entrypoint":"claude-desktop","cwd":"/Users/kenneth/Projects/JusPrin/.claude/worktrees/first-run-flow-f7be35/src/slic3r/GUI/JusPrin","sessionId":"c868826d-3950-4f0f-9ecd-4a549cdd6983","version":"2.1.309","gitBranch":"claude/first-run-fixes","slug":"dapper-knitting-moler"}
