Ender-3 V2 Neo 0.4 nozzle\", \"Qidi X-Plus 4 0.4 nozzle\"});","     CHECK(orca_printer_bases({}).empty());"," }","+","+TEST_CASE(\"an orca import brings only the printers the person left chosen, and every filament and process\",","+          \"[home][onboarding][orca_import]\")","+{","+    TempFolder orca;","+    const fs::path account = orca.path / \"user\" / \"default\";","+    preset(account / \"machine\" / \"My X1C.json\", printer(\"My X1C\"));","+    preset(account / \"machine\" / \"Old Voron.json\", printer(\"Old Voron\", \"Voron 0.1\"));","+    const std::string pla  = write(account / \"filament\" / \"My PLA.json\", \"{}\");","+    const std::string fine = write(account / \"process\" / \"Fine.json\", \"{}\");","+    const OrcaPresetFiles presets = scan_orca_presets(account);","+    REQUIRE(presets.printers == std::vector<std::string>{\"My X1C\", \"Old Voron\"});","+","+    OrcaImportItem a1;","+    a1.name   = \"Bambu Lab A1 mini 0.4 nozzle\";","+    a1.vendor = \"BBL\";","+    OrcaImportItem p1s = a1;","+    p1s.name           = \"Bambu Lab P1S 0.4 nozzle\";","+    const std::vector<OrcaImportItem> profiles{a1, p1s};","+","+    SECTION(\"every printer chosen\")","+    {","+        const OrcaImportChoice choice =","+            orca_import_chosen(presets, profiles, {\"My X1C\", \"Old Voron\", \"Bambu Lab A1 mini 0.4 nozzle\", \"Bambu Lab P1S 0.4 nozzle\"});","+        CHECK(choice.files == presets.files);","+        CHECK(choice.profile_printers.size() == 2);","+    }","+    SECTION(\"one saved printer and one profile printer left out\")","+    {","+        const OrcaImportChoice choice = orca_import_chosen(presets, profiles, {\"My X1C\", \"Bambu Lab P1S 0.4 nozzle\"});","+        CHECK(choice.files == std::vector<std::string>{(account / \"machine\" / \"My X1C.json\").u8string(), pla, fine});","+        REQUIRE(choice.profile_printers.size() == 1);","+        CHECK(choice.profile_printers.front().name == \"Bambu Lab P1S 0.4 nozzle\");","+    }","+    SECTION(\"no printer chosen still brings the filaments and processes\")","+    {","+        const OrcaImportChoice choice = orca_import_chosen(presets, profiles, {});","+        CHECK(choice.files == std::vector<std::string>{pla, fine});","+        CHECK(choice.profile_printers.empty());","+    }","+}","+","+TEST_CASE(\"an orca import offers a retry only for a failure a retry can fix\", \"[home][onboarding][orca_import]\")","+{","+    const auto item = [](Outcome outcome, Reason reason) {","+        OrcaImportItem made;","+        made.outcome = outcome;","+        made.reason  = reason;","+        return made;","+    };","+    CHECK(orca_import_retryable(item(Outcome::NotImported, Reason::Unreadable)));","+    CHECK(orca_import_retryable(item(Outcome::NotImported, Reason::NotLoaded)));","+    CHECK_FALSE(orca_import_retryable(item(Outcome::NotImported, Reason::MissingBase)));","+    CHECK_FALSE(orca_import_retryable(item(Outcome::NotImported, Reason::NoVersion)));","+    CHECK_FALSE(orca_import_retryable(item(Outcome::NotImported, Reason::NotAPreset)));","+    CHECK_FALSE(orca_import_retryable(item(Outcome::Imported, Reason::None)));","+    CHECK_FALSE(orca_import_retryable(item(Outcome::AlreadyThere, Reason::None)));","+}"]}]}],"moreFiles":0,"changedFiles":["/Users/kenneth/Projects/JusPrin/.claude/worktrees/first-run-flow-f7be35/tests/jusprin/test_home_host.cpp","/Users/kenneth/Projects/JusPrin/.claude/worktrees/first-run-flow-f7be35/tests/jusprin/test_orca_import.cpp"]}},"sandboxed":false,"sourceToolAssistantUUID":"bff09751-9cfb-441c-86e4-81b272c3f3bd","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"userType":"external","entrypoint":"claude-desktop","cwd":"/Users/kenneth/Projects/JusPrin/.claude/worktrees/first-run-flow-f7be35/tests/jusprin","sessionId":"c868826d-3950-4f0f-9ecd-4a549cdd6983","version":"2.1.309","gitBranch":"claude/first-run-fixes","slug":"dapper-knitting-moler"}
