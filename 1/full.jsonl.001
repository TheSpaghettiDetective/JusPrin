generic printer’s place'\")\nend=s.index(\"});\\n\",s.index(\"toBeNull();\",start))+4\ns=s[:start]+'''  it('retries the failed items, and offers no retry when nothing failed', async () => {\n    const act = actions();\n    const failed = { kind: 'printer' as const, name: 'Old', renamedTo: '', imported: false, reason: 'the file has no version' };\n    const { rerender } = render(<OrcaImport actions={act} state={state({ screen: 'imported', result: [failed] })} />);\n    await userEvent.click(screen.getByRole('button', { name: 'Retry failed items' }));\n    expect(screen.getByRole('button', { name: 'Importing…' })).toBeDisabled();\n    expect(screen.getByRole('button', { name: 'Done' })).toBeDisabled();\n    await waitFor(() => expect(act.retry).toHaveBeenCalledTimes(1));\n    rerender(<OrcaImport actions={act} state={state({ screen: 'imported', result: [{ ...failed, imported: true }] })} />);\n    expect(screen.queryByRole('button', { name: /Retry|Importing/ })).toBeNull();\n    expect(screen.getByRole('button', { name: 'Done' })).toBeEnabled();\n  });\n'''+s[end:]\nopen(p,'w').write(s)\nEOF\ntail -5 src/components/OrcaImport.test.tsx; npx vitest run src/components/OrcaImport 2>&1 | tail -15","description":"Update the dialog tests and run them","timeout":120000},"caller":{"type":"direct"}}]}}
