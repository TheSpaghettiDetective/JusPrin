med_printer(plater, item.model, {});","-            item.outcome     = OrcaImportItem::Outcome::Imported;","-            item.reason      = OrcaImportItem::Reason::None;","+    Plater& plater = *wxGetApp().plater();","+    // Each printer is saved under its model's name as it is installed, two","+    // nozzles of one model as two printers, and the last one saved stays","+    // selected: the preferred one, otherwise the first, goes last.","+    std::vector<OrcaImportItem*> order;","+    for (OrcaImportItem& item : items)","+        if (item.outcome != OrcaImportItem::Outcome::AlreadyThere)","+            order.push_back(&item);","+    if (order.empty())","+        return;","+    const auto kept = std::find_if(order.begin(), order.end(), [&](const OrcaImportItem* item) { return item->name == preferred; });","+    std::rotate(order.begin(), kept == order.end() ? order.begin() + 1 : kept + 1, order.end());","+    for (OrcaImportItem* entry : order) {","+        OrcaImportItem& item = *entry;","+        const std::vector<PrinterSetup::PrinterCandidate>& candidates = profile_catalog().candidates();","+        const auto profile = std::find_if(candidates.begin(), candidates.end(), [&item](const PrinterSetup::PrinterCandidate& candidate) {","+            return candidate.vendor_id == item.vendor && candidate.model_id == item.model && candidate.variant == item.nozzle;","+        });","+        if (profile == candidates.end())","+            throw std::logic_error(\"A printer ticked in OrcaSlicer lost its JusPrin profile between detection and import\");","+        // The reason is the generic one: installing a shipped profile fails","+        // only on a broken install, which the log describes.","+        std::string problem;","+        if (SetupCommands::install_and_select_printer(plater, item.vendor, item.model, item.nozzle, profile->default_material, problem)) {","+            Printers::add_named_printer(plater, item.model, {});","+            item.outcome = OrcaImportItem::Outcome::Imported;","+            item.reason  = OrcaImportItem::Reason::None;","         } else {","-            BOOST_LOG_TRIVIAL(error) << \"Selecting \" << item.model << \" from OrcaSlicer's printer list failed after its profile was \"","-                                     << (installed ? \"installed\" : \"not installed\");","+            BOOST_LOG_TRIVIAL(error) << \"Installing \" << item.model << \" from OrcaSlicer's printer list failed: \" << problem;","             item.outcome = OrcaImportItem::Outcome::NotImported;","             item.reason  = OrcaImportItem::Reason::NotLoaded;","         }","     }","-    return saved;"," }"," ","-std::vector<OrcaImportItem> OrcaImporter::import_files(const std::vector<std::string>& files)","+std::vector<OrcaImportItem> OrcaImporter::import_files(const std::vector<std::string>& files, const std::string& preferred,","+                                                      Selection selection)"," {","-    PresetBundle&           presets = preset_bundle();","-    AppConfig&              config  = *wxGetApp().app_config;","-    const OrcaImportCatalog lookup  = catalog();","+    PresetBundle& presets = preset_bundle();","+    AppConfig&    config  = *wxGetApp().app_config;","+    Plater&       plater  = *wxGetApp().plater();","+    const OrcaImportCatalog lookup = catalog();","+","+    // A saved printer imports only once its base profile is loaded, and","+    // JusPrin loads a vendor's profiles only once one of its printers is","+    // installed, which on a fresh install none is. So each base JusPrin has","+    // a profile for is installed first, as OrcaSlicer had it. A base that","+    // fails to install stays missing, and its printer's line says so.","+    for (const std::string& base : orca_printer_bases(files)) {","+        const PrinterSetup::PrinterCandidate* profile = missing_base(base);","+        if (profile == nullptr)","+            continue;","+        std::string problem;","+        if (!SetupCommands::install_and_select_printer(plater, profile->vendor_id, profile->model_id, profile->variant,","+                                                       profile->default_material, problem))","+            BOOST_LOG_TRIVIAL(error) << \"Installing \" << base << \", the base of a saved OrcaSlicer printer, failed: \" << problem;","+    }"," ","     // Renamed copies live here only until import_presets has copied them.","     const fs::path staging = fs::temp_directory_path() / (\"jusprin-orca-import-\" + std::to_string(wxGetProcessId()));"]},{"oldStart":344,"oldLines":6,"newStart":288,"newLines":17,"lines":["     // import_presets leaves in `pending` what it imported.","     settle_orca_import(items, pending);","     fs::remove_all(staging);","+","+    if (selection == Selection::Kept)","+        return items;","+    const auto is_printer = [](const OrcaImportItem& item) {","+        return item.kind == OrcaImportItem::Kind::Printer && item.outcome == OrcaImportItem::Outcome::Imported;","+    };","+    auto chosen = std::find_if(items.begin(), items.end(), [&](const OrcaImportItem& item) { return is_printer(item) && item.name == preferred; });","+    if (chosen == items.end())","+        chosen = std::find_if(items.begin(), items.end(), is_printer);","+    if (chosen != items.end())","+        SetupCommands::select_printer_preset(plater, chosen->renamed_to.empty() ? chosen->name : chosen->renamed_to);","     return items;"," }"," "]}]}],"moreFiles":3,"changedFiles":["/Users/kenneth/Projects/JusPrin/.claude/worktrees/first-run-flow-f7be35/src/slic3r/GUI/JusPrin/Home/OrcaHomeBackend.cpp","/Users/kenneth/Projects/JusPrin/.claude/worktrees/first-run-flow-f7be35/src/slic3r/GUI/JusPrin/Home/OrcaHomeBackend.hpp","/Users/kenneth/Projects/JusPrin/.claude/worktrees/first-run-flow-f7be35/src/slic3r/GUI/JusPrin/Home/OrcaImportWindow.cpp","/Users/kenneth/Projects/JusPrin/.claude/worktrees/first-run-flow-f7be35/src/slic3r/GUI/JusPrin/Home/OrcaImportWindow.hpp","/Users/kenneth/Projects