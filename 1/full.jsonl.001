usprin/v2/web/cancel')\n         cancel.assert_called_once_with('sub-1', {'end_of_term': True}, env=mock.ANY)\n         self.assertEqual(response['Location'], '/ent/jusprin/v2/web/done')\n-        html = self.page(self.URL)\n+        with mock.patch('chargebee.Customer.retrieve', return_value=SimpleNamespace(card=None)):\n+            html = self.page(self.URL)\n         self.assertIn('Ends', html)\n         self.assertNotIn('Cancel plan', html)\n \n+    def test_a_card_lookup_chargebee_refuses_for_a_reason_other_than_not_found_is_ours(self):\n+        billing.record_subscription(self.user, sub(self.user, end=int((timezone.now() + timedelta(days=9)).timestamp())))\n+        refused = chargebee.APIError(401, {'message': 'authentication failed', 'type': 'invalid_request',\n+                                         'api_error_code': 'api_authentication_failed', 'error_code': 'api_authentication_failed'})\n+        with mock.patch('chargebee.Customer.retrieve', side_effect=refused), self.assertRaises(chargebee.APIError):\n+            self.client.get(self.URL)\n+\n     def test_a_yearly_plan_shows_its_price_its_next_credits_and_its_renewal(self):\n         start, end = this_year()\n         billing.record_subscription(self.user, yearly(self.user, start=start, end=end))\ndiff --git a/web_ent/jusprin/v2/tests/test_print_reports.py b/web_ent/jusprin/v2/tests/test_print_reports.py\nindex dd9e53d7e6..6dacc1ce04 100644\n--- a/web_ent/jusprin/v2/tests/test_print_reports.py\n+++ b/web_ent/jusprin/v2/tests/test_print_reports.py\n@@ -109,9 +109,12 @@ class SubmitTests(PrintReportTestCase):\n         self.assertEqual(response.json()['error']['code'], 'photo_unreadable')\n         self.assertFalse(self.stored.called)\n \n-    def test_a_bad_outcome_or_no_hash_is_invalid(self):\n-        self.assertEqual(self.report(outcome='great').status_code, 400)\n-        self.assertEqual(self.report(gcode_hash='').status_code, 400)\n+    def test_a_bad_outcome_or_no_hash_is_ours(self):\n+        # The app fills both in, so a report it sent with either wrong is ours.\n+        with self.assertRaises(ValueError):\n+            self.report(outcome='great')\n+        with self.assertRaises(ValueError):\n+            self.report(gcode_hash='')\n \n     def test_it_takes_a_token(self):\n         response = Client().post(URL, {'gcode_hash': 'h', 'outcome': 'worked', 'text': TEXT, 'photos': [jpeg()]})\ndiff --git a/web_ent/jusprin/v2/tests/test_web_link.py b/web_ent/jusprin/v2/tests/test_web_link.py\nindex 20ab06369c..2da8e5da1a 100644\n--- a/web_ent/jusprin/v2/tests/test_web_link.py\n+++ b/web_ent/jusprin/v2/tests/test_web_link.py\n@@ -50,10 +50,11 @@ class WebLinkTests(TestCase):\n         response = Client().post(URL, '{}', content_type='application/json')\n         self.assertEqual(response.json()['url'], 'http://testserver/ent/jusprin/v2/web/prices?guest=1&lang=en')\n \n-    def test_a_body_that_is_not_an_object_is_refused(self):\n-        self.assertEqual(Client().post(URL, 'nope', content_type='application/json',\n-                                       HTTP_AUTHORIZATION=f'Bearer {self.token}').status_code, 400)\n-        self.assertEqual(self.ask(['prices']).status_code, 400)\n+    def test_a_body_that_is_not_an_object_is_ours(self):\n+        with self.assertRaises(json.JSONDecodeError):\n+            Client().post(URL, 'nope', content_type='application/json', HTTP_AUTHORIZATION=f'Bearer {self.token}')\n+        with self.assertRaises(ValueError):\n+            self.ask(['prices'])\n \n     def test_the_link_signs_in_and_goes_to_the_page_with_where_the_click_was(self):\n         url = self.link({'page': 'billing', 'from': 'account'})\ndiff --git a/web_ent/jusprin/v2/views.py b/web_ent/jusprin/v2/views.py\nindex 93cc1bff4f..2d55d6c4c1 100644\n--- a/web_ent/jusprin/v2/views.py\n+++ b/web_ent/jusprin/v2/views.py\n@@ -167,12 +167,10 @@ def web_link(request):\n     user = None if signed_out else authenticate(request)\n     if user is None and not signed_out:\n         return _refuse('unauthorized', 401)\n-    try:\n-        body = json.loads(request.body or b'{}')\n-    except json.JSONDecodeError:\n-        return _refuse('invalid_request', 400)\n+    # The app writes this body, so one refused here is ours.\n+    body = json.loads(request.body or b'{}')\n     if not isinstance(body, dict):\n-        return _refuse('invalid_request', 400)\n+        raise ValueError(f'The app asked for a web link with a body of type {type(body).__name__}')\n     page = body.get('page') if body.get('page') in settings.JUSPRIN_V2_WEB_PAGES else 'prices'\n     origin = body.get('from')\n     origin = origin if isinstance(origin, str) and WEB_LINK_FROM.fullmatch(origin) else None\n@@ -262,12 +260,11 @@ def print_reports(request):\n     gcode_hash = request.POST.get('gcode_hash', '').strip()\n     outcome = request.POST.get('outcome', '')\n     text = request.POST.get('text', '').strip()\n-    try:\n-        facts = json.loads(request.POST.get('facts', '{}'))\n-    except json.JSONDecodeError:\n-        return _refuse('invalid_request', 400)\n+    # The app fills these in, so a report it sent that is refused here is ours.\n+    facts = json.loads(request.POST.get('facts', '{}'))\n     if not gcode_hash or outcome not in dict(PrintReport.OUTCOMES) or not isinstance(facts, dict):\n-        return _refuse('invalid_request', 400)\n+        raise ValueError(f'The app sent a print report with gcode_hash {gcode_hash!r}, outcome {outcome!r} '\n+                         f'and facts of type {type(facts).__name__}')\n     if len(text) < settings.JUSPRIN_V2_REPORT_MIN_TEXT:\n         return _refuse('text_too_short', 400)\n     photos = request.FILES.getlist('photos')\ndiff --git a/web_ent/jusprin/v2/tests/test_gateway.py b/web_ent/jusprin/v2/tests/test_gateway.py\nindex 3ff3c69746..74703f2e90 100644\n--- a/web_ent/jusprin/v2/tests/test_gateway.py\n+++ b/web_ent/jusprin/v2/tests/test_gateway.py\n@@ -273,5 +273,5 @@ class MessagesTests(GatewayTestCase):\n \n-    async def test_effort_the_alias_does_not_offer_is_400(self):\n+    async def test_effort_the_alias_does_not_offer_is_ours(self):\n         response = await self.post('messages', messages_body(output_config={'effort': 'high'}))\n-        self.assert_error(response, 400, 'invalid_request')\n+        self.assert_error(response, 500, 'server_error')\n         self.assertEqual(self.upstream.requests, [])\n@@ -357,6 +357,6 @@ class ResponsesTests(GatewayTestCase):\n \n-    async def test_a_cache_key_that_is_not_a_string_is_400(self):\n+    async def test_a_cache_key_that_is_not_a_string_is_ours(self):\n         for key in ('', 3, None, ['p-1']):\n-            self.assert_error(await self.post('responses', responses_body(prompt_cache_key=key)), 400,\n-                              'invalid_request')\n+            self.assert_error(await self.post('responses', responses_body(prompt_cache_key=key)), 500,\n+                              'server_error')\n         self.assertEqual(self.upstream.requests, [])\n@@ -396,5 +396,5 @@ class IdentityTests(GatewayTestCase):\n \n-    async def test_a_system_prompt_of_another_type_is_400(self):\n+    async def test_a_system_prompt_of_another_type_is_ours(self):\n         response = await self.post('messages', messages_body(system={'text': 'x'}))\n-        self.assert_error(response, 400, 'invalid_request')\n+        self.assert_error(response, 500, 'server_error')\n         self.assertEqual(self.upstream.requests, [])\n@@ -414,5 +414,5 @@ class IdentityTests(GatewayTestCase):\n \n-    async def test_instructions_of_another_type_is_400(self):\n+    async def test_instructions_of_another_type_is_ours(self):\n         response = await self.post('responses', responses_body(instructions=['x']))\n-        self.assert_error(response, 400, 'invalid_request')\n+        self.assert_error(response, 500, 'server_error')\n         self.assertEqual(self.upstream.requests, [])\n@@ -446,5 +446,5 @@ class AssignmentTests(GatewayTestCase):\n class MissingBackendTests(GatewayTestCase):\ndiff --git a/tests/jusprin/test_setup_options.cpp b/tests/jusprin/test_setup_options.cpp\nindex 0cfb9a6f60..66fa746c3a 100644\n--- a/tests/jusprin/test_setup_options.cpp\n+++ b/tests/jusprin/test_setup_options.cpp\n@@ -258,11 +258,11 @@ TEST_CASE(\"a printer whose profile turns on several plate types offers them\", \"[\n     CHECK_FALSE(options.plates.empty());\n }\n \n-TEST_CASE(\"a folder without the profiles is reported, and an unknown profile is a bug\", \"[setup-options]\")\n+TEST_CASE(\"a folder without the profiles, like an unknown profile, is a bug\", \"[setup-options]\")\n {\n-    const SetupOptions missing = load_setup_options(kProfiles + \"/nowhere\", \"Prusa\", \"Prusa MK4 0.4 nozzle\");\n-    CHECK_FALSE(missing.error.empty());\n-    CHECK(missing.filaments.empty());\n+    // The shipped profiles fail to read only on a broken install.\n+    CHECK_THROWS_WITH(load_setup_options(kProfiles + \"/nowhere\", \"Prusa\", \"Prusa MK4 0.4 nozzle\"),\n+                      Catch::Matchers::ContainsSubstring(\"shipped printer profiles of Prusa\"));\n     CHECK_THROWS_AS(load_setup_options(kProfiles, \"Prusa\", \"Prusa MK99 0.4 nozzle\"), std::logic_error);\n }\n \n+                          {500, \"sensitive upstream body\", \"network_error\", true, \"could not reach the Test Provider service\"},\n+                          {503, \"sensitive upstream body\", \"network_error\", true, \"could not reach the Test Provider service\"},\n+                          {529, \"sensitive upstream body\", \"network_error\", true, \"could not reach the Test Provider service\"}};\n     for (const Case& item : cases) {\n         CAPTURE(item.status, item.detail);\n         Harness h;\n@@ -615,7 +619,7 @@ TEST_CASE(\"HTTP failures are mapped to safe errors that name the provider\", \"[ag\n TEST_CASE(\"an answer that names nothing a person can act on stops the turn with the service's status and text\", \"[agent][loop][errors]\")\n {\n     const std::string not_found = R\"({\"error\":{\"message\":\"The model `gpt-x` does not exist\",\"type\":\"invalid_request_error\",\"code\":\"model_not_found\"}})\";\n-    for (const unsigned status : {400u, 403u, 404u, 408u, 500u, 503u, 529u}) {\n+    for (const unsigned status : {400u, 403u, 404u, 408u}) {\n         CAPTURE(status);\n         Harness h;\n         REQUIRE(h.agent->start(request_fixture()));","is_error":false}]}}
