o the project's choices are put back","+    // afterwards.","+    PresetBundle&                  presets        = preset_bundle();","+    Plater&                        plater         = *wxGetApp().plater();","+    const std::string              kept_printer   = presets.printers.get_selected_preset_name();","+    const std::vector<std::string> kept_filaments = presets.filament_presets;","+    const std::string              kept_process   = presets.prints.get_selected_preset_name();","+","+    // Every profile the import needs goes in with one preset reload, which","+    // re-reads every installed vendor's profiles and takes seconds: the","+    // ticked printers' own, and the bases saved printers name. A saved","+    // printer imports only once its base is loaded, and JusPrin loads a","+    // vendor's profiles only once one of its printers is installed, which on","+    // a fresh install none is. A base that fails to install stays missing,","+    // and its printer's line says so.","+    std::vector<SetupCommands::PrinterProfile> profiles;","+    for (const OrcaImportItem& item : ticked)","+        if (item.outcome != OrcaImportItem::Outcome::AlreadyThere)","+            profiles.push_back({item.vendor, item.model, item.nozzle, ticked_profile(item).default_material});","+    for (const std::string& base : orca_printer_bases(files))","+        if (const PrinterSetup::PrinterCandidate* profile = missing_base(base))","+            profiles.push_back({profile->vendor_id, profile->model_id, profile->variant, profile->default_material});","+    std::string problem;","+    const bool  installed = SetupCommands::install_printer_profiles(plater, profiles, problem);","+    if (!installed)","+        BOOST_LOG_TRIVIAL(error) << \"Installing the profiles of OrcaSlicer's printers failed: \" << problem;","+","+    std::vector<OrcaImportItem>        items = import_files(files);","+    const std::map<std::string, std::string> saved = name_ticked(ticked, installed);","     items.insert(items.end(), std::make_move_iterator(ticked.begin()), std::make_move_iterator(ticked.end()));"," ","     if (selection == Selection::Kept) {","-        Plater& plater = *wxGetApp().plater();","         if (presets.printers.get_selected_preset_name() != kept_printer && !SetupCommands::select_printer_preset(plater, kept_printer))","             throw std::logic_error(\"The project's printer \" + kept_printer + \" was gone after an OrcaSlicer import\");","         for (std::size_t slot = 0; slot < kept_filaments.size() && slot < presets.filament_presets.size(); ++slot)"]},{"oldStart":172,"oldLines":10,"newStart":184,"newLines":70,"lines":["                 SetupCommands::select_filament_preset(plater, slot, kept_filaments[slot]);","         if (presets.prints.get_selected_preset_name() != kept_process)","             SetupCommands::select_process_preset(plater, kept_process);","+        return items;","     }","+    // The printer OrcaSlicer had selected, otherwise the first one brought.","+    const auto saved_as = [&saved](const OrcaImportItem& item) {","+        if (!item.vendor.empty())","+            return saved.at(item.name);","+        return item.renamed_to.empty() ? item.name : item.renamed_to;","+    };","+    const auto is_printer = [](const OrcaImportItem& item) {","+        return item.kind == OrcaImportItem::Kind::Printer && item.outcome == OrcaImportItem::Outcome::Imported;","+    };","+    auto chosen = std::find_if(items.begin(), items.end(), [&](const OrcaImportItem& item) { return is_printer(item) && item.name == preferred; });","+    if (chosen == items.end())","+        chosen = std::find_if(items.begin(), items.end(), is_printer);","+    if (chosen != items.end())","+        SetupCommands::select_printer_preset(plater, saved_as(*chosen));","     return items;"," }"," ","+void OrcaImporter::retry(std::vector<OrcaImportItem>& result, const std::string& preferred, Selection selection)","+{","+    // A failed ticked printer is installed again; a failed file is imported again.","+    std::vector<OrcaImportItem> ticked;","+    std::vector<std::string>    failed;","+    for (const OrcaImportItem& item : result)","+        if (item.outcome == OrcaImportItem::Outcome::NotImported) {","+            if (item.vendor.empty())","+                failed.push_back(item.source);","+            else","+                ticked.push_back(item);","+        }","+    // The printer the first try selected stays selected, unless this try","+    // brings OrcaSlicer's selected printer.","+    const auto imported_printer = [](const OrcaImportItem& item) {","+        return item.kind == OrcaImportItem::Kind::Printer && item.outcome == OrcaImportItem::Outcome::Imported;","+    };","+    const bool        had_printer = std::any_of(result.begin(), result.end(), imported_printer);","+    const std::string kept        = preset_bundle().printers.get_selected_preset_name();","+    // Each failed item is replaced by its new outcome, in place. bring lists","+    // the files' items before the ticked ones.","+    std::vector<OrcaImportItem> again = bring(std::move(ticked), failed, preferred, selection);","+    const bool brought_selected = std::any_of(again.begin(), again.end(), [&](const OrcaImportItem& item) {","+        return imported_printer(item) && item.name == preferred;","+    });","+    if (selection == Selection::Brought && had_printer && !brought_selected)","+        SetupCommands::select_printer_preset(*wxGetApp().plater(), kept);","+    auto next_file   = again.begin();","+    auto next_ticked = again.begin() + std::ptrdiff_t(failed.size());","+    for (OrcaImportItem& item : result)","+        if (item.outcome == OrcaImportItem::Outcome::NotImported)","+            item = item.vendor.empty() ? std::move(*next_file++) : std::move(*next_ticked++);","+}","+","+OrcaImporter::FolderChoice OrcaImporter::choose_folder(wxWindow* parent)","+{","+    wxDirDialog dialog(parent, _L(\"Choose your OrcaSlicer folder\"), wxEmptyString, wxDD_DEFAULT_STYLE | wxDD_DIR_MUST_EXIST);","+    if (dialog.ShowModal() != wxID_OK)","+        return {};","+    const fs::path picked = fs::u8path(into_u8(dialog.GetPath()));","+    if (!detect(picked).has_printers())","+        return {std::nullopt, into_u8(_L(\"JusPrin found no OrcaSlicer printers in that folder.\"))};","+    return {picked, {}};","+}","+"," bool OrcaImporter::installs_profiles(const std::vector<OrcaImportItem>& ticked, const std::vector<std::string>& files)"," {","     if (std::any_of(ticked.begin(), ticked.end(), [](const OrcaImportItem& item) { return item.outcome != OrcaImportItem::Outcome::AlreadyThere; }))"]},{"oldStart":206,"oldLines":65,"newStart":278,"newLines":49,"lines":["     return *m_profile_catalog;"," }"," ","-void OrcaImporter::install_ticked(std::vector<OrcaImportItem>& items, const std::string& preferred)","+const PrinterSetup::PrinterCandidate& OrcaImporter::ticked_profile(const OrcaImportItem& item)"," {","-    Plater& plater = *wxGetApp().plater();","-    // Each printer is saved under its model's name as it is installed, two","-    // nozzles of one model as two printers, and the last one saved stays","-    // selected: the preferred one, otherwise the first, goes last.","-    std::vector<OrcaImportItem*> order;","-    for (OrcaImportItem& item : items)","-        if (item.outcome != OrcaImportItem::Outcome::AlreadyThere)","-            order.push_back(&item);","-    if (order.empty())","-        return;","-    const auto kept = std::find_if(order.begin(), order.end(), [&](const OrcaImportItem* item) { return item->name == preferred; });","-    std::rotate(order.begin(), kept == order.end() ? order.begin() + 1 : kept + 1, order.end());","-    for (OrcaImportItem* entry : order) {","-        OrcaImportItem& item = *entry;","-        const std::vector<PrinterSetup::PrinterCandidate>& candidates = profile_catalog().candidates();","-        const auto profile = std::find_if(candidates.begin(), candidates.end(), [&item](const PrinterSetup::PrinterCandidate& candidate) {","-            return candidate.vendor_id == item.vendor && candidate.model_id == item.model && candidate.variant == item.nozzle;","-        });","-        if (profile == candidates.end())","-            throw std::logic_error(\"A printer ticked in OrcaSlicer lost its JusPrin profile between detection and import\");","-        // The reason is the generic one: installing a shipped profile fails","-        // only on a broken install, which the log describes.","-        std::string problem;","-        if (SetupCommands::install_and_select_printer(plater, item.vendor, item.model, item.nozzle, profile->default_material, problem)) {","-            Printers::add_named_printer(plater, item.model, {});","-            item.outcome = OrcaImportItem::Outcome::Imported;","-            item.reason  = OrcaImportItem::Reason::None;","+    const std::vector<PrinterSetup::PrinterCandidate>& candidates = profile_catalog().candidates();","+    const auto profile = std::find_if(candidates.begin(), candidates.end(), [&item](const PrinterSetup::PrinterCandidate& candidate) {","+        return candidate.vendor_id == item.vendor && candidate.model_id == item.model && candidate.variant == item.nozzle;","+    });","+    if (profile == candidates.end())","+        throw std::logic_error(\"A printer ticked in OrcaSlicer lost its JusPrin profile between detection and import\");","+    return *profile;","+}","+","+std::map<std::string, std::string> OrcaImporter::name_ticked(std::vector<OrcaImportItem>& items, bool installed)","+{","+    Plater&                            plater  = *wxGetApp().plater();","+    PresetBundle&                      presets = preset_bundle();","+    std::map<std::string, std::string> saved;","+    // Each printer is saved under its model's name, two nozzles of one model","+    // as two printers. The reason for a failure is the generic one:","+    // installing a shipped profile fails only on a broken install, which the","+    // log describes.","+    for (OrcaImportItem& item : items) {","+        if (item.outcome == OrcaImportItem::Outcome::AlreadyThere)","+            continue;","+        const Preset* profile = installed ? presets.printers.find_system_preset_by_model_and_variant(item.model, item.nozzle) : nullptr;","+        if (profile != nullptr && SetupCommands::select_printer_preset(plater, profile->name)) {","+            saved[item.name] = Printers::add_named_printer(plater, item.model, {});","+            item.outcome     = OrcaImportItem::Outcome::Imported;","+            item.reason      = OrcaImportItem::Reason::None;","         } else {","-            BOOST_LOG_TRIVIAL(error) << \"Installing \" << item.model << \" from OrcaSlicer's printer list failed: \" << problem;","+            BOOST_LOG_TRIVIAL(error) << \"Selecting \" << item.model << \" from OrcaSlicer's printer list failed after its profile was \"","+                                     << (installed ? \"installed\" : \"not installed\");","             item.outcome = OrcaImportItem::Outcome::NotImported;","             item.reason  = OrcaImportItem::Reason::NotLoaded;","         }","     }","+    return saved;"," }"," ","-std::vector<OrcaImportItem> OrcaImporter::import_files(const std::vector<std::string>& files, const std::string& preferred,","-                                                      Selection selection)","+std::vector<OrcaImportItem> OrcaImporter::import_files(const std::vector<std::string>& files)"," {","-    PresetBundle& presets = preset_bundle();","-    AppConfig&    config  = *wxGetApp().app_config;","-    Plater&       plater  = *wxGetApp().plater();","-    const OrcaImportCatalog lookup = catalog();","-","-    // A saved printer imports only once its base profile is loaded, and","-    // JusPrin loads a vendor's profiles only once one of its printers is","-    // installed, which on a fresh install none is. So each base JusPrin has","-    // a profile for is installed first, as OrcaSlicer had it. A base that","-    // fails to install stays missing, and its printer's line says so.","-    for (const std::string& base : orca_printer_bases(files)) {","-        const PrinterSetup::PrinterCandidate* profile = missing_base(base);","-        if (profile == nullptr)","-            continue;","-        std::string problem;","-        if (!SetupCommands::install_and_select_printer(plater, profile->vendor_id, profile->model_id, profile->variant,","-                                                       profile->default_material, problem))","-            BOOST_LOG_TRIVIAL(error) << \"Installing \" << base << \", the base of a saved OrcaSlicer printer, failed: \" << problem;","-    }","+    PresetBundle&           presets = preset_bundle();","+    AppConfig&              config  = *wxGetApp().app_config;","+    const OrcaImportCatalog lookup  = catalog();"," ","     // Renamed copies live here only until import_presets has copied them.","     const fs::path staging = fs::temp_directory_path() / (\"jusprin-orca-import-\" + std::to_string(wxGetProcessId()));"]},{"oldStart":288,"oldLines":17,"newStart":344,"newLines":6,"lines":["     // import_presets leaves in `pending` what it imported.","     settle_orca_import(items, pending);","     fs::remove_all(staging);","-","-    if (selection == Selection::Kept)","-        return items;","-    const auto is_printer = [](const OrcaImportItem& item) {","-        return item.kind == OrcaImportItem::Kind::Printer && item.outcome == OrcaImportItem::Outcome::Imported;","-    };","-    auto chosen = std::find_if(items.begin(), items.end(), [&](const OrcaImportItem& item) { return is_printer(item) && item.name == preferred; });","-    if (chosen == items.end())","-        chosen = std::find_if(items.begin(), items.end(), is_printer);","-    if (chosen != items.end())","-        SetupCommands::select_printer_preset(plater, chosen->renamed_to.empty() ? chosen->name : chosen->renamed_to);","     return items;"," }"," "]}]}],"moreFiles