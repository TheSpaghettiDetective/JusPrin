add their own.\n    static bool assumed_printer_selected();\n''','')\nopen(p,'w').write(s)\nEOF\ngit diff --stat -- Home/OrcaHomeBackend.hpp; grep -n \"wx/dirdlg\\|wxDirDialog\" Home/OrcaHomeBackend.cpp; grep -n \"bring_orca_items\" -B2 -A3 Home/OrcaHomeBackend.hpp","description":"Point Home's retry and folder picker at the importer"},"caller":{"type":"direct"}}]}}
