  return status >= 500 || status == 408 || says.type == \"overloaded_error\" || says.type == \"api_error\" ||\n903:+           says.type == \"timeout_error\" || says.type == \"server_error\" || says.type == \"service_unavailable_error\" ||\n904:+           says.code == \"server_error\" || says.code == \"server_is_overloaded\";\n914:+bool refused_the_person(unsigned status, const ServiceSays& says)\n917:+    if (openrouter.count(says.error_type) > 0 || says.code == \"rate_limit_exceeded\")\n922:+        return says.code == \"model_not_found\" || starts_with(says.message, \"No endpoints found\");\n923:+    return status == 402 || status == 403 || status == 429 || (status == 400 && says.param == \"service_tier\");\n954:     if (too_long(status, says))\n958:+    if (says.message.empty()) {\n964:+        if (service_trouble(status, says))\n968:+    if (service_trouble(status, says))\n969:+        return service_said(\"provider_unavailable\", name, says.message, true);\n970:+    if (refused_the_person(status, says)) {\n971:+        const bool too_many = status == 429 || says.code == \"rate_limit_exceeded\" || says.error_type == \"rate_limit_exceeded\";\n972:+        return service_said(too_many ? \"rate_limited\" : \"provider_refused\", name, says.message, too_many);\n1013:+                         \"{}\", refused_by_system(error).has_value());\n1028:+                    save_refused = refused_by_system(error).has_value();\n1036:+                    save_refused = refused_by_system(error).has_value();\n1059:+            // The opener says why it could not, as a reason or as the\n1066:+                refused = refused_by_system(error).has_value();\n1188:+  it('says a failure on our side as the app worded it, not that GitHub was out of reach', () => {\n1284:   // Each configured provider's model list; the JusPrin account's says whether\n1289: // the signed-out form; a failure leaves the dialog open and says so.\n1301:+  // Our server's fault: the work stops, and the report dialog says so.\n1342:+      error: { code: 'failed', message: 'The app could not write the preset. macOS says: “Permission denied”.',\n1343:+        systemSaid: 'macOS says: “/Users/alex/Library/JusPrin/user/default/filament: Permission denied”' },\n1346:+    expect(screen.getByRole('alert')).toHaveTextContent('macOS says: “/Users/alex/Library/JusPrin/user/default/filament: Permission denied”');\n1352:   it('says it was not saved once the person answered another way', () => {\n1362:   // The save's error is the AI model's to read; the card says only what\n1557:+        const std::optional<std::string> words = refused_by_system(error);\n1594:+            const std::optional<std::string> words = refused_by_system(error);\n1721:+msgid \"%1% says: “%2%”\"\n1747:+msgid \"%1% says: “%2%”\"\n1773:+msgid \"%1% says: “%2%”\"\n1799:+msgid \"%1% says: “%2%”\"\n1825:+msgid \"%1% says: “%2%”\"\n1851:+msgid \"%1% says: “%2%”\"\n1877:+msgid \"%1% says: “%2%”\"\n1903:+msgid \"%1% says: “%2%”\"\n1929:+msgid \"%1% says: “%2%”\"\n    7461 /Users/kenneth/Library/Application Support/Claude/side-session-notes/local_cd3120f7-030a-4af8-a6d1-28ecae789f1a/misrouted-failures-reverted-app.patch","is_error":false}]},"uuid":"fb9627d6-9574-4565-948f-c749b863299e","timestamp":"2026-11-25T20:00:39.114Z","toolUseResult":{"stdout":"e5244801be Own-key outages, an offline sign-out and unreadable shipped profiles go to whoever can act on them\n9f485c3604 Error handling rules: a failure goes to whoever can do something about it\nfd7127e424 Chats can run on a model on this computer, in Ollama or LM Studio\n11:+fails, the current model stays open and the header says \"Couldn't save\".\n118:+    const std::optional<std::string> words = refused_by_system(error);\n136:+        // says so on its card in the system's words; any other is ours,\n178:+        const std::optional<std::string> words = refused_by_system(error);\n276:-    // thread: whether the server says it is gone.\n379:     // type says what the