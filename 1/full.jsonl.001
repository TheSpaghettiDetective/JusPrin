{"parentUuid":"18061658-951e-43f9-a990-0d6b1702e380","isSidechain":false,"promptId":"4fcc31c2-3e80-420b-a5c6-f7cbf63689ec","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01QJ2g7zwdND7Wwr934sgN8N","type":"tool_result","content":".orca-import {\n  display: flex;\n  flex: 1 1 auto;\n  flex-direction: column;\n  min-height: 0;\n}\n.orca-import-content {\n  display: flex;\n  flex: 1 1 auto;\n  flex-direction: column;\n  gap: 16px;\n  min-height: 0;\n  overflow-y: auto;\n  padding: 20px;\n}\np.orca-import-lead,\np.orca-import-count {\n  margin: 0;\n  font: var(--font-body);\n  color: var(--text-secondary);\n}\n.orca-import-list {\n  display: flex;\n  flex: none;\n  flex-direction: column;\n  margin: 0;\n  padding: 0;\n  list-style: none;\n  border-radius: var(--radius-medium);\n  background: var(--surface-subtle);\n  box-shadow: inset 0 0 0 1px var(--border-subtle);\n}\n.orca-import-row {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  padding: 12px 16px;\n  color: var(--text-secondary);\n}\n.orca-import-row + .orca-import-row {\n  box-shadow: inset 0 1px 0 0 var(--border-subtle);\n}\n.orca-import-row-name {\n  flex: 1 1 auto;\n  min-width: 0;\n  font: var(--font-body);\n  color: var(--text-primary);\n}\n.orca-import-row--already,\n.orca-import-row--already .orca-import-row-name {\n  color: var(--text-tertiary);\n}\n.orca-import-row-status {\n  flex: none;\n  font: var(--font-label);\n  color: var(--text-secondary);\n}\n.orca-import-icon--done {\n  color: var(--status-success);\n}\n.orca-import-icon--warning {\n  color: var(--status-warning);\n}\n.orca-import-folder {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  color: var(--text-tertiary);\n}\n.orca-import-folder-path {\n  flex: 1 1 auto;\n  min-width: 0;\n  font: var(--font-label);\n  overflow-wrap: anywhere;\n}\np.orca-import-error {\n  margin: 0;\n  font: var(--font-body-small);\n  color: var(--status-danger);\n}\n.orca-import-buttons {\n  display: flex;\n  flex: none;\n