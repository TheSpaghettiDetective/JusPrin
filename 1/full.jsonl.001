{"parentUuid":"31e4262e-74d9-4e4f-8157-245aa4ed8514","isSidechain":false,"promptId":"62e7eb90-bc85-4f64-ac21-5be3d9cb2cc1","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_016fDGmbvN87vWvYN2ZNZEE3","type":"tool_result","content":" M src/slic3r/GUI/JusPrin/WebShared/afterPaint.ts\n?? .playwright-mcp/\ndiff --git a/src/slic3r/GUI/JusPrin/WebShared/afterPaint.ts b/src/slic3r/GUI/JusPrin/WebShared/afterPaint.ts\nindex 694ce42683..42b5dfe061 100644\n--- a/src/slic3r/GUI/JusPrin/WebShared/afterPaint.ts\n+++ b/src/slic3r/GUI/JusPrin/WebShared/afterPaint.ts\n@@ -1,10 +1,15 @@\n-// Runs `action` once the browser has painted what the page just rendered.\n-// A host message that does long work on the UI thread blocks the web view's\n-// painting too, so a busy label set in the same turn would never show. A frame\n-// callback runs before the paint and the timeout after it. A hidden view gets\n-// no frames, hence the fallback.\n+// Runs `action` once what the page just rendered is on screen. A host message\n+// that does long work on the UI thread blocks the window too, so a busy label\n+// set in the same turn never shows. The web page draws its frame in its own\n+// process, but the app's UI thread puts that frame on screen, and it does so\n+// only on a later turn. One frame and a zero timeout send the message before\n+// that turn comes: the import then ran with \"Import\" still on screen. Waiting\n+// for the next frame and 50 ms more lets the UI thread show it first (seen in\n+// the built app on macOS, 2026-11-05). A hidden view gets no frames, hence\n+// the fallback.\n \n-const FALLBACK_MS = 100;\n+const SETTLE_MS = 50;\n+const FALLBACK_MS = 500;\n \n export function afterPaint(action: () => void): void {\n   let done = false;\n@@ -13,6 +18,6 @@ export function afterPaint(action: () => void): void {\n     done = true;\n     action();\n   };\n-  requestAnimationFrame(() => setTimeout(run, 0));\n+  requestAnimationFrame(() => requestAnimationFrame(() => setTimeout(run, SETTLE_MS)));\n   setTimeout(run, FALLBACK_MS);\n }","is_error":false}]},"uuid":"739e4d02-b093-492d-a54c-b8b6e45b2d5c","timestamp":"2026-11-06T05:21:14.430Z","toolUseResult":{"stdout":" M src/slic3r/GUI/JusPrin/WebShared/afterPaint.ts\n?? .playwright-mcp/\ndiff --git a/src/slic3r/GUI/JusPrin/WebShared/afterPaint.ts b/src/slic3r/GUI/JusPrin/WebShared/afterPaint.ts\nindex 694ce42683..42b5dfe061 100644\n--- a/src/slic3r/GUI/JusPrin/WebShared/afterPaint.ts\n+++ b/src/slic3r/GUI/JusPrin/WebShared/afterPaint.ts\n@@ -1,10 +1,15 @@\n-// Runs `action` once the browser has painted what the page just rendered.\n-// A host message that does long work on the UI thread blocks the web view's\n-// painting too, so a busy label set in the same turn would never show. A frame\n-// callback runs before the paint and the timeout after it. A hidden view gets\n-// no frames, hence the fallback.\n+// Runs `action` once what the page just rendered is on screen. A host message\n+// that does long work on the UI thread blocks the window too, so a busy label\n+// set in the same turn never shows. The web page draws its frame in its own\n+// process, but the app's UI thread puts that frame on screen, and it does so\n+// only on a later turn. One frame and a zero timeout send the message before\n+// that turn comes: the import then ran with \"Import\" still on screen. Waiting\n+// for the next frame and 50 ms more lets the UI thread show it first (seen in\n+// the built app on macOS, 2026-11-05). A hidden view gets no frames, hence\n+// the fallback.\n \n-const FALLBACK_MS = 100;\n+const SETTLE_MS = 50;\n+const FALLBACK_MS = 500;\n \n export function afterPaint(action: () => void): void {\n   let done = false;\n@@ -13,6 +18,6 @@ export function afterPaint(action: () => void): void {\n     done = true;\n     action();\n   };\n-  requestAnimationFrame(() => setTimeout(run, 0));\n+  requestAnimationFrame(() => requestAnimationFrame(() => setTimeout(run, SETTLE_MS)));\n   setTimeout(run, FALLBACK_MS);\n }","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"sandboxed":false,"sourceToolAssistantUUID":"31e4262e-74d9-4e4f-8157-245aa4ed8514","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"userType":"external","entrypoint":"claude-desktop","cwd":"/Users/kenneth/Projects/JusPrin/.claude/worktrees/first-run-flow-f7be35","sessionId":"c868826d-3950-4f0f-9ecd-4a549cdd6983","version":"2.1.309","gitBranch":"claude/orca-import-menu","slug":"dapper-knitting-moler"}
