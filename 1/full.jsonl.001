{"parentUuid":"8ab18b06-d39e-4061-a04c-1a45edad55d1","isSidechain":false,"promptId":"a87f93ac-7f7c-43ec-a4cd-0785d69b9cce","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01WNJnTqLVmA7yb1KE5muNFQ","type":"tool_result","content":"TEST_CASE(\"a late completion from the tool-call request cannot end its continuation\", \"[agent][loop][tools]\")\n{\n    Harness h;\n    REQUIRE(h.agent->start(request_fixture()));\n    h.fake->data(frame(json{{\"turn\", \"t\"}, {\"calls\", json::array({call(\"call-9\", \"plate_layout\", kLayoutArguments)})}}));\n    REQUIRE(h.poll_until(AgentEventKind::ToolCall));\n    REQUIRE(h.agent->continue_after_tool({\"call-9\", \"succeeded\", R\"({\"state\":\"succeeded\"})\"}));\n\n    // The first request's libcurl completion can race with page handling and\n    // arrive after the continuation has already started.\n    h.fake->callbacks.front()(AgentHttpEvent{AgentHttpEvent::Kind::Complete, {}, {}, 200});\n    CHECK_FALSE(h.agent->poll());\n    CHECK(h.agent->busy());\n\n    h.fake->data(frame(json{{\"turn\", json::array()}}));\n    h.fake->complete();\n    REQUIRE(h.poll_until(AgentEventKind::Completed));\n    CHECK_FALSE(h.agent->busy());\n}\n\nTEST_CASE(\"HTTP failures are mapped to safe errors that name the provider\", \"[agent][loop][errors]\")\n{\n    struct Case { unsigned status; const char* detail; const char* code; bool retryable; const char* mention; };\n    const Case cases[] = {{401, \"body omitted\", \"invalid_credentials\", false, \"The Test Provider API key was rejected\"},\n                          {429, \"sensitive upstream body\", \"rate_limited\", true, \"The Test Provider service is rate limited\"},\n                          {0, \"Operation timed out\", \"network_error\", true, \"could not reach the Test Provider service\"},\n                          {0, \"could not resolve host\", \"network_error\", true, \"could not reach the Test Provider service\"},\n                          {413, \"body omitted\", \"request_too_large\", false, \"too large for the Test Provider service\"},\n                          // The service of the person's own key failing on its side.\n                          {500, \"sensitive upstream body\", \"network_error\", true, \"could not reach the Test Provider service\"},\n                          {503, \"sensitive upstream body\", \"network_error\", true, \"could not reach the Test Provider service\"},\n                          {529, \"sensitive upstream body\", \"network_error\", true, \"could not reach the Test Provider service\"}};\n    for (const Case& item : cases) {\n        CAPTURE(item.status, item.detail);\n        Harness h;\n        REQUIRE(h.agent->start(request_fixture()));\n        h.fake->error(item.status, item.detail);\n        const auto event = h.poll_until(AgentEventKind::Failed);\n        REQUIRE(event);\n        REQUIRE(event->error);\n        CHECK(event->error->code == item.code);\n        CHECK(event->error->retryable == item.retryable);\n        CHECK(event->error->message.find(item.mention) != std::string::npos);\n        CHECK(event->error->message.find(\"sensitive\") == std::string::npos);\n        CHECK_FALSE(h.agent->busy());\n    }\n}\n\nTEST_CASE(\"an answer that names nothing a person can act on stops the turn with the service's status and text\", \"[agent][loop][errors]\")\n{\n    const std::string not_found = R\"({\"error\":{\"message\":\"The model `gpt-x` does not exist\",\"type\":\"invalid_request_error\",\"code\":\"model_not_found\"}})\";\n    for (const unsigned status : {400u, 403u, 404u, 408u}) {\n        CAPTURE(status);\n        Harness h;\n        REQUIRE(h.agent->start(request_fixture()));\n        h.fake->refuse(status, not_found);\n        CHECK_THROWS_WITH(h.poll_until(AgentEventKind::Failed),\n                          ContainsSubstring(\"Test Provider answered HTTP \" + std::to_string(status)) &&\n                              ContainsSubstring(\"model_not_found\") && ContainsSubstring(\"assistant-7-attempt-1\"));\n        // The turn stopped there: nothing is waiting, nothing more arrives.\n        CHECK_FALSE(h.agent->busy());\n        CHECK(h.fake->cancelled);\n        CHECK_FALSE(h.agent->poll());\n    }\n}\n\nTEST_CASE(\"what the codec reports ends the turn as it says\", \"[agent][loop][errors]\")\n{\n    Harness h;\n    REQUIRE(h.agent->start(request_fixture()));\n    h.fake->data(frame(json{{\"incomplete\", true}}));\n    CHECK_THROWS_WITH(h.poll_until(AgentEventKind::Failed), ContainsSubstring(\"ended its response early\"));\n    CHECK_FALSE(h.agent->busy());\n\n    REQUIRE(h.agent->start(request_fixture()));\n    h.fake->data(frame(json{{\"failed\", json{{\"code\", \"refusal\"}, {\"retryable\", false}}}}));\n    auto event = h.poll_until(AgentEventKind::Failed);\n    REQUIRE(event);\n    CHECK(event->error->code == \"refusal\");\n    CHECK_FALSE(event->error->retryable);","is_error":false}]},"uuid":"f1ef2f34-553a-482f-b90c-53df171d154d","timestamp":"2026-11-25T20:08:13.476Z","toolUseResult":{"stdout":"TEST_CASE(\"a late completion from the tool-call request cannot end its continuation\", \"[agent][loop][tools]\")\n{\n    Harness h;\n    REQUIRE(h.agent->start(request_fixture()));\n    h.fake->data(frame(json{{\"turn\", \"t\"}, {\"calls\", json::array({call(\"call-9\", \"plate_layout\", kLayoutArguments)})}}));\n    REQUIRE(h.poll_until(AgentEventKind::ToolCall));\n    REQUIRE(h.agent->continue_after_tool({\"call-9\", \"succeeded\", R\"({\"state\":\"succeeded\"})\"}));\n\n    // The first request's libcurl completion can race with page handling and\n    // arrive after the continuation has already started.\n    h.fake->callbacks.front()(AgentHttpEvent{AgentHttpEvent::Kind::Complete, {}, {}, 200});\n    CHECK_FALSE(h.agent->poll());\n    CHECK(h.agent->busy());\n\n    h.fake->data(frame(json{{\"turn\", json::array()}}));\n    h.fake->complete();\n    REQUIRE(h.poll_until(AgentEventKind::Completed));\n    CHECK_FALSE(h.agent->busy());\n}\n\nTEST_CASE(\"HTTP failures are mapped to safe errors that name the provider\", \"[agent][loop][errors]\")\n{\n    struct Case { unsigned status; const char* detail; const char* code; bool retryable; const char* mention; };\n    const Case cases[] = {{401, \"body omitted\", \"invalid_credentials\", false, \"The Test Provider API key was rejected\"},\n                          {429, \"sensitive upstream body\", \"rate_limited\", true, \"The Test Provider service is rate limited\"},\n                          {0, \"Operation timed out\", \"network_error\", true, \"could not reach the Test Provider service\"},\n                          {0, \"could not resolve host\", \"network_error\", true, \"could not reach the Test Provider service\"},\n                          {413, \"body omitted\", \"request_too_large\", false, \"too large for the Test Provider service\"},\n                          // The service of the person's own key failing on its side.\n                          {500, \"sensitive upstream body\", \"network_error\", true, \"could not reach the Test Provider service\"},\n                          {503, \"sensitive upstream body\", \"network_error\", true, \"could not reach the Test Provider service\"},\n                          {529, \"sensitive upstream body\", \"network_error\", true, \"could not reach the Test Provider service\"}};\n    for (const Case& item : cases) {\n        CAPTURE(item.status, item.detail);\n        Harness h;\n        REQUIRE(h.agent->start(request_fixture()));\n        h.fake->error(item.status, item.detail);\n        const auto event = h.poll_until(AgentEventKind::Failed);\n        REQUIRE(event);\n        REQUIRE(event->error);\n        CHECK(event->error->code == item.code);\n        CHECK(event->error->retryable == item.retryable);\n        CHECK(event->error->message.find(item.mention) != std::string::npos);\n        CHECK(event->error->message.find(\"sensitive\") == std::string::npos);\n        CHECK_FALSE(h.agent->busy());\n    }\n}\n\nTEST_CASE(\"an answer that names nothing a person can act on stops the turn with the service's status and text\", \"[agent][loop][errors]\")\n{\n    const std::string not_found = R\"({\"error\":{\"message\":\"The model `gpt-x` does not exist\",\"type\":\"invalid_request_error\",\"code\":\"model_not_found\"}})\";\n    for (const unsigned status : {400u, 403u, 404u, 408u}) {\n        CAPTURE(status);\n        Harness h;\n        REQUIRE(h.agent->start(request_fixture()));\n        h.fake->refuse(status, not_found);\n        CHECK_THROWS_WITH(h.poll_until(AgentEventKind::Failed),\n                          ContainsSubstring(\"Test Provider answered HTTP \" + std::to_string(status)) &&\n                              ContainsSubstring(\"model_not_found\") && ContainsSubstring(\"assistant-7-attempt-1\"));\n        // The turn stopped there: nothing is waiting, nothing more arrives.\n        CHECK_FALSE(h.agent->busy());\n        CHECK(h.fake->cancelled);\n        CHECK_FALSE(h.agent->poll());\n    }\n}\n\nTEST_CASE(\"what the codec reports ends the turn as it says\", \"[agent][loop][errors]\")\n{\n    Harness h;\n    REQUIRE(h.agent->start(request_fixture()));\n    h.fake->data(frame(json{{\"incomplete\", true}}));\n    CHECK_THROWS_WITH(h.poll_until(AgentEventKind::Failed), ContainsSubstring(\"ended its response early\"));\n    CHECK_FALSE(h.agent->busy());\n\n    REQUIRE(h.agent->start(request_fixture()));\n    h.fake->data(frame(json{{\"failed\", json{{\"code\", \"refusal\"}, {\"retryable\", false}}}}));\n    auto event = h.poll_until(AgentEventKind::Failed);\n    REQUIRE(event);\n    CHECK(event->error->code == \"refusal\");\n    CHECK_FALSE(event->error->retryable);","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"sandboxed":false,"sourceToolAssistantUUID":"8ab18b06-d39e-4061-a04c-1a45edad55d1","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"userType":"external","entrypoint":"claude-desktop","