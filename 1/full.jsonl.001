\n197-    };\n198-    auto chosen = std::find_if(items.begin(), items.end(), [&](const OrcaImportItem& item) { return is_printer(item) && item.name == preferred; });\n199-    if (chosen == items.end())\n200-        chosen = std::find_if(items.begin(), items.end(), is_printer);\n201-    if (chosen != items.end())\n202-        SetupCommands::select_printer_preset(plater, saved_as(*chosen));\n203-    return items;\n204-}\n205-\n206-void OrcaImporter::retry(std::vector<OrcaImportItem>& result, const std::string& preferred, Selection selection)\n207-{\n208-    // A failed ticked printer is installed again; a failed file is imported again.\n209-    std::vector<OrcaImportItem> ticked;\n210-    std::vector<std::string>    failed;\n211-    for (const OrcaImportItem& item : result)\n212-        if (item.outcome == OrcaImportItem::Outcome::NotImported) {\n213-            if (item.vendor.empty())\n214-                failed.push_back(item.source);\n215-            else\n216-                ticked.push_back(item);\n217-        }\n218-    // The printer the first try selected stays selected, unless this try\n219-    // brings OrcaSlicer's selected printer.\n220-    const auto imported_printer = [](const OrcaImportItem& item) {\n221-        return item.kind == OrcaImportItem::Kind::Printer && item.outcome == OrcaImportItem::Outcome::Imported;\n222-    };\n223-    const bool        had_printer = std::any_of(result.begin(), result.end(), imported_printer);\n224-    const std::string kept        = preset_bundle().printers.get_selected_preset_name();\n225-    // Each failed item is replaced by its new outcome, in place. bring lists\n226-    // the files' items before the ticked ones.\n227-    std::vector<OrcaImportItem> again = bring(std::move(ticked), failed, preferred, selection);\n228-    const bool brought_selected = std::any_of(again.begin(), again.end(), [&](const OrcaImportItem& item) {\n229-        return imported_printer(item) && item.name == preferred;\n230-    });\n231-    