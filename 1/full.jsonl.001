{"type":"api-request-blob","sessionId":"c868826d-3950-4f0f-9ecd-4a549cdd6983","hash":"442464f5648493dc6ec38162615bd0c16924aa8145bbda3e89e488a2a7b50bca","message":{"role":"assistant","content":[{"type":"tool_use","id":"toolu_01PXgDUqUqvCSJ7FWm95A9zh","name":"Bash","input":{"command":"cd /Users/kenneth/Projects/JusPrin/.claude/worktrees/first-run-flow-f7be35/src/slic3r/GUI/JusPrin/HomeUI && python3 - <<'EOF'\np='src/components/Onboarding.tsx'\ns=open(p).read()\ns=s.replace(\"import type { Appearance, EmailSignIn, ImportResultItem, OnboardingState } from '../bridge/protocol';\",\n\"import type { Appearance, EmailSignIn, OnboardingState } from '../bridge/protocol';\")\ns=s.replace(\"import { creditCount } from '../../../AgentUI/src/credits';\",\n\"import { afterPaint } from '@shared/afterPaint';\\nimport { creditCount } from '../../../AgentUI/src/credits';\\nimport { OrcaImportResultLines, OrcaPrinterList } from '../../../AgentUI/src/components/OrcaImportLists';\")\ns=s.replace(\"import { CheckGlyph, FolderGlyph, PrinterGlyph, WarningGlyph } from './Glyphs';\",\"import { CheckGlyph, FolderGlyph } from './Glyphs';\")\n# OrcaImport screen\ns=s.replace('''function OrcaImport({ onboarding, error, onAction }: Props) {\n  const { orca } = onboarding;\n  return (''','''// Importing holds the app on the action's message, so the button says so\n// first and the message goes once that has been painted. The host answers\n// with the next screen, or with an error.\nfunction useBusy(onAction: Action, ...answers: unknown[]) {\n  const [busy, setBusy] = useState(false);\n  // eslint-disable-next-line react-hooks/exhaustive-deps\n  useEffect(() => setBusy(false), answers);\n  const run = (type: string) => {\n    setBusy(true);\n    afterPaint(() => onAction(type));\n  };\n  return [busy, run] as const;\n}\n\nfunction OrcaImport({ onboarding, error, onAction }: Props) {\n  const { orca } = onboarding;\n  const [busy, run] = useBusy(onAction, error);\n  return (''')\ns=s.replace('''      <ul className=\"onboarding-printers\">\n        {orca.printers.map((name) => (\n          <li key={name}>\n            <PrinterGlyph />\n            {name}\n          </li>\n        ))}\n      </ul>''','''      <OrcaPrinterList printers={orca.printers.map((name) => ({ name, already: false }))} />''')\ns=s.replace('''        <button type=\"button\" className=\"button-primary\" onClick={() => onAction('onboarding_import')}>Import</button>\n        <button type=\"button\" className=\"button-secondary\" onClick={() => onAction('onboarding_start_fresh')}>Start fresh</button>\n      </div>\n      <button type=\"button\" className=\"onboarding-link flush\" onClick={() => onAction('onboarding_back')}>Back</button>''','''        <button type=\"button\" className=\"button-primary\" disabled={busy} onClick={() => run('onboarding_import')}>\n          {busy ? 'Importing…' : 'Import'}\n        </button>\n        <button type=\"button\" className=\"button-secondary\" disabled={busy} onClick={() => onAction('onboarding_start_fresh')}>\n          Start fresh\n        </button>\n      </div>\n      <button type=\"button\" className=\"onboarding-link flush\" disabled={busy} onClick={() => onAction('onboarding_back')}>Back</button>''')\nstart=s.index(\"function importStatus(item: ImportResultItem)\")\nend=s.index(\"// \\\"Which printer do you have?\\\"\")\ns=s[:start]+'''function ImportResult({ onboarding, error, onAction }: Props) {\n  const items = onboarding.orca.importResult ?? [];\n  const failed = items.some((item) => !item.imported);\n  const [busy, run] = useBusy(onAction, items, error);\n  return (\n    <div className=\"onboarding-step\">\n      <div className=\"onboarding-heading\">\n        <h1>{failed ? 'Some settings need attention' : 'Imported from OrcaSlicer'}</h1>\n        <p className=\"onboarding-lead\">OrcaSlicer’s own files were not changed.</p>\n      </div>\n      <OrcaImportResultLines lines={items} />\n      {error && <p className=\"onboarding-error\" role=\"alert\">{error}</p>}\n      <div className=\"onboarding-actions\">\n        <button type=\"button\" className=\"button-primary\" disabled={busy} onClick={() => onAction('onboarding_import_continue')}>\n          Continue\n        </button>\n        {failed && (\n          <button type=\"button\" className=\"button-secondary\" disabled={busy} onClick={() => run('onboarding_import_retry')}>\n            {busy ? 'Importing…' : 'Retry failed items'}\n          </button>\n        )}\n      </div>\n    </div>\n  );\n}\n\n'''+s[end:]\nopen(p,'w').write(s)\nEOF\ngrep -n \"PrinterGlyph\\|WarningGlyph\\|eslint\" src/components/*.tsx | head; ls ../HomeUI/.eslintrc* ../HomeUI/eslint* 2>/dev/null; grep -n \"ImportResultItem\" -A8 src/bridge/protocol.ts | head -12","description":"Switch the onboarding import screens to the shared components"},"caller":{"type":"direct"}}]}}
