{"type":"api-request-blob","sessionId":"c868826d-3950-4f0f-9ecd-4a549cdd6983","hash":"9c5af7360b581a6ecd4e162df3a9fcd628031f14c84c3228f60ecbc69f2b27b0","message":{"role":"assistant","content":[{"type":"thinking","thinking":"","signature":""},{"type":"text","text":"The import ran from 21:07:44.2 to 21:08:05.9, so all three captures fell inside it. Putting the fix into the shared helper."},{"type":"tool_use","id":"toolu_01BrQvmkEneURwNTJNEqBEUF","name":"mcp__ccd_turn__update_plan","input":{"advance":true},"caller":{"type":"direct"}},{"type":"tool_use","id":"toolu_01E1qhCGKriPgzjSVVQJwWLf","name":"Write","input":{"file_path":"/Users/kenneth/Projects/JusPrin/.claude/worktrees/first-run-flow-f7be35/src/slic3r/GUI/JusPrin/WebShared/afterPaint.ts","content":"// Runs `action` once what the page just rendered is on screen. A host message\n// that does long work on the UI thread blocks the window too, so a busy label\n// set in the same turn never shows. The web page draws its frame in its own\n// process, but the app's UI thread puts that frame on screen, and it does so\n// only on a later turn. One frame and a zero timeout send the message before\n// that turn comes: the import then ran with \"Import\" still on screen. Waiting\n// for the next frame and 50 ms more lets the UI thread show it first (seen in\n// the built app on macOS, 2026-11-05). A hidden view gets no frames, hence\n// the fallback.\n\nconst SETTLE_MS = 50;\nconst FALLBACK_MS = 500;\n\nexport function afterPaint(action: () => void): void {\n  let done = false;\n  const run = () => {\n    if (done) return;\n    done = true;\n    action();\n  };\n  requestAnimationFrame(() => requestAnimationFrame(() => setTimeout(run, SETTLE_MS)));\n  setTimeout(run, FALLBACK_MS);\n}\n"},"caller":{"type":"direct"}}]}}
