{"parentUuid":"ba554e06-dcd4-4023-b96c-96625253fe08","isSidechain":false,"promptId":"72013b54-b18f-48cf-ab14-3227cd513d22","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01RbzRnPMtRXFjMYSPQEXXvR","type":"tool_result","content":"diff --git a/src/slic3r/GUI/JusPrin/Agent/CloudSignInMachine.cpp b/src/slic3r/GUI/JusPrin/Agent/CloudSignInMachine.cpp\nindex b395ab991a..ad39b6385d 100644\n--- a/src/slic3r/GUI/JusPrin/Agent/CloudSignInMachine.cpp\n+++ b/src/slic3r/GUI/JusPrin/Agent/CloudSignInMachine.cpp\n@@ -186,6 +186,12 @@ CloudAccountDeps make_cloud_account_deps()\n             .timeout_connect(10)\n             .timeout_max(30)\n             .on_error(reported(\"signing out of JusPrin\", [url](std::string body, std::string error, unsigned status) {\n+                // No answer, such as no network: the token is already\n+                // forgotten on this computer, and nobody can act on it.\n+                if (status == 0) {\n+                    BOOST_LOG_TRIVIAL(warning) << \"Signing out of JusPrin reached no server at \" << url << \": \" << error;\n+                    return;\n+                }\n                 // Forgotten on this computer, the token still works on the\n                 // server.\n                 throw RuntimeError(\"revoking the token at \" + url + \" answered \" + std::to_string(status) + \": \" + error +\ndiff --git a/src/slic3r/GUI/JusPrin/Agent/ModelCatalogFetch.cpp b/src/slic3r/GUI/JusPrin/Agent/ModelCatalogFetch.cpp\nindex a573a91146..7d4be09113 100644\n--- a/src/slic3r/GUI/JusPrin/Agent/ModelCatalogFetch.cpp\n+++ b/src/slic3r/GUI/JusPrin/Agent/ModelCatalogFetch.cpp\n@@ -78,6 +78,10 @@ void request_page(std::shared_ptr<Fetch> fetch, const std::string& after)\n             if (const std::optional<AgentError> outdated = update_required(status, body))\n                 fetch->result.update_message = outdated->message;\n             fetch->done(std::move(fetch->result));\n+            // The service of the person's own key failing on its side is for\n+            // whoever runs it; the list is marked failed above.\n+            if (!fetch->profile.account_sign_in && !fetch->profile.on_this_computer && status >= 500)\n+                return;\n             if (const std::optional<std::string> fault = model_list_fault(status, body))\n                 throw std::runtime_error(*fault);\n         }))\ndiff --git a/src/slic3r/GUI/JusPrin/Agent/ProviderAgent.cpp b/src/slic3r/GUI/JusPrin/Agent/ProviderAgent.cpp\nindex f8dd025e52..c59dabcf81 100644\n--- a/src/slic3r/GUI/JusPrin/Agent/ProviderAgent.cpp\n+++ b/src/slic3r/GUI/JusPrin/Agent/ProviderAgent.cpp\n@@ -841,6 +841,12 @@ AgentError ProviderAgent::http_error(const AgentHttpEvent& event)\n     const std::string& words   = event.data.empty() ? event.error : event.data;\n     if (expected)\n         return this->expected(std::move(*expected), answered, words);\n+    // The service of the person's own key failing on its side: whoever runs\n+    // it can fix it, and nobody here can.\n+    if (!m_config.profile.account_sign_in && !m_config.profile.on_this_computer && event.status >= 500)\n+        // TRN %1% is an AI provider, such as OpenAI.\n+        return this->expected({\"network_error\", Slic3r::format(translated(L(\"The AI request could not reach the %1% service.\")), m_config.profile.display_name), true},\n+                              answered, words);\n     unexpected(answered, words);\n }\n \n@@ -892,8 +898,17 @@ std::optional<AgentError> ProviderAgent::provider_answer(unsigned status, const\n \n std::optional<AgentError> ProviderAgent::in_reply_answer(const json& answer) const\n {\n-    if (!m_config.profile.account_sign_in)\n+    if (!m_config.profile.account_sign_in) {\n+        // The service of the person's own key overloaded or failing on its\n+        // side, as Anthropic, OpenAI and OpenRouter name it inside a reply.\n+        const ServiceSays says = service_says(answer);\n+        if (!m_config.profile.on_this_computer &&\n+            (says.type == \"overloaded_error\" || says.type == \"api_error\" || says.code == \"server_error\" ||\n+             says.error_type == \"provider_overloaded\" || says.error_type == \"provider_unavailable\" || says.error_type == \"server\"))\n+            // TRN %1% is an AI provider, such as OpenAI.\n+            return AgentError{\"network_error\", Slic3r::format(translated(L(\"The AI request could not reach the %1% service.\")), m_config.profile.display_name), true};\n         return provider_answer(0, answer);\n+    }\n     // Inside a reply the gateway names one cause a person can act on: a chat\n     // more than the model takes.\n     const std::string code = service_says(answer).code;\ndiff --git a/src/slic3r/GUI/JusPrin/PrinterSetup/SetupOptionsLoader.cpp b/src/slic3r/GUI/JusPrin/PrinterSetup/SetupOptionsLoader.cpp\nindex e194f76c9b..a30a65a08f 100644\n--- a/src/slic3r/GUI/JusPrin/PrinterSetup/SetupOptionsLoader.cpp\n+++ b/src/slic3r/GUI/JusPrin/PrinterSetup/SetupOptionsLoader.cpp\n@@ -3,7 +3,6 @@\n #include \"libslic3r/Preset.hpp\"\n #include \"libslic3r/PresetBundle.hpp\"\n #include \"libslic3r/PrintConfig.hpp\"\n-#include \"libslic3r/format.hpp\"\n \n #include <boost/algorithm/string/case_conv.hpp>\n \n@@ -11,10 +10,6 @@\n #include <set>\n #include <stdexcept>\n \n-// Also built into tests that have no GUI: text a person reads is marked with\n-// L() and translated with translated() (Localization/README.md).\n-#include \"slic3r/GUI/JusPrin/Support/Translate.hpp\"\n-\n namespace Slic3r::GUI::JusPrin::PrinterSetup {\n \n namespace {\n@@ -76,15 +71,12 @@ SetupOptions load_setup_options(const std::string& profiles_directory, const std\n {\n     SetupOptions options;\n     PresetBundle bundle;\n-    // A vendor that cannot be read is named, not thrown; its error is in the text.\n+    // The profiles shipped with the app fail to read only on a broken\n+    // install, which is ours. The loader logs each file's error, with its path.\n     std::vector<std::string> failed;\n-    const std::string errors =\n-        bundle.load_system_vendor_from_dir(profiles_directory, vendor_id, ForwardCompatibilitySubstitutionRule::EnableSilent, &failed).second;\n-    if (!failed.empty()) {\n-        // TRN %1% is the profile loader's own error, in English.\n-        options.error = Slic3r::format(translated(L(\"The printer profiles could not be read: %1%\")), errors);\n-        return options;\n-    }\n+    bundle.load_system_vendor_from_dir(profiles_directory, vendor_id, ForwardCompatibilitySubstitutionRule::EnableSilent, &failed);\n+    if (!failed.empty())\n+        throw std::runtime_error(\"The shipped printer profiles of \" + vendor_id + \" could not be read\");\n \n     const Preset* printer = bundle.printers.find_preset(printer_preset, false);\n     if (printer == nullptr || printer->name != printer_preset)\ndiff --git a/tests/agent/test_anthropic_codec.cpp b/tests/agent/test_anthropic_codec.cpp\nindex 3b57579693..98f65fa3ae 100644\n--- a/tests/agent/test_anthropic_codec.cpp\n+++ b/tests/agent/test_anthropic_codec.cpp\n@@ -738,8 +738,11 @@ TEST_CASE(\"each stop reason ends the response as it should\", \"[agent][anthropic]\n         Agent agent;\n         REQUIRE(agent.service->start(request_fixture()));\n         agent.fake->data(sse(json{{\"type\", \"error\"}, {\"error\", json{{\"type\", \"overloaded_error\"}, {\"message\", \"Overloaded\"}}}}));\n-        CHECK_THROWS_WITH(agent.poll_until(AgentEventKind::Failed),\n-                          Catch::Matchers::ContainsSubstring(\"overloaded_error\") && Catch::Matchers::ContainsSubstring(\"Overloaded\"));\n+        // The service of the person's own key, overloaded: nobody here can fix it.\n+        const auto overloaded = agent.poll_until(AgentEventKind::Failed);\n+        REQUIRE(overloaded);\n+        REQUIRE(overloaded->error);\n+        CHECK(overloaded->error->code == \"network_error\");\n \n         REQUIRE(agent.service->start(request_fixture()))