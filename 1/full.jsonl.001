lc_flushing_volumes(int(slot));\n    plater.on_filament_change(slot);\n    // With one slot the filament tab follows the selection; with several it\n    // keeps its own, and only the slot lists repaint.\n    if (presets->filament_presets.size() > 1)\n        plater.sidebar().update_presets(Preset::TYPE_FILAMENT);\n    else\n        tab->select_preset(preset_name);\n    plater.on_config_change(presets->full_config());\n    return true;\n}\n\nvoid set_filament_colour(Plater& plater, std::size_t slot, const wxColour& colour)\n{\n    PresetBundle* presets = wxGetApp().preset_bundle;\n    if (presets == nullptr || !colour.IsOk() || slot >= presets->filament_presets.size())\n79:std::vector<FilamentSlot> filament_slots();\n92:std::vector<BedTypeChoice> bed_types();\n98:std::vector<FilamentInfo> compatible_filaments();\n102:std::vector<wxColour> saved_colours();\n104:void remember_colour(const wxColour& colour);\n144:bool select_filament_preset(Plater& plater, std::size_t slot, const std::string& preset_name);\n148:void set_filament_colour(Plater& plater, std::size_t slot, const wxColour& colour);\n152:std::optional<std::size_t> add_filament_slot(Plater& plater);\n157:bool select_printer_preset(Plater& plater, const std::string& preset_name);\n162:bool select_named_printer(Plater& plater, const std::string& name);\n166:bool install_and_select_printer(Plater& plater, const std::string& vendor_id,\n173:bool select_bed_type(Plater& plater, int bed_type_value);\n176:void open_settings_tab(Preset::Type type);\n178:void open_filament_settings(std::size_t slot);\n181:void open_filament_library();\n184:bool sync_from_printer(Plater& plater);\n188:std::string monitored_device();","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"sandboxed":false,"sourceToolAssistantUUID":"03d4b2c2-757a-4032-a6c3-dd9964c0fb6d","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"userType":"external","entrypoint":"claude-desktop","cwd":"/Users/ken