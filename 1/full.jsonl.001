ne {\n  kind: 'printer' | 'filament' | 'process';\n38:      importPrinters: () => client.send('shell_action', { action: 'import' }),\n39:      chooseFolder: () => client.send('shell_action', { action: 'choose_folder' }),","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false,"staleReadFileStateHint":"[This command modified 1 file you've previously read: AgentUI/src/components/OrcaImport.tsx. Call Read before editing.]","bashEditDiff":{"files":[{"filePath":"/Users/kenneth/Projects/JusPrin/.claude/worktrees/first-run-flow-f7be35/src/slic3r/GUI/JusPrin/AgentUI/src/components/OrcaImport.tsx","hunks":[{"oldStart":6,"oldLines":6,"newStart":6,"newLines":7,"lines":[" "," import { useState } from 'react';"," import type { OrcaImportLine, OrcaImportPayload } from '../bridge/protocol';","+import { afterPaint } from '@shared/afterPaint';"," import { OrcaImportResultLines, OrcaPrinterList } from './OrcaImportLists';"," "," export interface OrcaImportActions {"]}]},{"filePath":"/Users/kenneth/Projects/JusPrin/.claude/worktrees/first-run-flow-f7be35/src/slic3r/GUI/JusPrin/WebShared/afterPaint.ts","hunks":[{"oldStart":0,"oldLines":0,"newStart":1,"newLines":18,"lines":["+// Runs `action` once the browser has painted what the page just rendered.","+// A host message that does long work on the UI thread blocks the web view's","+// painting too, so a busy label set in the same turn would never show. A frame","+// callback runs before the paint and the timeout after it. A hidden view gets","+// no frames, hence the fallback.","+","+const FALLBACK_MS = 100;","+","+export function afterPaint(action: () => void): void {","+  let done = false;","+  const run = () => {","+    if (done) return;","+    done = true;","+    action();","+  };","+  requestAnimationFrame(() => setTimeout(run, 0));","+  setTimeout(run, FALLBACK_MS);","+}"]}],"created":true}],"moreFiles":0,"changedFiles":["/Users/kenneth/Projects/JusPrin/.claude/worktrees/first-run-flow-f7be35/src/slic3r/GUI/JusPri