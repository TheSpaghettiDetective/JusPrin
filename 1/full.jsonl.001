{"parentUuid":"56838f57-cbc7-4dfe-b588-c631ccd91612","isSidechain":false,"promptId":"a87f93ac-7f7c-43ec-a4cd-0785d69b9cce","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01JgkgFYw81sULU8u5ZtKDPL","type":"tool_result","content":"            {\"id\", \"resp_1\"}, {\"status\", \"failed\"}, {\"error\", json{{\"code\", \"invalid_prompt\"}, {\"message\", \"Context length exceeded\"}}},\n            {\"error_type\", \"context_length_exceeded\"}}}}));\n        const auto error = r.failure();\n        REQUIRE(error);\n        CHECK(error->code == \"request_too_large\");\n    }\n    // The gateway's own event when the provider says so after the 200.\n    SECTION(\"a JusPrin account inside the reply\")\n    {\n        Responses r(\"jusprin\");\n        r.fake->data(sse(kCreated) + sse(json{{\"type\", \"error\"}, {\"code\", \"request_too_large\"}, {\"message\", \"The request is too large.\"}}));\n        const auto error = r.failure();\n        REQUIRE(error);\n        CHECK(error->code == \"request_too_large\");\n    }\n}\n\nTEST_CASE(\"a 403 or an event that names no cause the person can act on is still unexpected\", \"[agent][openai][errors]\")\n{\n    SECTION(\"OpenAI's 403 for a country\")\n    {\n        Responses r(\"openai\");\n        r.fake->refuse(403, R\"({\"error\":{\"code\":\"unsupported_country_region_territory\",\"message\":\"Country, region, or territory not supported\",\"param\":null,\"type\":\"request_forbidden\"}})\");\n        CHECK_THROWS_WITH(r.failure(), Catch::Matchers::ContainsSubstring(\"unsupported_country_region_territory\"));\n    }\n    SECTION(\"a failed response for a picture\")\n    {\n        Responses r(\"openai\");\n        r.fake->data(sse(kCreated) + sse(json{{\"type\", \"response.failed\"}, {\"response\", json{\n            {\"error\", json{{\"code\", \"invalid_image_format\"}, {\"message\", \"Invalid image format.\"}}}}}}));\n        CHECK_THROWS_WITH(r.failure(), Catch::Matchers::ContainsSubstring(\"invalid_image_format\"));\n    }\n    SECTION(\"the gateway's unexpected answer\")\n    {\n        Responses r(\"jusprin\");\n        r.fake->data(sse(kCreated) + sse(json{{\"type\", \"error\"}, {\"code\", \"server_error\"}, {\"message\", \"Something went wrong on our side\"}}));\n        CHECK_THROWS_WITH(r.failure(), Catch::Matchers::ContainsSubstring(\"server_error\"));\n    }\n}\n\nTEST_CASE(\"reported usage carries the cached share of the input\", \"[agent][openai][usage]\")","is_error":false}]},"uuid":"ae818b7e-4ba2-42e2-8dd1-c0f3a8749c47","timestamp":"2026-11-25T20:24:19.630Z","toolUseResult":{"stdout":"            {\"id\", \"resp_1\"}, {\"status\", \"failed\"}, {\"error\", json{{\"code\", \"invalid_prompt\"}, {\"message\", \"Context length exceeded\"}}},\n            {\"error_type\", \"context_length_exceeded\"}}}}));\n        const auto error = r.failure();\n        REQUIRE(error);\n        CHECK(error->code == \"request_too_large\");\n    }\n    // The gateway's own event when the provider says so after the 200.\n    SECTION(\"a JusPrin account inside the reply\")\n    {\n        Responses r(\"jusprin\");\n        r.fake->data(sse(kCreated) + sse(json{{\"type\", \"error\"}, {\"code\", \"request_too_large\"}, {\"message\", \"The request is too large.\"}}));\n        const auto error = r.failure();\n        REQUIRE(error);\n        CHECK(error->code == \"request_too_large\");\n    }\n}\n\nTEST_CASE(\"a 403 or an event that names no cause the person can act on is still unexpected\", \"[agent][openai][errors]\")\n{\n    SECTION(\"OpenAI's 403 for a country\")\n    {\n        Responses r(\"openai\");\n        r.fake->refuse(403, R\"({\"error\":{\"code\":\"unsupported_country_region_territory\",\"message\":\"Country, region, or territory not supported\",\"param\":null,\"type\":\"request_forbidden\"}})\");\n        CHECK_THROWS_WITH(r.failure(), Catch::Matchers::ContainsSubstring(\"unsupported_country_region_territory\"));\n    }\n    SECTION(\"a failed response for a picture\")\n    {\n        Responses r(\"openai\");\n        r.fake->data(sse(kCreated) + sse(json{{\"type\", \"response.failed\"}, {\"response\", json{\n            {\"error\", json{{\"code\", \"invalid_image_format\"}, {\"message\", \"Invalid image format.\"}}}}}}));\n        CHECK_THROWS_WITH(r.failure(), Catch::Matchers::ContainsSubstring(\"invalid_image_format\"));\n    }\n    SECTION(\"the gateway's unexpected answer\")\n    {\n        Responses r(\"jusprin\");\n        r.fake->data(sse(kCreated) + sse(json{{\"type\", \"error\"}, {\"code\", \"server_error\"}, {\"message\", \"Something went wrong on our side\"}}));\n        CHECK_THROWS_WITH(r.failure(), Catch::Matchers::ContainsSubstring(\"server_error\"));\n    }\n}\n\nTEST_CASE(\"reported usage carries the cached share of the input\", \"[agent][openai][usage]\")","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"sandboxed":false,"sourceToolAssistantUUID":"56838f57-cbc7-4dfe-b588-c631ccd91612","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"userType":"external","entrypoint":"claude-desktop","cwd":"/Users/kenneth/Projects/JusPrin/.claude/worktrees/misrouted-failures","sessionId":"b575a9e5-080c-46d7-b71a-f5842e099a04","version":"2.1.330","gitBranch":"claude/misrouted-failures","slug":"linear-finding-kay-of-b575a9e5-080c-46d7-b71a-f5842e099a04","dataFlowOn":true}
