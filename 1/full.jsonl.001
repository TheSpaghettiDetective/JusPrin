                      // A refusal of what the key, its account or its settings allow, in the service's words.\n                          {429, R\"({\"error\":{\"message\":\"Rate limit exceeded: limit_rpm\"}})\", \"rate_limited\", true,\n                           \"Test Provider says: \\\\u201cRate limit exceeded: limit_rpm\\\\u201d\"},\n                          {403, R\"({\"error\":{\"message\":\"Country, region, or territory not supported\",\"code\":\"unsupported_country_region_territory\"}})\",\n                           \"provider_refused\", false, \"Test Provider says: \\\\u201cCountry, region, or territory not supported\\\\u201d\"},\n                          {400, R\"({\"error\":{\"message\":\"The requested or resolved service tier is not allowed for the project.\",\"type\":\"invalid_request_error\",\"param\":\"service_tier\"}})\",\n                           \"provider_refused\", false, \"Test Provider says: \\\\u201cThe requested or resolved service tier is not allowed for the project.\\\\u201d\"}};'''\nassert old in s; s=s.replace(old,new,1)\nold2='''    for (const unsigned status : {400u, 403u, 404u, 408u}) {'''\nnew2='''    for (const unsigned status : {400u, 404u, 408u}) {'''\nassert old2 in s; s=s.replace(old2,new2,1)\nopen(p,'w').write(s)\nEOF\nsed -n 40,60p tests/agent/test_provider_agent.cpp"},"caller":{"type":"direct"}}],"container":null,"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":2361,"cache_read_input_tokens":261282,"output_tokens":1405,"output_tokens_details":{"thinking_tokens":181},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":2361,"ephemeral_5m_input_tokens":0},"inference_geo":"global","iterations":[{"input_tokens":2,"output_tokens":1405,"cache_read_input_tokens":261282,"cache_creation_input_tokens":2361,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_t