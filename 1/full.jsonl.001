m.reason}});''','''                         {\"reason\", item.reason},\n                         {\"retryable\", item.retryable}});''')\nsub(c,'''                  {\"printers\", onboarding.orca_printers},''','''                  {\"printers\", onboarding.orca_printers},\n                  {\"selected\", onboarding.orca_selected},''')\nsub(c,'''    if (printer.assumed)\n        out[\"assumed\"] = true;''','''    if (printer.assumed)\n        out[\"assumed\"] = true;\n    if (printer.no_connection)\n        out[\"noConnection\"] = true;''')\nEOF\ngrep -n \"Only the name and the status\\|PrinterStatus\\b.*status\" HomeSnapshot.hpp | head","description":"Add the new snapshot fields and their JSON"},"caller":{"type":"direct"}}]}}
