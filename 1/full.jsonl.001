{"parentUuid":"a17fb771-8933-4f83-8a0c-ee1e6a1ad710","isSidechain":false,"promptId":"a87f93ac-7f7c-43ec-a4cd-0785d69b9cce","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Mop8QLjyen42oDZr7rH681","type":"tool_result","content":"+    // model for this key's account (Sentry JUSPRIN-APP-E).\n+    if (status == 404)\n+        return says.code == \"model_not_found\" || starts_with(says.message, \"No endpoints found\");\n+    return status == 402 || status == 403 || status == 429 || (status == 400 && says.param == \"service_tier\");\n+}\n+\n+// What the service said, after its name, for a cause it explains itself.\n+AgentError service_said(const char* code, const std::string& name, const std::string& words, bool retryable)\n+{\n+    return {code, said_by(name, words), retryable};\n+}\n+\n+AgentError could_not_reach(const std::string& name)\n+{\n+    // TRN %1% is an AI provider, such as OpenAI.\n+    return {\"network_error\", Slic3r::format(translated(L(\"The AI request could not reach the %1% service.\")), name), true};\n+}\n+\n AgentError provider_out_of_credits(const std::string& name)\n {\n     return {\"provider_credits_exhausted\",\n@@ -826,9 +876,7 @@ AgentError ProviderAgent::http_error(const AgentHttpEvent& event)\n     if (event.status < 400 && m_config.profile.on_this_computer)\n         return expected(local_unreachable(m_config.profile.endpoint), \"could not be reached\", event.error);\n     if (event.status < 400)\n-        // TRN %1% is an AI provider, such as OpenAI.\n-        return expected({\"network_error\", Slic3r::format(translated(L(\"The AI request could not reach the %1% service.\")), m_config.profile.display_name), true},\n-                        \"could not be reached\", event.error);\n+        return expected(could_not_reach(m_config.profile.display_name), \"could not be reached\", event.error);\n     std::optional<AgentError> expected;\n     if (m_config.profile.account_sign_in) {\n         expected = update_required(event.status, event.data);\n@@ -885,8 +933,22 @@ std::optional<AgentError> ProviderAgent::provider_answer(unsigned status, const\n         return AgentError{\"invalid_credentials\", Slic3r::format(translated(L(\"The %1% API key was rejected. Update the AI configuration and try again.\")), name), false};\n     if (too_long(status, says))\n         return too_large(name);\n-    if (status == 429)\n-        return rate_limited(name);\n+    if (says.message.empty()) {\n+        if (status == 429)\n+            return rate_limited(name);\n+        // The service down and answering with a web page or nothing, the\n+        // usual shape of an outage: its trouble, not reported, and the person\n+        // does what they do when it cannot be reached.\n+        if (service_trouble(status, says))\n+            return could_not_reach(name);\n+        return std::nullopt;\n+    }\n+    if (service_trouble(status, says))\n+        return service_said(\"provider_unavailable\", name, says.message, true);\n+    if (refused_the_person(status, says)) {\n+        const bool too_many = status == 429 || says.code == \"rate_limit_exceeded\" || says.error_type == \"rate_limit_exceeded\";\n+        return service_said(too_many ? \"rate_limited\" : \"provider_refused\", name, says.message, too_many);\n+    }\n     return std::nullopt;\n }\n \n712:+// The deletion `status` says: the server deleted it (204), did not answer,\n927:+AgentError service_said(const char* code, const std::string& name, const std::string& words, bool retryable)\n969:+        return service_said(\"provider_unavailable\", name, says.message, true);\n972:+        return service_said(too_many ? \"rate_limited\" : \"provider_refused\", name, says.message, too_many);\n1342:+      error: { code: 'failed', message: 'The app could not write the preset. macOS says: “Permission denied”.',\n1343:+        systemSaid: 'macOS says: “/Users/alex/Library/JusPrin/user/default/filament: Permission denied”' },\n1346:+    expect(screen