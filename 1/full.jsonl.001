  <SignInDoor onboarding={onboarding} onAction={onAction} />\n          <OwnAccountDoor onAction={onAction} disabled={onboarding.signIn === 'checking'} />\"\"\")\np='HomeUI/src/components/PrinterCard.tsx'\nsub(p,\"\"\"import { PrinterActions, PrinterMenu } from './PrinterMenu';\"\"\",\"\"\"import { PrinterActions, PrinterMenu } from './PrinterMenu';\nimport { STAND_IN_PRINTER } from './Onboarding';\"\"\")\nsub(p,\"\"\"      <p className=\"no-printer-text\">Files slice for a generic 0.4 mm printer until you add yours.</p>\"\"\",\"\"\"      <p className=\"no-printer-text\">{STAND_IN_PRINTER}</p>\"\"\")\nsub(p,\"\"\"// printer reports. Only the name and the status are always there. Nothing\n// stands in for a field the printer did not report.\"\"\",\"\"\"// printer reports. Only the name and the status are always there, but on a\n// printer with no connection ever set up, where the card says what\n// connecting is for instead. Nothing stands in for a field the printer did\n// not report.\"\"\")\nsub(p,\"\"\"      <div className=\"printer-status\">\n        {!quiet && <span className={`status-dot ${printer.status}`} aria-hidden=\"true\" />}\n        <span className=\"printer-status-text\">\n          <span className={quiet ? 'printer-status-word quiet' : 'printer-status-word'}>{STATUS_WORD[printer.status]}</span>\n          {detail && <span className=\"printer-status-detail\"> · {detail}</span>}\n        </span>\n      </div>\"\"\",\"\"\"      {!printer.noConnection && (\n        <div className=\"printer-status\">\n          {!quiet && <span className={`status-dot ${printer.status}`} aria-hidden=\"true\" />}\n          <span className=\"printer-status-text\">\n            <span className={quiet ? 'printer-status-word quiet' : 'printer-status-word'}>{STATUS_WORD[printer.status]}</span>\n            {detail && <span className=\"printer-status-detail\"> · {detail}</span>}\n          </span>\n        </div>\n      )}\"\"\")\nsub(p,\"\"\"      {(printer.action === 'reconnect' || printer.action === 'connect') && actions.onConnect && (\n        <button type=\"button\" className=\"button-secondary launch-monitor\" onClick={() => actions.onConnect?.(printer.id)}>\n          {printer.action === 'reconnect' ? 'Reconnect' : 'Connect…'}\n        </button>\n      )}\"\"\",\"\"\"      {(printer.action === 'reconnect' || printer.action === 'connect') && actions.onConnect && (\n        <div className=\"printer-connect-row\">\n          <button type=\"button\" className=\"button-secondary launch-monitor\" onClick={() => actions.onConnect?.(printer.id)}>\n            {printer.action === 'reconnect' ? 'Reconnect' : 'Connect…'}\n          </button>\n          {printer.noConnection && <span className=\"printer-connect-why\">Connect it to send prints straight from JusPrin</span>}\n        </div>\n      )}\"\"\")\np='HomeUI/src/App.tsx'\nsub(p,\"\"\"                    ? 'JusPrin slices it for a generic 0.4 mm printer until you add yours.'\"\"\",\"\"\"                    ? STAND_IN_PRINTER\"\"\")\nEOF\ngrep -n \"^import.*Onboarding\" HomeUI/src/App.tsx","description":"Update the Agent card, printer card and drop zone"},"caller":{"type":"direct"}}]}}
