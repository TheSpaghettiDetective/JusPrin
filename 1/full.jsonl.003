d\n    if (injectionTime != wxWEBVIEW_INJECT_AT_DOCUMENT_START)\n        return false;\n\n    if (m_impl->m_webView)\n    {\n        HRESULT hr = m_impl->m_webView->AddScriptToExecuteOnDocumentCreated(javascript.wc_str(),\n            Callback<ICoreWebView2AddScriptToExecuteOnDocumentCreatedCompletedHandler>(m_impl,\n            &wxWebViewEdgeImpl::OnAddScriptToExecuteOnDocumentedCreatedCompleted).Get());\n        if (FAILED(hr))\n            return false;\n    }\n    else\n        m_impl->m_pendingUserScripts.push_back(javascript);\n\n    return true;\n}\n--- mac handler\n1325:      didReceiveScriptMessage:(nonnull WKScriptMessage *)message\n1326-{\n1327-    // Handle internal fullscreen message independent of user message handlers\n1328-    if ([message.name isEqualToString:@\"__wxfullscreen\"])\n1329-    {\n1330-        wxWebViewEvent event(wxEVT_WEBVIEW_FULLSCREEN_CHANGED, webKitWindow->GetId(),\n1331-            webKitWindow->GetCurrentURL(), wxString());\n1332-        event.SetEventObject(webKitWindow);\n1333-        event.SetInt(((NSNumber*)message.body).intValue);\n1334-        webKitWindow->HandleWindowEvent(event);\n1335-        return;\n1336-    }\n1337-\n1338-    wxWebViewEvent event(wxEVT_WEBVIEW_SCRIPT_MESSAGE_RECEIVED,\n1339-                         webKitWindow->GetId(),\n1340-                         webKitWindow->GetCurrentURL(),","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"sandboxed":false,"sourceToolAssistantUUID":"67f98328-79df-414b-a921-9d1a39c374c6","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"userType":"external","entrypoint":"claude-desktop","cwd":"/Users/kenneth/Projects","sessionId":"473348c5-5f94-4e4d-9ad9-c7e9dd10b438","version":"2.1.309","gitBranch":"jusprin-newui","slug":"glimmering-doodling-lovelace"}
