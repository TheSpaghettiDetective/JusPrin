r 3D print '\n          'of #3DBenchy v13” (flickr.com/photos/3dbenchy/19239738473) by #3DBenchy, CC BY 2.0. Cropped and resized.')\n\n# ---- the clip: one frame of the animatic, 620 x 388, positioned as animatic.html positions it ----------------------------------------\nCLIP_W, CLIP_H = 620, 388\nABS = BOX + 'position:absolute;'\nPHOTO_BIG, PHOTO_CORNER = (236, 14, 368, 230), (16, 16, 184, 115)","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"sandboxed":false,"sourceToolAssistantUUID":"29add447-6b51-4387-9d7c-3ed5c72da7d4","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"userType":"external","entrypoint":"claude-desktop","cwd":"/Users/kenneth/.claude/projects/-Users-kenneth-Projects-JusPrin/figma-mirror/tools/composer","sessionId":"473348c5-5f94-4e4d-9ad9-c7e9dd10b438","version":"2.1.309","gitBranch":"jusprin-newui","slug":"glimmering-doodling-lovelace"}
