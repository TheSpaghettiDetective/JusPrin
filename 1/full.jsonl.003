{"parentUuid":"c9905109-0c28-44e6-907a-b5775d614abd","isSidechain":false,"promptId":"7f668efa-054d-4724-a408-dee0c47b11e4","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_014543zQw5jjcynmYAqr5KMr","type":"tool_result","content":"1\t// The first launch: the welcome, then the Printers step. Each screen is the\n2\t// board of the same name on the \"JusPrin v2\" canvas's \"On boarding\n3\t// experience\" page (first-run-welcome-01, first-run-04 to 08). The host\n4\t// decides which is in front (Home/OnboardingModel) and carries out every\n5\t// door; this file only draws them.\n6\t//\n7\t// Every door on the welcome comes back into the sequence: signing in waits on\n8\t// the offer card, Preferences closes back onto the welcome, and \"Just slice\n9\t// for now\" moves on at once.\n10\t\n11\timport { useEffect, useRef, useState } from 'react';\n12\timport type { Appearance, EmailSignIn, OnboardingState } from '../bridge/protocol';\n13\timport { afterPaint } from '@shared/afterPaint';\n14\timport { SIGNUP_OFFER, SIGNUP_SCALE, signedInCredits } from '../../../AgentUI/src/credits';\n15\timport { OrcaImportResultLines, OrcaPrinterList } from '../../../AgentUI/src/components/OrcaImportLists';\n16\timport lockupLight from '@resources/jusprin/overlay/images/OrcaSlicer_horizontal_light.svg';\n17\timport lockupDark from '@resources/jusprin/overlay/images/OrcaSlicer_horizontal_dark.svg';\n18\timport clip from '@resources/jusprin/welcome/welcome-clip.mp4';\n19\timport googleMark from '@resources/jusprin/welcome/google-g.svg';\n20\timport { CodeField } from './CodeField';\n21\timport { CheckGlyph, FolderGlyph } from './Glyphs';\n22\timport { PrinterPickerHost } from './PrinterPickerHost';\n23\timport type { PrinterPick } from '../../../AgentUI/src/components/PrinterPicker';\n24\t\n25\t// What Skip installs: OrcaSlicer's Generic Klipper Printer, its 250 × 250 mm\n26\t// bed and Klipper G-code (OrcaHomeBackend::assume_default_printer). Home's\n27\t// \"No printer yet\" card and its drop zone say the same.\n28\texport const STAND_IN_PRINTER = 'Until you add yours, files are sliced for a 250 mm Klipper printer and may not print on other printers.';\n29\t\n30\t// How long the card says who signed in before the Printers step.\n31\tconst SIGNED_IN_PAUSE_MS = 1500;\n32\t\n33\ttype Action = (type: string, payload?: object) => void;\n34\t\n35\tinterface Props {\n36\t  onboarding: OnboardingState;\n37\t  appearance: Appearance;\n38\t  error?: string;\n39\t  onAction: Action;\n40\t}\n41\t\n42\t// The JusPrin lockup in the window's top-left corner, as the welcome boards\n43\t// anchor it; the welcome has no header of its own.\n44\tfunction Lockup({ appearance }: { appearance: Appearance }) {\n45\t  return <img className=\"onboarding-lockup\" src={appearance === 'dark' ? lockupDark : lockupLight} alt=\"JusPrin\" />;\n46\t}\n47\t\n48\t// What the server's refusal means to the person.\n49\tfunction refusalText(email: EmailSignIn): string {\n50\t  switch (email.refusal) {\n51\t    case 'wrong_code':\n52\t      return 'That code is wrong.';\n53\t    case 'expired_code':\n54\t      return 'That code no longer works. We can send a new one.';\n55\t    case 'too_many_tries':\n56\t      return 'Too many tries. Wait a few minutes, or email me a code.';\n57\t    case 'too_many_codes':\n58\t      return 'Too many codes were sent to this address. Try again in an hour.';\n59\t    case 'wrong_password':\n60\t      return 'That password is wrong.';\n61\t    default:\n62\t      return '';\n63\t  }\n64\t}\n65\t\n66\t// Links in a row, separated by middle dots, with Cancel apart on the right.\n67\tfunction LinkRow({ links, cancel }: { links: [string, () => void][]; cancel?: () => void }) {\n68\t  return (\n69\t    <div className=\"onboarding-link-row\">\n70\t      <span className=\"onboarding-links\">\n71\t        {links.map(([label, onClick], index) => (\n72\t          <span key={label}>\n73\t            {index > 0 && <span className=\"onboarding-link-dot\" aria-hidden=\"true\">·</span>}\n74\t            <button type=\"button\" className=\"onboarding-link flush\" onClick={onClick}>{label}</button>\n75\t          </span>\n76\t        ))}\n77\t      </span>\n78\t      {cancel && <button type=\"button\" className=\"onboarding-link flush\" onClick={cancel}>Cancel</button>}\n79\t    </div>\n80\t  );\n81\t}\n82\t\n83\t// The email door's code step (canvas boards first-run-14 to 16).\n84\tfunction CodeStep({ email, onAction, onChangeEmail, onBrowser }: {\n85\t  email: EmailSignIn; onAction: Action; onChangeEmail: () => void; onBrowser: () => void;\n86\t}) {\n87\t  const [code, setCode] = useState('');\n88\t  const field = useRef<HTMLInputElement>(null);\n89\t  const refusal = refusalText(email);\n90\t  // A code that can no longer work: the way on is a new one.\n91\t  const spent = email.refusal === 'expired_code';\n92\t  const sendCode = () => onAction('onboarding_sign_in_send_code');\n93\t  // A new code empties the cells; so does typing after a wrong one.\n94\t  useEffect(() => {\n95\t    if (email.codeResent) setCode('');\n96\t  }, [email.codeResent]);\n97\t  useEffect(() => {\n98\t    if (email.refusal === 'wrong_code' && !email.busy) setCode('');\n99\t  }, [email.refusal, email.busy]);\n100\t  useEffect(() => {\n101\t    if (!email.busy) field.current?.focus();\n102\t  }, [email.busy]);\n103\t  return (\n104\t    <>\n105\t      <p className=\"onboarding-door-title\">Check your email.</p>\n106\t      <p className=\"onboarding-door-detail\">\n107\t        {email.codeResent ? 'We sent a new code to ' : 'We sent a 6-digit code to '}\n108\t        {email.email}.\n109\t      </p>\n110\t      <CodeField\n111\t        ref={field}\n112\t        value={code}\n113\t        refused={email.refusal === 'wrong_code' || spent}\n114\t        disabled={email.busy}\n115\t        onChange={setCode}\n116\t        onComplete={(digits) => onAction('onboarding_sign_in_code', { code: digits })}\n117\t      />\n118\t      {refusal ? (\n119\t        <p className=\"onboarding-error\" role=\"alert\">{refusal}</p>\n120\t      ) : (\n121\t        <p className=\"onboarding-door-note\">Type the code from the email. You can open it on your phone.</p>\n122\t      )}\n123\t      {spent ? (\n124\t        <div className=\"onboarding-link-row onboarding-new-code-row\">\n125\t          <button type=\"button\" className=\"button-primary\" disabled={email.busy} onClick={sendCode}>Send a new code</button>\n126\t          <LinkRow links={[['Change email', onChangeEmail], ['Sign in with Google instead', onBrowser]]} />\n127\t        </div>\n128\t      ) : (\n129\t        <LinkRow\n130\t          links={[['Send a new code', sendCode], ['Change email', onChangeEmail], ['Sign in with Google instead', onBrowser]]}\n131\t          cancel={() => onAction('onboarding_sign_in_cancel')}\n132\t        />\n133\t      )}\n134\t    </>\n135\t  );\n136\t}\n137\t\n138\t// The email door before anything is sent: an emailed code, which also\n139\t// makes the account of an address that has none, and, for someone who set\n140\t// one, the password behind \"Use a password instead\".\n141\tfunction ChooseStep({ email, onAction, onChangeEmail }: { email: EmailSignIn; onAction: Action; onChangeEmail: () => void }) {\n142\t  const [password, setPassword] = useState('');\n143\t  const [withPassword, setWithPassword] = useState(email.refusal === 'wrong_password');\n144\t  const refusal = refusalText(email);\n145\t  const codeRefused = email.refusal === 'too_many_codes';\n146\t  return (\n147\t    <>\n148\t      <p className=\"onboarding-door-title\">We’ll email you a code.</p>\n149\t      <p className=\"onboarding-door-detail\">\n150\t        {email.email}.{' '}\n151\t        <button type=\"button\" className=\"onboarding-link inline\" onClick={onChangeEmail}>Change email</button>\n152\t      </p>\n153\t      <button type=\"button\" className=\"button-primary onboarding-code-button\" disabled={email.busy}\n154\t        onClick={() => onAction('onboarding_sign_in_send_code')}>\n155\t        Email me a 6-digit code\n156\t      </button>\n157\t      {codeRefused && <p className=\"onboarding-error\" role=\"alert\">{refusal}</p>}\n158\t      {withPassword ? (\n159\t        <>\n160\t          <p className=\"onboarding-or\"><span>or</span></p>\n161\t          <form className=\"onboarding-email-row\" onSubmit={(event) => {\n162\t            event.preventDefault();\n163\t            if (password) onAction('onboarding_sign_in_password', { password });\n164\t          }}>\n165\t            <input className=\"onboarding-field\" type=\"password\" placeholder=\"Password\" autoComplete=\"current-password\"\n166\t              aria-label=\"Password\" value={password} disabled={email.busy} autoFocus\n167\t              onChange={(event) => setPassword(event.target.value)} />\n168\t            <button type=\"submit\" className=\"button-secondary\" disabled={email.busy || !password}>Sign in</button>\n169\t          </form>\n170\t          {refusal && !codeRefused && <p className=\"onboarding-error\" role=\"alert\">{refusal}</p>}\n171\t          <LinkRow\n172\t            links={[['Forgot password', () => onAction('onboarding_open_link', { link: 'reset_password' })]]}\n173\t            cancel={() => onAction('onboarding_sign_in_cancel')}\n174\t          />\n175\t        </>\n176\t      ) : (\n177\t        <LinkRow links={[['Use a password instead', () => setWithPassword(true)]]} cancel={() => onAction('onboarding_sign_in_cancel')} />\n178\t      )}\n179\t    </>\n180\t  );\n181\t}\n182\t\n183\t// Who signed in, under what signing in got them: the free credits a new\n184\t// account was just given, or what an account used before has left.\n185\tfunction SignedIn({ onboarding }: { onboarding: OnboardingState }) {\n186\t  const account = onboarding.account;\n187\t  if (!account) return <p className=\"onboarding-door-title\" role=\"status\">Signed in as {onboarding.accountEmail}</p>;\n188\t  return (\n189\t    <div role=\"status\">\n190\t      <p className=\"onboarding-door-title\">{signedInCredits(account)}</p>\n191\t      <p className=\"onboarding-door-detail\">Signed in as {onboarding.accountEmail}</p>\n192\t    </div>\n193\t  );\n194\t}\n195\t\n196\t// The first door, on the welcome and in Home's Agent group alike: the\n197\t// sign-up offer, Google in the browser or an email that stays in the app,\n198\t// each step of either, and who signed in. Signing up and signing in are\n199\t// the same door: an address with no account gets one from its first code.\n200\t// Returns the words and controls only; the caller frames them.\n201\texport function SignInDoor({ onboarding, onAction, offer }: { onboarding: OnboardingState; onAction: Action; offer?: boolean }) {\n202\t  // The address typed at rest, kept for \"Change email\".\n203\t  const [address, setAddress] = useState('');\n204\t  const addressField = useRef<HTMLInputElement>(null);\n205\t  const [focusAddress, setFocusAddress] = useState(false);\n206\t  useEffect(() => {\n207\t    if (focusAddress && onboarding.signIn === 'idle') {\n208\t      addressField.current?.focus();\n209\t      setFocusAddress(false);\n210\t    }\n211\t  }, [focusAddress, onboarding.signIn]);\n212\t  const backToAddress = () => {\n213\t    onAction('onboarding_sign_in_cancel');\n214\t    setFocusAddress(true);\n215\t  };\n216\t  const browser = () => {\n217\t    onAction('onboarding_sign_in_cancel');\n218\t    onAction('onboarding_sign_in');\n219\t  };\n220\t\n221\t  const email = onboarding.email;\n222\t  if (onboarding.signIn === 'email' && email && email.step === 'code')\n223\t    return <CodeStep email={email} onAction={onAction} onChangeEmail={backToAddress} onBrowser={browser} />;\n224\t  if (onboarding.signIn === 'email' && email)\n225\t    return <ChooseStep email={email} onAction={onAction} onChangeEmail={backToAddress} />;\n226\t  if (onboarding.signIn === 'browser') {\n227\t    return (\n228\t      <>\n229\t        <p className=\"onboarding-door-title onboarding-waiting\">\n230\t          <span className=\"onboarding-spinner\" aria-hidden=\"true\" />\n231\t          Finish in your browser.\n232\t        </p>\n233\t        <p className=\"onboarding-door-detail\">The app continues on its own once the browser is done.</p>\n234\t        <p className=\"onboarding-door-note\">\n235\t          Nothing happened?{' '}\n236\t          <button type=\"button\" className=\"onboarding-link inline\" onClick={() => onAction('onboarding_sign_in_reopen')}>\n237\t            Open the browser again\n238\t          </button>\n239\t        </p>\n240\t        <LinkRow links={[['Use an email code instead', backToAddress]]} cancel={() => onAction('onboarding_sign_in_cancel')} />\n241\t      </>\n242\t    );\n243\t  }\n244\t  if (onboarding.signIn === 'checking') {\n245\t    return (\n246\t      <>\n247\t        <p className=\"onboarding-door-title onboarding-waiting\">\n248\t          <span className=\"onboarding-spinner\" aria-hidden=\"true\" />\n249\t          Signing you in…\n250\t        </p>\n251\t        <LinkRow links={[]} cancel={() => onAction('onboarding_sign_in_cancel')} />\n252\t      </>\n253\t    );\n254\t  }\n255\t  if (onboarding.accountEmail) return <SignedIn onboarding={onboarding} />;\n256\t  // At rest.\n257\t  const sendEmail = () => {\n258\t    const typed = address.trim();\n259\t    if (typed) onAction('onboarding_sign_in_email', { email: typed });\n260\t    else addressField.current?.focus();\n261\t  };\n262\t  return (\n263\t    <>\n264\t      {offer && <p className=\"onboarding-door-title\">{SIGNUP_OFFER}</p>}\n265\t      {offer && <p className=\"onboarding-door-detail\">{SIGNUP_SCALE}</p>}\n266\t      {offer && onboarding.v1Imported && (\n267\t        <p className=\"onboarding-door-detail\">Subscribed to JusPrin v1? You get these 500 credits and keep your original price.</p>\n268\t      )}\n269\t      <button type=\"button\" className=\"button-secondary onboarding-google\"\n270\t        onClick={() => onAction('onboarding_sign_in')}>\n271\t        <img src={googleMark} alt=\"\" />\n272\t        Continue with Google\n273\t      </button>\n274\t      <p className=\"onboarding-or\"><span>or</span></p>\n275\t      <form className=\"onboarding-email-row\" onSubmit={(event) => {\n276\t        event.preventDefault();\n277\t        sendEmail();\n278\t      }}>\n279\t        <input ref={addressField} className=\"onboarding-field\" type=\"email\" placeholder=\"you@example.com\" autoComplete=\"email\"\n280\t          aria-label=\"Email\" value={address} onChange={(event) => setAddress(event.target.value)} />\n281\t        <button type=\"submit\" className=\"button-primary\" disabled={!address.trim()}>Sign up free</button>\n282\t      </form>\n283\t      <p className=\"onboarding-door-note\">\n284\t        Already have an account?{' '}\n285\t        <button type=\"button\" className=\"onboarding-link inline\" onClick={sendEmail}>Sign in</button>\n286\t      </p>\n287\t      <p className=\"onboarding-door-note\">Google opens your browser; email stays here.</p>\n288\t      <p className=\"onboarding-door-note\">\n289\t        By continuing you agree to the{' '}\n290\t        <button type=\"button\" className=\"onboarding-link inline\" onClick={() => onAction('onboarding_open_link', { link: 'terms' })}>\n291\t          Terms\n292\t        </button>{' '}\n293\t        and{' '}\n294\t        <button type=\"button\" className=\"onboarding-link inline\" onClick={() => onAction('onboarding_open_link', { link: 'privacy' })}>\n295\t          Privacy Policy\n296\t        </button>\n297\t        .\n298\t      </p>\n299\t      {onboarding.signInError && <p className=\"onboarding-error\" role=\"alert\">{onboarding.signInError}</p>}\n300\t    </>\n301\t  );\n302\t}\n303\t\n304\t// The agent on the person's own AI account, an API key or Claude Code and\n305\t// Claude Desktop: Preferences › Agent explains both, and closes back here.\n306\texport function OwnAccountDoor({ onAction, disabled }: { onAction: Action; disabled: boolean }) {\n307\t  return (\n308\t    <button type=\"button\" className=\"onboarding-link flush\" disabled={disabled}\n309\t      onClick={() => onAction('onboarding_open_preferences', { door: 'key' })}>\n310\t      Use your own AI account instead\n311\t    </button>\n312\t  );\n313\t}\n314\t\n315\tfunction Welcome({ onboarding, appearance, onAction }: Props) {\n316\t  const signingIn = onboarding.signIn !== 'idle';\n317\t  // The other doors stay open while the person signs in, as canvas boards\n318\t  // first-run-04 and 12 to 16 draw them, and close only while the account is read.\n319\t  const checking = onboarding.signIn === 'checking';\n320\t  // Only a sign-in finished here moves on by itself. Someone who comes Back\n321\t  // already signed in sees who, and goes on with Continue.\n322\t  const waited = useRef(false);\n323\t  if (signingIn) waited.current = true;\n324\t  const signedIn = Boolean(onboarding.accountEmail) && !signingIn;\n325\t  useEffect(() => {\n326\t    if (!signedIn || !waited.current) return;\n327\t    const timer = setTimeout(() => onAction('onboarding_leave_welcome'), SIGNED_IN_PAUSE_MS);\n328\t    return () => clearTimeout(timer);\n329\t  }, [signedIn, onAction]);\n330\t\n331\t  return (\n332\t    <div className=\"onboarding\">\n333\t      <Lockup appearance={appearance} />\n334\t      <div className=\"onboarding-welcome\">\n335\t        <figure className=\"onboarding-clip\">\n336\t          <video src={clip} autoPlay loop muted playsInline aria-label=\"The agent fixing a print that came out stringy\" />\n337\t          <details className=\"onboarding-credits\">\n338\t            <summary>Photo credits</summary>\n339\t            <p>\n340\t              “Dual extrusion 3D printed #3DBenchy v01” by #3DBenchy, flickr.com/photos/3dbenchy/19273965123, CC BY 2.0\n341\t              (creativecommons.org/licenses/by/2.0). Cropped.\n342\t            </p>\n343\t            <p>\n344\t              “Dual-print multi-part color 3D print of #3DBenchy v13” by #3DBenchy, flickr.com/photos/3dbenchy/19239738473,\n345\t              CC BY 2.0 (creativecommons.org/licenses/by/2.0). Cropped and resized.\n346\t            </p>\n347\t          </details>\n348\t        </figure>\n349\t        <div className=\"onboarding-pitch\">\n350\t          <div className=\"onboarding-heading\">\n351\t            <h1>The AI slicer that fixes failed prints.</h1>\n352\t            <p className=\"onboarding-lead\">\n353\t              Show it a photo of what went wrong. The agent reads your file, your settings and your slice, changes the settings\n354\t              and slices again.\n355\t            </p>\n356\t          </div>\n357\t          <div className=\"onboarding-doors\">\n358\t            <p className=\"onboarding-doors-label\">Sign up to use the AI agent, or skip it and just slice.</p>\n359\t            <div className=\"onboarding-offer\">\n360\t              <SignInDoor onboarding={onboarding} onAction={onAction} offer />\n361\t              {signedIn && !waited.current && (\n362\t                <button type=\"button\" className=\"button-primary onboarding-door-button\"\n363\t                  onClick={() => onAction('onboarding_leave_welcome')}>\n364\t                  Continue\n365\t                </button>\n366\t              )}\n367\t            </div>\n368\t            <OwnAccountDoor onAction={onAction} disabled={checking || (signedIn && waited.current)} />\n369\t            <button type=\"button\" className=\"onboarding-link flush\" disabled={checking || (signedIn && waited.current)}\n370\t              onClick={() => onAction('onboarding_leave_welcome')}>\n371\t              Just slice for now\n372\t            </button>\n373\t          </div>\n374\t        </div>\n375\t      </div>\n376\t    </div>\n377\t  );\n378\t}\n379\t\n380\t// What the welcome finished, above the first printer screen's headline:\n381\t// who signed in, or whose key the agent uses. Nothing after \"Just slice for\n382\t// now\".\n383\tfunction WelcomeDone({ onboarding }: { onboarding: OnboardingState }) {\n384\t  const { account, accountEmail } = onboarding;\n385\t  if (accountEmail && account) {\n386\t    return (\n387\t      <div className=\"onboarding-done\">\n388\t        <CheckGlyph />\n389\t        <span className=\"onboarding-done-text\">\n390\t          <span>{signedInCredits(account)}</span>\n391\t          <span className=\"onboarding-done-detail\">Signed in as {accountEmail}</span>\n392\t        </span>\n393\t      </div>\n394\t    );\n395\t  }\n396\t  const text = accountEmail ? `Signed in as ${accountEmail}`\n397\t    : onboarding.agentKeyProvider ? `The agent uses your ${onboarding.agentKeyProvider} key` : '';\n398\t  if (!text) return null;\n399\t  return <p className=\"onboarding-done\"><CheckGlyph />{text}</p>;\n400\t}\n401\t\n402\t// Importing holds the app on the action's message, so the button says so\n403\t// first and the message goes once that has been painted. The host answers\n404\t// every action with fresh state.\n405\tfunction useBusy(onAction: Action, onboarding: OnboardingState) {\n406\t  const [busy, setBusy] = useState(false);\n407\t  useEffect(() => setBusy(false), [onboarding]);\n408\t  const run = (type: string, payload?: object) => {\n409\t    setBusy(true);\n410\t    afterPaint(() => onAction(type, payload));\n411\t  };\n412\t  return [busy, run] as const;\n413\t}\n414\t\n415\t// The printer JusPrin selects once the import is done, as the importer\n416\t// picks it: OrcaSlicer's own, while it is ticked, otherwise the first ticked.\n417\tfunction startsWith(orca: OnboardingState['orca'], chosen: string[]): string {\n418\t  const ticked = orca.printers.filter((name) => chosen.includes(name));\n419\t  if (ticked.length === 0) return '';\n420\t  if (ticked.includes(orca.selected)) return `JusPrin starts with ${orca.selected}, the printer OrcaSlicer had selected.`;\n421\t  return `JusPrin starts with ${ticked[0]}.`;\n422\t}\n423\t\n424\tfunction OrcaImport({ onboarding, error, onAction }: Props) {\n425\t  const { orca } = onboarding;\n426\t  const [busy, run] = useBusy(onAction, onboarding);\n427\t  // Every printer starts ticked; only the ticked ones are imported.\n428\t  const [chosen, setChosen] = useState(orca.printers);\n429\t  const listed = orca.printers.join('\\n');\n430\t  useEffect(() => setChosen(orca.printers), [listed]);\n431\t  const choose = (name: string, ticked: boolean) =>\n432\t    setChosen((now) => (ticked ? [...now, name] : now.filter((one) => one !== name)));\n433\t  const starts = startsWith(orca, chosen);\n434\t  return (\n435\t    <div className=\"onboarding-step\">\n436\t      <WelcomeDone onboarding={onboarding} />\n437\t      <div className=\"onboarding-heading\">\n438\t        <h1>Bring your printers from OrcaSlicer?</h1>\n439\t        <p className=\"onboarding-lead\">\n440\t          JusPrin copies these printers with their filaments, settings and printer connections. OrcaSlicer keeps its own copy.\n441\t        </p>\n442\t      </div>\n443\t      <OrcaPrinterList printers={orca.printers.map((name) => ({ name, already: false }))} chosen={chosen} onChoose={choose}\n444\t        disabled={busy} />\n445\t      <div className=\"onboarding-source\">\n446\t        {orca.filamentCount > 0 && (\n447\t          <p>Also brings {orca.filamentCount === 1 ? '1 filament' : `${orca.filamentCount} filaments`}.</p>\n448\t        )}\n449\t        <p className=\"onboarding-source-folder\">\n450\t          <FolderGlyph />\n451\t          <span className=\"onboarding-source-path\">{orca.source}</span>\n452\t        </p>\n453\t      </div>\n454\t      {starts && <p className=\"onboarding-lead\">{starts}</p>}\n455\t      {error && <p className=\"onboarding-error\" role=\"alert\">{error}</p>}\n456\t      <div className=\"onboarding-actions\">\n457\t        <button type=\"button\" className=\"button-primary\" disabled={busy || chosen.length === 0}\n458\t          onClick={() => run('onboarding_import', { printers: chosen })}>\n459\t          {busy ? 'Importing…' : 'Import'}\n460\t        </button>\n461\t        <button type=\"button\" className=\"button-secondary\" disabled={busy} onClick={() => onAction('onboarding_start_fresh')}>\n462\t          Choose my printer instead\n463\t        </button>\n464\t      </div>\n465\t      <button type=\"button\" className=\"onboarding-link flush\" disabled={busy} onClick={() => onAction('onboarding_back')}>Back</button>\n466\t    </div>\n467\t  );\n468\t}\n469\t\n470\tfunction ImportResult({ onboarding, error, onAction }: Props) {\n471\t  const items = onboarding.orca.importResult ?? [];\n472\t  // Only a failure that can go another way is offered again.\n473\t  const retryable = items.some((item) => item.retryable);\n474\t  const [busy, run] = useBusy(onAction, onboarding);\n475\t  return (\n476\t    <div className=\"onboarding-step\">\n477\t      <div className=\"onboarding-heading\">\n478\t        <h1>Imported from OrcaSlicer</h1>\n479\t      </div>\n480\t      <OrcaImportResultLines lines={items} />\n481\t      {error && <p className=\"onboarding-error\" role=\"alert\">{error}</p>}\n482\t      <div className=\"onboarding-actions\">\n483\t        <button type=\"button\" className=\"button-primary\" disabled={busy} onClick={() => onAction('onboarding_import_continue')}>\n484\t          Continue\n485\t        </button>\n486\t        {retryable && (\n487\t          <button type=\"button\" className=\"button-secondary\" disabled={busy} onClick={() => run('onboarding_import_retry')}>\n488\t            {busy ? 'Importing…' : 'Retry failed items'}\n489\t          </button>\n490\t        )}\n491\t      </div>\n492\t    </div>\n493\t  );\n494\t}\n495\t\n496\t// \"Which printer do you have?\": the printer and its nozzle, added with its\n497\t// profile's own plate and filament. The dialog Home's \"+ Add printer\" opens\n498\t// asks for those too.\n499\tfunction ChoosePrinter({ onboarding, error, onAction }: Props) {\n500\t  const form = onboarding.printerForm;\n501\t  const [pick, setPick] = useState<PrinterPick>({});\n502\t  const { catalogId, nozzle, deviceId } = pick;\n503\t  // Continue waits for the app: it either leaves for Home or says why not.\n504\t  const [finishing, setFinishing] = useState(false);\n505\t  useEffect(() => { setFinishing(false); }, [form?.error]);\n506\t  useEffect(() => {\n507\t    if (catalogId && nozzle !== undefined) onAction('onboarding_printer_form', { action: 'form_options', catalogId, nozzle });\n508\t  }, [catalogId, nozzle]);\n509\t  // The options the app sent for exactly this choice, and none for another.\n510\t  const options = form?.options && form.options.catalogId === catalogId && form.options.nozzle === nozzle ? form.options : undefined;\n511\t  const ready = options !== undefined && !form?.loading && !options.error;\n512\t  // The agent can help only when it can answer: an account with credits, or a key.\n513\t  const agentReady = onboarding.agentKeyProvider !== '' ||\n514\t    (onboarding.accountEmail !== '' && (onboarding.account?.credits.total ?? 0) > 0);\n515\t\n516\t  const finish = () => {\n517\t    if (!options || !catalogId || nozzle === undefined) return;\n518\t    const plate = options.plates.some((entry) => entry.type === options.defaultPlate) ? options.defaultPlate : options.plates[0]?.type;\n519\t    setFinishing(true);\n520\t    onAction('onboarding_printer_form', { action: 'form_finish', catalogId, nozzle,\n521\t      ...(options.plates.length > 0 ? { plate } : {}), ...(deviceId ? { deviceId } : {}) });\n522\t  };\n523\t\n524\t  return (\n525\t    <div className=\"onboarding-step\">\n526\t      {!onboarding.orca.found && <WelcomeDone onboarding={onboarding} />}\n527\t      <div className=\"onboarding-heading\">\n528\t        <h1>Which printer do you have?</h1>\n529\t        <p className=\"onboarding-lead\">\n530\t          JusPrin plans every print for your printer: its bed, its nozzle and the filament it starts with. You can add more\n531\t          printers later.\n532\t        </p>\n533\t      </div>\n534\t      {form ? (\n535\t        <PrinterPickerHost form={form} pick={pick} onPick={setPick}\n536\t          reading={Boolean(form.loading && catalogId && nozzle !== undefined)}\n537\t          onAskAgent={agentReady ? () => onAction('onboarding_ask_agent') : undefined} />\n538\t      ) : (\n539\t        <p className=\"onboarding-lead\" role=\"status\">Reading the printer list…</p>\n540\t      )}\n541\t      {options?.error && <p className=\"onboarding-error\" role=\"alert\">{options.error}</p>}\n542\t      {form?.error && <p className=\"onboarding-error\" role=\"alert\">{form.error}</p>}\n543\t      {error && <p className=\"onboarding-error\" role=\"alert\">{error}</p>}\n544\t      <div className=\"onboarding-step-group\">\n545\t        <div className=\"onboarding-actions\">\n546\t          <button type=\"button\" className=\"button-primary\" disabled={!ready || finishing} onClick={finish}>Continue</button>\n547\t          <button type=\"button\" className=\"onboarding-link\" onClick={() => onAction('onboarding_assume_default')}>Skip for now</button>\n548\t        </div>\n549\t        <p className=\"onboarding-note\">{STAND_IN_PRINTER}</p>\n550\t      </div>\n551\t      <button type=\"button\" className=\"onboarding-link flush\" onClick={() => onAction('onboarding_back')}>Back</button>\n552\t    </div>\n553\t  );\n554\t}\n555\t\n556\texport function Onboarding(props: Props) {\n557\t  if (props.onboarding.step === 'welcome') return <Welcome {...props} />;\n558\t  return (\n559\t    <div className=\"onboarding\">\n560\t      <Lockup appearance={props.appearance} />\n561\t      {props.onboarding.printersScreen === 'orca_import' ? <OrcaImport {...props} />\n562\t        : props.onboarding.printersScreen === 'import_result' ? <ImportResult {...props} />\n563\t          : <ChoosePrinter {...props} />}\n564\t    </div>\n565\t  );\n566\t}\n567\t"}]},"uuid":"27898989-9a18-4635-9c54-9b6a6363ee6a","timestamp":"2026-11-06T18:33:18.602Z","toolUseResult":{"type":"text","file":{"filePath":"/Users/kenneth/Projects/JusPrin/src/slic3r/GUI/JusPrin/HomeUI/src/components/Onboarding.tsx","content":"// The first launch: the welcome, then the Printers step. Each screen is the\n// board of the same name on the \"JusPrin v2\" canvas's \"On boarding\n// experience\" page (first-run-welcome-01, first-run-04 to 08). The host\n// decides which is in front (Home/OnboardingModel) and carries out every\n// door; this file only draws them.\n//\n// Every door on the welcome comes back into the sequence: signing in waits on\n// the offer card, Preferences closes back onto the welcome, and \"Just slice\n// for now\" moves on at once.\n\nimport { useEffect, useRef, useState } from 'react';\nimport type { Appearance, EmailSignIn, OnboardingState } from '../bridge/protocol';\nimport { afterPaint } from '@shared/afterPaint';\nimport { SIGNUP_OFFER, SIGNUP_SCALE, signedInCredits } from '../../../AgentUI/src/credits';\nimport { OrcaImportResultLines, OrcaPrinterList } from '../../../AgentUI/src/components/OrcaImportLists';\nimport lockupLight from '@resources/jusprin/overlay/images/OrcaSlicer_horizontal_light.svg';\nimport lockupDark from '@resources/jusprin/overlay/images/OrcaSlicer_horizontal_dark.svg';\nimport clip from '@resources/jusprin/welcome/welcome-clip.mp4';\nimport googleMark from '@resources/jusprin/welcome/google-g.svg';\nimport { CodeField } from './CodeField';\nimport { CheckGlyph, FolderGlyph } from './Glyphs';\nimport { PrinterPickerHost } from './PrinterPickerHost';\nimport type { PrinterPick } from '../../../AgentUI/src/components/PrinterPicker';\n\n// What Skip installs: OrcaSlicer's Generic Klipper Printer, its 250 × 250 mm\n// bed and Klipper G-code (OrcaHomeBackend::assume_default_printer). Home's\n// \"No printer yet\" card and its drop zone say the same.\nexport const STAND_IN_PRINTER = 'Until you add yours, files are sliced for a 250 mm Klipper printer and may not print on other printers.';\n\n// How long the card says who signed in before the Printers step.\nconst SIGNED_IN_PAUSE_MS = 1500;\n\ntype Action = (type: string, payload?: object) => void;\n\ninterface Props {\n  onboarding: OnboardingState;\n  appearance: Appearance;\n  error?: string;\n  onAction: Action;\n}\n\n// The JusPrin lockup in the window's top-left corner, as the welcome boards\n// anchor it; the welcome has no header of its own.\nfunction Lockup({ appearance }: { appearance: Appearance }) {\n  return <img className=\"onboarding-lockup\" src={appearance === 'dark' ? lockupDark : lockupLight} alt=\"JusPrin\" />;\n}\n\n// What the server's refusal means to the person.\nfunction refusalText(email: EmailSignIn): string {\n  switch (email.refusal) {\n    case 'wrong_code':\n      return 'That code is wrong.';\n    case 'expired_code':\n      return 'That code no longer works. We can send a new one.';\n    case 'too_many_tries':\n      return 'Too many tries. Wait a few minutes, or email me a code.';\n    case 'too_many_codes':\n      return 'Too many codes were sent to this address. Try again in an hour.';\n    case 'wrong_password':\n      return 'That password is wrong.';\n    default:\n      return '';\n  }\n}\n\n// Links in a row, separated by middle dots, with Cancel apart on the right.\nfunction LinkRow({ links, cancel }: { links: [string, () => void][]; cancel?: () => void }) {\n  return (\n    <div className=\"onboarding-link-row\">\n      <span className=\"onboarding-links\">\n        {links.map(([label, onClick], index) => (\n          <span key={label}>\n            {index > 0 && <span className=\"onboarding-link-dot\" aria-hidden=\"true\">·</span>}\n            <button type=\"button\" className=\"onboarding-link flush\" onClick={onClick}>{label}</button>\n          </span>\n        ))}\n      </span>\n      {cancel && <button type=\"button\" className=\"onboarding-link flush\" onClick={cancel}>Cancel</button>}\n    </div>\n  );\n}\n\n// The email door's code step (canvas boards first-run-14 to 16).\nfunction CodeStep({ email, onAction, onChangeEmail, onBrowser }: {\n  email: EmailSignIn; onAction: Action; onChangeEmail: () => void; onBrowser: () => void;\n}) {\n  const [code, setCode] = useState('');\n  const field = useRef<HTMLInputElement>(null);\n  const refusal = refusalText(email);\n  // A code that can no longer work: the way on is a new one.\n  const spent = email.refusal === 'expired_code';\n  const sendCode = () => onAction('onboarding_sign_in_send_code');\n  // A new code empties the cells; so does typing after a wrong one.\n  useEffect(() => {\n    if (email.codeResent) setCode('');\n  }, [email.codeResent]);\n  useEffect(() => {\n    if (email.refusal === 'wrong_code' && !email.busy) setCode('');\n  }, [email.refusal, email.busy]);\n  useEffect(() => {\n    if (!email.busy) field.current?.focus();\n  }, [email.busy]);\n  return (\n    <>\n      <p className=\"onboarding-door-title\">Check your email.</p>\n      <p className=\"onboarding-door-detail\">\n        {email.codeResent ? 'We sent a new code to ' : 'We sent a 6-digit code to '}\n        {email.email}.\n      </p>\n      <CodeField\n        ref={field}\n        value={code}\n        refused={email.refusal === 'wrong_code' || spent}\n        disabled={email.busy}\n        onChange={setCode}\n        onComplete={(digits) => onAction('onboarding_sign_in_code', { code: digits })}\n      />\n      {refusal ? (\n        <p className=\"onboarding-error\" role=\"alert\">{refusal}</p>\n      ) : (\n        <p className=\"onboarding-door-note\">Type the code from the email. You can open it on your phone.</p>\n      )}\n      {spent ? (\n        <div className=\"onboarding-link-row onboarding-new-code-row\">\n          <button type=\"button\" className=\"button-primary\" disabled={email.busy} onClick={sendCode}>Send a new code</button>\n          <LinkRow links={[['Change email', onChangeEmail], ['Sign in with Google instead', onBrowser]]} />\n        </div>\n      ) : (\n        <LinkRow\n          links={[['Send a new code', sendCode], ['Change email', onChangeEmail], ['Sign in with Google instead', onBrowser]]}\n          cancel={() => onAction('onboarding_sign_in_cancel')}\n        />\n      )}\n    </>\n  );\n}\n\n// The email door before anything is sent: an emailed code, which also\n// makes the account of an address that has none, and, for someone who set\n// one, the password behind \"Use a password instead\".\nfunction ChooseStep({ email, onAction, onChangeEmail }: { email: EmailSignIn; onAction: Action; onChangeEmail: () => void }) {\n  const [password, setPassword] = useState('');\n  const [withPassword, setWithPassword] = useState(email.refusal === 'wrong_password');\n  const refusal = refusalText(email);\n  const codeRefused = email.refusal === 'too_many_codes';\n  return (\n    <>\n      <p className=\"onboarding-door-title\">We’ll email you a code.</p>\n      <p className=\"onboarding-door-detail\">\n        {email.email}.{' '}\n        <button type=\"button\" className=\"onboarding-link inline\" onClick={onChangeEmail}>Change email</button>\n      </p>\n      <button type=\"button\" className=\"button-primary onboarding-code-button\" disabled={email.busy}\n        onClick={() => onAction('onboarding_sign_in_send_code')}>\n        Email me a 6-digit code\n      </button>\n      {codeRefused && <p className=\"onboarding-error\" role=\"alert\">{refusal}</p>}\n      {withPassword ? (\n        <>\n          <p className=\"onboarding-or\"><span>or</span></p>\n          <form className=\"onboarding-email-row\" onSubmit={(event) => {\n            event.preventDefault();\n            if (password) onAction('onboarding_sign_in_password', { password });\n          }}>\n            <input className=\"onboarding-field\" type=\"password\" placeholder=\"Password\" autoComplete=\"current-password\"\n              aria-label=\"Password\" value={password} disabled={email.busy} autoFocus\n              onChange={(event) => setPassword(event.target.value)} />\n            <button type=\"submit\" className=\"button-secondary\" disabled={email.busy || !password}>Sign in</button>\n          </form>\n          {refusal && !codeRefused && <p className=\"onboarding-error\" role=\"alert\">{refusal}</p>}\n          <LinkRow\n            links={[['Forgot password', () => onAction('onboarding_open_link', { link: 'reset_password' })]]}\n            cancel={() => onAction('onboarding_sign_in_cancel')}\n          />\n        </>\n      ) : (\n        <LinkRow links={[['Use a password instead', () => setWithPassword(true)]]} cancel={() => onAction('onboarding_sign_in_cancel')} />\n      )}\n    </>\n  );\n}\n\n// Who signed in, under what signing in got them: the free credits a new\n// account was just given, or what an account used before has left.\nfunction SignedIn({ onboarding }: { onboarding: OnboardingState }) {\n  const account = onboarding.account;\n  if (!account) return <p className=\"onboarding-door-title\" role=\"status\">Signed in as {onboarding.accountEmail}</p>;\n  return (\n    <div role=\"status\">\n      <p className=\"onboarding-door-title\">{signedInCredits(account)}</p>\n      <p className=\"onboarding-door-detail\">Signed in as {onboarding.accountEmail}</p>\n    </div>\n  );\n}\n\n// The first door, on the welcome and in Home's Agent group alike: the\n// sign-up offer, Google in the browser or an email that stays in the app,\n// each step of either, and who signed in. Signing up and signing in are\n// the same door: an address with no account gets one from its first code.\n// Returns the words and controls only; the caller frames them.\nexport function SignInDoor({ onboarding, onAction, offer }: { onboarding: OnboardingState; onAction: Action; offer?: boolean }) {\n  // The address typed at rest, kept for \"Change email\".\n  const [address, setAddress] = useState('');\n  const addressField = useRef<HTMLInputElement>(null);\n  const [focusAddress, setFocusAddress] = useState(false);\n  useEffect(() => {\n    if (focusAddress && onboarding.signIn === 'idle') {\n      addressField.current?.focus();\n      setFocusAddress(false);\n    }\n  }, [focusAddress, onboarding.signIn]);\n  const backToAddress = () => {\n    onAction('onboarding_sign_in_cancel');\n    setFocusAddress(true);\n  };\n  const browser = () => {\n    onAction('onboarding_sign_in_cancel');\n    onAction('onboarding_sign_in');\n  };\n\n  const email = onboarding.email;\n  if (onboarding.signIn === 'email' && email && email.step === 'code')\n    return <CodeStep email={email} onAction={onAction} onChangeEmail={backToAddress} onBrowser={browser} />;\n  if (onboarding.signIn === 'email' && email)\n    return <ChooseStep email={email} onAction={onAction} onChangeEmail={backToAddress} />;\n  if (onboarding.signIn === 'browser') {\n    return (\n      <>\n        <p className=\"onboarding-door-title onboarding-waiting\">\n          <span className=\"onboarding-spinner\" aria-hidden=\"true\" />\n          Finish in your browser.\n        </p>\n        <p className=\"onboarding-door-detail\">The app continues on its own once the browser is done.</p>\n        <p className=\"onboarding-door-note\">\n          Nothing happened?{' '}\n          <button type=\"button\" className=\"onboarding-link inline\" onClick={() => onAction('onboarding_sign_in_reopen')}>\n            Open the browser again\n          </button>\n        </p>\n        <LinkRow links={[['Use an email code instead', backToAddress]]} cancel={() => onAction('onboarding_sign_in_cancel')} />\n      </>\n    );\n  }\n  if (onboarding.signIn === 'checking') {\n    return (\n      <>\n        <p className=\"onboarding-door-title onboarding-waiting\">\n          <span className=\"onboarding-spinner\" aria-hidden=\"true\" />\n          Signing you in…\n        </p>\n        <LinkRow links={[]} cancel={() => onAction('onboarding_sign_in_cancel')} />\n      </>\n    );\n  }\n  if (onboarding.accountEmail) return <SignedIn onboarding={onboarding} />;\n  // At rest.\n  const sendEmail = () => {\n    const typed = address.trim();\n    if (typed) onAction('onboarding_sign_in_email', { email: typed });\n    else addressField.current?.focus();\n  };\n  return (\n    <>\n      {offer && <p className=\"onboarding-door-title\">{SIGNUP_OFFER}</p>}\n      {offer && <p className=\"onboarding-door-detail\">{SIGNUP_SCALE}</p>}\n      {offer && onboarding.v1Imported && (\n        <p className=\"onboarding-door-detail\">Subscribed to JusPrin v1? You get these 500 credits and keep your original price.</p>\n      )}\n      <button type=\"button\" className=\"button-secondary onboarding-google\"\n        onClick={() => onAction('onboarding_sign_in')}>\n        <img src={googleMark} alt=\"\" />\n        Continue with Google\n      </button>\n      <p className=\"onboarding-or\"><span>or</span></p>\n      <form className=\"onboarding-email-row\" onSubmit={(event) => {\n        event.preventDefault();\n        sendEmail();\n      }}>\n        <input ref={addressField} className=\"onboarding-field\" type=\"email\" placeholder=\"you@example.com\" autoComplete=\"email\"\n          aria-label=\"Email\" value={address} onChange={(event) => setAddress(event.target.value)} />\n        <button type=\"submit\" className=\"button-primary\" disabled={!address.trim()}>Sign up free</button>\n      </form>\n      <p className=\"onboarding-door-note\">\n        Already have an account?{' '}\n        <button type=\"button\" className=\"onboarding-link inline\" onClick={sendEmail}>Sign in</button>\n      </p>\n      <p className=\"onboarding-door-note\">Google opens your browser; email stays here.</p>\n      <p className=\"onboarding-door-note\">\n        By continuing you agree to the{' '}\n        <button type=\"button\" className=\"onboarding-link inline\" onClick={() => onAction('onboarding_open_link', { link: 'terms' })}>\n          Terms\n        </button>{' '}\n        and{' '}\n        <button type=\"button\" className=\"onboarding-link inline\" onClick={() => onAction('onboarding_open_link', { link: 'privacy' })}>\n          Privacy Policy\n        </button>\n        .\n      </p>\n      {onboarding.signInError && <p className=\"onboarding-error\" role=\"alert\">{onboarding.signInError}</p>}\n    </>\n  );\n}\n\n// The agent on the person's own AI account, an API key or Claude Code and\n// Claude Desktop: Preferences › Agent explains both, and closes back here.\nexport function OwnAccountDoor({ onAction, disabled }: { onAction: Action; disabled: boolean }) {\n  return (\n    <button type=\"button\" className=\"onboarding-link flush\" disabled={disabled}\n      onClick={() => onAction('onboarding_open_preferences', { door: 'key' })}>\n      Use your own AI account instead\n    </button>\n  );\n}\n\nfunction Welcome({ onboarding, appearance, onAction }: Props) {\n  const signingIn = onboarding.signIn !== 'idle';\n  // The other doors stay open while the person signs in, as canvas boards\n  // first-run-04 and 12 to 16 draw them, and close only while the account is read.\n  const checking = onboarding.signIn === 'checking';\n  // Only a sign-in finished here moves on by itself. Someone who comes Back\n  // already signed in sees who, and goes on with Continue.\n  const waited = useRef(false);\n  if (signingIn) waited.current = true;\n  const signedIn = Boolean(onboarding.accountEmail) && !signingIn;\n  useEffect(() => {\n    if (!signedIn || !waited.current) return;\n    const timer = setTimeout(() => onAction('onboarding_leave_welcome'), SIGNED_IN_PAUSE_MS);\n    return () => clearTimeout(timer);\n  }, [signedIn, onAction]);\n\n  return (\n    <div className=\"onboarding\">\n      <Lockup appearance={appearance} />\n      <div className=\"onboarding-welcome\">\n        <figure className=\"onboarding-clip\">\n          <video src={clip} autoPlay loop muted playsInline aria-label=\"The agent fixing a print that came out stringy\" />\n          <details className=\"onboarding-credits\">\n            <summary>Photo credits</summary>\n            <p>\n              “Dual extrusion 3D printed #3DBenchy v01” by #3DBenchy, flickr.com/photos/3dbenchy/19273965123, CC BY 2.0\n              (creativecommons.org/licenses/by/2.0). Cropped.\n            </p>\n            <p>\n              “Dual-print multi-part color 3D print of #3DBenchy v13” by #3DBenchy, flickr.com/photos/3dbenchy/19239738473,\n              CC BY 2.0 (creativecommons.org/licenses/by/2.0). Cropped and resized.\n            </p>\n          </details>\n        </figure>\n        <div className=\"onboarding-pitch\">\n          <div className=\"onboarding-heading\">\n            <h1>The AI slicer that fixes failed prints.</h1>\n            <p className=\"onboarding-lead\">\n              Show it a photo of what went wrong. The agent reads your file, your settings and your slice, changes the settings\n              and slices again.\n            </p>\n          </div>\n          <div className=\"onboarding-doors\">\n            <p className=\"onboarding-doors-label\">Sign up to use the AI agent, or skip it and just slice.</p>\n            <div className=\"onboarding-offer\">\n              <SignInDoor onboarding={onboarding} onAction={onAction} offer />\n              {signedIn && !waited.current && (\n                <button type=\"button\" className=\"button-primary onboarding-door-button\"\n                  onClick={() => onAction('onboarding_leave_welcome')}>\n                  Continue\n                </button>\n              )}\n            </div>\n            <OwnAccountDoor onAction={onAction} disabled={checking || (signedIn && waited.current)} />\n            <button type=\"button\" className=\"onboarding-link flush\" disabled={checking || (signedIn && waited.current)}\n              onClick={() => onAction('onboarding_leave_welcome')}>\n              Just slice for now\n            </button>\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n}\n\n// What the welcome finished, above the first printer screen's headline:\n// who signed in, or whose key the agent uses. Nothing after \"Just slice for\n// now\".\nfunction WelcomeDone({ onboarding }: { onboarding: OnboardingState }) {\n  const { account, accountEmail } = onboarding;\n  if (accountEmail && account) {\n    return (\n      <div className=\"onboarding-done\">\n        <CheckGlyph />\n        <span className=\"onboarding-done-text\">\n          <span>{signedInCredits(account)}</span>\n          <span className=\"onboarding-done-detail\">Signed in as {accountEmail}</span>\n        </span>\n      </div>\n    );\n  }\n  const text = accountEmail ? `Signed in as ${accountEmail}`\n    : onboarding.agentKeyProvider ? `The agent uses your ${onboarding.agentKeyProvider} key` : '';\n  if (!text) return null;\n  return <p className=\"onboarding-done\"><CheckGlyph />{text}</p>;\n}\n\n// Importing holds the app on the action's message, so the button says so\n// first and the message goes once that has been painted. The host answers\n// every action with fresh state.\nfunction useBusy(onAction: Action, onboarding: OnboardingState) {\n  const [busy, setBusy] = useState(false);\n  useEffect(() => setBusy(false), [onboarding]);\n  const run = (type: string, payload?: object) => {\n    setBusy(true);\n    afterPaint(() => onAction(type, payload));\n  };\n  return [busy, run] as const;\n}\n\n// The printer JusPrin selects once the import is done, as the importer\n// picks it: OrcaSlicer's own, while it is ticked, otherwise the first ticked.\nfunction startsWith(orca: OnboardingState['orca'], chosen: string[]): string {\n  const ticked = orca.printers.filter((name) => chosen.includes(name));\n  if (ticked.length === 0) return '';\n  if (ticked.includes(orca.selected)) return `JusPrin starts with ${orca.selected}, the printer OrcaSlicer had selected.`;\n  return `JusPrin starts with ${ticked[0]}.`;\n}\n\nfunction OrcaImport({ onboarding, error, onAction }: Props) {\n  const { orca } = onboarding;\n  const [busy, run] = useBusy(onAction, onboarding);\n  // Every printer starts ticked; only the ticked ones are imported.\n  const [chosen, setChosen] = useState(orca.printers);\n  const listed = orca.printers.join('\\n');\n  useEffect(() => setChosen(orca.printers), [listed]);\n  const choose = (name: string, ticked: boolean) =>\n    setChosen((now) => (ticked ? [...now, name] : now.filter((one) => one !== name)));\n  const starts = startsWith(orca, chosen);\n  return (\n    <div className=\"onboarding-step\">\n      <WelcomeDone onboarding={onboarding} />\n      <div className=\"onboarding-heading\">\n        <h1>Bring your printers from OrcaSlicer?</h1>\n        <p className=\"onboarding-lead\">\n          JusPrin copies these printers with their filaments, settings and printer connections. OrcaSlicer keeps its own copy.\n        </p>\n      </div>\n      <OrcaPrinterList printers={orca.printers.map((name) => ({ name, already: false }))} chosen={chosen} onChoose={choose}\n        disabled={busy} />\n      <div className=\"onboarding-source\">\n        {orca.filamentCount > 0 && (\n          <p>Also brings {orca.filamentCount === 1 ? '1 filament' : `${orca.filamentCount} filaments`}.</p>\n        )}\n        <p className=\"onboarding-source-folder\">\n          <FolderGlyph />\n          <span className=\"onboarding-source-path\">{orca.source}</span>\n        </p>\n      </div>\n      {starts && <p className=\"onboarding-lead\">{starts}</p>}\n      {error && <p className=\"onboarding-error\" role=\"alert\">{error}</p>}\n      <div className=\"onboarding-actions\">\n        <button type=\"button\" className=\"button-primary\" disabled={busy || chosen.length === 0}\n          onClick={() => run('onboarding_import', { printers: chosen })}>\n          {busy ? 'Importing…' : 'Import'}\n        </button>\n        <button type=\"button\" className=\"button-secondary\" disabled={busy} onClick={() => onAction('onboarding_start_fresh')}>\n          Choose my printer instead\n        </button>\n      </div>\n      <button type=\"button\" className=\"onboarding-link flush\" disabled={busy} onClick={() => onAction('onboarding_back')}>Back</button>\n    </div>\n  );\n}\n\nfunction ImportResult({ onboarding, error, onAction }: Props) {\n  const items = onboarding.orca.importResult ?? [];\n  // Only a failure that can go another way is offered again.\n  const retryable = items.some((item) => item.retryable);\n  const [busy, run] = useBusy(onAction, onboarding);\n  return (\n    <div className=\"onboarding-step\">\n      <div className=\"onboarding-heading\">\n        <h1>Imported from OrcaSlicer</h1>\n      </div>\n      <OrcaImportResultLines lines={items} />\n      {error && <p className=\"onboarding-error\" role=\"alert\">{error}</p>}\n      <div className=\"onboarding-actions\">\n        <button type=\"button\" className=\"button-primary\" disabled={busy} onClick={() => onAction('onboarding_import_continue')}>\n          Continue\n        </button>\n        {retryable && (\n          <button type=\"button\" className=\"button-secondary\" disabled={busy} onClick={() => run('onboarding_import_retry')}>\n            {busy ? 'Importing…' : 'Retry failed items'}\n          </button>\n        )}\n      </div>\n    </div>\n  );\n}\n\n// \"Which printer do you have?\": the printer and its nozzle, added with its\n// profile's own plate and filament. The dialog Home's \"+ Add printer\" opens\n// asks for those too.\nfunction ChoosePrinter({ onboarding, error, onAction }: Props) {\n  const form = onboarding.printerForm;\n  const [pick, setPick] = useState<PrinterPick>({});\n  const { catalogId, nozzle, deviceId } = pick;\n  // Continue waits for the app: it either leaves for Home or says why not.\n  const [finishing, setFinishing] = useState(false);\n  useEffect(() => { setFinishing(false); }, [form?.error]);\n  useEffect(() => {\n    if (catalogId && nozzle !== undefined) onAction('onboarding_printer_form', { action: 'form_options', catalogId, nozzle });\n  }, [catalogId, nozzle]);\n  // The options the app sent for exactly this choice, and none for another.\n  const options = form?.options && form.options.catalogId === catalogId && form.options.nozzle === nozzle ? form.options : undefined;\n  const ready = options !== undefined && !form?.loading && !options.error;\n  // The agent can help only when it can answer: an account with credits, or a key.\n  const agentReady = onboarding.agentKeyProvider !== '' ||\n    (onboarding.accountEmail !== '' && (onboarding.account?.credits.total ?? 0) > 0);\n\n  const finish = () => {\n    if (!options || !catalogId || nozzle === undefined) return;\n    const plate = options.plates.some((entry) => entry.type === options.defaultPlate) ? options.defaultPlate : options.plates[0]?.type;\n    setFinishing(true);\n    onAction('onboarding_printer_form', { action: 'form_finish', catalogId, nozzle,\n      ...(options.plates.length > 0 ? { plate } : {}), ...(deviceId ? { deviceId } : {}) });\n  };\n\n  return (\n    <div className=\"onboarding-step\">\n      {!onboarding.orca.found && <WelcomeDone onboarding={onboarding} />}\n      <div className=\"onboarding-heading\">\n        <h1>Which printer do you have?</h1>\n        <p className=\"onboarding-lead\">\n          JusPrin plans every print for your printer: its bed, its nozzle and the filament it starts with. You can add more\n          printers later.\n        </p>\n      </div>\n      {form ? (\n        <PrinterPickerHost form={form} pick={pick} onPick={setPick}\n          reading={Boolean(form.loading && catalogId && nozzle !== undefined)}\n          onAskAgent={agentReady ? () => onAction('onboarding_ask_agent') : undefined} />\n      ) : (\n        <p className=\"onboarding-lead\" role=\"status\">Reading the printer list…</p>\n      )}\n      {options?.error && <p className=\"onboarding-error\" role=\"alert\">{options.error}</p>}\n      {form?.error && <p className=\"onboarding-error\" role=\"alert\">{form.error}</p>}\n      {error && <p className=\"onboarding-error\" role=\"alert\">{error}</p>}\n      <div className=\"onboarding-step-group\">\n        <div className=\"onboarding-actions\">\n          <button type=\"button\" className=\"button-primary\" disabled={!ready || finishing} onClick={finish}>Continue</button>\n          <button type=\"button\" className=\"onboarding-link\" onClick={() => onAction('onboarding_assume_default')}>Skip for now</button>\n        </div>\n        <p className=\"onboarding-note\">{STAND_IN_PRINTER}</p>\n      </div>\n      <button type=\"button\" className=\"onboarding-link flush\" onClick={() => onAction('onboarding_back')}>Back</button>\n    </div>\n  );\n}\n\nexport function Onboarding(props: Props) {\n  if (props.onboarding.step === 'welcome') return <Welcome {...props} />;\n  return (\n    <div className=\"onboarding\">\n      <Lockup appearance={props.appearance} />\n      {props.onboarding.printersScreen === 'orca_import' ? <OrcaImport {...props} />\n        : props.onboarding.printersScreen === 'import_result' ? <ImportResult {...props} />\n          : <ChoosePrinter {...props} />}\n    </div>\n  );\n}\n","numLines":567,"startLine":1,"totalLines":567}},"sourceToolAssistantUUID":"c9905109-0c28-44e6-907a-b5775d614abd","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"userType":"external","entrypoint":"claude-desktop","cwd":"/Users/kenneth/Projects/JusPrin/src/slic3r/GUI/JusPrin","sessionId":"473348c5-5f94-4e4d-9ad9-c7e9dd10b438","version":"2.1.309","gitBranch":"jusprin-newui","slug":"glimmering-doodling-lovelace"}
{"parentUuid":"27898989-9a18-4635-9c54-9b6a6363ee6a","isSidechain":false,"attachment":{"type":"output_style","style":"Plain"},"type":"attachment","uuid":"a898ceea-6cd1-4107-bb21-62a1bb6e9fd6","timestamp":"2026-11-06T18:33:18.611Z","rendered":[{"content":"<system-reminder>\nPlain output style is active. Remember to follow the specific guidelines for this style.\n</system-reminder>"}],"renderedRole":"system","userType":"external","entrypoint":"claude-desktop","cwd":"/Users/kenneth/Projects/JusPrin/src/slic3r/GUI/JusPrin","sessionId":"473348c5-5f94-4e4d-9ad9-c7e9dd10b438","version":"2.1.309","gitBranch":"jusprin-newui","slug":"glimmering-doodling-lovelace"}
{"type":"api-request-blob","sessionId":"473348c5-5f94-4e4d-9ad9-c7e9dd10b438","hash":"906347d41faee951fbe3406c81810ebf592c7ec6298f35e68f95e424285ebcad","message":{"role":"assistant","content":[{"type":"thinking","thinking":"","signature":""},{"type":"text","text":"Looking at today's app screens before redrawing."},{"type":"tool_use","id":"toolu_014FcwboSpxangqMK4JxWNLS","name":"Read","input":{"file_path":"/Users/kenneth/Library/Application Support/Claude/side-session-notes/local_4d17825a-ac19-4732-a080-7e0c1dca6d1c/first-run-fixes-shots/01-welcome-signed-out.jpg"},"caller":{"type":"direct"}},{"type":"tool_use","id":"toolu_014543zQw5jjcynmYAqr5KMr","name":"Read","input":{"file_path":"/Users/kenneth/Projects/JusPrin/src/slic3r/GUI/JusPrin/HomeUI/src/components/Onboarding.tsx"},"caller":{"type":"direct"}}]}}
{"type":"api-request-blob","sessionId":"473348c5-5f94-4e4d-9ad9-c7e9dd10b438","hash":"a023313db9e63c3f3f35bbafdca1e32201ffc89887aee3adcd19fc0d92707e0b","message":{"role":"user","content":[{"tool_use_id":"toolu_014FcwboSpxangqMK4JxWNLS","type":"tool_result","content":[{"type":"image","source":{"type":"base64","data":"","media_type":"image/jpeg"}}]},{"tool_use_id":"toolu_014543zQw5jjcynmYAqr5KMr","type":"tool_result","content":"1\t// The first launch: the welcome, then the Printers step. Each screen is the\n2\t// board of the same name on the \"JusPrin v2\" canvas's \"On boarding\n3\t// experience\" page (first-run-welcome-01, first-run-04 to 08). The host\n4\t// decides which is in front (Home/OnboardingModel) and carries out every\n5\t// door; this file only draws them.\n6\t//\n7\t// Every door on the welcome comes back into the sequence: signing in waits on\n8\t// the offer card, Preferences closes back onto the welcome, and \"Just slice\n9\t// for now\" moves on at once.\n10\t\n11\timport { useEffect, useRef, useState } from 'react';\n12\timport type { Appearance, EmailSignIn, OnboardingState } from '../bridge/protocol';\n13\timport { afterPaint } from '@shared/afterPaint';\n14\timport { SIGNUP_OFFER, SIGNUP_SCALE, signedInCredits } from '../../../AgentUI/src/credits';\n15\timport { OrcaImportResultLines, OrcaPrinterList } from '../../../AgentUI/src/components/OrcaImportLists';\n16\timport lockupLight from '@resources/jusprin/overlay/images/OrcaSlicer_horizontal_light.svg';\n17\timport lockupDark from '@resources/jusprin/overlay/images/OrcaSlicer_horizontal_dark.svg';\n18\timport clip from '@resources/jusprin/welcome/welcome-clip.mp4';\n19\timport googleMark from '@resources/jusprin/welcome/google-g.svg';\n20\timport { CodeField } from './CodeField';\n21\timport { CheckGlyph, FolderGlyph } from './Glyphs';\n22\timport { PrinterPickerHost } from './PrinterPickerHost';\n23\timport type { PrinterPick } from '../../../AgentUI/src/components/PrinterPicker';\n24\t\n25\t// What Skip installs: OrcaSlicer's Generic Klipper Printer, its 250 × 250 mm\n26\t// bed and Klipper G-code (OrcaHomeBackend::assume_default_printer). Home's\n27\t// \"No printer yet\" card and its drop zone say the same.\n28\texport const STAND_IN_PRINTER = 'Until you add yours, files are sliced for a 250 mm Klipper printer and may not print on other printers.';\n29\t\n30\t// How long the card says who signed in before the Printers step.\n31\tconst SIGNED_IN_PAUSE_MS = 1500;\n32\t\n33\ttype Action = (type: string, payload?: object) => void;\n34\t\n35\tinterface Props {\n36\t  onboarding: OnboardingState;\n37\t  appearance: Appearance;\n38\t  error?: string;\n39\t  onAction: Action;\n40\t}\n41\t\n42\t// The JusPrin lockup in the window's top-left corner, as the welcome boards\n43\t// anchor it; the welcome has no header of its own.\n44\tfunction Lockup({ appearance }: { appearance: Appearance }) {\n45\t  return <img className=\"onboarding-lockup\" src={appearance === 'dark' ? lockupDark : lockupLight} alt=\"JusPrin\" />;\n46\t}\n47\t\n48\t// What the server's refusal means to the person.\n49\tfunction refusalText(email: EmailSignIn): string {\n50\t  switch (email.refusal) {\n51\t    case 'wrong_code':\n52\t      return 'That code is wrong.';\n53\t    case 'expired_code':\n54\t      return 'That code no longer works. We can send a new one.';\n55\t    case 'too_many_tries':\n56\t      return 'Too many tries. Wait a few minutes, or email me a code.';\n57\t    case 'too_many_codes':\n58\t      return 'Too many codes were sent to this address. Try again in an hour.';\n59\t    case 'wrong_password':\n60\t      return 'That password is wrong.';\n61\t    default:\n62\t      return '';\n63\t  }\n64\t}\n65\t\n66\t// Links in a row, separated by middle dots, with Cancel apart on the right.\n67\tfunction LinkRow({ links, cancel }: { links: [string, () => void][]; cancel?: () => void }) {\n68\t  return (\n69\t    <div className=\"onboarding-link-row\">\n70\t      <span className=\"onboarding-links\">\n71\t        {links.map(([label, onClick], index) => (\n72\t          <span key={label}>\n73\t            {index > 0 && <span className=\"onboarding-link-dot\" aria-hidden=\"true\">·</span>}\n74\t            <button type=\"button\" className=\"onboarding-link flush\" onClick={onClick}>{label}</button>\n75\t          </span>\n76\t        ))}\n77\t      </span>\n78\t      {cancel && <button type=\"button\" className=\"onboarding-link flush\" onClick={cancel}>Cancel</button>}\n79\t    </div>\n80\t  );\n81\t}\n82\t\n83\t// The email door's code step (canvas boards first-run-14 to 16).\n84\tfunction CodeStep({ email, onAction, onChangeEmail, onBrowser }: {\n85\t  email: EmailSignIn; onAction: Action; onChangeEmail: () => void; onBrowser: () => void;\n86\t}) {\n87\t  const [code, setCode] = useState('');\n88\t  const field = useRef<HTMLInputElement>(null);\n89\t  const refusal = refusalText(email);\n90\t  // A code that can no longer work: the way on is a new one.\n91\t  const spent = email.refusal === 'expired_code';\n92\t  const sendCode = () => onAction('onboarding_sign_in_send_code');\n93\t  // A new code empties the cells; so does typing after a wrong one.\n94\t  useEffect(() => {\n95\t    if (email.codeResent) setCode('');\n96\t  }, [email.codeResent]);\n97\t  useEffect(() => {\n98\t    if (email.refusal === 'wrong_code' && !email.busy) setCode('');\n99\t  }, [email.refusal, email.busy]);\n100\t  useEffect(() => {\n101\t    if (!email.busy) field.current?.focus();\n102\t  }, [email.busy]);\n103\t  return (\n104\t    <>\n105\t      <p className=\"onboarding-door-title\">Check your email.</p>\n106\t      <p className=\"onboarding-door-detail\">\n107\t        {email.codeResent ? 'We sent a new code to ' : 'We sent a 6-digit code to '}\n108\t        {email.email}.\n109\t      </p>\n110\t      <CodeField\n111\t        ref={field}\n112\t        value={code}\n113\t        refused={email.refusal === 'wrong_code' || spent}\n114\t        disabled={email.busy}\n115\t        onChange={setCode}\n116\t        onComplete={(digits) => onAction('onboarding_sign_in_code', { code: digits })}\n117\t      />\n118\t      {refusal ? (\n119\t        <p className=\"onboarding-error\" role=\"alert\">{refusal}</p>\n120\t      ) : (\n121\t        <p className=\"onboarding-door-note\">Type the code from the email. You can open it on your phone.</p>\n122\t      )}\n123\t      {spent ? (\n124\t        <div className=\"onboarding-link-row onboarding-new-code-row\">\n125\t          <button type=\"button\" className=\"button-primary\" disabled={email.busy} onClick={sendCode}>Send a new code</button>\n126\t          <LinkRow links={[['Change email', onChangeEmail], ['Sign in with Google instead', onBrowser]]} />\n127\t        </div>\n128\t      ) : (\n129\t        <LinkRow\n130\t          links={[['Send a new code', sendCode], ['Change email', onChangeEmail], ['Sign in with Google instead', onBrowser]]}\n131\t          cancel={() => onAction('onboarding_sign_in_cancel')}\n132\t        />\n133\t      )}\n134\t    </>\n135\t  );\n136\t}\n137\t\n138\t// The email door before anything is sent: an emailed code, which also\n139\t// makes the account of an address that has none, and, for someone who set\n140\t// one, the password behind \"Use a password instead\".\n141\tfunction ChooseStep({ email, onAction, onChangeEmail }: { email: EmailSignIn; onAction: Action; onChangeEmail: () => void }) {\n142\t  const [password, setPassword] = useState('');\n143\t  const [withPassword, setWithPassword] = useState(email.refusal === 'wrong_password');\n144\t  const refusal = refusalText(email);\n145\t  const codeRefused = email.refusal === 'too_many_codes';\n146\t  return (\n147\t    <>\n148\t      <p className=\"onboarding-door-title\">We’ll email you a code.</p>\n149\t      <p className=\"onboarding-door-detail\">\n150\t        {email.email}.{' '}\n151\t        <button type=\"button\" className=\"onboarding-link inline\" onClick={onChangeEmail}>Change email</button>\n152\t      </p>\n153\t      <button type=\"button\" className=\"button-primary onboarding-code-button\" disabled={email.busy}\n154\t        onClick={() => onAction('onboarding_sign_in_send_code')}>\n155\t        Email me a 6-digit code\n156\t      </button>\n157\t      {codeRefused && <p className=\"onboarding-error\" role=\"alert\">{refusal}</p>}\n158\t      {withPassword ? (\n159\t        <>\n160\t          <p className=\"onboarding-or\"><span>or</span></p>\n161\t          <form className=\"onboarding-email-row\" onSubmit={(event) => {\n162\t            event.preventDefault();\n163\t            if (password) onAction('onboarding_sign_in_password', { password });\n164\t          }}>\n165\t            <input className=\"onboarding-field\" type=\"password\" placeholder=\"Password\" autoComplete=\"current-password\"\n166\t              aria-label=\"Password\" value={password} disabled={email.busy} autoFocus\n167\t              onChange={(event) => setPassword(event.target.value)} />\n168\t            <button type=\"submit\" className=\"button-secondary\" disabled={email.busy || !password}>Sign in</button>\n169\t          </form>\n170\t          {refusal && !codeRefused && <p className=\"onboarding-error\" role=\"alert\">{refusal}</p>}\n171\t          <LinkRow\n172\t            links={[['Forgot password', () => onAction('onboarding_open_link', { link: 'reset_password' })]]}\n173\t            cancel={() => onAction('onboarding_sign_in_cancel')}\n174\t          />\n175\t        </>\n176\t      ) : (\n177\t        <LinkRow links={[['Use a password instead', () => setWithPassword(true)]]} cancel={() => onAction('onboarding_sign_in_cancel')} />\n178\t      )}\n179\t    </>\n180\t  );\n181\t}\n182\t\n183\t// Who signed in, under what signing in got them: the free credits a new\n184\t// account was just given, or what an account used before has left.\n185\tfunction SignedIn({ onboarding }: { onboarding: OnboardingState }) {\n186\t  const account = onboarding.account;\n187\t  if (!account) return <p className=\"onboarding-door-title\" role=\"status\">Signed in as {onboarding.accountEmail}</p>;\n188\t  return (\n189\t    <div role=\"status\">\n190\t      <p className=\"onboarding-door-title\">{signedInCredits(account)}</p>\n191\t      <p className=\"onboarding-door-detail\">Signed in as {onboarding.accountEmail}</p>\n192\t    </div>\n193\t  );\n194\t}\n195\t\n196\t// The first door, on the welcome and in Home's Agent group alike: the\n197\t// sign-up offer, Google in the browser or an email that stays in the app,\n198\t// each step of either, and who signed in. Signing up and signing in are\n199\t// the same door: an address with no account gets one from its first code.\n200\t// Returns the words and controls only; the caller frames them.\n201\texport function SignInDoor({ onboarding, onAction, offer }: { onboarding: OnboardingState; onAction: Action; offer?: boolean }) {\n202\t  // The address typed at rest, kept for \"Change email\".\n203\t  const [address, setAddress] = useState('');\n204\t  const addressField = useRef<HTMLInputElement>(null);\n205\t  const [focusAddress, setFocusAddress] = useState(false);\n206\t  useEffect(() => {\n207\t    if (focusAddress && onboarding.signIn === 'idle') {\n208\t      addressField.current?.focus();\n209\t      setFocusAddress(false);\n210\t    }\n211\t  }, [focusAddress, onboarding.signIn]);\n212\t  const backToAddress = () => {\n213\t    onAction('onboarding_sign_in_cancel');\n214\t    setFocusAddress(true);\n215\t  };\n216\t  const browser = () => {\n217\t    onAction('onboarding_sign_in_cancel');\n218\t    onAction('onboarding_sign_in');\n219\t  };\n220\t\n221\t  const email = onboarding.email;\n222\t  if (onboarding.signIn === 'email' && email && email.step === 'code')\n223\t    return <CodeStep email={email} onAction={onAction} onChangeEmail={backToAddress} onBrowser={browser} />;\n224\t  if (onboarding.signIn === 'email' && email)\n225\t    return <ChooseStep email={email} onAction={onAction} onChangeEmail={backToAddress} />;\n226\t  if (onboarding.signIn === 'browser') {\n227\t    return (\n228\t      <>\n229\t        <p className=\"onboarding-door-title onboarding-waiting\">\n230\t          <span className=\"onboarding-spinner\" aria-hidden=\"true\" />\n231\t          Finish in your browser.\n232\t        </p>\n233\t        <p className=\"onboarding-door-detail\">The app continues on its own once the browser is done.</p>\n234\t        <p className=\"onboarding-door-note\">\n235\t          Nothing happened?{' '}\n236\t          <button type=\"button\" className=\"onboarding-link inline\" onClick={() => onAction('onboarding_sign_in_reopen')}>\n237\t            Open the browser again\n238\t          </button>\n239\t        </p>\n240\t        <LinkRow links={[['Use an email code instead', backToAddress]]} cancel={() => onAction('onboarding_sign_in_cancel')} />\n241\t      </>\n242\t    );\n243\t  }\n244\t  if (onboarding.signIn === 'checking') {\n245\t    return (\n246\t      <>\n247\t        <p className=\"onboarding-door-title onboarding-waiting\">\n248\t          <span className=\"onboarding-spinner\" aria-hidden=\"true\" />\n249\t          Signing you in…\n250\t        </p>\n251\t        <LinkRow links={[]} cancel={() => onAction('onboarding_sign_in_cancel')} />\n252\t      </>\n253\t    );\n254\t  }\n255\t  if (onboarding.accountEmail) return <SignedIn onboarding={onboarding} />;\n256\t  // At rest.\n257\t  const sendEmail = () => {\n258\t    const typed = address.trim();\n259\t    if (typed) onAction('onboarding_sign_in_email', { email: typed });\n260\t    else addressField.current?.focus();\n261\t  };\n262\t  return (\n263\t    <>\n264\t      {offer && <p className=\"onboarding-door-title\">{SIGNUP_OFFER}</p>}\n265\t      {offer && <p className=\"onboarding-door-detail\">{SIGNUP_SCALE}</p>}\n266\t      {offer && onboarding.v1Imported && (\n267\t        <p className=\"onboarding-door-detail\">Subscribed to JusPrin v1? You get these 500 credits and keep your original price.</p>\n268\t      )}\n269\t      <button type=\"button\" className=\"button-secondary onboarding-google\"\n270\t        onClick={() => onAction('onboarding_sign_in')}>\n271\t        <img src={googleMark} alt=\"\" />\n272\t        Continue with Google\n273\t      </button>\n274\t      <p className=\"onboarding-or\"><span>or</span></p>\n275\t      <form className=\"onboarding-email-row\" onSubmit={(event) => {\n276\t        event.preventDefault();\n277\t        sendEmail();\n278\t      }}>\n279\t        <input ref={addressField} className=\"onboarding-field\" type=\"email\" placeholder=\"you@example.com\" autoComplete=\"email\"\n280\t          aria-label=\"Email\" value={address} onChange={(event) => setAddress(event.target.value)} />\n281\t        <button type=\"submit\" className=\"button-primary\" disabled={!address.trim()}>Sign up free</button>\n282\t      </form>\n283\t      <p className=\"onboarding-door-note\">\n284\t        Already have an account?{' '}\n285\t        <button type=\"button\" className=\"onboarding-link inline\" onClick={sendEmail}>Sign in</button>\n286\t      </p>\n287\t      <p className=\"onboarding-door-note\">Google opens your browser; email stays here.</p>\n288\t      <p className=\"onboarding-door-note\">\n289\t        By continuing you agree to the{' '}\n290\t        <button type=\"button\" className=\"onboarding-link inline\" onClick={() => onAction('onboarding_open_link', { link: 'terms' })}>\n291\t          Terms\n292\t        </button>{' '}\n293\t        and{' '}\n294\t        <button type=\"button\" className=\"onboarding-link inline\" onClick={() => onAction('onboarding_open_link', { link: 'privacy' })}>\n295\t          Privacy Policy\n296\t        </button>\n297\t        .\n298\t      </p>\n299\t      {onboarding.signInError && <p className=\"onboarding-error\" role=\"alert\">{onboarding.signInError}</p>}\n300\t    </>\n301\t  );\n302\t}\n303\t\n304\t// The agent on the person's own AI account, an API key or Claude Code and\n305\t// Claude Desktop: Preferences › Agent explains both, and closes back here.\n306\texport function OwnAccountDoor({ onAction, disabled }: { onAction: Action; disabled: boolean }) {\n307\t  return (\n308\t    <button type=\"button\" className=\"onboarding-link flush\" disabled={disabled}\n309\t      onClick={() => onAction('onboarding_open_preferences', { door: 'key' })}>\n310\t      Use your own AI account instead\n311\t    </button>\n312\t  );\n313\t}\n314\t\n315\tfunction Welcome({ onboarding, appearance, onAction }: Props) {\n316\t  const signingIn = onboarding.signIn !== 'idle';\n317\t  // The other doors stay open while the person signs in, as canvas boards\n318\t  // first-run-04 and 12 to 16 draw them, and close only while the account is read.\n319\t  const checking = onboarding.signIn === 'checking';\n320\t  // Only a sign-in finished here moves on by itself. Someone who comes Back\n321\t  // already signed in sees who, and goes on with Continue.\n322\t  const waited = useRef(false);\n323\t  if (signingIn) waited.current = true;\n324\t  const signedIn = Boolean(onboarding.accountEmail) && !signingIn;\n325\t  useEffect(() => {\n326\t    if (!signedIn || !waited.current) return;\n327\t    const timer = setTimeout(() => onAction('onboarding_leave_welcome'), SIGNED_IN_PAUSE_MS);\n328\t    return () => clearTimeout(timer);\n329\t  }, [signedIn, onAction]);\n330\t\n331\t  return (\n332\t    <div className=\"onboarding\">\n333\t      <Lockup appearance={appearance} />\n334\t      <div className=\"onboarding-welcome\">\n335\t        <figure className=\"onboarding-clip\">\n336\t          <video src={clip} autoPlay loop muted playsInline aria-label=\"The agent fixing a print that came out stringy\" />\n337\t          <details className=\"onboarding-credits\">\n338\t            <summary>Photo credits</summary>\n339\t            <p>\n340\t              “Dual extrusion 3D printed #3DBenchy v01” by #3DBenchy, flickr.com/photos/3dbenchy/19273965123, CC BY 2.0\n341\t              (creativecommons.org/licenses/by/2.0). Cropped.\n342\t            </p>\n343\t            <p>\n344\t              “Dual-print multi-part color 3D print of #3DBenchy v13” by #3DBenchy, flickr.com/photos/3dbenchy/19239738473,\n345\t              CC BY 2.0 (creativecommons.org/licenses/by/2.0). Cropped and resized.\n346\t            </p>\n347\t          </details>\n348\t        </figure>\n349\t        <div className=\"onboarding-pitch\">\n350\t          <div className=\"onboarding-heading\">\n351\t            <h1>The AI slicer that fixes failed prints.</h1>\n352\t            <p className=\"onboarding-lead\">\n353\t              Show it a photo of what went wrong. The agent reads your file, your settings and your slice, changes the settings\n354\t              and slices again.\n355\t            </p>\n356\t          </div>\n357\t          <div className=\"onboarding-doors\">\n358\t            <p className=\"onboarding-doors-label\">Sign up to use the AI agent, or skip it and just slice.</p>\n359\t            <div className=\"onboarding-offer\">\n360\t              <SignInDoor onboarding={onboarding} onAction={onAction} offer />\n361\t              {signedIn && !waited.current && (\n362\t                <button type=\"button\" className=\"button-primary onboarding-door-button\"\n363\t                  onClick={() => onAction('onboarding_leave_welcome')}>\n364\t                  Continue\n365\t                </button>\n366\t              )}\n367\t            </div>\n368\t            <OwnAccountDoor onAction={onAction} disabled={checking || (signedIn && waited.current)} />\n369\t            <button type=\"button\" className=\"onboarding-link flush\" disabled={checking || (signedIn && waited.current)}\n370\t              onClick={() => onAction('onboarding_leave_welcome')}>\n371\t              Just slice for now\n372\t            </button>\n373\t          </div>\n374\t        </div>\n375\t      </div>\n376\t    </div>\n377\t  );\n378\t}\n379\t\n380\t// What the welcome finished, above the first printer screen's headline:\n381\t// who signed in, or whose key the agent uses. Nothing after \"Just slice for\n382\t// now\".\n383\tfunction WelcomeDone({ onboarding }: { onboarding: OnboardingState }) {\n384\t  const { account, accountEmail } = onboarding;\n385\t  if (accountEmail && account) {\n386\t    return (\n387\t      <div className=\"onboarding-done\">\n388\t        <CheckGlyph />\n389\t        <span className=\"onboarding-done-text\">\n390\t          <span>{signedInCredits(account)}</span>\n391\t          <span className=\"onboarding-done-detail\">Signed in as {accountEmail}</span>\n392\t        </span>\n393\t      </div>\n394\t    );\n395\t  }\n396\t  const text = accountEmail ? `Signed in as ${accountEmail}`\n397\t    : onboarding.agentKeyProvider ? `The agent uses your ${onboarding.agentKeyProvider} key` : '';\n398\t  if (!text) return null;\n399\t  return <p className=\"onboarding-done\"><CheckGlyph />{text}</p>;\n400\t}\n401\t\n402\t// Importing holds the app on the action's message, so the button says so\n403\t// first and the message goes once that has been painted. The host answers\n404\t// every action with fresh state.\n405\tfunction useBusy(onAction: Action, onboarding: OnboardingState) {\n406\t  const [busy, setBusy] = useState(false);\n407\t  useEffect(() => setBusy(false), [onboarding]);\n408\t  const run = (type: string, payload?: object) => {\n409\t    setBusy(true);\n410\t    afterPaint(() => onAction(type, payload));\n411\t  };\n412\t  return [busy, run] as const;\n413\t}\n414\t\n415\t// The printer JusPrin selects once the import is done, as the importer\n416\t// picks it: OrcaSlicer's own, while it is ticked, otherwise the first ticked.\n417\tfunction startsWith(orca: OnboardingState['orca'], chosen: string[]): string {\n418\t  const ticked = orca.printers.filter((name) => chosen.includes(name));\n419\t  if (ticked.length === 0) return '';\n420\t  if (ticked.includes(orca.selected)) return `JusPrin starts with ${orca.selected}, the printer OrcaSlicer had selected.`;\n421\t  return `JusPrin starts with ${ticked[0]}.`;\n422\t}\n423\t\n424\tfunction OrcaImport({ onboarding, error, onAction }: Props) {\n425\t  const { orca } = onboarding;\n426\t  const [busy, run] = useBusy(onAction, onboarding);\n427\t  // Every printer starts ticked; only the ticked ones are imported.\n428\t  const [chosen, setChosen] = useState(orca.printers);\n429\t  const listed = orca.printers.join('\\n');\n430\t  useEffect(() => setChosen(orca.printers), [listed]);\n431\t  const choose = (name: string, ticked: boolean) =>\n432\t    setChosen((now) => (ticked ? [...now, name] : now.filter((one) => one !== name)));\n433\t  const starts = startsWith(orca, chosen);\n434\t  return (\n435\t    <div className=\"onboarding-step\">\n436\t      <WelcomeDone onboarding={onboarding} />\n437\t      <div className=\"onboarding-heading\">\n438\t        <h1>Bring your printers from OrcaSlicer?</h1>\n439\t        <p className=\"onboarding-lead\">\n440\t          JusPrin copies these printers with their filaments, settings and printer connections. OrcaSlicer keeps its own copy.\n441\t        </p>\n442\t      </div>\n443\t      <OrcaPrinterList printers={orca.printers.map((name) => ({ name, already: false }))} chosen={chosen} onChoose={choose}\n444\t        disabled={busy} />\n445\t      <div className=\"onboarding-source\">\n446\t        {orca.filamentCount > 0 && (\n447\t          <p>Also brings {orca.filamentCount === 1 ? '1 filament' : `${orca.filamentCount} filaments`}.</p>\n448\t        )}\n449\t        <p className=\"onboarding-source-folder\">\n450\t          <FolderGlyph />\n451\t          <span className=\"onboarding-source-path\">{orca.source}</span>\n452\t        </p>\n453\t      </div>\n454\t      {starts && <p className=\"onboarding-lead\">{starts}</p>}\n455\t      {error && <p className=\"onboarding-error\" role=\"alert\">{error}</p>}\n456\t      <div className=\"onboarding-actions\">\n457\t        <button type=\"button\" className=\"button-primary\" disabled={busy || chosen.length === 0}\n458\t          onClick={() => run('onboarding_import', { printers: chosen })}>\n459\t          {busy ? 'Importing…' : 'Import'}\n460\t        </button>\n461\t        <button type=\"button\" className=\"button-secondary\" disabled={busy} onClick={() => onAction('onboarding_start_fresh')}>\n462\t          Choose my printer instead\n463\t        </button>\n464\t      </div>\n465\t      <button type=\"button\" className=\"onboarding-link flush\" disabled={busy} onClick={() => onAction('onboarding_back')}>Back</button>\n466\t    </div>\n467\t  );\n468\t}\n469\t\n470\tfunction ImportResult({ onboarding, error, onAction }: Props) {\n471\t  const items = onboarding.orca.importResult ?? [];\n472\t  // Only a failure that can go another way is offered again.\n473\t  const retryable = items.some((item) => item.retryable);\n474\t  const [busy, run] = useBusy(onAction, onboarding);\n475\t  return (\n476\t    <div className=\"onboarding-step\">\n477\t      <div className=\"onboarding-heading\">\n478\t        <h1>Imported from OrcaSlicer</h1>\n479\t      </div>\n480\t      <OrcaImportResultLines lines={items} />\n481\t      {error && <p className=\"onboarding-error\" role=\"alert\">{error}</p>}\n482\t      <div className=\"onboarding-actions\">\n483\t        <button type=\"button\" className=\"button-primary\" disabled={busy} onClick={() => onAction('onboarding_import_continue')}>\n484\t          Continue\n485\t        </button>\n486\t        {retryable && (\n487\t          <button type=\"button\" className=\"button-secondary\" disabled={busy} onClick={() => run('onboarding_import_retry')}>\n488\t            {busy ? 'Importing…' : 'Retry failed items'}\n489\t          </button>\n490\t        )}\n491\t      </div>\n492\t    </div>\n493\t  );\n494\t}\n495\t\n496\t// \"Which printer do you have?\": the printer and its nozzle, added with its\n497\t// profile's own plate and filament. The dialog Home's \"+ Add printer\" opens\n498\t// asks for those too.\n499\tfunction ChoosePrinter({ onboarding, error, onAction }: Props) {\n500\t  const form = onboarding.printerForm;\n501\t  const [pick, setPick] = useState<PrinterPick>({});\n502\t  const { catalogId, nozzle, deviceId } = pick;\n503\t  // Continue waits for the app: it either leaves for Home or says why not.\n504\t  const [finishing, setFinishing] = useState(false);\n505\t  useEffect(() => { setFinishing(false); }, [form?.error]);\n506\t  useEffect(() => {\n507\t    if (catalogId && nozzle !== undefined) onAction('onboarding_printer_form', { action: 'form_options', catalogId, nozzle });\n508\t  }, [catalogId, nozzle]);\n509\t  // The options the app sent for exactly this choice, and none for another.\n510\t  const options = form?.options && form.options.catalogId === catalogId && form.options.nozzle === nozzle ? form.options : undefined;\n511\t  const ready = options !== undefined && !form?.loading && !options.error;\n512\t  // The agent can help only when it can answer: an account with credits, or a key.\n513\t  const agentReady = onboarding.agentKeyProvider !== '' ||\n514\t    (onboarding.accountEmail !== '' && (onboarding.account?.credits.total ?? 0) > 0);\n515\t\n516\t  const finish = () => {\n517\t    if (!options || !catalogId || nozzle === undefined) return;\n518\t    const plate = options.plates.some((entry) => entry.type === options.defaultPlate) ? options.defaultPlate : options.plates[0]?.type;\n519\t    setFinishing(true);\n520\t    onAction('onboarding_printer_form', { action: 'form_finish', catalogId, nozzle,\n521\t      ...(options.plates.length > 0 ? { plate } : {}), ...(deviceId ? { deviceId } : {}) });\n522\t  };\n523\t\n524\t  return (\n525\t    <div className=\"onboarding-step\">\n526\t      {!onboarding.orca.found && <WelcomeDone onboarding={onboarding} />}\n527\t      <div className=\"onboarding-heading\">\n528\t        <h1>Which printer do you have?</h1>\n529\t        <p className=\"onboarding-lead\">\n530\t          JusPrin plans every print for your printer: its bed, its nozzle and the filament it starts with. You can add more\n531\t          printers later.\n532\t        </p>\n533\t      </div>\n534\t      {form ? (\n535\t        <PrinterPickerHost form={form} pick={pick} onPick={setPick}\n536\t          reading={Boolean(form.loading && catalogId && nozzle !== undefined)}\n537\t          onAskAgent={agentReady ? () => onAction('onboarding_ask_agent') : undefined} />\n538\t      ) : (\n539\t        <p className=\"onboarding-lead\" role=\"status\">Reading the printer list…</p>\n540\t      )}\n541\t      {options?.error && <p className=\"onboarding-error\" role=\"alert\">{options.error}</p>}\n542\t      {form?.error && <p className=\"onboarding-error\" role=\"alert\">{form.error}</p>}\n543\t      {error && <p className=\"onboarding-error\" role=\"alert\">{error}</p>}\n544\t      <div className=\"onboarding-step-group\">\n545\t        <div className=\"onboarding-actions\">\n546\t          <button type=\"button\" className=\"button-primary\" disabled={!ready || finishing} onClick={finish}>Continue</button>\n547\t          <button type=\"button\" className=\"onboarding-link\" onClick={() => onAction('onboarding_assume_default')}>Skip for now</button>\n548\t        </div>\n549\t        <p className=\"onboarding-note\">{STAND_IN_PRINTER}</p>\n550\t      </div>\n551\t      <button type=\"button\" className=\"onboarding-link flush\" onClick={() => onAction('onboarding_back')}>Back</button>\n552\t    </div>\n553\t  );\n554\t}\n555\t\n556\texport function Onboarding(props: Props) {\n557\t  if (props.onboarding.step === 'welcome') return <Welcome {...props} />;\n558\t  return (\n559\t    <div className=\"onboarding\">\n560\t      <Lockup appearance={props.appearance} />\n561\t      {props.onboarding.printersScreen === 'orca_import' ? <OrcaImport {...props} />\n562\t        : props.onboarding.printersScreen === 'import_result' ? <ImportResult {...props} />\n563\t          : <ChoosePrinter {...props} />}\n564\t    </div>\n565\t  );\n566\t}\n567\t"}]}}
