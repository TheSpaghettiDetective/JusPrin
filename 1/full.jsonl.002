{"type":"api-request","sessionId":"473348c5-5f94-4e4d-9ad9-c7e9dd10b438","id":"84b833a8-45d4-4be5-bc76-4d8086cf64de","timestamp":"2026-11-06T16:51:17.256Z","version":"2.1.309","querySource":"sdk","shapeHash":"b9dd0bd5a33788d9ca22f5c1531fc92f918cd9ae3201ce2c9539abcac6880adc","params":{"model":"claude-opus-5-5","betas":["claude-code-20250219","oauth-2025-04-20","interleaved-thinking-2025-05-14","thinking-token-count-2026-05-13","context-management-2025-06-27","prompt-caching-scope-2026-01-05","per-turn-control-2026-07-01","mid-conversation-tool-changes-2026-07-01","inline-tools-2026-09-15","advisor-tool-2026-03-01","advanced-tool-use-2025-11-20","mid-conversation-system-clear-at-2026-08-21","effort-2025-11-24","thinking-binding-controls-2026-08-01","thinking-display-updates-2026-08-18","extended-cache-ttl-2025-04-11","cache-diagnosis-2026-04-07","message-threads-2026-08-12"],"max_tokens":128000,"thinking":{"type":"adaptive","display":"updates"},"context_management":{"edits":[{"type":"clear_thinking_20251015","keep":"all"}]},"output_config":{"effort":"high"}},"base":"48508a7c-b4ae-44a9-8095-f1a20f7d8b12","keep":113,"tail":["7096108ba8c6de111b82f823a981e9e1756fab426b1927998ec2b83fd8c8076f","46afaea14ff80d77120931ba227f3183da7c4bb33d5de92ca5350e4d040c431e","8d5417819870814c986d7076932ad2dcad28287bdd05a674772b4c6ce5fb42e5"],"cacheControl":[{"path":["system",1],"value":{"type":"ephemeral","ttl":"1h","scope":"global"}},{"path":["system",2],"value":{"type":"ephemeral","ttl":"1h"}},{"path":["messages",115,"content",0],"value":{"type":"ephemeral","ttl":"1h"}}],"requestDigest":"23848f0128e87ef7adfb4ca69b6133362651348a7114b5731357075f88af87fa"}
{"parentUuid":"7a60d0d7-14ad-44d4-bea8-16dd4dbacf55","isSidechain":false,"message":{"model":"claude-opus-5-5","id":"msg_011Cgn27tJFrX23iVXXKJ8TP","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01NawJbWxGoq5KQxzG1rfCsF","name":"Write","input":{"file_path":"/Users/kenneth/.claude/projects/-Users-kenneth-Projects-JusPrin/figma-mirror/tools/composer/build_money_page.py","content":"\"\"\"Draws \"How the app and the server share the money pages\" on the Credits & plans page of the JusPrin v2 canvas (2026-11-06):\nwhere a person first meets prices, buying a credit pack from start to finish, and which parts the app draws and which the server draws.\nKenneth, 2026-11-06: the server's pages open in a sheet inside the app, not the browser; the one-time purchase is a \"Credit pack\"; the\nlaunch offer doubles every credit amount, packs and plans, until the end of January. The rest is a proposal.\nReuses build_credits_page.py's helpers (pricing_card, plan_card, prefs_window, composer…) and dc-imports or patches live boards for the\nscreens underneath. Usage: build_money_page.py <canvas project dir>; render with render_dc.py.\"\"\"\nimport json, re, sys\nfrom html import escape\nfrom pathlib import Path\n\n_src = (Path(__file__).parent / 'build_credits_page.py').read_text()\nexec(_src[:_src.index('# ---- the report form')])\nexec(_src[_src.index('# ---- boards'):_src.index('over = lambda')])\n\nSITE = 'jusprinv2.obico.io'\nPACK = 'Credit pack'\nLAUNCH_END = '31 Jan'   # placeholder for the end of January's last billing day\n\n# ---- the sheet: the app draws the frame and its states, the server draws what is inside ---------------------------------\nSHEET_W, SHEET_H, SHEET_TITLE_H = 1120, 752, 48\n\ndef sheet(title, inner, w=SHEET_W, h=SHEET_H, left=(SCREEN_W - SHEET_W) // 2, top=(SCREEN_H - SHEET_H) // 2, placed=True):\n    \"\"\"The app's sheet: title row with Open in browser and close, then the server's page filling the rest.\"\"\"\n    pos = f'position:absolute;z-index:20;left:{left}px;top:{top}px;' if placed else ''\n    head = (f'<div data-n=\"Sheet title row · drawn by the app\" style=\"{BOX}align-self:stretch;height:{SHEET_TITLE_H}px;display:flex;gap:var(--space-12);justify-content:space-between;align-items:center;padding:0 var(--space-12) 0 var(--space-20);background:var(--surface-raised);box-shadow:inset 0 -1px 0 0 var(--border-subtle)\">'\n            + text('body-bold', title, extra='flex:1 1 0;min-width:0', nowrap=True) + row([link('Open in browser'), dismiss()], 8, 'flex:none') + '</div>')\n    body = f'<div data-n=\"Server page\" style=\"{BOX}align-self:stretch;flex:1 1 0;min-height:0;display:flex;flex-direction:column;align-items:center;background:var(--surface-subtle);overflow:hidden\">{inner}</div>'\n    return (f'<div data-c=\"Sheet\" data-n=\"Sheet\" style=\"{BOX}{pos}width:{w}px;height:{h}px;display:flex;flex-direction:column;background:var(--surface-raised);border-radius:var(--radius-large);box-shadow:inset 0 0 0 1px var(--border-subtle),var(--elevation-strong);overflow:hidden\">'\n            + head + body + '</div>')\n\ndef over_screen(under, child):\n    return f'<div data-n=\"Window\" style=\"{BOX}position:relative;width:{SCREEN_W}px;height:{SCREEN_H}px;overflow:hidden;border-radius:var(--radius-small);box-shadow:inset 0 0 0 1px var(--border-subtle)\">{under}{child}</div>'\n\ndef imported(board_name):\n    return f'<div style=\"position:absolute;left:0;top:0;width:{SCREEN_W}px;height:{SCREEN_H}px\"><dc-import theme=\"{THEME}\" name=\"{board_name}\" hint-size=\"{SCREEN_W}px,{SCREEN_H}px\"></dc-import></div>'\n\ndef strip(words, actions=()):\n    \"\"\"The server page's first line: what it knows about the person, on the selected surface.\"\"\"\n    return (f'<div data-n=\"Where you are\" style=\"{BOX}align-self:stretch;display:flex;gap:var(--space-16);align-items:center;padding:var(--space-12) var(--space-16);background:var(--surface-selected);border-radius:var(--radius-medium);box-shadow:inset 0 0 0 1px var(--border-subtle)\">'\n            + text('body', words, extra='flex:1 1 0;min-width:0') + ''.join(actions) + '</div>')\n\n# ---- Credits and plans (server) --------------------------------------------------------------------------------------------\nPLAN_EXPIRY = 'These credits reset each month. Unused ones don’t carry over.'\n\ndef prices(state):\n    \"\"\"state: signed-out | out-of-credits | hobby.\"\"\"\n    signed_in = state != 'signed-out'\n    buy = (lambda s: primary(s, block=True)) if signed_in else (lambda s: secondary('Sign up to buy', block=True))\n    strips = {'signed-out': strip('Buying needs a JusPrin account. New accounts get 500 free credits for their first month.'),\n              'out-of-credits': strip('You have 3 credits, and an Expert message needs 5. What you buy goes to alex@example.com and is ready as soon as this closes.'),\n              'hobby': strip('You’re on Hobby: 1,122 of 1,500 credits left, renewing 1 Dec. A switch to Workshop starts today; the days left on Hobby come off the first payment.', [link('Billing')])}\n    intro = col([text('page-title', 'Credits and plans'),\n                 text('body', 'A Standard message is 1 credit and an Expert message is 5. Only messages you send cost credits.', '--text-secondary')], 8)\n    pack = pricing_card(PACK, '$10', 'once', '1,000 credits', 'These credits never expire.', buy('Buy a credit pack'),\n                        extra=[callout(f'Launch offer until {LAUNCH_END}: double the usual 500.')])\n    hobby_cta = secondary('Your plan', block=True) if state == 'hobby' else buy('Subscribe to Hobby')\n    work_cta = primary('Switch to Workshop', block=True) if state == 'hobby' else buy('Subscribe to Workshop')\n    hobby = pricing_card('Hobby', '$10', 'a month', '1,500 credits a month', PLAN_EXPIRY, hobby_cta,\n                         extra=[callout(f'Launch offer: every month billed until {LAUNCH_END} gets double the usual 750.')])\n    workshop = pricing_card('Workshop', '$20', 'a month', '2,000 credits a month. Standard messages cost 0 credits.', PLAN_EXPIRY, work_cta,\n                            extra=[callout(f'Launch offer: every month billed until {LAUNCH_END} gets double the usual 1,000.')])\n    cards = f'<div data-n=\"Plans\" style=\"{BOX}align-self:stretch;display:flex;gap:var(--space-16);align-items:stretch\">{pack}{hobby}{workshop}</div>'\n    foot = text('body-small', 'After your first month, accounts without a plan get 50 free credits a month. Your own API key stays free and never uses credits.', '--text-secondary')\n    return f'<div data-n=\"Content\" style=\"{BOX}width:1040px;display:flex;flex-direction:column;gap:var(--space-20);padding:var(--space-24) 0 var(--space-32);align-items:flex-start\">{strips[state]}{intro}{cards}{foot}</div>'\n\ndef tick():\n    return (f'<div style=\"{BOX}width:40px;height:40px;display:flex;justify-content:center;align-items:center;border-radius:50%;background:var(--surface-selected)\">'\n            + icon('check', '--status-success', 22) + '</div>')\n\ndef purchase_done():\n    card = col([tick(), col([text('page-title', '1,000 credits added'), text('body', 'They’re on alex@example.com. You now have 1,003 credits.')], 8),\n                primary('Back to your chat'),\n                text('label', 'A receipt is on its way to alex@example.com. Invoices are under Billing.', '--text-secondary')], 16,\n               'width:520px', 'padding:var(--space-32);background:var(--surface-canvas);border-radius:var(--radius-large);box-shadow:inset 0 0 0 1px var(--border-subtle);', name='Purchase done')\n    return f'<div style=\"{BOX}align-self:stretch;flex:1 1 auto;display:flex;justify-content:center;align-items:center\">{card}</div>'\n\ndef billing():\n    gap = f'<div style=\"{BOX}height:var(--space-16)\"></div>'\n    rows = [group_head('Plan'),\n            prefs_row('Hobby · $10 a month', f'1,500 credits a month until {LAUNCH_END}, then 750. Renews 1 Dec.', [secondary('Change plan'), secondary('Cancel plan')], 'body-bold'),\n            prefs_row('Payment method and invoices', 'Visa ending 4242. Receipts for every payment and credit pack.', [secondary('Open')]),\n            gap, group_head('Credits'),\n            prefs_row('1,122 credits left', 'Where they went, chat by chat, is in Preferences › Account.', [link('Buy a credit pack')]),\n            gap, group_head('Account'),\n            prefs_row('alex@example.com', 'Deleting the account ends the plan and removes its credits and saved chats from JusPrin’s servers.', [secondary('Delete account…')])]\n    return col([text('page-title', 'Billing'), col(rows, 0)], 20, 'width:720px', 'padding:var(--space-24) 0 var(--space-32);')\n\n# ---- the app's side ------------------------------------------------------------------------------------------------------\nSTANDARD_TURNS = USAGE_FIRST\nUSAGE_PACK = [r if r[1] != 'Bought 500 credits' else ('17 Nov', PACK, '', '', '+1,000') for r in USAGE_FIRST]\n\ndef lots_with_pack(pad):\n    return [meter('First-month credits', '62 of 500 left', 'Expires 1 Dec', 62 / 500, pad), meter('Credit packs', '1,000 of 1,000 left', 'Never expire', 1, pad)]\n\ndef account_no_plan():\n    pad = 'padding:var(--space-12) var(--space-16);'\n    card = plan_card('No plan', 'Only messages you send cost credits.', [secondary('Billing'), primary(OUT_OF_CREDITS)], [balance_head('1,062 credits left', pad)] + lots_with_pack(pad))\n    return col([text('section', 'Account'), account_row_signed_in(), card, text('label', USED_FIRST, '--text-secondary'), usage_group('438', DAYS_FIRST, USAGE_PACK), alert_group()], 24, name='Account')\n\ndef account_workshop_v2():\n    pad = 'padding:var(--space-12) var(--space-16);'\n    card = plan_card('Workshop', '$16 a month with Obico Premium’s 20% off. Renews 1 Dec.', [secondary('Billing'), primary(OUT_OF_CREDITS)],\n                     [balance_head('1,640 credits left', pad), meter('Workshop credits', '1,640 of 2,000 left', f'Expires 1 Dec. Doubled until {LAUNCH_END}. Unused credits don’t carry over.', 0.82, pad)])\n    return col([text('section', 'Account'), account_row_signed_in(), card, usage_group('360', DAYS_WORKSHOP, USAGE_WORKSHOP), alert_group()], 24, name='Account')\n\ndef out_of_credits_screen():\n    \"\"\"3b on Compositions, as build_credits_page.py draws it.\"\"\"\n    return screen(agent_pane(composer(notices=[notice('You have 3 credits; this Expert chat needs 5 a message.', [link(OUT_OF_CREDITS)], below=True)], field=TYPED, typed=True, balance='3 left', balance_frac=0.0, balance_low=True)))\n\ndef back_in_app():\n    return screen(agent_pane(composer(notices=[quiet_line('+1,000 credits', '--status-success')], field=TYPED, typed=True, send_on=True, balance='1,003 left', balance_frac=1)))\n\ndef plain_prepare():\n    return screen(agent_pane(composer(field='Reply…', balance='1,122 left', balance_frac=0.75)))\n\ndef spinner():\n    arc = 'cx=\"12\" cy=\"12\" r=\"9\" fill=\"none\" stroke-width=\"2.5\"'\n    return (f'<span aria-hidden=\"true\" style=\"{BOX}width:24px;height:24px;display:inline-block\"><svg viewBox=\"0 0 24 24\" width=\"100%\" height=\"100%\" style=\"display:block\">'\n            f'<circle {arc} style=\"stroke:var(--border-subtle)\" /><circle {arc} pathLength=\"100\" stroke-dasharray=\"25 100\" stroke-linecap=\"round\" style=\"stroke:var(--action-primary)\" /></svg></span>')\n\ndef sheet_state(kind):\n    if kind == 'loading':\n        inner = col([spinner(), text('body-small', 'Loading Credits and plans…', '--text-secondary', 'flex:none', True)], 12, 'flex:1 1 auto', align='center')\n    else:\n        inner = col([text('section', 'Couldn’t load Credits and plans'), text('body', 'Check your internet connection, then try again.', '--text-secondary'),\n                     row([primary('Try again'), secondary('Open in browser')], 8, 'flex:none')], 12, 'width:360px;margin:auto 0', align='flex-start')\n    return sheet('Credits and plans', f'<div style=\"{BOX}align-self:stretch;flex:1 1 auto;display:flex;flex-direction:column;justify-content:center;align-items:center\">{inner}</div>', 560, 360, placed=False)\n\n# ---- the map: who draws what, and what crosses ------------------------------------------------------------------------------\ndef lane_item(head, body):\n    return col([text('body-bold', head), text('body-small', body, '--text-secondary')], 2,\n               pad='padding:var(--space-12) var(--space-16);background:var(--surface-canvas);border-radius:var(--radius-medium);box-shadow:inset 0 0 0 1px var(--border-subtle);')\n\ndef lane(title, sub, items, width):\n    return col([col([text('section', title), text('body-small', sub, '--text-secondary')], 2)] + [lane_item(h, b) for h, b in items], 8, f'width:{width}px',\n               'padding:var(--space-16);background:var(--surface-subtle);border-radius:var(--radius-large);', name=title)\n\nAPP_ITEMS = [('The sheet', 'Its frame and title, Open in browser, close, and its own loading and can’t-load states. Never the page inside.'),\n             ('Welcome and Home’s agent card', 'The 500-credit offer, its scale line and a “See prices” link.'),\n             ('The composer', 'The credits ring and its panel, prices in credits on the model picker, “About 25 credits left”, the out-of-credits card, “+1,000 credits” after buying.'),\n             ('Preferences › Account', 'Signed in as, the plan’s name and its server-written price line, a bar per kind of credit, usage per chat, the savings-alert switch. Get more credits and Billing open the sheet.'),\n             ('Print history', 'The print-report button and “25 credits added”.')]\nCROSS_ITEMS = [('1 · The account answer', 'GET /v2/account, as today: credits by kind with dates, the plan’s name, renewal date and price line, usage. Fields are only ever added; the app ignores ones it doesn’t know.'),\n               ('2 · Page links', 'POST /v2/web_link with a page name, prices or billing, and where the click came from. The answer is a URL that signs in as the app’s account once. The sheet opens it; Open in browser asks for a fresh one. A name the server doesn’t know opens Credits and plans.'),\n               ('3 · The done address', 'When a server page goes to /v2/web/done, the app closes the sheet and reads the account answer again. Checkout, a plan change and a cancel all end there.'),\n               ('4 · Server-written lines', 'The plan’s price line and the savings alert come as finished sentences, with a page name for any button. The app shows them as written and never works out money.')]\nSERVER_ITEMS = [('Credits and plans', 'Credit pack, Hobby and Workshop with dollar prices, the launch offer, Obico’s discount.'),\n                ('Checkout', 'Chargebee’s hosted page, inside the sheet.'),\n                ('Purchase done', 'What was added and to which account; Back to your chat goes to the done address.'),\n                ('Billing', 'The plan in dollars, change and cancel, Chargebee’s portal for payment method and invoices, delete account.'),\n                ('Server-written lines', 'The words of the plan’s price line and the savings alert, with their sums.')]\n\ndef money_map():\n    rule = col([text('body-bold', 'The app draws credits; the server draws money, inside a sheet the app owns.'),\n                text('body', 'Anything about dollars, payment or changing a plan is a server page shown in the app’s sheet, so the person never leaves the app and a price change never needs a release. Where the app shows a price, it shows a sentence the server wrote. Google sign-in can’t run inside an app’s web view, so signing in always happens on the app’s own screens, never in the sheet.', '--text-secondary')], 4)\n    lanes = row([lane('Drawn by the app', 'Ships with each release; old versions stay in use for months.', APP_ITEMS, 400),\n                 lane('What crosses between them', 'The only contract to keep backward compatible.', CROSS_ITEMS, 420),\n                 lane('Drawn by the server', f'{SITE}, changes any day.', SERVER_ITEMS, 400)], 16, align='flex-start')\n    return col([rule, lanes], 24)\n\n# ---- the welcome, with the one changed card ----------------------------------------------------------------------------------\nWELCOME = 'first-run-welcome-01-clip-beat-1.dc.html'\nOFFER_OLD = ('Your first month: 500 credits', 'An Expert message is 5 credits. Your own API key stays free.')\nsee_prices = '<span style=\"color:var(--action-primary);font-weight:700;white-space:nowrap\">See prices</span>'\nOFFER_NEW = ('Sign up and get 500 free credits', f'Good for your first month: about 100 Expert questions. After that, 50 free credits a month. {see_prices}')\n\n# ---- boards ---------------------------------------------------------------------------------------------------------------\nboards = []\nboards.append(board('money-00-map.dc.html', 'Who draws which part, and what crosses between the app and the server',\n    'The in-app sheet, Credit pack and the launch offer are Kenneth’s (2026-11-06); the rest is a proposal. The app’s parts read only the account answer; the server’s pages open only through a page link and end at the done address. Those plus the server-written lines are the whole contract an old app version depends on.', money_map()))\nboards.append(patched('money-01-welcome-see-prices.dc.html', WELCOME, 'First meeting · the welcome says what the credits are and links to prices',\n    'Proposal. Only the offer card’s two lines change: the headline says the credits are free, the detail says how long they last, what 500 buys and what comes after, and “See prices” opens Credits and plans in the sheet. The rest is the welcome as drawn on On boarding experience, where the agreed wording fixes for its other lines also apply.',\n    [(f'>{escape(OFFER_OLD[0])}<', f'>{escape(OFFER_NEW[0])}<'), (f'>{escape(OFFER_OLD[1])}<', f'>{OFFER_NEW[1]}<')]))\n_lockup = re.search(r'lockup: (\\{[^}]*\\})', (proj / WELCOME).read_text()).group(1)   # the welcome's lockup is picked by its own script\n_b = proj / boards[-1][0]\n_b.write_text(_b.read_text().replace(\"return { theme: this.props.theme ?? 'light' };\",\n                                     f\"const theme = this.props.theme ?? 'light'; return {{ theme, lockup: {_lockup}[theme] }};\"))\nboards.append(board('money-02-prices-signed-out.dc.html', 'First meeting · Credits and plans in the sheet, before signing up',\n    'Proposal. Opened from “See prices” over the welcome. Prices are readable without an account. Every button reads “Sign up to buy”, which closes the sheet and puts the person on the welcome’s sign-up card: Google sign-in can’t run inside the sheet. Every card shows the launch offer in its own credit amount, with the usual amount in its note.',\n    over_screen(imported('first-run-welcome-01-clip-beat-1'), sheet('Credits and plans', prices('signed-out')))))\nboards.append(board('money-03-prices-out-of-credits.dc.html', 'Buying · from “Get more credits” on the out-of-credits card',\n    'Proposal. The sheet opens over the chat, already signed in as the app’s account through a page link. The line at the top says why the person is here and which account the credits go to. Checkout is Chargebee’s hosted page, inside the same sheet.',\n    over_screen(out_of_credits_screen(), sheet('Credits and plans', prices('out-of-credits')))))\nboards.append(board('money-04-purchase-done.dc.html', 'Buying · checkout finished, still in the sheet',\n    'Proposal. Replaces today’s redirect to the JusPrin v1 chat. It says what was added and to which account. “Back to your chat” goes to the done address, so the app closes the sheet; closing it with × does the same.',\n    over_screen(out_of_credits_screen(), sheet('Credits and plans', purchase_done()))))\nboards.append(board('money-05-back-in-app.dc.html', 'Buying · the sheet closed',\n    'Proposal. The app reads the account answer again as the sheet closes. The ring fills, “+1,000 credits” shows once above the box, Send turns on, and the typed message is still there.', back_in_app()))\nboth = row([prefs_window('account', account_no_plan(), 848, 'No plan'), prefs_window('account', account_workshop_v2(), 848, 'Workshop')], 48, 'flex:none', align='flex-start')\nboards.append(board('money-06-account.dc.html', 'Plan and billing · Preferences › Account',\n    'Proposal. Left: someone without a plan reads “No plan”, not “Pay as you go”; bought credits are “Credit packs”. Right: Workshop during the launch, 2,000 credits a month. Its price line, “$16 a month with Obico Premium’s 20% off”, is a sentence the server writes, so the app never works out a price. “Billing” replaces “Manage plan ↗” and opens the sheet. Bars and usage stay in the app because usage lists chats by their local titles.', both, 1696))\nboards.append(board('money-07-billing.dc.html', 'Plan and billing · Billing in the sheet',\n    'Proposal. Opened from Billing in Account or the line at the top of Credits and plans. The plan in dollars, with Change plan (Credits and plans with the current plan marked) and Cancel plan. Payment method and invoices open Chargebee’s portal inside the sheet. Named Billing so it is never confused with the app’s Account section, which it points back to for usage.',\n    over_screen(plain_prepare(), sheet('Billing', billing()))))\nboards.append(board('money-08-prices-hobby.dc.html', 'Plan and billing · Change plan, on Hobby',\n    'Proposal. The same page marks the current plan and turns the other subscription’s button into a switch. The line at the top says what switching does to money already paid; the proration rule is a placeholder for Chargebee’s setting.',\n    over_screen(plain_prepare(), sheet('Credits and plans', prices('hobby')))))\nboards.append(board('money-09-sheet-states.dc.html', 'Edge · the sheet while loading and when the server can’t be reached',\n    'Proposal. These two the app draws itself, because the server’s page isn’t there. Open in browser stays in the title row in every state, for anyone who wants their browser’s saved cards or password manager.',\n    row([sheet_state('loading'), sheet_state('failed')], 24, 'flex:none', align='flex-start'), 1192))\n\n# ---- canvas registration -------------------------------------------------------------------------------------------------\nc = json.loads((proj / 'canvas.json').read_text())\ndrawn = {b[0]: b for b in boards}\nfor k in [k for k in c['boards'] if k.startswith('money-') and k not in drawn]:\n    del c['boards'][k]\n    c['order'] = [o for o in c['order'] if o != k]\nnotes = {k: v for k, v in c['notes'].items() if not k.startswith('money-')}\norder = [k for k in c.get('noteOrder', []) if k in notes]\ndef add_note(key, **v):\n    notes[key] = {**v, 'page': PAGE}\n    order.append(key)\nadd_note('money-supersedes', x=2816, y=744, w=420, size='s', color='orange', text=(\n    'Superseded 2026-11-06 by the boards from y 2900: the one-time purchase is now “Credit pack”, the launch offer doubles every credit amount (packs and plans) until the end of January, '\n    'and these pages open in a sheet inside the app (Kenneth). 4b’s “Pay as you go” plan name is replaced by “No plan” there too.'))\nROWS = [('How the app and the server share the money pages · 2026-11-06', ['00']),\n        ('Where a person first meets prices', ['01', '02']),\n        ('Buying a credit pack, start to finish (after 3b, on Compositions)', ['03', '04', '05']),\n        ('Plan and billing', ['06', '07', '08']),\n        ('Edge cases', ['09'])]\ny, GAP, ROW_GAP = 2900, 80, 200\nfor heading, ids in ROWS:\n    group = [next(b for name, b in drawn.items() if name.startswith(f'money-{i}')) for i in ids]\n    add_note(f'money-h-{ids[0]}', x=0, y=y - 100, text=heading, kind='title1', size=40, maxW=4000)\n    x = 0\n    for name, w, h, title in group:\n        c['boards'][name] = {'x': x, 'y': y, 'w': w, 'h': h, 'title': title, 'page': PAGE}\n        if name not in c['order']: c['order'].append(name)\n        x += w + GAP\n    y += max(g[2] for g in group) + ROW_GAP\nc['notes'], c['noteOrder'] = notes, order\n(proj / 'canvas.json').write_text(json.dumps(c, indent=1, ensure_ascii=False))\njson.dump(list(drawn), open(proj.parent / 'money-boards.json', 'w'), indent=0)\nprint('boards', len(boards))\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":3682,"cache_read_input_tokens":236444,"output_tokens":9518,"output_tokens_details":{"thinking_tokens":0},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":3682,"ephemeral_5m_input_tokens":0},"inference_geo":"global","iterations":[{"input_tokens":2,"output_tokens":9518,"cache_read_input_tokens":236444,"cache_creation_input_tokens":3682,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":3682},"type":"message"}],"speed":"standard","fallback_credit":null},"input_transformations":[],"diagnostics":null,"context_management":null},"wireToolInputs":{"toolu_01NawJbWxGoq5KQxzG1rfCsF":{"file_path":"/Users/kenneth/.claude/projects/-Users-kenneth-Projects-JusPrin/figma-mirror/tools/composer/build_money_page.py","content":"\"\"\"Draws \"How the app and the server share the money pages\" on the Credits & plans page of the JusPrin v2 canvas (2026-11-06):\nwhere a person first meets prices, buying a credit pack from start to finish, and which parts the app draws and which the server draws.\nKenneth, 2026-11-06: the server's pages open in a sheet inside the app, not the browser; the one-time purchase is a \"Credit pack\"; the\nlaunch offer doubles every credit amount, packs and plans, until the end of January. The rest is a proposal.\nReuses build_credits_page.py's helpers (pricing_card, plan_card, prefs_window, composer…) and dc-imports or patches live boards for the\nscreens underneath. Usage: build_money_page.py <canvas project dir>; render with render_dc.py.\"\"\"\nimport json, re, sys\nfrom html import escape\nfrom pathlib import Path\n\n_src = (Path(__file__).parent / 'build_credits_page.py').read_text()\nexec(_src[:_src.index('# ---- the report form')])\nexec(_src[_src.index('# ---- boards'):_src.index('over = lambda')])\n\nSITE = 'jusprinv2.obico.io'\nPACK = 'Credit pack'\nLAUNCH_END = '31 Jan'   # placeholder for the end of January's last billing day\n\n# ---- the sheet: the app draws the frame and its states, the server draws what is inside ---------------------------------\nSHEET_W, SHEET_H, SHEET_TITLE_H = 1120, 752, 48\n\ndef sheet(title, inner, w=SHEET_W, h=SHEET_H, left=(SCREEN_W - SHEET_W) // 2, top=(SCREEN_H - SHEET_H) // 2, placed=True):\n    \"\"\"The app's sheet: title row with Open in browser and close, then the server's page filling the rest.\"\"\"\n    pos = f'position:absolute;z-index:20;left:{left}px;top:{top}px;' if placed else ''\n    head = (f'<div data-n=\"Sheet title row · drawn by the app\" style=\"{BOX}align-self:stretch;height:{SHEET_TITLE_H}px;display:flex;gap:var(--space-12);justify-content:space-between;align-items:center;padding:0 var(--space-12) 0 var(--space-20);background:var(--surface-raised);box-shadow:inset 0 -1px 0 0 var(--border-subtle)\">'\n            + text('body-bold', title, extra='flex:1 1 0;min-width:0', nowrap=True) + row([link('Open in browser'), dismiss()], 8, 'flex:none') + '</div>')\n    body = f'<div data-n=\"Server page\" style=\"{BOX}align-self:stretch;flex:1 1 0;min-height:0;display:flex;flex-direction:column;align-items:center;background:var(--surface-subtle);overflow:hidden\">{inner}</div>'\n    return (f'<div data-c=\"Sheet\" data-n=\"Sheet\" style=\"{BOX}{pos}width:{w}px;height:{h}px;display:flex;flex-direction:column;background:var(--surface-raised);border-radius:var(--radius-large);box-shadow:inset 0 0 0 1px var(--border-subtle),var(--elevation-strong);overflow:hidden\">'\n            + head + body + '</div>')\n\ndef over_screen(under, child):\n    return f'<div data-n=\"Window\" style=\"{BOX}position:relative;width:{SCREEN_W}px;height:{SCREEN_H}px;overflow:hidden;border-radius:var(--radius-small);box-shadow:inset 0 0 0 1px var(--border-subtle)\">{under}{child}</div>'\n\ndef imported(board_name):\n    return f'<div style=\"position:absolute;left:0;top:0;width:{SCREEN_W}px;height:{SCREEN_H}px\"><dc-import theme=\"{THEME}\" name=\"{board_name}\" hint-size=\"{SCREEN_W}px,{SCREEN_H}px\"></dc-import></div>'\n\ndef strip(words, actions=()):\n    \"\"\"The server page's first line: what it knows about the person, on the selected surface.\"\"\"\n    return (f'<div data-n=\"Where you are\" style=\"{BOX}align-self:stretch;display:flex;gap:var(--space-16);align-items:center;padding:var(--space-12) var(--space-16);background:var(--surface-selected);border-radius:var(--radius-medium);box-shadow:inset 0 0 0 1px var(--border-subtle)\">'\n            + text('body', words, extra='flex:1 1 0;min-width:0') + ''.join(actions) + '</div>')\n\n# ---- Credits and plans (server) --------------------------------------------------------------------------------------------\nPLAN_EXPIRY = 'These credits reset each month. Unused ones don’t carry over.'\n\ndef prices(state):\n    \"\"\"state: signed-out | out-of-credits | hobby.\"\"\"\n    signed_in = state != 'signed-out'\n    buy = (lambda s: primary(s, block=True)) if signed_in else (lambda s: secondary('Sign up to buy', block=True))\n    strips = {'signed-out': strip('Buying needs a JusPrin account. New accounts get 500 free credits for their first month.'),\n              'out-of-credits': strip('You have 3 credits, and an Expert message needs 5. What you buy goes to alex@example.com and is ready as soon as this closes.'),\n              'hobby': strip('You’re on Hobby: 1,122 of 1,500 credits left, renewing 1 Dec. A switch to Workshop starts today; the days left on Hobby come off the first payment.', [link('Billing')])}\n    intro = col([text('page-title', 'Credits and plans'),\n                 text('body', 'A Standard message is 1 credit and an Expert message is 5. Only messages you send cost credits.', '--text-secondary')], 8)\n    pack = pricing_card(PACK, '$10', 'once', '1,000 credits', 'These credits never expire.', buy('Buy a credit pack'),\n                        extra=[callout(f'Launch offer until {LAUNCH_END}: double the usual 500.')])\n    hobby_cta = secondary('Your plan', block=True) if state == 'hobby' else buy('Subscribe to Hobby')\n    work_cta = primary('Switch to Workshop', block=True) if state == 'hobby' else buy('Subscribe to Workshop')\n    hobby = pricing_card('Hobby', '$10', 'a month', '1,500 credits a month', PLAN_EXPIRY, hobby_cta,\n                         extra=[callout(f'Launch offer: every month billed until {LAUNCH_END} gets double the usual 750.')])\n    workshop = pricing_card('Workshop', '$20', 'a month', '2,000 credits a month. Standard messages cost 0 credits.', PLAN_EXPIRY, work_cta,\n                            extra=[callout(f'Launch offer: every month billed until {LAUNCH_END} gets double the usual 1,000.')])\n    cards = f'<div data-n=\"Plans\" style=\"{BOX}align-self:stretch;display:flex;gap:var(--space-16);align-items:stretch\">{pack}{hobby}{workshop}</div>'\n    foot = text('body-small', 'After your first month, accounts without a plan get 50 free credits a month. Your own API key stays free and never uses credits.', '--text-secondary')\n    return f'<div data-n=\"Content\" style=\"{BOX}width:1040px;display:flex;flex-direction:column;gap:var(--space-20);padding:var(--space-24) 0 var(--space-32);align-items:flex-start\">{strips[state]}{intro}{cards}{foot}</div>'\n\ndef tick():\n    return (f'<div style=\"{BOX}width:40px;height:40px;display:flex;justify-content:center;align-items:center;border-radius:50%;background:var(--surface-selected)\">'\n            + icon('check', '--status-success', 22) + '</div>')\n\ndef purchase_done():\n    card = col([tick(), col([text('page-title', '1,000 credits added'), text('body', 'They’re on alex@example.com. You now have 1,003 credits.')], 8),\n                primary('Back to your chat'),\n                text('label', 'A receipt is on its way to alex@example.com. Invoices are under Billing.', '--text-secondary')], 16,\n               'width:520px', 'padding:var(--space-32);background:var(--surface-canvas);border-radius:var(--radius-large);box-shadow:inset 0 0 0 1px var(--border-subtle);', name='Purchase done')\n    return f'<div style=\"{BOX}align-self:stretch;flex:1 1 auto;display:flex;justify-content:center;align-items:center\">{card}</div>'\n\ndef billing():\n    gap = f'<div style=\"{BOX}height:var(--space-16)\"></div>'\n    rows = [group_head('Plan'),\n            prefs_row('Hobby · $10 a month', f'1,500 credits a month until {LAUNCH_END}, then 750. Renews 1 Dec.', [secondary('Change plan'), secondary('Cancel plan')], 'body-bold'),\n            prefs_row('Payment method and invoices', 'Visa ending 4242. Receipts for every payment and credit pack.', [secondary('Open')]),\n            gap, group_head('Credits'),\n            prefs_row('1,122 credits left', 'Where they went, chat by chat, is in Preferences › Account.', [link('Buy a credit pack')]),\n            gap, group_head('Account'),\n            prefs_row('alex@example.com', 'Deleting the account ends the plan and removes its credits and saved chats from JusPrin’s servers.', [secondary('Delete account…')])]\n    return col([text('page-title', 'Billing'), col(rows, 0)], 20, 'width:720px', 'padding:var(--space-24) 0 var(--space-32);')\n\n# ---- the app's side ------------------------------------------------------------------------------------------------------\nSTANDARD_TURNS = USAGE_FIRST\nUSAGE_PACK = [r if r[1] != 'Bought 500 credits' else ('17 Nov', PACK, '', '', '+1,000') for r in USAGE_FIRST]\n\ndef lots_with_pack(pad):\n    return [meter('First-month credits', '62 of 500 left', 'Expires 1 Dec', 62 / 500, pad), meter('Credit packs', '1,000 of 1,000 left', 'Never expire', 1, pad)]\n\ndef account_no_plan():\n    pad = 'padding:var(--space-12) var(--space-16);'\n    card = plan_card('No plan', 'Only messages you send cost credits.', [secondary('Billing'), primary(OUT_OF_CREDITS)], [balance_head('1,062 credits left', pad)] + lots_with_pack(pad))\n    return col([text('section', 'Account'), account_row_signed_in(), card, text('label', USED_FIRST, '--text-secondary'), usage_group('438', DAYS_FIRST, USAGE_PACK), alert_group()], 24, name='Account')\n\ndef account_workshop_v2():\n    pad = 'padding:var(--space-12) var(--space-16);'\n    card = plan_card('Workshop', '$16 a month with Obico Premium’s 20% off. Renews 1 Dec.', [secondary('Billing'), primary(OUT_OF_CREDITS)],\n                     [balance_head('1,640 credits left', pad), meter('Workshop credits', '1,640 of 2,000 left', f'Expires 1 Dec. Doubled until {LAUNCH_END}. Unused credits don’t carry over.', 0.82, pad)])\n    return col([text('section', 'Account'), account_row_signed_in(), card, usage_group('360', DAYS_WORKSHOP, USAGE_WORKSHOP), alert_group()], 24, name='Account')\n\ndef out_of_credits_screen():\n    \"\"\"3b on Compositions, as build_credits_page.py draws it.\"\"\"\n    return screen(agent_pane(composer(notices=[notice('You have 3 credits; this Expert chat needs 5 a message.', [link(OUT_OF_CREDITS)], below=True)], field=TYPED, typed=True, balance='3 left', balance_frac=0.0, balance_low=True)))\n\ndef back_in_app():\n    return screen(agent_pane(composer(notices=[quiet_line('+1,000 credits', '--status-success')], field=TYPED, typed=True, send_on=True, balance='1,003 left', balance_frac=1)))\n\ndef plain_prepare():\n    return screen(agent_pane(composer(field='Reply…', balance='1,122 left', balance_frac=0.75)))\n\ndef spinner():\n    arc = 'cx=\"12\" cy=\"12\" r=\"9\" fill=\"none\" stroke-width=\"2.5\"'\n    return (f'<span aria-hidden=\"true\" style=\"{BOX}width:24px;height:24px;display:inline-block\"><svg viewBox=\"0 0 24 24\" width=\"100%\" height=\"100%\" style=\"display:block\">'\n            f'<circle {arc} style=\"stroke:var(--border-subtle)\" /><circle {arc} pathLength=\"100\" stroke-dasharray=\"25 100\" stroke-linecap=\"round\" style=\"stroke:var(--action-primary)\" /></svg></span>')\n\ndef sheet_state(kind):\n    if kind == 'loading':\n        inner = col([spinner(), text('body-small', 'Loading Credits and plans…', '--text-secondary', 'flex:none', True)], 12, 'flex:1 1 auto', align='center')\n    else:\n        inner = col([text('section', 'Couldn’t load Credits and plans'), text('body', 'Check your internet connection, then try again.', '--text-secondary'),\n                     row([primary('Try again'), secondary('Open in browser')], 8, 'flex:none')], 12, 'width:360px;margin:auto 0', align='flex-start')\n    return sheet('Credits and plans', f'<div style=\"{BOX}align-self:stretch;flex:1 1 auto;display:flex;flex-direction:column;justify-content:center;align-items:center\">{inner}</div>', 560, 360, placed=False)\n\n# ---- the map: who draws what, and what crosses ------------------------------------------------------------------------------\ndef lane_item(head, body):\n    return col([text('body-bold', head), text('body-small', body, '--text-secondary')], 2,\n               pad='padding:var(--space-12) var(--space-16);background:var(--surface-canvas);border-radius:var(--radius-medium);box-shadow:inset 0 0 0 1px var(--border-subtle);')\n\ndef lane(title, sub, items, width):\n    return col([col([text('section', title), text('body-small', sub, '--text-secondary')], 2)] + [lane_item(h, b) for h, b in items], 8, f'width:{width}px',\n               'padding:var(--space-16);background:var(--surface-subtle);border-radius:var(--radius-large);', name=title)\n\nAPP_ITEMS = [('The sheet', 'Its frame and title, Open in browser, close, and its own loading and can’t-load states. Never the page inside.'),\n             ('Welcome and Home’s agent card', 'The 500-credit offer, its scale line and a “See prices” link.'),\n             ('The composer', 'The credits ring and its panel, prices in credits on the model picker, “About 25 credits left”, the out-of-credits card, “+1,000 credits” after buying.'),\n             ('Preferences › Account', 'Signed in as, the plan’s name and its server-written price line, a bar per kind of credit, usage per chat, the savings-alert switch. Get more credits and Billing open the sheet.'),\n             ('Print history', 'The print-report button and “25 credits added”.')]\nCROSS_ITEMS = [('1 · The account answer', 'GET /v2/account, as today: credits by kind with dates, the plan’s name, renewal date and price line, usage. Fields are only ever added; the app ignores ones it doesn’t know.'),\n               ('2 · Page links', 'POST /v2/web_link with a page name, prices or billing, and where the click came from. The answer is a URL that signs in as the app’s account once. The sheet opens it; Open in browser asks for a fresh one. A name the server doesn’t know opens Credits and plans.'),\n               ('3 · The done address', 'When a server page goes to /v2/web/done, the app closes the sheet and reads the account answer again. Checkout, a plan change and a cancel all end there.'),\n               ('4 · Server-written lines', 'The plan’s price line and the savings alert come as finished sentences, with a page name for any button. The app shows them as written and never works out money.')]\nSERVER_ITEMS = [('Credits and plans', 'Credit pack, Hobby and Workshop with dollar prices, the launch offer, Obico’s discount.'),\n                ('Checkout', 'Chargebee’s hosted page, inside the sheet.'),\n                ('Purchase done', 'What was added and to which account; Back to your chat goes to the done address.'),\n                ('Billing', 'The plan in dollars, change and cancel, Chargebee’s portal for payment method and invoices, delete account.'),\n                ('Server-written lines', 'The words of the plan’s price line and the savings alert, with their sums.')]\n\ndef money_map():\n    rule = col([text('body-bold', 'The app draws credits; the server draws money, inside a sheet the app owns.'),\n                text('body', 'Anything about dollars, payment or changing a plan is a server page shown in the app’s sheet, so the person never leaves the app and a price change never needs a release. Where the app shows a price, it shows a sentence the server wrote. Google sign-in can’t run inside an app’s web view, so signing in always happens on the app’s own screens, never in the sheet.', '--text-secondary')], 4)\n    lanes = row([lane('Drawn by the app', 'Ships with each release; old versions stay in use for months.', APP_ITEMS, 400),\n                 lane('What crosses between them', 'The only contract to keep backward compatible.', CROSS_ITEMS, 420),\n                 lane('Drawn by the server', f'{SITE}, changes any day.', SERVER_ITEMS, 400)], 16, align='flex-start')\n    return col([rule, lanes], 24)\n\n# ---- the welcome, with the one changed card ----------------------------------------------------------------------------------\nWELCOME = 'first-run-welcome-01-clip-beat-1.dc.html'\nOFFER_OLD = ('Your first month: 500 credits', 'An Expert message is 5 credits. Your own API key stays free.')\nsee_prices = '<span style=\"color:var(--action-primary);font-weight:700;white-space:nowrap\">See prices</span>'\nOFFER_NEW = ('Sign up and get 500 free credits', f'Good for your first month: about 100 Expert questions. After that, 50 free credits a month. {see_prices}')\n\n# ---- boards ---------------------------------------------------------------------------------------------------------------\nboards = []\nboards.append(board('money-00-map.dc.html', 'Who draws which part, and what crosses between the app and the server',\n    'The in-app sheet, Credit pack and the launch offer are Kenneth’s (2026-11-06); the rest is a proposal. The app’s parts read only the account answer; the server’s pages open only through a page link and end at the done address. Those plus the server-written lines are the whole contract an old app version depends on.', money_map()))\nboards.append(patched('money-01-welcome-see-prices.dc.html', WELCOME, 'First meeting · the welcome says what the credits are and links to prices',\n    'Proposal. Only the offer card’s two lines change: the headline says the credits are free, the detail says how long they last, what 500 buys and what comes after, and “See prices” opens Credits and plans in the sheet. The rest is the welcome as drawn on On boarding experience, where the agreed wording fixes for its other lines also apply.',\n    [(f'>{escape(OFFER_OLD[0])}<', f'>{escape(OFFER_NEW[0])}<'), (f'>{escape(OFFER_OLD[1])}<', f'>{OFFER_NEW[1]}<')]))\n_lockup = re.search(r'lockup: (\\{[^}]*\\})', (proj / WELCOME).read_text()).group(1)   # the welcome's lockup is picked by its own script\n_b = proj / boards[-1][0]\n_b.write_text(_b.read_text().replace(\"return { theme: this.props.theme ?? 'light' };\",\n                                     f\"const theme = this.props.theme ?? 'light'; return {{ theme, lockup: {_lockup}[theme] }};\"))\nboards.append(board('money-02-prices-signed-out.dc.html', 'First meeting · Credits and plans in the sheet, before signing up',\n    'Proposal. Opened from “See prices” over the welcome. Prices are readable without an account. Every button reads “Sign up to buy”, which closes the sheet and puts the person on the welcome’s sign-up card: Google sign-in can’t run inside the sheet. Every card shows the launch offer in its own credit amount, with the usual amount in its note.',\n    over_screen(imported('first-run-welcome-01-clip-beat-1'), sheet('Credits and plans', prices('signed-out')))))\nboards.append(board('money-03-prices-out-of-credits.dc.html', 'Buying · from “Get more credits” on the out-of-credits card',\n    'Proposal. The sheet opens over the chat, already signed in as the app’s account through a page link. The line at the top says why the person is here and which account the credits go to. Checkout is Chargebee’s hosted page, inside the same sheet.',\n    over_screen(out_of_credits_screen(), sheet('Credits and plans', prices('out-of-credits')))))\nboards.append(board('money-04-purchase-done.dc.html', 'Buying · checkout finished, still in the sheet',\n    'Proposal. Replaces today’s redirect to the JusPrin v1 chat. It says what was added and to which account. “Back to your chat” goes to the done address, so the app closes the sheet; closing it with × does the same.',\n    over_screen(out_of_credits_screen(), sheet('Credits and plans', purchase_done()))))\nboards.append(board('money-05-back-in-app.dc.html', 'Buying · the sheet closed',\n    'Proposal. The app reads the account answer again as the sheet closes. The ring fills, “+1,000 credits” shows once above the box, Send turns on, and the typed message is still there.', back_in_app()))\nboth = row([prefs_window('account', account_no_plan(), 848, 'No plan'), prefs_window('account', account_workshop_v2(), 848, 'Workshop')], 48, 'flex:none', align='flex-start')\nboards.append(board('money-06-account.dc.html', 'Plan and billing · Preferences › Account',\n    'Proposal. Left: someone without a plan reads “No plan”, not “Pay as you go”; bought credits are “Credit packs”. Right: Workshop during the launch, 2,000 credits a month. Its price line, “$16 a month with Obico Premium’s 20% off”, is a sentence the server writes, so the app never works out a price. “Billing” replaces “Manage plan ↗” and opens the sheet. Bars and usage stay in the app because usage lists chats by their local titles.', both, 1696))\nboards.append(board('money-07-billing.dc.html', 'Plan and billing · Billing in the sheet',\n    'Proposal. Opened from Billing in Account or the line at the top of Credits and plans. The plan in dollars, with Change plan (Credits and plans with the current plan marked) and Cancel plan. Payment method and invoices open Chargebee’s portal inside the sheet. Named Billing so it is never confused with the app’s Account section, which it points back to for usage.',\n    over_screen(plain_prepare(), sheet('Billing', billing()))))\nboards.append(board('money-08-prices-hobby.dc.html', 'Plan and billing · Change plan, on Hobby',\n    'Proposal. The same page marks the current plan and turns the other subscription’s button into a switch. The line at the top says what switching does to money already paid; the proration rule is a placeholder for Chargebee’s setting.',\n    over_screen(plain_prepare(), sheet('Credits and plans', prices('hobby')))))\nboards.append(board('money-09-sheet-states.dc.html', 'Edge · the sheet while loading and when the server can’t be reached',\n    'Proposal. These two the app draws itself, because the server’s page isn’t there. Open in browser stays in the title row in every state, for anyone who wants their browser’s saved cards or password manager.',\n    row([sheet_state('loading'), sheet_state('failed')], 24, 'flex:none', align='flex-start'), 1192))\n\n# ---- canvas registration -------------------------------------------------------------------------------------------------\nc = json.loads((proj / 'canvas.json').read_text())\ndrawn = {b[0]: b for b in boards}\nfor k in [k for k in c['boards'] if k.startswith('money-') and k not in drawn]:\n    del c['boards'][k]\n    c['order'] = [o for o in c['order'] if o != k]\nnotes = {k: v for k, v in c['notes'].items() if not k.startswith('money-')}\norder = [k for k in c.get('noteOrder', []) if k in notes]\ndef add_note(key, **v):\n    notes[key] = {**v, 'page': PAGE}\n    order.append(key)\nadd_note('money-supersedes', x=2816, y=744, w=420, size='s', color='orange', text=(\n    'Superseded 2026-11-06 by the boards from y 2900: the one-time purchase is now “Credit pack”, the launch offer doubles every credit amount (packs and plans) until the end of January, '\n    'and these pages open in a sheet inside the app (Kenneth). 4b’s “Pay as you go” plan name is replaced by “No plan” there too.'))\nROWS = [('How the app and the server share the money pages · 2026-11-06', ['00']),\n        ('Where a person first meets prices', ['01', '02']),\n        ('Buying a credit pack, start to finish (after 3b, on Compositions)', ['03', '04', '05']),\n        ('Plan and billing', ['06', '07', '08']),\n        ('Edge cases', ['09'])]\ny, GAP, ROW_GAP = 2900, 80, 200\nfor heading, ids in ROWS:\n    group = [next(b for name, b in drawn.items() if name.startswith(f'money-{i}')) for i in ids]\n    add_note(f'money-h-{ids[0]}', x=0, y=y - 100, text=heading, kind='title1', size=40, maxW=4000)\n    x = 0\n    for name, w, h, title in group:\n        c['boards'][name] = {'x': x, 'y': y, 'w': w, 'h': h, 'title': title, 'page': PAGE}\n        if name not in c['order']: c['order'].append(name)\n        x += w + GAP\n    y += max(g[2] for g in group) + ROW_GAP\nc['notes'], c['noteOrder'] = notes, order\n(proj / 'canvas.json').write_text(json.dumps(c, indent=1, ensure_ascii=False))\njson.dump(list(drawn), open(proj.parent / 'money-boards.json', 'w'), indent=0)\nprint('boards', len(boards))\n"}},"apiBlockIndex":0,"requestId":"req_011Cgn27stwERyKTCGXfwqsQ","requestRef":"84b833a8-45d4-4be5-bc76-4d8086cf64de","requestedModel":"claude-opus-5-5","type":"assistant","uuid":"12f36b48-d80a-4695-9595-d473ea3a2864","timestamp":"2026-11-06T16:52:25.643Z","advisorModel":"claude-opus-5-5","effort":"high","perTurnEffort":"high","userType":"external","entrypoint":"claude-desktop","cwd":"/Users/kenneth/.claude/projects/-Users-kenneth-Projects-JusPrin/figma-mirror","sessionId":"473348c5-5f94-4e4d-9ad9-c7e9dd10b438","version":"2.1.309","gitBranch":"jusprin-newui","slug":"glimmering-doodling-lovelace"}
{"parentUuid":"12f36b48-d80a-4695-9595-d473ea3a2864","isSidechain":false,"promptId":"5a654659-7a68-4526-a481-c199ca4d1cdb","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01NawJbWxGoq5KQxzG1rfCsF","type":"tool_result","content":"The file /Users/kenneth/.claude/projects/-Users-kenneth-Projects-JusPrin/figma-mirror/tools/composer/build_money_page.py has been updated successfully. (file state is current in your context — no need to Read it back)"}]},"uuid":"368aa4ac-6c80-44fa-a3e2-d6a6d78037ae","timestamp":"2026-11-06T16:52:25.738Z","toolUseResult":{"type":"update","filePath":"/Users/kenneth/.claude/projects/-Users-kenneth-Projects-JusPrin/figma-mirror/tools/composer/build_money_page.py","content":"\"\"\"Draws \"How the app and the server share the money pages\" on the Credits & plans page of the JusPrin v2 canvas (2026-11-06):\nwhere a person first meets prices, buying a credit pack from start to finish, and which parts the app draws and which the server draws.\nKenneth, 2026-11-06: the server's pages open in a sheet inside the app, not the browser; the one-time purchase is a \"Credit pack\"; the\nlaunch offer doubles every credit amount, packs and plans, until the end of January. The rest is a proposal.\nReuses build_credits_page.py's helpers (pricing_card, plan_card, prefs_window, composer…) and dc-imports or patches live boards for the\nscreens underneath. Usage: build_money_page.py <canvas project dir>; render with render_dc.py.\"\"\"\nimport json, re, sys\nfrom html import escape\nfrom pathlib import Path\n\n_src = (Path(__file__).parent / 'build_credits_page.py').read_text()\nexec(_src[:_src.index('# ---- the report form')])\nexec(_src[_src.index('# ---- boards'):_src.index('over = lambda')])\n\nSITE = 'jusprinv2.obico.io'\nPACK = 'Credit pack'\nLAUNCH_END = '31 Jan'   # placeholder for the end of January's last billing day\n\n# ---- the sheet: the app draws the frame and its states, the server draws what is inside ---------------------------------\nSHEET_W, SHEET_H, SHEET_TITLE_H = 1120, 752, 48\n\ndef sheet(title, inner, w=SHEET_W, h=SHEET_H, left=(SCREEN_W - SHEET_W) // 2, top=(SCREEN_H - SHEET_H) // 2, placed=True):\n    \"\"\"The app's sheet: title row with Open in browser and close, then the server's page filling the rest.\"\"\"\n    pos = f'position:absolute;z-index:20;left:{left}px;top:{top}px;' if placed else ''\n    head = (f'<div data-n=\"Sheet title row · drawn by the app\" style=\"{BOX}align-self:stretch;height:{SHEET_TITLE_H}px;display:flex;gap:var(--space-12);justify-content:space-between;align-items:center;padding:0 var(--space-12) 0 var(--space-20);background:var(--surface-raised);box-shadow:inset 0 -1px 0 0 var(--border-subtle)\">'\n            + text('body-bold', title, extra='flex:1 1 0;min-width:0', nowrap=True) + row([link('Open in browser'), dismiss()], 8, 'flex:none') + '</div>')\n    body = f'<div data-n=\"Server page\" style=\"{BOX}align-self:stretch;flex:1 1 0;min-height:0;display:flex;flex-direction:column;align-items:center;background:var(--surface-subtle);overflow:hidden\">{inner}</div>'\n    return (f'<div data-c=\"Sheet\" data-n=\"Sheet\" style=\"{BOX}{pos}width:{w}px;height:{h}px;display:flex;flex-direction:column;background:var(--surface-raised);border-radius:var(--radius-large);box-shadow:inset 0 0 0 1px var(--border-subtle),var(--elevation-strong);overflow:hidden\">'\n            + head + body + '</div>')\n\ndef over_screen(under, child):\n    return f'<div data-n=\"Window\" style=\"{BOX}position:relative;width:{SCREEN_W}px;height:{SCREEN_H}px;overflow:hidden;border-radius:var(--radius-small);box-shadow:inset 0 0 0 1px var(--border-subtle)\">{under}{child}</div>'\n\ndef imported(board_name):\n    return f'<div style=\"position:absolute;left:0;top:0;width:{SCREEN_W}px;height:{SCREEN_H}px\"><dc-import theme=\"{THEME}\" name=\"{board_name}\" hint-size=\"{SCREEN_W}px,{SCREEN_H}px\"></dc-import></div>'\n\ndef strip(words, actions=()):\n    \"\"\"The server page's first line: what it knows about the person, on the selected surface.\"\"\"\n    return (f'<div data-n=\"Where you are\" style=\"{BOX}align-self:stretch;display:flex;gap:var(--space-16);align-items:center;padding:var(--space-12) var(--space-16);background:var(--surface-selected);border-radius:var(--radius-medium);box-shadow:inset 0 0 0 1px var(--border-subtle)\">'\n            + text('body', words, extra='flex:1 1 0;min-width:0') + ''.join(actions) + '</div>')\n\n# ---- Credits and plans (server) --------------------------------------------------------------------------------------------\nPLAN_EXPIRY = 'These credits reset each month. Unused ones don’t carry over.'\n\ndef prices(state):\n    \"\"\"state: signed-out | out-of-credits | hobby.\"\"\"\n    signed_in = state != 'signed-out'\n    buy = (lambda s: primary(s, block=True)) if signed_in else (lambda s: secondary('Sign up to buy', block=True))\n    strips = {'signed-out': strip('Buying needs a JusPrin account. New accounts get 500 free credits for their first month.'),\n              'out-of-credits': strip('You have 3 credits, and an Expert message needs 5. What you buy goes to alex@example.com and is ready as soon as this closes.'),\n              'hobby': strip('You’re on Hobby: 1,122 of 1,500 credits left, renewing 1 Dec. A switch to Workshop starts today; the days left on Hobby come off the first payment.', [link('Billing')])}\n    intro = col([text('page-title', 'Credits and plans'),\n                 text('body', 'A Standard message is 1 credit and an Expert message is 5. Only messages you send cost credits.', '--text-secondary')], 8)\n    pack = pricing_card(PACK, '$10', 'once', '1,000 credits', 'These credits never expire.', buy('Buy a credit pack'),\n                        extra=[callout(f'Launch offer until {LAUNCH_END}: double the usual 500.')])\n    hobby_cta = secondary('Your plan', block=True) if state == 'hobby' else buy('Subscribe to Hobby')\n    work_cta = primary('Switch to Workshop', block=True) if state == 'hobby' else buy('Subscribe to Workshop')\n    hobby = pricing_card('Hobby', '$10', 'a month', '1,500 credits a month', PLAN_EXPIRY, hobby_cta,\n                         extra=[callout(f'Launch offer: every month billed until {LAUNCH_END} gets double the usual 750.')])\n    workshop = pricing_card('Workshop', '$20', 'a month', '2,000 credits a month. Standard messages cost 0 credits.', PLAN_EXPIRY, work_cta,\n                            extra=[callout(f'Launch offer: every month billed until {LAUNCH_END} gets double the usual 1,000.')])\n    cards = f'<div data-n=\"Plans\" style=\"{BOX}align-self:stretch;display:flex;gap:var(--space-16);align-items:stretch\">{pack}{hobby}{workshop}</div>'\n    foot = text('body-small', 'After your first month, accounts without a plan get 50 free credits a month. Your own API key stays free and never uses credits.', '--text-secondary')\n    return f'<div data-n=\"Content\" style=\"{BOX}width:1040px;display:flex;flex-direction:column;gap:var(--space-20);padding:var(--space-24) 0 var(--space-32);align-items:flex-start\">{strips[state]}{intro}{cards}{foot}</div>'\n\ndef tick():\n    return (f'<div style=\"{BOX}width:40px;height:40px;display:flex;justify-content:center;align-items:center;border-radius:50%;background:var(--surface-selected)\">'\n            + icon('check', '--status-success', 22) + '</div>')\n\ndef purchase_done():\n    card = col([tick(), col([text('page-title', '1,000 credits added'), text('body', 'They’re on alex@example.com. You now have 1,003 credits.')], 8),\n                primary('Back to your chat'),\n                text('label', 'A receipt is on its way to alex@example.com. Invoices are under Billing.', '--text-secondary')], 16,\n               'width:520px', 'padding:var(--space-32);background:var(--surface-canvas);border-radius:var(--radius-large);box-shadow:inset 0 0 0 1px var(--border-subtle);', name='Purchase done')\n    return f'<div style=\"{BOX}align-self:stretch;flex:1 1 auto;display:flex;justify-content:center;align-items:center\">{card}</div>'\n\ndef billing():\n    gap = f'<div style=\"{BOX}height:var(--space-16)\"></div>'\n    rows = [group_head('Plan'),\n            prefs_row('Hobby · $10 a month', f'1,500 credits a month until {LAUNCH_END}, then 750. Renews 1 Dec.', [secondary('Change plan'), secondary('Cancel plan')], 'body-bold'),\n            prefs_row('Payment method and invoices', 'Visa ending 4242. Receipts for every payment and credit pack.', [secondary('Open')]),\n            gap, group_head('Credits'),\n            prefs_row('1,122 credits left', 'Where they went, chat by chat, is in Preferences › Account.', [link('Buy a credit pack')]),\n            gap, group_head('Account'),\n            prefs_row('alex@example.com', 'Deleting the account ends the plan and removes its credits and saved chats from JusPrin’s servers.', [secondary('Delete account…')])]\n    return col([text('page-title', 'Billing'), col(rows, 0)], 20, 'width:720px', 'padding:var(--space-24) 0 var(--space-32);')\n\n# ---- the app's side ------------------------------------------------------------------------------------------------------\nSTANDARD_TURNS = USAGE_FIRST\nUSAGE_PACK = [r if r[1] != 'Bought 500 credits' else ('17 Nov', PACK, '', '', '+1,000') for r in USAGE_FIRST]\n\ndef lots_with_pack(pad):\n    return [meter('First-month credits', '62 of 500 left', 'Expires 1 Dec', 62 / 500, pad), meter('Credit packs', '1,000 of 1,000 left', 'Never expire', 1, pad)]\n\ndef account_no_plan():\n    pad = 'padding:var(--space-12) var(--space-16);'\n    card = plan_card('No plan', 'Only messages you send cost credits.', [secondary('Billing'), primary(OUT_OF_CREDITS)], [balance_head('1,062 credits left', pad)] + lots_with_pack(pad))\n    return col([text('section', 'Account'), account_row_signed_in(), card, text('label', USED_FIRST, '--text-secondary'), usage_group('438', DAYS_FIRST, USAGE_PACK), alert_group()], 24, name='Account')\n\ndef account_workshop_v2():\n    pad = 'padding:var(--space-12) var(--space-16);'\n    card = plan_card('Workshop', '$16 a month with Obico Premium’s 20% off. Renews 1 Dec.', [secondary('Billing'), primary(OUT_OF_CREDITS)],\n                     [balance_head('1,640 credits left', pad), meter('Workshop credits', '1,640 of 2,000 left', f'Expires 1 Dec. Doubled until {LAUNCH_END}. Unused credits don’t carry over.', 0.82, pad)])\n    return col([text('section', 'Account'), account_row_signed_in(), card, usage_group('360', DAYS_WORKSHOP, USAGE_WORKSHOP), alert_group()], 24, name='Account')\n\ndef out_of_credits_screen():\n    \"\"\"3b on Compositions, as build_credits_page.py draws it.\"\"\"\n    return screen(agent_pane(composer(notices=[notice('You have 3 credits; this Expert chat needs 5 a message.', [link(OUT_OF_CREDITS)], below=True)], field=TYPED, typed=True, balance='3 left', balance_frac=0.0, balance_low=True)))\n\ndef back_in_app():\n    return screen(agent_pane(composer(notices=[quiet_line('+1,000 credits', '--status-success')], field=TYPED, typed=True, send_on=True, balance='1,003 left', balance_frac=1)))\n\ndef plain_prepare():\n    return screen(agent_pane(composer(field='Reply…', balance='1,122 left', balance_frac=0.75)))\n\ndef spinner():\n    arc = 'cx=\"12\" cy=\"12\" r=\"9\" fill=\"none\" stroke-width=\"2.5\"'\n    return (f'<span aria-hidden=\"true\" style=\"{BOX}width:24px;height:24px;display:inline-block\"><svg viewBox=\"0 0 24 24\" width=\"100%\" height=\"100%\" style=\"display:block\">'\n            f'<circle {arc} style=\"stroke:var(--border-subtle)\" /><circle {arc} pathLength=\"100\" stroke-dasharray=\"25 100\" stroke-linecap=\"round\" style=\"stroke:var(--action-primary)\" /></svg></span>')\n\ndef sheet_state(kind):\n    if kind == 'loading':\n        inner = col([spinner(), text('body-small', 'Loading Credits and plans…', '--text-secondary', 'flex:none', True)], 12, 'flex:1 1 auto', align='center')\n    else:\n        inner = col([text('section', 'Couldn’t load Credits and plans'), text('body', 'Check your internet connection, then try again.', '--text-secondary'),\n                     row([primary('Try again'), secondary('Open in browser')], 8, 'flex:none')], 12, 'width:360px;margin:auto 0', align='flex-start')\n    return sheet('Credits and plans', f'<div style=\"{BOX}align-self:stretch;flex:1 1 auto;display:flex;flex-direction:column;justify-content:center;align-items:center\">{inner}</div>', 560, 360, placed=False)\n\n# ---- the map: who draws what, and what crosses ------------------------------------------------------------------------------\ndef lane_item(head, body):\n    return col([text('body-bold', head), text('body-small', body, '--text-secondary')], 2,\n               pad='padding:var(--space-12) var(--space-16);background:var(--surface-canvas);border-radius:var(--radius-medium);box-shadow:inset 0 0 0 1px var(--border-subtle);')\n\ndef lane(title, sub, items, width):\n    return col([col([text('section', title), text('body-small', sub, '--text-secondary')], 2)] + [lane_item(h, b) for h, b in items], 8, f'width:{width}px',\n               'padding:var(--space-16);background:var(--surface-subtle);border-radius:var(--radius-large);', name=title)\n\nAPP_ITEMS = [('The sheet', 'Its frame and title, Open in browser, close, and its own loading and can’t-load states. Never the page inside.'),\n             ('Welcome and Home’s agent card', 'The 500-credit offer, its scale line and a “See prices” link.'),\n             ('The composer', 'The credits ring and its panel, prices in credits on the model picker, “About 25 credits left”, the out-of-credits card, “+1,000 credits” after buying.'),\n             ('Preferences › Account', 'Signed in as, the plan’s name and its server-written price line, a bar per kind of credit, usage per chat, the savings-alert switch. Get more credits and Billing open the sheet.'),\n             ('Print history', 'The print-report button and “25 credits added”.')]\nCROSS_ITEMS = [('1 · The account answer', 'GET /v2/account, as today: credits by kind with dates, the plan’s name, renewal date and price line, usage. Fields are only ever added; the app ignores ones it doesn’t know.'),\n               ('2 · Page links', 'POST /v2/web_link with a page name, prices or billing, and where the click came from. The answer is a URL that signs in as the app’s account once. The sheet opens it; Open in browser asks for a fresh one. A name the server doesn’t know opens Credits and plans.'),\n               ('3 · The done address', 'When a server page goes to /v2/web/done, the app closes the sheet and reads the account answer again. Checkout, a plan change and a cancel all end there.'),\n               ('4 · Server-written lines', 'The plan’s price line and the savings alert come as finished sentences, with a page name for any button. The app shows them as written and never works out money.')]\nSERVER_ITEMS = [('Credits and plans', 'Credit pack, Hobby and Workshop with dollar prices, the launch offer, Obico’s discount.'),\n                ('Checkout', 'Chargebee’s hosted page, inside the sheet.'),\n                ('Purchase done', 'What was added and to which account; Back to your chat goes to the done address.'),\n                ('Billing', 'The plan in dollars, change and cancel, Chargebee’s portal for payment method and invoices, delete account.'),\n                ('Server-written lines', 'The words of the plan’s price line and the savings alert, with their sums.')]\n\ndef money_map():\n    rule = col([text('body-bold', 'The app draws credits; the server draws money, inside a sheet the app owns.'),\n                text('body', 'Anything about dollars, payment or changing a plan is a server page shown in the app’s sheet, so the person never leaves the app and a price change never needs a release. Where the app shows a price, it shows a sentence the server wrote. Google sign-in can’t run inside an app’s web view, so signing in always happens on the app’s own screens, never in the sheet.', '--text-secondary')], 4)\n    lanes = row([lane('Drawn by the app', 'Ships with each release; old versions stay in use for months.', APP_ITEMS, 400),\n                 lane('What crosses between them', 'The only contract to keep backward compatible.', CROSS_ITEMS, 420),\n                 lane('Drawn by the server', f'{SITE}, changes any day.', SERVER_ITEMS, 400)], 16, align='flex-start')\n    return col([rule, lanes], 24)\n\n# ---- the welcome, with the one changed card ----------------------------------------------------------------------------------\nWELCOME = 'first-run-welcome-01-clip-beat-1.dc.html'\nOFFER_OLD = ('Your first month: 500 credits', 'An Expert message is 5 credits. Your own API key stays free.')\nsee_prices = '<span style=\"color:var(--action-primary);font-weight:700;white-space:nowrap\">See prices</span>'\nOFFER_NEW = ('Sign up and get 500 free credits', f'Good for your first month: about 100 Expert questions. After that, 50 free credits a month. {see_prices}')\n\n# ---- boards ---------------------------------------------------------------------------------------------------------------\nboards = []\nboards.append(board('money-00-map.dc.html', 'Who draws which part, and what crosses between the app and the server',\n    'The in-app sheet, Credit pack and the launch offer are Kenneth’s (2026-11-06); the rest is a proposal. The app’s parts read only the account answer; the server’s pages open only through a page link and end at the done address. Those plus the server-written lines are the whole contract an old app version depends on.', money_map()))\nboards.append(patched('money-01-welcome-see-prices.dc.html', WELCOME, 'First meeting · the welcome says what the credits are and links to prices',\n    'Proposal. Only the offer card’s two lines change: the headline says the credits are free, the detail says how long they last, what 500 buys and what comes after, and “See prices” opens Credits and plans in the sheet. The rest is the welcome as drawn on On boarding experience, where the agreed wording fixes for its other lines also apply.',\n    [(f'>{escape(OFFER_OLD[0])}<', f'>{escape(OFFER_NEW[0])}<'), (f'>{escape(OFFER_OLD[1])}<', f'>{OFFER_NEW[1]}<')]))\n_lockup = re.search(r'lockup: (\\{[^}]*\\})', (proj / WELCOME).read_text()).group(1)   # the welcome's lockup is picked by its own script\n_b = proj / boards[-1][0]\n_b.write_text(_b.read_text().replace(\"return { theme: this.props.theme ?? 'light' };\",\n                                     f\"const theme = this.props.theme ?? 'light'; return {{ theme, lockup: {_lockup}[theme] }};\"))\nboards.append(board('money-02-prices-signed-out.dc.html', 'First meeting · Credits and plans in the sheet, before signing up',\n    'Proposal. Opened from “See prices” over the welcome. Prices are readable without an account. Every button reads “Sign up to buy”, which closes the sheet and puts the person on the welcome’s sign-up card: Google sign-in can’t run inside the sheet. Every card shows the launch offer in its own credit amount, with the usual amount in its note.',\n    over_screen(imported('first-run-welcome-01-clip-beat-1'), sheet('Credits and plans', prices('signed-out')))))\nboards.append(board('money-03-prices-out-of-credits.dc.html', 'Buying · from “Get more credits” on the out-of-credits card',\n    'Proposal. The sheet opens over the chat, already signed in as the app’s account through a page link. The line at the top says why the person is here and which account the credits go to. Checkout is Chargebee’s hosted page, inside the same sheet.',\n    over_screen(out_of_credits_screen(), sheet('Credits and plans', prices('out-of-credits')))))\nboards.append(board('money-04-purchase-done.dc.html', 'Buying · checkout finished, still in the sheet',\n    'Proposal. Replaces today’s redirect to the JusPrin v1 chat. It says what was added and to which account. “Back to your chat” goes to the done address, so the app closes the sheet; closing it with × does the same.',\n    over_screen(out_of_credits_screen(), sheet('Credits and plans', purchase_done()))))\nboards.append(board('money-05-back-in-app.dc.html', 'Buying · the sheet closed',\n    'Proposal. The app reads the account answer again as the sheet closes. The ring fills, “+1,000 credits” shows once above the box, Send turns on, and the typed message is still there.', back_in_app()))\nboth = row([prefs_window('account', account_no_plan(), 848, 'No plan'), prefs_window('account', account_workshop_v2(), 848, 'Workshop')], 48, 'flex:none', align='flex-start')\nboards.append(board('money-06-account.dc.html', 'Plan and billing · Preferences › Account',\n    'Proposal. Left: someone without a plan reads “No plan”, not “Pay as you go”; bought credits are “Credit packs”. Right: Workshop during the launch, 2,000 credits a month. Its price line, “$16 a month with Obico Premium’s 20% off”, is a sentence the server writes, so the app never works out a price. “Billing” replaces “Manage plan ↗” and opens the sheet. Bars and usage stay in the app because usage lists chats by their local titles.', both, 1696))\nboards.append(board('money-07-billing.dc.html', 'Plan and billing · Billing in the sheet',\n    'Proposal. Opened from Billing in Account or the line at the top of Credits and plans. The plan in dollars, with Change plan (Credits and plans with the current plan marked) and Cancel plan. Payment method and invoices open Chargebee’s portal inside the sheet. Named Billing so it is never confused with the app’s Account section, which it points back to for usage.',\n    over_screen(plain_prepare(), sheet('Billing', billing()))))\nboards.append(board('money-08-prices-hobby.dc.html', 'Plan and billing · Change plan, on Hobby',\n    'Proposal. The same page marks the current plan and turns the other subscription’s button into a switch. The line at the top says what switching does to money already paid; the proration rule is a placeholder for Chargebee’s setting.',\n    over_screen(plain_prepare(), sheet('Credits and plans', prices('hobby')))))\nboards.append(board('money-09-sheet-states.dc.html', 'Edge · the sheet while loading and when the server can’t be reached',\n    'Proposal. These two the app draws itself, because the server’s page isn’t there. Open in browser stays in the title row in every state, for anyone who wants their browser’s saved cards or password manager.',\n    row([sheet_state('loading'), sheet_state('failed')], 24, 'flex:none', align='flex-start'), 1192))\n\n# ---- canvas registration -------------------------------------------------------------------------------------------------\nc = json.loads((proj / 'canvas.json').read_text())\ndrawn = {b[0]: b for b in boards}\nfor k in [k for k in c['boards'] if k.startswith('money-') and k not in drawn]:\n    del c['boards'][k]\n    c['order'] = [o for o in c['order'] if o != k]\nnotes = {k: v for k, v in c['notes'].items() if not k.startswith('money-')}\norder = [k for k in c.get('noteOrder', []) if k in notes]\ndef add_note(key, **v):\n    notes[key] = {**v, 'page': PAGE}\n    order.append(key)\nadd_note('money-supersedes', x=2816, y=744, w=420, size='s', color='orange', text=(\n    'Superseded 2026-11-06 by the boards from y 2900: the one-time purchase is now “Credit pack”, the launch offer doubles every credit amount (packs and plans) until the end of January, '\n    'and these pages open in a sheet inside the app (Kenneth). 4b’s “Pay as you go” plan name is replaced by “No plan” there too.'))\nROWS = [('How the app and the server share the money pages · 2026-11-06', ['00']),\n        ('Where a person first meets prices', ['01', '02']),\n        ('Buying a credit pack, start to finish (after 3b, on Compositions)', ['03', '04', '05']),\n        ('Plan and billing', ['06', '07', '08']),\n        ('Edge cases', ['09'])]\ny, GAP, ROW_GAP = 2900, 80, 200\nfor heading, ids in ROWS:\n    group = [next(b for name, b in drawn.items() if name.startswith(f'money-{i}')) for i in ids]\n    add_note(f'money-h-{ids[0]}', x=0, y=y - 100, text=heading, kind='title1', size=40, maxW=4000)\n    x = 0\n    for name, w, h, title in group:\n        c['boards'][name] = {'x': x, 'y': y, 'w': w, 'h': h, 'title': title, 'page': PAGE}\n        if name not in c['order']: c['order'].append(name)\n        x += w + GAP\n    y += max(g[2] for g in group) + ROW_GAP\nc['notes'], c['noteOrder'] = notes, order\n(proj / 'canvas.json').write_text(json.dumps(c, indent=1, ensure_ascii=False))\njson.dump(list(drawn), open(proj.parent / 'money-boards.json', 'w'), indent=0)\nprint('boards', len(boards))\n","structuredPatch":[{"oldStart":1,"oldLines":7,"newStart":1,"newLines":9,"lines":[" \"\"\"Draws \"How the app and the server share the money pages\" on the Credits & plans page of the JusPrin v2 canvas (2026-11-06):","-where a person first meets prices, buying credits from start to finish, and which pages the app draws and which the server draws.","-Every board is a proposal for Kenneth. Reuses build_credits_page.py's helpers (pricing_card, plan_card, prefs_window, composer…)","-and patches the live first-run welcome board for the one changed line. Usage: build_money_page.py <canvas project dir>; render with render_dc.py.\"\"\"","+where a person first meets prices, buying a credit pack from start to finish, and which parts the app draws and which the server draws.","+Kenneth, 2026-11-06: the server's pages open in a sheet inside the app, not the browser; the one-time purchase is a \"Credit pack\"; the","+launch offer doubles every credit amount, packs and plans, until the end of January. The rest is a proposal.","+Reuses build_credits_page.py's helpers (pricing_card, plan_card, prefs_window, composer…) and dc-imports or patches live boards for the","+screens underneath. Usage: build_money_page.py <canvas project dir>; render with render_dc.py.\"\"\""," import json, re, sys"," from html import escape"," from pathlib import Path"]},{"oldStart":11,"oldLines":86,"newStart":13,"newLines":120,"lines":[" exec(_src[_src.index('# ---- boards'):_src.index('over = lambda')])"," "," SITE = 'jusprinv2.obico.io'","+PACK = 'Credit pack'","+LAUNCH_END = '31 Jan'   # placeholder for the end of January's last billing day"," ","-# ---- the server's pages: one header for all of them --------------------------------------------------------------","-def web_head(section, email='alex@example.com'):","-    right = (row([text('label', f'Signed in as {email}', '--text-secondary', 'flex:none', True), link('Billing' if section != 'Billing' else 'Prices')], 12, 'flex:none')","-             if email else secondary('Sign in'))","-    return (f'<div data-n=\"top-bar\" style=\"{BOX}align-self:stretch;height:{BAR_H}px;display:flex;padding:0 var(--space-24);justify-content:space-between;align-items:center;background:var(--surface-canvas);box-shadow:inset 0 -1px 0 0 var(--border-subtle)\">'","-            + row([text('section', 'JusPrin', '--action-primary', 'flex:none', True), text('body', section, '--text-secondary', 'flex:none', True)], 12, 'flex:none') + right + '</div>')","+# ---- the sheet: the app draws the frame and its states, the server draws what is inside ---------------------------------","+SHEET_W, SHEET_H, SHEET_TITLE_H = 1120, 752, 48"," ","-def web_page(name, section, body, email='alex@example.com', height=None):","-    h = f'min-height:{height}px;' if height else ''","-    return (f'<div data-n=\"{escape(name)}\" data-theme=\"{THEME}\" class=\"body\" style=\"{BOX}position:relative;width:{SCREEN_W}px;{h}display:flex;flex-direction:column;align-items:center;background:var(--surface-subtle);color:var(--text-primary);font-family:var(--font-sans);border-radius:var(--radius-small);box-shadow:inset 0 0 0 1px var(--border-subtle);overflow:hidden\">'","-            + web_head(section, email) + body + '</div>')","+def sheet(title, inner, w=SHEET_W, h=SHEET_H, left=(SCREEN_W - SHEET_W) // 2, top=(SCREEN_H - SHEET_H) // 2, placed=True):","+    \"\"\"The app's sheet: title row with Open in browser and close, then the server's page filling the rest.\"\"\"","+    pos = f'position:absolute;z-index:20;left:{left}px;top:{top}px;' if placed else ''","+    head = (f'<div data-n=\"Sheet title row · drawn by the app\" style=\"{BOX}align-self:stretch;height:{SHEET_TITLE_H}px;display:flex;gap:var(--space-12);justify-content:space-between;align-items:center;padding:0 var(--space-12) 0 var(--space-20);background:var(--surface-raised);box-shadow:inset 0 -1px 0 0 var(--border-subtle)\">'","+            + text('body-bold', title, extra='flex:1 1 0;min-width:0', nowrap=True) + row([link('Open in browser'), dismiss()], 8, 'flex:none') + '</div>')","+    body = f'<div data-n=\"Server page\" style=\"{BOX}align-self:stretch;flex:1 1 0;min-height:0;display:flex;flex-direction:column;align-items:center;background:var(--surface-subtle);overflow:hidden\">{inner}</div>'","+    return (f'<div data-c=\"Sheet\" data-n=\"Sheet\" style=\"{BOX}{pos}width:{w}px;height:{h}px;display:flex;flex-direction:column;background:var(--surface-raised);border-radius:var(--radius-large);box-shadow:inset 0 0 0 1px var(--border-subtle),var(--elevation-strong);overflow:hidden\">'","+            + head + body + '</div>')"," ","+def over_screen(under, child):","+    return f'<div data-n=\"Window\" style=\"{BOX}position:relative;width:{SCREEN_W}px;height:{SCREEN_H}px;overflow:hidden;border-radius:var(--radius-small);box-shadow:inset 0 0 0 1px var(--border-subtle)\">{under}{child}</div>'","+","+def imported(board_name):","+    return f'<div style=\"position:absolute;left:0;top:0;width:{SCREEN_W}px;height:{SCREEN_H}px\"><dc-import theme=\"{THEME}\" name=\"{board_name}\" hint-size=\"{SCREEN_W}px,{SCREEN_H}px\"></dc-import></div>'","+"," def strip(words, actions=()):","-    \"\"\"The line at the top of a server page that says what the page knows about the person, on the selected surface.\"\"\"","+    \"\"\"The server page's first line: what it knows about the person, on the selected surface.\"\"\"","     return (f'<div data-n=\"Where you are\" style=\"{BOX}align-self:stretch;display:flex;gap:var(--space-16);align-items:center;padding:var(--space-12) var(--space-16);background:var(--surface-selected);border-radius:var(--radius-medium);box-shadow:inset 0 0 0 1px var(--border-subtle)\">'","             + text('body', words, extra='flex:1 1 0;min-width:0') + ''.join(actions) + '</div>')"," ","-# ---- the pricing page, with the launch offer in the card's own headline ---------------------------------------------","+# ---- Credits and plans (server) --------------------------------------------------------------------------------------------","+PLAN_EXPIRY = 'These credits reset each month. Unused ones don’t carry over.'","+"," def prices(state):","-    \"\"\"state: signed-out | out-of-credits | hobby | link-expired.\"\"\"","-    signed_in = state in ('out-of-credits', 'hobby')","-    buy = (lambda s: primary(s, block=True)) if signed_in else (lambda s: secondary('Sign in to buy', block=True))","-    strips = {'signed-out': strip('New accounts get 500 free credits for their first month: sign up in JusPrin. Already have an account? Sign in here to buy.'),","-              'out-of-credits': strip('You have 3 credits, and an Expert message needs 5. What you buy here goes to alex@example.com and is ready the moment you’re back in JusPrin.'),","-              'hobby': strip('You’re on Hobby: 122 of 750 credits left, renewing 1 Dec. A switch to Workshop starts today; the days left on Hobby come off the first payment.'),","-              'link-expired': strip('The link from JusPrin had expired, so this page doesn’t know which account is yours. Sign in, or go back to JusPrin and click Get more credits again.', [primary('Sign in')])}","+    \"\"\"state: signed-out | out-of-credits | hobby.\"\"\"","+    signed_in = state != 'signed-out'","+    buy = (lambda s: primary(s, block=True)) if signed_in else (lambda s: secondary('Sign up to buy', block=True))","+    strips = {'signed-out': strip('Buying needs a JusPrin account. New accounts get 500 free credits for their first month.'),","+              'out-of-credits': strip('You have 3 credits, and an Expert message needs 5. What you buy goes to alex@example.com and is ready as soon as this closes.'),","+              'hobby': strip('You’re on Hobby: 1,122 of 1,500 credits left, renewing 1 Dec. A switch to Workshop starts today; the days left on Hobby come off the first payment.', [link('Billing')])}","     intro = col([text('page-title', 'Credits and plans'),","                  text('body', 'A Standard message is 1 credit and an Expert message is 5. Only messages you send cost credits.', '--text-secondary')], 8)","-    payg = pricing_card('Pay as you go', '$10', 'once', '1,000 credits', 'These credits never expire.', buy('Buy 1,000 credits'),","-                        extra=[callout('Launch offer until 31 Jan: double the usual 500.')])","+    pack = pricing_card(PACK, '$10', 'once', '1,000 credits', 'These credits never expire.', buy('Buy a credit pack'),","+                        extra=[callout(f'Launch offer until {LAUNCH_END}: double the usual 500.')])","     hobby_cta = secondary('Your plan', block=True) if state == 'hobby' else buy('Subscribe to Hobby')","     work_cta = primary('Switch to Workshop', block=True) if state == 'hobby' else buy('Subscribe to Workshop')","-    hobby = pricing_card('Hobby', '$10', 'a month', '750 credits a month', 'These credits reset each month. Unused ones don’t carry over.', hobby_cta)","-    workshop = pricing_card('Workshop', '$20', 'a month', '1,000 credits a month. Standard messages cost 0 credits.', 'These credits reset each month. Unused ones don’t carry over.', work_cta)","-    cards = f'<div data-n=\"Plans\" style=\"{BOX}align-self:stretch;display:flex;gap:var(--space-16);align-items:stretch\">{payg}{hobby}{workshop}</div>'","+    hobby = pricing_card('Hobby', '$10', 'a month', '1,500 credits a month', PLAN_EXPIRY, hobby_cta,","+                         extra=[callout(f'Launch offer: every month billed until {LAUNCH_END} gets double the usual 750.')])","+    workshop = pricing_card('Workshop', '$20', 'a month', '2,000 credits a month. Standard messages cost 0 credits.', PLAN_EXPIRY, work_cta,","+                            extra=[callout(f'Launch offer: every month billed until {LAUNCH_END} gets double the usual 1,000.')])","+    cards = f'<div data-n=\"Plans\" style=\"{BOX}align-self:stretch;display:flex;gap:var(--space-16);align-items:stretch\">{pack}{hobby}{workshop}</div>'","     foot = text('body-small', 'After your first month, accounts without a plan get 50 free credits a month. Your own API key stays free and never uses credits.', '--text-secondary')","-    body = f'<div data-n=\"Content\" style=\"{BOX}width:1040px;display:flex;flex-direction:column;gap:var(--space-24);padding:var(--space-32) 0 var(--space-48);align-items:flex-start\">{strips[state]}{intro}{cards}{foot}</div>'","-    return web_page('Pricing page', 'Credits and plans', body, 'alex@example.com' if signed_in else None)","+    return f'<div data-n=\"Content\" style=\"{BOX}width:1040px;display:flex;flex-direction:column;gap:var(--space-20);padding:var(--space-24) 0 var(--space-32);align-items:flex-start\">{strips[state]}{intro}{cards}{foot}</div>'"," ","-# ---- after checkout ----------------------------------------------------------------------------------------------"," def tick():","     return (f'<div style=\"{BOX}width:40px;height:40px;display:flex;justify-content:center;align-items:center;border-radius:50%;background:var(--surface-selected)\">'","             + icon('check', '--status-success', 22) + '</div>')"," ","-def thank_you():","+def purchase_done():","     card = col([tick(), col([text('page-title', '1,000 credits added'), text('body', 'They’re on alex@example.com. You now have 1,003 credits.')], 8),","-                text('body', 'Go back to JusPrin. Your message is still in the box, ready to send. You can close this tab.'),","+                primary('Back to your chat'),","                 text('label', 'A receipt is on its way to alex@example.com. Invoices are under Billing.', '--text-secondary')], 16,","-               'width:560px', 'padding:var(--space-32);background:var(--surface-canvas);border-radius:var(--radius-large);box-shadow:inset 0 0 0 1px var(--border-subtle);', name='Thanks')","-    return web_page('Thank-you page', 'Credits and plans', f'<div style=\"{BOX}align-self:stretch;flex:1 1 auto;display:flex;justify-content:center;align-items:center;padding:var(--space-48) 0\">{card}</div>', height=SCREEN_H - 160)","+               'width:520px', 'padding:var(--space-32);background:var(--surface-canvas);border-radius:var(--radius-large);box-shadow:inset 0 0 0 1px var(--border-subtle);', name='Purchase done')","+    return f'<div style=\"{BOX}align-self:stretch;flex:1 1 auto;display:flex;justify-content:center;align-items:center\">{card}</div>'"," ","-# ---- the server's Billing page -----------------------------------------------------------------------------------"," def billing():","+    gap = f'<div style=\"{BOX}height:var(--space-16)\"></div>'","     rows = [group_head('Plan'),","-            prefs_row('Hobby · $10 a month', '750 credits a month. Renews 1 Dec.', [secondary('Change plan'), secondary('Cancel plan')], 'body-bold'),","-            prefs_row('Payment method and invoices', 'Visa ending 4242. Receipts for every payment and pack.', [secondary('Open', trailing='arrow-up-right')]),","-            f'<div style=\"{BOX}height:var(--space-16)\"></div>', group_head('Credits'),","-            prefs_row('122 credits left', 'Where they went, chat by chat, is in JusPrin › Preferences › Account.', [link('Buy credits')]),","-            f'<div style=\"{BOX}height:var(--space-16)\"></div>', group_head('Account'),","+            prefs_row('Hobby · $10 a month', f'1,500 credits a month until {LAUNCH_END}, then 750. Renews 1 Dec.', [secondary('Change plan'), secondary('Cancel plan')], 'body-bold'),","+            prefs_row('Payment method and invoices', 'Visa ending 4242. Receipts for every payment and credit pack.', [secondary('Open')]),","+            gap, group_head('Credits'),","+            prefs_row('1,122 credits left', 'Where they went, chat by chat, is in Preferences › Account.', [link('Buy a credit pack')]),","+            gap, group_head('Account'),","             prefs_row('alex@example.com', 'Deleting the account ends the plan and removes its credits and saved chats from JusPrin’s servers.', [secondary('Delete account…')])]","-    content = col([text('page-title', 'Billing')] + [col(rows, 0)], 24, 'width:720px', 'padding:var(--space-32) 0 var(--space-48);')","-    return web_page('Billing page', 'Billing', content)","+    return col([text('page-title', 'Billing'), col(rows, 0)], 20, 'width:720px', 'padding:var(--space-24) 0 var(--space-32);')"," ","-# ---- the app's side ------------------------------------------------------------------------------------------------","+# ---- the app's side ------------------------------------------------------------------------------------------------------","+STANDARD_TURNS = USAGE_FIRST","+USAGE_PACK = [r if r[1] != 'Bought 500 credits' else ('17 Nov', PACK, '', '', '+1,000') for r in USAGE_FIRST]","+","+def lots_with_pack(pad):","+    return [meter('First-month credits', '62 of 500 left', 'Expires 1 Dec', 62 / 500, pad), meter('Credit packs', '1,000 of 1,000 left', 'Never expire', 1, pad)]","+"," def account_no_plan():","     pad = 'padding:var(--space-12) var(--space-16);'","-    card = plan_card('No plan', 'Only messages you send cost credits.', [secondary('Billing', trailing='arrow-up-right'), primary(OUT_OF_CREDITS)], [balance_head(BALANCE_HEAD, pad)] + lots_first(pad))","-    return col([text('section', 'Account'), account_row_signed_in(), card, text('label', USED_FIRST, '--text-secondary'), usage_group('438', DAYS_FIRST, USAGE_FIRST), alert_group()], 24, name='Account')","+    card = plan_card('No plan', 'Only messages you send cost credits.', [secondary('Billing'), primary(OUT_OF_CREDITS)], [balance_head('1,062 credits left', pad)] + lots_with_pack(pad))","+    return col([text('section', 'Account'), account_row_signed_in(), card, text('label', USED_FIRST, '--text-secondary'), usage_group('438', DAYS_FIRST, USAGE_PACK), alert_group()], 24, name='Account')"," "," def account_workshop_v2():","     pad = 'padding:var(--space-12) var(--space-16);'","-    card = plan_card('Workshop', 'Renews 1 Dec. Standard messages cost 0 credits.', [secondary('Billing', trailing='arrow-up-right'), primary(OUT_OF_CREDITS)],","-                     [balance_head('640 credits left', pad), meter('Workshop credits', '640 of 1,000 left', 'Expires 1 Dec. Unused credits don’t carry over.', 0.64, pad)])","+    card = plan_card('Workshop', '$16 a month with Obico Premium’s 20% off. Renews 1 Dec.', [secondary('Billing'), primary(OUT_OF_CREDITS)],","+                     [balance_head('1,640 credits left', pad), meter('Workshop credits', '1,640 of 2,000 left', f'Expires 1 Dec. Doubled until {LAUNCH_END}. Unused credits don’t carry over.', 0.82, pad)])","     return col([text('section', 'Account'), account_row_signed_in(), card, usage_group('360', DAYS_WORKSHOP, USAGE_WORKSHOP), alert_group()], 24, name='Account')"," ","+def out_of_credits_screen():","+    \"\"\"3b on Compositions, as build_credits_page.py draws it.\"\"\"","+    return screen(agent_pane(composer(notices=[notice('You have 3 credits; this Expert chat needs 5 a message.', [link(OUT_OF_CREDITS)], below=True)], field=TYPED, typed=True, balance='3 left', balance_frac=0.0, balance_low=True)))","+"," def back_in_app():","     return screen(agent_pane(composer(notices=[quiet_line('+1,000 credits', '--status-success')], field=TYPED, typed=True, send_on=True, balance='1,003 left', balance_frac=1)))"," ","-# ---- the map: who draws what, and the three things that cross --------------------------------------------------------","+def plain_prepare():","+    return screen(agent_pane(composer(field='Reply…', balance='1,122 left', balance_frac=0.75)))","+","+def spinner():","+    arc = 'cx=\"12\" cy=\"12\" r=\"9\" fill=\"none\" stroke-width=\"2.5\"'","+    return (f'<span aria-hidden=\"true\" style=\"{BOX}width:24px;height:24px;display:inline-block\"><svg viewBox=\"0 0 24 24\" width=\"100%\" height=\"100%\" style=\"display:block\">'","+            f'<circle {arc} style=\"stroke:var(--border-subtle)\" /><circle {arc} pathLength=\"100\" stroke-dasharray=\"25 100\" stroke-linecap=\"round\" style=\"stroke:var(--action-primary)\" /></svg></span>')","+","+def sheet_state(kind):","+    if kind == 'loading':","+        inner = col([spinner(), text('body-small', 'Loading Credits and plans…', '--text-secondary', 'flex:none', True)], 12, 'flex:1 1 auto', align='center')","+    else:","+        inner = col([text('section', 'Couldn’t load Credits and plans'), text('body', 'Check your internet connection, then try again.', '--text-secondary'),","+                     row([primary('Try again'), secondary('Open in browser')], 8, 'flex:none')], 12, 'width:360px;margin:auto 0', align='flex-start')","+    return sheet('Credits and plans', f'<div style=\"{BOX}align-self:stretch;flex:1 1 auto;display:flex;flex-direction:column;justify-content:center;align-items:center\">{inner}</div>', 560, 360, placed=False)","+","+# ---- the map: who draws what, and what crosses ------------------------------------------------------------------------------"," def lane_item(head, body):","     return col([text('body-bold', head), text('body-small', body, '--text-secondary')], 2,","                pad='padding:var(--space-12) var(--space-16);background:var(--surface-canvas);border-radius:var(--radius-medium);box-shadow:inset 0 0 0 1px var(--border-subtle);')"]},{"oldStart":99,"oldLines":64,"newStart":135,"newLines":71,"lines":["     return col([col([text('section', title), text('body-small', sub, '--text-secondary')], 2)] + [lane_item(h, b) for h, b in items], 8, f'width:{width}px',","                'padding:var(--space-16);background:var(--surface-subtle);border-radius:var(--radius-large);', name=title)"," ","-APP_ITEMS = [('Welcome and Home’s agent card', 'The 500-credit offer, its scale line and a “See prices” link.'),","+APP_ITEMS = [('The sheet', 'Its frame and title, Open in browser, close, and its own loading and can’t-load states. Never the page inside.'),","+             ('Welcome and Home’s agent card', 'The 500-credit offer, its scale line and a “See prices” link.'),","              ('The composer', 'The credits ring and its panel, prices in credits on the model picker, “About 25 credits left”, the out-of-credits card, “+1,000 credits” after buying.'),","-             ('Preferences › Account', 'Signed in as, the plan’s name and renewal date, a bar per kind of credit, usage per chat, the savings-alert switch. Get more credits and Billing ↗ open the server.'),","+             ('Preferences › Account', 'Signed in as, the plan’s name and its server-written price line, a bar per kind of credit, usage per chat, the savings-alert switch. Get more credits and Billing open the sheet.'),","              ('Print history', 'The print-report button and “25 credits added”.')]","-SERVER_ITEMS = [('Credits and plans', 'The three ways to pay with their dollar prices, the launch offer, Obico’s discount. Signed in or not.'),","-                ('Checkout', 'Chargebee’s hosted page, as today.'),","-                ('Thank-you page', 'What was added, to which account, and “go back to JusPrin”.'),","+CROSS_ITEMS = [('1 · The account answer', 'GET /v2/account, as today: credits by kind with dates, the plan’s name, renewal date and price line, usage. Fields are only ever added; the app ignores ones it doesn’t know.'),","+               ('2 · Page links', 'POST /v2/web_link with a page name, prices or billing, and where the click came from. The answer is a URL that signs in as the app’s account once. The sheet opens it; Open in browser asks for a fresh one. A name the server doesn’t know opens Credits and plans.'),","+               ('3 · The done address', 'When a server page goes to /v2/web/done, the app closes the sheet and reads the account answer again. Checkout, a plan change and a cancel all end there.'),","+               ('4 · Server-written lines', 'The plan’s price line and the savings alert come as finished sentences, with a page name for any button. The app shows them as written and never works out money.')]","+SERVER_ITEMS = [('Credits and plans', 'Credit pack, Hobby and Workshop with dollar prices, the launch offer, Obico’s discount.'),","+                ('Checkout', 'Chargebee’s hosted page, inside the sheet.'),","+                ('Purchase done', 'What was added and to which account; Back to your chat goes to the done address.'),","                 ('Billing', 'The plan in dollars, change and cancel, Chargebee’s portal for payment method and invoices, delete account.'),","-                ('The savings alert’s words', 'The sentence and its sums, sent to the app to show as written.')]","-CROSS_ITEMS = [('1 · The account answer', 'GET /v2/account, as today: credits by kind with dates, the plan’s name and renewal date, usage. Fields are only ever added; the app ignores ones it doesn’t know. The app reads it again whenever its window becomes active.'),","-               ('2 · Page links', 'POST /v2/web_link with a page name, prices or billing, and where the click came from. The answer is a URL that signs the browser in as the app’s account once, for a minute. The two names are answered forever; a name the server doesn’t know opens Credits and plans.'),","-               ('3 · Server-written lines', 'The answer’s unused suggestion slot carries a sentence and a page name. The app shows the sentence as it comes and opens the page through a page link. New offers need no app release.')]","+                ('Server-written lines', 'The words of the plan’s price line and the savings alert, with their sums.')]"," "," def money_map():","-    rule = col([text('body-bold', 'The app shows credits; the server sells them.'),","-                text('body', 'Anything with a dollar sign, a payment form or a plan change is a server page that opens in the browser. The app never shows a dollar amount, so a price change never needs a release. What the app draws it draws from the account answer, so a new kind of credit or a renamed plan also needs no release.', '--text-secondary')], 4)","+    rule = col([text('body-bold', 'The app draws credits; the server draws money, inside a sheet the app owns.'),","+                text('body', 'Anything about dollars, payment or changing a plan is a server page shown in the app’s sheet, so the person never leaves the app and a price change never needs a release. Where the app shows a price, it shows a sentence the server wrote. Google sign-in can’t run inside an app’s web view, so signing in always happens on the app’s own screens, never in the sheet.', '--text-secondary')], 4)","     lanes = row([lane('Drawn by the app', 'Ships with each release; old versions stay in use for months.', APP_ITEMS, 400),","                  lane('What crosses between them', 'The only contract to keep backward compatible.', CROSS_ITEMS, 420),","                  lane('Drawn by the server', f'{SITE}, changes any day.', SERVER_ITEMS, 400)], 16, align='flex-start')","     return col([rule, lanes], 24)"," ","-# ---- the welcome, with the one changed card ---------------------------------------------------------------------------","+# ---- the welcome, with the one changed card ----------------------------------------------------------------------------------"," WELCOME = 'first-run-welcome-01-clip-beat-1.dc.html'"," OFFER_OLD = ('Your first month: 500 credits', 'An Expert message is 5 credits. Your own API key stays free.')","-see_prices = f'<span style=\"color:var(--action-primary);font-weight:700;white-space:nowrap\">See prices ↗</span>'","+see_prices = '<span style=\"color:var(--action-primary);font-weight:700;white-space:nowrap\">See prices</span>'"," OFFER_NEW = ('Sign up and get 500 free credits', f'Good for your first month: about 100 Expert questions. After that, 50 free credits a month. {see_prices}')"," ","-# ---- boards ---------------------------------------------------------------------------------------------------------","+# ---- boards ---------------------------------------------------------------------------------------------------------------"," boards = []","-boards.append(board('money-00-map.dc.html', 'Who draws which page, and what crosses between the app and the server',","-    'Proposal. Each page has one owner. The app’s pages read only the account answer; the server’s pages are opened only through a page link. Those two, plus the server-written line, are the whole contract an old app version depends on.', money_map()))","+boards.append(board('money-00-map.dc.html', 'Who draws which part, and what crosses between the app and the server',","+    'The in-app sheet, Credit pack and the launch offer are Kenneth’s (2026-11-06); the rest is a proposal. The app’s parts read only the account answer; the server’s pages open only through a page link and end at the done address. Those plus the server-written lines are the whole contract an old app version depends on.', money_map()))"," boards.append(patched('money-01-welcome-see-prices.dc.html', WELCOME, 'First meeting · the welcome says what the credits are and links to prices',","-    'Proposal. The offer card’s two lines change and nothing else: the headline says the credits are free, the detail says how long they last, what 500 buys and what comes after, and “See prices ↗” opens Credits and plans in the browser, signed out. The rest of the screen is the welcome as drawn on On boarding experience, where the agreed wording fixes for its other lines also apply.',","+    'Proposal. Only the offer card’s two lines change: the headline says the credits are free, the detail says how long they last, what 500 buys and what comes after, and “See prices” opens Credits and plans in the sheet. The rest is the welcome as drawn on On boarding experience, where the agreed wording fixes for its other lines also apply.',","     [(f'>{escape(OFFER_OLD[0])}<', f'>{escape(OFFER_NEW[0])}<'), (f'>{escape(OFFER_OLD[1])}<', f'>{OFFER_NEW[1]}<')]))","-# The welcome's lockup is a prop its own script picks by theme; give this board's script the same pick.","-_lockup = re.search(r'lockup: (\\{[^}]*\\})', (proj / WELCOME).read_text()).group(1)","+_lockup = re.search(r'lockup: (\\{[^}]*\\})', (proj / WELCOME).read_text()).group(1)   # the welcome's lockup is picked by its own script"," _b = proj / boards[-1][0]"," _b.write_text(_b.read_text().replace(\"return { theme: this.props.theme ?? 'light' };\",","                                      f\"const theme = this.props.theme ?? 'light'; return {{ theme, lockup: {_lockup}[theme] }};\"))","-boards.append(board('money-02-prices-signed-out.dc.html', 'First meeting · Credits and plans, signed out',","-    'Proposal. Opened from “See prices” before signing up. Every button reads “Sign in to buy”, and the line at the top says where the free credits come from. Prices are readable without an account, so nobody signs up just to find out what it costs. The Pay as you go card shows the launch offer in its own headline, so the card no longer says 500 while its note says 1,000.', prices('signed-out')))","+boards.append(board('money-02-prices-signed-out.dc.html', 'First meeting · Credits and plans in the sheet, before signing up',","+    'Proposal. Opened from “See prices” over the welcome. Prices are readable without an account. Every button reads “Sign up to buy”, which closes the sheet and puts the person on the welcome’s sign-up card: Google sign-in can’t run inside the sheet. Every card shows the launch offer in its own credit amount, with the usual amount in its note.',","+    over_screen(imported('first-run-welcome-01-clip-beat-1'), sheet('Credits and plans', prices('signed-out')))))"," boards.append(board('money-03-prices-out-of-credits.dc.html', 'Buying · from “Get more credits” on the out-of-credits card',","-    'Proposal. The app asks the server for a page link, so the browser opens already signed in as the app’s account, whichever way the person signed in. The line at the top says why they’re here and that the credits go to this account. Checkout is Chargebee’s hosted page, as today.', prices('out-of-credits')))","-boards.append(board('money-04-thank-you.dc.html', 'Buying · after checkout, the server’s thank-you page',","-    'Proposal. Replaces today’s redirect to the JusPrin v1 chat. It names what was added and to which account, and tells the person to go back to the app, where their message is waiting.', thank_you()))","-boards.append(board('money-05-back-in-app.dc.html', 'Buying · back in the app',","-    'Proposal. The window becoming active makes the app read the account answer again. The ring fills, “+1,000 credits” shows once above the box, Send turns on, and the typed message is still there. Nothing in the app names the price paid.', back_in_app()))","+    'Proposal. The sheet opens over the chat, already signed in as the app’s account through a page link. The line at the top says why the person is here and which account the credits go to. Checkout is Chargebee’s hosted page, inside the same sheet.',","+    over_screen(out_of_credits_screen(), sheet('Credits and plans', prices('out-of-credits')))))","+boards.append(board('money-04-purchase-done.dc.html', 'Buying · checkout finished, still in the sheet',","+    'Proposal. Replaces today’s redirect to the JusPrin v1 chat. It says what was added and to which account. “Back to your chat” goes to the done address, so the app closes the sheet; closing it with × does the same.',","+    over_screen(out_of_credits_screen(), sheet('Credits and plans', purchase_done()))))","+boards.append(board('money-05-back-in-app.dc.html', 'Buying · the sheet closed',","+    'Proposal. The app reads the account answer again as the sheet closes. The ring fills, “+1,000 credits” shows once above the box, Send turns on, and the typed message is still there.', back_in_app()))"," both = row([prefs_window('account', account_no_plan(), 848, 'No plan'), prefs_window('account', account_workshop_v2(), 848, 'Workshop')], 48, 'flex:none', align='flex-start')","-boards.append(board('money-06-account-no-dollars.dc.html', 'Plan and billing · Preferences › Account without dollars',","-    'Proposal. Left: someone who never paid reads “No plan”, not “Pay as you go”, which sounds like something they chose. Right: Workshop as the plan’s name and renewal date, without “$16 a month” or the discount line, which move to the server’s Billing page. “Billing ↗” replaces “Manage plan ↗” and opens it through a page link. Bars and usage stay in the app because usage lists chats by their local titles.', both, 1696))","-boards.append(board('money-07-billing.dc.html', 'Plan and billing · the server’s Billing page',","-    'Proposal. Opened from Billing ↗ in the app or the header of any server page. The plan in dollars, with Change plan (Credits and plans with the current plan marked) and Cancel plan. Payment method and invoices open Chargebee’s portal, as JusPrin v1 does. Named Billing so it is never confused with the app’s Account section; it points back there for usage.', billing()))","+boards.append(board('money-06-account.dc.html', 'Plan and billing · Preferences › Account',","+    'Proposal. Left: someone without a plan reads “No plan”, not “Pay as you go”; bought credits are “Credit packs”. Right: Workshop during the launch, 2,000 credits a month. Its price line, “$16 a month with Obico Premium’s 20% off”, is a sentence the server writes, so the app never works out a price. “Billing” replaces “Manage plan ↗” and opens the sheet. Bars and usage stay in the app because usage lists chats by their local titles.', both, 1696))","+boards.append(board('money-07-billing.dc.html', 'Plan and billing · Billing in the sheet',","+    'Proposal. Opened from Billing in Account or the line at the top of Credits and plans. The plan in dollars, with Change plan (Credits and plans with the current plan marked) and Cancel plan. Payment method and invoices open Chargebee’s portal inside the sheet. Named Billing so it is never confused with the app’s Account section, which it points back to for usage.',","+    over_screen(plain_prepare(), sheet('Billing', billing()))))"," boards.append(board('money-08-prices-hobby.dc.html', 'Plan and billing · Change plan, on Hobby',","-    'Proposal. The same page marks the current plan and turns the other subscription’s button into a switch. The line at the top says what switching does to the money already paid; the proration rule is a placeholder for Chargebee’s setting.', prices('hobby')))","-boards.append(board('money-09-prices-link-expired.dc.html', 'Edge · the page link had expired',","-    'Proposal. A page link works once, for about a minute. Opened later, from browser history or a second click, it lands here signed out, with no dead end: the line says why and offers both ways back to the right account.', prices('link-expired')))","+    'Proposal. The same page marks the current plan and turns the other subscription’s button into a switch. The line at the top says what switching does to money already paid; the proration rule is a placeholder for Chargebee’s setting.',","+    over_screen(plain_prepare(), sheet('Credits and plans', prices('hobby')))))","+boards.append(board('money-09-sheet-states.dc.html', 'Edge · the sheet while loading and when the server can’t be reached',","+    'Proposal. These two the app draws itself, because the server’s page isn’t there. Open in browser stays in the title row in every state, for anyone who wants their browser’s saved cards or password manager.',","+    row([sheet_state('loading'), sheet_state('failed')], 24, 'flex:none', align='flex-start'), 1192))"," ","-# ---- canvas registration -----------------------------------------------------------------------------------------------","+# ---- canvas registration -------------------------------------------------------------------------------------------------"," c = json.loads((proj / 'canvas.json').read_text())"," drawn = {b[0]: b for b in boards}"," for k in [k for k in c['boards'] if k.startswith('money-') and k not in drawn]:"]},{"oldStart":167,"oldLines":9,"newStart":210,"newLines":12,"lines":[" def add_note(key, **v):","     notes[key] = {**v, 'page': PAGE}","     order.append(key)","-ROWS = [('How the app and the server share the money pages · proposal, 2026-11-06', ['00']),","+add_note('money-supersedes', x=2816, y=744, w=420, size='s', color='orange', text=(","+    'Superseded 2026-11-06 by the boards from y 2900: the one-time purchase is now “Credit pack”, the launch offer doubles every credit amount (packs and plans) until the end of January, '","+    'and these pages open in a sheet inside the app (Kenneth). 4b’s “Pay as you go” plan name is replaced by “No plan” there too.'))","+ROWS = [('How the app and the server share the money pages · 2026-11-06', ['00']),","         ('Where a person first meets prices', ['01', '02']),","-        ('Buying credits, start to finish (after 3b, on Compositions)', ['03', '04', '05']),","+        ('Buying a credit pack, start to finish (after 3b, on Compositions)', ['03', '04', '05']),","         ('Plan and billing', ['06', '07', '08']),","         ('Edge cases', ['09'])]"," y, GAP, ROW_GAP = 2900, 80, 200"]}],"originalFile":null,"userModified":false},"sourceToolAssistantUUID":"12f36b48-d80a-4695-9595-d473ea3a2864","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"userType":"external","entrypoint":"claude-desktop","cwd":"/Users/kenneth/.claude/projects/-Users-kenneth-Projects-JusPrin/figma-mirror","